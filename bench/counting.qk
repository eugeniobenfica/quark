// Counting: 82,944 rows of three values (0 to 255), counted four ways into 256 buckets, 200 times.
fn blend(a: Int, b: Int, c: Int) -> Int = round(0.2126 * a + 0.7152 * b + 0.0722 * c)

// how many rows hold each value (0 to 255) in one column
fn tally(rows: [Int], column: Int) -> [Int] {
    var counts = fill(256, 0)
    for r in 0..len(rows) / 3 {
        counts[rows[r * 3 + column]] += 1
    }
    counts
}

// how many rows blend to each value
fn tallyBlend(rows: [Int]) -> [Int] {
    var counts = fill(256, 0)
    for r in 0..len(rows) / 3 {
        counts[blend(rows[r * 3], rows[r * 3 + 1], rows[r * 3 + 2])] += 1
    }
    counts
}

fn main() {
    let n = 384 * 216
    // three values per row, from a fixed sequence
    let rows = (0..n * 3).map(i => (i * 2654435761 + 12345) / 7 % 256)
    let start = now()
    var checksum = 0
    for pass in 0..200 {
        checksum += tally(rows, 0)[pass % 256] + tally(rows, 1)[7] + tally(rows, 2)[200] + tallyBlend(rows)[pass % 256]
    }
    print("checksum", checksum)
    print("ms", (now() - start) * 1000)
}
