// The heart of a Scopes panel: four histograms (red, green, blue, light) of a 384 x 216 frame, 200 times.
fn luma(r: Int, g: Int, b: Int) -> Int = round(0.2126 * r + 0.7152 * g + 0.0722 * b)

fn main() {
    let n = 384 * 216
    // a frame: red, green, blue per pixel, from a fixed sequence
    let rgb = (0..n * 3).map(i => (i * 2654435761 + 12345) / 7 % 256)
    let start = now()
    var checksum = 0
    for frame in 0..200 {
        let red = (0..n).histogram(256, p => rgb[p * 3])
        let green = (0..n).histogram(256, p => rgb[p * 3 + 1])
        let blue = (0..n).histogram(256, p => rgb[p * 3 + 2])
        let light = (0..n).histogram(256, p => luma(rgb[p * 3], rgb[p * 3 + 1], rgb[p * 3 + 2]))
        checksum += red[frame % 256] + green[7] + blue[200] + light[frame % 256]
    }
    print("checksum", checksum)
    print("ms", (now() - start) * 1000)
}
