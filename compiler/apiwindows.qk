// libquark on Windows: the embedding API (compiler/api.qk) on the runtime written in Quark, its system calls
// runtime/windows.qk's. tools/libquark.sh compiles it into one object (its entries wmain, qkWinEntry... left out).
use std.machine as machine
use api
use runtime.base
use runtime.windows

extern effect fn tlsAlloc() -> UInt32 as "TlsAlloc"

// the thread's context made findable (the runtime's TLS slot); the system: 0, Windows
pub extern effect fn libraryStart() -> Int64 as "qkosLibraryStart" {
    setWord(cell(), 1, tlsAlloc())
    setWord(cell(), 2, 0) // errno
    setWord(cell(), 3, 0) // Winsock, not loaded yet (the cell is a literal's bytes until its words are set)
    0
}

extern effect fn createThread(security: Int64, stack: UInt64, f: Int64, arg: Int64, flags: UInt32, id: Int64) -> Int64 as "CreateThread"
extern effect fn waitForSingleObject(h: Int64, ms: UInt32) -> UInt32 as "WaitForSingleObject"
extern effect fn closeHandle(h: Int64) -> Int32 as "CloseHandle"
extern fn threadAddress(f: extern (Int64) -> Int64) -> Int64 as "qkTextAddress"

// a thread's start: the context first (Quark code may allocate as it starts), then f(arg); t: f, arg, context
fn threadMain(t: Int) -> Int {
    setCtx(word(t, 2))
    machine.call(Pointer<UInt8>(word(t, 0)), word(t, 1), 0, 0, 0)
}

// f(arg) on a thread whose stack is 256 MB (reserved), with this thread's context, waited for: where the compiler runs
pub extern effect fn libraryRun(f: Int64, arg: Int64, ctx: Int64) as "qkosLibraryRun" {
    let t = calloc(3, 8)
    setWord(t, 0, f)
    setWord(t, 1, arg)
    setWord(t, 2, ctx)
    let h = createThread(0, 268435456, threadAddress(x => threadMain(x)), t, 65536, 0)
    if h == 0 {
        let _ = machine.call(Pointer<UInt8>(f), arg, 0, 0, 0) // no thread: here, as deep as this stack goes
    } else {
        let _ = waitForSingleObject(h, 4294967295)
        let _ = closeHandle(h)
    }
    free(t)
}
