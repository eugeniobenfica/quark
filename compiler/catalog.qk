// a text in quotes, as the catalog writes it (a tab as \u0009)
fn jsonText(s: Text) -> Text {
    var out = "\""
    var from = 0
    let b = s.bytes()
    for (i, c) in b.enumerate() {
        let escaped = if c == '"' {
            "\\\""
        } else if c == '\\' {
            "\\\\"
        } else if c == '\n' {
            "\\n"
        } else if c < 0x20 {
            "\\u00" + "0123456789abcdef"[c >> 4..c >> 4 + 1] + "0123456789abcdef"[c & 15..c & 15 + 1]
        } else {
            ""
        }
        if escaped != "" {
            out += s[from..i] + escaped
            from = i + 1
        }
    }
    out + s[from..] + "\""
}

// ---- pin shapes -------------------------------------------------------------------------------------------------
// a type's text being read: where, the type parameters' names, and whether it is a built-in's (its type parameters
// are single capital letters)
type Shaper { text: Text, b: Bytes, p: Int = 0, params: [Text] = [], builtin: Bool = false }

fn Shaper.at(self, i: Int) -> Int = if i < len(self.b) { self.b[i] } else { 0 }

fn Shaper.spaces(var self) {
    while self.at(self.p) == ' ' {
        self.p += 1
    }
}

fn Shaper.eat(var self, word: Text) -> Bool {
    self.spaces()
    let n = len(word)
    if self.p + n > len(self.b) or self.text[self.p..self.p + n] != word {
        return false
    }
    self.p += n
    true
}

fn isLetter(c: Int) -> Bool = c | 32 >= 'a' and c | 32 <= 'z' or c == '_'

// a name's length (geo.Point: a dot inside a name, not "Any...")
fn Shaper.word(var self) -> Int {
    self.spaces()
    var n = 0
    while true {
        let c = self.at(self.p + n)
        if not isLetter(c)
            and not (n > 0 and c >= '0' and c <= '9')
            and not (n > 0 and c == '.' and isLetter(self.at(self.p + n + 1)) and self.at(self.p + n + 1) != '_') {
            break
        }
        n += 1
    }
    n
}

// "(A, B)" after its opening: [shape, shape]
fn Shaper.list(var self, close: Text) -> Text {
    var out = "["
    var i = 0
    while not self.eat(close) and self.p < len(self.b) {
        if i > 0 {
            out += ", "
        }
        i += 1
        let at = self.p
        let n = self.word()
        if n > 0 and self.at(self.p + n) == ':' and close == ")" {
            self.p += n + 1 // (loud: Bool) -> Text: the name is not the type
        } else {
            self.p = at
        }
        out += self.union()
        self.eat(",")
        if self.p == at {
            break
        }
    }
    out + "]"
}

// after "(": params, then -> returns
fn Shaper.fnShape(var self, isEffect: Bool) -> Text {
    var out = "\{\"kind\": \"fn\", \"params\": " + self.list(")") + ", \"returns\": "
    out += if self.eat("->") {
        self.union()
    } else {
        "\{\"kind\": \"nothing\"\}"
    }
    if isEffect {
        out += ", \"effect\": true"
    }
    out + "\}"
}

const plainShapes: [Text: Text] = [
    "Int": "int", "Float": "float", "Bool": "bool", "Text": "text", "Bytes": "bytes", "Any": "any", "Never": "never",
    "nothing": "nothing", "": "any",
]

fn Shaper.one(var self) -> Text {
    var base = ""
    self.spaces()
    if self.eat("[") {
        let first = self.union()
        if self.eat(":") {
            base = "\{\"kind\": \"map\", \"key\": " + first + ", \"element\": " + self.union() + "\}"
        } else {
            base = "\{\"kind\": \"array\", \"element\": " + first + "\}"
        }
        self.eat("]")
    } else if self.eat("effect (") or self.eat("effect fn(") {
        base = self.fnShape(true)
    } else if self.eat("fn(") or self.eat("fn (") {
        base = self.fnShape(false)
    } else if self.eat("(") {
        // (A, B) -> R, or the tuple (A, B)
        let at = self.p
        let items = self.list(")")
        self.spaces()
        if self.p + 2 <= len(self.b) and self.text[self.p..self.p + 2] == "->" {
            self.p = at
            base = self.fnShape(false)
        } else {
            base = "\{\"kind\": \"tuple\", \"items\": " + items + "\}"
        }
    } else if self.eat("an enum") or self.eat("a case") {
        base = "\{\"kind\": \"enum\"\}"
    } else if self.eat("a lambda") {
        base = "\{\"kind\": \"fn\", \"params\": [], \"returns\": \{\"kind\": \"any\"\}\}"
    } else if self.eat("a range of ") {
        base = "\{\"kind\": \"range\", \"element\": " + self.one() + "\}"
    } else if self.eat("a loop of ") {
        base = "\{\"kind\": \"loop\", \"element\": " + self.one() + "\}"
    } else {
        let n = self.word()
        let name = self.text[self.p..self.p + n]
        self.p += n
        let param = self.builtin and n == 1 and self.b[self.p - 1] >= 'A' and self.b[self.p - 1] <= 'Z'
            or self.params.contains(name)
        if plainShapes[name] is Some(kind) {
            base = "\{\"kind\": \"{kind}\"\}"
        } else if name == "Number" {
            base = "\{\"kind\": \"param\", \"name\": \"Number\", \"oneOf\": [\{\"kind\": \"int\"\}, \{\"kind\": \"float\"\}]\}"
        } else if name == "Loop" and self.eat("<") {
            base = "\{\"kind\": \"loop\", \"element\": " + self.union()
            self.eat(">")
            base += "\}"
        } else if param {
            base = "\{\"kind\": \"param\", \"name\": \"{name}\"\}"
        } else {
            base = "\{\"kind\": \"named\", \"name\": \"{name}\""
            if self.eat("<") {
                base += ", \"args\": " + self.list(">")
            }
            base += "\}"
        }
    }
    // T? T! T!ParseError
    while self.at(self.p) == '?' or self.at(self.p) == '!' {
        let optional = self.at(self.p) == '?'
        self.p += 1
        var wrapped = "\{\"kind\": \"" + (if optional { "optional" } else { "result" }) + "\", \"element\": " + base
        if not optional and self.word() > 0 {
            wrapped += ", \"error\": " + self.one()
        }
        base = wrapped + "\}"
    }
    base
}

fn Shaper.union(var self) -> Text {
    let first = self.one()
    self.spaces()
    if self.at(self.p) != '|' {
        return first
    }
    var out = "\{\"kind\": \"oneOf\", \"options\": [" + first
    while self.eat("|") {
        out += ", " + self.one()
    }
    out + "]\}"
}

// ", \"key\": {shape}" for a type's text
fn shapeField(key: Text, text: Text, params: [Text], builtin: Bool) -> Text {
    if text == "" {
        return ", \"{key}\": \{\"kind\": \"nothing\"\}"
    }
    var s = Shaper(text, text.bytes(), params: params, builtin: builtin)
    ", \"{key}\": " + s.union()
}

// A built-in's pins from its text ("source: Loop<T>, f: fn(T) -> U"): name, shape, and whether it is a var ("(a
// var)"), may be left out ("(may be left out)") or takes any number of values ("Any...").
fn builtinPins(params: Text) -> Text {
    var out = ", \"pins\": ["
    var s = Shaper(params, params.bytes(), builtin: true)
    var i = 0
    while s.p < len(s.b) {
        s.spaces()
        var n = 0
        while s.p + n < len(s.b) and s.b[s.p + n] != ':' {
            n += 1
        }
        if s.p + n >= len(s.b) {
            break
        }
        out += (if i > 0 { ", \{\"name\": " } else { "\{\"name\": " }) + jsonText(s.text[s.p..s.p + n])
        i += 1
        s.p += n + 1
        out += ", \"shape\": " + s.union()
        if s.eat("...") {
            out += ", \"variadic\": true"
        }
        if s.eat("(a var)") {
            out += ", \"mutable\": true"
        }
        if s.eat("(may be left out)") {
            out += ", \"optional\": true"
        }
        out += "\}"
        if not s.eat(",") {
            break
        }
    }
    out + "]"
}

fn declEntry(p: Program, d: Decl, checked: Bool) -> Text {
    let a = p.ast
    let kind = match d.kind {
        Enum => "enum"
        Type => if d.isExtern { "extern type" } else { "type" }
        Const => "const"
        _ => if d.isExtern { "extern fn" } else { "fn" }
    }
    var out = "\{\"name\": "
        + jsonText(d.name)
        + ", \"kind\": "
        + jsonText(kind)
        + ", \"host\": "
        + (if d.fromPrelude { "true" } else { "false" })
    if d.isEffect {
        out += ", \"effect\": true" // an action node: on the execution wire
    }
    if d.leading != "" {
        out += ", \"doc\": " + jsonText(d.leading)
    }
    if d.kind == DeclKind.Enum {
        out += ", \"cases\": ["
        for (k, c) in d.cases.enumerate() {
            out += (if k > 0 { ", " } else { "" }) + jsonText(c)
        }
        return out + "]\}"
    }
    if not (d.kind == DeclKind.Type and d.isExtern and not d.cStruct) {
        out += if d.kind == DeclKind.Type {
            ", \"fields\": ["
        } else {
            ", \"params\": ["
        }
        for (k, at) in d.params.enumerate() {
            let prm = a.params[at]
            out += (if k > 0 { ", \{\"name\": " } else { "\{\"name\": " }) + jsonText(prm.name)
            if prm.isVar {
                out += ", \"var\": true" // fn Parser.next(var self)
            }
            let t = if prm.ty >= 0 { typeText(a, prm.ty) } else { "" }
            out += ", \"type\": " + jsonText(t) + shapeField("shape", t, d.typeParams, false) + "\}"
        }
        out += "]"
    }
    if d.kind == DeclKind.Fn {
        // as written (Pair<B, A>), else as the checker found it
        var r = ""
        if d.ret >= 0 {
            r = typeText(a, d.ret)
        } else if checked and d.retType >= 0 and p.types[d.retType].kind != Kind.Void {
            r = p.typeName(d.retType)
        }
        if checked and d.retType >= 0 or d.ret >= 0 {
            out += ", \"returns\": " + jsonText(r) + shapeField("result", r, d.typeParams, false)
        }
    }
    out + "\}"
}

pub fn catalogOf(p: Program, parsed: Bool, checked: Bool) -> Text {
    var out = "\{\"quark\": 1,\n \"builtins\": ["
    for (i, (name, category, params, returns, doc)) in builtins.enumerate() {
        out += (if i > 0 { ",\n    \{\"name\": " } else { "\n    \{\"name\": " })
            + jsonText(name)
            + ", \"category\": "
            + jsonText(category)
        out += ", \"params\": " + jsonText(params) + ", \"returns\": " + jsonText(returns) + builtinPins(params)
        out += shapeField("result", returns, [], true) + ", \"doc\": " + jsonText(doc) + "\}"
    }
    out += "],\n \"types\": [\"Int\", \"Float\", \"Bool\", \"Text\", \"[T]\", \"[K: V]\", \"T?\", \"T!\"],\n"
    out += " \"operators\": [\"+\", \"-\", \"*\", \"/\", \"%\", \"==\", \"!=\", \"<\", \"<=\", \">\", \">=\", \"and\", \"or\", \"not\", \"neg\", \"..\", \"??\", \"?\", \"with\"],\n"
    out += " \"statements\": [\"let\", \"var\", \"set\", \"do\", \"if\", \"match\", \"for\", \"while\", \"return\", \"break\", \"continue\"],\n"
    out += " \"decls\": ["
    var first = true
    if parsed {
        for at in p.decls {
            let d = p.ast.decls[at]
            if d.templateOf >= 0 or d.isTest or d.lifted or d.kind == DeclKind.Use {
                continue
            }
            out += (if first { "\n    " } else { ",\n    " }) + declEntry(p, d, checked)
            first = false
        }
    }
    out + "]\}\n"
}

// quark catalog FILE [--prelude P]: FILE a program, or - for the built-ins and the prelude only
pub fn catalogCommand(given: [Text]) -> Int {
    let o = options(given, 1, true)
    if o.bad != "" {
        printErr("quark: unknown option {o.bad}")
        return 2
    }
    if len(o.files) == 0 {
        return 2
    }
    var host: Source? = None
    if o.prelude != "" {
        let Ok(text) = readFile(o.prelude) else {
            printErr("quark: the prelude {o.prelude} does not read")
            return 1
        }
        let alone = loadProgram(Source("prelude", text), None)
        if not alone.ok or not checkProgram(alone.program, alone.errors, false, None).ok {
            printErr("quark: the prelude {o.prelude} does not read")
            return 1
        }
        host = Some(Source("prelude", text))
    }
    let text = if o.files[0] == "-" { "" } else { readFile(o.files[0]) ?? "" }
    let loaded = loadProgram(Source("program", text), host)
    if not loaded.ok {
        emit(catalogOf(loaded.program, false, false))
        return 0
    }
    let errors = loaded.errors.count
    let checked = checkProgram(loaded.program, loaded.errors, false, None)
    emit(catalogOf(checked.program, true, checked.ok and checked.errors.count == errors))
    0
}
