// The checker: every expression gets a type, inferred from its parts; only function parameters (and record fields)
// are written. An Int goes where a Float is wanted; a loop (map, filter, a range) goes where an array is wanted.
// Names and scopes, files (use, pub, opaque), inference,
// generics and their instances, interfaces, effects, patterns and exhaustiveness, places (var self), defaults,
// .Case, ?. chains, is, C's types.
//
// One Checker value holds the program and the context of the code being checked (Ctx). Checking another function
// in the middle (its result type is needed now), a lambda kept as a value, a constant or a template's instance
// works in a context of its own: the one around it is pushed on saved and taken back after. A lambda kept as a
// value sees the names of the function it is written in through outer (an index into saved): it captures them.
//
// What checking works out goes into the tree: each expression's ty, binding, decl, builtin, ordered...; implicit
// conversions are calls of their own (Some, Ok, toFloat, toArray, #interface...) that take the converted node's
// index, the node itself moved to a new one; templates get instances (Decl.instances, cloned from Decl.pristine),
// lambdas kept as values become functions (Decl.lifted), all added to Program.decls.
use token
use ast
use source
use types
use clone
use format
use parser

// The context of the code being checked. scope: the names in reach (bindings), innermost last; fnDecl the function
// whose body it is; loopDepth loops and lambda bodies around (how often code runs); pureDepth lambdas that must be
// pure around it (map, filter..., a parameter typed without effect), pureFn the innermost one's function and
// pureScope where its names begin; declaring the let whose value is checked (a lambda in it cannot call it);
// varReads reads of vars so far; lets this function's lets of loops (fused or not); inConst a constant or a
// default (no names, no effects); deferDepth inside a defer's block (it cannot leave); module the file whose code it
// is; hint the type a value goes into, when written (let xs: [Speaker] = [...]); outer a lifted lambda's function's
// context (in saved); result the type the if or match being checked gives, when written; typing whose type
// parameters a type may name (view: with viewArgs for them); keepIs the next expression's is names stay in reach;
// dotted .Case values not yet given their enum; errorWant the error a mapErr's result goes into; isNames the names
// is patterns made (for a message); cTypes C's types may be written (an extern declaration's).
pub type Ctx {
    scope: [Int] = []
    fnDecl: Int = -1
    loopDepth: Int = 0
    lambdaDepth: Int = 0
    pureDepth: Int = 0
    pureFn: Text = ""
    pureScope: Int = 0
    declaring: Text = ""
    varReads: Int = 0
    lets: [Int] = []
    inConst: Bool = false
    deferDepth: Int = 0
    module: Int = 0
    hint: Int = -1
    outer: Int = -1
    result: Int = -1
    typing: Int = -1
    view: Bool = false
    viewArgs: [Int] = []
    keepIs: Bool = false
    dotted: [Int] = []
    errorWant: Int = -1
    isNames: [Text] = []
    cTypes: Bool = false
}

// A use of a function not known (yet) to change the world: one of them may still turn out to, through a function
// that calls itself. Settled once everything is checked.
type EffectUse { user: Int, used: Int, line: Int, col: Int, module: Int, place: Int }

// where an effect is: a function's body, a pure lambda, a constant, a lambda kept as a value typed pure, a function
// taken as a value (its type says)
const inBody = 0
const inLambda = 1
const inConst = 2
const inKept = 3
const asValue = 4

// The checker: the program, the context (c, and the ones around it in saved), the errors said; allowed the
// capabilities a host gives (None: everything); byName the program's declarations by name, in order; methods the
// names after Type. of every type's function; changers those of var self ones.
pub type Checker {
    p: Program
    errors: Errors
    c: Ctx = Ctx()
    saved: [Ctx] = []
    allowed: Text? = None
    effectUses: [EffectUse] = []
    instantiating: Int = 0
    builtins: [Text: Int] = [:]
    byName: [Text: [Int]] = [:]
    methods: Set<Text> = []
    changers: Set<Text> = []
    selfMarker: Int = -1 // what Self is in an interface's functions: the type that fits it (fitsMember puts it in)
    jsonCallModule: Int = 0
    jsonCallAt: Int = -1 // the template call being made an instance of (what jsonNot points at)
    jsonSelf: Int = -1 // std.json's jsonOf or fromJson made for a record or an enum: Self is that type (jsonBody)
}

// A checked program, and the errors said (with those said before: errors).
pub type Checked { program: Program, errors: Errors, ok: Bool }

// Checks a program. needMain: it must have fn main() (the command line's run, build...); allowed: what it may reach
// (--allow; None: anything).
pub fn checkProgram(p: Program, errors: Errors, needMain: Bool, allowed: Text?) -> Checked {
    var k = Checker(p, errors, allowed: allowed)
    for (i, name) in builtinNames.enumerate() {
        if i > 0 and not k.builtins.contains(name) {
            k.builtins[name] = i
        }
    }
    k.addDefaults()
    for d in k.p.decls {
        k.named(d)
    }
    let ok = k.run(needMain)
    Checked(k.p, k.errors, ok)
}

// An interface's functions with a body are its defaults: a type (not generic) that has each of its other functions
// and not this one gets it, as if it were written fn Type.name(self, ...) = body in the interface's file (Self there
// is the type, as in any of its functions). It is the type's own from then on: called on it, or through the interface.
fn Checker.addDefaults(var self) {
    var made = false
    let decls = self.p.decls
    var fns: Set<Text> = [] // Type.name of every function a type has
    for d in decls {
        let x = self.p.ast.decls[d]
        if x.kind == DeclKind.Fn and x.name.contains(".") {
            fns.add(x.name)
        }
    }
    for w in decls {
        let iface = self.p.ast.decls[w]
        if iface.kind != DeclKind.Type or not iface.isInterface {
            continue
        }
        let members = iface.params.map(f => self.p.ast.params[f]).toArray()
        if not members.any(m => m.fallback >= 0) {
            continue
        }
        for t in decls {
            let ty = self.p.ast.decls[t]
            if not ty.kind is Type | Enum or ty.isInterface or len(ty.typeParams) > 0 or ty.isExtern or ty.fromPrelude {
                continue
            }
            if not members.all(m => m.fallback >= 0 or fns.contains(ty.name + "." + m.name)) {
                continue // not one that fits it
            }
            for m in members {
                if m.fallback < 0 or fns.contains(ty.name + "." + m.name) {
                    continue
                }
                // fn loud(times: Int) -> Text = ... as fn Dog.loud(self, times: Int) -> Text = ...
                let head = memberText(self.p.ast, m with { fallback: -1 })
                let open = head.indexOf("(") ?? 0
                let hasParams = not head[open + 1..].startsWith(")")
                let start = if head.startsWith("effect ") { "pub effect fn " } else { "pub fn " }
                let text = start
                    + ty.name
                    + "."
                    + m.name
                    + "(self"
                    + (if hasParams { ", " } else { "" })
                    + head[open + 1..]
                    + " = "
                    + exprText(self.p.ast, m.fallback, 0)
                    + "\n"
                let before = len(self.p.ast.decls)
                let errors = self.parseMore(Source("{iface.name}.{m.name} (its default, for {ty.name})", text))
                for e in errors {
                    self.errors.add(Source("", ""), iface.line, iface.col, e)
                }
                for at in before..len(self.p.ast.decls) {
                    self.p.ast.decls[at].module = iface.module
                    self.p.ast.decls[at].fromDefault = true // the language's making: not in the program's graph
                    self.p.ast.decls[at].index = len(self.p.decls)
                    self.p.decls.push(at)
                    fns.add(self.p.ast.decls[at].name)
                    made = true
                }
            }
        }
    }
    let _ = made
}

// d among the program's declarations, findable by its name
fn Checker.named(var self, d: Int) {
    let name = self.p.ast.decls[d].name
    if self.byName.contains(name) {
        self.byName[name].push(d)
    } else {
        self.byName[name] = [d]
    }
}

// a declaration the checker makes (an instance, a lifted lambda): among the program's
fn Checker.addDecl(var self, d: Decl) -> Int {
    let at = self.p.ast.decl(d)
    self.p.ast.decls[at].index = len(self.p.decls)
    self.p.decls.push(at)
    self.named(at)
    at
}

// ---- small things ------------------------------------------------------------------------------------------------
fn plural(n: Int) -> Text = if n == 1 { "" } else { "s" }

fn article(cond: Bool) -> Text = if cond { "a" } else { "an" }

// fmt with each %s replaced by a, then b (C's printf, for the messages built around two types), %% by %
fn printf2(fmt: Text, a: Text, b: Text) -> Text {
    let bs = fmt.bytes()
    var out = ""
    var start = 0
    var i = 0
    var n = 0
    while i + 1 < len(bs) {
        if bs[i] == '%' and bs[i + 1] == 's' {
            out += fmt[start..i] + (if n == 0 {
                a
            } else if n == 1 {
                b
            } else {
                ""
            })
            n += 1
            i += 2
            start = i
        } else if bs[i] == '%' and bs[i + 1] == '%' {
            out += fmt[start..i] + "%"
            i += 2
            start = i
        } else {
            i += 1
        }
    }
    out + fmt[start..]
}

// the closest name, for "did you mean": "" when nothing is close
fn closest(name: Text, candidates: [Text]) -> Text {
    var best = ""
    var found = false
    var bestDistance = len(name) / 3 + 1
    for c in candidates {
        let d = editDistance(name, c)
        if d < bestDistance or d == bestDistance and not found {
            best = c
            found = true
            bestDistance = d
        }
    }
    best
}

fn editDistance(a: Text, b: Text) -> Int {
    let x = a.bytes()
    let y = b.bytes()
    if len(x) > 40 or len(y) > 40 {
        return 99
    }
    var row = (0..len(y) + 1).toArray()
    for i in 1..len(x) + 1 {
        var diag = row[0]
        row[0] = i
        for j in 1..len(y) + 1 {
            let up = row[j]
            let cost = if x[i - 1] == y[j - 1] { 0 } else { 1 }
            var best = diag + cost
            if row[j] + 1 < best {
                best = row[j] + 1
            }
            if row[j - 1] + 1 < best {
                best = row[j - 1] + 1
            }
            row[j] = best
            diag = up
        }
    }
    row[len(y)]
}

// a call's value names: "" where a value is given by position
fn nameAt(names: [Text], i: Int) -> Text = names.get(i) ?? ""

// what a node is called by: a name's, a call's, a field's, a case's
fn Checker.nameOf(self, e: Int) -> Text = match self.p.ast.exprs[e].node {
    Name(name) => name
    Call(name, _, _, _, _, _) => name
    Field(_, name) => name
    Case(name, _, _) => name
    _ => ""
}

fn Checker.argsOf(self, e: Int) -> [Int] = match self.p.ast.exprs[e].node {
    Call(_, _, args, _, _, _) => args
    ArrayLit(items) => items
    MapLit(items) => items
    With(_, values, _) => values
    Interp(values, _, _, _, _) => values
    _ => []
}

fn Checker.namesOf(self, e: Int) -> [Text] = match self.p.ast.exprs[e].node {
    Call(_, _, _, names, _, _) => names
    With(_, _, fields) => fields
    _ => []
}

fn Checker.ty(self, e: Int) -> Int = self.p.ast.exprs[e].ty

fn Checker.setTy(var self, e: Int, t: Int) {
    self.p.ast.exprs[e].ty = t
}

fn Checker.kindOf(self, t: Int) -> Kind = self.p.types[t].kind

fn Checker.isErr(self, t: Int) -> Bool = self.p.types[t].kind == Kind.Error

fn Checker.same(self, a: Int, b: Int) -> Bool = a == b or self.isErr(a) or self.isErr(b)

fn Checker.tname(self, t: Int) -> Text = self.p.typeName(t)

fn Checker.elemOf(self, t: Int) -> Int = self.p.types[t].elem

fn Checker.keyOf(self, t: Int) -> Int = self.p.types[t].key

fn Checker.declOf(self, t: Int) -> Int = self.p.types[t].decl

fn Checker.isLoop(self, t: Int) -> Bool = self.p.types[t].kind is Range | Iter

fn Checker.isTypeNode(self, te: Int) -> Bool = te >= 0

fn Checker.bindingType(self, b: Int) -> Int = self.p.bindings[b].ty

fn Checker.paramType(self, prm: Int) -> Int = self.p.paramType(prm)

fn Checker.paramName(self, prm: Int) -> Text = self.p.ast.params[prm].name

fn Checker.declName(self, d: Int) -> Text = self.p.ast.decls[d].name

// an array of C's types ([Float32], [CText], [DivT]): C's array, given to C only
fn Checker.cArray(self, t: Int) -> Bool {
    if t < 0 or self.kindOf(t) != Kind.Array {
        return false
    }
    let e = self.elemOf(t)
    self.p.types[e].c != 0 or self.p.types[e].kind == Kind.Record and self.p.ast.decls[self.p.types[e].decl].cStruct
}

fn Checker.isCFunction(self, d: Int) -> Bool {
    let x = self.p.ast.decls[d]
    x.kind == DeclKind.Fn and x.isExtern and x.body < 0
}

// fn Parser.next(var self): it changes the value it is called on
fn Checker.changesSelf(self, d: Int) -> Bool =
    d >= 0 and len(self.p.ast.decls[d].params) > 0 and self.p.ast.params[self.p.ast.decls[d].params[0]].isVar

// a type written as a Quark function's: (A) -> R, effect (A) -> R (not extern (A) -> R: a C function's address, a value)
// a type written as a function's: (A) -> R, effect (A) -> R, extern (A) -> R
fn Checker.isFnTypeNode(self, te: Int) -> Bool =
    te >= 0 and self.p.ast.types[te].node is Fn(_, _, _, _, false) // a Quark function; extern (A) -> R is a value (an address)

fn Checker.isExternFnNode(self, te: Int) -> Bool =
    te >= 0 and self.p.ast.types[te].node is Fn(_, _, _, _, true)

fn Checker.builtinNamed(self, name: Text) -> Int = self.builtins[name] ?? 0

fn Checker.src(self) -> Source = self.p.modules[self.c.module].src

fn Checker.say(var self, line: Int, col: Int, message: Text) {
    self.errors.add(self.p.modules[self.c.module].src, line, col, message)
}

fn Checker.sayAt(var self, e: Int, message: Text) {
    let line = self.p.ast.exprs[e].line
    let col = self.p.ast.exprs[e].col
    self.say(line, col, message)
}

// a message about types: a or b (-1: none) in place of fmt's %s; nothing when one is an error (said already)
fn Checker.typeError(var self, e: Int, fmt: Text, a: Int, b: Int) {
    if a >= 0 and self.isErr(a) or b >= 0 and self.isErr(b) {
        return
    }
    let na = if a >= 0 { self.tname(a) } else { "" }
    let nb = if b >= 0 { self.tname(b) } else { "" }
    self.sayAt(e, printf2(fmt, na, nb))
}

// ---- contexts ----------------------------------------------------------------------------------------------------
fn Checker.enter(var self, next: Ctx) {
    self.saved.push(self.c)
    self.c = next
}

fn Checker.leave(var self) {
    let back = self.saved.pop() ?? Ctx()
    self.c = back
}

fn Checker.truncate(var self, mark: Int) {
    while len(self.c.scope) > mark {
        self.c.scope.pop()
    }
}

fn Checker.ctxAt(self, k: Int) -> Ctx = if k < 0 { self.c } else { self.saved[k] }

// ---- names -------------------------------------------------------------------------------------------------------
// Does module `from` use module `to` (by its names: not through an alias, unless `aliased`)?
fn Checker.usesModuleAs(self, from: Int, to: Int, aliased: Bool) -> Bool {
    if from < 0 or from >= len(self.p.modules) {
        return false
    }
    let m = self.p.modules[from]
    for (i, u) in m.uses.enumerate() {
        if u == to and (aliased or m.aliases[i] == "") {
            return true
        }
    }
    false
}

// What code in module m sees: its own declarations, the host's, and the pub ones of the files it uses (a type's own
// functions, Vec2.plus, also through an alias: a + b works on a g.Vec2).
fn Checker.seenFrom(self, m: Int, d: Int) -> Bool {
    if self.p.ast.decls[d].kind == DeclKind.Use {
        return false
    }
    if self.p.ast.decls[d].fromPrelude or self.p.ast.decls[d].module == m {
        return true
    }
    if self.p.ast.decls[d].builtin {
        return self.p.ast.decls[d].isPub // the language's own: everywhere (after the program's: they come last)
    }
    self.p.ast.decls[d].isPub and self.usesModuleAs(m, self.p.ast.decls[d].module, self.p.ast.decls[d].owner != "")
}

// use geometry as g: the module g stands for in module m, or -1
fn Checker.aliasModule(self, m: Int, alias: Text) -> Int {
    if m < 0 or m >= len(self.p.modules) {
        return -1
    }
    let mod = self.p.modules[m]
    for (i, a) in mod.aliases.enumerate() {
        if a != "" and a == alias {
            return mod.uses[i]
        }
    }
    -1
}

fn Checker.impliedSelfOf(self, f: Int) -> Bool =
    f >= 0
        and self.p.ast.decls[f].impliedSelf
        and len(self.p.ast.decls[f].params) > 0
        and self.p.ast.params[self.p.ast.decls[f].params[0]].ty >= 0

// The function of a type whose code is being checked (fn Vec2.plus), around a lambda too: what Self names.
fn Checker.selfOf(self) -> Int {
    var k = -1
    var steps = 0
    while steps < 10000 {
        steps += 1
        let typing = if k < 0 { self.c.typing } else { self.saved[k].typing }
        let fnDecl = if k < 0 { self.c.fnDecl } else { self.saved[k].fnDecl }
        let outer = if k < 0 { self.c.outer } else { self.saved[k].outer }
        let f = if typing >= 0 { typing } else { fnDecl }
        if self.impliedSelfOf(f) {
            return f
        }
        if self.impliedSelfOf(fnDecl) {
            return fnDecl
        }
        if outer < 0 {
            return -1
        }
        k = outer
    }
    -1
}

fn startsLower(name: Text) -> Bool = len(name) > 0 and name.bytes()[0] is 'a'..='z'

fn startsUpper(name: Text) -> Bool = len(name) > 0 and name.bytes()[0] is 'A'..='Z'

fn Checker.findDecl(var self, name: Text) -> Int {
    if name == "Self" and self.jsonSelf >= 0 {
        return self.jsonSelf
    }
    if name == "Self" {
        // Self(x: 1), Self.Leaf: the type the function belongs to
        let f = self.selfOf()
        if f < 0 {
            return -1
        }
        let te = self.p.ast.params[self.p.ast.decls[f].params[0]].ty
        let Named(n, _) = self.p.ast.types[te].node else {
            return -1
        }
        return self.findDecl(n)
    }
    let dot = name.indexOf(".") ?? -1
    if dot >= 0 and startsLower(name) {
        // g.area: a pub declaration of the module g stands for
        let m = self.aliasModule(self.c.module, name[..dot])
        if m >= 0 {
            for d in self.byName[name[dot + 1..]] ?? [] {
                let x = self.p.ast.decls[d]
                if x.module == m and x.isPub and x.kind != DeclKind.Use {
                    return d
                }
            }
        }
    }
    for d in self.byName[name] ?? [] {
        if self.seenFrom(self.c.module, d) {
            return d
        }
    }
    -1
}

// Shape, g.Shape: a name whose last part is a type's
fn typeLike(name: Text) -> Bool {
    let b = name.bytes()
    var start = 0
    for (i, c) in b.enumerate() {
        if c == '.' {
            start = i + 1
        }
    }
    start < len(b) and b[start] is 'A'..='Z'
}

// The checker set to the file d comes from: its errors there, its names in reach.
fn Checker.enterDecl(var self, d: Int) {
    self.c.module = self.p.ast.decls[d].module
}

fn Checker.accessLayout(var self, d: Int, at: Int) -> Bool {
    if not self.p.ast.decls[d].opaque or self.p.ast.decls[d].module == self.c.module {
        return true
    }
    self.sayAt(at, "{self.declName(d)} is opaque outside its module: use its public functions")
    false
}

// a name in reach in context k (-1: the current one), innermost first
fn Checker.lookupAt(self, k: Int, name: Text) -> Int {
    if k < 0 {
        var i = len(self.c.scope) - 1
        while i >= 0 {
            let b = self.c.scope[i]
            if self.p.bindings[b].name == name {
                return b
            }
            i -= 1
        }
        return -1
    }
    var i = len(self.saved[k].scope) - 1
    while i >= 0 {
        let b = self.saved[k].scope[i]
        if self.p.bindings[b].name == name {
            return b
        }
        i -= 1
    }
    -1
}

fn Checker.lookup(self, name: Text) -> Int = self.lookupAt(-1, name)

// A template's parameter that takes a function is used as a value (kept, captured, given back): from now on it is
// given a function value, not a lambda put in.
fn Checker.keepsFunction(var self, b: Int) {
    let d = self.p.bindings[b].paramOf
    if d < 0 or not self.p.ast.decls[d].isTemplate {
        return
    }
    if len(self.p.ast.decls[d].valueParams) == 0 {
        self.p.ast.decls[d].valueParams = [false] * len(self.p.ast.decls[d].params)
    }
    let at = self.p.bindings[b].paramIndex
    if at < len(self.p.ast.decls[d].valueParams) {
        self.p.ast.decls[d].valueParams[at] = true
    }
}

// A name, in reach here, or around the lambda kept as a value being checked: then it is captured (its value,
// copied where the lambda is made) and the lambda's own binding for it is given. k: the context (-1 the current).
fn Checker.lookupOrCapture(var self, k: Int, name: Text) -> Int {
    let b = self.lookupAt(k, name)
    let outer = if k < 0 { self.c.outer } else { self.saved[k].outer }
    let d = if k < 0 { self.c.fnDecl } else { self.saved[k].fnDecl }
    if b >= 0 or outer < 0 or d < 0 or not self.p.ast.decls[d].lifted {
        return b
    }
    for (i, inner) in self.p.ast.decls[d].captureInner.enumerate() {
        if self.p.bindings[inner].name == name {
            return inner
        }
    }
    let ob = self.lookupOrCapture(outer, name)
    if ob >= 0 and self.p.bindings[ob].fnParam {
        self.keepsFunction(ob) // the template keeps the function it is given: a value
    }
    if ob < 0 {
        return -1
    }
    let o = self.p.bindings[ob]
    let paramOfTemplate = o.paramOf >= 0 and self.p.ast.decls[o.paramOf].isTemplate
    if o.fnParam and not paramOfTemplate or o.lambda >= 0 {
        return -1
    }
    self.p.bindings[ob].uses += 1
    self.p.bindings[ob].iterUses += 1000 // stored, never fused into the lambda
    self.p.bindings.push(Binding(o.name, o.ty, line: o.line, col: o.col, capturedFrom: ob))
    let inner = len(self.p.bindings) - 1
    self.p.ast.decls[d].captureOuter.push(ob)
    self.p.ast.decls[d].captureInner.push(inner)
    inner
}

fn Checker.declare(var self, name: Text, t: Int, mutable: Bool, line: Int, col: Int) -> Int {
    let old = self.lookup(name)
    if old >= 0 and not self.p.bindings[old].isParam {
        self.say(line, col, "\"{name}\" is already defined here: give it another name")
    } else if old >= 0 {
        self.say(line, col, "\"{name}\" is a parameter: give it another name")
    }
    self.p.bindings.push(Binding(name, t, mutable: mutable, depth: self.c.loopDepth, line: line, col: col))
    let b = len(self.p.bindings) - 1
    self.c.scope.push(b)
    b
}

// the file name of a path (after its last / or \)
fn baseName(path: Text) -> Text {
    let b = path.bytes()
    var start = 0
    for (i, c) in b.enumerate() {
        if c is '/' | '\\' {
            start = i + 1
        }
    }
    path[start..]
}

// A name declared in a file this one does not see (not used, or not pub there): where it is and what to write.
fn Checker.sayHidden(var self, line: Int, col: Int, name: Text, what: Text) -> Bool {
    if name.contains(".") {
        return false
    }
    for d in self.byName[name] ?? [] {
        let x = self.p.ast.decls[d]
        if x.kind == DeclKind.Use or x.templateOf >= 0 or x.module == self.c.module or x.module >= len(self.p.modules) {
            continue
        }
        let f = self.p.modules[x.module]
        let file = baseName(f.path)
        if not x.isPub {
            self.say(
                line,
                col,
                "{name} is in {file}, but not pub there: write pub before its declaration to use it in other files",
            )
            return true
        }
        // what this file writes: the path from its folder (lib/ast.qk: use lib.ast), std.json, or the first use's
        let here = if self.c.module < len(self.p.modules) {
            self.p.modules[self.c.module].path
        } else {
            ""
        }
        let dir = len(here) - len(baseName(here))
        var rel = ""
        var hasRel = false
        if f.path.startsWith("std/") {
            rel = f.path
            hasRel = true
        } else if len(f.path) >= dir and f.path[..dir] == here[..dir] {
            rel = f.path[dir..]
            hasRel = true
        }
        var useText = ""
        if hasRel and len(rel) > 3 {
            useText = rel[..len(rel) - 3].replace("/", ".").replace("\\", ".")
        } else if f.useName != "" {
            useText = f.useName
        } else {
            useText = if len(file) > 3 { file[..len(file) - 3] } else { file }
        }
        self.say(line, col, "unknown {what} \"{name}\": it is in {file}; add use {useText}")
        return true
    }
    false
}

// Names other languages use, and what Quark writes for them: an error says the Quark way.
const otherNames: [Text: Text] = [
    "length": "len(x)", "size": "len(x)", "toString": "toText(x)", "str": "toText(x)", "String": "toText(x)",
    "string": "toText(x)", "Int": "toInt(x) for a Float, parseInt(t) for a text", "int": "toInt(x), or parseInt(t)",
    "Float": "toFloat(n) for an Int, parseFloat(t) for a text", "float": "toFloat(n), or parseFloat(t)",
    "null": "None (an optional, T?)", "nil": "None (an optional, T?)", "undefined": "None (an optional, T?)",
    "toUpper": "upper(t)", "toUpperCase": "upper(t)", "uppercase": "upper(t)", "toLower": "lower(t)",
    "toLowerCase": "lower(t)", "lowercase": "lower(t)", "strip": "trim(t)", "trimStart": "trim(t)",
    "trimEnd": "trim(t)", "find": "indexOf(t, part) for a text, first(x => ...) for a list",
    "includes": "contains(xs, v)", "has": "contains(xs, v)", "append": "xs.push(v), or xs += ys",
    "reduce": "fold(start, (acc, x) => ...)", "forEach": "a for loop: for x in xs \{ ... \}",
    "sort": "sorted() (a sorted copy)", "fill": "an array repeated: [value] * n",
    "repeat": "a text or an array repeated: text * n", "reverse": "reversed() (a copy, last first)",
    "sortBy": "sortedBy(key)", "isEmpty": "len(x) == 0", "substring": "a slice: t[a..b]", "substr": "a slice: t[a..b]",
    "slice": "a slice: xs[a..b]", "charAt": "a slice, t[i..i + 1], or codePoints(t)",
    "insert": "slices joined: xs[..i] + [v] + xs[i..]", "removeAt": "slices joined: xs[..i] + xs[i + 1..]",
    "distinct": "toSet()", "unique": "toSet()", "range": "a..b", "exists": "pathExists(path)", "mkdir": "makeDir(path)",
    "rmdir": "removePath(path)", "deleteFile": "removePath(path)", "unlink": "removePath(path)",
    "ord": "a character, 'a' (an Int), or codePoints(t)", "chr": "char(n)", "println": "print(...)",
    "printf": "print(\"\{x:.2\}\")", "assertEqual": "assertEqual from std.testing (use std.testing)",
]

// "did you mean" over every name in reach
fn Checker.unknownName(var self, e: Int) {
    let name = self.nameOf(e)
    let line = self.p.ast.exprs[e].line
    let col = self.p.ast.exprs[e].col
    var names: [Text] = []
    for b in self.c.scope {
        if len(names) < 400 {
            names.push(self.p.bindings[b].name)
        }
    }
    for d in self.p.decls {
        if len(names) < 480 and self.seenFrom(self.c.module, d) {
            names.push(self.p.ast.decls[d].name)
        }
    }
    for (i, b) in builtinNames.enumerate() {
        if i > 0 and len(names) < 512 and not b.startsWith("#") {
            names.push(b)
        }
    }
    if name == "Self" {
        self.say(line, col, "Self names the type a function belongs to: use it in fn Type.name(self, ...)")
        return
    }
    if self.c.isNames.contains(name) {
        self.say(
            line,
            col,
            "{name} is named by an is pattern: it is in reach only where the pattern held (the if's block, the while's body, after and)",
        )
        return
    }
    var o = self.c.outer
    while o >= 0 {
        if self.lookupAt(o, name) >= 0 {
            self.say(
                line,
                col,
                "a function is not a value to keep here: {name} was given to the function around this lambda, so call it there",
            )
            return
        }
        o = self.saved[o].outer
    }
    var k = -1
    var steps = 0
    while steps < 10000 {
        steps += 1
        let ctx = self.ctxAt(k)
        if ctx.declaring != "" and ctx.declaring == name {
            self.say(
                line,
                col,
                "{name} is not made yet inside its own lambda: a function that calls itself is a fn of its own, fn {name}(...) -> Type",
            )
            return
        }
        if ctx.outer < 0 {
            break
        }
        k = ctx.outer
    }
    if self.sayHidden(line, col, name, if typeLike(name) { "type" } else { "name" }) {
        return
    }
    if self.p.ast.exprs[e].node is Name(_) and self.builtinNamed(name) > 0 {
        self.say(line, col, "{name} is built in: it is called, not kept as a value (a lambda keeps it: x => {name}(x))")
        return
    }
    if otherNames[name] is Some(other) {
        self.say(line, col, "there is no {name}: write {other}")
        return
    }
    let close = closest(name, names)
    if close != "" {
        self.say(line, col, "unknown name \"{name}\": did you mean \"{close}\"?")
    } else {
        self.say(line, col, "unknown name \"{name}\"")
    }
}

// Wraps the node at `at` in an implicit built-in call (a conversion the reader does not see): the node moves to a
// new index, the call takes its place.
fn Checker.wrap(var self, at: Int, builtin: Int, t: Int) {
    let inner = self.p.ast.exprs[at]
    self.p.ast.exprs.push(inner)
    let moved = len(self.p.ast.exprs) - 1
    self.p.ast.exprs[at] = Expr(
        .Call(builtinNames[builtin], "", [moved], [""], false, false),
        inner.line,
        inner.col,
        ty: t,
        builtin: builtin,
        implicit: true,
    )
}

// a node put in another's place (the other moved to a new index): the new index of the one that was there
fn Checker.replace(var self, at: Int, x: Expr) -> Int {
    self.p.ast.exprs.push(self.p.ast.exprs[at])
    let moved = len(self.p.ast.exprs) - 1
    self.p.ast.exprs[at] = x
    moved
}

fn Checker.newExpr(var self, node: ExprNode, line: Int, col: Int) -> Int =
    self.p.ast.expr(node, line, col)

// ---- types as written --------------------------------------------------------------------------------------------
// T where a type is written: what it stands for in the declaration being checked, or (in a lambda) in the one
// around it
fn Checker.typeArgOf(self, name: Text) -> Int {
    var k = -1
    var steps = 0
    while steps < 10000 {
        steps += 1
        let c = if k < 0 { self.c } else { self.saved[k] }
        let owner = c.typing
        if owner >= 0 {
            let args = if c.view { c.viewArgs } else { self.p.ast.decls[owner].typeArgs }
            for (i, tp) in self.p.ast.decls[owner].typeParams.enumerate() {
                if tp == name and i < len(args) {
                    return if args[i] >= 0 {
                        args[i] // T: what it stands for
                    } else {
                        tyError
                    }
                }
            }
        }
        if c.outer < 0 {
            return -1
        }
        k = c.outer
    }
    -1
}

fn Checker.resolveType(var self, te: Int) -> Int {
    let line = self.p.ast.types[te].line
    let col = self.p.ast.types[te].col
    match self.p.ast.types[te].node {
        Optional(inner) => {
            let t = self.resolveType(inner)
            if self.isErr(t) {
                return t
            }
            self.p.optionType(t)
        }
        Result(inner, error) => {
            let t = self.resolveType(inner)
            if self.isErr(t) {
                return t
            }
            if error >= 0 {
                // T!ParseError
                let et = self.resolveType(error)
                if self.isErr(et) {
                    return et
                }
                return self.p.resultOfType(t, et)
            }
            self.p.resultType(t)
        }
        Tuple(items) => {
            var elems: [Int] = []
            for item in items {
                let t = self.resolveType(item)
                if self.isErr(t) {
                    return t
                }
                elems.push(t)
            }
            self.p.tupleType(elems)
        }
        Fn(params, _, result, isEffect, external) => {
            if external {
                // extern (A, B) -> R: a C function's address, its parameters and result C's types (written anywhere:
                // a value C gives back is kept, passed on and called)
                let wasC = self.c.cTypes
                self.c.cTypes = true
                var ps: [Int] = []
                for prm in params {
                    let t = self.resolveType(prm)
                    if self.isErr(t) {
                        self.c.cTypes = wasC
                        return t
                    }
                    if self.cArray(t) {
                        self.say(
                            line,
                            col,
                            "C gives an array as its first element's address: take a Pointer<{self.tname(self.elemOf(t))}> (and its count)",
                        )
                        return tyError
                    }
                    ps.push(t)
                }
                let ret = if result >= 0 { self.resolveType(result) } else { tyVoid }
                self.c.cTypes = wasC
                if self.isErr(ret) {
                    return ret
                }
                // -> Unit: C's void, as when the result is left out
                return self.p.cFnType(ps, if ret == self.p.tupleType([]) { tyVoid } else { ret })
            }
            var ps: [Int] = []
            var loose = false
            for prm in params {
                let t = self.resolveType(prm)
                loose = loose or self.isErr(t)
                ps.push(t)
            }
            let ret = if result >= 0 {
                self.resolveType(result) // an interface's fn log(...): nothing
            } else {
                tyVoid
            }
            if loose or self.isErr(ret) {
                // a template's T inside: a type of its own, not interned
                return self.p.addType(Type(.Fn, elem: ret, params: ps, isEffect: isEffect))
            }
            self.p.fnType(ps, ret, isEffect)
        }
        Map(key, value) => {
            let k = self.resolveType(key)
            let v = self.resolveType(value)
            if not self.keyable(k) {
                self.say(
                    line,
                    col,
                    "a map's key must support hashing and equality (a value == compares, with no array or map inside): found {self.tname(k)}",
                )
                return tyError
            }
            if self.isErr(k) {
                return k
            }
            if self.isErr(v) {
                return v
            }
            self.p.mapType(k, v)
        }
        Array(elem) => {
            let t = self.resolveType(elem)
            if self.isErr(t) { t } else { self.p.arrayType(t) }
        }
        Named(name, args) => self.resolveNamed(te, name, args, line, col)
    }
}

fn Checker.resolveNamed(var self, te: Int, name: Text, args: [Int], line: Int, col: Int) -> Int {
    let param = self.typeArgOf(name)
    if param >= 0 {
        return param
    }
    for k in 1..12 {
        // C's types: where Quark meets C
        if name == cTypeNames[k] and len(args) == 0 {
            if self.c.cTypes {
                return tyC + k
            }
            let quark = if k == ctText {
                "Text"
            } else if k >= ctF32 {
                "Float"
            } else {
                "Int"
            }
            self.say(
                line,
                col,
                "{name} is one of C's types: it is written in extern declarations and in Pointer<{name}> (in Quark it is {article(k == ctText)} {quark})",
            )
            return tyError
        }
    }
    if name == "Pointer" and len(args) == 1 and self.findDecl("Pointer") < 0 {
        // Pointer<T>: an address in C's memory
        let was = self.c.cTypes
        self.c.cTypes = true
        let elem = self.resolveType(args[0])
        self.c.cTypes = was
        if self.isErr(elem) {
            return elem
        }
        let et = self.p.types[elem]
        let laidOut = et.kind is Int | Float | Bool | Pointer | Handle
            or et.kind == Kind.Text and et.c != 0
            or et.kind == Kind.Record and self.p.ast.decls[et.decl].cStruct
        if not laidOut {
            self.say(
                line,
                col,
                "a Pointer points at what C lays out (Int32, Float64, CText, a Pointer, an extern type), not {self.tname(elem)}",
            )
            return tyError
        }
        return self.p.pointerType(elem)
    }
    if name == "Int" {
        return tyInt
    }
    if name == "Float" {
        return tyFloat
    }
    if name == "Bool" {
        return tyBool
    }
    if name == "Text" {
        return tyText
    }
    if name == "Bytes" {
        return tyBytes
    }
    if name == "Never" {
        return tyNever
    }
    if name == "Unit" and len(args) == 0 {
        return self.p.tupleType([])
    }
    if name == "Task" and len(args) == 0 {
        return tyTask
    }
    if name == "Self" and len(args) == 0 and self.jsonSelf >= 0 {
        return self.p.ast.decls[self.jsonSelf].ty
    }
    if name == "Self" and len(args) == 0 {
        if self.c.typing >= 0 and self.p.ast.decls[self.c.typing].isInterface {
            // fn compare(other: Self) -> Int: the type that fits the interface
            if self.selfMarker < 0 {
                self.selfMarker = self.p.addType(Type(.Error, typeVar: "Self"))
            }
            return self.selfMarker
        }
        // fn Vec2.plus(self, b: Self) -> Self: the receiver's type
        let f = self.selfOf()
        if f >= 0 {
            return self.resolveType(self.p.ast.params[self.p.ast.decls[f].params[0]].ty)
        }
        self.say(line, col, "Self names the type a function belongs to: use it in fn Type.name(self, ...)")
        return tyError
    }
    let d = self.findDecl(name)
    if d < 0 and name == "Set" and len(args) == 1 {
        // Set<Text>: each value once, in the order they came
        let k = self.resolveType(args[0])
        if self.isErr(k) {
            return k
        }
        if not self.keyable(k) {
            self.say(line, col, "a set holds values == compares, with no array or map inside, not {self.tname(k)}")
            return tyError
        }
        return self.p.mapType(k, tyVoid)
    }
    if d < 0 and name == "Entry" and len(args) == 2 {
        // a map's entry: Entry<Text, Int>
        let k = self.resolveType(args[0])
        let v = self.resolveType(args[1])
        if self.isErr(k) {
            return k
        }
        if self.isErr(v) {
            return v
        }
        return self.p.entryType(k, v)
    }
    if d >= 0 and not self.p.ast.decls[d].kind is Fn | Const {
        let x = self.p.ast.decls[d]
        let count = len(x.typeParams)
        if count != len(args) {
            if count > 0 {
                let more = if count > 1 { ", ..." } else { "" }
                self.say(line, col, "{x.name} takes {count} type{plural(count)}: {x.name}<{x.typeParams[0]}{more}>")
            } else {
                self.say(line, col, "{x.name} takes no types")
            }
            return tyError
        }
        if len(args) == 0 {
            return x.ty
        }
        var ts: [Int] = []
        for a in args {
            let t = self.resolveType(a)
            if self.isErr(t) {
                return t // inside a template: T is not known yet
            }
            ts.push(t)
        }
        return self.instanceType(d, ts)
    }
    if self.sayHidden(line, col, name, "type") {
        return tyError
    }
    var names = ["Int", "Float", "Bool", "Text", "Bytes", "Unit", "Never", "Entry", "Set", "Task", "Process", "Pointer"]
    for o in self.p.decls {
        let x = self.p.ast.decls[o]
        if len(names) < 512
            and x.kind is Type | Enum
            and x.templateOf < 0
            and not x.isTuple
            and self.seenFrom(self.c.module, o) {
            names.push(x.name)
        }
    }
    let close = closest(name, names)
    if close != "" {
        self.say(line, col, "unknown type \"{name}\": did you mean \"{close}\"?")
    } else {
        self.say(line, col, "unknown type \"{name}\"")
    }
    tyError
}

// a type written in a template, with its type parameters standing for these types (bound: -1 not known)
fn Checker.resolveWith(var self, te: Int, d: Int, bound: [Int]) -> Int {
    let typing = self.c.typing
    let view = self.c.view
    let viewArgs = self.c.viewArgs
    self.c.typing = d
    self.c.view = true
    self.c.viewArgs = bound
    let t = self.resolveType(te)
    self.c.typing = typing
    self.c.view = view
    self.c.viewArgs = viewArgs
    t
}

// ---- what == compares --------------------------------------------------------------------------------------------
// Numbers, Bools, texts, handles, cases (with their data), records and tuples, arrays, maps and sets of them, through
// boxes too (a type met again inside itself compares as far as the rest of it does). A map's key is any of them that
// holds no array or map (a key never changes): Float, (Text, Int), a case with data...
fn Checker.comparable(self, t: Int, key: Bool, open: [Int]) -> Bool {
    let ty = self.p.types[t]
    match ty.kind {
        Int | Float | Bool | Text | Bytes | Handle | Error | Pointer | CFn => true
        Void => not key
        // a set's values
        Array => not key and self.comparable(ty.elem, false, open)
        Map => not key and self.comparable(ty.key, true, open) and self.comparable(ty.elem, false, open)
        Enum | Record => {
            if t == tyNone or t == tyErr or ty.decl < 0 {
                return false
            }
            if open.contains(t) {
                return true
            }
            if len(open) == 32 {
                return false
            }
            let inner = open + [t]
            let d = self.p.ast.decls[ty.decl]
            if ty.kind == Kind.Record {
                for f in d.params {
                    if not self.fieldComparable(f, key, inner) {
                        return false
                    }
                }
                return true
            }
            if self.p.hasData(t) {
                for fields in d.caseFields {
                    for f in fields {
                        if not self.fieldComparable(f, key, inner) {
                            return false
                        }
                    }
                }
            }
            true
        }
        _ => false
    }
}

fn Checker.fieldComparable(self, prm: Int, key: Bool, open: [Int]) -> Bool {
    let b = self.p.ast.params[prm].binding
    if b < 0 {
        // not resolved yet (declared further down): by the type written
        let te = self.p.ast.params[prm].ty
        if te < 0 {
            return false
        }
        let node = self.p.ast.types[te].node
        return not node is Fn(_, _, _, _, _) and (not key or node is Named(_, _))
    }
    self.comparable(self.p.bindings[b].ty, key, open)
}

fn Checker.keyable(self, t: Int) -> Bool = self.comparable(t, true, [])

fn Checker.equatable(self, t: Int) -> Bool = self.comparable(t, false, [])

// ---- lambdas kept as values -----------------------------------------------------------------------------------------
// A lambda kept as a value (let f: (Int) -> Int = x => x * 2): a function of its own, which uses its parameters,
// constants and functions, and copies of the names around it it uses (captured). ret: -1 when the type does not say.
fn Checker.liftLambda(var self, lam: Int, params: [Int], ret: Int, isEffect: Bool, inferEffect: Bool) -> Bool {
    let Lambda(lamParams, body) = self.p.ast.exprs[lam].node else {
        return false
    }
    let line = self.p.ast.exprs[lam].line
    let col = self.p.ast.exprs[lam].col
    if len(lamParams) != len(params) {
        let n = len(lamParams)
        self.say(line, col, "this lambda takes {n} value{plural(n)}, but {len(params)} go into it here")
        return false
    }
    self.p.bindings.push(Binding("#env", tyInt, isParam: true))
    let env = len(self.p.bindings) - 1
    var declParams: [Int] = []
    for (i, prm) in lamParams.enumerate() {
        let x = self.p.ast.params[prm]
        self.p.bindings.push(Binding(x.name, params[i], isParam: true, line: x.line, col: x.col))
        let b = len(self.p.bindings) - 1
        self.p.ast.params[prm].binding = b
        declParams.push(self.p.ast.param(Param(x.name, -1, x.line, x.col, binding: b)))
    }
    declParams.push(self.p.ast.param(Param("#env", -1, line, col, binding: env)))
    let inTemplate = self.c.typing >= 0 and self.p.ast.decls[self.c.typing].isTemplate
        or self.c.fnDecl >= 0 and self.p.ast.decls[self.c.fnDecl].isTemplate
    let d = self.addDecl(
        Decl(
            kind: .Fn,
            name: "lambda at line {line}",
            line: line,
            col: col,
            params: declParams,
            body: body,
            module: self.c.module,
            isEffect: isEffect,
            retType: ret,
            isTemplate: inTemplate,
            lifted: true,
            inferEffect: inferEffect,
            env: env,
        ),
    )
    self.enter(Ctx(module: self.c.module, outer: len(self.saved)))
    self.checkFnBody(d)
    self.leave()
    self.p.ast.exprs[lam].decl = d
    let t = if ret >= 0 {
        self.p.fnType(params, ret, isEffect)
    } else {
        let r = self.p.ast.decls[d].retType
        self.p.fnType(params, if r >= 0 { r } else { tyError }, isEffect or self.p.ast.decls[d].isEffect)
    }
    self.setTy(lam, t)
    true
}

fn Checker.liftAs(var self, lam: Int, want: Int) -> Bool {
    let w = self.p.types[want]
    self.liftLambda(lam, w.params, w.elem, w.isEffect, false)
}

// What parallelMap's function gives back: plain values (numbers, Bools, cases, records of them), so each thread's
// memory can go when it is done.
fn Checker.plainValue(self, t: Int) -> Bool {
    let ty = self.p.types[t]
    match ty.kind {
        Int | Float | Bool | Handle => true
        Enum => {
            if self.p.hasData(t) {
                for fields in self.p.ast.decls[ty.decl].caseFields {
                    for f in fields {
                        if self.p.ast.params[f].boxed or not self.plainValue(self.paramType(f)) {
                            return false
                        }
                    }
                }
            }
            t != tyNone and t != tyErr
        }
        Record => {
            for f in self.p.ast.decls[ty.decl].params {
                if self.p.ast.params[f].boxed or not self.plainValue(self.paramType(f)) {
                    return false
                }
            }
            true
        }
        _ => false
    }
}

// What parallelMap's function gives back: a value without functions in it (no closures, no interfaces), so it can be
// copied out of the thread's memory, and out of its copy of the program, when the thread is done. seen: the records
// and enums looked into already (a type that holds itself).
fn Checker.sharedValue(self, t: Int, seen: [Int]) -> Bool {
    let ty = self.p.types[t]
    match ty.kind {
        Int | Float | Bool | Handle | Text | Bytes => true
        Array => self.sharedValue(ty.elem, seen)
        Map => self.sharedValue(ty.key, seen) and self.sharedValue(ty.elem, seen)
        Enum => {
            if t == tyNone or t == tyErr {
                return false // not a type yet
            }
            if seen.contains(t) or not self.p.hasData(t) {
                return true
            }
            for fields in self.p.ast.decls[ty.decl].caseFields {
                for f in fields {
                    if not self.sharedValue(self.paramType(f), seen + [t]) {
                        return false
                    }
                }
            }
            true
        }
        Record => {
            if seen.contains(t) {
                return true
            }
            if self.p.ast.decls[ty.decl].isInterface {
                return false
            }
            for f in self.p.ast.decls[ty.decl].params {
                if not self.sharedValue(self.paramType(f), seen + [t]) {
                    return false
                }
            }
            true
        }
        _ => false
    }
}

// xs.parallelFold(start, step) and xs.parallelFold(start, step, combine): each thread folds its part of the elements
// from start with step, and the parts are combined in order, from start, with combine (step itself when the
// accumulator is an element: then step must be associative and start its identity, as sum's 0). Both are pure
// functions of plain values, as parallelMap's.
fn Checker.checkParallelFold(var self, e: Int) -> Int {
    let args = self.argsOf(e)
    let names = self.namesOf(e)
    if len(args) < 3 or len(args) > 4 or len(args) == 4 and nameAt(names, 3) != "" and nameAt(names, 3) != "combine" {
        self.sayAt(
            e,
            "parallelFold takes an array, a start and a function, and a function that combines two parts: xs.parallelFold(start, step, combine)",
        )
        return tyError
    }
    let t = self.checkExpr(args[0], true)
    if not self.p.isIterable(t) {
        if not self.isErr(t) {
            self.typeError(args[0], "parallelFold goes over an array, a range or a loop, not %s", t, -1)
        }
        return tyError
    }
    self.markIterUse(args[0])
    let elem = self.elemOf(t)
    if self.kindOf(t) != Kind.Array {
        self.coerce(args[0], self.p.arrayType(elem), "parallelFold")
    }
    let acc = self.checkExpr(args[1], true)
    if self.isErr(acc) {
        return acc
    }
    if not self.plainValue(acc) {
        self.typeError(args[1], "parallelFold gives numbers, Bools, cases or records of them, not %s", acc, -1)
        return tyError
    }
    if not self.parallelFn(args[2], [acc, elem], acc, "step") {
        return tyError
    }
    if len(args) == 4 {
        if not self.parallelFn(args[3], [acc, acc], acc, "combine") {
            return tyError
        }
    } else if not self.same(acc, elem) {
        self.typeError(
            args[1],
            "parallelFold of a %s into another type needs a combine function: xs.parallelFold(start, step, (a, b) => ...)",
            elem,
            -1,
        )
        return tyError
    }
    self.p.ast.exprs[e].builtin = bParallelFold
    acc
}

// a function parallelFold runs on its threads: of the values params, giving ret, pure
fn Checker.parallelFn(var self, f: Int, params: [Int], ret: Int, what: Text) -> Bool {
    var ft = tyError
    if self.p.ast.exprs[f].node is Lambda(_, _) {
        if not self.liftLambda(f, params, ret, false, false) {
            return false
        }
        ft = self.ty(f)
    } else {
        ft = self.checkExpr(f, true)
    }
    if self.isErr(ft) {
        return false
    }
    let x = self.p.types[ft]
    if x.kind != Kind.Fn
        or len(x.params) != 2
        or not self.same(x.params[0], params[0])
        or not self.same(x.params[1], params[1])
        or not self.same(x.elem, ret) {
        self.typeError(f, "parallelFold's {what} needs a function of two values giving a %s here, not %s", ret, ft)
        return false
    }
    if x.isEffect {
        self.sayAt(f, "parallelFold runs pure functions (no effects): its threads change nothing")
        return false
    }
    true
}

// parallelMap(xs, f): f on every element, the elements shared out to the processor's threads. f is a function (a
// name, or a lambda that uses only its parameter: each thread runs it on its own).
fn Checker.checkParallelMap(var self, e: Int) -> Int {
    let args = self.argsOf(e)
    if len(args) != 2 {
        self.sayAt(e, "parallelMap takes an array and a function: xs.parallelMap(f)")
        return tyError
    }
    let t = self.checkExpr(args[0], true)
    if not self.p.isIterable(t) {
        if not self.isErr(t) {
            self.typeError(args[0], "parallelMap goes over an array, a range or a loop, not %s", t, -1)
        }
        return tyError
    }
    self.markIterUse(args[0])
    let elem = self.elemOf(t)
    if self.kindOf(t) != Kind.Array {
        let arr = self.p.arrayType(elem)
        self.coerce(args[0], arr, "parallelMap")
    }
    var ft = tyError
    if self.p.ast.exprs[args[1]].node is Lambda(_, _) {
        if not self.liftLambda(args[1], [elem], -1, false, false) {
            return tyError
        }
        ft = self.ty(args[1])
    } else {
        ft = self.checkExpr(args[1], true)
    }
    if self.isErr(ft) {
        return ft
    }
    let f = self.p.types[ft]
    if f.kind != Kind.Fn or len(f.params) != 1 or not self.same(f.params[0], elem) {
        self.typeError(args[1], "parallelMap needs a function of one %s here, not %s", -1, ft)
        return tyError
    }
    if f.isEffect {
        self.sayAt(args[1], "parallelMap runs pure functions (no effects): its threads change nothing")
        return tyError
    }
    if not self.sharedValue(f.elem, []) {
        self.typeError(args[1], "parallelMap gives values without functions in them, not %s", f.elem, -1)
        return tyError
    }
    self.p.ast.exprs[e].builtin = bParallelMap
    self.p.arrayType(f.elem)
}

// ---- interfaces ----------------------------------------------------------------------------------------------------
// An interface: a record whose fields are all functions (interface Speaker { fn speak() -> Text }). Any type with a
// function of its own for each (fn Dog.speak(self) -> Text) goes where one is wanted: the record of closures over
// the value, so a [Speaker] holds dogs and cats.
fn Checker.isInterface(self, t: Int) -> Bool {
    let ty = self.p.types[t]
    ty.kind == Kind.Record and ty.decl >= 0 and self.p.ast.decls[ty.decl].isInterface
}

// does m, a type's function, fit the interface's function of type ft?
// the type a member's function's value or result is, Self (in an interface) being have
fn Checker.asFor(self, t: Int, have: Int) -> Int =
    if t >= 0 and t == self.selfMarker { have } else { t }

fn Checker.fitsMember(var self, m: Int, ft: Int, at: Int, have: Int) -> Bool {
    if m < 0 {
        return false
    }
    let f = self.p.types[ft]
    let mp = self.p.ast.decls[m].params
    if len(mp) != len(f.params) + 1 {
        return false
    }
    if self.effectOf(m) and not f.isEffect or self.changesSelf(m) {
        return false
    }
    for (i, p) in f.params.enumerate() {
        if self.paramType(mp[i + 1]) != self.asFor(p, have) {
            return false
        }
    }
    self.fnReturnType(m, at) == self.asFor(f.elem, have)
}

// fn talk<T: Speaker>: does this type have each of the interface's functions, of its type? Said where it is called.
fn Checker.fitsInterface(var self, have: Int, w: Int, at: Int, fnName: Text, param: Text) -> Bool {
    for f in self.p.ast.decls[w].params {
        let ft = self.paramType(f)
        let fname = self.paramName(f)
        let m = self.typeFunction(have, fname)
        if not self.fitsMember(m, ft, at, have) {
            let hn = self.tname(have)
            let sig = memberText(self.p.ast, self.p.ast.params[f])
            self.sayAt(
                at,
                "{fnName} needs its {param} to fit {self.declName(w)}: {hn} has no {sig} of its own (fn {hn}.{fname}(self, ...))",
            )
            return false
        }
    }
    true
}

fn Checker.toInterface(var self, slot: Int, have: Int, want: Int) -> Bool {
    let w = self.declOf(want)
    let hn = self.tname(have)
    let wn = self.tname(want)
    for f in self.p.ast.decls[w].params {
        let ft = self.paramType(f)
        if self.selfMarker >= 0
            and (self.p.types[ft].elem == self.selfMarker or self.p.types[ft].params.contains(self.selfMarker)) {
            self.sayAt(
                slot,
                "{wn}'s functions take or give Self (the type that fits it): it is a bound (T: {wn}), not a value",
            )
            return false
        }
    }
    for f in self.p.ast.decls[w].params {
        // each field: the type's own function, of the same type
        let ft = self.paramType(f)
        let fname = self.paramName(f)
        let m = self.typeFunction(have, fname)
        if not self.fitsMember(m, ft, slot, have) {
            self.sayAt(slot, "{hn} cannot be a {wn}: it needs fn {hn}.{fname}(self, ...) of the type {self.tname(ft)}")
            return false
        }
    }
    let inner = self.p.ast.exprs[slot]
    let line = inner.line
    let col = inner.col
    self.p.bindings.push(Binding("#self", have, line: line, col: col))
    let selfBinding = len(self.p.bindings) - 1
    self.c.scope.push(selfBinding)
    self.p.ast.exprs.push(inner)
    let moved = len(self.p.ast.exprs) - 1
    var args = [moved]
    var ok = true
    for f in self.p.ast.decls[w].params {
        // (a, b) => #self.name(a, b), kept as a value
        let ft = self.paramType(f)
        let n = len(self.p.types[ft].params)
        var lamParams: [Int] = []
        var callArgs = [self.newExpr(.Name("#self"), line, col)]
        for i in 0..n {
            lamParams.push(self.p.ast.param(Param("#a{i}", -1, line, col)))
            callArgs.push(self.newExpr(.Name("#a{i}"), line, col))
        }
        let call = self.newExpr(.Call(self.paramName(f), "", callArgs, [""] * len(callArgs), true, false), line, col)
        let lam = self.newExpr(.Lambda(lamParams, call), line, col)
        ok = self.liftAs(lam, ft) and ok
        args.push(lam)
    }
    self.c.scope.pop()
    self.p.ast.exprs[slot] = Expr(
        .Call("#interface", "", args, [""] * len(args), false, false),
        line,
        col,
        ty: want,
        binding: selfBinding,
        builtin: bInterface,
        implicit: true,
    )
    ok
}

// ---- .Case and conversions -----------------------------------------------------------------------------------------
// .Leaf, .Circle(radius: 1): the case of the enum `want` (an optional or a result of one takes its Some or Ok)
fn Checker.resolveDotted(var self, e: Int, want: Int, where: Text) -> Bool {
    let en = self.declOf(want)
    let name = self.nameOf(e)
    if self.kindOf(want) != Kind.Enum or en < 0 or want == tyNone or want == tyErr or self.p.fallibleValue(want) >= 0 {
        self.sayAt(e, "{where}: expected {self.tname(want)}, found .{name} (a case of an enum)")
        self.setTy(e, tyError)
        return false
    }
    let cases = self.p.ast.decls[en].cases
    let k = cases.indexOf(name) ?? -1
    let template = self.p.ast.decls[en].templateOf
    let enumName = if template >= 0 {
        self.declName(template)
    } else {
        self.declName(en)
    }
    let n = if k >= 0 { len(self.p.ast.decls[en].caseFields[k]) } else { 0 }
    let isCase = self.p.ast.exprs[e].node is Case(_, _, _)
    if k < 0 {
        let close = closest(name, cases)
        if close != "" {
            self.sayAt(e, "{enumName} has no case {name}: did you mean .{close}?")
        } else {
            self.sayAt(e, "{enumName} has no case {name}")
        }
    } else if isCase and n > 0 {
        self.sayAt(e, "{enumName}.{name} carries data: .{name}(...)")
    } else if not isCase and n == 0 {
        self.sayAt(e, "{enumName}.{name} carries no data: write .{name}")
    } else {
        self.p.ast.exprs[e].decl = en
        self.p.ast.exprs[e].caseIndex = k
        self.setTy(e, want)
        if isCase or self.bindArgs(e, self.p.ast.decls[en].caseFields[k], name) {
            return true
        }
    }
    self.setTy(e, tyError)
    false
}

// the last statement's value of a block, when it is one: the block's value (-1: none)
fn Checker.blockValue(self, b: Int) -> Int {
    let stmts = self.p.ast.blocks[b].stmts
    if len(stmts) == 0 {
        return -1
    }
    let ExprStmt(value) = self.p.ast.stmts[stmts[len(stmts) - 1]].node else {
        return -1
    }
    value
}

fn Checker.blockResult(self, e: Int) -> Int {
    let BlockExpr(b, _) = self.p.ast.exprs[e].node else {
        return -1
    }
    self.blockValue(b)
}

// where a branch's value is: a block's last value, or the branch itself (a value, or a jump); -1: a block that
// gives none
fn Checker.branchSlot(self, body: Int) -> Int {
    let r = self.blockResult(body)
    if r >= 0 {
        return r
    }
    if self.p.ast.exprs[body].node is BlockExpr(_, false) {
        return -1
    }
    body
}

// An if, a match or a block whose branches give .Case values: each branch fitted to want
fn Checker.coerceBranches(var self, e: Int, want: Int, where: Text) -> Bool {
    var ok = true
    match self.p.ast.exprs[e].node {
        If(_, then, otherwise) => {
            let t = self.blockValue(then)
            if t >= 0 {
                ok = self.coerce(t, want, where) and ok
            }
            let other = if otherwise >= 0 { self.branchSlot(otherwise) } else { -1 }
            if other >= 0 {
                ok = self.coerce(other, want, where) and ok
            }
        }
        Match(_, arms, _) => {
            for a in arms {
                let arm = if self.p.ast.arms[a].expanded {
                    -1
                } else {
                    self.branchSlot(self.p.ast.arms[a].body)
                }
                if arm >= 0 {
                    ok = self.coerce(arm, want, where) and ok
                }
            }
        }
        _ => {
            let last = self.blockResult(e)
            if last >= 0 {
                ok = self.coerce(last, want, where) and ok
            }
        }
    }
    self.setTy(e, if ok { want } else { tyError })
    ok
}

// A function given where C wants a function (extern (A, B) -> R): a named function of the program, or a lambda that
// keeps nothing from around it. C calls it through code of its own, its values made Quark's on the way in.
fn Checker.toCFunction(var self, e: Int, want: Int, where: Text) -> Bool {
    let w = self.p.types[want]
    var params: [Int] = []
    for (i, p) in w.params.enumerate() {
        if i < 16 {
            params.push(self.p.plainType(p))
        }
    }
    let n = len(params)
    let ret = self.p.plainType(w.elem)
    let have = self.ty(e)
    if self.p.ast.exprs[e].node is Lambda(_, _) and have == tyLambda {
        let ft = self.p.fnType(params, ret, true)
        if not self.liftLambda(e, params, ret, true, true) {
            return false
        }
        let _ = ft
        let d = self.p.ast.exprs[e].decl
        if len(self.p.ast.decls[d].captureOuter) > 0 {
            let used = self.p.bindings[self.p.ast.decls[d].captureOuter[0]].name
            self.sayAt(
                e,
                "a C function value keeps nothing: this lambda uses {used} from around it (C gets only an address)",
            )
            return false
        }
        self.setTy(e, want)
        return true
    }
    let d = self.p.ast.exprs[e].decl
    if self.p.ast.exprs[e].node is Name(_)
        and d >= 0
        and self.p.ast.decls[d].kind == DeclKind.Fn
        and have >= 0
        and self.kindOf(have) == Kind.Fn {
        let dp = self.p.ast.decls[d].params
        var fits = len(dp) == n and self.same(self.fnReturnType(d, e), ret)
        for i in 0..n {
            if fits {
                fits = self.same(self.paramType(dp[i]), params[i])
            }
        }
        if not fits {
            self.typeError(
                e,
                "{where}: {self.declName(d)} does not fit %s (C's types are Quark's here: Int32 an Int, CText a Text), found %s",
                want,
                have,
            )
            return false
        }
        self.setTy(e, want)
        return true
    }
    if have >= 0 and self.kindOf(have) == Kind.Fn {
        self.sayAt(
            e,
            "a C function value keeps nothing: give a function's name, or a lambda that uses nothing around it",
        )
        return false
    }
    self.typeError(e, "{where}: expected %s, found %s", want, if have >= 0 { have } else { tyError })
    false
}

// A generic type's own type, before its types are known (Tree.Leaf of enum Tree<T>): it takes the Tree<Int> it goes
// into, as None takes the optional.
fn Checker.isPlaceholder(self, t: Int) -> Bool {
    let ty = self.p.types[t]
    ty.kind is Enum | Record
        and ty.decl >= 0
        and self.p.ast.decls[ty.decl].isTemplate
        and self.p.ast.decls[ty.decl].kind != DeclKind.Fn
}

fn Checker.isDotted(self, e: Int) -> Bool = match self.p.ast.exprs[e].node {
    Case(_, _, dotted) => dotted
    Call(_, _, _, _, _, dotted) => dotted
    _ => false
}

// the node an implicit conversion holds, through every one around it
fn Checker.underImplicit(self, e: Int) -> Int {
    var x = e
    while self.p.ast.exprs[x].implicit and self.p.ast.exprs[x].node is Call(_, _, args, _, _, _) and len(args) > 0 {
        x = args[0]
    }
    x
}

// every implicit node from e down to made: of type want
fn Checker.typeDown(var self, e: Int, made: Int, want: Int) {
    var x = e
    while true {
        self.setTy(x, want)
        if x == made {
            break
        }
        let args = self.argsOf(x)
        if len(args) == 0 {
            break
        }
        x = args[0]
    }
}

// Makes the node at slot fit `want`, converting when Quark allows it.
fn Checker.coerce(var self, slot: Int, want: Int, where: Text) -> Bool {
    let have = self.ty(slot)
    let wk = self.kindOf(want)
    let hk = self.kindOf(have)
    if wk == Kind.CFn and have != want and hk != Kind.Error and hk != Kind.Never {
        return self.toCFunction(slot, want, where)
    }
    if self.same(have, want) {
        if have == tyDot {
            self.setTy(slot, tyError) // said already, or a template's T: checked in its instances
        }
        return true
    }
    if have == tyDot and self.isDotted(slot) and self.p.fallibleValue(want) < 0 {
        return self.resolveDotted(slot, want, where)
    }
    if have == tyDot and self.p.ast.exprs[slot].node is If(_, _, _) | Match(_, _, _) | BlockExpr(_, _) {
        return self.coerceBranches(slot, want, where) // f(match c { "." => .Any, _ => .Lit(c) }): each branch's
    }
    if hk == Kind.Never and want == tyDot {
        return true // wrapped when the branches meet their enum
    }
    let haveValue = self.p.fallibleValue(have)
    if haveValue == tyNone
        and self.p.isResult(have)
        and self.p.isResult(want)
        and self.p.isOption(self.p.fallibleValue(want)) {
        // Ok(None) where a T?! goes: the None is a T?'s
        let made = self.underImplicit(slot)
        let margs = self.argsOf(made)
        if self.p.ast.exprs[made].node is Call(_, _, _, _, _, _)
            and self.p.ast.exprs[made].builtin == bOk
            and len(margs) == 1
            and self.coerce(margs[0], self.p.fallibleValue(want), where) {
            self.typeDown(slot, made, want)
            return true
        }
    }
    if haveValue == tyDot and (if self.p.isOption(have) {
        self.p.isOption(want)
    } else {
        self.p.isResult(want)
    }) {
        // Some(.Red), Ok(.Red)
        let made = self.underImplicit(slot)
        let b = self.p.ast.exprs[made].builtin
        let margs = self.argsOf(made)
        if self.p.ast.exprs[made].node is Call(_, _, _, _, _, _)
            and (b == bSome or b == bOk)
            and len(margs) == 1
            and self.coerce(margs[0], self.p.fallibleValue(want), where) {
            self.typeDown(slot, made, want)
            return true
        }
    }
    if haveValue >= 0
        and self.kindOf(haveValue) == Kind.Fn
        and self.p.isOption(have)
        and self.p.isOption(want)
        and self.kindOf(self.p.fallibleValue(want)) == Kind.CFn {
        // Some(compare) where a (extern (A) -> R)? goes: the function's C entry
        let made = self.underImplicit(slot)
        let margs = self.argsOf(made)
        if self.p.ast.exprs[made].node is Call(_, _, _, _, _, _)
            and self.p.ast.exprs[made].builtin == bSome
            and len(margs) == 1
            and self.coerce(margs[0], self.p.fallibleValue(want), where) {
            self.typeDown(slot, made, want)
            return true
        }
    }
    if hk == Kind.Never {
        // exit(1), panic("...") where a value goes: it never gets there
        if wk != Kind.Void and wk != Kind.Never {
            self.wrap(slot, bNever, want)
        }
        return true
    }
    if hk == Kind.Void and want == self.p.tupleType([]) {
        return true // print(x) where a Unit goes: () is nothing
    }
    if have == tyNone and self.p.isOption(want) {
        // None takes the type
        self.setTy(slot, want)
        self.p.ast.exprs[slot].decl = self.declOf(want)
        return true
    }
    if have == tyLambda and wk == Kind.Fn and self.p.ast.exprs[slot].node is Lambda(_, _) {
        return self.liftAs(slot, want)
    }
    if hk == Kind.Fn
        and wk == Kind.Fn
        and have != tyLambda
        and not self.p.types[have].isEffect
        and self.p.types[want].isEffect {
        let h = self.p.types[have]
        if self.p.fnType(h.params, h.elem, true) == want {
            // a pure function where an effect one goes
            self.setTy(slot, want)
            return true
        }
    }
    if self.isPlaceholder(have)
        and self.declOf(want) >= 0
        and self.p.ast.decls[self.declOf(want)].templateOf == self.declOf(have) {
        // Tree.Leaf takes the Tree<T>
        self.setTy(slot, want)
        self.p.ast.exprs[slot].decl = self.declOf(want)
        return true
    }
    if have == tyEmpty and wk == Kind.Array {
        self.setTy(slot, want) // [] takes the type
        return true
    }
    if self.p.isSet(want) and self.p.ast.exprs[slot].node is ArrayLit(items) and hk == Kind.Array {
        // let s: Set<Text> = ["a", "b"]
        for item in items {
            if not self.coerce(item, self.keyOf(want), where) {
                return false
            }
        }
        let arr = self.p.arrayType(self.keyOf(want))
        self.setTy(slot, arr)
        self.wrap(slot, bToSet, want)
        return true
    }
    if have == tyEmptyMap and wk == Kind.Map {
        self.setTy(slot, want) // [:] takes the type
        return true
    }
    if have == tyErr and self.p.isResult(want) {
        // Err("...") takes the T! it goes into, and holds its error type
        let err = self.underImplicit(slot)
        let eargs = self.argsOf(err)
        if self.p.ast.exprs[err].node is Call(_, _, _, _, _, _)
            and self.p.ast.exprs[err].builtin == bErr
            and len(eargs) == 1
            and not self.coerce(eargs[0], self.p.errorOf(want), "Err's value") {
            return false
        }
        self.setTy(slot, want)
        return true
    }
    if self.p.isResult(have)
        and self.p.isResult(want)
        and self.p.errorOf(have) == tyText
        and self.same(self.p.fallibleValue(have), self.p.fallibleValue(want)) {
        // Ok(x) takes the T ! E it goes into
        let ok = self.underImplicit(slot)
        if self.p.ast.exprs[ok].node is Call(_, _, _, _, _, _) and self.p.ast.exprs[ok].builtin == bOk {
            self.typeDown(slot, ok, want)
            return true
        }
    }
    let haveFallible = haveValue >= 0
    if self.p.isOption(want) and not haveFallible and have != tyNone and have != tyErr {
        // a T (or an Int for a Float?) where a T? goes: Some(it)
        if not self.coerce(slot, self.p.fallibleValue(want), where) {
            return false
        }
        self.wrap(slot, bSome, want)
        return true
    }
    if self.p.isResult(want) and not haveFallible and have != tyNone and have != tyErr {
        // a T where a T! goes: Ok(it)
        if not self.coerce(slot, self.p.fallibleValue(want), where) {
            return false
        }
        self.wrap(slot, bOk, want)
        return true
    }
    if hk == Kind.Int and wk == Kind.Float {
        self.wrap(slot, bToFloat, tyFloat)
        return true
    }
    if wk == Kind.Bytes
        and (have == tyEmpty
            or self.p.isIterable(have) and self.elemOf(have) >= 0 and self.kindOf(self.elemOf(have)) == Kind.Int) {
        // [1, 2, 255], [], a loop of Ints where Bytes go: each one a byte (a constant past 0..255 is an error here)
        if self.p.ast.exprs[slot].node is ArrayLit(items) {
            for x in items {
                var bad = false
                var shown = ""
                match self.p.ast.exprs[x].node {
                    IntLit(v, _) => if v < 0 or v > 255 {
                        bad = true
                        shown = v.toText()
                    }
                    Unary(op, operand) => if op == Op.Minus
                        and self.p.ast.exprs[operand].node is IntLit(v, _)
                        and v != 0 {
                        bad = true
                        shown = "-{v}"
                    }
                    _ => {}
                }
                if bad {
                    self.sayAt(x, "a byte is 0 to 255, not {shown}")
                    return false
                }
            }
            let arr = self.p.arrayType(tyInt)
            self.setTy(slot, arr)
        }
        self.markIterUse(slot)
        self.wrap(slot, bToBytes, tyBytes)
        return true
    }
    if hk is Range | Iter | Bytes and wk == Kind.Array and self.same(self.elemOf(have), self.elemOf(want)) {
        self.wrap(slot, bToArray, want)
        return true
    }
    if wk == Kind.Record and have != want and self.hasOperators(have) and self.isInterface(want) {
        return self.toInterface(slot, have, want)
    }
    self.typeError(slot, "{where}: expected %s, found %s", want, have)
    false
}

// The source of a loop, seen through implicit wrappers: a name used as a loop's source.
fn Checker.markIterUse(var self, e: Int) {
    let x = self.underImplicit(e)
    let b = self.p.ast.exprs[x].binding
    if self.p.ast.exprs[x].node is Name(_) and b >= 0 {
        self.p.bindings[b].iterUses += 1
    }
}

// Int with Float: both become Float. The common type, or -1.
fn Checker.unifyNumeric(var self, a: Int, b: Int) -> Int {
    let ta = self.ty(a)
    let tb = self.ty(b)
    if ta == tb {
        return ta
    }
    if self.kindOf(ta) == Kind.Int and self.kindOf(tb) == Kind.Float {
        self.coerce(a, tyFloat, "")
        return tyFloat
    }
    if self.kindOf(ta) == Kind.Float and self.kindOf(tb) == Kind.Int {
        self.coerce(b, tyFloat, "")
        return tyFloat
    }
    -1
}

// An Int with a Float: compared exactly, as numbers, not with the Int rounded to a Float (9007199254740993 ==
// 9007199254740992.0 is false). An Int literal a Float holds exactly is just made one.
fn Checker.compareNumeric(var self, a: Int, b: Int) {
    if self.ty(a) == self.ty(b) {
        return
    }
    let integer = if self.ty(a) == tyInt { a } else { b }
    if self.p.ast.exprs[integer].node is IntLit(v, _) {
        let value = toFloat(v)
        if value < 9223372036854775808.0 and toInt(value) == v {
            let _ = self.unifyNumeric(a, b)
        }
    }
}

// ---- functions of a type, and operators ----------------------------------------------------------------------------
// A type the program declares (a record, an enum, a host handle) can have functions of its own: fn Vec2.plus. They
// are called as v.f(...) (or f(v, ...)), and its operators go through them: a + b is a's type's plus.
fn Checker.hasOperators(self, t: Int) -> Bool {
    let ty = self.p.types[t]
    if ty.kind is Record | Handle {
        return true
    }
    ty.kind == Kind.Enum and t != tyNone and t != tyErr and ty.decl >= 0 and self.p.fallibleValue(t) < 0
}

fn Checker.typeFunction(var self, t: Int, name: Text) -> Int {
    if not self.hasOperators(t) {
        return -1
    }
    let td = self.declOf(t)
    let template = self.p.ast.decls[td].templateOf
    let owner = if template >= 0 { template } else { td }
    let full = "{self.declName(owner)}.{name}"
    var d = self.findDecl(full)
    if d < 0 {
        // a type's functions go with its values: from its own file too (a generic of std on a program's type)
        let om = self.p.ast.decls[owner].module
        let opaque = self.p.ast.decls[owner].opaque
        for o in self.byName[full] ?? [] {
            let x = self.p.ast.decls[o]
            if d < 0
                and x.module == om
                and x.kind == DeclKind.Fn
                and (not opaque or x.isPub or x.module == self.c.module) {
                d = o
            }
        }
    }
    if d >= 0 and self.p.ast.decls[d].kind == DeclKind.Fn {
        d
    } else {
        -1
    }
}

// Some type has a function of this name: a call to it may mean that one.
fn Checker.anyTypeFunction(self, name: Text) -> Bool = self.methods.contains(name)

fn operatorWord(op: Op?) -> Text = match op {
    Some(Plus) => "plus"
    Some(Minus) => "minus"
    Some(Star) => "times"
    Some(Slash) => "div"
    Some(Percent) => "rem"
    _ => "negate"
}

// a + b (or -a) on a type of the program: a call to its function (decl, ordered); the operands are checked already.
// In text and in graphs it stays an operator.
fn Checker.checkOperator(var self, e: Int, scalarFirst: Bool) -> Int {
    var unary = false
    var op: Op? = None
    var first = -1
    var second = -1
    match self.p.ast.exprs[e].node {
        Unary(_, operand) => {
            unary = true
            first = operand
        }
        Binary(o, left, right) => {
            op = o
            first = if scalarFirst { right } else { left }
            second = if scalarFirst { left } else { right }
        }
        _ => {
            return tyError
        }
    }
    let t = self.ty(first)
    let word = operatorWord(op)
    let symbol = if op is Some(o) { o.name() } else { "-" }
    let d = self.typeFunction(t, word)
    if d < 0 {
        let n = self.tname(t)
        if unary {
            self.sayAt(e, "{n} has no -: write fn {n}.negate(self) -> {n}")
        } else {
            self.sayAt(e, "{n} has no {symbol}: write fn {n}.{word}(self, b: ...) -> ...")
        }
        return tyError
    }
    let want = if unary { 1 } else { 2 }
    if len(self.p.ast.decls[d].params) != want {
        self.sayAt(e, "{self.declName(d)} takes {want} value{plural(want)} to be the operator {symbol}")
        return tyError
    }
    self.usesEffectsOf(e, d, 0)
    var ordered = [first]
    if not unary {
        ordered.push(second)
        if self.isLoop(self.ty(second)) {
            self.markIterUse(second)
        }
        if not self.coerce(second, self.paramType(self.p.ast.decls[d].params[1]), self.declName(d)) {
            return tyError
        }
    }
    self.p.ast.exprs[e].decl = d
    self.p.ast.exprs[e].ordered = ordered
    self.fnReturnType(d, e)
}

// ---- effects -------------------------------------------------------------------------------------------------------
// A call that changes the world (print, now, the host's effect fns, or a function that makes one) makes the function
// it is in change the world too: effects are inferred, never written on a function with a body. A lambda given to
// map, filter... and a constant never have any, so they can be fused, reordered, cached, and run on several threads.
// Where nothing can be inferred (extern effect fn, effect (A) -> R) it is written.
fn Checker.effectPlace(self) -> Int {
    if self.c.pureDepth > 0 {
        return inLambda
    }
    let f = self.c.fnDecl
    if self.c.inConst or f < 0 {
        return inConst
    }
    let d = self.p.ast.decls[f]
    if d.lifted and not d.isEffect and not d.inferEffect {
        return inKept
    }
    inBody
}

fn Checker.effectError(var self, module: Int, line: Int, col: Int, place: Int, what: Text) {
    let message = if place == inLambda {
        "{what} has effects: this lambda must be pure (map, filter... take pure functions; a parameter takes effects when its type says so, f: effect (T) -> R)"
    } else if place == inConst {
        "{what} has effects: a constant cannot have any"
    } else if place == inKept {
        "{what} has effects: this lambda's type says it has none (write effect (A) -> R)"
    } else {
        "{what} has effects, found only after its type was given as pure (a function that calls itself through it)"
    }
    self.errors.add(self.p.modules[module].src, line, col, message)
}

fn Checker.needEffect(var self, e: Int, what: Text) {
    let place = self.effectPlace()
    if place == inBody {
        self.p.ast.decls[self.c.fnDecl].isEffect = true
    } else {
        self.effectError(self.c.module, self.p.ast.exprs[e].line, self.p.ast.exprs[e].col, place, what)
    }
}

// d's body, checked now (in a context of its own) if it was not yet: what it gives, and whether it has effects
fn Checker.checkNow(var self, d: Int) {
    let x = self.p.ast.decls[d]
    if self.isCFunction(d) or x.state != 0 or x.isTemplate or x.lifted {
        return
    }
    let inner = self.c with { scope: [], lets: [], inConst: false, hint: -1, outer: -1, keepIs: false, declaring: "", dotted: [
        
    ] }
    self.enter(inner)
    self.checkFnBody(d)
    self.leave()
}

fn Checker.effectOf(var self, d: Int) -> Bool {
    self.checkNow(d)
    self.p.ast.decls[d].isEffect
}

// e uses d (calls it, through an operator too, or takes it as a value): d's effects are the user's
fn Checker.usesEffectsOf(var self, e: Int, d: Int, place: Int) {
    if self.effectOf(d) {
        if place == asValue {
            return // its type says so
        }
        self.needEffect(e, self.declName(d))
        return
    }
    if self.isCFunction(d) {
        return
    }
    let at = if place == asValue { place } else { self.effectPlace() }
    self.effectUses.push(
        EffectUse(self.c.fnDecl, d, self.p.ast.exprs[e].line, self.p.ast.exprs[e].col, self.c.module, at),
    )
}

fn Checker.settleEffects(var self) {
    var changed = true
    while changed {
        changed = false
        for u in self.effectUses {
            if u.place == inBody
                and u.user >= 0
                and self.p.ast.decls[u.used].isEffect
                and not self.p.ast.decls[u.user].isEffect
                and not self.p.ast.decls[u.user].lifted {
                self.p.ast.decls[u.user].isEffect = true
                changed = true
            }
        }
    }
    for u in self.effectUses {
        if not self.p.ast.decls[u.used].isEffect {
            continue
        }
        if u.place != inBody {
            self.effectError(u.module, u.line, u.col, u.place, self.declName(u.used))
        } else if u.user >= 0 and self.p.ast.decls[u.user].lifted and not self.p.ast.decls[u.user].isEffect {
            self.effectError(u.module, u.line, u.col, asValue, self.declName(u.used))
        }
    }
    self.effectUses = []
}

// ---- lambdas given to functions ------------------------------------------------------------------------------------
// Checks a function argument: a lambda, or a function's name (made into one). Its result type. A lambda given to a
// parameter typed effect (T) -> R may have effects: they are the caller's, where it is written.
fn Checker.checkLambda(var self, slot: Int, paramTypes: [Int], maxParams: Int, minParams: Int, builtin: Text) -> Int =
    self.checkLambdaAs(slot, paramTypes, maxParams, minParams, builtin, false)

fn Checker.checkLambdaAs(
    var self,
    slot: Int,
    paramTypes: [Int],
    maxParams: Int,
    minParams: Int,
    builtin: Text,
    effects: Bool,
) -> Int {
    let line = self.p.ast.exprs[slot].line
    let col = self.p.ast.exprs[slot].col
    var isName = false
    var name = ""
    if self.p.ast.exprs[slot].node is Name(n) {
        isName = true
        name = n
    }
    let fb = if isName { self.lookupOrCapture(-1, name) } else { -1 }
    let fbFn = fb >= 0 and self.kindOf(self.bindingType(fb)) == Kind.Fn
    let kept = fbFn and self.p.bindings[fb].lambda < 0 and not self.p.bindings[fb].fnParam // a function kept as a value
    if fbFn and not kept {
        // a function this one was given: the caller's lambda
        let ft = self.p.types[self.bindingType(fb)]
        let n = len(ft.params)
        if n < minParams or n > maxParams {
            self.say(
                line,
                col,
                "{builtin} needs a function of {minParams} value{plural(minParams)} here; {name} takes {n}",
            )
            return tyError
        }
        for (i, pt) in ft.params.enumerate() {
            if not self.same(pt, paramTypes[i]) {
                self.typeError(slot, "this function takes %s, but %s is given here", pt, paramTypes[i])
            }
        }
        self.p.ast.exprs[slot].binding = fb
        self.p.bindings[fb].uses += 1
        let lambda = self.p.bindings[fb].lambda
        if lambda < 0 {
            return ft.elem // a template, checked loosely
        }
        self.p.ast.exprs[slot] = self.p.ast.exprs[lambda]
        return ft.elem
    }
    if isName {
        let d = if self.lookup(name) >= 0 { -1 } else { self.findDecl(name) }
        // a function's name, or a built-in's (len, abs, upper...: as many values as are given here)
        let arity = if kept {
            len(self.p.types[self.bindingType(fb)].params)
        } else if d >= 0 and self.p.ast.decls[d].kind == DeclKind.Fn {
            len(self.p.ast.decls[d].params)
        } else if d < 0 and self.lookup(name) < 0 and self.builtinNamed(name) > 0 {
            minParams
        } else {
            -1
        }
        if arity >= 0 {
            if arity < minParams or arity > maxParams {
                self.say(
                    line,
                    col,
                    "{builtin} needs a function of {minParams} value{plural(minParams)} here; {name} takes {arity}",
                )
                return tyError
            }
            var lamParams: [Int] = []
            var refs: [Int] = []
            for i in 0..arity {
                lamParams.push(self.p.ast.param(Param("#{i}", -1, line, col)))
                refs.push(self.newExpr(.Name("#{i}"), line, col))
            }
            let call = self.newExpr(.Call(name, "", refs, [""] * arity, false, false), line, col)
            let moved = self.replace(slot, Expr(.Lambda(lamParams, call), line, col))
            self.p.ast.exprs[slot].sugar = moved
        }
    }
    let Lambda(params, _) = self.p.ast.exprs[slot].node else {
        self.say(line, col, "{builtin} needs a function here: a lambda (x => ...) or a function's name")
        self.checkExpr(slot, true)
        return tyError
    }
    let count = len(params)
    let whole = if maxParams == 1 and self.kindOf(paramTypes[0]) == Kind.Record {
        self.declOf(paramTypes[0])
    } else {
        -1
    }
    let spreads = whole >= 0 and (self.p.ast.decls[whole].isTuple or self.p.ast.decls[whole].isEntry)
    if count >= 2 and spreads and len(self.p.ast.decls[whole].params) == count {
        // (i, x) => ... over (index, value) tuples, (k, v) => ... over a map's entries: the fields, as for (i, x) in
        self.p.ast.exprs[slot].spread = paramTypes[0]
        var fields: [Int] = []
        for f in self.p.ast.decls[whole].params {
            fields.push(self.paramType(f))
        }
        return self.checkLambdaBody(slot, fields, builtin, effects)
    }
    if count < minParams or count > maxParams {
        if minParams == 1 and maxParams == 1 and count == 2 and spreads {
            self.say(
                line,
                col,
                "this lambda takes 1 value in {builtin}, or one for each of its {len(self.p.ast.decls[whole].params)} fields",
            )
        } else if minParams == maxParams {
            self.say(line, col, "this lambda takes {minParams} value{plural(minParams)} in {builtin}")
        } else {
            self.say(line, col, "this lambda takes {minParams} or {maxParams} values in {builtin}")
        }
        return tyError
    }
    self.checkLambdaBody(slot, paramTypes, builtin, effects)
}

// a lambda's body, its values named (paramTypes: each one's type)
fn Checker.checkLambdaBody(var self, e: Int, paramTypes: [Int], builtin: Text, effects: Bool) -> Int {
    let Lambda(params, body) = self.p.ast.exprs[e].node else {
        return tyError
    }
    let mark = len(self.c.scope)
    let pureFn = self.c.pureFn
    let pureScope = self.c.pureScope
    self.c.loopDepth += 1
    self.c.lambdaDepth += 1
    if not effects {
        self.c.pureDepth += 1
        self.c.pureFn = builtin
        self.c.pureScope = mark
    }
    for (i, prm) in params.enumerate() {
        let x = self.p.ast.params[prm]
        self.p.bindings.push(
            Binding(x.name, paramTypes[i], isParam: true, depth: self.c.loopDepth, line: x.line, col: x.col),
        )
        let b = len(self.p.bindings) - 1
        self.p.ast.params[prm].binding = b
        self.c.scope.push(b)
    }
    let t = self.checkExpr(body, true)
    self.truncate(mark)
    self.c.loopDepth -= 1
    self.c.lambdaDepth -= 1
    if not effects {
        self.c.pureDepth -= 1
    }
    self.c.pureFn = pureFn
    self.c.pureScope = pureScope
    self.setTy(e, t)
    t
}

// ---- calls of the built-ins ----------------------------------------------------------------------------------------
fn Checker.argCount(var self, e: Int, lo: Int, hi: Int) -> Bool {
    let n = len(self.argsOf(e))
    if n >= lo and n <= hi {
        return true // the names were checked by namedBuiltinArgs
    }
    let name = self.nameOf(e)
    if lo == hi {
        self.sayAt(e, "{name} takes {lo} value{plural(lo)}, not {n}")
    } else {
        self.sayAt(e, "{name} takes {lo} to {hi} values, not {n}")
    }
    false
}

// the values a loop goes over: an array's, a range's, a loop's, a map's entries, a set's values, or a type's
// items(); i: the call's value
fn Checker.checkSource(var self, e: Int, i: Int) -> Int = self.checkSourceExpr(self.argsOf(e)[i])

fn Checker.checkSourceExpr(var self, a: Int) -> Int {
    let t = self.checkExpr(a, true)
    if self.p.isSet(t) {
        // a set: its values, in the order they came
        let it = self.p.iterType(self.keyOf(t))
        self.wrap(a, bEntries, it)
        return self.keyOf(t)
    }
    if self.kindOf(t) == Kind.Map and self.keyOf(t) >= 0 {
        // a map: its entries, Entry(key, value), in the order the keys came
        let entry = self.p.entryType(self.keyOf(t), self.elemOf(t))
        let it = self.p.iterType(entry)
        self.wrap(a, bEntries, it)
        return entry
    }
    if not self.p.isIterable(t) and self.hasOperators(t) and self.typeFunction(t, "items") >= 0 {
        self.p.ast.exprs[a].typed = true
        let line = self.p.ast.exprs[a].line
        let col = self.p.ast.exprs[a].col
        let items = self.newExpr(.Call("items", "", [a], [""], true, false), line, col)
        self.p.ast.exprs[items].implicit = true
        let result = self.checkExpr(items, true)
        if self.kindOf(result) != Kind.Array or self.elemOf(result) < 0 {
            if not self.isErr(result) {
                self.typeError(a, "items() must return an array, not %s", result, -1)
            }
            return tyError
        }
        // the call takes the source's place
        let call = self.p.ast.exprs[items]
        let moved = self.replace(a, call)
        self.p.ast.exprs[a].node = .Call("items", "", [moved], [""], true, false)
        let ordered = self.p.ast.exprs[a].ordered.map(o => if o == a { moved } else { o })
        self.p.ast.exprs[a].ordered = ordered // the call's receiver too: the source, not the call
        return self.elemOf(result)
    }
    if self.isErr(t) {
        return t
    }
    if not self.p.isIterable(t) {
        self.typeError(a, "expected an array, a map, a range or a loop, found %s", t, -1)
        return tyError
    }
    self.markIterUse(a)
    self.elemOf(t)
}

// what toText and "{x}" take
fn Checker.printable(self, t: Int) -> Bool {
    let ty = self.p.types[t]
    match ty.kind {
        Array => self.printable(ty.elem)
        Map => ty.key >= 0 and self.printable(ty.key) and (self.p.isSet(t) or self.printable(ty.elem))
        Range | Iter | Void | Error | Fn | CFn => false
        _ => true
    }
}

// a value made text ("{p}", toText(p)): what print writes (a loop, the array it gives), a case without its enum's name
fn Checker.asText(var self, slot: Int, what: Text) -> Int {
    let t = self.checkExpr(slot, true)
    if self.isLoop(t) {
        self.markIterUse(slot)
        let arr = self.p.arrayType(self.elemOf(t))
        self.coerce(slot, arr, if what != "" { what } else { "a text's value" })
        return self.ty(slot)
    }
    if not self.isErr(t) and not self.printable(t) {
        self.typeError(slot, "%s has no text form (a function does not)", t, -1)
    }
    t
}

// What sorted and < order: numbers, texts, Bools, cases without data, and types with fn T.compare(a, b) -> Int.
fn Checker.orderable(var self, t: Int) -> Bool {
    let k = self.kindOf(t)
    if k is Int | Float | Text | Bytes | Bool | Error {
        return true
    }
    if k is Enum | Record | Handle {
        if k == Kind.Enum
            and self.declOf(t) >= 0
            and not self.p.hasData(t)
            and self.p.fallibleValue(t) < 0
            and self.typeFunction(t, "compare") < 0 {
            return true
        }
        let d = self.typeFunction(t, "compare")
        return d >= 0 and len(self.p.ast.decls[d].params) == 2
    }
    false
}

// every built-in's values, by name, in their order (the catalog's): a call may name them (split(t, separator: ","))
const builtinParams: [(Text, Text)] = [
    ("sqrt", "x: Float"),
    ("sin", "x: Float"),
    ("cos", "x: Float"),
    ("tan", "x: Float"),
    ("asin", "x: Float"),
    ("acos", "x: Float"),
    ("atan", "x: Float"),
    ("atan2", "y: Float, x: Float"),
    ("exp", "x: Float"),
    ("log", "x: Float"),
    ("pow", "x: Float, y: Float"),
    ("abs", "x: Number"),
    ("floor", "x: Float"),
    ("ceil", "x: Float"),
    ("round", "x: Float"),
    ("toFloat", "x: Int"),
    ("toInt", "x: Float"),
    ("min", "a: Number, b: Number"),
    ("max", "a: Number, b: Number"),
    ("clamp", "value: Number, low: Number, high: Number"),
    ("lerp", "a: Float, b: Float, t: Float"),
    ("map", "source: Loop<T>, f: fn(T) -> U"),
    ("filter", "source: Loop<T>, keep: fn(T) -> Bool"),
    ("fold", "source: Loop<T>, start: A, f: fn(A, T) -> A"),
    ("sum", "source: Loop<Number>"),
    ("min", "source: Loop<Number>"),
    ("max", "source: Loop<Number>"),
    ("any", "source: Loop<T>, test: fn(T) -> Bool"),
    ("all", "source: Loop<T>, test: fn(T) -> Bool"),
    ("len", "source: Loop<T>"),
    ("toArray", "source: Loop<T>"),
    ("toSet", "source: Loop<T>"),
    ("push", "list: [T] (a var), value: T"),
    ("pop", "list: [T] (a var)"),
    ("first", "source: Loop<T>, test: fn(T) -> Bool (may be left out)"),
    ("last", "source: Loop<T>, test: fn(T) -> Bool (may be left out)"),
    ("count", "source: Loop<T>, test: fn(T) -> Bool"),
    ("contains", "source: Loop<T>, value: T"),
    ("indexOf", "source: Loop<T>, value: T"),
    ("minBy", "source: Loop<T>, key: fn(T) -> K"),
    ("maxBy", "source: Loop<T>, key: fn(T) -> K"),
    ("sorted", "source: Loop<T>, descending: Bool (may be left out)"),
    ("sortedBy", "source: Loop<T>, key: fn(T) -> K, descending: Bool (may be left out)"),
    ("take", "source: Loop<T>, count: Int"),
    ("enumerate", "source: Loop<T>"),
    ("skip", "source: Loop<T>, count: Int"),
    ("countBy", "source: Loop<T>, key: fn(T) -> K"),
    ("mean", "source: Loop<Number>"),
    ("get", "list: [T], index: Int"),
    ("panic", "message: Text"),
    ("parallelMap", "source: Loop<T>, f: fn(T) -> U"),
    ("parallelFold", "source: Loop<T>, start: A, step: fn(A, T) -> A, combine: fn(A, A) -> A (may be left out)"),
    ("reversed", "source: Loop<T>"),
    ("keys", "map: [K: V]"),
    ("values", "map: [K: V]"),
    ("contains", "map: [K: V], key: K"),
    ("remove", "map: [K: V] (a var), key: K"),
    ("add", "set: Set<T> (a var), value: T"),
    ("remove", "set: Set<T> (a var), value: T"),
    ("len", "map: [K: V]"),
    ("Some", "value: T"),
    ("Ok", "value: T"),
    ("Err", "message: Text"),
    ("mapErr", "result: T ! E, f: fn(E) -> F"),
    ("index", "case: an enum"),
    ("words", "text: Text"),
    ("lines", "text: Text"),
    ("contains", "text: Text, part: Text"),
    ("indexOf", "text: Text, part: Text"),
    ("startsWith", "text: Text, part: Text"),
    ("endsWith", "text: Text, part: Text"),
    ("replace", "text: Text, old: Text, new: Text"),
    ("upper", "text: Text"),
    ("lower", "text: Text"),
    ("join", "texts: Loop<Text>, separator: Text"),
    ("assert", "condition: Bool, message: Text (may be left out)"),
    ("toText", "value: Any"),
    ("len", "text: Text"),
    ("split", "text: Text, separator: Text"),
    ("trim", "text: Text"),
    ("parseInt", "text: Text"),
    ("parseFloat", "text: Text"),
    ("print", "values: Any..."),
    ("printErr", "values: Any..."),
    ("bytes", "text: Text"),
    ("Text", "bytes: Bytes"),
    ("len", "bytes: Bytes"),
    ("push", "bytes: Bytes (a var), value: Int"),
    ("char", "codePoint: Int"),
    ("codePoints", "text: Text"),
]

// Is `name` the name of a built-in's value at place `at` (fn split(text, separator): 1 is separator)? Else what the
// first entry that has a value there calls it ("" none).
fn builtinParam(fnName: Text, at: Int, name: Text) -> (Bool, Text) {
    var expected = ""
    var any = false
    for (n, params) in builtinParams {
        if n != fnName {
            continue
        }
        let pieces = params.split(", ")
        if params == "" or at >= len(pieces) {
            continue
        }
        let piece = pieces[at]
        let colon = piece.indexOf(":") ?? len(piece)
        let named = piece[..colon]
        if named == name {
            return (true, "")
        }
        if not any {
            expected = named
        }
        any = true
    }
    (false, expected)
}

// split(t, separator: ","): a built-in's values may be named, in their order (a name says what the value is)
fn Checker.namedBuiltinArgs(var self, e: Int) -> Bool {
    let args = self.argsOf(e)
    let names = self.namesOf(e)
    let fnName = self.nameOf(e)
    for (i, a) in args.enumerate() {
        let name = nameAt(names, i)
        if name == "" {
            continue
        }
        let (fits, want) = builtinParam(fnName, i, name)
        if not fits {
            if want != "" {
                self.sayAt(a, "{fnName}'s value here is {want}, not \"{name}\" (named values go in their order)")
            } else {
                self.sayAt(a, "{fnName} has no value \"{name}\"")
            }
            return false
        }
    }
    true
}

// the group a built-in that reaches outside the program belongs to ("" none)
pub fn builtinGroup(b: Int) -> Text = if b == bPrint or b == bPrintErr { "print" } else { "" }

// coerce each of a call's values from `from` to `to` (their checks first)
// runtime(group, name, values...), the body of a built-in written in compiler/prelude.qk: the runtime's function
// `name` (ir.qk's runtimeNames) called with the values' slots, giving what the function around it says it gives
// (runtimeLine: the line of the call that reached it goes last, for the runtime's messages). group: the capability
// its callers need ("" none).
fn Checker.checkRuntimeCall(var self, e: Int, hint: Int) -> Int {
    let args = self.argsOf(e)
    let f = self.c.fnDecl
    var ok = len(args) >= 2
    for i in 0..min(2, len(args)) {
        ok = ok and self.p.ast.exprs[args[i]].node is TextLit(_, _, _)
    }
    if not ok {
        self.sayAt(e, "runtime(group, name, values...): the group and the name are texts")
        return tyError
    }
    if self.p.ast.decls[f].isEffect or self.p.ast.decls[f].effectDeclared {
        self.needEffect(e, "the runtime")
    }
    for a in args {
        self.checkExpr(a, true)
    }
    self.p.ast.exprs[e].builtin = bRuntime
    // what it gives: the function's when it is its body; in a block, the written type it goes into
    // (let s: Scope = runtime(...)), else nothing
    let ret = self.p.ast.decls[f].retType
    let body = self.p.ast.decls[f].body
    if body >= 0 and self.p.ast.exprs[body].node is BlockExpr(_, _) {
        return if hint >= 0 { hint } else { tyVoid }
    }
    if ret >= 0 { ret } else { tyVoid }
}

// the capability group a built-in of the prelude needs (its body: runtime(group, ...); a block: the group of the
// first built-in its statements call that needs one), "" none
fn Checker.builtinGroupOf(self, d: Int) -> Text {
    let body = self.p.ast.decls[d].body
    if body < 0 {
        return ""
    }
    if self.p.ast.exprs[body].node is BlockExpr(block, _) {
        for st in self.p.ast.blocks[block].stmts {
            let v = match self.p.ast.stmts[st].node {
                Let(_, _, _, value, _, _) => value
                ExprStmt(value) => value
                _ => -1
            }
            if v >= 0 and self.p.ast.exprs[v].node is Call(called, _, _, _, _, _) {
                for o in self.byName[called] ?? [] {
                    if o != d and self.p.ast.decls[o].builtin and self.p.ast.decls[o].kind == DeclKind.Fn {
                        let g = self.builtinGroupOf(o)
                        if g != "" {
                            return g
                        }
                    }
                }
            }
        }
        return ""
    }
    let Call(name, _, args, _, _, _) = self.p.ast.exprs[body].node else {
        return ""
    }
    if not name is "runtime" | "runtimeLine" or len(args) == 0 {
        return ""
    }
    match self.p.ast.exprs[args[0]].node {
        TextLit(group, _, _) => group
        _ => ""
    }
}

fn Checker.allTo(var self, e: Int, from: Int, to: Int, want: Int, where: Text) {
    if from >= to {
        return
    }
    let a = self.argsOf(e)[from]
    self.checkExpr(a, true)
    self.coerce(a, want, where)
    self.allTo(e, from + 1, to, want, where) // recursion, not a loop: see checkStmtsFrom
}

fn Checker.checkBuiltin(var self, e: Int, b: Int) -> Int {
    self.p.ast.exprs[e].builtin = b
    if not self.p.ast.exprs[e].implicit and not self.namedBuiltinArgs(e) {
        return tyError
    }
    let Call(name, qualifier, args, names, method, dotted) = self.p.ast.exprs[e].node else {
        return tyError
    }
    let n = len(args)
    if (b == bSort or b == bSortBy) and n >= 2 and nameAt(names, n - 1) == "descending" {
        // xs.sortedBy(f, descending: true)
        self.p.ast.exprs[e].node = .Call(name, qualifier, args[..n - 1], names[..n - 1], method, dotted)
        let r = self.checkBuiltin(e, b)
        self.p.ast.exprs[e].node = .Call(name, qualifier, args, names, method, dotted)
        self.checkExpr(args[n - 1], true)
        self.coerce(args[n - 1], tyBool, "descending")
        return r
    }
    if b == bEnumerate {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let elem = self.checkSource(e, 0)
        if self.isErr(elem) {
            return elem
        }
        let pair = self.p.tupleType([tyInt, elem])
        return self.p.iterType(pair)
    }
    if b == bTake or b == bSkip {
        // the first n, or all but them: fused into the loop; past the end is the end
        if not self.argCount(e, 2, 2) {
            return tyError
        }
        let elem = self.checkSource(e, 0)
        self.checkExpr(args[1], true)
        self.coerce(args[1], tyInt, name)
        return if self.isErr(elem) { elem } else { self.p.iterType(elem) }
    }
    if b == bMean {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let t = self.checkSource(e, 0)
        if not self.isErr(t) and not self.p.isNumeric(t) {
            self.typeError(args[0], "mean: expected numbers, found a list of %s", t, -1)
        }
        return tyFloat
    }
    if b == bCountBy {
        // how many values give each key: [key: count], in the order the keys came
        if not self.argCount(e, 2, 2) {
            return tyError
        }
        let elem = self.checkSource(e, 0)
        let r = self.checkLambda(args[1], [elem], 1, 1, "countBy")
        if self.isErr(r) or self.isErr(elem) {
            return tyError
        }
        if not self.keyable(r) {
            self.typeError(args[1], "countBy: the lambda gives %s, which cannot be a map's key", r, -1)
            return tyError
        }
        return self.p.mapType(r, tyInt)
    }
    if b == bGet {
        // xs.get(i): the value at i, or None (no panic)
        if not self.argCount(e, 2, 2) {
            return tyError
        }
        let elem = self.checkSource(e, 0)
        if self.isErr(elem) {
            return elem
        }
        if self.kindOf(self.ty(args[0])) != Kind.Bytes {
            let arr = self.p.arrayType(elem)
            self.coerce(args[0], arr, "get")
        }
        self.checkExpr(args[1], true)
        self.coerce(args[1], tyInt, "get's index")
        return self.p.optionType(elem)
    }
    if b == bToSet {
        // xs.toSet(): each value once, in the order they came
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let elem = self.checkSource(e, 0)
        if self.isErr(elem) {
            return elem
        }
        if not self.keyable(elem) {
            self.typeError(args[0], "a set holds values == compares, with no array or map inside, not %s", elem, -1)
            return tyError
        }
        return self.p.mapType(elem, tyVoid)
    }
    if b == bAdd {
        // s.add(v): s a var set, one value more
        if not self.argCount(e, 2, 2) {
            return tyError
        }
        self.markPlace(args[0])
        let t = self.checkExpr(args[0], true)
        if not self.p.isSet(t) {
            if not self.isErr(t) {
                self.sayAt(args[0], "add puts a value into a var set: var s: Set<Text> = [] ... s.add(\"a\")")
            }
            return tyError
        }
        if not self.changeable(
            args[0],
            "add",
            "add puts a value into a var set: var s: Set<Text> = [] ... s.add(\"a\")",
            false,
        ) {
            return tyError
        }
        self.checkExpr(args[1], true)
        self.coerce(args[1], self.keyOf(t), "the value")
        return tyVoid
    }
    if b == bPanic {
        // stops the program (or the host's call) with this message: it never gives a value
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        self.allTo(e, 0, 1, tyText, "panic's message")
        return tyNever
    }
    if b == bSqrt
        or b == bSin
        or b == bCos
        or b == bTan
        or b == bAsin
        or b == bAcos
        or b == bAtan
        or b == bExp
        or b == bLog {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        self.allTo(e, 0, 1, tyFloat, name)
        return tyFloat
    }
    if b == bAtan2 or b == bPow {
        if not self.argCount(e, 2, 2) {
            return tyError
        }
        self.allTo(e, 0, 2, tyFloat, name)
        return tyFloat
    }
    if b == bAbs {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let t = self.checkExpr(args[0], true)
        if not self.p.isNumeric(t) {
            self.typeError(args[0], "abs: expected Int or Float, found %s", t, -1)
        }
        return t
    }
    if b == bFloor or b == bCeil or b == bRound {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let t = self.checkExpr(args[0], true)
        if self.kindOf(t) == Kind.Int {
            return tyInt
        }
        self.coerce(args[0], tyFloat, name)
        return tyInt
    }
    if b == bToFloat {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let t = self.checkExpr(args[0], true)
        if self.kindOf(t) == Kind.Float {
            return tyFloat
        }
        if self.kindOf(t) == Kind.Text {
            self.typeError(
                args[0],
                "toFloat makes a Float of an Int: parseFloat(t) reads one from a text (Float!)",
                -1,
                -1,
            )
            return tyFloat
        }
        self.coerce(args[0], tyInt, "toFloat")
        return tyFloat
    }
    if b == bToInt {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let t = self.checkExpr(args[0], true)
        if self.kindOf(t) == Kind.Int {
            return tyInt
        }
        if self.kindOf(t) == Kind.Text {
            self.typeError(args[0], "toInt truncates a Float: parseInt(t) reads an Int from a text (Int!)", -1, -1)
            return tyInt
        }
        self.coerce(args[0], tyFloat, "toInt")
        return tyInt
    }
    if b == bMin or b == bMax {
        if not self.argCount(e, 1, 2) {
            return tyError
        }
        if n == 1 {
            let t = self.checkSource(e, 0)
            if not self.isErr(t) and not self.p.isNumeric(t) {
                self.typeError(args[0], "%s of a list: expected numbers, found %s", -1, t)
            }
            return t
        }
        self.checkExpr(args[0], true)
        self.checkExpr(args[1], true)
        let t = self.unifyNumeric(args[0], args[1])
        if t < 0 or not self.p.isNumeric(t) {
            self.typeError(e, "min / max: expected two numbers, found %s and %s", self.ty(args[0]), self.ty(args[1]))
            return tyError
        }
        return t
    }
    if b == bClamp {
        if not self.argCount(e, 3, 3) {
            return tyError
        }
        for a in args {
            self.checkExpr(a, true)
        }
        var anyFloat = false
        for a in args {
            if not self.p.isNumeric(self.ty(a)) {
                self.typeError(a, "clamp: expected a number, found %s", self.ty(a), -1)
                return tyError
            }
            anyFloat = anyFloat or self.kindOf(self.ty(a)) == Kind.Float
        }
        if not anyFloat {
            return tyInt
        }
        for a in args {
            self.coerce(a, tyFloat, "clamp")
        }
        return tyFloat
    }
    if b == bLerp {
        if not self.argCount(e, 3, 3) {
            return tyError
        }
        self.allTo(e, 0, 3, tyFloat, "lerp")
        return tyFloat
    }
    if b == bLen {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let t = self.checkExpr(args[0], true)
        if self.kindOf(t) is Text | Map {
            return tyInt // bytes; keys
        }
        if not self.p.isIterable(t) {
            if not self.isErr(t) {
                self.typeError(args[0], "len: expected a text, an array, a range or a loop, found %s", t, -1)
            }
            return tyInt
        }
        self.markIterUse(args[0])
        return tyInt
    }
    if b == bFill {
        if not self.argCount(e, 2, 2) {
            return tyError
        }
        self.checkExpr(args[0], true)
        self.coerce(args[0], tyInt, "fill's count")
        let t = self.checkExpr(args[1], true)
        if self.kindOf(t) is Void | Range | Iter {
            self.typeError(args[1], "fill: %s cannot be stored", t, -1)
            return tyError
        }
        return self.p.arrayType(t)
    }
    if b == bMap or b == bFilter or b == bAny or b == bAll {
        if not self.argCount(e, 2, 2) {
            return tyError
        }
        let elem = self.checkSource(e, 0)
        let r = self.checkLambda(args[1], [elem, tyInt], 1, 1, name)
        if b == bMap {
            if self.kindOf(r) is Void | Range | Iter {
                self.typeError(args[1], "map: each value becomes %s, which cannot be stored", r, -1)
                return tyError
            }
            return self.p.iterType(r)
        }
        if self.kindOf(r) != Kind.Bool and not self.isErr(r) {
            self.typeError(args[1], "%s: the lambda must give a Bool, not %s", r, -1)
        }
        return if b == bFilter { self.p.iterType(elem) } else { tyBool }
    }
    if b == bFold {
        if not self.argCount(e, 3, 3) {
            return tyError
        }
        let elem = self.checkSource(e, 0)
        let acc = self.checkExpr(args[1], true)
        let r = self.checkLambda(args[2], [acc, elem], 2, 2, "fold")
        if not self.isErr(r) and not self.same(r, acc) {
            if self.kindOf(r) == Kind.Int and self.kindOf(acc) == Kind.Float {
                return acc // converted where it is lowered
            }
            self.typeError(args[2], "fold: the lambda gives %s, but the total is %s", r, acc)
        }
        return acc
    }
    if b == bSum {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let t = self.checkSource(e, 0)
        if not self.isErr(t) and not self.p.isNumeric(t) {
            self.typeError(args[0], "sum: expected numbers, found a list of %s (fold adds anything)", t, -1)
        }
        return t
    }
    if b == bToArray {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let elem = self.checkSource(e, 0)
        return self.p.arrayType(elem)
    }
    if b == bPrint or b == bPrintErr {
        self.needEffect(e, name)
        for a in args {
            let t = self.checkExpr(a, true)
            if self.isLoop(t) {
                self.markIterUse(a)
                let arr = self.p.arrayType(self.elemOf(t))
                self.coerce(a, arr, name)
            } else if not self.printable(t) {
                self.typeError(a, "{name} cannot show %s", t, -1)
            }
        }
        return tyVoid
    }
    if b == bSplit or b == bTrim or b == bParseInt or b == bParseFloat {
        // text, pure
        let k = if b == bSplit { 2 } else { 1 }
        if not self.argCount(e, k, k) {
            return tyError
        }
        self.allTo(e, 0, k, tyText, name)
        if b == bSplit {
            return self.p.arrayType(tyText)
        }
        if b == bTrim {
            return tyText
        }
        return self.p.resultType(if b == bParseInt {
            tyInt // Err: not a number, and the text
        } else {
            tyFloat
        })
    }
    if b == bSome {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        var t = self.checkExpr(args[0], true)
        if self.isLoop(t) {
            self.markIterUse(args[0])
            let arr = self.p.arrayType(self.elemOf(t))
            self.coerce(args[0], arr, "Some")
            t = self.ty(args[0])
        }
        if self.kindOf(t) == Kind.Void or t == tyNone or t == tyEmpty {
            self.typeError(args[0], "Some needs a value of a known type, not %s", t, -1)
            return tyError
        }
        if self.isErr(t) {
            return t
        }
        if self.p.isOption(t) {
            self.typeError(args[0], "Some of %s: it is optional already", t, -1)
            return tyError
        }
        return self.p.optionType(t)
    }
    if b == bToText {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        self.asText(args[0], "toText")
        return tyText
    }
    if b == bOk {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        var t = self.checkExpr(args[0], true)
        if self.isLoop(t) {
            self.markIterUse(args[0])
            let arr = self.p.arrayType(self.elemOf(t))
            self.coerce(args[0], arr, "Ok")
            t = self.ty(args[0])
        }
        if self.isErr(t) {
            return t
        }
        if t == tyNone {
            return self.p.resultType(tyNone) // Ok(None): its optional's type from where it goes (coerce)
        }
        if self.kindOf(t) == Kind.Void or t == tyEmpty or t == tyErr or t == tyEmptyMap or self.p.isResult(t) {
            self.typeError(args[0], "Ok needs a plain value of a known type, not %s", t, -1)
            return tyError
        }
        return self.p.resultType(t)
    }
    if b == bErr {
        // Err("why"), or Err(ParseError.Empty) in a T!ParseError
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let t = self.checkExpr(args[0], true)
        if self.isLoop(t) {
            self.markIterUse(args[0])
            let arr = self.p.arrayType(self.elemOf(t))
            self.coerce(args[0], arr, "Err")
        }
        return tyErr // takes the T! it goes into: its error type is checked there
    }
    if b == bWords or b == bLines or b == bUpper or b == bLower {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        self.allTo(e, 0, 1, tyText, name)
        return if b == bUpper or b == bLower {
            tyText
        } else {
            self.p.arrayType(tyText)
        }
    }
    if b == bStartsWith or b == bEndsWith or b == bReplace {
        let k = if b == bReplace { 3 } else { 2 }
        if not self.argCount(e, k, k) {
            return tyError
        }
        self.allTo(e, 0, k, tyText, name)
        return if b == bReplace { tyText } else { tyBool }
    }
    if b == bRepeat {
        if not self.argCount(e, 2, 2) {
            return tyError
        }
        self.checkExpr(args[0], true)
        self.coerce(args[0], tyText, "repeat")
        self.checkExpr(args[1], true)
        self.coerce(args[1], tyInt, "repeat's count")
        return tyText
    }
    if b == bJoin {
        if not self.argCount(e, 2, 2) {
            return tyError
        }
        let t = self.checkSource(e, 0)
        if self.kindOf(t) != Kind.Text and not self.isErr(t) {
            self.typeError(args[0], "join puts texts together, not %s (map them to text first)", t, -1)
        }
        self.checkExpr(args[1], true)
        self.coerce(args[1], tyText, "join's separator")
        return tyText
    }
    if b == bContains or b == bIndexOf {
        if not self.argCount(e, 2, 2) {
            return tyError
        }
        let t = self.checkExpr(args[0], true)
        let found = if b == bContains { tyBool } else { self.p.optionType(tyInt) }
        if self.kindOf(t) == Kind.Text {
            self.checkExpr(args[1], true)
            self.coerce(args[1], tyText, name)
            return found
        }
        if self.kindOf(t) == Kind.Map and b == bContains {
            self.checkExpr(args[1], true)
            self.coerce(args[1], self.keyOf(t), "the key")
            return found
        }
        if not self.p.isIterable(t) {
            if not self.isErr(t) {
                self.typeError(args[0], "this looks in a text, an array or a map, not in %s", t, -1)
            }
            return tyError
        }
        self.markIterUse(args[0])
        if not self.equatable(self.elemOf(t)) {
            self.typeError(args[0], "the values of %s cannot be compared with ==", t, -1)
        }
        self.checkExpr(args[1], true)
        self.coerce(args[1], self.elemOf(t), name)
        return found
    }
    if b == bSort or b == bReverse {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let t = self.checkSource(e, 0)
        if self.isErr(t) {
            return t
        }
        if b == bSort and not self.orderable(t) {
            self.typeError(
                args[0],
                "sort orders numbers, texts and cases; for %s write fn T.compare(a: T, b: T) -> Int, or use sortBy",
                t,
                -1,
            )
        }
        let arr = self.p.arrayType(t)
        self.coerce(args[0], arr, name) // it works on an array
        return arr
    }
    if b == bSortBy or b == bMinBy or b == bMaxBy or b == bCountOf or b == bFirst or b == bLast {
        let optionalFn = b == bFirst or b == bLast
        if b == bCountOf and n == 1 {
            self.sayAt(e, "count takes a test: xs.count(x => ...)")
            return tyError
        }
        if not self.argCount(e, if optionalFn { 1 } else { 2 }, 2) {
            return tyError
        }
        let elem = self.checkSource(e, 0)
        if n == 2 {
            let r = self.checkLambda(args[1], [elem], 1, 1, name)
            if not self.isErr(r) {
                if (b == bCountOf or optionalFn) and self.kindOf(r) != Kind.Bool {
                    self.typeError(args[1], "the lambda must give a Bool, not %s", r, -1)
                }
                if (b == bSortBy or b == bMinBy or b == bMaxBy) and not self.orderable(r) {
                    self.typeError(
                        args[1],
                        "the lambda gives %s, which has no order (numbers, texts and cases do)",
                        r,
                        -1,
                    )
                }
            }
        }
        if self.isErr(elem) {
            return elem
        }
        if b == bSortBy {
            let arr = self.p.arrayType(elem)
            self.coerce(args[0], arr, name)
            return arr
        }
        if b == bLast and n == 1 {
            let arr = self.p.arrayType(elem)
            self.coerce(args[0], arr, name)
        }
        if b == bCountOf {
            return tyInt
        }
        return if optionalFn { self.p.optionType(elem) } else { elem }
    }
    if b == bKeys or b == bValues {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let t = self.checkExpr(args[0], true)
        if self.kindOf(t) != Kind.Map {
            if not self.isErr(t) {
                self.typeError(args[0], "expected a map, found %s", t, -1)
            }
            return tyError
        }
        return self.p.arrayType(if b == bKeys { self.keyOf(t) } else { self.elemOf(t) })
    }
    if b == bRemove {
        // m.remove(key): m a var map, one key fewer
        if not self.argCount(e, 2, 2) {
            return tyError
        }
        self.markPlace(args[0])
        let t = self.checkExpr(args[0], true)
        if self.kindOf(t) != Kind.Map {
            if not self.isErr(t) {
                self.typeError(args[0], "remove takes a key out of a map, not %s", t, -1)
            }
            return tyError
        }
        if not self.changeable(
            args[0],
            "remove",
            "remove takes a key out of a var map: var m: [Text: Int] = [:] ... m.remove(\"a\")",
            false,
        ) {
            return tyError
        }
        self.checkExpr(args[1], true)
        self.coerce(args[1], self.keyOf(t), "the key")
        return tyVoid
    }
    if b == bIndex {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let t = self.checkExpr(args[0], true)
        if self.kindOf(t) != Kind.Enum or t == tyNone or t == tyErr {
            if not self.isErr(t) {
                self.typeError(args[0], "index gives an enum case's place (0, 1...), not %s's", t, -1)
            }
            return tyError
        }
        return tyInt
    }
    if b == bCodePointCount {
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        self.allTo(e, 0, 1, tyText, name)
        return tyInt
    }
    if b == bMapErr {
        // r.mapErr(e => .Io(e)): the same Ok, or Err(f(e)); f's .Case meets the error it goes into
        let want = self.c.errorWant
        self.c.errorWant = -1
        if not self.argCount(e, 2, 2) {
            return tyError
        }
        let t = self.checkExpr(args[0], true)
        if self.isErr(t) {
            return t
        }
        if not self.p.isResult(t) {
            self.typeError(args[0], "mapErr changes a result's error (T ! E, or T!), not %s", t, -1)
            return tyError
        }
        let err = self.p.errorOf(t)
        var f = self.checkLambda(args[1], [err], 1, 1, "mapErr")
        if self.isErr(f) {
            return f
        }
        let lam = args[1]
        if want >= 0 and self.p.ast.exprs[lam].sugar < 0 and self.p.ast.exprs[lam].node is Lambda(_, body) {
            if not self.coerce(body, want, "mapErr's error") {
                return tyError
            }
            f = want
            self.setTy(lam, want)
        }
        if f == tyDot
            or f == tyNone
            or f == tyErr
            or f == tyEmpty
            or f == tyEmptyMap
            or self.kindOf(f) is Void | Never
            or self.p.fallibleValue(f) >= 0 {
            if f != tyDot {
                self.typeError(
                    lam,
                    "mapErr's function gives the new error: a value of a type of its own, not %s",
                    f,
                    -1,
                )
            }
            return tyError
        }
        return self.p.resultOfType(self.p.fallibleValue(t), f)
    }
    if b == bAssert {
        // assert(condition) or assert(condition, "why"): stops the program (or the test) when false
        if not self.argCount(e, 1, 2) {
            return tyError
        }
        self.checkExpr(args[0], true)
        self.coerce(args[0], tyBool, "assert")
        if n == 2 {
            self.checkExpr(args[1], true)
            self.coerce(args[1], tyText, "assert's message")
        }
        return tyVoid
    }
    if b == bBytes {
        // t.bytes(): a text's bytes, the same memory
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        self.allTo(e, 0, 1, tyText, "bytes")
        return tyBytes
    }
    if b == bCBytes or b == bTextOf {
        // Text(b): the bytes as a text, when they are UTF-8 (Err says where they are not)
        if b == bCBytes or n == 2 {
            // Text(p, n), Bytes(p, n): n bytes of C's memory, copied
            if not self.argCount(e, 2, 2) {
                return tyError
            }
            let pt = self.checkExpr(args[0], true)
            if self.kindOf(pt) != Kind.Pointer and not self.isErr(pt) {
                self.typeError(args[0], "%s(p, n) copies n bytes from where a Pointer points, not from %s", pt, -1)
                return tyError
            }
            self.checkExpr(args[1], true)
            self.coerce(args[1], tyInt, "the count of bytes")
            self.needEffect(e, "reading C's memory")
            return if b == bCBytes { tyBytes } else { tyText }
        }
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        self.checkExpr(args[0], true)
        let t = self.ty(args[0])
        if not self.p.isIterable(t) and not self.isErr(t) and t != tyEmpty {
            self.typeError(
                args[0],
                "Text(b) reads Bytes as UTF-8 text, not %s: toText(x) shows any value as text",
                t,
                -1,
            )
            return tyError
        }
        self.coerce(args[0], tyBytes, "Text") // Text([0xff, 0x41]): a list of Ints made Bytes
        return self.p.resultType(tyText)
    }
    if b == bChar {
        // char(n): the text of a code point
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        self.allTo(e, 0, 1, tyInt, "char")
        return tyText
    }
    if b == bCodePoints {
        // codePoints(t): a loop of the text's code points (Ints), nothing built
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        self.allTo(e, 0, 1, tyText, "codePoints")
        return self.p.iterType(tyInt)
    }
    if b == bPop {
        // xs.pop(): xs a var array, one shorter; the value it had last, or None
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        self.markPlace(args[0])
        let t = self.checkExpr(args[0], true)
        if not self.kindOf(t) is Array | Bytes {
            if not self.isErr(t) {
                self.typeError(args[0], "pop takes the last value off an array or Bytes, not %s", t, -1)
            }
            return tyError
        }
        if not self.changeable(args[0], "pop", "pop takes from a var array: var xs = [1, 2] ... xs.pop()", false) {
            return tyError
        }
        return self.p.optionType(if self.kindOf(t) == Kind.Bytes { tyInt } else { self.elemOf(t) })
    }
    if b == bPush {
        // xs.push(value): xs a var array, one longer
        if not self.argCount(e, 2, 2) {
            return tyError
        }
        self.markPlace(args[0])
        let t = self.checkExpr(args[0], true)
        if not self.kindOf(t) is Array | Bytes {
            if not self.isErr(t) {
                self.typeError(args[0], "push adds to an array or to Bytes, not %s", t, -1)
            }
            return tyError
        }
        if not self.changeable(args[0], "push", "push adds to a var array: var xs: [Int] = [] ... xs.push(1)", false) {
            return tyError
        }
        let v = self.checkExpr(args[1], true)
        if self.isLoop(v) {
            self.markIterUse(args[1])
        }
        self.coerce(args[1], self.elemOf(t), "push")
        if self.kindOf(t) == Kind.Bytes and self.p.ast.exprs[args[1]].node is IntLit(x, _) and (x < 0 or x > 255) {
            self.sayAt(args[1], "a byte is 0 to 255, not {x}")
        }
        return tyVoid
    }
    tyError
}

// ---- constants and defaults ----------------------------------------------------------------------------------------
// A constant or a default is checked without local names or effects, in module m. written: its type as written
// (-1 none); want: the type it goes into (-1 none).
fn Checker.checkPure(var self, slot: Int, written: Int, want: Int, name: Text, m: Int) -> Int {
    self.enter(Ctx(inConst: true, module: m))
    var w = want
    if written >= 0 {
        w = self.resolveType(written)
    }
    self.c.hint = w
    self.c.result = w
    var t = self.checkExpr(slot, true)
    if w >= 0 {
        self.coerce(slot, w, name)
        t = w
    }
    if self.isLoop(t) {
        self.markIterUse(slot)
        let arr = self.p.arrayType(self.elemOf(t))
        self.coerce(slot, arr, name)
        t = self.ty(slot)
    }
    self.reportDotted()
    self.leave()
    if t == tyDot {
        t = tyError
    }
    if t == tyNone or t == tyEmpty or t == tyErr or t == tyEmptyMap {
        self.sayAt(slot, "{name} needs its type written: let {name}: T = ...")
        t = tyError
    }
    if self.kindOf(t) == Kind.Void {
        self.sayAt(slot, "{name} is given nothing")
        t = tyError
    }
    t
}

fn Checker.constType(var self, d: Int, at: Int) -> Int {
    let state = self.p.ast.decls[d].state
    if state == 2 {
        let r = self.p.ast.decls[d].retType
        return if r >= 0 { r } else { tyError }
    }
    if state == 1 {
        self.sayAt(at, "the constant {self.declName(d)} needs itself")
        return tyError
    }
    self.p.ast.decls[d].state = 1
    let x = self.p.ast.decls[d]
    let t = self.checkPure(x.body, x.ret, -1, x.name, x.module)
    self.p.ast.decls[d].retType = t
    self.p.ast.decls[d].state = 2
    t
}

// A call's values onto the parameters: by position, then by name (f(1, size: 2)), the rest from their defaults.
// ordered gets one value per parameter, converted to its type; args keep what was written.
fn Checker.bindArgs(var self, e: Int, params: [Int], what: Text) -> Bool {
    let args = self.argsOf(e)
    let count = len(params)
    let state = self.bindFrom(e, params, what, args, self.namesOf(e), 0, BindState([-1] * count, true, false))
    if state.stopped {
        return false
    }
    var ordered = state.ordered
    var ok = state.ok
    for (p, prm) in params.enumerate() {
        if ordered[p] < 0 {
            let fallback = self.p.ast.params[prm].fallback
            if fallback >= 0 {
                ordered[p] = fallback
            } else {
                self.sayAt(
                    e,
                    "{what} needs \"{self.paramName(prm)}\" ({count} value{plural(count)}, given {len(args)})",
                )
                ok = false
            }
        }
    }
    self.p.ast.exprs[e].ordered = ordered
    ok
}

// A call of a C function that takes ... (printf): its parameters by position, then any number of values, each as C's
// variadic arguments take it: an Int as int64_t, a Float as double, a Bool as int64_t 0 or 1, a Text as a zero-ended
// copy (char*), a Pointer as its address, a handle as itself.
fn Checker.bindVariadic(var self, e: Int, d: Int) -> Bool {
    let x = self.p.ast.decls[d]
    let args = self.argsOf(e)
    let names = self.namesOf(e)
    let fixed = len(x.params)
    var ok = true
    for (i, a) in args.enumerate() {
        let t = self.checkExpr(a, true)
        if nameAt(names, i) != "" {
            self.sayAt(a, "{x.name} takes its values by position (C's variadic function)")
            ok = false
        } else if i < fixed {
            self.coerce(a, self.paramType(x.params[i]), self.paramName(x.params[i]))
        } else if not self.isErr(t) and not self.kindOf(t) is Int | Float | Bool | Text | Pointer | Handle {
            self.typeError(a, "C's variadic arguments are numbers, Bools, texts and pointers, not %s", t, -1)
            ok = false
        }
    }
    if len(args) < fixed {
        self.sayAt(e, "{x.name} takes {fixed} value{plural(fixed)} at least, given {len(args)}")
        ok = false
    }
    self.p.ast.exprs[e].ordered = args
    ok
}

// a call's values bound so far: each parameter's (-1 none yet), no error said, a named one met, too many given
type BindState { ordered: [Int], ok: Bool, named: Bool, stopped: Bool = false }

// the call's values from the i-th on, onto the parameters (recursion, not a loop: a value may be a lambda, a match...)
fn Checker.bindFrom(
    var self,
    e: Int,
    params: [Int],
    what: Text,
    args: [Int],
    names: [Text],
    i: Int,
    state: BindState,
) -> BindState {
    if i >= len(args) {
        return state
    }
    let a = args[i]
    let count = len(params)
    let name = nameAt(names, i)
    let goesTo = if name != "" {
        (0..count).first(k => self.paramName(params[k]) == name) ?? -1
    } else {
        i
    }
    if goesTo >= 0 and goesTo < count {
        self.hintLiteral(a, self.paramType(params[goesTo]))
    }
    let t = self.checkExpr(a, true)
    self.c.hint = -1
    if self.isLoop(t) {
        self.markIterUse(a)
    }
    var p = i
    var named = state.named
    if name != "" {
        named = true
        p = -1
        for (k, prm) in params.enumerate() {
            if self.paramName(prm) == name {
                p = k
            }
        }
        if p < 0 {
            let close = closest(name, params.map(prm => self.paramName(prm)).toArray())
            if close != "" {
                self.sayAt(a, "{what} has no parameter \"{name}\": did you mean \"{close}\"?")
            } else {
                self.sayAt(a, "{what} has no parameter \"{name}\"")
            }
            return self.bindFrom(e, params, what, args, names, i + 1, state with { ok: false, named: named })
        }
    } else if named {
        self.sayAt(a, "after a named value, every value is named")
        return self.bindFrom(e, params, what, args, names, i + 1, state with { ok: false })
    }
    if p >= count {
        self.sayAt(e, "{what} takes {count} value{plural(count)}, given {len(args)}")
        return state with { stopped: true }
    }
    if state.ordered[p] >= 0 {
        self.sayAt(a, "\"{self.paramName(params[p])}\" is given twice")
        return self.bindFrom(e, params, what, args, names, i + 1, state with { ok: false, named: named })
    }
    var ordered = state.ordered
    ordered[p] = a
    self.coerce(a, self.paramType(params[p]), self.paramName(params[p]))
    self.bindFrom(e, params, what, args, names, i + 1, state with { ordered: ordered, named: named })
}

// ---- templates: generic functions, and functions that take functions -------------------------------------------
fn Checker.typeParamIndex(self, d: Int, name: Text) -> Int =
    self.p.ast.decls[d].typeParams.indexOf(name) ?? -1

// What a call's value says about the template's type parameters: [T] given [Int] binds T to Int. It goes as deep as
// both types go: [(T, Int)] given [(Text, Int)], [K: [V]], Set<T>, T? and T ! E, Pair<T, U>, (T) -> R.
fn Checker.unify(var self, d: Int, te: Int, actual: Int, bound: [Int]) -> [Int] {
    if te < 0 or actual < 0 or self.isErr(actual) or actual == tyNone or actual == tyErr or actual == tyDot {
        return bound // .Case: no type to tell
    }
    var out = bound
    let at = self.p.types[actual]
    match self.p.ast.types[te].node {
        Optional(inner) => {
            let v = self.p.fallibleValue(actual)
            out = self.unify(d, inner, if v >= 0 { v } else { actual }, out)
        }
        Result(inner, error) => {
            let v = self.p.fallibleValue(actual)
            out = self.unify(d, inner, if v >= 0 { v } else { actual }, out)
            if error >= 0 and v >= 0 and self.p.ast.decls[at.decl].errorOf >= 0 {
                out = self.unify(d, error, self.p.ast.decls[at.decl].errorOf, out)
            }
        }
        Tuple(items) => {
            // (T, Int) given (Text, Int)
            if at.kind == Kind.Record
                and at.decl >= 0
                and self.p.ast.decls[at.decl].isTuple
                and len(self.p.ast.decls[at.decl].params) == len(items) {
                let fields = self.p.ast.decls[at.decl].params
                for (i, item) in items.enumerate() {
                    out = self.unify(d, item, self.paramType(fields[i]), out)
                }
            }
        }
        Fn(params, _, result, _, _) => {
            // (T) -> R given (Int) -> Text
            if at.kind == Kind.Fn and len(at.params) == len(params) {
                for (i, prm) in params.enumerate() {
                    out = self.unify(d, prm, at.params[i], out)
                }
                if at.elem >= 0 {
                    out = self.unify(d, result, at.elem, out)
                }
            }
        }
        Map(key, value) => {
            if at.kind == Kind.Map and at.key >= 0 {
                out = self.unify(d, key, at.key, out)
                out = self.unify(d, value, at.elem, out)
            }
        }
        Array(elem) => {
            if self.p.isIterable(actual) and at.elem >= 0 {
                out = self.unify(d, elem, at.elem, out)
            }
        }
        Named(name, args) => {
            if len(args) > 0 {
                // Pair<T, Int> given Pair<Text, Int>: T is Text
                if self.typeParamIndex(d, name) < 0 and name == "Set" and len(args) == 1 {
                    // Set<T>: a map to nothing
                    if self.p.isSet(actual) {
                        out = self.unify(d, args[0], at.key, out)
                    }
                    return out
                }
                let ad = if at.kind is Record | Enum { at.decl } else { -1 }
                if ad >= 0 and self.p.ast.decls[ad].isEntry and name == "Entry" and len(args) == 2 {
                    let fields = self.p.ast.decls[ad].params
                    out = self.unify(d, args[0], self.paramType(fields[0]), out)
                    out = self.unify(d, args[1], self.paramType(fields[1]), out)
                    return out
                }
                if ad >= 0
                    and self.p.ast.decls[ad].templateOf >= 0
                    and self.declName(self.p.ast.decls[ad].templateOf) == name {
                    let typeArgs = self.p.ast.decls[ad].typeArgs
                    let count = len(self.p.ast.decls[ad].typeParams)
                    for (i, arg) in args.enumerate() {
                        if i < count and i < len(typeArgs) {
                            out = self.unify(d, arg, typeArgs[i], out)
                        }
                    }
                }
                return out
            }
            let k = self.typeParamIndex(d, name)
            if k < 0 {
                return out
            }
            var a = actual
            if self.isLoop(a) {
                a = self.p.arrayType(at.elem)
            }
            if a == tyEmpty or a == tyEmptyMap or self.kindOf(a) == Kind.Void {
                return out
            }
            if out[k] < 0 or self.kindOf(out[k]) == Kind.Int and self.kindOf(a) == Kind.Float {
                out[k] = a
            }
        }
    }
    out
}

// The first type parameter a type as written names that is not bound yet ("" none).
fn Checker.unbound(self, d: Int, te: Int, bound: [Int]) -> Text {
    if te < 0 {
        return ""
    }
    match self.p.ast.types[te].node {
        Fn(params, _, result, _, _) => {
            for prm in params {
                let m = self.unbound(d, prm, bound)
                if m != "" {
                    return m
                }
            }
            self.unbound(d, result, bound)
        }
        Tuple(items) => {
            for item in items {
                let m = self.unbound(d, item, bound)
                if m != "" {
                    return m
                }
            }
            ""
        }
        Named(name, args) => {
            let k = self.typeParamIndex(d, name)
            if k >= 0 and bound[k] < 0 {
                return name
            }
            for arg in args {
                let m = self.unbound(d, arg, bound)
                if m != "" {
                    return m
                }
            }
            ""
        }
        Map(key, value) => {
            let m = self.unbound(d, key, bound)
            if m != "" { m } else { self.unbound(d, value, bound) }
        }
        Array(elem) => self.unbound(d, elem, bound)
        Optional(inner) => self.unbound(d, inner, bound)
        Result(inner, error) => {
            let m = self.unbound(d, inner, bound)
            if m != "" { m } else { self.unbound(d, error, bound) }
        }
    }
}

fn Checker.paramTypeNode(self, d: Int, p: Int) -> Int =
    self.p.ast.params[self.p.ast.decls[d].params[p]].ty

// A copy of the template, with its types (and its lambdas) in place, checked like any function.
fn Checker.instantiate(var self, d: Int, bound: [Int], lambdas: [Int], takesFn: Bool) -> Int {
    var inst = self.p.ast.cloneDecl(self.p.ast.decls[d].pristine)
    inst.templateOf = d
    inst.isTemplate = false
    inst.typeArgs = bound
    inst.inlineOnly = takesFn
    var name = self.declName(d)
    for (i, t) in bound.enumerate() {
        name += if i > 0 { ", " } else { "<" }
        name += self.tname(t)
    }
    if len(bound) > 0 {
        name += ">"
    }
    if takesFn {
        name += "#{len(self.p.ast.decls[d].instances) + 1}"
    }
    inst.name = name
    // std.json's jsonOf and fromJson: a body made for the type (Self that type, when it is a record or an enum)
    let template = self.p.ast.decls[d]
    let jsonFn = len(bound) == 1
        and template.name is "jsonOf" | "fromJson"
        and self.p.modules[template.module].path == "std/json.qk"
    var selfFor = -1
    if jsonFn {
        let t = bound[0]
        let text = if template.name == "jsonOf" {
            self.jsonWriting(t)
        } else {
            self.jsonReading(t)
        }
        if text != "" {
            let header = if template.name == "jsonOf" {
                "fn jsonMade(value: Int) -> Int "
            } else {
                "fn jsonMade(j: Int) -> Int "
            }
            let before = len(self.p.ast.decls)
            let errors = self.parseMore(
                Source("{template.name}<{self.tname(t)}> (std.json's, made for the type)", header + text + "\n"),
            )
            for e in errors {
                self.errors.add(Source("", ""), template.line, template.col, e)
            }
            if len(self.p.ast.decls) > before {
                inst.body = self.p.ast.decls[before].body
            }
            if self.kindOf(t) is Record | Enum
                and self.p.ast.decls[self.declOf(t)].optionOf < 0
                and not self.p.ast.decls[self.declOf(t)].isTuple {
                selfFor = self.declOf(t)
            }
        }
    }
    let at = self.addDecl(inst)
    self.p.ast.decls[d].instances.push(at)
    let savedSelf = self.jsonSelf
    self.jsonSelf = selfFor
    self.enter(Ctx(module: inst.module, typing: at))
    for (f, prm) in inst.params.enumerate() {
        let x = self.p.ast.params[prm]
        let t = self.resolveType(x.ty)
        let lambda = if self.kindOf(t) == Kind.Fn { lambdas[f] } else { -1 }
        self.p.bindings.push(
            Binding(x.name, t, mutable: x.isVar or x.owned, isParam: true, lambda: lambda, deep: x.owned),
        )
        self.p.ast.params[prm].binding = len(self.p.bindings) - 1
    }
    for prm in inst.params {
        let x = self.p.ast.params[prm]
        if x.fallback >= 0 {
            self.checkPure(x.fallback, -1, self.p.bindings[x.binding].ty, x.name, self.c.module)
        }
    }
    self.instantiating += 1
    self.checkFnBody(at)
    self.instantiating -= 1
    self.leave()
    self.jsonSelf = savedSelf
    at
}

// ---- std.json's jsonOf and fromJson, made for each type (their bodies, as Quark) ----
// A record is an object of its fields, an enum's case its name (with data: an object of one entry, the name and an
// object of its fields), an array a list, a map from Text or Int an object, an optional null when None, a tuple a
// list; Int, Float, Bool and Text themselves. "" when the type is none of these (the template's own body stays: an
// error at run time would be wrong, so the checker says it).
fn Checker.jsonWriting(var self, t: Int) -> Text {
    let k = self.kindOf(t)
    let nl = "\n"
    match k {
        Int => "= Json.Integer(value)"
        Float => "= Json.Num(value)"
        Bool => "= Json.Bool(value)"
        Text => "= Json.Str(value)"
        Array => "= Json.List(value.map(x => jsonOf(x)).toArray())"
        Map => {
            let key = self.kindOf(self.keyOf(t))
            if key == Kind.Text {
                "\{"
                    + nl
                    + "var out: [Text: Json] = [:]"
                    + nl
                    + "for (k, v) in value \{"
                    + nl
                    + "out[k] = jsonOf(v)"
                    + nl
                    + "\}"
                    + nl
                    + "Json.Object(out)"
                    + nl
                    + "\}"
            } else if key == Kind.Int {
                "\{"
                    + nl
                    + "var out: [Text: Json] = [:]"
                    + nl
                    + "for (k, v) in value \{"
                    + nl
                    + "out[\"\{k\}\"] = jsonOf(v)"
                    + nl
                    + "\}"
                    + nl
                    + "Json.Object(out)"
                    + nl
                    + "\}"
            } else {
                self.jsonNot(t, "a map's keys are Text or Int in JSON")
            }
        }
        Record | Enum => {
            let d = self.declOf(t)
            let x = self.p.ast.decls[d]
            if x.optionOf >= 0 {
                return "= match value \{" + nl + "Some(x) => jsonOf(x)" + nl + "None => Json.Null" + nl + "\}"
            }
            if x.isTuple {
                var items: [Text] = []
                for i in 0..len(x.params) {
                    items.push("jsonOf(value.{i})")
                }
                return "= Json.List([" + items.join(", ") + "])"
            }
            if k == Kind.Record {
                if len(x.params) == 0 {
                    return "\{" + nl + "let none: [Text: Json] = [:]" + nl + "Json.Object(none)" + nl + "\}"
                }
                var fields: [Text] = []
                for prm in x.params {
                    let name = self.p.ast.params[prm].name
                    fields.push("\"{name}\": jsonOf(value.{name})")
                }
                return "= Json.Object([" + fields.join(", ") + "])"
            }
            var arms: [Text] = []
            for (i, case) in x.cases.enumerate() {
                let fs = x.caseFields.get(i) ?? []
                if len(fs) == 0 {
                    arms.push("{case} => Json.Str(\"{case}\")")
                } else {
                    var binds: [Text] = []
                    var fields: [Text] = []
                    for (j, prm) in fs.enumerate() {
                        binds.push("f{j}")
                        fields.push("\"{self.p.ast.params[prm].name}\": jsonOf(f{j})")
                    }
                    arms.push(
                        "{case}("
                            + binds.join(", ")
                            + ") => Json.Object([\"{case}\": Json.Object(["
                            + fields.join(", ")
                            + "])])",
                    )
                }
            }
            "= match value \{" + nl + arms.join(nl) + nl + "\}"
        }
        _ => self.jsonNot(t, "only data is JSON: numbers, Bool, Text, arrays, maps, optionals, tuples, records, enums")
    }
}

fn Checker.jsonReading(var self, t: Int) -> Text {
    let k = self.kindOf(t)
    let nl = "\n"
    match k {
        Int => "= intOfJson(j)"
        Float => "= floatOfJson(j)"
        Bool => "= boolOfJson(j)"
        Text => "= textOfJson(j)"
        Array => "\{" + nl + "let out: T = []" + nl + "listFromJson(j, out)" + nl + "\}"
        Map => {
            let key = self.kindOf(self.keyOf(t))
            if key == Kind.Text {
                "\{" + nl + "let out: T = [:]" + nl + "mapFromJson(j, out)" + nl + "\}"
            } else if key == Kind.Int {
                "\{" + nl + "let out: T = [:]" + nl + "intMapFromJson(j, out)" + nl + "\}"
            } else {
                self.jsonNot(t, "a map's keys are Text or Int in JSON")
            }
        }
        Record | Enum => {
            let d = self.declOf(t)
            let x = self.p.ast.decls[d]
            let name = self.tname(t)
            if x.optionOf >= 0 {
                return "\{" + nl + "let none: T = None" + nl + "optionFromJson(j, none)" + nl + "\}"
            }
            if x.isTuple {
                var items: [Text] = []
                for i in 0..len(x.params) {
                    items.push("itemFromJson(items, {i})?")
                }
                return "\{"
                    + nl
                    + "let items = j.items() ?? return Err(\"JSON: a tuple is a list, not \{j.kindName()\}\")"
                    + nl
                    + "let r: T = ("
                    + items.join(", ")
                    + ")"
                    + nl
                    + "r"
                    + nl
                    + "\}"
            }
            if k == Kind.Record {
                var given: [Text] = []
                var later: [Text] = []
                for prm in x.params {
                    let q = self.p.ast.params[prm]
                    let ft = self.paramType(prm)
                    let optional = self.kindOf(ft) == Kind.Enum and self.p.ast.decls[self.declOf(ft)].optionOf >= 0
                    let read = if optional {
                        "optionFieldFromJson(f, \"{q.name}\", None)?" // (None tells the inner type: Pet, of a Pet?)
                    } else {
                        "fieldFromJson(f, \"{q.name}\")?"
                    }
                    if q.fallback >= 0 {
                        later.push("if f.contains(\"{q.name}\") \{" + nl + "r.{q.name} = {read}" + nl + "\}")
                    } else {
                        given.push("{q.name}: {read}")
                    }
                }
                return "\{"
                    + nl
                    + "let f = j.fields() ?? return Err(\"JSON: a {name} is an object, not \{j.kindName()\}\")"
                    + nl
                    + "var r = Self("
                    + given.join(", ")
                    + ")"
                    + nl
                    + later.join(nl)
                    + nl
                    + "r"
                    + nl
                    + "\}"
            }
            var tests: [Text] = []
            for (i, case) in x.cases.enumerate() {
                let fs = x.caseFields.get(i) ?? []
                var made = "Self.{case}"
                if len(fs) > 0 {
                    var fields: [Text] = []
                    for prm in fs {
                        let n = self.p.ast.params[prm].name
                        let ft = self.paramType(prm)
                        let optional = self.kindOf(ft) == Kind.Enum and self.p.ast.decls[self.declOf(ft)].optionOf >= 0
                        fields.push(if optional {
                            "{n}: optionFieldFromJson(f, \"{n}\", None)?"
                        } else {
                            "{n}: fieldFromJson(f, \"{n}\")?"
                        })
                    }
                    made += "(" + fields.join(", ") + ")"
                }
                tests.push("if name == \"{case}\" \{" + nl + "return {made}" + nl + "\}")
            }
            "\{"
                + nl
                + "let (name, f) = caseOfJson(j, \"{name}\")?"
                + nl
                + tests.join(nl)
                + nl
                + "Err(\"JSON: \{name\} is not a case of {name}\")"
                + nl
                + "\}"
        }
        _ => self.jsonNot(t, "only data is JSON: numbers, Bool, Text, arrays, maps, optionals, tuples, records, enums")
    }
}

// the type is not JSON: said where the call is, and the template's own body kept
fn Checker.jsonNot(var self, t: Int, why: Text) -> Text {
    if self.jsonCallAt >= 0 {
        let x = self.p.ast.exprs[self.jsonCallAt]
        self.errors.add(self.p.modules[self.jsonCallModule].src, x.line, x.col, "{self.tname(t)} is not JSON: {why}")
    }
    ""
}

// A call to a template: its types from the values given, its lambdas checked where they are written; then the
// instance for those types (made once), or for those lambdas (made for this call, and always inlined).
// hint: the written type the call's value goes into (let c: Channel<Int> = channel()), -1 none: it tells the types
// the values do not
fn Checker.checkTemplateCall(var self, e: Int, d: Int, hint: Int) -> Int {
    if self.p.ast.decls[d].state == 0 {
        // checked loosely first: which of its functions it keeps
        self.enter(Ctx())
        self.checkFnBody(d)
        self.leave()
    }
    let dname = self.declName(d)
    let dparams = self.p.ast.decls[d].params
    let count = len(dparams)
    let args = self.argsOf(e)
    let names = self.namesOf(e)
    var given = [-1] * count
    var named = false
    for (i, a) in args.enumerate() {
        var p = i
        let name = nameAt(names, i)
        if name != "" {
            named = true
            p = -1
            for (k, prm) in dparams.enumerate() {
                if self.paramName(prm) == name {
                    p = k
                }
            }
            if p < 0 {
                self.sayAt(a, "{dname} has no parameter \"{name}\"")
                return tyError
            }
        } else if named {
            self.sayAt(a, "after a named value, every value is named")
            return tyError
        }
        if p >= count {
            self.sayAt(e, "{dname} takes {count} value{plural(count)}, given {len(args)}")
            return tyError
        }
        if given[p] >= 0 {
            self.sayAt(a, "\"{self.paramName(dparams[p])}\" is given twice")
            return tyError
        }
        given[p] = a
    }
    var loose = self.c.typing >= 0 and self.p.ast.decls[self.c.typing].isTemplate // inside a template being checked: no instance yet
    let typeParams = self.p.ast.decls[d].typeParams
    var bound = [-1] * len(typeParams)
    var takesFn = false
    let valueParams = self.p.ast.decls[d].valueParams
    for p in 0..count {
        let fte = self.paramTypeNode(d, p)
        let keeps = p < len(valueParams) and valueParams[p]
        if self.isFnTypeNode(fte) and not keeps {
            takesFn = true
            continue
        }
        if self.isFnTypeNode(fte) {
            continue // a function value: below, once the other types are known
        }
        if given[p] < 0 {
            continue
        }
        let t = self.checkExpr(given[p], true)
        if self.isLoop(t) {
            self.markIterUse(given[p])
        }
        if self.isErr(t) {
            loose = true
        }
        bound = self.unify(d, fte, t, bound)
    }
    var lambdas = [-1] * count
    for p in 0..count {
        let fte = self.paramTypeNode(d, p)
        let Fn(fparams, _, fresult, fEffect, _) = self.p.ast.types[fte].node else {
            continue
        }
        let keeps = p < len(valueParams) and valueParams[p]
        if given[p] >= 0 and keeps {
            // kept by the template: a function value, a closure
            var missing = ""
            for prm in fparams {
                if missing == "" {
                    missing = self.unbound(d, prm, bound)
                }
            }
            if missing != "" or loose {
                if not loose {
                    self.sayAt(given[p], "{dname}: what {missing} is cannot be told from the other values")
                } else if self.p.ast.exprs[given[p]].node is Lambda(_, _)
                    and self.p.ast.exprs[given[p]].decl < 0
                    and len(fparams) <= 16 {
                    // inside a template: its names
                    self.liftLambda(given[p], [tyError] * len(fparams), -1, fEffect, false)
                }
                return tyError
            }
            var ps: [Int] = []
            for prm in fparams {
                ps.push(self.resolveWith(prm, d, bound))
            }
            let ret = if fresult >= 0 and self.unbound(d, fresult, bound) == "" {
                self.resolveWith(fresult, d, bound) // its result too, when known
            } else {
                -1
            }
            var t = tyError
            if self.p.ast.exprs[given[p]].node is Lambda(_, _) {
                if not self.liftLambda(given[p], ps, ret, fEffect, false) {
                    return tyError
                }
                t = self.ty(given[p])
            } else {
                t = self.checkExpr(given[p], true)
            }
            if self.isErr(t) {
                return t
            }
            bound = self.unify(d, fte, t, bound)
            lambdas[p] = -1
            continue
        }
        if given[p] < 0 {
            self.sayAt(
                e,
                "{dname} needs a function for \"{self.paramName(dparams[p])}\": a lambda or a function's name",
            )
            return tyError
        }
        var missing = ""
        for prm in fparams {
            if missing == "" {
                missing = self.unbound(d, prm, bound)
            }
        }
        let known = missing == ""
        var ps: [Int] = []
        for prm in fparams {
            ps.push(if known and not loose {
                self.resolveWith(prm, d, bound)
            } else {
                tyError
            })
        }
        if not known and not loose {
            self.sayAt(given[p], "{dname}: what {missing} is cannot be told from the other values")
            return tyError
        }
        var fb = -1
        if self.p.ast.exprs[given[p]].node is Name(n) {
            fb = self.lookup(n)
        }
        var r = tyError
        if fb >= 0 and self.kindOf(self.bindingType(fb)) == Kind.Fn and self.p.bindings[fb].lambda >= 0 {
            // passed on: the caller's own lambda
            lambdas[p] = self.p.bindings[fb].lambda
            r = self.elemOf(self.bindingType(fb))
            self.p.bindings[fb].uses += 1
        } else {
            r = self.checkLambdaAs(given[p], ps, len(fparams), len(fparams), dname, fEffect)
            lambdas[p] = given[p]
        }
        if self.isErr(r) or not self.p.ast.exprs[lambdas[p]].node is Lambda(_, _) {
            loose = true
        } else {
            bound = self.unify(d, fresult, r, bound)
            if self.kindOf(r) == Kind.Void and fresult >= 0 and self.p.ast.types[fresult].node is Named(n, targs) {
                // a lambda that gives nothing: its result type is Unit (scope(s => { for ... }))
                let k = self.typeParamIndex(d, n)
                if len(targs) == 0 and k >= 0 and bound[k] < 0 {
                    bound[k] = r
                }
            }
        }
    }
    if loose {
        return tyError
    }
    if hint >= 0 and bound.contains(-1) and self.p.ast.decls[d].ret >= 0 {
        bound = self.unify(d, self.p.ast.decls[d].ret, hint, bound)
    }
    for (i, t) in bound.enumerate() {
        if t < 0 {
            self.sayAt(
                e,
                "{dname}: what {typeParams[i]} is cannot be told from the values given: write the type where the value goes, let x: Type = {dname}(...)",
            )
            return tyError
        }
    }
    let bounds = self.p.ast.decls[d].typeBounds
    for (i, bname) in bounds.enumerate() {
        // T: Speaker: the type given fits the interface
        if bname == "" or i >= len(typeParams) {
            continue
        }
        let w = self.findDecl(bname)
        if w < 0 or self.p.ast.decls[w].kind != DeclKind.Type or not self.p.ast.decls[w].isInterface {
            self.sayAt(e, "{dname}: {bname} is not an interface (T: Speaker, with interface Speaker \{ fn ... \})")
            return tyError
        }
        if not self.fitsInterface(bound[i], w, e, dname, typeParams[i]) {
            return tyError
        }
    }
    if self.instantiating > 24 {
        let instances = self.p.ast.decls[d].instances
        if len(typeParams) > 0 and len(instances) >= 3 {
            // deep((x, x), n - 1): T, (T, T), ((T, T), (T, T))...
            self.sayAt(
                e,
                "{dname} calls itself with new types: each call would need a new instance ({self.declName(instances[0])}, {self.declName(instances[1])}, {self.declName(instances[2])}...), without end; call it with the types it was given, or make the value an enum that holds itself",
            )
        } else {
            self.sayAt(e, "{dname} keeps making new versions of itself: each call needs a new instance, without end")
        }
        return tyError
    }
    var inst = -1
    if not takesFn {
        for i in self.p.ast.decls[d].instances {
            if inst < 0 and self.p.ast.decls[i].typeArgs == bound {
                inst = i
            }
        }
    }
    if inst < 0 {
        if self.p.modules[self.c.module].path != "std/json.qk" {
            self.jsonCallAt = e // (the program's call, not std.json's own inside it)
            self.jsonCallModule = self.c.module
        }
        inst = self.instantiate(d, bound, lambdas, takesFn)
    }
    let iparams = self.p.ast.decls[inst].params
    // a lambda's value becomes what the function type says (an Int where a Float goes)
    for p in 0..count {
        let ft = self.paramType(iparams[p])
        let lam = lambdas[p]
        if self.kindOf(ft) != Kind.Fn or lam < 0 {
            continue
        }
        let Lambda(_, body) = self.p.ast.exprs[lam].node else {
            continue
        }
        if body < 0 {
            continue
        }
        let lt = self.ty(lam)
        let fret = self.elemOf(ft)
        if lt >= 0 and lt != fret and given[p] == lam {
            self.coerce(body, fret, "the function's result")
            self.setTy(lam, fret)
        }
    }
    self.p.ast.exprs[e].decl = inst
    self.usesEffectsOf(e, inst, 0)
    var ordered = [-1] * count
    for p in 0..count {
        let pt = self.paramType(iparams[p])
        if self.kindOf(pt) == Kind.Fn and lambdas[p] >= 0 {
            ordered[p] = lambdas[p]
        } else if given[p] >= 0 {
            ordered[p] = given[p]
            self.coerce(given[p], pt, self.paramName(iparams[p]))
        } else if self.p.ast.params[iparams[p]].fallback >= 0 {
            ordered[p] = self.p.ast.params[iparams[p]].fallback
        } else {
            self.sayAt(e, "{dname} needs \"{self.paramName(dparams[p])}\"")
            return tyError
        }
    }
    self.p.ast.exprs[e].ordered = ordered
    self.checkChange(e, inst)
    self.fnReturnType(inst, e)
}

// f(x) where f is a function this one was given
// f(a, b) of a C function value (callee: the expression that gives it): its values as its parameters' C types take
// them, an effect (C's code does what it does); its result as Quark has it
fn Checker.checkCCall(var self, e: Int, callee: Int, ft: Int, args: [Int], what: Text) -> Int {
    let f = self.p.types[ft]
    if len(args) != len(f.params) {
        let n = len(f.params)
        self.sayAt(e, "{what} takes {n} value{plural(n)}, not {len(args)}")
        return tyError
    }
    let names = self.namesOf(e)
    let skip = len(names) - len(args) // a method's receiver among the names
    for (i, a) in args.enumerate() {
        if nameAt(names, i + skip) != "" {
            self.sayAt(a, "{what} takes no named values")
        }
        let t = self.checkExpr(a, true)
        if self.isLoop(t) {
            self.markIterUse(a)
        }
        let want = self.p.plainType(f.params[i])
        if self.kindOf(want) == Kind.CFn {
            self.coerce(a, f.params[i], what) // a function given to C: its C entry
        } else {
            self.coerce(a, want, what)
        }
    }
    self.needEffect(e, "a C function value")
    self.p.ast.exprs[e].callee = callee
    self.p.ast.exprs[e].ordered = args
    self.p.plainType(f.elem)
}

fn Checker.checkFnParamCall(var self, e: Int, fb: Int) -> Int {
    let ft = self.p.types[self.bindingType(fb)]
    let name = self.nameOf(e)
    self.p.bindings[fb].uses += 1
    self.p.ast.exprs[e].binding = fb
    if self.p.bindings[fb].mutable {
        self.c.varReads += 1
    }
    if ft.isEffect and self.p.bindings[fb].lambda < 0 {
        self.needEffect(e, name) // a lambda put in: its effects are its caller's, said where it is written
    }
    let args = self.argsOf(e)
    let names = self.namesOf(e)
    if len(args) != len(ft.params) {
        let n = len(ft.params)
        self.sayAt(e, "{name} takes {n} value{plural(n)}, not {len(args)}")
        return tyError
    }
    for (i, a) in args.enumerate() {
        if nameAt(names, i) != "" {
            self.sayAt(a, "{name} takes no named values")
        }
        let t = self.checkExpr(a, true)
        if self.isLoop(t) {
            self.markIterUse(a)
        }
        self.coerce(a, ft.params[i], name)
    }
    self.p.ast.exprs[e].ordered = args
    ft.elem
}

// A generic type's instance for these types (made once): its fields resolved with T standing for each.
fn Checker.instanceType(var self, d: Int, args: [Int]) -> Int {
    for i in self.p.ast.decls[d].instances {
        if self.p.ast.decls[i].typeArgs == args {
            return self.p.ast.decls[i].ty
        }
    }
    let pristine = self.p.ast.decls[d].pristine
    var inst = self.p.ast.cloneDecl(if pristine >= 0 { pristine } else { d })
    inst.templateOf = d
    inst.isTemplate = false
    inst.typeArgs = args
    var name = self.declName(d)
    for (i, t) in args.enumerate() {
        name += if i > 0 { ", " } else { "<" }
        name += self.tname(t)
    }
    inst.name = name + ">"
    inst.state = 2
    let at = self.addDecl(inst)
    let t = self.p.addType(Type(if inst.kind == DeclKind.Enum { Kind.Enum } else { Kind.Record }, decl: at))
    self.p.ast.decls[at].ty = t
    self.p.ast.decls[d].instances.push(at) // before its fields: List<T> holds a List<T>
    self.enter(Ctx(module: inst.module, typing: at))
    var fields: [Int] = []
    if inst.kind == DeclKind.Type {
        fields = inst.params
    } else {
        for group in inst.caseFields {
            fields += group
        }
    }
    for f in fields {
        let x = self.p.ast.params[f]
        let ft = self.resolveType(x.ty)
        self.p.bindings.push(Binding(x.name, ft))
        self.p.ast.params[f].binding = len(self.p.bindings) - 1
    }
    for f in fields {
        self.boxIfRecursive(f, t)
    }
    self.leave()
    t
}

// Code the language makes while checking (an interface's default for a type, std.json's for a type), read on its own
// and put after the program's tree: its errors. (Read into the program's tree itself, the whole tree would be copied.)
fn Checker.parseMore(var self, src: Source) -> [Text] {
    let parsed = parse(src)
    self.p.ast.append(parsed.ast)
    parsed.errors
}

// A lambda of a template checked before it has types (not checked itself then): the functions given to the template
// that it names are kept as values, as they are when a lambda that is checked names them.
fn Checker.keepNamedFunctions(var self, e: Int) {
    if e < 0 or not self.p.ast.exprs[e].node is Lambda(_, _) {
        return
    }
    let text = exprText(self.p.ast, e, 0).bytes()
    for b in self.c.scope {
        let x = self.p.bindings[b]
        if not x.fnParam {
            continue
        }
        let name = x.name.bytes()
        var i = 0
        while i + len(name) <= len(text) {
            let before = i > 0 and isWordByte(text[i - 1])
            let after = i + len(name) < len(text) and isWordByte(text[i + len(name)])
            if not before and not after and text[i..i + len(name)] == name {
                self.keepsFunction(b)
                break
            }
            i += 1
        }
    }
}

fn isWordByte(c: Int) -> Bool = c is 'a'..='z' | 'A'..='Z' | '0'..='9' | '_'

// inside a template being checked before it has types (its lambdas too)
fn Checker.inTemplate(self) -> Bool {
    var k = -1
    var steps = 0
    while steps < 10000 {
        steps += 1
        let c = if k < 0 { self.c } else { self.saved[k] }
        if c.typing >= 0 and self.p.ast.decls[c.typing].isTemplate
            or c.fnDecl >= 0 and self.p.ast.decls[c.fnDecl].isTemplate {
            return true
        }
        if c.outer < 0 {
            return false
        }
        k = c.outer
    }
    false
}

// A call that makes a generic record or case: its types from the values given (each checked once here).
fn Checker.inferInstance(var self, e: Int, d: Int, fields: [Int], hint: Int) -> Int {
    if hint >= 0 and self.declOf(hint) >= 0 and self.p.ast.decls[self.declOf(hint)].templateOf == d {
        return self.declOf(hint) // var s: Stack<Int> = Stack([])
    }
    var bound = [-1] * len(self.p.ast.decls[d].typeParams)
    let args = self.argsOf(e)
    let names = self.namesOf(e)
    for (i, a) in args.enumerate() {
        var f = i
        let name = nameAt(names, i)
        if name != "" {
            f = -1
            for (k, prm) in fields.enumerate() {
                if self.paramName(prm) == name {
                    f = k
                }
            }
        }
        let t = self.checkExpr(a, true)
        self.p.ast.exprs[a].typed = true
        if self.isErr(t) {
            return -1 // said already, or a template's T: its instances will tell
        }
        if f >= 0 and f < len(fields) {
            bound = self.unify(d, self.p.ast.params[fields[f]].ty, t, bound)
        }
    }
    let dname = self.declName(d)
    for (k, t) in bound.enumerate() {
        if t < 0 {
            if self.inTemplate() {
                for a in args {
                    self.keepNamedFunctions(a)
                }
                return -1 // a template's, checked before it has types: its instances will tell
            }
            self.sayAt(
                e,
                "{dname}: what {self.p.ast.decls[d].typeParams[k]} is cannot be told from the values: write the type where it goes, let x: {dname}<...> = ...",
            )
            return -1
        }
    }
    self.declOf(self.instanceType(d, bound))
}

// A function's name where a value goes: the function itself, as a value
fn Checker.fnValueType(var self, d: Int, at: Int) -> Int {
    let name = self.declName(d)
    if self.isCFunction(d) {
        self.sayAt(at, "{name} is the host's: keep a function of the program instead, fn f(...) = {name}(...)")
        return tyError
    }
    if self.p.ast.decls[d].isTemplate or self.p.ast.decls[d].isTest {
        self.sayAt(at, "{name} is generic, or takes a function: call it, {name}(...)")
        return tyError
    }
    if self.changesSelf(d) {
        let dot = name.indexOf(".") ?? -1
        self.sayAt(at, "{name} changes the value it is called on: call it on a var, v.{name[dot + 1..]}(...)")
        return tyError
    }
    var params: [Int] = []
    for prm in self.p.ast.decls[d].params {
        params.push(self.paramType(prm))
    }
    let ret = self.fnReturnType(d, at)
    if self.isErr(ret) {
        return ret
    }
    self.usesEffectsOf(at, d, asValue)
    self.p.fnType(params, ret, self.p.ast.decls[d].isEffect)
}

// ---- capabilities: what a program may reach -------------------------------------------------------------------------
fn listed(list: Text, name: Text) -> Bool {
    let b = list.bytes()
    var i = 0
    while i < len(b) {
        while i < len(b) and b[i] is ' ' | ',' | '\n' | '\t' {
            i += 1
        }
        let start = i
        while i < len(b) and not b[i] is ' ' | ',' | '\n' | '\t' {
            i += 1
        }
        let n = i - start
        if n == 0 {
            continue
        }
        let word = list[start..i]
        if word == "*" {
            return true
        }
        if b[i - 1] == '*' and name.startsWith(word[..n - 1]) {
            return true // a prefix: Object.*, net*
        }
        if word == name {
            return true
        }
    }
    false
}

fn Checker.capableOf(self, name: Text) -> Bool {
    let Some(list) = self.allowed else {
        return true
    }
    listed(list, name)
}

fn Checker.capable(var self, e: Int, name: Text, group: Text) -> Bool {
    if self.capableOf(if group != "" { group } else { name }) or group != "" and self.capableOf(name) {
        return true
    }
    let list = self.allowed ?? ""
    let allows = if list != "" { list } else { "nothing" }
    let inGroup = if group != "" { "; it is in the group {group}" } else { "" }
    self.sayAt(e, "{name} is not given to this program (the host allows: {allows}){inGroup}")
    false
}

// a record's field that holds a function: button.onPress(3) calls it
fn Checker.fnField(self, t: Int, name: Text) -> Bool {
    if self.kindOf(t) != Kind.Record {
        return false
    }
    for f in self.p.ast.decls[self.declOf(t)].params {
        if self.paramName(f) == name and self.kindOf(self.paramType(f)) is Fn | CFn {
            return true
        }
    }
    false
}

// ---- places: what a statement changes in place ----------------------------------------------------------------------
// push, remove, add and a type's var self functions change the value they are called on
fn Checker.changesReceiver(self, name: Text) -> Bool =
    name is "push" | "remove" | "add" or self.changers.contains(name)

// In a place, a map's element is the value itself (m[k].push(x)), not an optional: said before it is checked.
fn Checker.markPlace(var self, e: Int) {
    var x = e
    while true {
        match self.p.ast.exprs[x].node {
            Field(target, _) => {
                x = target
            }
            Index(target, _) => {
                self.p.ast.exprs[x].place = true
                x = target
            }
            _ => {
                return
            }
        }
    }
}

// The var a place starts at (p, p.at, t.syms[i].uses, m[k], grid[i][j]), or -1 when it is none (a call's value; a
// slice, which is a copy); and whether it reaches into an array or a map that the var's value holds, not its own.
fn Checker.placeVar(self, e: Int) -> (Int, Bool) {
    var inside = false
    var x = e
    while true {
        match self.p.ast.exprs[x].node {
            Name(_) => {
                return (self.p.ast.exprs[x].binding, inside)
            }
            Field(target, _) => {
                let t = self.ty(target)
                if t < 0 or self.kindOf(t) != Kind.Record {
                    return (-1, inside)
                }
                x = target
            }
            Index(target, index) => {
                let t = self.ty(target)
                if self.p.ast.exprs[index].node is Range(_, _) or t < 0 or not self.kindOf(t) is Array | Map {
                    return (-1, inside)
                }
                if not self.p.ast.exprs[target].node is Name(_) {
                    inside = true
                }
                x = target
            }
            _ => {
                return (-1, inside)
            }
        }
    }
    (-1, inside)
}

// A field on the way that holds its own type (a box): it is set whole, never through.
fn Checker.throughBox(var self, e: Int, settable: Int) -> Bool {
    var x = e
    while true {
        match self.p.ast.exprs[x].node {
            Field(target, name) => {
                let t = self.ty(target)
                if t >= 0 and self.kindOf(t) == Kind.Record and x != settable {
                    let k = self.p.ast.exprs[x].caseIndex
                    let fields = self.p.ast.decls[self.declOf(t)].params
                    if k >= 0 and k < len(fields) and self.p.ast.params[fields[k]].boxed {
                        self.sayAt(
                            x,
                            "{name} holds its own type: set it whole (x.{name} = ...), or build a new one with with",
                        )
                        return true
                    }
                }
                x = target
            }
            Index(target, _) => {
                x = target
            }
            _ => {
                return false
            }
        }
    }
    false
}

// Why a name that is not a var cannot change (fnName: what tries to change it, push, next...; "": an assignment).
fn Checker.notChangeable(var self, at: Int, root: Int, fnName: Text) {
    let r = self.p.bindings[root]
    var why = if fnName != "" { "{fnName} changes its value: " } else { "" }
    if r.capturedFrom >= 0 {
        why += "a function value takes copies of the names it uses: {r.name} cannot change inside it; keep the state in a var outside and return it, or use a var self method"
    } else if r.isParam and r.name == "self" {
        why += "self is a parameter (parameters never change): make the function a var self method, fn T.name(var self, ...)"
    } else if r.isParam {
        why += "\"{r.name}\" is a parameter (parameters never change): make it the function's own (owned {r.name}: T), copy it into a var, or make the function a var self method"
    } else if fnName != "" {
        why += "{r.name} must be a var"
    } else {
        why += "\"{r.name}\" is a let (it never changes); declare it with var to change it"
    }
    self.sayAt(at, why)
}

// A var changed inside a lambda that must be pure: one from outside the lambda never changes there (map, filter,
// fold... fuse, reorder and share out their calls; a parameter without effect takes a lambda that changes nothing).
fn Checker.pureChange(var self, at: Int, root: Int) -> Bool {
    if self.c.pureFn == "" {
        return false
    }
    for i in self.c.pureScope..len(self.c.scope) {
        if self.c.scope[i] == root {
            return false
        }
    }
    let f = self.c.pureFn
    let name = self.p.bindings[root].name
    if self.builtinNamed(f) > 0 {
        self.sayAt(at, "a lambda given to {f} is pure: it cannot change {name}; use fold, or a for loop")
    } else {
        self.sayAt(
            at,
            "a lambda given to {f} is pure: it cannot change {name}; give {f}'s parameter an effect type (effect (T) -> R), or use a for loop",
        )
    }
    true
}

// xs.push(v), t.syms.push(s), m[k].push(x), p.next(), st.parser.next(): what fnName changes is a var, or a field or
// element of one. Changing more than the var's own slots, array or map makes its value deep (everything in it its own).
fn Checker.changeable(var self, target: Int, fnName: Text, notPlace: Text, whole: Bool) -> Bool {
    let t = self.ty(target)
    if t < 0 or self.isErr(t) {
        return false
    }
    let (root, _) = self.placeVar(target)
    if root < 0 {
        if notPlace != "" {
            self.sayAt(target, notPlace)
        } else {
            self.sayAt(target, "{fnName} changes its value: call it on a var, or on a field or element of one")
        }
        return false
    }
    if not self.p.bindings[root].mutable {
        self.notChangeable(target, root, fnName)
        return false
    }
    if self.pureChange(target, root) {
        return false
    }
    if self.throughBox(target, -1) {
        return false
    }
    let isName = self.p.ast.exprs[target].node is Name(_)
    if not isName or whole and self.p.holdsContainers(t) {
        self.p.bindings[root].deep = true
    }
    true
}

// p.next() of fn Parser.next(var self): p is a var's place, changed where it is
fn Checker.checkChange(var self, e: Int, d: Int) {
    if not self.changesSelf(d) {
        return
    }
    let ordered = self.p.ast.exprs[e].ordered
    let args = self.argsOf(e)
    let target = if len(ordered) > 0 {
        ordered[0]
    } else if len(args) > 0 {
        args[0]
    } else {
        -1
    }
    if target < 0 {
        return
    }
    let name = self.declName(d)
    let dot = name.indexOf(".") ?? -1
    let _ = self.changeable(target, if dot >= 0 { name[dot + 1..] } else { name }, "", true)
}

// a type read from a call's name: where the call is
fn Checker.placeTypeExpr(var self, te: Int, line: Int, col: Int) {
    if te < 0 {
        return
    }
    self.p.ast.types[te].line = line
    self.p.ast.types[te].col = col
    match self.p.ast.types[te].node {
        Named(_, args) => {
            for a in args {
                self.placeTypeExpr(a, line, col)
            }
        }
        Array(elem) => self.placeTypeExpr(elem, line, col)
        Optional(inner) => self.placeTypeExpr(inner, line, col)
        Result(inner, _) => self.placeTypeExpr(inner, line, col)
        _ => {}
    }
}

// ---- calls ---------------------------------------------------------------------------------------------------------
// whether f(...) or a.f(...) calls a local value named f: in a.f(...) only a function value is (a local Float named
// start leaves s.start(...) to the function start)
fn Checker.localCalled(self, name: Text, method: Bool) -> Bool {
    let b = self.lookup(name)
    b >= 0 and (not method or self.kindOf(self.bindingType(b)) is Fn | CFn)
}

fn Checker.checkCall(var self, e: Int) -> Int {
    let hint = self.c.hint // the written type it goes into, for this call only (not its values)
    self.c.hint = -1
    let Call(name, qualifier, args, names, method, dotted) = self.p.ast.exprs[e].node else {
        return tyError
    }
    if hint >= 0 and self.p.isResult(hint) and name == "mapErr" {
        self.c.errorWant = self.p.errorOf(hint) // let r: T ! E = x.mapErr(...)
    }
    if dotted {
        // .Circle(radius: 1): its values checked here (their names are in reach here), fitted when it meets its enum
        if self.p.ast.exprs[e].decl >= 0 {
            return self.ty(e)
        }
        for a in args {
            self.checkExpr(a, true)
            self.p.ast.exprs[a].typed = true
        }
        return self.dottedCase(e)
    }
    if name == "(,)" {
        // (a, b): a tuple
        if len(args) > 16 {
            self.sayAt(e, "a tuple has at most 16 elements")
            return tyError
        }
        // a tuple's type it goes into: each element's, for the [], None and .Case among them
        let into = if hint >= 0
            and self.kindOf(hint) == Kind.Record
            and self.declOf(hint) >= 0
            and self.p.ast.decls[self.declOf(hint)].isTuple
            and len(self.p.ast.decls[self.declOf(hint)].params) == len(args) {
            self.p.ast.decls[self.declOf(hint)].params.map(f => self.paramType(f)).toArray()
        } else {
            []
        }
        var elems: [Int] = []
        for (k, a) in args.enumerate() {
            if len(into) > 0 {
                self.hintLiteral(a, into[k])
            }
            var t = self.checkExpr(a, true)
            self.c.hint = -1
            if len(into) > 0 and (t == tyNone or t == tyEmpty or t == tyEmptyMap or t == tyDot or t == tyLambda) {
                self.coerce(a, into[k], "a tuple's value")
                t = self.ty(a)
            }
            if self.isLoop(t) {
                self.markIterUse(a)
                let arr = self.p.arrayType(self.elemOf(t))
                self.coerce(a, arr, "a tuple's value")
                t = self.ty(a)
            }
            if t == tyNone
                or t == tyEmpty
                or t == tyEmptyMap
                or t == tyErr
                or self.kindOf(t) == Kind.Void
                or t == tyLambda {
                self.typeError(a, "a tuple's value needs a type of its own, not %s", t, -1)
                return tyError
            }
            if self.isErr(t) {
                return t
            }
            elems.push(t)
        }
        let t = self.p.tupleType(elems)
        self.p.ast.exprs[e].decl = self.declOf(t)
        self.p.ast.exprs[e].ordered = args
        return t
    }
    if name.startsWith("Pointer<") {
        // Pointer<T>(address), Pointer<T>(another pointer): the same address, a T
        let te = self.p.ast.parseTypeOnto(name)
        let line = self.p.ast.exprs[e].line
        let col = self.p.ast.exprs[e].col
        self.placeTypeExpr(te, line, col)
        let t = if te >= 0 { self.resolveType(te) } else { tyError }
        if self.kindOf(t) != Kind.Pointer {
            if not self.isErr(t) {
                self.sayAt(e, "{name} is not a pointer's type")
            }
            return tyError
        }
        if not self.argCount(e, 1, 1) {
            return tyError
        }
        let from = self.checkExpr(args[0], true)
        if not self.kindOf(from) is Pointer | Int | Error {
            self.typeError(args[0], "Pointer<T>(x) takes an address (an Int) or another pointer, not %s", from, -1)
            return tyError
        }
        self.needEffect(e, "making a pointer")
        self.p.ast.exprs[e].ordered = args
        return t
    }
    var fb = if qualifier != "" { -1 } else { self.lookupOrCapture(-1, name) }
    if fb >= 0 and method and len(args) > 0 and nameAt(names, 0) == "" {
        // by.f(x) with a field f holding a function: the field, not a value named f around it
        let t = self.checkExpr(args[0], true)
        self.p.ast.exprs[args[0]].typed = true
        if self.fnField(t, name) {
            fb = -1
        } else if self.isErr(t) and self.inTemplate() {
            // a template's, checked before it has types: which f it is, its instances tell
            for i in 1..len(args) {
                if not self.p.ast.exprs[args[i]].node is Lambda(_, _) {
                    self.checkExpr(args[i], true)
                }
            }
            return tyError
        }
    }
    if name == "()" and len(args) > 0 {
        // pick(true)(5): the function a value gives, called
        let ft = self.checkExpr(args[0], true)
        if self.isErr(ft) {
            return ft
        }
        if self.kindOf(ft) == Kind.CFn {
            return self.checkCCall(e, args[0], ft, args[1..], "this C function")
        }
        if self.kindOf(ft) != Kind.Fn or ft == tyLambda {
            self.typeError(args[0], "only a function can be called, not %s", ft, -1)
            return tyError
        }
        self.p.ast.exprs[e].callee = args[0]
        let f = self.p.types[ft]
        if len(args) - 1 != len(f.params) {
            let n = len(f.params)
            self.sayAt(e, "this function takes {n} value{plural(n)}, not {len(args) - 1}")
            return tyError
        }
        if f.isEffect {
            self.needEffect(e, "this function")
        }
        for i in 1..len(args) {
            let t = self.checkExpr(args[i], true)
            if self.isLoop(t) {
                self.markIterUse(args[i])
            }
            self.coerce(args[i], f.params[i - 1], "the function")
        }
        self.p.ast.exprs[e].ordered = args[1..]
        return f.elem
    }
    if fb >= 0 and self.kindOf(self.bindingType(fb)) == Kind.Fn {
        return self.checkFnParamCall(e, fb)
    }
    if fb >= 0 and self.kindOf(self.bindingType(fb)) == Kind.CFn {
        // f(x) of a C function value: the name's value is what is called
        let x = self.p.ast.exprs[e]
        let callee = self.newExpr(.Name(name), x.line, x.col)
        let _ = self.checkExpr(callee, true)
        return self.checkCCall(e, callee, self.bindingType(fb), args, name)
    }
    var d = self.findDecl(name)
    if qualifier != "" {
        d = -1 // a case: below
    }
    if d >= 0 {
        let x = self.p.ast.decls[d]
        if x.kind == DeclKind.Type and x.isExtern and not x.cStruct {
            self.sayAt(e, "{x.name} comes from the host: it is given to the program, never made by it")
            return tyError
        }
        if x.kind == DeclKind.Type and not self.accessLayout(d, e) {
            return tyError
        }
        if x.isInterface {
            self.sayAt(e, "{x.name} is an interface: give it a value that implements its functions")
            return tyError
        }
        if x.kind == DeclKind.Type and x.isTemplate {
            // Pair(1, "a"): Pair<Int, Text>, from the values
            d = self.inferInstance(e, d, x.params, hint)
            if d < 0 {
                return tyError
            }
        }
        if self.p.ast.decls[d].kind == DeclKind.Type {
            // a record: its fields by position, then by name
            self.p.ast.exprs[e].decl = d
            if not self.bindArgs(e, self.p.ast.decls[d].params, self.declName(d)) {
                return tyError
            }
            return self.p.ast.decls[d].ty
        }
    }
    if qualifier != "" {
        // Shape.Circle(2): a case with data
        var en = self.findDecl(qualifier)
        if en < 0 or self.p.ast.decls[en].kind != DeclKind.Enum {
            if en >= 0 {
                self.sayAt(e, "{qualifier} is not an enum")
            } else if not self.sayHidden(self.p.ast.exprs[e].line, self.p.ast.exprs[e].col, qualifier, "type") {
                self.sayAt(e, "unknown type \"{qualifier}\"")
            }
            return tyError
        }
        let cases = self.p.ast.decls[en].cases
        let k = cases.indexOf(name) ?? -1
        let ename = self.declName(en)
        if k < 0 {
            let close = closest(name, cases)
            if close != "" {
                self.sayAt(e, "{ename} has no case {name}: did you mean {close}?")
            } else {
                self.sayAt(e, "{ename} has no case {name}")
            }
            return tyError
        }
        let fields = self.p.ast.decls[en].caseFields[k]
        if len(fields) == 0 {
            self.sayAt(e, "{ename}.{name} carries no data: write {ename}.{name}")
            return tyError
        }
        if self.p.ast.decls[en].isTemplate {
            // Tree.Node(1, ...): Tree<Int>, from the values
            en = self.inferInstance(e, en, fields, hint)
            if en < 0 {
                return tyError
            }
        }
        self.p.ast.exprs[e].decl = en
        self.p.ast.exprs[e].caseIndex = k
        if not self.bindArgs(e, self.p.ast.decls[en].caseFields[k], name) {
            return tyError
        }
        return self.p.ast.decls[en].ty
    }
    if method and len(args) > 0 and not self.p.ast.exprs[args[0]].typed and self.changesReceiver(name) {
        self.markPlace(args[0]) // m[k].push(x), m[k].next(): the value itself
    }
    var ownFn = false
    let typing = self.c.typing
    let generic = method
        and typing >= 0
        and (self.p.ast.decls[typing].isTemplate or self.p.ast.decls[typing].templateOf >= 0)
        and self.builtinNamed(name) == 0
        and d < 0
    if len(args) > 0
        and nameAt(names, 0) == ""
        and not self.p.ast.exprs[args[0]].node is Lambda(_, _)
        and (self.anyTypeFunction(name) or generic) {
        // v.length(): the receiver's type's own function comes first
        let t = self.checkExpr(args[0], true)
        self.p.ast.exprs[args[0]].typed = true
        let own = self.typeFunction(t, name)
        if own >= 0 {
            d = own // j.text(): the type's own function, even with a local named text
            ownFn = true
        } else if self.isErr(t)
            and (self.p.types[t].typeVar != "" or typing >= 0 and self.p.ast.decls[typing].isTemplate)
            and d < 0 {
            // x.speak() on a template's T: checked in each instance
            for i in 1..len(args) {
                if not self.p.ast.exprs[args[i]].node is Lambda(_, _) {
                    self.checkExpr(args[i], true)
                }
            }
            return tyError
        } else if d < 0
            and typing >= 0
            and self.p.ast.decls[typing].templateOf >= 0
            and not self.isErr(t)
            and not self.fnField(t, name)
            and self.builtinNamed(name) == 0 {
            // an instance: say whose T it is (a built-in, xs.push, is not)
            let n = self.tname(t)
            self.sayAt(e, "{n} has no function {name}: {self.declName(typing)} needs fn {n}.{name}(...) for it")
            return tyError
        }
    }
    if method and d >= 0 and not ownFn and len(args) > 0 and nameAt(names, 0) == "" {
        // ops.mix(x, n) with a field mix holding a function: the field, not a free fn mix(ops, x, n)
        let t = self.checkExpr(args[0], true)
        self.p.ast.exprs[args[0]].typed = true
        if self.fnField(t, name) {
            d = -1
        }
    }
    if d >= 0 {
        let x = self.p.ast.decls[d]
        if x.kind == DeclKind.Fn
            and x.builtin
            and self.c.module != x.module
            and (ownFn or not self.localCalled(name, method))
            and self.builtinGroupOf(d) != ""
            and not self.capable(e, x.name, self.builtinGroupOf(d)) {
            return tyError // what the program calls (the prelude's own calls are its)
        }
        if x.kind == DeclKind.Fn and x.isTemplate and (ownFn or not self.localCalled(name, method)) {
            return self.checkTemplateCall(e, d, hint)
        }
        if x.kind == DeclKind.Fn and x.isTest {
            self.sayAt(e, "a test is run by quark test, not called")
            return tyError
        }
        if x.kind == DeclKind.Fn and (ownFn or not self.localCalled(name, method)) {
            if self.isCFunction(d)
                and not self.capable(e, if x.externSymbol != "" { x.externSymbol } else { x.name }, "") {
                return tyError
            }
            self.p.ast.exprs[e].decl = d
            self.usesEffectsOf(e, d, 0)
            if x.variadic {
                let _ = self.bindVariadic(e, d)
            } else if self.bindArgs(e, x.params, x.name) {
                self.checkChange(e, d)
            }
            return self.fnReturnType(d, e)
        }
        if x.kind == DeclKind.Enum {
            let first = if len(x.cases) > 0 { x.cases[0] } else { "Case" }
            self.sayAt(e, "{x.name} is an enum: pick a case, {x.name}.{first}")
            return tyError
        }
        if x.kind == DeclKind.Const {
            self.sayAt(e, "{x.name} is a constant, not a function")
            return tyError
        }
    }
    if method and len(args) > 0 and d < 0 {
        // button.onPress(3): a function kept in a field
        let rt = self.checkExpr(args[0], true)
        self.p.ast.exprs[args[0]].typed = true
        if self.kindOf(rt) == Kind.Record {
            for prm in self.p.ast.decls[self.declOf(rt)].params {
                if self.paramName(prm) == name and self.kindOf(self.paramType(prm)) == Kind.CFn {
                    // a C struct's function field, called
                    let line = self.p.ast.exprs[e].line
                    let col = self.p.ast.exprs[e].col
                    let field = self.newExpr(.Field(args[0], name), line, col)
                    let ft = self.checkExpr(field, true)
                    return self.checkCCall(e, field, ft, args[1..], name)
                }
                if self.paramName(prm) != name or self.kindOf(self.paramType(prm)) != Kind.Fn {
                    continue
                }
                let line = self.p.ast.exprs[e].line
                let col = self.p.ast.exprs[e].col
                let field = self.newExpr(.Field(args[0], name), line, col)
                let ft = self.checkExpr(field, true)
                self.p.ast.exprs[e].callee = field
                let f = self.p.types[ft]
                if len(args) - 1 != len(f.params) {
                    let n = len(f.params)
                    self.sayAt(e, "{name} takes {n} value{plural(n)}, not {len(args) - 1}")
                    return tyError
                }
                if f.isEffect {
                    self.needEffect(e, name)
                }
                for i in 1..len(args) {
                    let t = self.checkExpr(args[i], true)
                    if self.isLoop(t) {
                        self.markIterUse(args[i])
                    }
                    self.coerce(args[i], f.params[i - 1], name)
                }
                self.p.ast.exprs[e].ordered = args[1..]
                return f.elem
            }
        }
    }
    if name is "runtime" | "runtimeLine" and self.c.fnDecl >= 0 and self.p.ast.decls[self.c.fnDecl].builtin {
        return self.checkRuntimeCall(e, hint)
    }
    let b = self.builtinNamed(name)
    if b == bParallelMap {
        return self.checkParallelMap(e)
    }
    if b == bParallelFold {
        return self.checkParallelFold(e)
    }
    if b > 0 and builtinGroup(b) != "" and not self.capable(e, name, builtinGroup(b)) {
        return tyError
    }
    if b > 0 {
        return self.checkBuiltin(e, b)
    }
    if self.lookup(name) >= 0 {
        self.sayAt(e, "\"{name}\" is a value, not a function")
        return tyError
    }
    if method and len(args) > 0 {
        // p.nrm(): the type has no such function (its own ones, for "did you mean")
        let rt = if self.ty(args[0]) >= 0 {
            self.ty(args[0])
        } else {
            self.checkExpr(args[0], true)
        }
        if self.isErr(rt) {
            return rt
        }
        let n = self.tname(rt)
        let rd = self.declOf(rt)
        let base = if rd >= 0 {
            let template = self.p.ast.decls[rd].templateOf
            if template >= 0 {
                self.declName(template)
            } else {
                self.declName(rd)
            }
        } else {
            n
        }
        var candidates: [Text] = []
        for o in self.p.decls {
            let x = self.p.ast.decls[o]
            if len(candidates) < 256
                and x.kind == DeclKind.Fn
                and x.owner == base
                and x.owner != ""
                and x.templateOf < 0
                and self.seenFrom(self.c.module, o) {
                candidates.push(baseAfterDot(x.name))
            }
        }
        let own = rd >= 0
            and self.kindOf(rt) is Record | Enum | Handle
            and self.p.fallibleValue(rt) < 0
            and not self.p.ast.decls[rd].isTuple
            and not self.p.ast.decls[rd].isEntry
        if not own {
            // a built-in type: its functions are the built-ins
            for (i, bn) in builtinNames.enumerate() {
                if i > 0 and len(candidates) < 256 and not bn.startsWith("#") {
                    candidates.push(bn)
                }
            }
        }
        let close = closest(name, candidates)
        if otherNames[name] is Some(other) {
            self.sayAt(e, "{n} has no function \"{name}\": write {other}")
        } else if close != "" {
            self.sayAt(e, "{n} has no function \"{name}\": did you mean \"{close}\"?")
        } else if own {
            self.sayAt(e, "{n} has no function \"{name}\": a type's function is written fn {base}.{name}(self, ...)")
        } else {
            self.sayAt(e, "{n} has no function \"{name}\" (quark catalog lists the built-in ones)")
        }
        for i in 1..len(args) {
            if not self.p.ast.exprs[args[i]].node is Lambda(_, _) {
                self.checkExpr(args[i], true)
            }
        }
        return tyError
    }
    self.unknownName(e)
    for a in args {
        if not self.p.ast.exprs[a].node is Lambda(_, _) {
            self.checkExpr(a, true)
        }
    }
    tyError
}

// what comes after a name's last dot (Vec2.plus: plus)
fn baseAfterDot(name: Text) -> Text {
    let b = name.bytes()
    var start = 0
    for (i, c) in b.enumerate() {
        if c == '.' {
            start = i + 1
        }
    }
    name[start..]
}

// ---- blocks and statements -----------------------------------------------------------------------------------------
// The last statement's value is the block's, when one is wanted.
fn Checker.checkBlock(var self, b: Int, wantValue: Bool) -> Int {
    let mark = len(self.c.scope)
    let result = self.c.result // the type the block's last if or match gives, when it is written
    self.c.result = -1
    let t = self.checkStmtsFrom(self.p.ast.blocks[b].stmts, 0, wantValue, result, tyVoid)
    self.truncate(mark)
    self.c.result = result
    if t >= 0 { t } else { tyVoid }
}

// a block's statements from the i-th on, and its value so far: one after another by recursion, not a loop (a loop
// that makes things collects its memory, and a block's statements make the whole checker's)
fn Checker.checkStmtsFrom(var self, stmts: [Int], i: Int, wantValue: Bool, result: Int, t: Int) -> Int {
    if i >= len(stmts) {
        return t
    }
    let s = stmts[i]
    let last = i == len(stmts) - 1
    var value = t
    if last and wantValue and self.p.ast.stmts[s].node is ExprStmt(v) {
        if self.p.ast.exprs[v].node is If(_, _, _) | Match(_, _, _) {
            self.c.result = result
        }
        self.hintLiteral(v, result)
        value = self.checkExpr(v, true)
        self.c.hint = -1
        self.c.result = -1
    } else {
        self.checkStmt(s)
        if last and self.p.ast.stmts[s].node is Return(_) {
            value = -1 // never falls through
        }
    }
    self.checkStmtsFrom(stmts, i + 1, wantValue, result, value)
}

// Does the code always leave (return, break, continue, exit, panic)? Then what follows it never runs after it.
fn Checker.leaves(self, e: Int) -> Bool {
    if e < 0 {
        return false
    }
    let t = self.ty(e)
    if t >= 0 and self.kindOf(t) == Kind.Never {
        return true
    }
    match self.p.ast.exprs[e].node {
        BlockExpr(b, _) => self.blockLeaves(b)
        If(_, then, otherwise) => otherwise >= 0 and self.blockLeaves(then) and self.leaves(otherwise)
        Match(_, arms, _) => {
            for a in arms {
                if not self.leaves(self.p.ast.arms[a].body) {
                    return false
                }
            }
            len(arms) > 0
        }
        _ => false
    }
}

fn Checker.blockLeaves(self, b: Int) -> Bool {
    let stmts = self.p.ast.blocks[b].stmts
    if len(stmts) == 0 {
        return false
    }
    match self.p.ast.stmts[stmts[len(stmts) - 1]].node {
        Return(_) | Break | Continue => true
        ExprStmt(value) => self.leaves(value)
        _ => false
    }
}

fn Checker.slotType(self, s: Int) -> Int = if s >= 0 { self.ty(s) } else { tyVoid }

// Branch values must agree; an Int and a Float become Floats. slots: each branch's value (-1: a block that gives none).
fn Checker.unifyBranches(var self, slots: [Int], at: Int) -> Int {
    let n = len(slots)
    var nevers = 0
    for s in slots {
        if s >= 0 and self.kindOf(self.ty(s)) == Kind.Never {
            nevers += 1
        }
    }
    if nevers > 0 {
        // a branch that never gives a value (exit, panic) takes the others' type
        if nevers == n {
            return tyNever
        }
        var rest: [Int] = []
        for s in slots {
            if s < 0 or self.kindOf(self.ty(s)) != Kind.Never {
                rest.push(s)
            }
        }
        let r = self.unifyBranches(rest, at)
        for s in slots {
            if s >= 0 and self.kindOf(self.ty(s)) == Kind.Never {
                self.coerce(s, r, "this branch")
            }
        }
        return r
    }
    var t = -1
    var anyFloat = false
    var allNumeric = true
    for s in slots {
        let bt = self.slotType(s)
        if self.isErr(bt) {
            return tyError
        }
        anyFloat = anyFloat or self.kindOf(bt) == Kind.Float
        allNumeric = allNumeric and self.p.isNumeric(bt)
        if t < 0 {
            t = bt
        }
    }
    if allNumeric and anyFloat {
        for s in slots {
            self.coerce(s, tyFloat, "this branch")
        }
        return tyFloat
    }
    // an optional among the branches (or a typed array among []): every branch becomes one
    var target = -1
    for s in slots {
        // a result whose error is a type, among Ok(...)s
        let bt = self.slotType(s)
        if target < 0 and self.p.isResult(bt) and self.p.errorOf(bt) != tyText {
            target = bt
        }
    }
    let result = self.c.result
    if result >= 0 and self.p.isResult(result) {
        for s in slots {
            // the written result: Ok and Err take it
            let bt = self.slotType(s)
            if target < 0 and (self.p.isResult(bt) or bt == tyErr) {
                target = result
            }
        }
    }
    for s in slots {
        let bt = self.slotType(s)
        if target < 0 and self.p.fallibleValue(bt) >= 0 {
            target = bt
        }
    }
    for s in slots {
        let bt = self.slotType(s)
        if target < 0 and self.kindOf(bt) == Kind.Array and bt != tyEmpty {
            target = bt
        }
    }
    var anyNone = false
    var anyEmpty = false
    var anyErr = false
    for s in slots {
        let bt = self.slotType(s)
        anyNone = anyNone or bt == tyNone
        anyEmpty = anyEmpty or bt == tyEmpty or bt == tyEmptyMap
        anyErr = anyErr or bt == tyErr
    }
    for s in slots {
        // Tree.Leaf among Tree<Int>s
        let bt = self.slotType(s)
        if target < 0 and self.isPlaceholder(bt) {
            for o in slots {
                let other = self.slotType(o)
                let od = self.declOf(other)
                if target < 0 and od >= 0 and self.p.ast.decls[od].templateOf == self.declOf(bt) {
                    target = other
                }
            }
        }
    }
    var anyPlaceholder = false
    for s in slots {
        anyPlaceholder = anyPlaceholder or s >= 0 and self.isPlaceholder(self.ty(s))
    }
    for s in slots {
        // a typed map among [:]
        let bt = self.slotType(s)
        if target < 0 and self.kindOf(bt) == Kind.Map and bt != tyEmptyMap {
            target = bt
        }
    }
    var anyDot = false // 90.. => .A, _ => .B: the enum among the branches, or the one written for them
    for s in slots {
        anyDot = anyDot or s >= 0 and self.ty(s) == tyDot
    }
    if anyDot {
        for s in slots {
            let bt = self.slotType(s)
            if target < 0 and self.kindOf(bt) == Kind.Enum and bt != tyDot and bt != tyNone and bt != tyErr {
                target = bt
            }
        }
    }
    if anyDot and target < 0 and result >= 0 {
        target = result
    }
    if anyDot and target < 0 {
        return tyDot // every branch a .Case: said where they are
    }
    if (anyNone or anyErr)
        and target < 0
        and result >= 0
        and (if anyErr { self.p.isResult(result) } else { self.p.isOption(result) }) {
        target = result
    }
    if (anyNone or anyErr) and target < 0 {
        // None and a T: a T?; Err(...) and a T: a T!
        for s in slots {
            let bt = self.slotType(s)
            if target < 0 and bt != tyNone and bt != tyErr and self.kindOf(bt) != Kind.Void {
                target = if anyErr { self.p.resultType(bt) } else { self.p.optionType(bt) }
            }
        }
    }
    if target >= 0 and (anyNone or anyEmpty or anyErr or anyPlaceholder or anyDot or self.kindOf(target) == Kind.Enum) {
        for s in slots {
            if s >= 0 and not self.coerce(s, target, "this branch") {
                return tyError
            }
        }
        return target
    }
    var differ = false
    for s in slots {
        differ = differ or not self.same(self.slotType(s), t)
    }
    if differ and result >= 0 and self.isInterface(result) {
        // a Dog and a Cat where a Speaker goes: each one made one
        for s in slots {
            if s >= 0 and not self.coerce(s, result, "this branch") {
                return tyError
            }
        }
        return result
    }
    for s in slots {
        let bt = self.slotType(s)
        if not self.same(bt, t) {
            self.typeError(if s >= 0 { s } else { at }, "the branches give different types: %s and %s", t, bt)
            return tyError
        }
    }
    if self.isLoop(t) {
        let arr = self.p.arrayType(self.elemOf(t))
        for s in slots {
            self.coerce(s, arr, "this branch")
        }
        return arr
    }
    t
}

fn Checker.checkIf(var self, e: Int, wantValue: Bool) -> Int {
    let If(cond, then, otherwise) = self.p.ast.exprs[e].node else {
        return tyError
    }
    let result = self.c.result // for this if's branches, not what is inside them
    self.c.result = -1
    let mark = len(self.c.scope)
    self.c.keepIs = true // if tok is Ident(name) { ... }: name in reach in the then block
    let ct = self.checkExpr(cond, true)
    if self.kindOf(ct) != Kind.Bool and not self.isErr(ct) {
        self.typeError(cond, "the condition must be a Bool, not %s", ct, -1)
    }
    self.c.result = result // the branches' own ifs and matches give the same type
    let thenT = self.checkBlock(then, wantValue)
    self.truncate(mark)
    let elseT = if otherwise >= 0 { self.checkExpr(otherwise, wantValue) } else { -1 }
    self.c.result = -1
    if otherwise < 0 {
        if wantValue and self.kindOf(thenT) != Kind.Void {
            self.sayAt(e, "an if that gives a value needs an else")
            return tyError
        }
        return tyVoid
    }
    if not wantValue {
        return tyVoid
    }
    let thenLeaves = self.blockLeaves(then)
    let elseLeaves = self.leaves(otherwise)
    if thenLeaves and elseLeaves {
        return tyNever // if c { return 1 } else { return 2 }
    }
    if self.kindOf(thenT) == Kind.Void and self.kindOf(elseT) == Kind.Void {
        return tyVoid
    }
    let slots = [self.blockValue(then), self.branchSlot(otherwise)]
    if thenLeaves != elseLeaves {
        // the branch that leaves gives nothing: the if is the other's
        let other = if thenLeaves { slots[1] } else { slots[0] }
        if other >= 0 {
            self.c.result = result
            let r = self.unifyBranches([other], e)
            self.c.result = -1
            return r
        }
    }
    if slots[0] < 0 or slots[1] < 0 {
        self.sayAt(e, "both branches must end with a value")
        return tyError
    }
    self.c.result = result
    let r = self.unifyBranches(slots, e)
    self.c.result = -1
    r
}

// ---- patterns ------------------------------------------------------------------------------------------------------
fn Checker.declareNames(var self, a: Int, t: Int, line: Int, col: Int) {
    let arm = self.p.ast.arms[a]
    if arm.whole != "" {
        let whole = self.declare(arm.whole, t, false, line, col)
        self.p.ast.arms[a].wholeBinding = whole
    }
    var bindings = [-1] * len(arm.binds)
    for (f, name) in arm.binds.enumerate() {
        let sub = arm.subs.get(f) ?? -1
        if sub >= 0 {
            self.declareNames(sub, t, line, col)
        } else if name != "_" {
            bindings[f] = self.declare(name, t, false, line, col)
        }
    }
    self.p.ast.arms[a].bindings = bindings
}

// A pattern on a value of type t: Some(x), Circle(r, _), Point(x, 0), (q, r), 3, "quit", with patterns inside; its
// names declared. False when it cannot be one of t's. When t is not known (a template's T, or an error said already)
// its names are in reach, of no known type, so the rest is checked loosely.
fn Checker.bindPattern(var self, a: Int, t: Int, at: Int) -> Bool {
    let line = self.p.ast.exprs[at].line
    let col = self.p.ast.exprs[at].col
    if self.isErr(t) {
        self.declareNames(a, t, line, col)
        return false
    }
    let arm = self.p.ast.arms[a]
    if arm.whole != "" {
        // n if n > 2: the value itself
        let whole = self.declare(arm.whole, t, false, line, col)
        self.p.ast.arms[a].wholeBinding = whole
        return true
    }
    if arm.textPattern >= 0 {
        if self.kindOf(t) == Kind.Text {
            return true
        }
        self.typeError(arm.textPattern, "a text pattern, but the value is %s", t, -1)
        return false
    }
    if arm.intPattern >= 0 or arm.isRange {
        if arm.intPattern >= 0 and self.p.ast.exprs[arm.intPattern].node is BoolLit(_) {
            if self.kindOf(t) == Kind.Bool {
                return true
            }
            self.typeError(arm.intPattern, "a Bool pattern, but the value is %s", t, -1)
            return false
        }
        if self.kindOf(t) is Int | Float {
            return true // Box(w, 1): a Float field too
        }
        self.typeError(
            if arm.intPattern >= 0 { arm.intPattern } else { arm.intHigh },
            "an Int pattern, but the value is %s",
            t,
            -1,
        )
        return false
    }
    if arm.pattern == "" {
        return true // _
    }
    let d = self.declOf(t)
    var fields: [Int] = []
    if self.kindOf(t) == Kind.Record {
        // Point(x, y), (q, r): the record itself
        if not self.accessLayout(d, at) {
            return false
        }
        let x = self.p.ast.decls[d]
        let name = if x.isEntry {
            "Entry"
        } else if x.templateOf >= 0 {
            self.declName(x.templateOf)
        } else {
            x.name
        }
        let tuple = arm.pattern == "(,)"
        if tuple != x.isTuple or not tuple and arm.pattern != name {
            let what = if tuple { "a tuple" } else { arm.pattern }
            self.say(line, col, "{what} is not a pattern of {self.tname(t)}")
            return false
        }
        self.p.ast.arms[a].caseIndex = 0
        fields = x.params
    } else if self.kindOf(t) == Kind.Enum and t != tyNone and t != tyErr {
        let cases = self.p.ast.decls[d].cases
        let k = cases.indexOf(arm.pattern) ?? -1
        self.p.ast.arms[a].caseIndex = k
        if k < 0 {
            let close = closest(arm.pattern, cases)
            if close != "" {
                self.say(line, col, "{self.declName(d)} has no case {arm.pattern}: did you mean {close}?")
            } else {
                self.say(line, col, "{self.declName(d)} has no case {arm.pattern}")
            }
            return false
        }
        fields = self.p.ast.decls[d].caseFields[k]
    } else {
        self.say(line, col, "{arm.pattern} is a pattern of a case or a record, but the value is {self.tname(t)}")
        return false
    }
    let count = len(fields)
    if (len(arm.binds) > 0 or self.kindOf(t) == Kind.Record) and len(arm.binds) != count {
        self.say(line, col, "{arm.pattern} carries {count} value{plural(count)}: name each (or _)")
        return false
    }
    var bindings = [-1] * len(arm.binds)
    self.p.ast.arms[a].bindings = bindings
    for (f, name) in arm.binds.enumerate() {
        let ft = self.paramType(fields[f])
        let sub = arm.subs.get(f) ?? -1
        if sub >= 0 {
            if not self.bindPattern(sub, ft, at) {
                return false
            }
            let alternatives = self.p.ast.arms[sub].alternatives
            for alt in alternatives {
                if not self.bindPattern(alt, ft, at) {
                    return false
                }
            }
            if len(alternatives) > 0 and self.namesAny(sub) {
                self.say(line, col, "alternatives (|) cannot bind values or destructure fields")
                return false
            }
            for alt in alternatives {
                if self.namesAny(alt) {
                    self.say(line, col, "alternatives (|) cannot bind values or destructure fields")
                    return false
                }
            }
            continue
        }
        if name == "_" {
            continue
        }
        bindings[f] = self.declare(name, ft, false, line, col)
        self.p.ast.arms[a].bindings = bindings
    }
    true
}

// the types of a record's fields, or of a case's data
fn Checker.fieldType(self, t: Int, k: Int, f: Int) -> Int {
    let d = self.declOf(t)
    if self.kindOf(t) == Kind.Record {
        return self.paramType(self.p.ast.decls[d].params[f])
    }
    self.paramType(self.p.ast.decls[d].caseFields[k][f])
}

fn Checker.fieldsOf(self, t: Int, k: Int) -> Int {
    let d = self.declOf(t)
    if self.kindOf(t) == Kind.Record {
        return len(self.p.ast.decls[d].params)
    }
    if k >= 0 and k < len(self.p.ast.decls[d].caseFields) {
        len(self.p.ast.decls[d].caseFields[k])
    } else {
        0
    }
}

// Can a pattern fail on a value of its type? Names, _, records and one-case enums of patterns that cannot.
fn Checker.refutable(self, a: Int, t: Int) -> Bool {
    let arm = self.p.ast.arms[a]
    if arm.textPattern >= 0 or arm.intPattern >= 0 or arm.isRange or len(arm.alternatives) > 0 or arm.valuePattern >= 0 {
        return true
    }
    if arm.pattern == "" {
        return false
    }
    if self.kindOf(t) == Kind.Enum and len(self.p.ast.decls[self.declOf(t)].cases) > 1 {
        return true
    }
    for (f, sub) in arm.subs.enumerate() {
        if sub >= 0 and f < len(arm.binds) and self.refutable(sub, self.fieldType(t, arm.caseIndex, f)) {
            return true
        }
    }
    false
}

// ---- exhaustiveness: do the arms cover every value? A matrix of patterns (rows: arms; -1: anything), its first
// column taken apart case by case (Maranget's way, as OCaml and Rust do).
fn Checker.wildcardPattern(self, a: Int) -> Bool {
    if a < 0 {
        return true
    }
    let arm = self.p.ast.arms[a]
    arm.pattern == ""
        and arm.intPattern < 0
        and not arm.isRange
        and arm.textPattern < 0
        and len(arm.alternatives) == 0
        and arm.valuePattern < 0
}

fn Checker.intOf(self, e: Int) -> Int = match self.p.ast.exprs[e].node {
    IntLit(v, _) => v
    BoolLit(v) => if v { 1 } else { 0 }
    _ => 0
}

fn Checker.coversPattern(self, previous: Int, current: Int) -> Bool {
    let p = self.p.ast.arms[previous]
    let c = self.p.ast.arms[current]
    if p.guard >= 0 {
        return false
    }
    if self.wildcardPattern(previous) {
        return true
    }
    if p.textPattern >= 0 and c.textPattern >= 0 {
        let TextLit(a, _, _) = self.p.ast.exprs[p.textPattern].node else {
            return false
        }
        let TextLit(b, _, _) = self.p.ast.exprs[c.textPattern].node else {
            return false
        }
        return a == b
    }
    if not p.isRange and not c.isRange and p.intPattern >= 0 and c.intPattern >= 0 {
        let pBool = self.p.ast.exprs[p.intPattern].node is BoolLit(_)
        let cBool = self.p.ast.exprs[c.intPattern].node is BoolLit(_)
        return pBool == cBool and self.intOf(p.intPattern) == self.intOf(c.intPattern)
    }
    let currentInt = c.intPattern >= 0 and self.p.ast.exprs[c.intPattern].node is IntLit(_, _)
    if not p.isRange or not (c.isRange or currentInt) {
        return false
    }
    let startsInside = p.intPattern < 0 or c.intPattern >= 0 and self.intOf(c.intPattern) >= self.intOf(p.intPattern)
    let endsInside = p.intHigh < 0 or (if c.isRange {
        c.intHigh >= 0 and self.intOf(c.intHigh) <= self.intOf(p.intHigh)
    } else {
        self.intOf(c.intPattern) < self.intOf(p.intHigh)
    })
    startsInside and endsInside
}

fn Checker.covers(self, rows: [[Int]], cols: [Int], depth: Int) -> Bool {
    if len(rows) == 0 {
        return false
    }
    if len(cols) == 0 or depth > 40 {
        return true
    }
    let t = cols[0]
    if self.kindOf(t) == Kind.Bool {
        for value in 0..2 {
            var keep: [[Int]] = []
            for row in rows {
                let a = row[0]
                if self.wildcardPattern(a) {
                    keep.push(row[1..])
                } else {
                    let ip = self.p.ast.arms[a].intPattern
                    if ip >= 0 and self.p.ast.exprs[ip].node is BoolLit(_) and self.intOf(ip) == value {
                        keep.push(row[1..])
                    }
                }
            }
            if not self.covers(keep, cols[1..], depth + 1) {
                return false
            }
        }
        return true
    }
    var split = false // does the first column take values apart (cases, records)?
    for row in rows {
        split = split or row[0] >= 0 and self.p.ast.arms[row[0]].pattern != ""
    }
    let enumSplit = split and self.kindOf(t) == Kind.Enum
    let ways = if enumSplit {
        len(self.p.ast.decls[self.declOf(t)].cases)
    } else {
        1
    }
    if not split {
        // anything, or literals: only the rows that take anything cover the rest
        var keep: [[Int]] = []
        for row in rows {
            if self.wildcardPattern(row[0]) {
                keep.push(row[1..])
            }
        }
        return self.covers(keep, cols[1..], depth + 1)
    }
    for k in 0..ways {
        // each case (or the record): its fields, then the other columns
        let fields = self.fieldsOf(t, k)
        var sub: [Int] = []
        for f in 0..fields {
            sub.push(self.fieldType(t, k, f))
        }
        sub += cols[1..]
        var next: [[Int]] = []
        for row in rows {
            let a = row[0]
            let wild = self.wildcardPattern(a)
            if not wild and (self.p.ast.arms[a].pattern == "" or enumSplit and self.p.ast.arms[a].caseIndex != k) {
                continue
            }
            var r: [Int] = []
            for f in 0..fields {
                var s = -1
                if a >= 0 {
                    let arm = self.p.ast.arms[a]
                    if f < len(arm.binds) {
                        s = arm.subs.get(f) ?? -1
                    }
                }
                r.push(s)
            }
            r += row[1..]
            next.push(r)
        }
        if not self.covers(next, sub, depth + 1) {
            return false
        }
    }
    true
}

// Does a case's arm need its data's patterns to match too (Some(Circle(r))): then it does not cover the case
fn Checker.subsRefutable(self, a: Int, t: Int) -> Bool {
    let arm = self.p.ast.arms[a]
    if len(arm.subs) == 0 or self.kindOf(t) != Kind.Enum {
        return false
    }
    for (f, sub) in arm.subs.enumerate() {
        if sub >= 0 and f < len(arm.binds) and self.refutable(sub, self.fieldType(t, arm.caseIndex, f)) {
            return true
        }
    }
    false
}

// Does a pattern name a value (Circle(r))? Circle(_) names none.
fn Checker.namesAny(self, a: Int) -> Bool {
    let arm = self.p.ast.arms[a]
    if arm.whole != "" {
        return true
    }
    for (f, name) in arm.binds.enumerate() {
        let sub = arm.subs.get(f) ?? -1
        if sub >= 0 {
            if self.namesAny(sub) {
                return true
            }
        } else if name != "_" {
            return true
        }
    }
    false
}

// Alternatives share a guard and a body: they are checked as arms of their own, after the arm they belong to (marked
// expanded), while the arm keeps its spelling for the formatter and graphs.
fn Checker.expandMatchAlternatives(var self, e: Int) {
    let Match(subject, arms, chain) = self.p.ast.exprs[e].node else {
        return
    }
    var count = len(arms)
    for a in arms {
        if self.p.ast.arms[a].expanded {
            return // already expanded
        }
        count += len(self.p.ast.arms[a].alternatives)
    }
    if count == len(arms) {
        return
    }
    var expanded: [Int] = []
    for a in arms {
        expanded.push(a)
        let arm = self.p.ast.arms[a]
        if len(arm.alternatives) == 0 {
            continue
        }
        var bindings = self.namesAny(a)
        for alt in arm.alternatives {
            bindings = bindings or self.namesAny(alt)
            let copy = self.p.ast.arms[alt] with { guard: arm.guard, body: arm.body, expanded: true }
            expanded.push(self.p.ast.arm(copy))
        }
        if bindings {
            self.sayAt(arm.body, "alternatives in a match arm cannot bind values or destructure fields")
        }
    }
    self.p.ast.exprs[e].node = .Match(subject, expanded, chain)
}

// the name a?.rest reads into: the hole at the start of rest
fn Checker.holeOf(self, body: Int) -> Text {
    var x = body
    var steps = 0
    while steps < 100000 {
        steps += 1
        match self.p.ast.exprs[x].node {
            Name(name) => {
                return name
            }
            Call(_, _, args, _, _, _) => {
                x = args[0]
            }
            Field(target, _) => {
                x = target
            }
            Index(target, _) => {
                x = target
            }
            Try(value) => {
                x = value
            }
            With(target, _, _) => {
                x = target
            }
            Match(subject, _, _) => {
                x = subject
            }
            Unary(_, operand) => {
                x = operand
            }
            Binary(_, left, _) => {
                x = left
            }
            _ => {
                return ""
            }
        }
    }
    ""
}

fn Checker.checkMatch(var self, e: Int, wantValue: Bool) -> Int {
    let errors = self.errors.count
    self.expandMatchAlternatives(e)
    let result = self.c.result
    self.c.result = -1
    let Match(subject, firstArms, chain) = self.p.ast.exprs[e].node else {
        return tyError
    }
    let t = self.checkExpr(subject, true)
    let line = self.p.ast.exprs[e].line
    let col = self.p.ast.exprs[e].col
    if chain and len(firstArms) == 1 {
        // a?.rest: Some(#c) => #c.rest, None => None (or Ok / Err(#e) => Err(#e))
        if self.isErr(t) {
            return t
        }
        if not self.p.isOption(t) and not self.p.isResult(t) {
            self.typeError(subject, "?. reads into an optional or a result, not %s", t, -1)
            return tyError
        }
        let option = self.p.isOption(t)
        let held = firstArms[0]
        let hole = self.holeOf(self.p.ast.arms[held].body)
        self.p.ast.arms[held].pattern = if option { "Some" } else { "Ok" }
        self.p.ast.arms[held].binds = [hole]
        var empty = Arm(pattern: if option { "None" } else { "Err" }, hidden: true)
        if option {
            empty.body = self.newExpr(.Name("None"), line, col)
        } else {
            empty.binds = ["#e"]
            let why = self.newExpr(.Name("#e"), line, col)
            empty.body = self.newExpr(.Call("Err", "", [why], [""], false, false), line, col)
        }
        let added = self.p.ast.arm(empty)
        self.p.ast.exprs[e].node = .Match(subject, firstArms + [added], chain)
    }
    let Match(_, arms, _) = self.p.ast.exprs[e].node else {
        return tyError
    }
    let tk = self.kindOf(t)
    let onText = tk == Kind.Text
    let onRecord = tk == Kind.Record
    let onBool = tk == Kind.Bool
    let onNumber = tk is Int | Float // Int patterns on a Float: compared exactly
    if not tk == Kind.Enum and not onNumber and not onText and not onRecord and not onBool or t == tyNone or t == tyErr {
        if not self.isErr(t) {
            self.typeError(
                subject,
                "match works on an enum, an optional, a result, a record, a Bool, a number or a Text, not %s",
                t,
                -1,
            )
        }
        return tyError
    }
    let state = self.checkArms(arms, 0, t, result, wantValue, ArmsState(false, [false] * 256))
    var wildcard = state.wildcard
    let seen = state.seen
    if not wildcard and (onRecord or tk == Kind.Enum) {
        // patterns inside patterns: is every value covered?
        var nested = onRecord
        for a in arms {
            nested = nested or len(self.p.ast.arms[a].subs) > 0
        }
        if nested {
            var rows: [[Int]] = []
            var fine = true
            for a in arms {
                let arm = self.p.ast.arms[a]
                if arm.guard >= 0 {
                    continue
                }
                fine = fine and (arm.pattern == "" or arm.caseIndex >= 0)
                rows.push([a])
            }
            if fine and self.covers(rows, [t], 0) {
                wildcard = true
            } else if fine {
                self.sayAt(e, "this match may miss some values: cover them, or add a last arm _ => ...")
                wildcard = true // said
            }
        }
    }
    if not wildcard {
        if onRecord {
            self.sayAt(e, "this match may miss some values: add a last arm _ => ...")
        } else if onNumber {
            self.sayAt(e, "a match on {if tk == Kind.Int { "an Int" } else { "a Float" }} needs a last arm _ => ...")
        } else if onText {
            self.sayAt(e, "a match on a Text needs a last arm _ => ...")
        } else if onBool {
            if not seen[0] or not seen[1] {
                self.sayAt(e, "this match misses {if seen[0] { "true" } else { "false" }} (or add _ => ...)")
            }
        } else {
            let d = self.declOf(t)
            let cases = self.p.ast.decls[d].cases
            for (k, c) in cases.enumerate() {
                if k < 256 and not seen[k] {
                    self.sayAt(e, "this match misses {self.declName(d)}.{c} (or add _ => ...)")
                    break
                }
            }
        }
    }
    if errors != self.errors.count {
        return tyError
    }
    if not wantValue {
        return tyVoid
    }
    var slots: [Int] = []
    var allVoid = true
    for a in arms {
        let arm = self.p.ast.arms[a]
        if arm.expanded {
            continue
        }
        let slot = self.branchSlot(arm.body)
        if slot >= 0 and self.ty(slot) >= 0 and self.kindOf(self.ty(slot)) != Kind.Void {
            allVoid = false
        }
        slots.push(slot)
    }
    if allVoid {
        return tyVoid
    }
    for s in slots {
        if s < 0 {
            self.sayAt(e, "every arm must give a value")
            return tyError
        }
    }
    if chain and self.p.isResult(t) and len(slots) == 2 {
        // a?.rest on a result: what rest gives, or a's Err, as one result
        let held = self.ty(slots[0])
        let error = self.p.errorOf(t)
        let r = if self.p.isResult(held) and self.same(self.p.errorOf(held), error) {
            held
        } else {
            self.p.resultOfType(held, error)
        }
        if r != held {
            self.wrap(slots[0], bOk, r) // what rest gives, as Ok (an optional too: Int? ! E)
        }
        if not self.coerce(slots[1], r, "this branch") {
            return tyError
        }
        return r
    }
    self.c.result = result
    let r = self.unifyBranches(slots, e)
    self.c.result = -1
    r
}

// let Some(x) = value else { return }: the names hold the case's data from here on
fn Checker.checkLetElse(var self, s: Int, value: Int, a: Int, otherwise: Int) {
    let t = self.checkExpr(value, true)
    let line = self.p.ast.stmts[s].line
    let col = self.p.ast.stmts[s].col
    let ok = self.kindOf(t) is Enum | Record and t != tyNone and t != tyErr
    if not ok and not self.isErr(t) {
        self.typeError(
            value,
            "let Case(...) = value takes apart an enum, an optional, a result, a record or a tuple, not %s",
            t,
            -1,
        )
    }
    if otherwise >= 0 {
        self.checkBlock(otherwise, false)
        if not self.blockLeaves(otherwise) {
            let pattern = self.p.ast.arms[a].pattern
            let shown = if pattern != "(,)" { pattern } else { "" }
            self.say(line, col, "the else of let {shown}(...) must leave: end it with return, break, continue or exit")
        }
    }
    if ok and self.bindPattern(a, t, value) {
        if otherwise < 0 and self.refutable(a, t) {
            self.say(line, col, "this pattern may not match: say what happens then, let ... = value else \{ return \}")
        }
        return
    }
    // unknown: no more errors
    let binds = self.p.ast.arms[a].binds
    var bindings = [-1] * len(binds)
    for (f, name) in binds.enumerate() {
        if name != "_" {
            bindings[f] = self.declare(name, tyError, false, line, col)
        }
    }
    self.p.ast.arms[a].bindings = bindings
}

fn Checker.makeMutable(var self, a: Int) {
    let arm = self.p.ast.arms[a]
    for (f, _) in arm.binds.enumerate() {
        let b = arm.bindings.get(f) ?? -1
        if b >= 0 {
            self.p.bindings[b].mutable = true
        }
        let sub = arm.subs.get(f) ?? -1
        if sub >= 0 {
            self.makeMutable(sub)
        }
    }
}

// p[i], p[i].field, p[i].inner.field: a place in C's memory
fn Checker.pointerPlace(self, e: Int) -> Bool {
    var x = e
    while true {
        match self.p.ast.exprs[x].node {
            Field(target, _) => {
                let t = self.ty(target)
                if t >= 0 and self.kindOf(t) == Kind.Record and self.p.ast.decls[self.declOf(t)].cStruct {
                    x = target
                } else {
                    return false
                }
            }
            Index(target, _) => {
                let t = self.ty(target)
                return t >= 0 and self.kindOf(t) == Kind.Pointer
            }
            _ => {
                return false
            }
        }
    }
    false
}

fn Checker.checkStmt(var self, s: Int) {
    let line = self.p.ast.stmts[s].line
    let col = self.p.ast.stmts[s].col
    match self.p.ast.stmts[s].node {
        Let(mutable, name, ty, value, pattern, otherwise) => self.checkLet(
            s,
            mutable,
            name,
            ty,
            value,
            pattern,
            otherwise,
        )
        Assign(target, op, value) => self.checkAssign(s, target, op, value)
        ExprStmt(value) => {
            self.checkExpr(value, false)
            let t = self.ty(value)
            if self.p.isResult(t) {
                self.sayAt(value, "this result is discarded: handle it, propagate it with ?, or write let _ = ...")
            }
            let kept = self.p.ast.exprs[value].node is Call(_, _, _, _, _, _) | If(_, _, _) | Match(_, _, _) | BlockExpr(_, _) | Try(_)
            if not kept and not self.isErr(t) {
                self.sayAt(value, "this value is not used: keep it with let, or remove it")
            }
        }
        For(name, pattern, iter, body) => self.checkFor(s, name, pattern, iter, body)
        Defer(body) => {
            if self.c.lambdaDepth > 0 {
                self.say(line, col, "defer belongs in a function's block, not in a lambda")
                return
            }
            let loops = self.c.loopDepth
            self.c.loopDepth = 0 // a break inside it would leave the defer, not a loop
            self.c.deferDepth += 1
            self.checkBlock(body, false)
            self.c.deferDepth -= 1
            self.c.loopDepth = loops
        }
        While(cond, body) => {
            self.c.loopDepth += 1
            let mark = len(self.c.scope)
            self.c.keepIs = true // while peek() is Some(t) { ... }: t in reach in the body
            let t = self.checkExpr(cond, true)
            if self.kindOf(t) != Kind.Bool and not self.isErr(t) {
                self.typeError(cond, "the condition must be a Bool, not %s", t, -1)
            }
            self.checkBlock(body, false)
            self.truncate(mark)
            self.c.loopDepth -= 1
        }
        Return(value) => self.checkReturn(s, value)
        Break => if self.c.lambdaDepth > 0 {
            self.say(line, col, "break and continue cannot leave a lambda")
        } else if self.c.loopDepth == 0 {
            self.say(line, col, "break outside a loop")
        }
        Continue => if self.c.lambdaDepth > 0 {
            self.say(line, col, "break and continue cannot leave a lambda")
        } else if self.c.loopDepth == 0 {
            self.say(line, col, "continue outside a loop")
        }
    }
}

fn Checker.checkLet(var self, s: Int, mutable: Bool, name: Text, ty: Int, value: Int, pattern: Int, otherwise: Int) {
    let line = self.p.ast.stmts[s].line
    let col = self.p.ast.stmts[s].col
    let keyword = if mutable { "var" } else { "let" }
    if pattern >= 0 {
        self.checkLetElse(s, value, pattern, otherwise)
        if mutable {
            self.makeMutable(pattern) // var (lo, hi) = ...: names that change
        }
        return
    }
    if name == "_" {
        let t = self.checkExpr(value, true)
        if ty >= 0 {
            let want = self.resolveType(ty)
            self.coerce(value, want, "discarded value")
        } else if t == tyNone or t == tyErr or t == tyEmpty or t == tyEmptyMap {
            self.say(line, col, "the discarded value needs a type")
        }
        return
    }
    let readsBefore = self.c.varReads
    let declaring = self.c.declaring
    self.c.declaring = name // let fact: (Int) -> Int = n => ... fact(n - 1): said clearly
    if ty >= 0 {
        let hint = self.resolveType(ty)
        self.setHint(hint)
    }
    if ty >= 0 and self.p.ast.exprs[value].node is If(_, _, _) | Match(_, _, _) {
        self.c.result = self.c.hint // its branches' .Case
    }
    var t = self.checkExpr(value, true)
    self.c.hint = -1
    self.c.result = -1
    if ty >= 0 {
        let want = self.resolveType(ty)
        self.coerce(value, want, name)
        t = want
    }
    if self.kindOf(t) == Kind.Void {
        self.sayAt(value, "this gives nothing to keep in \"{name}\"")
        t = tyError
    }
    if t == tyDot {
        // let c = .Red: no enum to go into (inside an if or a match: said at the end)
        if self.isDotted(value) {
            self.dottedError(value)
        }
        t = tyError
    }
    if self.isPlaceholder(t) {
        let dn = self.declName(self.declOf(t))
        self.sayAt(value, "{dn} needs its type written: {keyword} {name}: {dn}<...> = ...")
        t = tyError
    }
    if t == tyNone or t == tyEmpty or t == tyErr or t == tyEmptyMap {
        let what = if t == tyNone {
            "None"
        } else if t == tyEmpty {
            "[]"
        } else if t == tyErr {
            "Err(...)"
        } else {
            "[:]"
        }
        let example = if t == tyNone {
            "Int?"
        } else if t == tyEmpty {
            "[Int]"
        } else if t == tyErr {
            "Int!"
        } else {
            "[Text: Int]"
        }
        self.sayAt(value, "{what} needs its type written: {keyword} {name}: {example} = ...")
        t = tyError
    }
    if t == tyLambda {
        if self.p.ast.exprs[value].node is Lambda(params, _) {
            // let f = (x: Int) => ...: its type from its parameters'
            var typed = len(params) <= 16
            for prm in params {
                typed = typed and self.p.ast.params[prm].ty >= 0
            }
            if typed {
                var ps: [Int] = []
                for prm in params {
                    ps.push(self.resolveType(self.p.ast.params[prm].ty))
                }
                t = if self.liftLambda(value, ps, -1, false, true) {
                    self.ty(value) // its effects: its body's
                } else {
                    tyError
                }
            }
        }
    }
    if t == tyLambda {
        self.sayAt(
            value,
            "a lambda kept in \"{name}\" needs its type written: {keyword} {name}: (Int) -> Int = x => ...",
        )
        t = tyError
    }
    let loop = self.isLoop(t)
    if loop and mutable {
        self.markIterUse(value)
        let arr = self.p.arrayType(self.elemOf(t))
        self.coerce(value, arr, name)
        t = self.ty(value)
    }
    self.c.declaring = declaring
    let bt = if loop { self.p.arrayType(self.elemOf(t)) } else { t }
    let b = self.declare(name, bt, mutable, line, col + 4) // at the name
    self.p.bindings[b].init = value
    self.p.bindings[b].readsVar = self.c.varReads != readsBefore
    self.p.ast.stmts[s].binding = b
    if loop {
        self.c.lets.push(b)
    }
}

fn Checker.checkAssign(var self, s: Int, target: Int, op: Op, value: Int) {
    let line = self.p.ast.stmts[s].line
    let col = self.p.ast.stmts[s].col
    match self.p.ast.exprs[target].node {
        Field(inner, _) => self.markPlace(inner)
        // m[k].n = 1: the value itself
        Index(inner, _) => self.markPlace(inner)
        _ => {}
    }
    var tt = self.checkExpr(target, true)
    if self.p.ast.exprs[target].node is Field(inner, field) {
        let it = self.ty(inner)
        if it >= 0 and self.isInterface(it) {
            self.sayAt(
                target,
                "{field} is a function of the type the value has: an interface's functions are never set",
            )
            return
        }
    }
    if self.p.ast.exprs[target].node is Index(inner, index) {
        if self.p.ast.exprs[index].node is Range(_, _) {
            self.sayAt(target, "a slice is a copy: set the elements one by one, xs[i] = ...")
            return
        }
        let it = self.ty(inner)
        if it >= 0 and self.kindOf(it) == Kind.Map {
            // m[k] = v
            tt = self.elemOf(it)
            if op != Op.Assign {
                self.say(line, col, "m[key] gives an optional: write m[key] = (m[key] ?? 0) + 1")
                return
            }
        }
    }
    if self.pointerPlace(target) {
        // p[i] = v, p[i].field = v: C's memory, written (an effect; p need not be a var)
        self.needEffect(target, "writing through a pointer")
        let vt = self.checkExpr(value, true)
        if op != Op.Assign and (not self.p.isNumeric(tt) or not op is PlusEq | MinusEq | StarEq | SlashEq) {
            self.typeError(
                target,
                "%s through a pointer changes with =, or with += -= *= /= when it is a number",
                tt,
                -1,
            )
            return
        }
        if op != Op.Assign and self.kindOf(tt) == Kind.Int and self.kindOf(vt) == Kind.Float {
            self.typeError(value, "an Int changed by a Float: write toInt(...) or make it a Float", -1, -1)
            return
        }
        self.coerce(value, tt, "the new value")
        return
    }
    let (root, inside) = self.placeVar(target)
    var targetIsBytesIndex = false
    if self.p.ast.exprs[target].node is Index(inner, _) {
        let it = self.ty(inner)
        targetIsBytesIndex = it >= 0 and self.kindOf(it) == Kind.Bytes
    }
    if root < 0 and self.isErr(tt) {
        // said
    } else if targetIsBytesIndex {
        self.sayAt(target, "a byte of Bytes is not set in place: make new Bytes (b[..i] + [x] + b[i + 1..])")
    } else if root < 0 {
        self.sayAt(target, "only a var, or a field or element of one, can be set")
    } else if not self.p.bindings[root].mutable {
        self.notChangeable(target, root, "")
    } else if self.pureChange(target, root) {
        // said
    } else if inside {
        self.p.bindings[root].deep = true // a.items[i] = v: the arrays in a's value are its own
    }
    self.throughBox(target, if op == Op.Assign {
        target // through a box: a new value
    } else {
        -1
    })
    if op == Op.Assign {
        self.hintLiteral(value, tt) // r.port = fromJson(j)?: the place's type
    }
    let vt = self.checkExpr(value, true)
    self.c.hint = -1
    let tk = self.kindOf(tt)
    if op is PercentEq | AmpEq | PipeEq | CaretEq | ShlEq | ShrEq | PlusWrapEq | MinusWrapEq | StarWrapEq
        or op == Op.PlusEq and tk is Text | Bytes | Array {
        // x %= y, x <<= y, h *%= k, s += t, xs += ys: x = x % y, the operator's own checks
        let binary = match op {
            PlusEq => Op.Plus
            PlusWrapEq => Op.PlusWrap
            MinusWrapEq => Op.MinusWrap
            StarWrapEq => Op.StarWrap
            PercentEq => Op.Percent
            AmpEq => Op.Amp
            PipeEq => Op.Pipe
            CaretEq => Op.Caret
            ShlEq => Op.Shl
            _ => Op.Shr
        }
        let e = self.newExpr(.Binary(binary, target, value), line, col)
        self.p.ast.exprs[e].implicit = true
        self.p.ast.exprs[target].typed = true
        self.p.ast.exprs[value].typed = true
        let r = self.checkBinary(e)
        self.setTy(e, r)
        if not self.isErr(r) and not self.isErr(tt) and not self.same(r, tt) {
            self.typeError(value, "the new value: expected %s, found %s", tt, r)
        }
        self.p.ast.stmts[s].opValue = e
        return
    }
    if op != Op.Assign {
        if self.hasOperators(tt) {
            // v += w: v = v + w, through the type's plus
            let binary = match op {
                PlusEq => Op.Plus
                MinusEq => Op.Minus
                StarEq => Op.Star
                _ => Op.Slash
            }
            let e = self.newExpr(.Binary(binary, target, value), line, col)
            self.p.ast.exprs[e].implicit = true
            let r = self.checkOperator(e, false)
            self.setTy(e, r)
            if not self.isErr(r) and not self.same(r, tt) {
                self.typeError(value, "the new value: expected %s, found %s", tt, r)
            }
            self.p.ast.stmts[s].opValue = e
            return
        }
        if not self.p.isNumeric(tt) {
            self.typeError(target, "%s cannot be changed with +=, -=, *= or /=", tt, -1)
        }
        if tk == Kind.Int and self.kindOf(vt) == Kind.Float {
            self.typeError(value, "an Int changed by a Float: write toInt(...) or make it a Float", -1, -1)
            return
        }
    }
    if self.isLoop(vt) {
        self.markIterUse(value)
    }
    let _ = self.coerce(value, tt, "the new value")
}

fn Checker.checkFor(var self, s: Int, name: Text, pattern: Int, iter: Int, body: Int) {
    let line = self.p.ast.stmts[s].line
    let col = self.p.ast.stmts[s].col
    var t = self.checkExpr(iter, true)
    let overMap = self.kindOf(t) == Kind.Map and self.keyOf(t) >= 0 // for e in m: its entries; for x in s: a set's values
    if not self.p.isIterable(t) and not overMap {
        if not self.isErr(t) {
            let elem = self.checkSourceExpr(iter)
            t = if self.isErr(elem) { elem } else { self.ty(iter) }
        }
    }
    self.markIterUse(iter)
    let mark = len(self.c.scope)
    self.c.loopDepth += 1
    if pattern >= 0 {
        var elem = if self.isErr(t) { t } else { self.elemOf(t) }
        if overMap {
            if self.p.isSet(t) {
                elem = self.keyOf(t)
            } else {
                elem = if self.p.ast.arms[pattern].pattern == "(,)" {
                    self.p.tupleType([self.keyOf(t), self.elemOf(t)])
                } else {
                    self.p.entryType(self.keyOf(t), self.elemOf(t))
                }
            }
            let it = self.p.iterType(elem)
            self.wrap(iter, bEntries, it)
        }
        if elem < 0 {
            elem = tyError
        }
        if self.bindPattern(pattern, elem, iter) and self.refutable(pattern, elem) {
            self.say(line, col, "a for pattern must match every element")
        }
        self.checkBlock(body, false)
        self.c.loopDepth -= 1
        self.truncate(mark)
        return
    }
    if overMap and not self.p.isSet(t) {
        // Entry(key, value), in the order the keys came
        let entry = self.p.entryType(self.keyOf(t), self.elemOf(t))
        let it = self.p.iterType(entry)
        self.wrap(iter, bEntries, it)
        t = self.ty(iter)
    }
    if name != "_" {
        let bt = if self.isErr(t) {
            t
        } else if self.p.isSet(t) {
            self.keyOf(t)
        } else {
            self.elemOf(t)
        }
        let b = self.declare(name, if bt >= 0 { bt } else { tyError }, false, line, col + 4)
        self.p.ast.stmts[s].binding = b
        // for i in 0..len(xs), xs a let or a parameter: xs[i] needs no bounds check
        if self.p.ast.exprs[iter].node is Range(low, high)
            and low >= 0
            and high >= 0
            and self.p.ast.exprs[low].node is IntLit(v, _)
            and v >= 0
            and self.p.ast.exprs[high].builtin == bLen {
            let largs = self.argsOf(high)
            if len(largs) == 1 and self.p.ast.exprs[high].node is Call(_, _, _, _, _, _) {
                let arr = largs[0]
                let ab = self.p.ast.exprs[arr].binding
                if self.p.ast.exprs[arr].node is Name(_)
                    and ab >= 0
                    and not self.p.bindings[ab].mutable
                    and self.kindOf(self.p.bindings[ab].ty) == Kind.Array {
                    self.p.bindings[b].safeIn = ab
                }
            }
        }
    }
    self.checkBlock(body, false)
    self.c.loopDepth -= 1
    self.truncate(mark)
}

fn Checker.checkReturn(var self, s: Int, value: Int) {
    let line = self.p.ast.stmts[s].line
    let col = self.p.ast.stmts[s].col
    if self.c.deferDepth > 0 {
        self.say(line, col, "a defer's block cannot leave its function: no return in it")
        return
    }
    if self.c.lambdaDepth > 0 {
        self.say(line, col, "return inside a lambda: a lambda is one expression")
        return
    }
    let f = self.c.fnDecl
    let want = self.p.ast.decls[f].retType
    let blockBody = self.p.ast.exprs[self.p.ast.decls[f].body].node is BlockExpr(_, _)
    if want < 0 and value < 0 and blockBody {
        // return, alone: the function gives nothing
        self.p.ast.decls[f].retType = tyVoid
        self.p.ast.decls[f].returnsEarly = true
        return
    }
    let fname = self.declName(f)
    if want < 0 {
        self.say(line, col, "a function that returns early needs its type written: fn {fname}(...) -> Type")
        if value >= 0 {
            self.checkExpr(value, true)
        }
        return
    }
    if value < 0 {
        if self.kindOf(want) != Kind.Void {
            self.say(line, col, "{fname} must return a value")
        }
        return
    }
    if self.p.ast.exprs[value].node is If(_, _, _) | Match(_, _, _) {
        self.c.result = want
    }
    if self.p.ast.exprs[value].node is Call("mapErr", _, _, _, _, _) and self.p.isResult(want) {
        self.c.errorWant = self.p.errorOf(want)
    }
    self.hintLiteral(value, want)
    let t = self.checkExpr(value, true)
    self.c.hint = -1
    self.c.result = -1
    self.c.errorWant = -1
    if self.isLoop(t) {
        self.markIterUse(value)
    }
    let _ = self.coerce(value, want, "return")
}

// ---- expressions ---------------------------------------------------------------------------------------------------
fn Checker.checkBinary(var self, e: Int) -> Int {
    let Binary(op, left, right) = self.p.ast.exprs[e].node else {
        return tyError
    }
    var a = self.checkExpr(left, true)
    self.c.keepIs = op == Op.And
    if op == Op.Coalesce and self.p.fallibleValue(a) >= 0 {
        self.hintLiteral(right, self.p.fallibleValue(a)) // m[k] ?? ([], .Red)
    }
    var b = self.checkExpr(right, true)
    self.c.hint = -1
    if self.isErr(a) or self.isErr(b) {
        return tyError
    }
    if op is Eq | Ne and (a == tyDot) != (b == tyDot) {
        // shape == .Empty: the other's enum
        if a == tyDot {
            self.coerce(left, b, "==")
        } else {
            self.coerce(right, a, "==")
        }
        a = self.ty(left)
        b = self.ty(right)
        if self.isErr(a) or self.isErr(b) {
            return tyError
        }
    }
    let ak = self.kindOf(a)
    let bk = self.kindOf(b)
    if op == Op.Coalesce {
        // a ?? b: what is in a, or b
        let inner = self.p.fallibleValue(a)
        if inner < 0 {
            self.typeError(left, "?? takes an optional (T?) or a result (T!) on its left, not %s", a, -1)
            return tyError
        }
        if self.p.isOption(a) and (b == tyNone or self.p.isOption(b))
            or self.p.isResult(a) and (b == tyErr or self.p.isResult(b)) {
            self.coerce(right, a, "??") // a ?? b ?? c: still optional
            return a
        }
        self.coerce(right, inner, "??")
        return inner
    }
    if ak == Kind.Pointer and op is Plus | Minus {
        // p + n: n Ts further, as C's p + n
        if bk != Kind.Int {
            self.typeError(right, "a pointer moves by an Int of its Ts (p + n), not by %s", b, -1)
            return tyError
        }
        self.needEffect(e, "pointer arithmetic")
        return a
    }
    if ak == Kind.Text and bk == Kind.Text {
        // joined, compared byte by byte
        if op == Op.Plus {
            return tyText
        }
        if op.compares() {
            return tyBool
        }
        self.typeError(e, "texts are joined with + and compared, not %s and %s", a, b)
        return tyError
    }
    if ak == Kind.Bytes or bk == Kind.Bytes {
        // the same: b + [0], b == c, b < c
        let where = if op == Op.Plus { "+" } else { "the other side" }
        if ak == Kind.Bytes and bk != Kind.Bytes and bk != Kind.Error {
            self.coerce(right, a, where)
        } else if bk == Kind.Bytes and ak != Kind.Bytes and ak != Kind.Error {
            self.coerce(left, b, where)
        }
        if self.kindOf(self.ty(left)) != Kind.Bytes or self.kindOf(self.ty(right)) != Kind.Bytes {
            return tyError
        }
        if op == Op.Plus {
            return tyBytes
        }
        if op.compares() {
            return tyBool
        }
        self.typeError(e, "bytes are joined with + and compared, not %s and %s", a, b)
        return tyError
    }
    if op == Op.Plus and (ak == Kind.Array or bk == Kind.Array) {
        // xs + ys: a new array, one after the other
        if a == tyEmpty and bk == Kind.Array {
            self.coerce(left, b, "+")
        } else if b == tyEmpty and ak == Kind.Array {
            self.coerce(right, a, "+")
        } else if ak == Kind.Array and bk is Range | Iter {
            self.markIterUse(right)
            self.coerce(right, a, "+")
        } else if bk == Kind.Array and ak is Range | Iter {
            self.markIterUse(left)
            self.coerce(left, b, "+")
        } else if ak == Kind.Array and bk == Kind.Array and a != b and self.elemOf(a) >= 0 and self.elemOf(b) >= 0 {
            self.typeError(e, "+ joins two arrays of one type, not %s and %s", a, b)
            return tyError
        }
        let la = self.ty(left)
        let rb = self.ty(right)
        if la == tyEmpty {
            self.sayAt(e, "[] + []: write the type, let xs: [Int] = []")
            return tyError
        }
        if self.kindOf(la) == Kind.Array and la == rb {
            return la
        }
        self.typeError(e, "+ joins two arrays of one type, not %s and %s", la, rb)
        return tyError
    }
    if (ak == Kind.Text) != (bk == Kind.Text) and op == Op.Plus {
        self.typeError(e, "+ joins two texts: make the other one text with \"\{x\}\" or toText(x) (%s and %s)", a, b)
        return tyError
    }
    if op == Op.Star and ak is Text | Array {
        // "-" * 40, [0] * 256: repeated
        if bk != Kind.Int {
            self.typeError(e, "* repeats a text or an array an Int of times, not %s", b, -1)
            return tyError
        }
        if a == tyEmpty {
            self.sayAt(e, "[] * n: write the type, let xs: [Int] = []")
            return tyError
        }
        self.p.ast.exprs[e].builtin = if ak == Kind.Text { bRepeat } else { bFill }
        return a
    }
    if op == Op.Star and ak == Kind.Int and bk is Text | Array {
        self.typeError(e, "the %s goes first: what is repeated, then how many times (\"-\" * 40)", b, -1)
        return tyError
    }
    if self.p.isSet(a) and op is Pipe | Amp | Minus {
        // union, intersection, difference
        if a != b {
            self.typeError(e, "| & - join sets of one type, not %s and %s", a, b)
            return tyError
        }
        return a
    }
    if op is PlusWrap | MinusWrap | StarWrap {
        // an Int's arithmetic that wraps around (a hash's, a random generator's)
        if ak != Kind.Int and ak != Kind.Error or bk != Kind.Int and bk != Kind.Error {
            self.typeError(e, "+% -% *% wrap around on Ints, not %s and %s", a, b)
            return tyError
        }
        return tyInt
    }
    if op is Amp | Pipe | Caret | Shl | Shr {
        // an Int's bits
        if ak != Kind.Int and ak != Kind.Error or bk != Kind.Int and bk != Kind.Error {
            self.typeError(e, "& | ^ << >> work on the bits of Ints, not %s and %s", a, b)
            return tyError
        }
        return tyInt
    }
    let arithmetic = op is Plus | Minus | Star | Slash | Percent
    if arithmetic and self.hasOperators(a) {
        return self.checkOperator(e, false)
    }
    if op == Op.Star and self.p.isNumeric(a) and self.hasOperators(b) {
        return self.checkOperator(e, true) // 2 * v is v * 2
    }
    if arithmetic and self.hasOperators(b) {
        self.typeError(e, "put the %s first: the left value's type gives the operator", b, -1)
        return tyError
    }
    if op is And | Or {
        if ak != Kind.Bool or bk != Kind.Bool {
            self.typeError(e, "and / or join Bools, not %s and %s", a, b)
            return tyError
        }
        return tyBool
    }
    if arithmetic {
        if self.p.isNumeric(a) and self.p.isNumeric(b) {
            if op == Op.Percent and (ak != Kind.Int or bk != Kind.Int) {
                self.typeError(e, "%% works on Ints, not %s and %s", a, b)
                return tyError
            }
            return self.unifyNumeric(left, right)
        }
        self.typeError(e, "arithmetic needs numbers, not %s and %s", a, b)
        return tyError
    }
    if op is Eq | Ne {
        if self.p.isNumeric(a) and self.p.isNumeric(b) {
            self.compareNumeric(left, right)
            return tyBool
        }
        if self.isPlaceholder(b) and not self.isPlaceholder(a) and self.coerce(right, a, "==") {
            b = a // t == Tree.Leaf
        }
        if self.isPlaceholder(a) and not self.isPlaceholder(b) and self.coerce(left, b, "==") {
            a = b
        }
        if a != b and self.p.fallibleValue(a) >= 0 and self.p.fallibleValue(b) < 0 and self.coerce(right, a, "==") {
            b = a // x == None, x == 3
        } else if a != b and self.p.fallibleValue(b) >= 0 and self.p.fallibleValue(a) < 0 and self.coerce(left, b, "==") {
            a = b
        }
        if a == b and self.equatable(a) {
            return tyBool // records field by field, cases with their data
        }
        if a == b and self.p.hasData(a) {
            self.typeError(e, "%s carries data: compare it with match", a, -1)
            return tyError
        }
        if a == b and self.kindOf(a) == Kind.Record {
            self.typeError(e, "%s holds something == cannot compare (a function)", a, -1)
            return tyError
        }
        self.typeError(e, "== compares numbers, texts, Bools, enum cases or records of one type, not %s and %s", a, b)
        return tyError
    }
    // < <= > >=
    if self.p.isNumeric(a) and self.p.isNumeric(b) {
        self.compareNumeric(left, right)
        return tyBool
    }
    if a == b and ak == Kind.Bool {
        return tyBool
    }
    if a == b and ak is Record | Enum | Handle {
        let d = self.typeFunction(a, "compare") // fn T.compare(a: T, b: T) -> Int: below 0, 0, above 0
        if d >= 0 and len(self.p.ast.decls[d].params) == 2 and self.p.ast.decls[d].isTemplate {
            // a generic type's compare: its instance, as a call would make
            let line = self.p.ast.exprs[e].line
            let col = self.p.ast.exprs[e].col
            let call = self.newExpr(.Call(self.declName(d), "", [left, right], ["", ""], false, false), line, col)
            self.p.ast.exprs[left].typed = true
            self.p.ast.exprs[right].typed = true
            let r = self.checkTemplateCall(call, d, -1)
            if self.isErr(r) {
                return r
            }
            self.p.ast.exprs[e].decl = self.p.ast.exprs[call].decl
            self.p.ast.exprs[e].ordered = self.p.ast.exprs[call].ordered
            return tyBool
        }
        if d >= 0 and len(self.p.ast.decls[d].params) == 2 {
            let r = self.fnReturnType(d, e)
            if self.kindOf(r) != Kind.Int and not self.isErr(r) {
                self.typeError(e, "%s.compare must give an Int (below 0, 0 or above 0), not %s", a, r)
                return tyError
            }
            self.usesEffectsOf(e, d, 0)
            self.coerce(right, self.paramType(self.p.ast.decls[d].params[1]), self.declName(d))
            self.p.ast.exprs[e].decl = d
            self.p.ast.exprs[e].ordered = [left, right]
            return tyBool
        }
        if ak == Kind.Enum and not self.p.hasData(a) and self.p.fallibleValue(a) < 0 {
            return tyBool // in the order of its cases
        }
        self.typeError(e, "%s has no order: write fn %s.compare(a, b) -> Int", a, a)
        return tyError
    }
    self.typeError(e, "< and > compare numbers, texts and cases, not %s and %s", a, b)
    tyError
}

// .Leaf, .Circle(...): its enum is the type it goes into, given where it meets it (coerce); its values wait till then
fn Checker.dottedCase(var self, e: Int) -> Int {
    self.c.dotted.push(e)
    tyDot
}

// The enums with a case of this name, for a message: "Color.Red" or "Color.Red or Light.Red"
fn Checker.dottedAdvice(self, name: Text) -> Text {
    var out = ""
    var found = 0
    for d in self.p.decls {
        if found >= 3 {
            break
        }
        let x = self.p.ast.decls[d]
        if x.kind != DeclKind.Enum or x.templateOf >= 0 or not self.seenFrom(self.c.module, d) {
            continue
        }
        for c in x.cases {
            if c == name {
                if found > 0 {
                    out += " or "
                }
                out += "{x.name}.{name}"
                found += 1
            }
        }
    }
    if found == 0 {
        out = "Type.{name}"
    }
    out
}

fn Checker.dottedError(var self, e: Int) {
    let name = self.nameOf(e)
    self.sayAt(e, ".{name} needs an enum to go into here: write {self.dottedAdvice(name)}")
    self.setTy(e, tyError)
}

// .Case values that never met their enum: each one said, where it is
fn Checker.reportDotted(var self) {
    let f = self.c.fnDecl
    let typing = self.c.typing
    let loose = f >= 0 and self.p.ast.decls[f].isTemplate or typing >= 0 and self.p.ast.decls[typing].isTemplate // a template's: said in its instances
    for e in self.c.dotted {
        if self.ty(e) == tyDot {
            if loose { self.setTy(e, tyError) } else { self.dottedError(e) }
        }
    }
    self.c.dotted = []
}

// value is Pattern: a Bool; the pattern's names are declared (checkExpr keeps them where they are in reach)
fn Checker.checkIs(var self, e: Int) -> Int {
    let Is(value, a) = self.p.ast.exprs[e].node else {
        return tyError
    }
    var t = self.checkExpr(value, true)
    if t == tyNone or t == tyErr or t == tyDot or self.kindOf(t) == Kind.Void {
        self.typeError(value, "is tests a value of a type of its own, not %s", t, -1)
        t = tyError
    }
    let mark = len(self.c.scope)
    if not self.bindPattern(a, t, value) {
        // unknown (a template's T, or said): its names, of no type, so no more errors
        self.truncate(mark)
        let line = self.p.ast.exprs[value].line
        let col = self.p.ast.exprs[value].col
        self.declareNames(a, tyError, line, col)
        return tyBool
    }
    for i in mark..len(self.c.scope) {
        self.c.isNames.push(self.p.bindings[self.c.scope[i]].name)
    }
    let alternatives = self.p.ast.arms[a].alternatives
    var binds = len(alternatives) > 0 and self.namesAny(a)
    for alt in alternatives {
        self.bindPattern(alt, t, value)
        binds = binds or self.namesAny(alt)
    }
    if binds {
        self.sayAt(e, "alternatives (|) cannot bind values or destructure fields")
    }
    tyBool
}

fn Checker.checkExprInner(var self, e: Int, wantValue: Bool) -> Int {
    let line = self.p.ast.exprs[e].line
    let col = self.p.ast.exprs[e].col
    match self.p.ast.exprs[e].node {
        IntLit(_, _) => tyInt
        FloatLit(_, _) => tyFloat
        TextLit(_, _, _) => tyText
        BoolLit(_) => tyBool
        Hole => tyNever
        // not written yet: it goes wherever a value goes, as panic(...) does
        Case(name, target, dotted) => {
            let d = self.p.ast.exprs[e].decl
            if d >= 0 {
                let t = self.ty(e)
                return if t >= 0 { t } else { self.p.ast.decls[d].ty }
            }
            if dotted {
                return self.dottedCase(e)
            }
            self.p.ast.exprs[e].node = .Field(target, name) // a copy of Color.Red, as written
            self.checkExprInner(e, wantValue)
        }
        Is(_, _) => self.checkIs(e)
        Name(name) => self.checkName(e, name)
        With(target, values, fields) => {
            // a copy with some fields changed
            let t = self.checkExpr(target, true)
            if self.kindOf(t) != Kind.Record or self.isInterface(t) {
                // an interface's functions are its value's type's: never changed
                if not self.isErr(t) {
                    self.typeError(target, "with changes fields of a record, not %s", t, -1)
                }
                return tyError
            }
            if not self.accessLayout(self.declOf(t), e) {
                return tyError
            }
            for (i, v) in values.enumerate() {
                self.checkExpr(v, true)
                let f = fields[i]
                var ft = -1
                for prm in self.p.ast.decls[self.declOf(t)].params {
                    if self.paramName(prm) == f {
                        ft = self.paramType(prm)
                    }
                }
                if ft < 0 {
                    self.sayAt(v, "{self.tname(t)} has no field \"{f}\"")
                    return tyError
                }
                for j in 0..i {
                    if fields[j] == f {
                        self.sayAt(v, "\"{f}\" is given twice")
                    }
                }
                if self.isLoop(self.ty(v)) {
                    self.markIterUse(v)
                }
                self.coerce(v, ft, f)
            }
            t
        }
        Interp(values, _, _, formats, _) => {
            // "lap {n}": each value as text
            for (i, v) in values.enumerate() {
                let t = self.asText(v, "")
                let f = formats.get(i) ?? ""
                if f.contains(".") {
                    // {x:.2}: decimals, for a number
                    let dot = f.indexOf(".") ?? 0
                    let after = f[dot + 1..]
                    let fine = len(after) > 0 and not after.contains(".")
                    if not fine {
                        self.sayAt(v, "a format is a width, decimals or both: \{x:8\}, \{x:.2\}, \{x:8.2\}")
                    } else if not self.p.isNumeric(t) and not self.isErr(t) {
                        self.typeError(v, "decimals (\{x:.2\}) are for numbers, not %s", t, -1)
                    }
                }
            }
            tyText
        }
        Try(value) => self.checkTry(e, value)
        MapLit(items) => self.checkMapLit(e, items)
        Field(target, name) => self.checkField(e, target, name)
        Index(target, index) => self.checkIndex(e, target, index)
        Unary(op, operand) => {
            let t = self.checkExpr(operand, true)
            if op == Op.Not {
                if self.kindOf(t) != Kind.Bool and not self.isErr(t) {
                    self.typeError(operand, "not takes a Bool, not %s", t, -1)
                }
                return tyBool
            }
            if op == Op.Tilde {
                if self.kindOf(t) != Kind.Int and not self.isErr(t) {
                    self.typeError(operand, "~ takes an Int (its bits), not %s", t, -1)
                }
                return tyInt
            }
            if self.hasOperators(t) {
                return self.checkOperator(e, false)
            }
            if not self.p.isNumeric(t) and not self.isErr(t) {
                self.typeError(operand, "- takes a number, not %s", t, -1)
            }
            t
        }
        Binary(_, _, _) => self.checkBinary(e)
        Range(low, high) => {
            if low < 0 or high < 0 {
                self.say(line, col, "a range needs both ends here (a..b); xs[a..] and xs[..b] are slices")
                return tyError
            }
            self.checkExpr(low, true)
            self.checkExpr(high, true)
            self.coerce(low, tyInt, "a range's start")
            self.coerce(high, tyInt, "a range's end")
            tyRange
        }
        If(_, _, _) => self.checkIf(e, wantValue)
        Match(_, _, _) => self.checkMatch(e, wantValue)
        BlockExpr(b, jump) => {
            if jump {
                // x ?? return 0: it leaves, so it fits wherever a value goes
                self.checkBlock(b, false)
                return tyNever
            }
            self.checkBlock(b, wantValue)
        }
        ArrayLit(items) => self.checkArrayLit(items)
        Lambda(_, _) => tyLambda
        // it takes the function type it goes into
        Call(_, _, _, _, _, _) => self.checkCall(e)
    }
}

fn Checker.checkName(var self, e: Int, name: Text) -> Int {
    let b = self.lookupOrCapture(-1, name)
    if b >= 0 {
        let x = self.p.bindings[b]
        let ofTemplate = x.paramOf >= 0 and self.p.ast.decls[x.paramOf].isTemplate
        if x.fnParam and ofTemplate {
            self.keepsFunction(b) // kept: a value from now on
        } else if x.fnParam or x.lambda >= 0 {
            self.sayAt(
                e,
                "a function is not a value to keep here: {name} was given to this function, so call it or pass it on",
            )
            return tyError
        }
        self.p.ast.exprs[e].binding = b
        self.p.bindings[b].uses += 1
        if x.mutable {
            self.c.varReads += 1
        }
        if x.depth != self.c.loopDepth {
            self.p.bindings[b].iterUses += 1000 // used deeper in loops: never fused
        }
        return x.ty
    }
    let d = self.findDecl(name)
    if d >= 0 and self.p.ast.decls[d].kind == DeclKind.Const {
        // a constant: its value, wherever it is used
        self.p.ast.exprs[e].decl = d
        return self.constType(d, e)
    }
    if d < 0 and name == "None" {
        return tyNone // takes the T? it goes into
    }
    if d >= 0 and self.p.ast.decls[d].kind == DeclKind.Fn {
        self.p.ast.exprs[e].decl = d
        return self.fnValueType(d, e)
    }
    if d >= 0 {
        self.sayAt(e, "{name} is a type, not a value")
    } else if name == "Some" {
        self.sayAt(e, "Some holds a value: Some(x)")
    } else {
        self.unknownName(e)
    }
    tyError
}

// How ? passes an Err of `from` on where the function's Err holds `to`: the case of to's enum that holds a `from`
// and nothing else (it is the only one: enum AppError { Parse(e: ParseError), Io(why: Text) }), -2 when to is a Text
// (the error said as text, as print says it), -1 none, -3 more than one case could.
fn Checker.errorConversion(self, from: Int, to: Int) -> Int {
    if to == tyText {
        return -2
    }
    if self.kindOf(to) != Kind.Enum or self.p.types[to].decl < 0 {
        return -1
    }
    var found = -1
    for (k, fields) in self.p.ast.decls[self.p.types[to].decl].caseFields.enumerate() {
        if len(fields) == 1 and self.same(self.paramType(fields[0]), from) {
            if found >= 0 {
                return -3 // two cases could hold it: which one is the program's to say (mapErr)
            }
            found = k
        }
    }
    found
}

fn Checker.checkTry(var self, e: Int, value: Int) -> Int {
    if self.c.deferDepth > 0 {
        self.sayAt(e, "a defer's block cannot leave its function: no ? in it")
        return tyError
    }
    let f = self.c.fnDecl
    if self.p.ast.exprs[value].node is Call("mapErr", _, _, _, _, _) and f >= 0 {
        let r = self.p.ast.decls[f].retType
        if r >= 0 and self.p.isResult(r) {
            self.c.errorWant = self.p.errorOf(r) // parse(t).mapErr(e => .Io(e))?: the function's error
        }
    }
    let t = self.checkExpr(value, true)
    self.c.errorWant = -1
    if self.isErr(t) {
        return t
    }
    let v = self.p.fallibleValue(t)
    if v < 0 {
        self.typeError(value, "? takes an optional (T?) or a result (T!), not %s", t, -1)
        return tyError
    }
    if self.c.lambdaDepth > 0 {
        self.sayAt(e, "? cannot leave a lambda (a lambda is one expression): use ?? or match")
    } else if self.c.inConst or f < 0 {
        self.sayAt(e, "? cannot leave a constant: use ?? or match")
    } else {
        let x = self.p.ast.decls[f]
        if not x.isTest and (x.name != "main" or x.retType >= 0 and self.p.isResult(x.retType)) {
            let want = x.retType
            if want < 0 {
                self.sayAt(
                    e,
                    "{x.name} uses ?, so it may return early: write its result type, fn {x.name}(...) -> Type",
                )
            } else if not self.isErr(want) and self.p.isOption(t) and not self.p.isOption(want) {
                self.typeError(e, "? passes a None on, so the function must give an optional (T?), not %s", want, -1)
            } else if not self.isErr(want) and self.p.isResult(t) and not self.p.isResult(want) {
                self.typeError(e, "? passes an Err on, so the function must give a result (T!), not %s", want, -1)
            } else if not self.isErr(want) and self.p.isResult(t) and self.p.errorOf(t) != self.p.errorOf(want) {
                let conversion = self.errorConversion(self.p.errorOf(t), self.p.errorOf(want))
                if conversion == -3 {
                    self.typeError(
                        e,
                        "? passes an Err of %s on, and two cases of %s hold one: say which with mapErr",
                        self.p.errorOf(t),
                        self.p.errorOf(want),
                    )
                } else if conversion == -1 {
                    self.typeError(
                        e,
                        "? passes an Err of %s on, but the function's Err holds %s: give its enum a case that holds one (Parse(e: ParseError)), or convert it with mapErr",
                        self.p.errorOf(t),
                        self.p.errorOf(want),
                    )
                } else {
                    self.p.ast.exprs[e].caseIndex = conversion
                }
            }
        }
    }
    v
}

fn Checker.checkMapLit(var self, e: Int, items: [Int]) -> Int {
    let hint = self.c.hint
    self.c.hint = -1
    if len(items) == 0 {
        return tyEmptyMap // takes the map type it goes into
    }
    if hint >= 0
        and self.kindOf(hint) == Kind.Map
        and self.keyOf(hint) >= 0
        and self.elemOf(hint) >= 0
        and not self.p.isSet(hint) {
        // let m: [Tree: Int] = [.Leaf: 1]
        var i = 0
        while i + 1 < len(items) {
            self.checkExpr(items[i], true)
            self.coerce(items[i], self.keyOf(hint), "a key")
            let value = items[i + 1]
            self.hintLiteral(value, self.elemOf(hint)) // [Text: [Shape]], [Text: ([Int], Int)]: inside too
            let vt = self.checkExpr(value, true)
            self.c.hint = -1
            if self.isLoop(vt) {
                self.markIterUse(value)
            }
            self.coerce(value, self.elemOf(hint), "a value")
            i += 2
        }
        return hint
    }
    var k = -1
    var v = -1
    var anyFloat = false
    var i = 0
    while i + 1 < len(items) {
        let kt = self.checkExpr(items[i], true)
        let vt = self.checkExpr(items[i + 1], true)
        anyFloat = anyFloat or self.kindOf(vt) == Kind.Float
        if k < 0 {
            k = kt
        }
        if v < 0 {
            v = vt
        }
        i += 2
    }
    if anyFloat and self.p.isNumeric(v) {
        v = tyFloat
    }
    if self.isLoop(v) {
        v = self.p.arrayType(self.elemOf(v))
    }
    if self.isErr(k) or self.isErr(v) {
        return tyError
    }
    if not self.keyable(k) {
        self.typeError(
            items[0],
            "a map's key must support hashing and equality (a value == compares, with no array or map inside), not %s",
            k,
            -1,
        )
        return tyError
    }
    i = 0
    while i + 1 < len(items) {
        self.coerce(items[i], k, "a key")
        if self.isLoop(self.ty(items[i + 1])) {
            self.markIterUse(items[i + 1])
        }
        self.coerce(items[i + 1], v, "a value")
        i += 2
    }
    self.p.mapType(k, v)
}

fn Checker.checkField(var self, e: Int, target: Int, name: Text) -> Int {
    if self.p.ast.exprs[target].node is Name(tn) and typeLike(tn) {
        let d = self.findDecl(tn)
        if d >= 0 and self.p.ast.decls[d].kind == DeclKind.Enum {
            let x = self.p.ast.decls[d]
            for (k, c) in x.cases.enumerate() {
                if c == name {
                    if len(x.caseFields[k]) > 0 {
                        self.sayAt(e, "{x.name}.{name} carries data: {x.name}.{name}(...)")
                        return tyError
                    }
                    self.p.ast.exprs[e].node = .Case(name, target, false)
                    self.p.ast.exprs[e].decl = d
                    self.p.ast.exprs[e].caseIndex = k
                    return x.ty
                }
            }
            let close = closest(name, x.cases)
            if close != "" {
                self.sayAt(e, "{x.name} has no case {name}: did you mean {close}?")
            } else {
                self.sayAt(e, "{x.name} has no case {name}")
            }
            return tyError
        }
    }
    let t = self.checkExpr(target, true)
    let tk = self.kindOf(t)
    if tk == Kind.Record {
        let d = self.declOf(t)
        let open = self.p.ast.decls[d].params.any(prm => self.p.ast.params[prm].isPub and self.paramName(prm) == name)
        if not open and not self.accessLayout(d, e) {
            return tyError // (a pub field of an opaque type is read and changed anywhere)
        }
        let fields = self.p.ast.decls[d].params
        for (f, prm) in fields.enumerate() {
            if self.paramName(prm) == name {
                self.p.ast.exprs[e].caseIndex = f
                return self.paramType(prm)
            }
        }
        var names: [Text] = []
        for prm in fields {
            if len(names) < 64 {
                names.push(self.paramName(prm))
            }
        }
        let close = closest(name, names)
        if close != "" {
            self.sayAt(e, "{self.declName(d)} has no field \"{name}\": did you mean \"{close}\"?")
        } else {
            self.sayAt(e, "{self.declName(d)} has no field \"{name}\"")
        }
        return tyError
    }
    if self.p.isIterable(t) and name == "len" {
        self.sayAt(e, "the length is a function: len(xs) or xs.len()")
        return tyError
    }
    if tk == Kind.Pointer and name == "address" {
        // p.address: where it points, an Int
        self.needEffect(e, "a pointer's address")
        return tyInt
    }
    if tk == Kind.Pointer {
        self.typeError(
            e,
            "%s has one field, address; p[i] is what it points at (p[i].field, for an extern type)",
            t,
            -1,
        )
        return tyError
    }
    self.typeError(e, "%s has no fields", t, -1)
    tyError
}

fn Checker.checkIndex(var self, e: Int, target: Int, index: Int) -> Int {
    var t = self.checkExpr(target, true)
    if self.kindOf(t) == Kind.Pointer {
        // p[i]: the i-th T where p points (a T as wide as C's)
        self.checkExpr(index, true)
        self.coerce(index, tyInt, "an index")
        self.needEffect(e, "reading through a pointer")
        if self.kindOf(self.elemOf(t)) == Kind.Handle {
            self.typeError(
                target,
                "%s points at what C keeps to itself: give it to C, or make it a Pointer<UInt8>",
                t,
                -1,
            )
            return tyError
        }
        return self.p.plainType(self.elemOf(t))
    }
    if self.isLoop(t) {
        self.markIterUse(target)
        let arr = self.p.arrayType(self.elemOf(t))
        self.coerce(target, arr, "indexing")
        t = self.ty(target)
    }
    let isSlice = self.p.ast.exprs[index].node is Range(_, _)
    if self.kindOf(t) == Kind.Bytes {
        // b[i]: an Int 0..255; b[a..b]: Bytes, the same memory
        if self.p.ast.exprs[index].node is Range(low, high) {
            for end in [low, high] {
                if end >= 0 {
                    self.checkExpr(end, true)
                    self.coerce(end, tyInt, "a slice's end")
                }
            }
            self.setTy(index, tyRange)
            return t
        }
        self.checkExpr(index, true)
        self.coerce(index, tyInt, "an index")
        return tyInt
    }
    if self.p.ast.exprs[index].node is Range(low, high) {
        // xs[a..b], t[a..]: a slice (b not included)
        for end in [low, high] {
            if end >= 0 {
                self.checkExpr(end, true)
                self.coerce(end, tyInt, "a slice's end")
            }
        }
        self.setTy(index, tyRange)
        if self.kindOf(t) is Array | Text {
            return t
        }
        if not self.isErr(t) {
            self.typeError(target, "only arrays and texts are sliced, not %s", t, -1)
        }
        return tyError
    }
    let _ = isSlice
    let i = self.checkExpr(index, true)
    if self.p.isSet(t) {
        self.sayAt(e, "a set has no values to look up: contains(s, value) says if it holds one")
        return tyError
    }
    if self.kindOf(t) == Kind.Map and self.keyOf(t) >= 0 {
        // m[key]: the value, or None; in a place, the value (m[k].push(x))
        self.coerce(index, self.keyOf(t), "the key")
        return if self.p.ast.exprs[e].place {
            self.elemOf(t)
        } else {
            self.p.optionType(self.elemOf(t))
        }
    }
    if self.kindOf(t) == Kind.Text {
        self.sayAt(e, "a text is sliced, not indexed: t[i..i + 1] is the piece at i")
        return tyError
    }
    if self.kindOf(i) != Kind.Int and not self.isErr(i) {
        self.typeError(index, "an index is an Int, not %s", i, -1)
    }
    if self.kindOf(t) != Kind.Array {
        if not self.isErr(t) {
            self.typeError(target, "only arrays are indexed, not %s", t, -1)
        }
        return tyError
    }
    self.elemOf(t)
}

fn Checker.checkArrayLit(var self, items: [Int]) -> Int {
    let hint = self.c.hint
    self.c.hint = -1
    if len(items) == 0 {
        return tyEmpty // takes the array type it goes into
    }
    if hint >= 0 and self.kindOf(hint) == Kind.Array and self.elemOf(hint) >= 0 {
        // let pets: [Speaker] = [Dog(...), Cat(...)]
        self.hintedFrom(items, 0, self.elemOf(hint))
        return hint
    }
    let (first, anyFloat) = self.elementsFrom(items, 0, -1, false)
    var t = first
    if anyFloat and self.p.isNumeric(t) {
        t = tyFloat
    }
    if self.isLoop(t) {
        t = self.p.arrayType(self.elemOf(t))
    }
    for item in items {
        if self.isLoop(self.ty(item)) {
            self.markIterUse(item)
        }
        self.coerce(item, t, "an array's element")
    }
    self.p.arrayType(t)
}

fn Checker.checkExpr(var self, e: Int, wantValue: Bool) -> Int {
    let t0 = self.p.ast.exprs[e].ty
    if t0 >= 0 and (self.p.ast.exprs[e].implicit or self.p.ast.exprs[e].typed) {
        return t0
    }
    let keep = self.c.keepIs
    self.c.keepIs = self.p.ast.exprs[e].node is Binary(And, _, _) // a is Some(x) and x > 0: and's sides keep theirs (for now)
    let mark = len(self.c.scope)
    let t = self.checkExprInner(e, wantValue)
    self.setTy(e, t)
    self.c.keepIs = false
    if not keep {
        self.truncate(mark) // an is's names: in reach only where it held
    }
    t
}

// ---- functions -----------------------------------------------------------------------------------------------------
fn Checker.fnReturnType(var self, d: Int, at: Int) -> Int {
    let r = self.p.ast.decls[d].retType
    if r >= 0 {
        return r
    }
    if self.p.ast.decls[d].state == 1 {
        let template = self.p.ast.decls[d].templateOf
        let name = if template >= 0 { self.declName(template) } else { self.declName(d) }
        let body = self.p.ast.decls[d].body
        if self.p.ast.exprs[body].node is BlockExpr(_, _) and self.p.ast.decls[d].ret < 0 {
            // fn walk(t: Tree) { ... walk(l) ... }: a block with no type written gives nothing
            self.p.ast.decls[d].retType = tyVoid
            self.p.ast.decls[d].callsItself = true
            return tyVoid
        }
        self.sayAt(at, "{name} calls itself: write its result type, fn {name}(...) -> Type")
        return tyError
    }
    self.checkNow(d) // infer it now, in a context of its own
    let t = self.p.ast.decls[d].retType
    if t >= 0 { t } else { tyError }
}

// A deferred source must be safe to evaluate again. Calls that construct the input, range endpoints with computation,
// and dynamic take/skip counts stay at the declaration, where they can observe effects or fail.
fn Checker.replayableSource(self, e: Int) -> Bool {
    let x = self.p.ast.exprs[e]
    match x.node {
        IntLit(_, _) | FloatLit(_, _) | BoolLit(_) | TextLit(_, _, _) => true
        Name(_) => x.binding >= 0 and not self.p.bindings[x.binding].mutable
            or x.decl >= 0 and self.p.ast.decls[x.decl].kind == DeclKind.Const
        Range(low, high) => low >= 0 and high >= 0 and self.replayableSource(low) and self.replayableSource(high)
        ArrayLit(_) | MapLit(_) => {
            for item in self.argsOf(e) {
                if not self.replayableSource(item) {
                    return false
                }
            }
            true
        }
        Call(_, _, args, _, _, _) => {
            let b = x.builtin
            if b == bEntries or b == bMap or b == bFilter or b == bEnumerate {
                return self.replayableSource(args[0])
            }
            if b == bTake or b == bSkip {
                return self.replayableSource(args[0]) and self.replayableSource(args[1])
            }
            false
        }
        _ => false
    }
}

fn Checker.decideFusion(var self) {
    for b in self.c.lets {
        // used again and again in a deeper loop: worked out once, where it is made, not at every turn
        let x = self.p.bindings[b]
        let lazy = not x.mutable and not x.readsVar and x.iterUses < 1000 and self.replayableSource(x.init)
        self.p.bindings[b].lazy = lazy
    }
}

fn Checker.checkFnBody(var self, d: Int) {
    if self.p.ast.decls[d].state == 2 {
        return
    }
    self.p.ast.decls[d].state = 1
    self.enterDecl(d)
    self.c.fnDecl = d
    self.c.typing = d
    self.c.view = false
    self.c.loopDepth = 0
    self.c.lambdaDepth = 0
    self.c.pureDepth = 0
    self.c.pureFn = ""
    let mark = len(self.c.scope)
    for prm in self.p.ast.decls[d].params {
        self.c.scope.push(self.p.ast.params[prm].binding)
    }
    let ret = self.p.ast.decls[d].ret
    if ret >= 0 and not self.p.ast.decls[d].isExtern {
        let written = self.resolveType(ret) // an extern fn's: resolved with C's types
        self.p.ast.decls[d].retType = written
    }
    let body = self.p.ast.decls[d].body
    if self.p.ast.exprs[body].node is BlockExpr(block, _) {
        let x = self.p.ast.decls[d]
        let implicitMain = x.ret < 0 and x.module == 0 and x.name == "main"
        let wantValue = not implicitMain and (x.retType < 0 or self.kindOf(x.retType) != Kind.Void)
        self.c.result = x.retType // fn g(x: Int) -> Int ! E { if ... { Err(E.A) } else { ... } }
        var t = self.checkBlock(block, wantValue)
        self.c.result = -1
        self.setTy(body, t)
        let result = self.blockValue(block)
        let y = self.p.ast.decls[d]
        let name = if y.templateOf >= 0 { self.declName(y.templateOf) } else { y.name }
        let tk = self.kindOf(t)
        if y.callsItself and y.ret < 0 and not tk is Void | Error | Never and result >= 0 {
            self.sayAt(result, "{name} calls itself and gives a value: write its result type, fn {name}(...) -> Type")
        } else if y.retType >= 0 and self.kindOf(y.retType) != Kind.Void {
            let stmts = self.p.ast.blocks[block].stmts
            let lastReturns = len(stmts) > 0 and self.p.ast.stmts[stmts[len(stmts) - 1]].node is Return(_)
            if result >= 0 {
                if self.isLoop(self.ty(result)) {
                    self.markIterUse(result)
                }
                self.coerce(result, y.retType, "the result")
            } else if not lastReturns and y.retType != self.p.tupleType([]) {
                // (a Unit is nothing: a body that ends with a statement gives it)
                self.say(y.line, y.col, "{y.name} must end with its result (or a return)")
            }
        } else if y.returnsEarly and tk != Kind.Void and tk != Kind.Error and result >= 0 {
            self.sayAt(
                result,
                "{y.name} returns nothing early, so it gives nothing: write its type to give a value, fn {y.name}(...) -> Type",
            )
        } else if y.retType < 0 {
            if self.isLoop(t) {
                self.markIterUse(result)
                let arr = self.p.arrayType(self.elemOf(t))
                self.coerce(result, arr, "the result")
                t = arr
            }
            self.p.ast.decls[d].retType = t
        }
    } else {
        if self.p.ast.exprs[body].node is If(_, _, _) | Match(_, _, _) {
            self.c.result = self.p.ast.decls[d].retType // fn f() -> Int!E = if ... { Err(E.A) }
        }
        self.hintLiteral(body, self.p.ast.decls[d].retType)
        var t = self.checkExpr(body, true)
        self.c.hint = -1
        self.c.result = -1
        let r = self.p.ast.decls[d].retType
        if self.isLoop(t) {
            self.markIterUse(body)
            let arr = self.p.arrayType(self.elemOf(t))
            self.coerce(body, if r >= 0 { r } else { arr }, "the result")
            t = arr
        } else if r >= 0 {
            self.coerce(body, r, "the result")
        }
        if r < 0 {
            self.p.ast.decls[d].retType = t
        }
    }
    self.decideFusion()
    self.reportDotted()
    self.truncate(mark)
    self.p.ast.decls[d].state = 2
}

// Does a value of type t hold one of `target` in its own slots (not behind an array, a map or a box)?
fn Checker.holdsByValue(self, t: Int, target: Int, seen: [Int]) -> Bool {
    if t == target {
        return true
    }
    let ty = self.p.types[t]
    if not ty.kind is Record | Enum or ty.decl < 0 or len(seen) >= 64 {
        return false
    }
    if seen.contains(ty.decl) {
        return false // a loop that does not go through target
    }
    let inner = seen + [ty.decl]
    let d = self.p.ast.decls[ty.decl]
    var fields = d.params
    if ty.kind == Kind.Enum {
        fields = []
        for group in d.caseFields {
            fields += group
        }
    }
    for f in fields {
        let prm = self.p.ast.params[f]
        if not prm.boxed and prm.binding >= 0 and self.holdsByValue(self.p.bindings[prm.binding].ty, target, inner) {
            return true
        }
    }
    false
}

// An extern type's field: what C lays out (its scalars, a Pointer, a CText, a C function, each optional where C's NULL
// is None, another extern type with fields)
fn Checker.cFieldType(var self, d: Int, prm: Int, t: Int) {
    if self.isErr(t) {
        return
    }
    let inner = self.p.fallibleValue(t)
    if inner >= 0 and self.declOf(t) >= 0 and self.p.ast.decls[self.declOf(t)].optionOf >= 0 {
        let k = self.kindOf(inner)
        if k is Pointer | CFn or k == Kind.Text and self.p.types[inner].c != 0 {
            return // NULL is None
        }
    }
    let ty = self.p.types[t]
    let ok = ty.kind is Int | Float | Bool | Pointer | CFn
        or ty.kind == Kind.Text and ty.c != 0
        or ty.kind == Kind.Record and self.p.ast.decls[ty.decl].cStruct and ty.decl != d
    if ok {
        return
    }
    let x = self.p.ast.params[prm]
    self.say(
        x.line,
        x.col,
        "a C struct's field is one of C's types (Int32, Float64, CText, a Pointer, extern (A) -> R, each optional, an extern type with fields), not {self.tname(t)}",
    )
}

fn Checker.boxIfRecursive(var self, prm: Int, owner: Int) {
    let b = self.p.ast.params[prm].binding
    if b >= 0 and self.holdsByValue(self.p.bindings[b].ty, owner, []) {
        self.p.ast.params[prm].boxed = true
    }
}

// ---- functions that take functions and call themselves ---------------------------------------------------------
// The functions a body names (called, or given as values), by name: a view of the text, before it is checked.
fn Checker.namesIn(self, e: Int, fns: [Int], named: [Bool]) -> [Bool] {
    if e < 0 {
        return named
    }
    var out = named
    let x = self.p.ast.exprs[e]
    var name = ""
    var method = false
    match x.node {
        Call(n, _, _, _, m, _) => {
            name = n
            method = m
        }
        Name(n) => {
            name = n
        }
        _ => {}
    }
    if name != "" {
        for (i, f) in fns.enumerate() {
            let fname = self.declName(f)
            let dot = fname.indexOf(".") ?? -1
            if fname == name or method and dot >= 0 and fname[dot + 1..] == name {
                out[i] = true
            }
        }
    }
    match x.node {
        Call(_, _, args, _, _, _) => {
            for a in args {
                out = self.namesIn(a, fns, out)
            }
        }
        Field(target, _) => {
            out = self.namesIn(target, fns, out)
        }
        Index(target, index) => {
            out = self.namesIn(target, fns, out)
            out = self.namesIn(index, fns, out)
        }
        Unary(_, operand) => {
            out = self.namesIn(operand, fns, out)
        }
        Binary(_, left, right) => {
            out = self.namesIn(left, fns, out)
            out = self.namesIn(right, fns, out)
        }
        Range(low, high) => {
            out = self.namesIn(low, fns, out)
            out = self.namesIn(high, fns, out)
        }
        If(cond, then, otherwise) => {
            out = self.namesIn(cond, fns, out)
            out = self.namesIn(otherwise, fns, out)
            out = self.namesInBlock(then, fns, out)
        }
        Match(subject, arms, _) => {
            out = self.namesIn(subject, fns, out)
            for a in arms {
                out = self.namesIn(self.p.ast.arms[a].guard, fns, out)
                out = self.namesIn(self.p.ast.arms[a].body, fns, out)
            }
        }
        Lambda(_, body) => {
            out = self.namesIn(body, fns, out)
        }
        ArrayLit(_) | MapLit(_) => {
            for item in self.argsOf(e) {
                out = self.namesIn(item, fns, out)
            }
        }
        BlockExpr(block, _) => {
            out = self.namesInBlock(block, fns, out)
        }
        Case(_, target, _) => {
            out = self.namesIn(target, fns, out)
        }
        With(target, values, _) => {
            out = self.namesIn(target, fns, out)
            for v in values {
                out = self.namesIn(v, fns, out)
            }
        }
        Interp(values, _, _, _, _) => {
            for v in values {
                out = self.namesIn(v, fns, out)
            }
        }
        Try(value) => {
            out = self.namesIn(value, fns, out)
        }
        Is(value, pattern) => {
            out = self.namesIn(value, fns, out)
            out = self.namesIn(self.p.ast.arms[pattern].body, fns, out)
        }
        _ => {}
    }
    out
}

fn Checker.namesInBlock(self, b: Int, fns: [Int], named: [Bool]) -> [Bool] {
    if b < 0 {
        return named
    }
    var out = named
    for s in self.p.ast.blocks[b].stmts {
        match self.p.ast.stmts[s].node {
            Let(_, _, _, value, _, otherwise) => {
                out = self.namesIn(value, fns, out)
                out = self.namesInBlock(otherwise, fns, out)
            }
            Assign(target, _, value) => {
                out = self.namesIn(value, fns, out)
                out = self.namesIn(target, fns, out)
            }
            ExprStmt(value) => {
                out = self.namesIn(value, fns, out)
            }
            For(_, _, iter, body) => {
                out = self.namesIn(iter, fns, out)
                out = self.namesInBlock(body, fns, out)
            }
            While(cond, body) => {
                out = self.namesIn(cond, fns, out)
                out = self.namesInBlock(body, fns, out)
            }
            Return(value) => {
                out = self.namesIn(value, fns, out)
            }
            Defer(body) => {
                out = self.namesInBlock(body, fns, out)
            }
            _ => {}
        }
    }
    out
}

// A function that takes a function and calls itself (or calls one that calls it back): a lambda put into each call
// would make a copy of the function inside each copy, without end. Its functions are given as function values instead
// (closures, one copy of the function for each list of types): mapTree(l, f) inside mapTree.
fn Checker.keepRecursiveFunctions(var self) {
    var fns: [Int] = []
    for d in self.p.decls {
        let x = self.p.ast.decls[d]
        if x.kind != DeclKind.Fn or not x.isTemplate {
            continue
        }
        var takesFn = false
        for prm in x.params {
            takesFn = takesFn or self.isFnTypeNode(self.p.ast.params[prm].ty)
        }
        if takesFn {
            fns.push(d)
        }
    }
    let n = len(fns)
    if n == 0 {
        return
    }
    var reach: [[Bool]] = [] // reach[i][j]: i names j, through others maybe
    for f in fns {
        reach.push(self.namesIn(self.p.ast.decls[f].body, fns, [false] * n))
    }
    for k in 0..n {
        for i in 0..n {
            if reach[i][k] {
                for j in 0..n {
                    if reach[k][j] {
                        reach[i][j] = true
                    }
                }
            }
        }
    }
    for (i, d) in fns.enumerate() {
        if not reach[i][i] {
            continue
        }
        let params = self.p.ast.decls[d].params
        if len(self.p.ast.decls[d].valueParams) == 0 {
            self.p.ast.decls[d].valueParams = [false] * len(params)
        }
        for (f, prm) in params.enumerate() {
            if self.isFnTypeNode(self.p.ast.params[prm].ty) {
                self.p.ast.decls[d].valueParams[f] = true
            }
        }
    }
}

// ---- the program ---------------------------------------------------------------------------------------------------
fn Checker.ownerName(self, d: Int) -> Text {
    let name = self.declName(d)
    let dot = name.indexOf(".") ?? -1
    if dot >= 0 { name[..dot] } else { "" }
}

fn Checker.run(var self, needMain: Bool) -> Bool {
    let before = self.errors.count
    // fn Vec2.length(self): self is a Vec2; fn Pair.swap(self) works on a Pair<A, B>, and takes its A and B
    for d in self.p.decls {
        let x = self.p.ast.decls[d]
        let isMethod = x.kind == DeclKind.Fn and not x.isTest and x.name.contains(".")
        if not isMethod or len(x.params) == 0 {
            continue
        }
        let first = self.p.ast.params[x.params[0]]
        let owner = self.ownerName(d)
        if first.ty >= 0 and not x.impliedSelf and first.name == "self" {
            self.say(first.line, first.col, "self takes no type: it is the {owner} the function works on")
            self.p.ast.params[x.params[0]].ty = -1 // said once: it is the type's, from here on
        }
        if self.p.ast.params[x.params[0]].ty >= 0 {
            continue
        }
        var ownerDecl = -1
        for o in self.byName[owner] ?? [] {
            let y = self.p.ast.decls[o]
            if ownerDecl < 0
                and y.kind is Type | Enum
                and y.templateOf < 0
                and y.name == owner
                and (y.module == x.module or y.isPub or y.fromPrelude) {
                ownerDecl = o
            }
        }
        var args: [Int] = []
        if ownerDecl >= 0 {
            for tp in self.p.ast.decls[ownerDecl].typeParams {
                args.push(self.p.ast.typeExpr(.Named(tp, []), first.line, first.col))
            }
            if len(args) > 0 and len(x.typeParams) == 0 {
                self.p.ast.decls[d].typeParams = self.p.ast.decls[ownerDecl].typeParams
                self.p.ast.decls[d].impliedTypes = true
            }
        }
        let selfType = self.p.ast.typeExpr(.Named(owner, args), first.line, first.col)
        self.p.ast.params[x.params[0]].ty = selfType
        self.p.ast.decls[d].impliedSelf = true
    }
    // names: one meaning each
    for (i, d) in self.p.decls.enumerate() {
        self.enterDecl(d)
        let x = self.p.ast.decls[d]
        if x.kind == DeclKind.Use {
            continue
        }
        if x.kind == DeclKind.Fn and not x.isExtern and x.templateOf < 0 {
            // generic, or takes a function: a template
            var takesFn = false
            for prm in x.params {
                takesFn = takesFn or self.isFnTypeNode(self.p.ast.params[prm].ty)
            }
            let typeParams = self.p.ast.decls[d].typeParams
            if (len(typeParams) > 0 or takesFn) and not x.isTemplate {
                self.p.ast.decls[d].isTemplate = true
                let pristine = self.p.ast.cloneDecl(d)
                let kept = self.p.ast.decl(pristine)
                self.p.ast.decls[d].pristine = kept
                var vars: [Int] = []
                for tp in typeParams {
                    vars.push(self.p.addType(Type(.Error, typeVar: tp))) // while it is checked: T is any type
                }
                self.p.ast.decls[d].typeArgs = vars
            }
        }
        if x.kind == DeclKind.Fn and x.isExtern {
            for prm in x.params {
                let te = self.p.ast.params[prm].ty
                if self.isFnTypeNode(te) and not self.isExternFnNode(te) {
                    let q = self.p.ast.params[prm]
                    self.say(q.line, q.col, "a host function takes values, not functions (C's take extern (A) -> R)")
                }
            }
            if len(x.typeParams) > 0 {
                self.say(x.line, x.col, "a host function has no type parameters")
            }
        }
        if x.kind == DeclKind.Fn and not x.isTest and x.name.contains(".") {
            let owner = self.ownerName(d)
            self.p.ast.decls[d].owner = owner // fn Vec2.plus belongs to Vec2
            self.methods.add(x.name[len(owner) + 1..])
        }
        for o in self.byName[x.name] ?? [] {
            // one meaning for each name a file sees (the ones declared before it)
            if self.p.ast.decls[o].index >= i {
                break
            }
            let y = self.p.ast.decls[o]
            if y.kind == DeclKind.Use {
                continue
            }
            if x.builtin != y.builtin {
                continue // a program's own name hides the language's
            }
            let clash = y.module == x.module
                or y.fromPrelude
                or x.fromPrelude
                or y.isPub and self.usesModuleAs(x.module, y.module, false)
                or x.isPub and self.usesModuleAs(y.module, x.module, false)
            if clash and y.module == x.module {
                self.say(x.line, x.col, "\"{x.name}\" is declared twice")
            } else if clash {
                let m = if y.module != 0 { y.module } else { x.module }
                self.say(
                    x.line,
                    x.col,
                    "\"{x.name}\" is declared here and in {self.p.modules[m].path}: give one of them another name",
                )
            }
        }
        let b = self.builtinNamed(x.name)
        if b > 0 and b < bParallelMap {
            // the newer ones a program's own may hide
            self.say(x.line, x.col, "\"{x.name}\" is a built-in name")
        }
        if x.kind is Type | Enum {
            let kind = if x.kind == DeclKind.Enum {
                Kind.Enum
            } else if x.isExtern and not x.cStruct {
                Kind.Handle
            } else {
                Kind.Record
            }
            let t = self.p.addType(Type(kind, decl: d))
            self.p.ast.decls[d].ty = t
            if len(x.typeParams) > 0 and x.templateOf < 0 {
                // generic: an instance for each list of types it is given
                self.p.ast.decls[d].isTemplate = true
                let pristine = self.p.ast.cloneDecl(d)
                let kept = self.p.ast.decl(pristine)
                self.p.ast.decls[d].pristine = kept
            }
            if x.name is "Some" | "None" {
                self.say(x.line, x.col, "{x.name} is the built-in optional's case: pick another name")
            }
            if x.name is "Unit" | "Result" | "Task" | "Self" {
                self.say(x.line, x.col, "{x.name} is a built-in type")
            }
        }
    }
    // var self functions, by their names after the dot (a call may change its receiver)
    for d in self.p.decls {
        let x = self.p.ast.decls[d]
        if x.kind == DeclKind.Fn and x.name.contains(".") and self.changesSelf(d) {
            self.changers.add(x.name[(x.name.indexOf(".") ?? 0) + 1..])
        }
    }
    self.keepRecursiveFunctions()
    // record fields, enum cases' data and function parameters
    for d in self.p.decls {
        self.enterDecl(d)
        let x = self.p.ast.decls[d]
        if x.kind == DeclKind.Use or x.templateOf >= 0 or x.isTemplate and x.kind != DeclKind.Fn {
            continue // instances: resolved when made
        }
        if x.kind == DeclKind.Enum {
            for (k, c) in x.cases.enumerate() {
                for j in 0..k {
                    if x.cases[j] == c {
                        self.say(x.line, x.col, "{x.name}.{c} is listed twice")
                    }
                }
                for prm in x.caseFields[k] {
                    let q = self.p.ast.params[prm]
                    let t = self.resolveType(q.ty)
                    self.p.bindings.push(Binding(q.name, t))
                    self.p.ast.params[prm].binding = len(self.p.bindings) - 1
                }
            }
            continue
        }
        if x.kind == DeclKind.Const {
            continue
        }
        if x.kind == DeclKind.Type and not x.opaque {
            for prm in x.params {
                let q = self.p.ast.params[prm]
                if q.isPub {
                    self.say(q.line, q.col, "{x.name}'s fields are all public: pub goes on a field of an opaque type")
                }
            }
        }
        self.c.typing = d // fn first<T>(xs: [T]): T is its own
        self.c.view = false
        self.c.cTypes = x.isExtern // where Quark meets C: C's types
        var cTypes: [Int] = []
        for (f, prm) in x.params.enumerate() {
            let q = self.p.ast.params[prm]
            for j in 0..f {
                if self.paramName(x.params[j]) == q.name {
                    self.say(q.line, q.col, "\"{q.name}\" is listed twice")
                }
            }
            var t = self.resolveType(q.ty)
            if x.isExtern {
                // C's type as written, Quark's in the binding
                cTypes.push(t)
                let written = t
                t = self.p.plainType(t)
                let inner = self.p.fallibleValue(written)
                if inner >= 0 and self.p.types[inner].c != 0 and self.p.types[inner].c != ctText {
                    self.say(
                        q.line,
                        q.col,
                        "C's NULL is a Pointer<T>? or a CText? that is None: a number is never None in C",
                    )
                }
                if x.cStruct {
                    self.cFieldType(d, prm, written)
                } else if x.body >= 0 and self.kindOf(written) == Kind.CFn {
                    self.say(
                        q.line,
                        q.col,
                        "a C function value is called by C: a function with a body takes Pointer<T> instead",
                    )
                } else if x.body >= 0 and self.cArray(written) {
                    self.say(
                        q.line,
                        q.col,
                        "C gives an array as its first element's address: take a Pointer<{self.tname(self.elemOf(written))}> (and its count)",
                    )
                }
            }
            let fnParam = x.kind == DeclKind.Fn and self.kindOf(t) == Kind.Fn
            self.p.bindings.push(
                Binding(
                    q.name,
                    t,
                    mutable: q.isVar or q.owned,
                    deep: q.owned,
                    isParam: true,
                    fnParam: fnParam,
                    paramOf: d,
                    paramIndex: f,
                    line: q.line,
                    col: q.col,
                ),
            )
            // owned: the function's own value, a var of it
            self.p.ast.params[prm].binding = len(self.p.bindings) - 1
            if t == x.ty and x.ty >= 0 {
                self.say(q.line, q.col, "{x.name} cannot hold itself")
            }
            if x.isExtern and self.isLoop(t) {
                self.say(q.line, q.col, "a host function takes values, not loops")
            }
        }
        if x.isExtern {
            self.p.ast.decls[d].cTypes = cTypes
        }
        let owner = self.p.ast.decls[d].owner
        if owner != "" {
            // fn Vec2.plus(a: Vec2, ...): a function of a type, which its first value is
            let t = self.findDecl(owner)
            if t < 0 or self.p.ast.decls[t].kind is Fn | Const {
                self.say(
                    x.line,
                    x.col,
                    "{owner} is not a type of this program: a function belongs to a record, an enum or an extern type",
                )
            } else if len(x.params) == 0 or self.paramName(x.params[0]) != "self" {
                let more = if len(x.params) > 1 { ", ..." } else { "" }
                self.say(x.line, x.col, "a type's function works on self, its first value: fn {x.name}(self{more})")
            } else {
                let st = self.paramType(x.params[0])
                let sd = self.declOf(st)
                if st != self.p.ast.decls[t].ty
                    and not self.isErr(st)
                    and sd != t
                    and (sd < 0 or self.p.ast.decls[sd].templateOf != t) {
                    self.say(x.line, x.col, "{x.name}'s self is the {owner} it works on: fn {x.name}(self, ...)")
                }
            }
        }
        if self.changesSelf(d) and (x.isExtern or x.isInterface) {
            let q = self.p.ast.params[x.params[0]]
            self.say(
                q.line,
                q.col,
                "{x.name} is the host's: it cannot change self (var self is for the program's own functions)",
            )
        }
        if x.kind == DeclKind.Fn and x.isExtern {
            // C's or the host's: its signature is all there is; a body C calls: checked below
            let written = if x.ret >= 0 { self.resolveType(x.ret) } else { tyVoid }
            self.p.ast.decls[d].cTypes.push(written)
            let plain = self.p.plainType(written)
            self.p.ast.decls[d].retType = plain
            if self.cArray(written) {
                let r = self.p.ast.types[x.ret]
                self.say(r.line, r.col, "C gives back no arrays: take a Pointer<{self.tname(self.elemOf(written))}>")
            }
            if x.body < 0 {
                self.p.ast.decls[d].state = 2
            }
        }
        self.c.cTypes = false
        self.c.typing = -1
    }
    if self.errors.count > before {
        return false
    }
    // a field whose type holds its own type (enum Expr { Add(a: Expr, b: Expr) }, type Node { next: Node? }) is
    // boxed: its value lives in the arena, and the field keeps its address
    for d in self.p.decls {
        let x = self.p.ast.decls[d]
        if x.isTemplate and x.kind != DeclKind.Fn {
            continue
        }
        if x.kind == DeclKind.Type and not x.isExtern {
            for prm in x.params {
                self.boxIfRecursive(prm, x.ty)
            }
        }
        if x.kind == DeclKind.Enum {
            for fields in x.caseFields {
                for prm in fields {
                    self.boxIfRecursive(prm, x.ty)
                }
            }
        }
    }
    // constants and default values: pure, checked once
    for d in self.p.decls {
        self.enterDecl(d)
        let x = self.p.ast.decls[d]
        if x.kind == DeclKind.Const {
            self.constType(d, x.body)
        }
        if x.kind != DeclKind.Fn and not (x.kind == DeclKind.Type and not x.isInterface and not x.isExtern) {
            continue // defaults: fn f(x: Int = 1), type T { x: Int = 1 }
        }
        for prm in x.params {
            let q = self.p.ast.params[prm]
            if q.fallback >= 0 and q.binding >= 0 {
                self.checkPure(q.fallback, -1, self.p.bindings[q.binding].ty, q.name, self.c.module)
            }
        }
    }
    self.reportDotted()
    if self.errors.count > before {
        return false
    }
    self.checkBodiesFrom(0)
    self.settleEffects()
    if self.errors.count > before {
        return false
    }
    self.c.module = 0
    var main = -1
    for d in self.p.decls {
        if main < 0 and self.p.ast.decls[d].module == 0 and self.p.ast.decls[d].name == "main" {
            main = d
        }
    }
    if main < 0 and not needMain {
        return self.errors.count == before
    }
    if main < 0 or self.p.ast.decls[main].kind != DeclKind.Fn {
        self.say(1, 1, "a program starts at fn main() \{ ... \}")
    } else {
        let x = self.p.ast.decls[main]
        let r = x.retType
        let unit = self.p.tupleType([])
        var fits = r < 0 or self.kindOf(r) is Void | Never or r == tyInt or r == unit
        if not fits and self.p.isResult(r) {
            let v = self.p.fallibleValue(r)
            fits = v == tyInt or v == unit
        }
        if x.isExtern or x.isTemplate or len(x.params) > 0 or not fits {
            self.say(x.line, x.col, "main takes no parameters and can return Unit, Int or a result of either")
        }
    }
    self.p.executable = needMain
    self.errors.count == before
}

// every function's body, from the i-th declaration on (instances and lifted lambdas made meanwhile among them):
// recursion, not a loop, so the loop collector never copies the program out (it holds everything)
fn Checker.checkBodiesFrom(var self, i: Int) {
    if i >= len(self.p.decls) {
        return
    }
    let d = self.p.decls[i]
    if self.p.ast.decls[d].kind == DeclKind.Fn and not self.isCFunction(d) {
        self.c.scope = []
        self.c.lets = []
        self.checkFnBody(d)
    }
    self.checkBodiesFrom(i + 1)
}

// what a match's arms say so far: a wildcard among them (every value matched), the cases matched (no guard)
type ArmsState { wildcard: Bool, seen: [Bool] }

// a match's arms from the i-th on, each checked: one after another by recursion, not a loop (a loop that makes
// things collects its memory, and an arm's body makes the whole checker's)
fn Checker.checkArms(
    var self,
    arms: [Int],
    i: Int,
    t: Int,
    result: Int,
    wantValue: Bool,
    state: ArmsState,
) -> ArmsState {
    if i >= len(arms) {
        return state
    }
    let a = arms[i]
    var wildcard = state.wildcard
    var seen = state.seen
    let tk = self.kindOf(t)
    let onText = tk == Kind.Text
    let onRecord = tk == Kind.Record
    let onNumber = tk is Int | Float
    let named = self.p.ast.arms[a]
    if named.pattern == ""
        and named.intPattern < 0
        and not named.isRange
        and named.textPattern < 0
        and named.whole != ""
        and named.valuePattern < 0
        and self.lookup(named.whole) < 0 {
        // a constant's name: the value is compared with it (any other name is the value, named)
        let d = self.findDecl(named.whole)
        if d >= 0 and self.p.ast.decls[d].kind == DeclKind.Const {
            let at = self.newExpr(
                .Name(named.whole),
                self.p.ast.exprs[named.body].line,
                self.p.ast.exprs[named.body].col,
            )
            let ct = self.checkExpr(at, true)
            if not self.isErr(ct) and self.coerce(at, t, "the pattern {named.whole}") {
                if not self.equatable(t) {
                    self.typeError(at, "a constant pattern compares with ==, and %s does not", t, -1)
                }
                self.p.ast.arms[a].valuePattern = at
            }
        }
    }
    let arm = self.p.ast.arms[a]
    let mark = len(self.c.scope)
    var ok = true
    if wildcard and not self.wildcardPattern(a) {
        self.sayAt(arm.body, "this match arm is unreachable")
    }
    if (onText or onNumber) and not wildcard {
        for k in 0..i {
            if self.coversPattern(arms[k], a) {
                self.sayAt(arm.body, "this match arm is unreachable")
                break
            }
        }
    }
    if arm.valuePattern >= 0 {
        // a constant: compared, not named
    } else if arm.pattern == "" and arm.intPattern < 0 and not arm.isRange and arm.textPattern < 0 {
        if arm.whole != "" {
            self.bindPattern(a, t, arm.body) // n if n > 2: the value, named
        }
        if arm.guard < 0 {
            wildcard = true
            if i != len(arms) - 1 {
                let what = if arm.whole != "" { arm.whole } else { "_" }
                self.sayAt(arm.body, "{what} catches everything: it goes last")
            }
        }
    } else if arm.pattern != "" {
        if tk != Kind.Enum and not onRecord {
            self.sayAt(arm.body, "{arm.pattern} is a case, but the match is on {self.tname(t)}")
            ok = false
        } else if self.bindPattern(a, t, arm.body) {
            let k = self.p.ast.arms[a].caseIndex
            if onRecord {
                if arm.guard < 0 and not self.refutable(a, t) {
                    wildcard = true // Point(x, y) catches every point
                }
            } else if k < 256 {
                if seen[k] {
                    self.sayAt(arm.body, "{arm.pattern} is matched twice")
                }
                if arm.guard < 0 and not self.subsRefutable(a, t) {
                    seen[k] = true
                }
            }
        } else {
            ok = false
        }
    } else if arm.textPattern >= 0 {
        if not onText {
            self.typeError(arm.textPattern, "a text pattern, but the match is on %s", t, -1)
            ok = false
        }
    } else if arm.intPattern >= 0 and self.p.ast.exprs[arm.intPattern].node is BoolLit(_) {
        ok = self.bindPattern(a, t, arm.body)
        if ok {
            let k = self.intOf(arm.intPattern)
            if seen[k] {
                self.sayAt(arm.body, "this Bool pattern is unreachable")
            }
            if arm.guard < 0 {
                seen[k] = true
            }
        }
    } else if not onNumber {
        self.typeError(
            if arm.intPattern >= 0 { arm.intPattern } else { arm.intHigh },
            "an Int pattern, but the match is on %s",
            t,
            -1,
        )
        ok = false
    } else if arm.isRange
        and arm.intPattern >= 0
        and arm.intHigh >= 0
        and self.intOf(arm.intPattern) >= self.intOf(arm.intHigh) {
        self.sayAt(arm.intPattern, "this range is empty (its end is not included): write a smaller start")
    }
    if ok and not arm.expanded and arm.guard >= 0 {
        let g = self.checkExpr(arm.guard, true)
        if self.kindOf(g) != Kind.Bool and not self.isErr(g) {
            self.typeError(arm.guard, "an arm's if takes a Bool, not %s", g, -1)
        }
    }
    self.c.result = result // an arm's own if or match gives the same type
    if ok and not arm.expanded {
        self.checkExpr(arm.body, wantValue)
    }
    self.c.result = -1
    self.truncate(mark)
    self.checkArms(arms, i + 1, t, result, wantValue, ArmsState(wildcard, seen))
}

// an array literal's elements from the i-th on, each going into elem (recursion, not a loop: see checkStmtsFrom)
fn Checker.hintedFrom(var self, items: [Int], i: Int, elem: Int) {
    if i >= len(items) {
        return
    }
    let item = items[i]
    self.hintLiteral(item, elem) // [[Shape]], [([Int], Color)]: inside too
    let et = self.checkExpr(item, true)
    self.c.hint = -1
    if self.isLoop(et) {
        self.markIterUse(item)
    }
    self.coerce(item, elem, "an array's element")
    self.hintedFrom(items, i + 1, elem)
}

// an array literal's elements from the i-th on, checked: the type the first that says one gives (t so far), and
// whether one is a Float
fn Checker.elementsFrom(var self, items: [Int], i: Int, t: Int, anyFloat: Bool) -> (Int, Bool) {
    if i >= len(items) {
        return (t, anyFloat)
    }
    let et = self.checkExpr(items[i], true)
    // [[], [1]], [None, Some(2)]: the first element that says its type gives it
    let vague = t == tyEmpty or t == tyEmptyMap or t == tyNone or t == tyDot or t >= 0 and self.kindOf(t) == Kind.Never
    let says = et != tyEmpty
        and et != tyEmptyMap
        and et != tyNone
        and et != tyDot
        and self.kindOf(et) != Kind.Never
        and not self.isErr(et)
    let next = if t < 0 or vague and says { et } else { t }
    self.elementsFrom(items, i + 1, next, anyFloat or self.kindOf(et) == Kind.Float)
}

// the type the next value goes into (a method of its own: set right after a call, a field of self kept its old value)
fn Checker.setHint(var self, t: Int) {
    self.c.hint = t
}

// value, a literal ([...], [k: v], (a, b)), goes into want: checked with it as the hint, so its [], [:], None and
// .Case take their types from it (f(["a": .Red]), fn pair() -> ([Int], Int) = ([], 0))
fn Checker.hintLiteral(var self, value: Int, want: Int) {
    if want < 0 or self.isErr(want) {
        return
    }
    let node = self.p.ast.exprs[value].node
    if node is ArrayLit(_) | MapLit(_) or node is Call(name, _, _, _, _, _) and name == "(,)" {
        self.setHint(want)
        return
    }
    // a call (or call?) of a template whose T only its result tells (fromJson(j), fieldFromJson(f, "a")?): the type the
    // value goes into
    let inner = if node is Try(v) { self.p.ast.exprs[v].node } else { node }
    if inner is Call(name, _, _, _, _, dotted) and not dotted and name != "(,)" {
        self.setHint(want)
    }
}
