// Programs as node graphs, and back. A graph is std.graph's values (compiler/graphvalue.qk): the writer below makes
// them from a checked program, the reader makes a program's syntax tree from them. Its two notations, Quark's own
// (QGN, what quark graph writes) and JSON (--json), are written and read in compiler/graphio.qk; here, as JSON says
// it:
//
// Every expression that is not a plain value is a node; its inputs are wires from other nodes or values typed into
// the pin. Every let, var, parameter and loop variable is a named node, and a use of the name is a wire from it.
// Statements run in the order of their block's list: that order is the execution wire. Literals, enum cases and
// function names are pin values, never nodes. Comments and blank lines ride on the nodes, so text -> graph -> text
// gives back the formatter's text exactly.
//
// {"quark": 1, "decls": [
//   {"kind": "fn", "name": "square", "params": [{"id": 1, "name": "x", "type": "Int"}], "returns": "Int",
//    "form": "expr", "result": {"node": 4}, "nodes": [{"id": 4, "kind": "op", "op": "+", "inputs": [...]}, ...]},
//   {"kind": "type", "name": "Point", "fields": [{"name": "x", "type": "Float"}]},
//   {"kind": "enum", "name": "Color", "cases": ["Red", "Green"]}]}
//
// Inputs: {"node": id} | {"value": "12", "of": "Int"} | {"case": "Color.Red"} | {"fn": "square"}. Blocks:
// {"stmts": [ids], "closing": "comment"}. A node's "key" (fn/name, for named nodes) is stable while the name is: an
// editor keeps positions in a side file under it (--layout), with a "uid" that survives a move.
//
use token
use ast
use source
use types
use format
use parser
use module
use check
use qgn
use graphio
use graphvalue as g
use json

// ---- writing a program's graph ----------------------------------------------------------------------------------
// The writer: the program, each binding's node (wire), the layout; per declaration its nodes so far (std.graph's
// values, made as they are met: inputs before the node that takes them), the next id, the function's name (keys start
// with it), how many lets, vars and fors name each name.
type Out {
    p: Program
    wire: [Int]
    layout: Json
    layoutRoot: Int = -1
    byHash: [Text: Int] = [:] // the layout's entries by the hash they say (an entry whose hash two say: none)
    nodes: [g.Node] = []
    nextId: Int = 1
    fnName: Text = ""
    named: [Text: Int] = [:]
}

// the node a name's uses wire to: a lambda's captured copy wires to the name it copies
fn Out.wireOf(self, b: Int) -> Int {
    var at = b
    while self.p.bindings[at].capturedFrom >= 0 {
        at = self.p.bindings[at].capturedFrom
    }
    self.wire[at]
}

fn Out.typeString(self, t: Int) -> Text = if t >= 0 { typeText(self.p.ast, t) } else { "" }

fn Out.visible(self, e: Int) -> Int {
    var v = e
    while self.p.ast.exprs[v].implicit and self.p.ast.exprs[v].node is Call(_, _, args, _, _, _) {
        v = args[0]
    }
    v
}

// A node's hash: its content's (its kind and canonical text, what it holds included), whatever its place: two
// versions of a program agree on a node that did not change even where its key (its place) did (FNV-1a, 64 bits).
fn contentHash(t: Text) -> Text {
    var h = -3750763034362895579
    for b in t.bytes() {
        h = (h ^ b) *% 1099511628211
    }
    let digits = "0123456789abcdef".bytes()
    var out = ""
    for i in 0..16 {
        out += char(digits[unsignedShift(h, 60 - 4 * i) & 15])
    }
    out
}

fn unsignedShift(x: Int, n: Int) -> Int = if n == 0 { x } else { x >> n & ~(-1 << (64 - n)) }

// a node's head: what names it, and its place and uid in the layout
fn Out.headed(self, n: g.Node, id: Int, kind: Text, key: Text, line: Int, hash: Text) -> g.Node {
    var out = n with { id: id, kind: kind, key: key, hash: hash, line: if line > 0 { line } else { 0 } }
    let l = self.layout
    let entry = self.layoutEntry(key, hash)
    if l.text(l.get(entry, "uid")) is Some(uid) and uid != "" {
        out.uid = uid
    }
    let pos = if l.kind(entry) == JKind.Obj { l.get(entry, "pos") } else { entry }
    let xy = l.items(pos)
    if l.kind(pos) == JKind.Arr and len(xy) == 2 and l.kind(xy[0]) == JKind.Num and l.kind(xy[1]) == JKind.Num {
        out.pos = [l.nodes[xy[0]].num, l.nodes[xy[1]].num]
    }
    out
}

// a node's entry in the layout: its key's while that one says the same hash (or none); else the one entry whose hash
// is the node's (it moved: an inserted statement changed its key). An entry that says another hash is another node's
// (one that moved away): a node changed where it is keeps its place by its uid (an editor's own id)
fn Out.layoutEntry(self, key: Text, hash: Text) -> Int {
    let l = self.layout
    let byKey = l.get(self.layoutRoot, key)
    let said = if l.kind(byKey) == JKind.Obj {
        l.text(l.get(byKey, "hash")) ?? ""
    } else {
        ""
    }
    if byKey >= 0 and (said == "" or said == hash) {
        return byKey
    }
    self.byHash[hash] ?? -1
}

fn Out.typeField(self, t: Int) -> Text {
    if t < 0 or self.p.types[t].kind is Error | Void {
        return ""
    }
    self.p.typeName(t)
}

// inputs: the i-th one's key is key.i
fn Out.inputs(var self, list: [Int], key: Text) -> [g.Pin] {
    var out: [g.Pin] = []
    for (i, e) in list.enumerate() {
        let one = self.writeInput(e, "{key}.{i}")
        out.push(one)
    }
    out
}

// A pattern: its text (Circle, 3, 80..90, "\"quit\"", _), and for a case its names, each a node the wires from them
// come from.
type Pattern {
    pattern: Text = ""
    wholeId: Int = 0
    alternatives: [g.Alt] = []
    binds: [g.Bind] = []
}

fn Out.writePattern(var self, arm: Arm) -> Pattern {
    var out = Pattern(pattern: if arm.pattern != "" {
        arm.pattern
    } else {
        patternText(self.p.ast, arm with { alternatives: [] })
    })
    if arm.whole != "" {
        let bid = self.nextId
        self.nextId += 1
        if arm.wholeBinding >= 0 {
            self.wire[arm.wholeBinding] = bid
        }
        out.wholeId = bid
    }
    for alt in arm.alternatives {
        let inner = self.writePattern(self.p.ast.arms[alt])
        out.alternatives.push(g.Alt(pattern: inner.pattern, binds: inner.binds))
    }
    for (f, bind) in arm.binds.enumerate() {
        let sub = arm.subs.get(f) ?? -1
        if sub >= 0 {
            let inner = self.writePattern(self.p.ast.arms[sub])
            out.binds.push(g.Bind(pattern: inner.pattern, binds: inner.binds, alternatives: inner.alternatives))
            continue
        }
        let bid = self.nextId
        self.nextId += 1
        let binding = arm.bindings.get(f) ?? -1
        if binding >= 0 {
            self.wire[binding] = bid
        }
        out.binds.push(g.Bind(id: bid, name: bind))
    }
    out
}

// a node with a pattern's fields
fn patterned(n: g.Node, p: Pattern) -> g.Node =
    n with { pattern: p.pattern, wholeId: p.wholeId, alternatives: p.alternatives, binds: p.binds }

fn Out.isEffectCall(self, x: Expr) -> Bool {
    if x.decl >= 0 and self.p.ast.decls[x.decl].kind == DeclKind.Fn and self.p.ast.decls[x.decl].isEffect {
        return true
    }
    if effectGroup(x.builtin) {
        return true
    }
    if x.callee >= 0 {
        let t = self.p.ast.exprs[x.callee].ty
        return t >= 0 and self.p.types[t].kind == Kind.Fn and self.p.types[t].isEffect
    }
    false
}

// the built-ins that reach the world (the checker's groups: print, files, process...)
fn effectGroup(b: Int) -> Bool = b == bPrint or b == bPrintErr

fn kindOfNode(node: ExprNode) -> Text = match node {
    IntLit(_, _) | FloatLit(_, _) | TextLit(_, _, _) | BoolLit(_) => "value"
    Hole => "hole"
    Name(_) => "name"
    Call(_, _, _, _, _, _) => "call"
    Field(_, _) => "field"
    Index(_, _) => "index"
    Unary(_, _) | Binary(_, _, _) | Range(_, _) => "op"
    If(_, _, _) => "if"
    Match(_, _, _) => "match"
    Lambda(_, _) => "lambda"
    ArrayLit(_) => "array"
    BlockExpr(_, _) => "block"
    Case(_, _, _) => "case"
    With(_, _, _) => "with"
    Interp(_, _, _, _, _) => "text"
    Try(_) => "try"
    MapLit(_) => "map"
    Is(_, _) => "is"
}

// An expression as a node; its id. Its inputs are made (and numbered) first.
fn Out.writeNode(var self, at: Int, key: Text) -> Int {
    let e = self.visible(at)
    let id = self.nextId
    self.nextId += 1
    let x = self.p.ast.exprs[e]
    var n = g.Node()
    match x.node {
        With(target, values, fields) => {
            n.names = fields
            n.inputs = self.inputs([target] + values, key)
        }
        Interp(values, _, raws, formats, multiline) => {
            n.multiline = multiline
            n.parts = raws
            if len(formats) > 0 {
                var fs: [Text] = []
                for i in 0..len(values) {
                    fs.push(formats.get(i) ?? "")
                }
                n.formats = fs
            }
            n.inputs = self.inputs(values, key)
        }
        Try(value) => {
            n.inputs = self.inputs([value], key)
        }
        MapLit(items) => {
            n.inputs = self.inputs(items, key)
        }
        Call(name, qualifier, args, names, method, dotted) => {
            n.function = name
            n.qualifier = qualifier
            n.dotted = dotted
            n.effects = self.isEffectCall(x)
            n.method = method
            if names.any(m => m != "") {
                var ns: [Text] = []
                for i in 0..len(args) {
                    ns.push(names.get(i) ?? "")
                }
                n.names = ns
            }
            n.inputs = self.inputs(args, key)
        }
        Binary(op, left, right) => {
            n.op = op.name()
            n.inputs = self.inputs([left, right], key)
        }
        Unary(op, operand) => {
            n.op = if op == Op.Not {
                "not"
            } else if op == Op.Tilde {
                "~"
            } else {
                "neg"
            }
            n.inputs = self.inputs([operand], key)
        }
        Range(low, high) => {
            n.op = ".."
            if low < 0 or high < 0 {
                // xs[2..], xs[..3]: the end that is left out
                n.open = if low >= 0 { "end" } else { "start" }
                let one = if low >= 0 {
                    [low]
                } else if high >= 0 {
                    [high]
                } else {
                    []
                }
                n.inputs = self.inputs(one, key)
            } else {
                n.inputs = self.inputs([low, high], key)
            }
        }
        Field(target, name) => {
            n.field = name
            n.inputs = self.inputs([target], key)
        }
        Index(target, index) => {
            n.inputs = self.inputs([target, index], key)
        }
        ArrayLit(items) => {
            n.inputs = self.inputs(items, key)
        }
        Lambda(params, body) => {
            for k in params {
                let prm = self.p.ast.params[k]
                let pid = self.nextId
                self.nextId += 1
                if prm.binding >= 0 {
                    self.wire[prm.binding] = pid
                }
                n.params.push(g.Param(id: pid, name: prm.name, typeName: self.typeString(prm.ty)))
            }
            n.inputs = self.inputs([body], key)
        }
        If(cond, then, otherwise) => {
            n.inputs = self.inputs([cond], key)
            n.then = self.writeBlock(then, key + "/then")
            if otherwise >= 0 {
                if self.p.ast.exprs[otherwise].node is If(_, _, _) {
                    n.elseIf = self.writeNode(otherwise, key + "/else")
                } else if self.p.ast.exprs[otherwise].node is BlockExpr(b, _) {
                    n.otherwise = Some(self.writeBlock(b, key + "/else"))
                }
            }
        }
        Match(subject, arms, chain) => {
            n.inputs = self.inputs([subject], key)
            n.chain = chain // a?.rest
            var ordinal = 0
            for k in arms {
                let arm = self.p.ast.arms[k]
                if arm.expanded {
                    continue
                }
                let armKey = "{key}/arm{ordinal}"
                ordinal += 1
                let pat = self.writePattern(arm)
                var a = g.Arm(
                    pattern: pat.pattern,
                    binds: pat.binds,
                    alternatives: pat.alternatives,
                    wholeId: pat.wholeId,
                )
                if arm.guard >= 0 {
                    a.guard = self.writeInput(arm.guard, armKey + "/if")
                }
                a.comment = arm.comment
                if self.p.ast.exprs[arm.body].node is BlockExpr(b, jump) and not jump {
                    a.block = self.writeBlock(b, armKey)
                } else {
                    a.value = self.writeInput(arm.body, armKey)
                }
                n.arms.push(a)
            }
        }
        BlockExpr(b, jump) => {
            n.jump = jump // x ?? return 0: its one statement, where a value goes
            n.block = self.writeBlock(b, key + "/block")
        }
        Is(value, pattern) => {
            n.inputs = self.inputs([value], key)
            n = patterned(n, self.writePattern(self.p.ast.arms[pattern]))
        }
        _ => {}
    }
    let kind = kindOfNode(x.node)
    n = self.headed(n, id, kind, key, x.line, contentHash(kind + ":" + exprText(self.p.ast, at, 0)))
    n.typeName = self.typeField(x.ty)
    self.nodes.push(n)
    id
}

fn Out.writeInput(var self, at: Int, key: Text) -> g.Pin {
    var e = self.visible(at)
    if self.p.ast.exprs[e].node is Lambda(_, _) and self.p.ast.exprs[e].sugar >= 0 {
        e = self.p.ast.exprs[e].sugar
    }
    let x = self.p.ast.exprs[e]
    match x.node {
        IntLit(_, raw) => g.Pin(value: raw, of: "Int")
        FloatLit(_, raw) => g.Pin(value: raw, of: "Float")
        TextLit(_, raw, _) => g.Pin(value: raw, of: "Text")
        BoolLit(value) => g.Pin(value: if value { "true" } else { "false" }, of: "Bool")
        Case(name, target, dotted) => g.Pin(case: self.caseText(x, name, target, dotted))
        Name(name) => if x.binding >= 0 {
            g.Pin(node: self.wireOf(x.binding))
        } else if x.decl >= 0 and self.p.ast.decls[x.decl].kind == DeclKind.Fn {
            g.Pin(function: name) // a function given where a lambda goes
        } else {
            g.Pin(name: name) // a constant, None
        }
        _ => g.Pin(node: self.writeNode(e, key))
    }
}

// a case as written: ".Leaf", "Tree.Leaf", "Self.Leaf"
fn Out.caseText(self, x: Expr, name: Text, target: Int, dotted: Bool) -> Text {
    if dotted {
        return "." + name
    }
    if target >= 0 and self.p.ast.exprs[target].node is Name(n) {
        return n + "." + name
    }
    if x.decl >= 0 {
        let d = self.p.ast.decls[x.decl]
        return (if d.templateOf >= 0 {
            self.p.ast.decls[d.templateOf].name
        } else {
            d.name
        }) + "." + name
    }
    ""
}

// how many lets, vars and fors of the function name each name (what keys a named statement by its place too)
fn Out.countExpr(var self, e: Int) {
    if e < 0 {
        return
    }
    let x = self.p.ast.exprs[e]
    match x.node {
        Call(_, _, args, _, _, _) => {
            for a in args {
                self.countExpr(a)
            }
        }
        Field(target, _) => self.countExpr(target)
        Index(target, index) => {
            self.countExpr(target)
            self.countExpr(index)
        }
        Unary(_, operand) => self.countExpr(operand)
        Binary(_, left, right) => {
            self.countExpr(left)
            self.countExpr(right)
        }
        Range(low, high) => {
            self.countExpr(low)
            self.countExpr(high)
        }
        If(cond, then, otherwise) => {
            self.countExpr(cond)
            self.countExpr(otherwise)
            self.countBlock(then)
        }
        Match(subject, arms, _) => {
            self.countExpr(subject)
            for k in arms {
                if not self.p.ast.arms[k].expanded {
                    self.countExpr(self.p.ast.arms[k].body)
                }
            }
        }
        Lambda(_, body) => self.countExpr(body)
        ArrayLit(items) => {
            for a in items {
                self.countExpr(a)
            }
        }
        BlockExpr(b, _) => self.countBlock(b)
        Case(_, target, _) => self.countExpr(target)
        With(target, values, _) => {
            self.countExpr(target)
            for a in values {
                self.countExpr(a)
            }
        }
        Interp(values, _, _, _, _) => {
            for a in values {
                self.countExpr(a)
            }
        }
        Try(value) => self.countExpr(value)
        MapLit(items) => {
            for a in items {
                self.countExpr(a)
            }
        }
        Is(value, pattern) => {
            self.countExpr(value)
            self.countExpr(self.p.ast.arms[pattern].body)
        }
        _ => {}
    }
}

fn Out.countName(var self, name: Text) {
    let n = self.named[name] ?? 0
    self.named[name] = n + 1
}

fn Out.countBlock(var self, b: Int) {
    if b < 0 {
        return
    }
    for s in self.p.ast.blocks[b].stmts {
        match self.p.ast.stmts[s].node {
            Let(_, name, _, value, pattern, otherwise) => {
                if pattern < 0 and name != "" {
                    self.countName(name)
                }
                self.countExpr(value)
                self.countBlock(otherwise)
            }
            Assign(target, _, value) => {
                self.countExpr(value)
                self.countExpr(target)
            }
            ExprStmt(value) => self.countExpr(value)
            For(name, pattern, iter, body) => {
                if pattern < 0 and name != "" {
                    self.countName(name)
                }
                self.countExpr(iter)
                self.countBlock(body)
            }
            While(cond, body) => {
                self.countExpr(cond)
                self.countBlock(body)
            }
            Return(value) => self.countExpr(value)
            Defer(body) => self.countBlock(body)
            _ => {}
        }
    }
}

// a declaration's writing starts: its nodes, ids and named statements of its own
fn Out.begin(var self, d: Decl) {
    self.nodes = []
    self.nextId = 1
    self.fnName = d.name
    self.named = [:]
    if d.body >= 0 and self.p.ast.exprs[d.body].node is BlockExpr(b, _) {
        self.countBlock(b)
    }
}

// the name a let, var or for gives (not a pattern's), or ""
fn stmtName(s: Stmt) -> Text = match s.node {
    Let(_, name, _, _, pattern, _) => if pattern < 0 { name } else { "" }
    For(name, pattern, _, _) => if pattern < 0 { name } else { "" }
    _ => ""
}

// A named statement is keyed fn/name; when the function names two (a for i in each of two loops), each is keyed by
// its place too (main/@3/i). Other statements by their place.
fn Out.stmtKey(self, s: Int, prefix: Text, i: Int) -> Text {
    let name = stmtName(self.p.ast.stmts[s])
    if name != "" {
        if (self.named[name] ?? 0) <= 1 {
            return self.fnName + "/" + name
        }
        return "{prefix}/@{i}/{name}"
    }
    "{prefix}/@{i}"
}

fn Out.writeBlock(var self, b: Int, prefix: Text) -> g.Block {
    let bl = self.p.ast.blocks[b]
    var ids: [Int] = []
    for (i, s) in bl.stmts.enumerate() {
        let key = self.stmtKey(s, prefix, i)
        let id = self.writeStmt(s, key)
        ids.push(id)
    }
    g.Block(stmts: ids, closing: bl.closingComment)
}

fn Out.writeStmt(var self, at: Int, key: Text) -> Int {
    let s = self.p.ast.stmts[at]
    let id = self.nextId
    self.nextId += 1
    var n = g.Node()
    var kind = ""
    match s.node {
        ExprStmt(value) => {
            // a "do" node holds the statement's place in the order; the expression is its input
            kind = "do"
            n.inputs = self.inputs([value], key)
        }
        Let(mutable, name, ty, value, pattern, otherwise) => {
            kind = if mutable { "var" } else { "let" }
            if pattern >= 0 {
                // let Some(x) = value else { ... }, var (a, b) = ...
                n = patterned(n, self.writePattern(self.p.ast.arms[pattern]))
                n.inputs = self.inputs([value], key)
                if otherwise >= 0 {
                    n.otherwise = Some(self.writeBlock(otherwise, key + "/else"))
                }
            } else {
                if s.binding >= 0 {
                    self.wire[s.binding] = id
                }
                n.name = name
                n.annotation = self.typeString(ty)
                n.inputs = self.inputs([value], key)
            }
        }
        Assign(target, op, value) => {
            kind = "set"
            n.op = op.name()
            n.inputs = self.inputs([target, value], key)
        }
        For(name, pattern, iter, body) => {
            kind = "for"
            if pattern >= 0 {
                n = patterned(n, self.writePattern(self.p.ast.arms[pattern]))
            } else {
                if s.binding >= 0 {
                    self.wire[s.binding] = id
                }
                n.name = name
            }
            n.inputs = self.inputs([iter], key)
            n.body = self.writeBlock(body, key)
        }
        Defer(body) => {
            kind = "defer"
            n.body = self.writeBlock(body, key)
        }
        While(cond, body) => {
            kind = "while"
            n.inputs = self.inputs([cond], key)
            n.body = self.writeBlock(body, key)
        }
        Return(value) => {
            kind = "return"
            if value >= 0 {
                n.inputs = self.inputs([value], key)
            }
        }
        Break => {
            kind = "break"
        }
        Continue => {
            kind = "continue"
        }
    }
    n.comment = s.leading
    n.trailing = s.trailing ?? ""
    n.blank = s.blankBefore
    n = self.headed(n, id, kind, key, s.line, contentHash(kind + ":" + stmtText(self.p.ast, at)))
    self.nodes.push(n)
    id
}

// a function's parameters, result and the rest of its head
fn Out.withParams(var self, d: Decl, given: g.Decl) -> g.Decl {
    var out = given
    for (k, at) in d.params.enumerate() {
        let prm = self.p.ast.params[at]
        let pid = self.nextId
        self.nextId += 1
        if prm.binding >= 0 {
            self.wire[prm.binding] = pid
        }
        var p = g.Param(id: pid, name: prm.name, mutable: prm.isVar, key: d.name + "/" + prm.name) // var self
        if k > 0 or not d.impliedSelf {
            p.typeName = self.typeString(prm.ty) // fn Vec2.length(self): its type is the type's
        }
        if prm.fallback >= 0 {
            // its default: a value, or nodes of its own
            p.default = self.writeInput(prm.fallback, d.name + "/" + prm.name + "=")
        }
        out.params.push(p)
    }
    if d.ret >= 0 {
        out.returns = self.typeString(d.ret)
    }
    out.effects = d.isEffect and not d.isTest
    out.effectDeclared = d.effectDeclared
    out.externSymbol = d.externSymbol
    out.library = d.externLib
    out.variadic = d.variadic
    if len(d.typeParams) > 0 and not d.impliedTypes {
        var tps: [Text] = []
        for (k, tp) in d.typeParams.enumerate() {
            let bound = d.typeBounds.get(k) ?? ""
            tps.push(if bound != "" {
                tp + ": " + bound // "T: Speaker"
            } else {
                tp
            })
        }
        out.typeParams = tps
    }
    out
}

fn declKindText(d: Decl) -> Text = match d.kind {
    Fn => if d.isExtern {
        "extern fn"
    } else if d.isTest {
        "test"
    } else {
        "fn"
    }
    Type => if d.isExtern {
        "extern type"
    } else if d.isInterface {
        "interface"
    } else {
        "type"
    }
    Const => "const"
    Use => "use"
    Enum => "enum"
}

fn Out.declOf(var self, d: Decl) -> g.Decl {
    var out = g.Decl(
        kind: declKindText(d),
        name: d.name,
        isPub: d.isPub,
        comment: d.leading,
        trailing: d.trailing ?? "",
    )
    if (d.kind == DeclKind.Type or d.kind == DeclKind.Enum) and len(d.typeParams) > 0 {
        out.typeParams = d.typeParams // type Pair<A, B>
    }
    if len(d.memberLeading) > 0 or len(d.memberTrailing) > 0 {
        // each field's (case's) comments: above it, and after it
        for i in 0..max(len(d.memberLeading), len(d.memberTrailing)) {
            let after = if i < len(d.memberTrailing) { d.memberTrailing[i] } else { None }
            out.memberComments.push(g.Note(above: d.memberLeading.get(i) ?? "", after: after))
        }
    }
    self.begin(d)
    match d.kind {
        Use => {
            // another file: its declarations are its own graph's
            out.alias = d.alias
            return out
        }
        Enum => {
            for (k, c) in d.cases.enumerate() {
                var fields: [g.Field] = []
                for prm in d.caseFields.get(k) ?? [] {
                    let q = self.p.ast.params[prm]
                    fields.push(g.Field(name: q.name, typeName: self.typeString(q.ty)))
                }
                out.cases.push(g.Case(name: c, fields: fields))
            }
            return out
        }
        Const => {
            // a constant: its value's nodes
            if d.ret >= 0 {
                out.annotation = self.typeString(d.ret)
            }
            out.result = self.writeInput(d.body, d.name + "/=")
            out.nodes = self.nodes
            return out
        }
        Type => {
            out.opaque = d.opaque
            if d.isInterface {
                // its functions, as they are written
                out.isInterface = true
                out.functions = d.params.map(prm => memberText(self.p.ast, self.p.ast.params[prm])).toArray()
            } else if not d.isExtern or d.cStruct {
                for at in d.params {
                    let prm = self.p.ast.params[at]
                    var f = g.Field(name: prm.name, typeName: self.typeString(prm.ty), isPub: prm.isPub)
                    if prm.fallback >= 0 {
                        f.default = self.writeInput(prm.fallback, d.name + "/" + prm.name + "=")
                    }
                    out.fields.push(f)
                }
                out.nodes = self.nodes
            }
            return out
        }
        Fn => {}
    }
    out = self.withParams(d, out)
    if d.isExtern and d.body < 0 {
        out.nodes = self.nodes // defaults with nodes
        return out
    }
    if self.p.ast.exprs[d.body].node is BlockExpr(b, _) {
        out.form = "block"
        out.body = self.writeBlock(b, d.name)
    } else {
        out.form = "expr"
        out.result = self.writeInput(d.body, d.name + "/=")
    }
    out.nodes = self.nodes
    out
}

// A checked program's graph, as std.graph's values; layout: {"key": [x, y]} or {"key": {"pos": [x, y], "uid": "..."}}
// ("" none).
pub fn graphValueOf(p: Program, layoutText: Text) -> g.Graph {
    var layout = Json()
    var root = -1
    if layoutText != "" and parseJson(layoutText) is Some(l) and l.kind(0) == JKind.Obj {
        layout = l
        root = 0
    }
    var byHash: [Text: Int] = [:]
    if root >= 0 {
        for v in layout.nodes[root].items {
            if layout.kind(v) == JKind.Obj and layout.text(layout.get(v, "hash")) is Some(h) and h != "" {
                byHash[h] = if byHash.contains(h) { -1 } else { v }
            }
        }
    }
    var o = Out(p, [0] * len(p.bindings), layout, layoutRoot: root, byHash: byHash)
    var decls: [g.Decl] = []
    for at in p.decls {
        let d = p.ast.decls[at]
        if d.fromPrelude or d.templateOf >= 0 or d.module != 0 or d.lifted or d.fromDefault {
            continue // the host's: in the catalog; another file's: in its own graph
        }
        decls.push(o.declOf(d))
    }
    g.Graph(quark: 1, decls: decls, closing: p.ast.closingComment)
}

// A checked program's graph, as JSON
pub fn graphOf(p: Program, layoutText: Text) -> Text = jsonOfGraph(graphValueOf(p, layoutText))

// The reader: the graph (std.graph's values), the tree being built, the errors; per declaration its nodes, the node
// at each id, the name a binding node carries, the nodes being built (one met again is wired into itself).
type In {
    ast: Ast = Ast()
    src: Source
    errors: Errors = Errors()
    nodes: [g.Node] = []
    byId: [Int] = []
    names: [Text?] = []
    building: [Bool] = []
    maxId: Int = 0
    failed: Bool = false
}

fn In.fail(var self, what: Text, id: Int) {
    if not self.failed {
        self.errors.add(self.src, 0, 0, "the graph is not valid: {what} (node {id})")
    }
    self.failed = true
}

fn In.zero(var self) -> Int = self.ast.expr(.IntLit(0, ""), 0, 0)

fn In.typeOf(var self, text: Text) -> Int = self.ast.parseTypeOnto(text)

fn intValue(raw: Text) -> Int {
    var digits = raw.replace("_", "")
    let negative = digits.startsWith("-")
    if negative {
        digits = digits[1..]
    }
    var base = 10
    if digits.startsWith("0x") {
        base = 16
    } else if digits.startsWith("0b") {
        base = 2
    } else if digits.startsWith("0o") {
        base = 8
    }
    if base != 10 {
        digits = digits[2..]
    }
    var v = 0
    for c in digits.bytes() {
        let d = match c {
            '0'..='9' => c - '0'
            'a'..='f' => c - 'a' + 10
            'A'..='F' => c - 'A' + 10
            _ => 99
        }
        if d >= base {
            break
        }
        v = v *% base +% d
    }
    if negative { 0 -% v } else { v }
}

// a literal from its text as written ("12", "\"hi\"", "true") and its type's name
fn In.literal(var self, raw: Text, of: Text) -> Int {
    if of == "Bool" {
        return self.ast.expr(.BoolLit(raw == "true"), 0, 0)
    }
    if of == "Text" {
        let plain = raw.startsWith("r") // r"...": no escapes
        let text = if plain { raw[1..] } else { raw }
        let n = len(text)
        var s = 1
        var end = if n > 1 { n - 1 } else { n }
        var multiline = false
        if n >= 8 and text.startsWith("\"\"\"\n") and text.endsWith("\n\"\"\"") {
            multiline = true // three quotes: lines
            s = 4
            end = n - 4
        }
        let decoded = if s > end {
            ""
        } else if plain {
            text[s..end]
        } else {
            decodeEscapes(text, s, end) ?? "" // a bad escape: the checker of the text it becomes says so
        }
        return self.ast.expr(.TextLit(decoded, raw, multiline), 0, 0)
    }
    if of == "Float" {
        return self.ast.expr(.FloatLit(raw.replace("_", "").parseFloat() ?? 0.0, raw), 0, 0)
    }
    if raw.startsWith("'") {
        return self.ast.expr(.IntLit(charLiteral(raw) ?? 0, raw), 0, 0) // 'a': its code point
    }
    self.ast.expr(.IntLit(intValue(raw), raw), 0, 0)
}

fn In.name(var self, name: Text) -> Int = self.ast.expr(.Name(name), 0, 0)

fn In.input(var self, p: g.Pin) -> Int {
    if p.value != "" or p.of != "" {
        return self.literal(p.value, if p.of != "" { p.of } else { "Int" })
    }
    if p.case != "" {
        let cs = p.case
        if cs.startsWith(".") {
            return self.ast.expr(.Case(cs[1..], -1, true), 0, 0) // .Leaf: the enum it goes into
        }
        let dot = lastDot(cs)
        let typeName = if dot >= 0 { cs[..dot] } else { cs }
        let target = self.name(typeName)
        return self.ast.expr(.Field(target, if dot >= 0 { cs[dot + 1..] } else { "" }), 0, 0)
    }
    if p.function != "" {
        return self.name(p.function)
    }
    if p.name != "" {
        return self.name(p.name) // a constant, None
    }
    let id = p.node
    if id <= 0 or id > self.maxId {
        self.fail(if id == 0 {
            "an input that is none of a wire, a value, a case or a function"
        } else {
            "a wire from a node that does not exist"
        }, id)
        return self.zero()
    }
    if self.names[id] is Some(n) {
        return self.name(n) // a named node: the wire is its name
    }
    let at = self.byId[id]
    let target = if at >= 0 { self.nodes[at] } else { g.Node() }
    if target.kind is "let" | "var" | "for" and target.name != "" {
        if self.building[id] {
            self.fail("a node wired into itself (its value uses it)", id)
            return self.zero()
        }
        // a wire from a let further on (a merge can make one): its name, which the checker finds is not known there yet
        return self.name(target.name)
    }
    self.node(id)
}

fn lastDot(t: Text) -> Int {
    let b = t.bytes()
    var i = len(b) - 1
    while i >= 0 and b[i] != '.' {
        i -= 1
    }
    i
}

fn In.inputsOf(var self, n: g.Node) -> [Int] {
    var out: [Int] = []
    for p in n.inputs {
        let e = self.input(p)
        out.push(e)
    }
    out
}

fn startsWithByte(t: Text, lo: Int, hi: Int) -> Bool {
    let b = t.bytes()
    len(b) > 0 and b[0] >= lo and b[0] <= hi
}

// a pattern's fields (see writePattern) back into an arm
fn In.pattern(var self, pat: Text, wholeId: Int, binds: [g.Bind], alternatives: [g.Alt], given: Arm) -> Arm {
    var arm = given
    if pat == "(,)" {
        arm.pattern = "(,)"
    } else if pat != "" and pat != "_" {
        let p = pat
        let dots = p.indexOf("..") ?? -1
        if p.startsWith("\"") or p.startsWith("r\"") {
            arm.textPattern = self.literal(p, "Text")
        } else if dots >= 0 {
            // 80..90, 90.., ..60, 'a'..='z'
            arm.isRange = true
            let inclusive = p[dots + 2..] != "" and p[dots + 2..].startsWith("=")
            if dots > 0 {
                arm.intPattern = self.literal(p[..dots], "Int")
            }
            let high = p[dots + 2 + (if inclusive { 1 } else { 0 })..]
            if high != "" {
                arm.intHigh = self.literal(high, "Int")
            }
            if inclusive and arm.intHigh >= 0 {
                arm.inclusive = true
                if self.ast.exprs[arm.intHigh].node is IntLit(v, raw) {
                    self.ast.exprs[arm.intHigh].node = .IntLit(v + 1, raw)
                }
            }
        } else if p == "true" or p == "false" {
            arm.intPattern = self.literal(p, "Bool")
        } else if p.startsWith("-") or p.startsWith("'") or startsWithByte(p, '0', '9') {
            arm.intPattern = self.literal(p, "Int")
        } else if startsWithByte(p, 'a', 'z') {
            arm.whole = p // the whole value, named
            if wholeId > 0 and wholeId <= self.maxId {
                self.names[wholeId] = p
            }
        } else {
            arm.pattern = p
        }
    }
    if len(binds) > 0 {
        // Circle(r): r names a node the arm's wires come from
        var names: [Text] = []
        var subs: [Int] = []
        var anySub = false
        for b in binds {
            if b.pattern != "" {
                // a pattern inside
                let inner = self.pattern(b.pattern, 0, b.binds, b.alternatives, Arm())
                let sub = self.ast.arm(inner)
                subs.push(sub)
                anySub = true
                names.push("_")
                continue
            }
            let name = if b.name != "" { b.name } else { "_" }
            names.push(name)
            subs.push(-1)
            if b.id > 0 and b.id <= self.maxId {
                self.names[b.id] = name
            }
        }
        arm.binds = names
        arm.subs = if anySub { subs } else { [] }
    }
    for alt in alternatives {
        let a = self.pattern(alt.pattern, 0, alt.binds, [], Arm())
        let at = self.ast.arm(a)
        arm.alternatives.push(at)
    }
    arm
}

fn In.node(var self, id: Int) -> Int {
    if id >= 0 and id <= self.maxId {
        if self.building[id] {
            self.fail("a node wired into itself (its value uses it)", id)
            return self.zero()
        }
        self.building[id] = true
        let e = self.nodeInner(id)
        self.building[id] = false
        return e
    }
    self.nodeInner(id)
}

fn In.first(var self, args: [Int]) -> Int = if len(args) > 0 { args[0] } else { self.zero() }

fn In.second(var self, args: [Int]) -> Int = if len(args) > 1 { args[1] } else { self.zero() }

fn binaryOp(name: Text) -> Op? = match name {
    "+" => Some(Op.Plus)
    "-" => Some(Op.Minus)
    "*" => Some(Op.Star)
    "/" => Some(Op.Slash)
    "%" => Some(Op.Percent)
    "&" => Some(Op.Amp)
    "|" => Some(Op.Pipe)
    "^" => Some(Op.Caret)
    "==" => Some(Op.Eq)
    "!=" => Some(Op.Ne)
    "<" => Some(Op.Lt)
    "<=" => Some(Op.Le)
    ">" => Some(Op.Gt)
    ">=" => Some(Op.Ge)
    "??" => Some(Op.Coalesce)
    "<<" => Some(Op.Shl)
    ">>" => Some(Op.Shr)
    "and" => Some(Op.And)
    "or" => Some(Op.Or)
    "+%" => Some(Op.PlusWrap)
    "-%" => Some(Op.MinusWrap)
    "*%" => Some(Op.StarWrap)
    _ => None
}

fn assignOp(name: Text) -> Op = match name {
    "+=" => Op.PlusEq
    "-=" => Op.MinusEq
    "*=" => Op.StarEq
    "/=" => Op.SlashEq
    "%=" => Op.PercentEq
    "&=" => Op.AmpEq
    "|=" => Op.PipeEq
    "^=" => Op.CaretEq
    "<<=" => Op.ShlEq
    ">>=" => Op.ShrEq
    "+%=" => Op.PlusWrapEq
    "-%=" => Op.MinusWrapEq
    "*%=" => Op.StarWrapEq
    _ => Op.Assign
}

fn In.nodeInner(var self, id: Int) -> Int {
    let at = if id >= 0 and id <= self.maxId { self.byId[id] } else { -1 }
    if at < 0 {
        self.fail("a missing node", id)
        return self.zero()
    }
    let n = self.nodes[at]
    let kind = n.kind
    if kind == "lambda" {
        // the parameters are named before the body is read
        var params: [Int] = []
        for p in n.params {
            let ty = if p.typeName != "" { self.typeOf(p.typeName) } else { -1 }
            let k = self.ast.param(Param(p.name, ty, 0, 0))
            params.push(k)
            if p.id > 0 and p.id <= self.maxId {
                self.names[p.id] = p.name
            }
        }
        let body = if len(n.inputs) > 0 {
            self.input(n.inputs[0])
        } else {
            self.input(g.Pin())
        }
        return self.ast.expr(.Lambda(params, body), 0, 0)
    }
    let args = self.inputsOf(n)
    let count = len(args)
    match kind {
        "call" => {
            var names = [""] * count
            for i in 0..min(count, len(n.names)) {
                names[i] = n.names[i]
            }
            if n.function == "" {
                self.fail("a call without a function", id)
            }
            return self.ast.expr(.Call(n.function, n.qualifier, args, names, n.method, n.dotted), 0, 0)
        }
        "with" => {
            // inputs: the base, then the new values, named
            let base = self.first(args)
            let values = if count > 0 { args[1..] } else { [] }
            var fields: [Text] = []
            for i in 0..len(values) {
                fields.push(n.names.get(i) ?? "x")
            }
            return self.ast.expr(.With(base, values, fields), 0, 0)
        }
        "text" => {
            // "lap {n}": the pieces as written, a value between each two
            var raws: [Text] = []
            var parts: [Text] = []
            for i in 0..count + 1 {
                let raw = n.parts.get(i) ?? ""
                raws.push(raw)
                parts.push(decodeEscapes(raw, 0, len(raw)) ?? "")
            }
            var formats: [Text] = []
            if len(n.formats) > 0 {
                for i in 0..count {
                    formats.push(n.formats.get(i) ?? "")
                }
            }
            return self.ast.expr(.Interp(args, parts, raws, formats, n.multiline), 0, 0)
        }
        "try" => {
            let v = self.first(args)
            return self.ast.expr(.Try(v), 0, 0)
        }
        "map" => return self.ast.expr(.MapLit(args), 0, 0)
        "op" => {
            let op = if n.op != "" { n.op } else { "+" }
            if n.open != "" and op == ".." {
                // a range without its start or its end
                let v = self.first(args)
                return self.ast.expr(if n.open == "end" { .Range(v, -1) } else { .Range(-1, v) }, 0, 0)
            }
            if op is "neg" | "not" | "~" {
                let v = self.first(args)
                let u = if op == "neg" {
                    Op.Minus
                } else if op == "~" {
                    Op.Tilde
                } else {
                    Op.Not
                }
                return self.ast.expr(.Unary(u, v), 0, 0)
            }
            let a = self.first(args)
            let b = self.second(args)
            if op == ".." {
                return self.ast.expr(.Range(a, b), 0, 0)
            }
            let Some(o) = binaryOp(op) else {
                self.fail("an unknown operator", id)
                return self.ast.expr(.Binary(Op.Plus, a, b), 0, 0)
            }
            return self.ast.expr(.Binary(o, a, b), 0, 0)
        }
        "field" => {
            let v = self.first(args)
            return self.ast.expr(.Field(v, n.field), 0, 0)
        }
        "index" => {
            let a = self.first(args)
            let b = self.second(args)
            return self.ast.expr(.Index(a, b), 0, 0)
        }
        "array" => return self.ast.expr(.ArrayLit(args), 0, 0)
        "if" => {
            let cond = self.first(args)
            let then = self.block(n.then)
            var otherwise = -1
            if n.elseIf > 0 {
                otherwise = self.node(n.elseIf)
            } else if n.otherwise is Some(ob) {
                let b = self.block(ob)
                otherwise = self.ast.expr(.BlockExpr(b, false), 0, 0)
            }
            return self.ast.expr(.If(cond, then, otherwise), 0, 0)
        }
        "match" => {
            let subject = self.first(args)
            var list: [Int] = []
            for a in n.arms {
                var arm = self.pattern(a.pattern, a.wholeId, a.binds, a.alternatives, Arm())
                arm.comment = a.comment
                if a.guard != g.Pin() {
                    let gd = self.input(a.guard)
                    arm.guard = gd
                }
                if a.value == g.Pin() {
                    let b = self.block(a.block)
                    arm.body = self.ast.expr(.BlockExpr(b, false), 0, 0)
                } else {
                    let v = self.input(a.value)
                    arm.body = v
                }
                let k = self.ast.arm(arm)
                list.push(k)
            }
            return self.ast.expr(.Match(subject, list, n.chain), 0, 0)
        }
        "block" => {
            let b = self.block(n.block)
            var jump = n.jump
            if jump {
                let stmts = self.ast.blocks[b].stmts
                if len(stmts) != 1 or not self.ast.stmts[stmts[0]].node is Return(_) | Break | Continue {
                    self.fail("a jump holds one return, break or continue", id)
                    jump = false
                }
            }
            return self.ast.expr(.BlockExpr(b, jump), 0, 0)
        }
        "hole" => return self.ast.expr(.Hole, 0, 0)
        // _: a value not written yet (an empty pin)
        "is" => {
            // value is Pattern
            let v = self.first(args)
            let arm = self.pattern(n.pattern, n.wholeId, n.binds, n.alternatives, Arm())
            let k = self.ast.arm(arm)
            return self.ast.expr(.Is(v, k), 0, 0)
        }
        _ => {}
    }
    self.fail("an unknown kind of node", id)
    self.zero()
}

fn In.block(var self, b: g.Block) -> Int {
    var list: [Int] = []
    for id in b.stmts {
        let s = self.stmt(id)
        list.push(s)
    }
    self.ast.block(Block(list, b.closing))
}

fn In.stmt(var self, id: Int) -> Int {
    let at = if id >= 0 and id <= self.maxId { self.byId[id] } else { -1 }
    if at < 0 {
        self.fail("a missing statement", id)
        return self.ast.stmt(Stmt(.Break, 0, 0))
    }
    let n = self.nodes[at]
    let kind = n.kind
    let first = n.inputs.get(0) ?? g.Pin()
    var made: StmtNode = .Break
    if kind is "let" | "var" and n.pattern != "" {
        // let Some(x) = value else { ... }
        let arm = self.pattern(n.pattern, n.wholeId, n.binds, n.alternatives, Arm())
        let pattern = self.ast.arm(arm)
        let value = self.input(first)
        let otherwise = if n.otherwise is Some(ob) { self.block(ob) } else { -1 }
        made = .Let(kind == "var", "", -1, value, pattern, otherwise)
    } else if kind is "let" | "var" {
        let ty = if n.annotation != "" { self.typeOf(n.annotation) } else { -1 }
        self.building[id] = true
        let value = self.input(first)
        self.building[id] = false
        self.names[id] = n.name // from here on, wires from it are its name
        made = .Let(kind == "var", n.name, ty, value, -1, -1)
    } else if kind == "set" {
        let op = assignOp(if n.op != "" { n.op } else { "=" })
        let target = self.input(first)
        let value = self.input(n.inputs.get(1) ?? g.Pin())
        made = .Assign(target, op, value)
    } else if kind == "for" {
        var name = ""
        var pattern = -1
        if n.pattern != "" {
            let arm = self.pattern(n.pattern, n.wholeId, n.binds, n.alternatives, Arm())
            pattern = self.ast.arm(arm)
        } else {
            name = n.name
            self.names[id] = name
        }
        let iter = self.input(first)
        let body = self.block(n.body)
        made = .For(name, pattern, iter, body)
    } else if kind == "defer" {
        let body = self.block(n.body)
        made = .Defer(body)
    } else if kind == "while" {
        let cond = self.input(first)
        let body = self.block(n.body)
        made = .While(cond, body)
    } else if kind == "return" {
        let value = if len(n.inputs) > 0 { self.input(first) } else { -1 }
        made = .Return(value)
    } else if kind == "break" {
        made = .Break
    } else if kind == "continue" {
        made = .Continue
    } else if kind == "do" {
        let value = self.input(first)
        made = .ExprStmt(value)
    } else {
        self.fail("an unknown kind of statement", id)
    }
    self.ast.stmt(
        Stmt(
            made,
            0,
            0,
            leading: n.comment,
            trailing: if n.trailing != "" { Some(n.trailing) } else { None },
            blankBefore: n.blank,
        ),
    )
}

// the highest id among a pattern's binds, the patterns inside them too
fn maxBindId(binds: [g.Bind]) -> Int {
    var m = 0
    for b in binds {
        m = max(m, max(b.id, maxBindId(b.binds)))
    }
    m
}

fn maxIdOf(d: g.Decl) -> Int {
    var m = 0
    for p in d.params {
        m = max(m, p.id)
    }
    for n in d.nodes {
        m = max(m, max(n.id, max(maxBindId(n.binds), n.wholeId))) // let Some(x) = ... else; v is n
        for p in n.params {
            m = max(m, p.id)
        }
        for a in n.arms {
            m = max(m, max(maxBindId(a.binds), a.wholeId))
        }
    }
    m
}

// a declaration's nodes, by id
fn In.startDecl(var self, d: g.Decl) {
    self.maxId = maxIdOf(d)
    self.nodes = d.nodes
    self.byId = [-1] * (self.maxId + 1)
    let none: Text? = None
    self.names = [none] * (self.maxId + 1)
    self.building = [false] * (self.maxId + 1)
    self.failed = false
    for (k, n) in d.nodes.enumerate() {
        if n.id >= 0 and n.id <= self.maxId {
            self.byId[n.id] = k
        }
    }
}

// an interface's function from its text (fn speak(loud: Bool) -> Text)
fn In.member(var self, text: Text) -> Param? {
    let before = len(self.ast.decls)
    let parsed = parseInto(self.ast, Source("type", "interface I \{\n    " + text + "\n\}\n"))
    if not parsed.ok or len(parsed.ast.decls) <= before or len(parsed.ast.decls[before].params) == 0 {
        return None
    }
    var tree = parsed.ast
    let at = tree.decls[before].params[0]
    tree.decls = tree.decls[..before]
    self.ast = tree
    Some(self.ast.params[at])
}

// A graph: its program's syntax tree, and the errors (said with path); ok when it is a whole one.
pub type Imported { ast: Ast, errors: [Text], ok: Bool }

// the program a graph's JSON is
pub fn graphToAst(json: Text, path: Text) -> Imported {
    let Some(gr) = graphOfJson(json) else {
        var errors = Errors()
        errors.add(Source(path, ""), 0, 0, "this is not a Quark graph (JSON with \"decls\")")
        return Imported(Ast(), errors.shown, false)
    }
    programOfGraph(gr, path)
}

// the program a graph is
pub fn programOfGraph(gr: g.Graph, path: Text) -> Imported {
    var r = In(src: Source(path, ""))
    if gr.quark != 1 and gr.quark != 0 {
        r.errors.add(r.src, 0, 0, "unsupported Quark graph version (expected 1)")
        return Imported(r.ast, r.errors.shown, false)
    }
    var ok = true
    for (i, dj) in gr.decls.enumerate() {
        if dj.kind == "" or dj.name == "" {
            r.errors.add(r.src, 0, 0, "declaration {i + 1} has no kind or name")
            return Imported(r.ast, r.errors.shown, false)
        }
        let k = dj.kind
        var d = Decl(
            kind: DeclKind.Fn,
            name: dj.name,
            line: 0,
            col: 0,
            leading: dj.comment,
            trailing: if dj.trailing != "" { Some(dj.trailing) } else { None },
            index: i,
        )
        d.isPub = dj.isPub
        if len(dj.typeParams) > 0 {
            var bounds: [Text] = []
            var anyBound = false
            for tp in dj.typeParams {
                if tp.indexOf(": ") is Some(colon) {
                    d.typeParams.push(tp[..colon]) // T: Speaker
                    bounds.push(tp[colon + 2..])
                    anyBound = true
                } else {
                    d.typeParams.push(tp)
                    bounds.push("")
                }
            }
            if anyBound {
                d.typeBounds = bounds
            }
        }
        for note in dj.memberComments {
            d.memberLeading.push(note.above)
            d.memberTrailing.push(note.after)
        }
        if k == "use" {
            d.kind = DeclKind.Use
            d.alias = dj.alias
        } else if k == "enum" {
            d.kind = DeclKind.Enum
            for c in dj.cases[..min(len(dj.cases), 64)] {
                d.cases.push(if c.name != "" { c.name } else { "Case" })
                var ps: [Int] = []
                for f in c.fields {
                    let ty = r.typeOf(if f.typeName != "" { f.typeName } else { "Int" })
                    let at = r.ast.param(Param(f.name, ty, 0, 0))
                    ps.push(at)
                }
                d.caseFields.push(ps)
            }
        } else if k is "type" | "interface" | "extern type" {
            d.kind = DeclKind.Type
            d.isExtern = k == "extern type"
            d.cStruct = d.isExtern and len(dj.fields) > 0
            d.isInterface = k == "interface"
            d.opaque = dj.opaque
            if len(dj.functions) > 0 and not d.isInterface {
                r.errors.add(r.src, 0, 0, "type {d.name} lists functions: an interface does (kind \"interface\")")
                return Imported(r.ast, r.errors.shown, false)
            }
            for text in dj.functions {
                // an interface
                if r.member(text) is Some(prm) {
                    let at = r.ast.param(prm)
                    d.params.push(at)
                }
            }
            r.startDecl(dj)
            for f in dj.fields {
                let ty = r.typeOf(if f.typeName != "" { f.typeName } else { "Int" })
                var prm = Param(f.name, ty, 0, 0, isPub: f.isPub)
                if f.default != g.Pin() {
                    let v = r.input(f.default)
                    prm.fallback = v
                }
                let at = r.ast.param(prm)
                d.params.push(at)
            }
        } else {
            // fn, extern fn, const, test: nodes of their own
            let isConst = k == "const"
            d.kind = if isConst { DeclKind.Const } else { DeclKind.Fn }
            d.isExtern = k == "extern fn"
            d.isEffect = dj.effects
            d.effectDeclared = dj.effectDeclared
            if d.isExtern {
                d.externSymbol = dj.externSymbol
                d.externLib = dj.library
                d.variadic = dj.variadic
            }
            if k == "test" {
                // test "name": its name as text
                d.isTest = true
                d.isEffect = true
                let title = if len(d.name) > 5 { d.name[5..] } else { "\"\"" }
                let t = r.literal(title, "Text")
                if r.ast.exprs[t].node is TextLit(text, _, _) {
                    d.testName = text
                }
            }
            r.startDecl(dj)
            for p in dj.params {
                let ty = if p.typeName != "" { r.typeOf(p.typeName) } else { -1 }
                var prm = Param(p.name, ty, 0, 0, isVar: p.mutable)
                if p.id > 0 and p.id <= r.maxId {
                    r.names[p.id] = prm.name
                }
                if p.default != g.Pin() {
                    let v = r.input(p.default)
                    prm.fallback = v
                }
                let at = r.ast.param(prm)
                d.params.push(at)
            }
            if dj.returns != "" {
                d.ret = r.typeOf(dj.returns)
            }
            if dj.annotation != "" {
                d.ret = r.typeOf(dj.annotation)
            }
            if d.isExtern and dj.form == "" {
                // C's, or the host's: no body
            } else if isConst or dj.form == "expr" {
                let v = r.input(dj.result)
                d.body = v
            } else {
                let b = r.block(dj.body)
                d.body = r.ast.expr(.BlockExpr(b, false), 0, 0)
            }
            ok = ok and not r.failed
        }
        r.ast.decl(d)
    }
    r.ast.closingComment = gr.closing
    Imported(r.ast, r.errors.shown, ok)
}

// whether a graph's nodes carry uids (a merge of such graphs keeps its own JSON)
pub fn graphHasUids(json: Text) -> Bool {
    let Some(gr) = graphOfJson(json) else {
        return false
    }
    gr.decls.any(d => d.nodes.any(n => n.uid != ""))
}

// ---- the commands ------------------------------------------------------------------------------------------------
// a command's output on standard output, as it is (print ends the line itself)
pub fn emit(out: Text) {
    if out == "" {
        return
    }
    if out.endsWith("\n") {
        print(out[..len(out) - 1])
    } else {
        print(out)
    }
}

// the lines of a text on the error stream
pub fn emitErr(out: Text) {
    if out != "" {
        printErr(if out.endsWith("\n") { out[..len(out) - 1] } else { out })
    }
}

// A program read from its text (the files it uses, the host's declarations) and checked: the program, or None when
// it has errors (said, unless silent: then it is checked for what it works out, its errors not said).
pub type Read { program: Program, ok: Bool, parsed: Bool }

pub fn readProgram(path: Text, text: Text, preludePath: Text, silent: Bool) -> Read {
    var host: Source? = None
    if preludePath != "" {
        let Ok(t) = readFile(preludePath) else {
            printErr("quark: cannot read {preludePath}")
            return Read(newProgram(Ast(), []), false, false)
        }
        host = Source(preludePath, t)
    }
    let loaded = loadProgram(Source(path, text), host)
    if not loaded.ok {
        for e in loaded.errors.shown {
            printErr(e)
        }
        return Read(loaded.program, false, false)
    }
    let checked = checkProgram(loaded.program, loaded.errors, false, None)
    if not silent {
        for e in checked.errors.shown {
            printErr(e)
        }
    }
    Read(checked.program, checked.ok, true)
}

// the command's options: its files, and each option's value (--layout L, -o out, --prelude P) or "" (--json)
pub type Options {
    files: [Text] = []
    layout: Text = ""
    out: Text = ""
    prelude: Text = ""
    json: Bool = false
    bad: Text = ""
}

pub fn options(given: [Text], most: Int, takesOut: Bool) -> Options {
    var o = Options()
    var i = 1
    while i < len(given) {
        let a = given[i]
        i += 1
        if a == "--json" {
            o.json = true
        } else if a == "--layout" and i < len(given) {
            o.layout = given[i]
            i += 1
        } else if a == "-o" and takesOut and i < len(given) {
            o.out = given[i]
            i += 1
        } else if a == "--prelude" and i < len(given) {
            o.prelude = given[i]
            i += 1
        } else if len(o.files) < most and (not a.startsWith("-") or a == "-") {
            o.files.push(a)
        } else {
            o.bad = a
            return o
        }
    }
    o
}

// quark graph FILE [--layout L]: its node graph; quark text FILE.json: the program a graph is
pub fn graphCommand(given: [Text]) -> Int {
    let o = options(given, 1, true)
    if o.bad != "" {
        printErr("quark: unknown option {o.bad}")
        return 2
    }
    if len(o.files) == 0 {
        return 2
    }
    let path = o.files[0]
    let Ok(text) = readFile(path) else {
        printErr("quark: cannot read {path}")
        return 1
    }
    if given[0] == "text" {
        // a graph in either notation: Quark's (QGN) or JSON
        let read = graphOfText(text, path)
        if read is Err(why) {
            printErr(why)
            return 1
        }
        let Ok(gr) = read else {
            return 1
        }
        let imported = programOfGraph(gr, path)
        for e in imported.errors {
            printErr(e)
        }
        if not imported.ok {
            return 1
        }
        emit(format(imported.ast))
        return 0
    }
    if path.endsWith(".qgn") or path.endsWith(".json") {
        // a graph already: said again in the notation asked for (QGN, or JSON with --json)
        let read = graphOfText(text, path)
        if read is Err(why) {
            printErr(why)
            return 1
        }
        let Ok(gr) = read else {
            return 1
        }
        emit(if o.json { jsonOfGraph(gr) } else { qgnOfGraph(gr) })
        return 0
    }
    let read = readProgram(path, text, o.prelude, false)
    var layout = ""
    if o.layout != "" {
        let Ok(l) = readFile(o.layout) else {
            printErr("quark: cannot read {o.layout}")
            return 1
        }
        layout = l
    }
    // with errors (said already), the graph of what was read: what could not be read is a hole (an empty pin), so a
    // program being written is a graph at every step; in Quark's notation (QGN), or JSON with --json
    let gr = graphValueOf(read.program, layout)
    emit(if o.json { jsonOfGraph(gr) } else { qgnOfGraph(gr) })
    if read.ok { 0 } else { 1 }
}

// ---- a line of a graph's text, as its node ----------------------------------------------------------------------
// The key of the statement a line belongs to (the last one starting at or before it, in the function that holds
// it), else of the declaration: how an error in a graph's canonical text points at a node (qkCompileGraph).
pub fn keyAtLine(p: Program, line: Int) -> Text? {
    var o = Out(p, [], Json())
    var best: Text? = None
    var bestLine = 0
    for at in p.decls {
        let d = p.ast.decls[at]
        if d.fromPrelude or d.line > line {
            continue
        }
        if d.line >= bestLine {
            best = d.name
            bestLine = d.line
        }
        if d.kind == DeclKind.Fn and d.body >= 0 and p.ast.exprs[d.body].node is BlockExpr(b, _) {
            o.begin(d)
            let (key, keyLine) = o.keyInBlock(b, d.name, line, best, bestLine)
            best = key
            bestLine = keyLine
        }
    }
    best
}

// each statement's line's graph key, as the debugger names the values of its statements (keyAtLine): LowerOptions.debugKeys
pub fn lineKeys(p: Program) -> [Int: Text] {
    var keys: [Int: Text] = [:]
    for st in p.ast.stmts {
        if st.line > 0 and not keys.contains(st.line) and keyAtLine(p, st.line) is Some(k) {
            keys[st.line] = k
        }
    }
    keys
}

fn Out.keyInBlock(self, b: Int, prefix: Text, line: Int, best: Text?, bestLine: Int) -> (Text?, Int) {
    var key = best
    var keyLine = bestLine
    for (i, s) in self.p.ast.blocks[b].stmts.enumerate() {
        let st = self.p.ast.stmts[s]
        let here = self.stmtKey(s, prefix, i)
        if st.line <= line and st.line >= keyLine {
            key = here
            keyLine = st.line
        }
        let body = match st.node {
            For(_, _, _, body) => body
            While(_, body) => body
            Defer(body) => body
            _ => -1
        }
        if body >= 0 {
            let (k, l) = self.keyInBlock(body, here, line, key, keyLine)
            key = k
            keyLine = l
        }
    }
    (key, keyLine)
}
