// quarkq ir and quarkq code: the back end written in Quark, from a file's text to machine code.
//   quarkq ir FILE [--json] [--lowered] [--release] [--fuel N] [--target T] [--abi sysv] [--no-avx]
//       [--trace OUT]
//       the IR (quark ir): lowered (compiler/lower.qk), then optimized (opt.qk, release.qk) unless --lowered; --json
//       every field the backends read (quark ir --json), else the readable dump
//   quarkq code FILE [-o code.bin] [--release] ...
//       quark code: the machine code into a file, and on standard output each function's offset, the way in and
//       out, the relocations and the call sites
use std.machine as machine
use source
use module
use check
use ir
use lower
use graph
use release
use x64
use arm64

fn irUsage() -> Int {
    printErr(
        "usage: quarkq ir FILE [--json] [--lowered] [--release] [--fuel N] [--target T] [--abi sysv] [--no-avx]\n       quarkq code FILE [-o code.bin] [--release] [--fuel N] [--target T]",
    )
    2
}

fn hex8(n: Int) -> Text {
    let digits = "0123456789abcdef"
    var out = ""
    for k in 0..8 {
        let d = n >> (28 - 4 * k) & 15
        out += digits[d..d + 1]
    }
    out
}

pub fn irCommand(given: [Text]) -> Int {
    let command = given[0]
    var path = ""
    var json = false
    var lowered = false
    var release = false
    var fuel = 0
    var noAvx = false
    var target = ""
    var sysvAbi = false
    var outPath = "code.bin"
    var debug = false
    var i = 1
    while i < len(given) {
        let a = given[i]
        i += 1
        if a == "--json" {
            json = true
        } else if a == "--lowered" {
            lowered = true
        } else if a == "--release" {
            release = true
        } else if a == "--no-avx" {
            noAvx = true
        } else if a == "--fuel" and i < len(given) {
            fuel = given[i].parseInt() ?? 0
            i += 1
        } else if a == "--target" and i < len(given) {
            target = given[i]
            i += 1
        } else if a == "--abi" and i < len(given) {
            sysvAbi = given[i] == "sysv"
            i += 1
        } else if a == "--trace" and i < len(given) {
            debug = true // lowered for the debugger, as quark run --trace compiles it
            i += 1
        } else if a == "-o" and i < len(given) {
            outPath = given[i]
            i += 1
        } else if path == "" and not a.startsWith("-") {
            path = a
        } else {
            printErr("quark: unknown option {a}")
            return 2
        }
    }
    if path == "" {
        return irUsage()
    }
    // the machine (as the C compiler sees it: AVX unless --no-avx, AVX2 for 4 lanes, SSE4.2), or the target named
    let cpu = machine.cpu()
    var avx = not noAvx and cpu & 1 != 0
    var arch = Arch.X64
    var sysv = sysvAbi
    if target != "" {
        let known = ["x86_64-windows", "x86_64-linux", "x86_64-macos", "arm64-linux", "arm64-macos", "arm64-ios"]
        if not known.contains(target) {
            printErr(
                "quark: --target is x86_64-windows, x86_64-linux, x86_64-macos, arm64-linux, arm64-macos or arm64-ios",
            )
            return 2
        }
        arch = if target.startsWith("arm64") { Arch.Arm64 } else { Arch.X64 }
        sysv = target != "x86_64-windows"
        avx = false
    }
    let lanes = if arch == Arch.Arm64 {
        2
    } else if avx and cpu & 2 != 0 {
        4
    } else {
        2
    }
    let Ok(text) = readFile(path) else {
        printErr("quark: cannot read {path}")
        return 1
    }
    let loaded = loadProgram(Source(path, text), None)
    if not loaded.ok {
        for e in loaded.errors.shown {
            printErr(e)
        }
        return 1
    }
    let checkedProgram = checkProgram(loaded.program, loaded.errors, false, None)
    for e in checkedProgram.errors.shown {
        printErr(e)
    }
    if not checkedProgram.ok {
        return 1
    }
    let low = lowerProgram(
        checkedProgram.program,
        LowerOptions(
            fuel: fuel > 0,
            arch: arch,
            sysv: sysv,
            debug: debug,
            debugKeys: if debug { lineKeys(checkedProgram.program) } else { [:] },
            shortTexts: env("QUARK_SHORT_TEXTS") == Some("1"),
        ),
    )
    var prog = low.program
    prog.target = Target(arch: arch, sysv: sysv, avx: avx, lanes: lanes, sse42: cpu & 4 != 0)
    if command == "ir" {
        if not lowered {
            prog.optimize(release)
        }
        let out = if json { irJson(prog, lowered) } else { irDump(prog) }
        if len(out) > 0 {
            print(out[..len(out) - 1])
        }
        return 0
    }
    prog.optimize(release)
    let mc = match prog.target.arch {
        X64 => genX64(prog)
        Arm64 => genArm64(prog)
    }
    if writeBytes(outPath, mc.code) is Err(_) {
        return 1
    }
    var out: [Text] = []
    for (k, f) in prog.fns.enumerate() {
        out.push("{hex8(mc.fnAt[k])} {f.name}")
    }
    out.push("enter {hex8(mc.enter)}")
    out.push("escape {hex8(mc.escape)}")
    for r in mc.relocs {
        out.push("reloc {hex8(r.at)} {r.kind} {r.target}")
    }
    for s in mc.sites {
        out.push("site {hex8(s.ret)} {s.line} {s.caller} {s.callee} {s.inl}")
    }
    print(out.join("\n"))
    0
}
