// each runtime function's arguments ('I' / 'F') and result ('I', 'F', 'V'), by its number
const runtimeSigs: [Text] = [
    "IIII V", "I V", "F V", "I V", "II V", " V", " V", "II I", "IIII I", "III I", " F", "F F", "F F", "F F", "F F",
    "F F", "F F", "FF F", "F F", "F F", "FF F", "I V", "III V", "IIII I", "IIII I", "I I", "F I", "III I", "II I",
    "IIII I", " I", " I", "IIII I", "II I", "II I", "II I", "III V", "I V", "I V", "II I", "II I", "II I", "II I",
    "IIII I", "IIII I", "IIIIII I", "III I", "IIII I", "IIII I", "FI I", "III I", "II I", "II I", "II I", " F", "I I",
    "IIII I", "III I", "III V", "I I", "I I", "I I", "II I", "I I", "I I", "I I", "I I", "II V", "IIII I", "IIIII I",
    "IIIIIII I", " F", "III I", "I V", "II I", "II I", " V", "F V", " V", " I", "II V", " V", "I V", "IIIIII V", "II I",
    "II V", "III V", "III I", "II I", "III I", "II V", "II I", "II I", "IIII I", "II I", "II I", "IIII I", "IIIII I",
    "IIII V", "II I", "II I", "I V", "I I", "II V", "II V", "IIII I", "I I", "I V", "IIII V", "I V", "I I", "I V",
    "II V",
]

pub fn runtimeTable() -> [RtSig] {
    var out: [RtSig] = []
    for s in runtimeSigs {
        let b = s.bytes()
        out.push(RtSig(b[..len(b) - 2], b[len(b) - 1]))
    }
    out
}

// a panic's code
const panicIndex = 1
const panicEmpty = 5
const panicSliceEnd = 7
const panicSliceStart = 8
const panicTextCut = 10
const panicByte = 18

// a var self of more slots than this takes it by address
const selfInRegisters = 4

// A record of more than byRefFrom slots, given to a function that does not change it (self, or any parameter), goes by
// address: the place it is in when it is in one, else a copy in the caller's area. A var self kept in memory never
// comes into registers for a loop when it is larger than selfRegistersMost (
// SELF_REGISTERS_MOST).
const byRefFrom = 8
const selfRegistersMost = 16

// inlining's budget
const inlineBody = 120
const inlineCostMax = 400
const inlineBudget = 4000

// ---- what lowering keeps ----
// a function being inlined: where its returns jump, where they leave their value
type Frame { d: Int, end: Int, result: [Int] }

// a defer of a block being lowered: its block, the function it belongs to (inlined ones too), the loops it is in
type DeferAt { body: Int, inlineDepth: Int, loopLevel: Int }

// an interface table made: for a type (have) that goes into an interface (want), at `at` in the data
type TableKey { have: Int, want: Int, at: Int }

// a function made after the program's: a printer of a type (byValue: its slots as the arguments, else a box's
// address), or (owns) one that copies the insides of an array's or a map's elements
type Helper { t: Int, index: Int, byValue: Bool, owns: Bool, textFind: Bool = false }

// xs.push(v) on a var's own name: the function, the push, the var
type Growth { fnId: Int, at: Int, holder: Int }

// a function made after the program's own: a C entry (kind 0: of Quark function fn, with C's types) or std.machine's
type Late { kind: Int, decl: Int, cTypes: [Int], exportName: Text?, index: Int = -1 }

// an instruction (of function fnId, at) whose imm names late function `late`
type LatePatch { fnId: Int, at: Int, late: Int }

// A loop's memory: the start's placeholder, the vars from outside that it changes (roots), the names it makes
// (inside), the vars it changes other than by push on their own name (changed).
type LoopMemory {
    frame: Int = 0
    slotsReg: Int = 0
    nopAt: Int = 0
    bodyStart: Int = 0
    started: Bool = false
    roots: [Int] = []
    inside: [Int] = []
    changed: [Int] = []
}

// Where a place's slots are: registers (a var, its fields), or memory (an element of an array, a map's value).
type PlaceRef {
    memory: Bool = false
    boxed: Bool = false
    regs: [Int] = []
    base: Int = 0
    index: Int = 0
    stride: Int = 0
    offset: Int = 0
    holder: Int = 0
    holderLen: Int = 0
    holderType: Int = -1
    ty: Int = -1
}

// p[i], p[i].field: where it is in C's memory, and its C type
type CPlace { base: Int = 0, index: Int = 0, scale: Int = 0, offset: Int = 0, t: Int = -1 }

// How a C type crosses a call: its slots where C wants them ('I', 'F', 'M': System V, on the stack), passed by its
// address (byRef), or an AAPCS64 HFA (a register per member at offsets, memberKinds 4 a C float, 8 a double).
type CPass {
    kinds: Bytes = []
    byRef: Bool = false
    hfa: Bool = false
    offsets: [Int] = []
    memberKinds: [Int] = []
}

// a search's state (contains, indexOf, first, last, count, minBy, maxBy)
type Search {
    result: [Int] = []
    needle: [Int] = []
    elem: Int = -1
    lambda: Int = -1
    bestKey: [Int] = []
    has: Int = -1
    builtin: Int = 0
    line: Int = 0
    keyType: Int = -1
}

// What a loop does with each element (C's Sink and its context).
enum Sink {
    Collect(ptr: Int, len: Int, cap: Int, bytes: Int, exact: Bool, line: Int, ty: Int)
    ByteBuild(ptr: Int, len: Int, cap: Int, line: Int)
    Mean(acc: Int, has: Int)
    CountBy(acc: Int, key: Int, lambda: Int, line: Int)
    ToSet(acc: Int, key: Int, line: Int)
    Sum(acc: [Int], line: Int)
    Count(acc: Int)
    Fold(acc: [Int], lambda: Int)
    AnyOf(acc: Int, lambda: Int, all: Bool)
    Extreme(acc: Int, has: Int, isMax: Bool)
    MapThrough(lambda: Int, inner: Sink)
    FilterThrough(lambda: Int, counter: Int, inner: Sink)
    TakeThrough(counter: Int, limit: Int, inner: Sink)
    SkipThrough(counter: Int, limit: Int, inner: Sink)
    EnumerateThrough(counter: Int, inner: Sink)
    Searching(s: Search)
    ForBody(stmt: Int, memory: Int)
    PrintElem(elem: Int)
    DumpElem(elem: Int)
}

// What a loop over a map's entries does with each one (C's EntryFn and its context).
enum EntrySink {
    EntryTuple(counter: Int, inner: Sink)
    PrintEntry(t: Int, first: Int)
    DumpEntry(t: Int)
    SetOpEntry(out: Int, other: Int, union: Bool, both: Bool, line: Int, key: Int)
    ForEntry(stmt: Int, memory: Int)
}

pub type Lower {
    p: Program
    own: Ownership // the memory questions (compiler/ownership.qk)
    opts: LowerOptions = LowerOptions()
    writing: Bool = false // placeOf for a change in place (counted: the containers on the way made unique)
    branchDepth: Int = 0 // counted: inside a branch, a pipeline's loop or a lambda (what is made there is not let go of)
    out: IrProgram = IrProgram()
    data: Bytes = []
    texts: [Text: Int] = [:] // each text's place in data: one for every use of the same text
    externDefs: [Text: Int] = [:] // the pub extern fns with a body, by their C symbol (an extern of that symbol calls one)
    externDefsMade: Bool = false
    variadicExterns: [Text: Int] = [:] // a variadic C function's externs, by its declaration and its C slots
    cSigIndex: [Text: Int] = [:] // the calls through a C function value: each way of passing slots, once
    cur: IrFn = IrFn("")
    fnId: Int = -1
    fns: [IrFn] = []
    outCount: Int = 0
    fnIndex: [Int] = []
    depth: Int = 0
    loopBreak: Int = 0
    loopContinue: Int = 0
    defers: [DeferAt] = []
    loopLevel: Int = 0
    userBreak: Int = 0
    userContinue: Int = 0
    preRange: Int = -1
    preA: Int = 0
    preB: Int = 0
    preArray: Int = -1
    preArrayVal: [Int] = []
    preText: Int = -1 // a fused text source (text.words()) whose text was worked out before the loop's mark
    preTextVal: [Int] = []
    snapshot: Int = -1
    tables: [TableKey] = []
    inlining: [Frame] = []
    callerLine: Int = 0 // inside a built-in of the prelude put in line: the line of the program's call that reached it
    current: Int = -1
    inl: Int = 0
    inlines: [InlineCall] = []
    externIndex: [Int] = []
    inlineCost: [Int] = []
    sizeMemo: [Int] = []
    inlined: Int = 0
    areaAt: Int = -1
    areaSlots: Int = 0
    areaReg: Int = 0
    selfMemo: [Int] = []
    asValue: [Bool] = []
    selfHome: Int = -1
    helpers: [Helper] = []
    helpersDone: Int = 0 // helpers given their function already (counted in outCount: a new one's index is after all)
    printing: [Int] = []
    growths: [Growth] = []
    regs: [[Int]] = []
    bound: [Bool] = []
    atAddress: [Bool] = []
    addrReg: [Int] = []
    selfInPlace: [Bool] = []
    shared: [(Int, Int)] = []
    constAt: [Int: Int] = [:]
    constTextAt: [Int: Int] = [:] // a constant array of text literals: its (offset, length) pairs in the data
    lates: [Late] = []
    latePatches: [LatePatch] = []
    memories: [LoopMemory] = []
    slotCache: [Int] = []
    kindCache: [Bytes] = []
    caseStarts: [Int: [Int]] = [:] // by enum declaration
}

// ---- the tree, as lowering reads it ----
fn Lower.ex(self, e: Int) -> Expr = self.p.ast.exprs[e]

fn Lower.ty(self, e: Int) -> Int = self.p.ast.exprs[e].ty

fn Lower.tk(self, t: Int) -> Kind = self.p.types[t].kind

fn Lower.ek(self, e: Int) -> Kind = self.p.types[self.p.ast.exprs[e].ty].kind

fn Lower.lineOf(self, e: Int) -> Int = self.p.ast.exprs[e].line

fn Lower.dl(self, d: Int) -> Decl = self.p.ast.decls[d]

fn Lower.tdecl(self, t: Int) -> Int = self.p.types[t].decl

fn Lower.elemOf(self, t: Int) -> Int = self.p.types[t].elem

fn Lower.keyOf(self, t: Int) -> Int = self.p.types[t].key

fn Lower.bt(self, b: Int) -> Int = self.p.bindings[b].ty

fn Lower.pbind(self, prm: Int) -> Int = self.p.ast.params[prm].binding

fn Lower.ptype(self, prm: Int) -> Int = self.p.paramType(prm)

fn Lower.boxed(self, prm: Int) -> Bool = self.p.ast.params[prm].boxed

fn Lower.builtinOf(self, e: Int) -> Int = self.p.ast.exprs[e].builtin

fn Lower.declName(self, d: Int) -> Text = self.p.ast.decls[d].name

// a template's instance: the template's name (Tree.Leaf of a Tree<Int> too)
fn Lower.shownName(self, d: Int) -> Text {
    let x = self.p.ast.decls[d]
    if x.templateOf >= 0 {
        self.p.ast.decls[x.templateOf].name
    } else {
        x.name
    }
}

fn Lower.aOf(self, e: Int) -> Int = self.p.ast.aOf(e)

fn Lower.bOf(self, e: Int) -> Int = self.p.ast.bOf(e)

fn Lower.argsOf(self, e: Int) -> [Int] = self.p.ast.argsOf(e)

fn Lower.armsOf(self, e: Int) -> [Int] = self.p.ast.armsOf(e)

fn Lower.arg(self, e: Int, i: Int) -> Int = self.argsOf(e)[i]

fn Lower.argCount(self, e: Int) -> Int = len(self.argsOf(e))

fn Lower.unwrapAll(self, e: Int) -> Int = self.p.ast.unwrapAll(e)

fn Lower.writtenArgs(self, e: Int) -> [Int] = self.p.ast.writtenArgs(e)

fn Lower.isLazyName(self, e: Int) -> Bool {
    let x = self.p.ast.exprs[e]
    x.node is Name(_) and x.binding >= 0 and self.p.bindings[x.binding].lazy
}

fn Lower.isBlockExpr(self, e: Int) -> Bool = e >= 0 and self.p.ast.exprs[e].node is BlockExpr(_, _)

fn Lower.blockOfExpr(self, e: Int) -> Int = match self.p.ast.exprs[e].node {
    BlockExpr(b, _) => b
    _ => -1
}

fn Lower.intOf(self, e: Int) -> Int = match self.p.ast.exprs[e].node {
    IntLit(v, _) => v
    BoolLit(v) => if v { 1 } else { 0 }
    _ => 0
}

// ---- types: slots and kinds (cached) ----
fn Lower.slots(var self, t: Int) -> Int {
    while len(self.slotCache) < len(self.p.types) {
        self.slotCache.push(-1)
        self.kindCache.push([])
    }
    if self.slotCache[t] < 0 {
        let n = self.p.slots(t)
        self.slotCache[t] = n
    }
    self.slotCache[t]
}

fn Lower.slotKinds(var self, t: Int) -> Bytes {
    let n = self.slots(t)
    if len(self.kindCache[t]) != n {
        let k = self.p.slotKinds(t).bytes()
        self.kindCache[t] = k
    }
    self.kindCache[t]
}

fn Lower.fieldSlots(var self, prm: Int) -> Int = if self.p.ast.params[prm].boxed {
    1
} else {
    self.slots(self.p.paramType(prm))
}

fn Lower.hasData(self, t: Int) -> Bool = self.p.hasData(t)

fn Lower.holdsContainers(self, t: Int) -> Bool = self.p.holdsContainers(t)

// a record's fields (param indices), an enum's cases' data
fn Lower.fields(self, t: Int) -> [Int] = self.p.ast.decls[self.p.types[t].decl].params

fn Lower.caseFields(self, d: Int, k: Int) -> [Int] = self.p.ast.decls[d].caseFields.get(k) ?? []

// ---- emitting ----
const powers = [1.0, 8.0, 64.0, 512.0, 4096.0, 32768.0]

fn Lower.newReg(var self, kind: Int) -> Int {
    self.cur.kinds.push(kind)
    self.cur.weight.push(0.0)
    len(self.cur.kinds) - 1
}

fn Lower.touch(var self, r: Int) {
    if r >= 0 {
        let w = powers[min(self.depth, 5)]
        self.cur.weight[r] += w
    }
}

fn Lower.kindOf(self, r: Int) -> Int = self.cur.kinds[r]

fn Lower.emit(var self, op: Op, dst: Int, a: Int, b: Int, imm: Int = 0, c: Int = -1, cond: Int = 0, line: Int = 0) {
    let _ = self.emitAt(op, dst, a, b, imm: imm, c: c, cond: cond, line: line)
}

// ... and where it is
fn Lower.emitAt(
    var self,
    op: Op,
    dst: Int,
    a: Int,
    b: Int,
    imm: Int = 0,
    c: Int = -1,
    cond: Int = 0,
    line: Int = 0,
) -> Int {
    self.touch(dst)
    self.touch(a)
    self.touch(b)
    self.cur.code.push(IrIns(op, cond: cond, dst: dst, a: a, b: b, c: c, imm: imm, line: line, inl: self.inl))
    len(self.cur.code) - 1
}

fn Lower.iconst(var self, v: Int) -> Int {
    let r = self.newReg('I')
    self.emit(.Const, r, -1, -1, imm: v)
    r
}

fn Lower.fconst(var self, v: Float) -> Int {
    let r = self.newReg('F')
    self.emit(.Const, r, -1, -1, imm: floatBits(v))
    r
}

fn Lower.op2(var self, op: Op, a: Int, b: Int, kind: Int) -> Int {
    let r = self.newReg(kind)
    self.emit(op, r, a, b)
    r
}

fn Lower.cmp(var self, cond: Int, a: Int, b: Int) -> Int {
    let r = self.newReg('I')
    let op = if self.cur.kinds[a] == 'F' { Op.Fcmp } else { Op.Cmp }
    self.emit(op, r, a, b, cond: cond)
    r
}

fn Lower.mov(var self, dst: Int, src: Int) {
    if dst != src {
        self.emit(.Mov, dst, src, -1)
    }
}

fn Lower.label(var self) -> Int {
    self.cur.labelCount += 1
    self.cur.labelCount - 1
}

fn Lower.place(var self, l: Int) {
    self.emit(.Label, -1, -1, -1, imm: l)
}

fn Lower.jmp(var self, l: Int) {
    self.emit(.Jmp, -1, -1, -1, imm: l)
}

fn Lower.jz(var self, r: Int, l: Int) {
    self.emit(.Jz, -1, r, -1, imm: l)
}

fn Lower.jnz(var self, r: Int, l: Int) {
    self.emit(.Jnz, -1, r, -1, imm: l)
}

fn Lower.valOf(var self, t: Int) -> [Int] {
    let kinds = self.slotKinds(t)
    var v: [Int] = []
    for k in kinds {
        v.push(self.newReg(k))
    }
    v
}

fn Lower.copyVal(var self, v: [Int]) -> [Int] {
    var c: [Int] = []
    for r in v {
        let n = self.newReg(self.cur.kinds[r])
        self.mov(n, r)
        c.push(n)
    }
    c
}

fn Lower.movVal(var self, dst: [Int], src: [Int]) {
    for i in 0..min(len(dst), len(src)) {
        if self.cur.kinds[dst[i]] == 'F' and self.cur.kinds[src[i]] == 'I' {
            self.emit(.IntToFloat, dst[i], src[i], -1)
        } else {
            self.mov(dst[i], src[i])
        }
    }
}

fn Lower.maxOut(var self, n: Int) {
    if n > self.cur.maxOut {
        self.cur.maxOut = n
    }
}

fn Lower.rtv(var self, id: Int, args: [Int], line: Int) {
    let _ = self.rtcall(id, args, 'V', line)
}

fn Lower.rtcall(var self, id: Int, args: [Int], ret: Int, line: Int) -> Int {
    let k = self.emitAt(.RtCall, -1, -1, -1, imm: id, line: line)
    for a in args {
        self.touch(a)
    }
    self.maxOut(len(args))
    if ret == 'V' {
        self.cur.setOperands(k, args, [])
        return -1
    }
    let r = self.newReg(ret)
    self.cur.setOperands(k, args, [r])
    self.touch(r)
    r
}

fn Lower.setRets(var self, k: Int, rets: [Int]) {
    self.cur.setRets(k, rets)
    for a in self.cur.argsOf(self.cur.code[k]) {
        self.touch(a)
    }
    for r in rets {
        self.touch(r)
    }
}

fn Lower.selfByAddress(var self, d: Int) -> Bool =
    not self.opts.debug
        and self.own.changesSelf(d)
        and self.slots(self.bt(self.pbind(self.dl(d).params[0]))) > selfInRegisters

fn Lower.bigRecord(var self, t: Int) -> Bool {
    if t < 0 or self.tk(t) != Kind.Record {
        return false
    }
    let d = self.tdecl(t)
    if d < 0 {
        return false
    }
    let x = self.p.ast.decls[d]
    not x.isExtern and not x.isInterface and not x.cStruct and self.slots(t) > byRefFrom
}

// parameter i of d comes by address (d is not a function kept as a value, nor one C calls)
fn Lower.paramByRef(var self, d: Int, i: Int) -> Bool {
    let x = self.p.ast.decls[d]
    if self.opts.debug
        or x.kind != DeclKind.Fn
        or x.isExtern
        or x.lifted
        or self.isCFunction(d)
        or self.asValue[x.index] {
        return false
    }
    if i == 0 and self.own.changesSelf(d) {
        return false
    }
    self.bigRecord(self.bt(self.pbind(x.params[i])))
}

// e names a record in memory, through fields in it (none boxed): its slots can be read where they are
fn Lower.memoryPlace(self, e: Int) -> Bool {
    var x = e
    while self.p.ast.exprs[x].node is Field(t, _) {
        let tt = self.ty(t)
        if self.p.ast.exprs[x].callee >= 0 or tt < 0 or self.tk(tt) != Kind.Record or self.tdecl(tt) < 0 {
            return false
        }
        let dd = self.p.ast.decls[self.tdecl(tt)]
        if dd.isInterface or dd.isExtern or dd.cStruct or self.boxed(dd.params[self.p.ast.exprs[x].caseIndex]) {
            return false
        }
        x = t
    }
    self.p.ast.exprs[x].node is Name(_)
        and self.p.ast.exprs[x].binding >= 0
        and self.atAddress[self.p.ast.exprs[x].binding]
}

// a value in registers, for a parameter that takes it by address: a copy in the area
fn Lower.refOf(var self, v: [Int]) -> [Int] {
    let area = self.areaTake(len(v))
    let z = self.iconst(0)
    self.storeSlots(area, z, 0, 0, v)
    [area]
}

fn Lower.isCFunction(self, d: Int) -> Bool {
    if d < 0 {
        return false
    }
    let x = self.p.ast.decls[d]
    x.kind == DeclKind.Fn and x.isExtern and x.body < 0
}

// Room for a value of slots in the function's area: made once, where the function starts.
fn Lower.areaTake(var self, slots: Int) -> Int {
    if self.areaAt < 0 {
        let n = self.iconst(slots) // (alloc takes the count in a register)
        return self.alloc(n, 8, 0)
    }
    if self.cur.code[self.areaAt].op == Op.Nop {
        let c0 = self.newReg('I')
        self.cur.code[self.areaAt] = IrIns(.Const, dst: c0, a: -1, b: -1, c: -1)
        let c1 = self.newReg('I')
        self.cur.code[self.areaAt + 1] = IrIns(.Const, dst: c1, a: -1, b: -1, c: -1, imm: 8)
        let area = self.newReg('I')
        self.areaReg = area
        self.cur.code[self.areaAt + 2] = IrIns(.RtCall, dst: -1, a: -1, b: -1, c: -1, imm: rtAlloc)
        self.cur.setOperands(self.areaAt + 2, [c0, c1], [area])
        self.touch(c0)
        self.touch(c1)
        self.touch(area)
        self.maxOut(2)
    }
    let at = self.areaSlots
    self.areaSlots += slots
    let n = self.areaSlots
    self.cur.code[self.areaAt].imm = n
    if at == 0 {
        return self.areaReg
    }
    let k = self.iconst(8 * at)
    self.op2(.Add, self.areaReg, k, 'I')
}

fn Lower.fuel(var self, line: Int) {
    if self.out.fuel {
        self.emit(.Fuel, -1, -1, -1, line: line)
    }
}

// bytes into the data, ended by a zero and padded to 8: where they are
fn Lower.dataBytes(var self, s: Bytes) -> Int {
    let at = len(self.data)
    self.data += s
    self.data.push(0)
    while len(self.data) % 8 != 0 {
        self.data.push(0)
    }
    at
}

fn Lower.dataText(var self, s: Text) -> Int {
    if self.texts[s] is Some(at) {
        return at
    }
    let at = self.dataBytes(s.bytes())
    self.texts[s] = at
    at
}

// An extern fn whose C symbol a pub extern fn of this program defines, with the same parameters and result: that
// function, called the Quark way (and inlined when small); else d.
fn Lower.boundExtern(var self, d: Int) -> Int {
    let x = self.dl(d)
    if not self.isCFunction(d) or x.externLib != "" or self.machineKind(d) != machineNone {
        return d
    }
    if not self.externDefsMade {
        self.externDefsMade = true
        for e in self.p.decls {
            let y = self.dl(e)
            if y.kind == DeclKind.Fn and y.isExtern and y.isPub and y.body >= 0 and not y.isTemplate {
                self.externDefs[if y.externSymbol != "" { y.externSymbol } else { y.name }] = e
            }
        }
    }
    let Some(impl) = self.externDefs[if x.externSymbol != "" { x.externSymbol } else { x.name }] else {
        return d
    }
    let y = self.dl(impl)
    if len(y.params) != len(x.params) or y.retType != x.retType {
        return d
    }
    for (i, prm) in x.params.enumerate() {
        if self.ptype(prm) != self.ptype(y.params[i]) {
            return d
        }
    }
    impl
}

fn Lower.dataAddress(var self, offset: Int) -> Int {
    let r = self.newReg('I')
    self.emit(.Const, r, -1, -1, imm: offset, c: 1)
    r
}

fn Lower.printLiteral(var self, s: Text) {
    let d = self.dataText(s)
    let a = self.dataAddress(d)
    let n = self.iconst(len(s))
    self.rtv(rtPrintText, [a, n], 0)
}

// the bytes of v (8, little-endian)
fn le64(v: Int) -> Bytes {
    var out: Bytes = []
    for i in 0..8 {
        out.push(v >> (8 * i) & 255)
    }
    out
}

// a Float's bits (C's memcpy of a double)
pub fn floatBits(f: Float) -> Int {
    if f != f {
        return 0x7FF8000000000000
    }
    let negative = f < 0.0 or f == 0.0 and 1.0 / f < 0.0
    let sign = if negative { minInt } else { 0 }
    var a = if negative { -f } else { f }
    if a == 0.0 {
        return sign
    }
    if a > 1.7976931348623157e308 {
        return sign | 0x7FF0000000000000
    }
    var e = 0
    while a >= 2.0 {
        a = a / 2.0
        e += 1
    }
    while a < 1.0 and e > -1022 {
        a = a * 2.0
        e -= 1
    }
    if a < 1.0 {
        // below the normal ones: a * 2^-1022, its mantissa a * 2^52
        return sign | toInt(a * 4503599627370496.0)
    }
    sign | (e + 1023) << 52 | toInt((a - 1.0) * 4503599627370496.0)
}

// ---- memory ----
fn Lower.elemBytes(var self, arrayType: Int) -> Int = self.slots(self.elemOf(arrayType)) * 8

fn Lower.loadElem(var self, arr: [Int], index: Int, elem: Int) -> [Int] {
    let v = self.valOf(elem)
    for j in 0..len(v) {
        self.emit(.Load, v[j], arr[0], index, imm: len(v) * 8, c: j * 8)
    }
    v
}

fn Lower.storeSlots(var self, base: Int, index: Int, stride: Int, offset: Int, v: [Int]) {
    for j in 0..len(v) {
        self.emit(.Store, v[j], base, index, imm: stride, c: offset + j * 8)
    }
}

fn Lower.bounds(var self, index: Int, n: Int, code: Int, line: Int) {
    self.emit(.Bounds, -1, index, n, imm: code, line: line)
}

// bytes, a size known here: counted, a block of its class taken here in the code (from the class's list of blocks
// given back, else the next of its page; their counts are 1 already), the runtime only when neither has one
fn Lower.allocFixed(var self, bytes: Int, line: Int) -> Int {
    let one = self.iconst(1)
    self.alloc(one, bytes, line)
}

fn Lower.alloc(var self, count: Int, bytesEach: Int, line: Int) -> Int {
    let n = self.constOf(count)
    if not self.opts.runtime and n >= 0 and bytesEach >= 0 and n * bytesEach > 0 and n * bytesEach < 65536 {
        return self.allocInline(n * bytesEach, count, line)
    }
    let b = self.iconst(bytesEach)
    self.rtcall(rtAlloc, [count, b], 'I', line)
}

// the value a register was given by a Const just before (the code being lowered, a few instructions back), or -1
fn Lower.constOf(self, r: Int) -> Int {
    var k = len(self.cur.code) - 1
    var seen = 0
    while k >= 0 and seen < 32 {
        let ins = self.cur.code[k]
        if ins.dst == r {
            return if ins.op == .Const and ins.c != 1 and ins.imm >= 0 {
                ins.imm
            } else {
                -1
            }
        }
        k -= 1
        seen += 1
    }
    -1
}

// bytes (known here, below 64 KB) from the arena, here in the code: the current block's room taken when it has it
// (the arena's memory is zeroed already), the runtime's alloc when not (a new block, a limit, no context). The words
// read are runtime/arena.qk's (ctxArena 5; aCurrent 1, aAllocated 4; a block's bSize 1, bUsed 2, bData 3).
fn Lower.allocInline(var self, bytes0: Int, count: Int, line: Int) -> Int {
    let bytes = (bytes0 + 15) / 16 * 16
    let r = self.newReg('I')
    if bytes == 0 {
        let one = self.iconst(1)
        let each = self.iconst(bytes0)
        let q = self.rtcall(rtAlloc, [count, each], 'I', line)
        self.mov(r, q)
        return r
    }
    let slow = self.label()
    let done = self.label()
    let cx = self.newReg('I')
    self.emit(.Ctx, cx, -1, -1)
    self.jz(cx, slow)
    let a = self.loadMem('I', cx, -1, 1, 8 * 5, mem64)
    let cur = self.loadMem('I', a, -1, 1, 8 * 1, mem64)
    self.jz(cur, slow)
    let used = self.loadMem('I', cur, -1, 1, 8 * 2, mem64)
    let size = self.loadMem('I', cur, -1, 1, 8 * 1, mem64)
    let k = self.iconst(bytes)
    let after = self.op2(.Add, used, k, 'I')
    let over = self.cmp(condGt, after, size)
    self.jnz(over, slow)
    self.storeMem(after, cur, -1, 1, 8 * 2, mem64)
    let made = self.loadMem('I', a, -1, 1, 8 * 4, mem64)
    let made2 = self.op2(.Add, made, k, 'I')
    self.storeMem(made2, a, -1, 1, 8 * 4, mem64)
    let data = self.loadMem('I', cur, -1, 1, 8 * 3, mem64)
    let p = self.op2(.Add, data, used, 'I')
    self.mov(r, p)
    self.jmp(done)
    self.place(slow)
    let each = self.iconst(bytes0)
    let one = self.iconst(1)
    let q = self.rtcall(rtAlloc, [one, each], 'I', line)
    self.mov(r, q)
    self.place(done)
    r
}

// The room the arena knows at address p (bytes; 0 none), found here in the code: runtime/arena.qk's growingRoom,
// the same hash (a logical shift is an arithmetic one masked) and the bucket's four entries. The words read are
// arena.qk's (ctxArena 5; aGrowing 5, aGrowingBits 6; a bucket: growingWays (address, bytes) pairs).
fn Lower.roomAt(var self, p: Int) -> Int {
    let room = self.newReg('I')
    let z = self.iconst(0)
    self.mov(room, z)
    let done = self.label()
    let cx = self.newReg('I')
    self.emit(.Ctx, cx, -1, -1)
    self.jz(cx, done)
    let a = self.loadMem('I', cx, -1, 1, 8 * 5, mem64)
    let k4 = self.iconst(4)
    let h0 = self.op2(.Sar, p, k4, 'I')
    let k17 = self.iconst(17)
    let h1 = self.op2(.Sar, h0, k17, 'I')
    let h2 = self.op2(.Xor, h0, h1, 'I')
    let mixer = self.iconst(-7046029254386353131)
    let h = self.op2(.Mul, h2, mixer, 'I')
    let bits = self.loadMem('I', a, -1, 1, 8 * 6, mem64)
    let k64 = self.iconst(64)
    let shift = self.op2(.Sub, k64, bits, 'I')
    let top = self.op2(.Sar, h, shift, 'I')
    let one = self.iconst(1)
    let span = self.op2(.Shl, one, bits, 'I')
    let mask = self.op2(.Sub, span, one, 'I')
    let index = self.op2(.And, top, mask, 'I')
    let k6 = self.iconst(6)
    let offset = self.op2(.Shl, index, k6, 'I') // growingWays * 16 bytes a bucket
    let table = self.loadMem('I', a, -1, 1, 8 * 5, mem64)
    let bucket = self.op2(.Add, table, offset, 'I')
    for i in 0..4 {
        let next = self.label()
        let at = self.loadMem('I', bucket, -1, 1, 16 * i, mem64)
        let same = self.cmp(condEq, at, p)
        self.jz(same, next)
        let r = self.loadMem('I', bucket, -1, 1, 16 * i + 8, mem64)
        self.mov(room, r)
        self.jmp(done)
        self.place(next)
    }
    self.place(done)
    room
}

// xs.push's array (p, n): p when its room holds one more of bytes (found here in the code), else the runtime's push
// (it moves to twice the room). growth: the var whose push it is (its loop's check: Growth), -1 none.
fn Lower.pushRoom(var self, p: Int, n: Int, bytes: Int, growth: Int, line: Int) -> Int {
    let kb = self.iconst(bytes)
    if self.opts.runtime {
        let q = self.rtcall(rtPush, [p, n, kb], 'I', line)
        if growth >= 0 {
            self.growths.push(Growth(self.fnId, len(self.cur.code) - 1, growth))
        }
        return q
    }
    let r = self.newReg('I')
    let slow = self.label()
    let done = self.label()
    self.jz(p, slow)
    let room = self.roomAt(p)
    let one = self.iconst(1)
    let more = self.op2(.Add, n, one, 'I')
    let need = self.op2(.Mul, more, kb, 'I')
    let over = self.cmp(condGt, need, room)
    self.jnz(over, slow)
    self.mov(r, p)
    self.jmp(done)
    self.place(slow)
    let q = self.rtcall(rtPush, [p, n, kb], 'I', line)
    if growth >= 0 {
        self.growths.push(Growth(self.fnId, len(self.cur.code) - 1, growth))
    }
    self.mov(r, q)
    self.place(done)
    r
}

// 1 when byte c is a space between words (' ', a tab, a new line, a carriage return), else 0: a byte above ' ' (most
// of them) by one test
fn Lower.spaceTest(var self, c: Int) -> Int {
    let r = self.newReg('I')
    let z = self.iconst(0)
    self.mov(r, z)
    let no = self.label()
    let k32 = self.iconst(32)
    let above = self.cmp(condGt, c, k32)
    self.jnz(above, no)
    let sp = self.cmp(condEq, c, k32)
    let k9 = self.iconst(9)
    let tab = self.cmp(condEq, c, k9)
    let k10 = self.iconst(10)
    let nl = self.cmp(condEq, c, k10)
    let k13 = self.iconst(13)
    let cr = self.cmp(condEq, c, k13)
    let a = self.op2(.Or, sp, tab, 'I')
    let b = self.op2(.Or, nl, cr, 'I')
    let any = self.op2(.Or, a, b, 'I')
    self.mov(r, any)
    self.place(no)
    r
}

fn Lower.loadByte(var self, base: Int, index: Int) -> Int {
    let r = self.newReg('I')
    self.emit(.Load, r, base, index, imm: 1, c: 0, cond: 1)
    r
}

fn Lower.storeByte(var self, v: Int, base: Int, index: Int) {
    self.emit(.Store, v, base, index, imm: 1, c: 0, cond: 1)
}

fn Lower.copyArray(var self, arr: [Int], bytesEach: Int, line: Int) -> [Int] {
    let b = self.iconst(bytesEach)
    let c0 = self.rtcall(rtCopy, [arr[0], arr[1], b], 'I', line)
    let c1 = self.newReg('I')
    self.mov(c1, arr[1])
    [c0, c1]
}

fn Lower.copyMap(var self, m: [Int], line: Int) -> [Int] =
    [self.rtcall(rtMapCopy, [m[0]], 'I', line)]

fn Lower.copyOf(var self, v: [Int], t: Int, line: Int) -> [Int] {
    if self.tk(t) == Kind.Map {
        return self.copyMap(v, line)
    }
    let b = self.elemBytes(t)
    self.copyArray(v, b, line)
}

// ---- names' registers ----
fn Lower.regsOf(var self, b: Int) -> [Int] {
    let n = self.slots(self.bt(b))
    let r = self.regs[b]
    if len(r) > n { r[..n] } else { r }
}

fn Lower.bind(var self, b: Int, r: [Int]) {
    if b >= 0 {
        self.regs[b] = r
        self.bound[b] = true
    }
}

// a name's value (C's lowerExpr of an E_NAME with this binding)
fn Lower.nameValue(var self, b: Int, line: Int) -> [Int] {
    let x = self.p.bindings[b]
    if x.lazy {
        return self.materialize(x.init, self.elemOf(x.ty), line)
    }
    if self.atAddress[b] {
        return self.loadSlots(self.addrReg[b], x.ty)
    }
    self.regsOf(b)
}

// ... kept (C's lowerStored of a name made by the lowering, line 0)
fn Lower.nameStored(var self, b: Int) -> [Int] {
    let v = self.nameValue(b, 0)
    let t = self.bt(b)
    if self.holdsContainers(t) and self.own.nameAliasesDeep(b) {
        return self.deepCopy(v, t, 0)
    }
    let x = self.p.bindings[b]
    if self.tk(t) is Array | Map and (x.mutable or x.isParam) {
        return self.copyOf(v, t, 0)
    }
    v
}

// A function kept as a value: its address, and the address of the values it captured (0: none).
fn Lower.fnAddress(var self, d: Int) -> [Int] {
    let a = self.newReg('I')
    self.emit(.Const, a, -1, -1, imm: self.fnIndex[self.dl(d).index], c: 2)
    let x = self.dl(d)
    if len(x.captureOuter) == 0 {
        let z = self.newReg('I')
        self.emit(.Const, z, -1, -1)
        return [a, z]
    }
    var slots = 0
    var desc: Bytes = []
    for o in x.captureOuter {
        slots += self.slots(self.bt(o))
        desc += self.typeDesc(self.bt(o))
    }
    let count = self.newReg('I')
    self.emit(.Const, count, -1, -1, imm: 1)
    let env = self.alloc(count, 8 * (slots + 1), x.line)
    let zero = self.newReg('I')
    self.emit(.Const, zero, -1, -1)
    let dd = self.dataBytes(desc)
    let da = self.dataAddress(dd)
    self.storeSlots(env, zero, 8, 0, [da])
    var at = 8
    for o in x.captureOuter {
        let v = self.nameStored(o)
        self.storeSlots(env, zero, 8, at, v)
        at += 8 * len(v)
    }
    [a, env]
}

fn Lower.stripImplicit(self, e: Int) -> Int {
    var x = e
    while self.p.ast.exprs[x].implicit
        and self.p.ast.exprs[x].builtin == bToArray
        and self.p.ast.exprs[x].node is Call(_, _, _, _, _, _) {
        x = self.argsOf(x)[0]
    }
    x
}

fn Lower.lowerStored(var self, e: Int) -> [Int] {
    let v = self.lowerExpr(e)
    let t = self.ty(e)
    if self.holdsContainers(t) and self.own.aliasesDeep(e) {
        return self.deepCopy(v, t, self.lineOf(e))
    }
    if self.own.needsCopy(e) and not self.own.takes[e] {
        return self.copyOf(v, t, self.lineOf(e))
    }
    v
}

fn Lower.lowerOwned(var self, e: Int, deep: Bool) -> [Int] {
    let t = self.ty(e)
    if (deep or self.own.aliasesDeep(e)) and self.holdsContainers(t) {
        if self.own.constructs(e) and not self.own.deepFresh(e) {
            return self.construct(e, true) // each field its own, not the whole value copied after
        }
        let v = self.lowerExpr(e)
        return if self.own.deepFresh(e) {
            v
        } else {
            self.deepCopy(v, t, self.lineOf(e))
        }
    }
    let v = self.lowerExpr(e)
    if self.tk(t) is Array | Map and not self.own.isFresh(e) and not self.own.isJoin(e) and not self.own.takes[e] {
        return self.copyOf(v, t, self.lineOf(e))
    }
    v
}

fn Lower.lowerInto(var self, e: Int, root: Int) -> [Int] {
    if root >= 0 and self.p.bindings[root].deep {
        return self.lowerOwned(e, true)
    }
    self.lowerStored(e)
}

// Is the chain from e down to its source maps only (so its length is the source's)? -1: no
fn Lower.exactSource(self, e: Int) -> Int {
    let s = self.stripImplicit(e)
    let x = self.p.ast.exprs[s]
    if x.node is Name(_) and x.binding >= 0 and self.p.bindings[x.binding].lazy {
        return self.exactSource(self.p.bindings[x.binding].init)
    }
    if x.node is Call(_, _, _, _, _, _) and x.builtin is 24 | 92 {
        return self.exactSource(self.arg(s, 0))
    }
    if x.node is Call(_, _, _, _, _, _) and x.builtin is 25 | 81 | 82 | 91 {
        return -1
    }
    s
}

fn Lower.materialize(var self, src: Int, elem: Int, line: Int) -> [Int] {
    let bytes = self.slots(elem) * 8
    let source = self.exactSource(src)
    var ptr = 0
    var n = 0
    var cap = 0
    var exact = false
    if source >= 0 and self.p.ast.exprs[source].node is Range(lo, hi) {
        let a = self.lowerExpr(lo)[0]
        let b = self.lowerExpr(hi)[0]
        self.preRange = source
        let pa = self.newReg('I')
        self.preA = pa
        let pb = self.newReg('I')
        self.preB = pb
        self.mov(pa, a)
        self.mov(pb, b)
        n = self.op2(.Sub, pb, pa, 'I')
        let z = self.iconst(0)
        let neg = self.cmp(condLt, n, z)
        let fine = self.label()
        self.jz(neg, fine)
        let z2 = self.iconst(0)
        self.mov(n, z2)
        self.place(fine)
        exact = true
        ptr = self.alloc(n, bytes, line)
    } else if source >= 0 and self.ek(source) is Array | Bytes {
        let arr = self.lowerExpr(source)
        self.preArray = source
        let c = self.copyVal(arr)
        self.preArrayVal = c
        exact = true
        n = c[1]
        ptr = self.alloc(n, bytes, line)
    } else {
        n = self.iconst(0)
        cap = self.iconst(8)
        ptr = self.alloc(cap, bytes, line)
    }
    self.forEach(src, .Collect(ptr, n, cap, bytes, exact, line, elem))
    let r1 = self.newReg('I')
    self.mov(r1, n)
    [ptr, r1]
}

fn Lower.bytesOf(var self, src: Int, line: Int) -> [Int] {
    if self.p.ast.exprs[src].node is ArrayLit(items) {
        let n = self.iconst(len(items))
        let ptr = self.alloc(n, 1, line)
        for (i, item) in items.enumerate() {
            let v = self.lowerExpr(item)[0]
            if not self.p.ast.exprs[item].node is IntLit(_, _) {
                let k = self.iconst(256)
                let l = self.lineOf(item)
                self.bounds(v, k, panicByte, if l != 0 { l } else { line })
            }
            let at = self.iconst(i)
            self.storeByte(v, ptr, at)
        }
        return [ptr, n]
    }
    let ptr = self.newReg('I')
    let n = self.newReg('I')
    let cap = self.newReg('I')
    let z = self.iconst(0)
    self.mov(n, z)
    let s = self.iconst(16)
    self.mov(cap, s)
    let a = self.alloc(cap, 1, line)
    self.mov(ptr, a)
    self.forEach(src, .ByteBuild(ptr, n, cap, line))
    [ptr, n]
}

// ---- consumers: what a loop does with each element ----
fn Lower.bindLambda(var self, lam: Int, vals: [[Int]]) {
    let x = self.p.ast.exprs[lam]
    let Lambda(params, _) = x.node else {
        return
    }
    if x.spread >= 0 and len(vals) >= 1 {
        let d = self.tdecl(x.spread)
        for (i, prm) in params.enumerate() {
            let off = self.recordOffset(d, i)
            self.bind(self.pbind(prm), vals[0][off..])
        }
        return
    }
    for (i, prm) in params.enumerate() {
        if i < len(vals) {
            self.bind(self.pbind(prm), vals[i])
        }
    }
}

fn Lower.lambdaBody(self, lam: Int) -> Int = match self.p.ast.exprs[lam].node {
    Lambda(_, body) => body
    _ => -1
}

fn Lower.sink(var self, sk: Sink, elem: [Int], index: Int) {
    match sk {
        Collect(ptr, n, cap, bytes, exact, line, ty) => {
            if exact {
                self.storeSlots(ptr, index, bytes, 0, elem)
                return
            }
            let full = self.cmp(condEq, n, cap)
            let ok = self.label()
            self.jz(full, ok)
            let newCap = self.op2(.Add, cap, cap, 'I')
            let b = self.iconst(bytes)
            let grown = self.rtcall(rtGrow, [ptr, cap, newCap, b], 'I', line)
            self.mov(ptr, grown)
            self.mov(cap, newCap)
            self.place(ok)
            self.storeSlots(ptr, n, bytes, 0, elem)
            let one = self.iconst(1)
            self.emit(.Add, n, n, one)
        }
        ByteBuild(ptr, n, cap, line) => {
            let k = self.iconst(256)
            self.bounds(elem[0], k, panicByte, line)
            let ok = self.label()
            let full = self.cmp(condEq, n, cap)
            self.jz(full, ok)
            let newCap = self.op2(.Add, cap, cap, 'I')
            let one = self.iconst(1)
            let grown = self.rtcall(rtGrow, [ptr, cap, newCap, one], 'I', line)
            self.mov(ptr, grown)
            self.mov(cap, newCap)
            self.place(ok)
            self.storeByte(elem[0], ptr, n)
            let one2 = self.iconst(1)
            self.emit(.Add, n, n, one2)
        }
        Mean(acc, has) => {
            var x = elem[0]
            if self.cur.kinds[x] != 'F' {
                x = self.op2(.IntToFloat, x, -1, 'F')
            }
            self.emit(.Fadd, acc, acc, x)
            let one = self.iconst(1)
            self.emit(.Add, has, has, one)
        }
        CountBy(acc, key, lambda, line) => {
            self.bindLambda(lambda, [elem])
            let kv = self.lowerExpr(self.lambdaBody(lambda))
            let k = self.copyVal(kv)
            let ka = self.keyArgs(k, key)
            let p = self.mapLookup(acc, ka, key, line)
            let fresh = self.label()
            let done = self.label()
            self.jz(p, fresh)
            let n = self.newReg('I')
            let z = self.iconst(0)
            self.emit(.Load, n, p, z, imm: 8, c: 0)
            let one = self.iconst(1)
            self.emit(.Add, n, n, one)
            let z2 = self.iconst(0)
            self.storeSlots(p, z2, 0, 0, [n])
            self.jmp(done)
            self.place(fresh)
            let one2 = self.iconst(1)
            self.mapSet([acc], k, key, [one2], line)
            self.place(done)
        }
        ToSet(acc, key, line) => {
            let k = self.copyVal(elem)
            self.mapSet([acc], k, key, [], line)
        }
        Sum(acc, line) => {
            for i in 0..len(acc) {
                if self.cur.kinds[acc[i]] == 'F' {
                    self.emit(.Fadd, acc[i], acc[i], elem[i])
                } else {
                    self.emit(.Add, acc[i], acc[i], elem[i], line: line, cond: 1) // past the limits: a panic
                }
            }
        }
        Count(acc) => {
            let one = self.iconst(1)
            self.emit(.Add, acc, acc, one)
        }
        Fold(acc, lambda) => {
            self.bindLambda(lambda, [acc, elem])
            let v = self.lowerExpr(self.lambdaBody(lambda))
            let fresh = self.copyVal(v)
            self.movVal(acc, fresh)
        }
        AnyOf(acc, lambda, all) => {
            self.bindLambda(lambda, [elem, [index]])
            let t = self.lowerExpr(self.lambdaBody(lambda))[0]
            if all {
                self.jnz(t, self.loopContinue)
                let z = self.iconst(0)
                self.mov(acc, z)
            } else {
                self.jz(t, self.loopContinue)
                let one = self.iconst(1)
                self.mov(acc, one)
            }
            self.jmp(self.loopBreak)
        }
        Extreme(acc, has, isMax) => {
            let compare = self.label()
            let done = self.label()
            self.jnz(has, compare)
            self.mov(acc, elem[0])
            let one = self.iconst(1)
            self.mov(has, one)
            self.jmp(done)
            self.place(compare)
            if self.cur.kinds[acc] == 'F' {
                self.emit(if isMax { Op.Fmax } else { Op.Fmin }, acc, acc, elem[0])
            } else {
                let better = self.cmp(if isMax { condGt } else { condLt }, elem[0], acc)
                self.jz(better, done)
                self.mov(acc, elem[0])
            }
            self.place(done)
        }
        MapThrough(lambda, inner) => {
            self.bindLambda(lambda, [elem, [index]])
            let v = self.lowerExpr(self.lambdaBody(lambda))
            self.sink(inner, v, index)
        }
        FilterThrough(lambda, counter, inner) => {
            self.bindLambda(lambda, [elem, [index]])
            let keep = self.lowerExpr(self.lambdaBody(lambda))[0]
            self.jz(keep, self.loopContinue)
            let at = self.newReg('I')
            self.mov(at, counter)
            let one = self.iconst(1)
            self.emit(.Add, counter, counter, one)
            self.sink(inner, elem, at)
        }
        TakeThrough(counter, limit, inner) => {
            let c1 = self.cmp(condGe, counter, limit)
            self.jnz(c1, self.loopBreak)
            let at = self.newReg('I')
            self.mov(at, counter)
            let one = self.iconst(1)
            self.emit(.Add, counter, counter, one)
            let after = self.label()
            let savedContinue = self.loopContinue
            self.loopContinue = after
            self.sink(inner, elem, at)
            self.loopContinue = savedContinue
            self.place(after)
            let c2 = self.cmp(condGe, counter, limit)
            self.jnz(c2, self.loopBreak)
        }
        SkipThrough(counter, limit, inner) => {
            let keep = self.label()
            let c1 = self.cmp(condGe, counter, limit)
            self.jnz(c1, keep)
            let one = self.iconst(1)
            self.emit(.Add, counter, counter, one)
            self.jmp(self.loopContinue)
            self.place(keep)
            let at = self.op2(.Sub, counter, limit, 'I')
            let one2 = self.iconst(1)
            self.emit(.Add, counter, counter, one2)
            self.sink(inner, elem, at)
        }
        EnumerateThrough(counter, inner) => {
            let at = self.newReg('I')
            self.mov(at, counter)
            let one = self.iconst(1)
            self.emit(.Add, counter, counter, one)
            self.sink(inner, [at] + elem, index)
        }
        Searching(s) => self.searchSink(s, elem, index)
        ForBody(stmt, memory) => self.forSink(stmt, memory, elem)
        PrintElem(t) => {
            let skip = self.label()
            self.jz(index, skip)
            self.printLiteral(", ")
            self.place(skip)
            self.printVal(elem, t)
        }
        DumpElem(t) => self.dumpVal(elem, t)
    }
}

fn Lower.entrySink(var self, s: EntrySink, key: [Int], value: [Int]) {
    match s {
        EntryTuple(counter, inner) => {
            let at = self.newReg('I')
            self.mov(at, counter)
            let one = self.iconst(1)
            self.emit(.Add, counter, counter, one)
            self.sink(inner, key + value, at)
        }
        DumpEntry(t) => {
            self.dumpVal(key, self.keyOf(t))
            if not self.p.isSet(t) {
                self.dumpVal(value, self.elemOf(t))
            }
        }
        PrintEntry(t, first) => {
            let skip = self.label()
            self.jnz(first, skip)
            self.printLiteral(", ")
            self.place(skip)
            let z = self.iconst(0)
            self.mov(first, z)
            self.printVal(key, self.keyOf(t))
            if self.p.isSet(t) {
                return
            }
            self.printLiteral(": ")
            self.printVal(value, self.elemOf(t))
        }
        SetOpEntry(out, other, union, both, line, keyType) => {
            if union {
                self.mapSet([out], key, keyType, [], line)
                return
            }
            let ka = self.keyArgs(key, keyType)
            let p = self.mapLookup(other, ka, keyType, line)
            let skip = self.label()
            if both { self.jz(p, skip) } else { self.jnz(p, skip) }
            self.mapSet([out], key, keyType, [], line)
            self.place(skip)
        }
        ForEntry(stmt, memory) => self.forEntrySink(stmt, memory, key)
    }
}

fn Lower.zeroOf(var self, t: Int) -> [Int] {
    let v = self.valOf(t)
    for r in v {
        let z = if self.cur.kinds[r] == 'F' {
            self.fconst(0.0)
        } else {
            self.iconst(0)
        }
        self.mov(r, z)
    }
    v
}

// ---- loops: sources and the code inside them ----
fn Lower.loopFrame(var self, brk: Int, cont: Int) -> (Int, Int) {
    let saved = (self.loopBreak, self.loopContinue)
    self.loopBreak = brk
    self.loopContinue = cont
    saved
}

fn Lower.forEach(var self, from: Int, sink: Sink) {
    self.branchDepth += 1
    self.forEachInner(from, sink)
    self.branchDepth -= 1
}

fn Lower.forEachInner(var self, from: Int, sink: Sink) {
    let src = self.stripImplicit(from)
    let x = self.p.ast.exprs[src]
    if x.node is Name(_) and x.binding >= 0 and self.p.bindings[x.binding].lazy {
        self.forEach(self.p.bindings[x.binding].init, sink)
        return
    }
    let isCall = x.node is Call(_, _, _, _, _, _)
    if isCall and x.builtin == bMap {
        self.forEach(self.arg(src, 0), .MapThrough(self.arg(src, 1), sink))
        return
    }
    if isCall and x.builtin == bFilter {
        let c = self.iconst(0)
        self.forEach(self.arg(src, 0), .FilterThrough(self.arg(src, 1), c, sink))
        return
    }
    if isCall and x.builtin == bEnumerate {
        let c = self.newReg('I')
        let z = self.iconst(0)
        self.mov(c, z)
        self.forEach(self.arg(src, 0), .EnumerateThrough(c, sink))
        return
    }
    if isCall and x.builtin is 81 | 82 {
        let counter = self.newReg('I')
        let limit = self.newReg('I')
        let z = self.iconst(0)
        self.mov(counter, z)
        let l = self.lowerExpr(self.arg(src, 1))[0]
        self.mov(limit, l)
        let fine = self.label()
        let z2 = self.iconst(0)
        let neg = self.cmp(condLt, limit, z2)
        self.jz(neg, fine)
        let z3 = self.iconst(0)
        self.mov(limit, z3)
        self.place(fine)
        let done = self.label()
        let take = x.builtin == bTake
        if take {
            self.jz(limit, done)
            self.forEach(self.arg(src, 0), .TakeThrough(counter, limit, sink))
            self.place(done)
        } else {
            self.forEach(self.arg(src, 0), .SkipThrough(counter, limit, sink))
        }
        return
    }
    if isCall and x.builtin == bEntries {
        let c = self.newReg('I')
        let z = self.iconst(0)
        self.mov(c, z)
        let m0 = self.arg(src, 0)
        var m: [Int] = []
        if self.preArray == m0 {
            m = self.preArrayVal
            self.preArray = -1
        } else {
            m = self.lowerExpr(m0)
        }
        self.forEachEntry(m, self.ty(m0), .EntryTuple(c, sink), x.line)
        return
    }
    let top = self.label()
    let next = self.label()
    let done = self.label()
    if isCall and x.builtin == bWords {
        // a text's words, each handed on as it is found: no array of them made (runtime/text.qk's splitText: a space
        // is ' ', a tab, a new line or a carriage return; a word, the bytes between)
        var t: [Int] = []
        if self.preText == src {
            t = self.preTextVal
            self.preText = -1
        } else {
            let tv = self.lowerExpr(self.arg(src, 0))
            t = self.copyVal(tv)
        }
        let at = self.newReg('I')
        let start = self.newReg('I')
        let index = self.newReg('I')
        let z = self.iconst(0)
        self.mov(at, z)
        let z2 = self.iconst(0)
        self.mov(index, z2)
        let skip = self.label()
        let scan = self.label()
        let ended = self.label()
        self.depth += 1
        self.jmp(skip)
        // at a word's first byte
        self.place(top)
        self.fuel(x.line)
        self.mov(start, at)
        self.place(scan)
        let one = self.iconst(1)
        self.emit(.Add, at, at, one)
        let inText = self.cmp(condLt, at, t[1])
        self.jz(inText, ended)
        let c = self.loadByte(t[0], at)
        self.jz(self.spaceTest(c), scan)
        self.place(ended)
        let wordAt = self.op2(.Add, t[0], start, 'I')
        let wordLen = self.op2(.Sub, at, start, 'I')
        let saved = self.loopFrame(done, next)
        self.sink(sink, [wordAt, wordLen], index)
        self.loopBreak = saved.0
        self.loopContinue = saved.1
        self.place(next)
        let one2 = self.iconst(1)
        self.emit(.Add, index, index, one2)
        // the spaces before the next word
        self.place(skip)
        let more = self.cmp(condLt, at, t[1])
        self.jz(more, done)
        let c2 = self.loadByte(t[0], at)
        self.jz(self.spaceTest(c2), top)
        let one3 = self.iconst(1)
        self.emit(.Add, at, at, one3)
        self.jmp(skip)
        self.depth -= 1
        self.place(done)
        return
    }
    if isCall and x.builtin == bCodePoints {
        var t: [Int] = []
        if self.preText == src {
            t = self.preTextVal
            self.preText = -1
        } else {
            let tv = self.lowerExpr(self.arg(src, 0))
            t = self.copyVal(tv)
        }
        let at = self.newReg('I')
        let index = self.newReg('I')
        let n = self.newReg('I')
        let cp = self.newReg('I')
        let z = self.iconst(0)
        self.mov(at, z)
        let z2 = self.iconst(0)
        self.mov(index, z2)
        let test = self.label()
        let one1 = self.label()
        let more = self.label()
        let decoded = self.label()
        self.depth += 1
        self.jmp(test)
        self.place(top)
        self.fuel(x.line)
        let c = self.loadByte(t[0], at)
        self.mov(cp, c)
        let k1 = self.iconst(1)
        self.mov(n, k1)
        let kc0 = self.iconst(0xC0)
        let lt = self.cmp(condLt, c, kc0)
        self.jnz(lt, one1)
        let kf0 = self.iconst(0xF0)
        let ge4 = self.cmp(condGe, c, kf0)
        let ke0 = self.iconst(0xE0)
        let ge3 = self.cmp(condGe, c, ke0)
        let sum = self.op2(.Add, ge3, ge4, 'I')
        let two = self.iconst(2)
        let lead = self.op2(.Add, two, sum, 'I')
        self.mov(n, lead)
        let k7f = self.iconst(0x7F)
        let mask = self.op2(.Sar, k7f, n, 'I')
        let bits = self.op2(.And, c, mask, 'I')
        self.mov(cp, bits)
        let k = self.newReg('I')
        let k1b = self.iconst(1)
        self.mov(k, k1b)
        self.place(more)
        let pos = self.op2(.Add, at, k, 'I')
        let b = self.loadByte(t[0], pos)
        let k3f = self.iconst(0x3F)
        let low = self.op2(.And, b, k3f, 'I')
        let k6 = self.iconst(6)
        let shifted = self.op2(.Shl, cp, k6, 'I')
        let joined = self.op2(.Or, shifted, low, 'I')
        self.mov(cp, joined)
        let k1c = self.iconst(1)
        self.emit(.Add, k, k, k1c)
        let again = self.cmp(condLt, k, n)
        self.jnz(again, more)
        self.jmp(decoded)
        self.place(one1)
        self.place(decoded)
        let saved = self.loopFrame(done, next)
        self.sink(sink, [cp], index)
        self.loopBreak = saved.0
        self.loopContinue = saved.1
        self.place(next)
        self.emit(.Add, at, at, n)
        let k1d = self.iconst(1)
        self.emit(.Add, index, index, k1d)
        self.place(test)
        let more2 = self.cmp(condLt, at, t[1])
        self.jnz(more2, top)
        self.depth -= 1
        self.place(done)
        return
    }
    if x.node is Range(lo, hi) {
        var i = 0
        var end = 0
        if self.preRange == src {
            i = self.preA
            end = self.preB
            self.preRange = -1
        } else {
            let a = self.lowerExpr(lo)[0]
            let b = self.lowerExpr(hi)[0]
            i = self.newReg('I')
            end = self.newReg('I')
            self.mov(i, a)
            self.mov(end, b)
        }
        let index = self.iconst(0)
        let test = self.label()
        self.depth += 1
        self.jmp(test)
        self.place(top)
        self.fuel(x.line)
        let saved = self.loopFrame(done, next)
        self.sink(sink, [i], index)
        self.loopBreak = saved.0
        self.loopContinue = saved.1
        self.place(next)
        let k1 = self.iconst(1)
        self.emit(.Add, i, i, k1)
        self.emit(.Add, index, index, k1)
        self.place(test)
        let more = self.cmp(condLt, i, end)
        self.jnz(more, top)
        self.depth -= 1
        self.place(done)
        return
    }
    if x.node is Name(_) and x.binding < 0 and x.decl >= 0 and self.constTexts(x.decl) >= 0 {
        // a constant array of texts: each read from its table in the data, no array made for it
        let table = self.dataAddress(self.constTextAt[x.decl] ?? 0)
        let count = self.iconst(self.constTextCount(x.decl))
        let k = self.newReg('I')
        let z = self.iconst(0)
        self.mov(k, z)
        let test = self.label()
        self.depth += 1
        self.jmp(test)
        self.place(top)
        self.fuel(x.line)
        let off = self.newReg('I')
        self.emit(.Load, off, table, k, imm: 16, c: 0)
        let size = self.newReg('I')
        self.emit(.Load, size, table, k, imm: 16, c: 8)
        let data = self.dataAddress(0)
        let at = self.op2(.Add, data, off, 'I')
        let saved = self.loopFrame(done, next)
        self.sink(sink, [at, size], k)
        self.loopBreak = saved.0
        self.loopContinue = saved.1
        self.place(next)
        let one = self.iconst(1)
        self.emit(.Add, k, k, one)
        self.place(test)
        let more = self.cmp(condLt, k, count)
        self.jnz(more, top)
        self.depth -= 1
        self.place(done)
        return
    }
    // an array
    var arr: [Int] = []
    if self.preArray == src {
        arr = self.preArrayVal
        self.preArray = -1
    } else {
        let v = self.lowerExpr(src)
        arr = self.copyVal(v)
    }
    let k = self.iconst(0)
    let test = self.label()
    self.depth += 1
    self.jmp(test)
    self.place(top)
    self.fuel(x.line)
    let elem = if self.tk(x.ty) == Kind.Bytes {
        [self.loadByte(arr[0], k)]
    } else {
        self.loadElem(arr, k, self.elemOf(x.ty))
    }
    let saved = self.loopFrame(done, next)
    self.sink(sink, elem, k)
    self.loopBreak = saved.0
    self.loopContinue = saved.1
    self.place(next)
    let k1 = self.iconst(1)
    self.emit(.Add, k, k, k1)
    self.place(test)
    let more = self.cmp(condLt, k, arr[1])
    self.jnz(more, top)
    self.depth -= 1
    self.place(done)
}

// ---- enums with data ----
// where case k's data starts (types.qk's caseLayout: the cases share slots)
fn Lower.caseOffset(var self, d: Int, k: Int) -> Int {
    if not self.caseStarts.contains(d) {
        self.caseStarts[d] = self.p.caseLayout(d).starts
    }
    (self.caseStarts[d] ?? []).get(k) ?? 1
}

fn Lower.fieldOffset(var self, d: Int, k: Int, field: Int) -> Int {
    var at = self.caseOffset(d, k)
    let fs = self.caseFields(d, k)
    for f in 0..field {
        at += self.fieldSlots(fs[f])
    }
    at
}

fn Lower.recordOffset(var self, d: Int, field: Int) -> Int {
    var at = 0
    let ps = self.dl(d).params
    for f in 0..field {
        at += self.fieldSlots(ps[f])
    }
    at
}

// The boxes every value of a case without data shares: one per case, its tag first. Offset in the data.
fn Lower.sharedBoxes(var self, t: Int, slots: Int) -> Int {
    for (ty, at) in self.shared {
        if ty == t {
            return at
        }
    }
    let n = len(self.dl(self.tdecl(t)).cases)
    var table: Bytes = []
    for k in 0..n * slots {
        table += le64(if k % slots == 0 { k / slots } else { 0 })
    }
    let at = self.dataBytes(table)
    if len(self.shared) < 64 {
        self.shared.push((t, at))
    }
    at
}

// A boxed field's value: its slots copied into the arena; a case without data takes its shared box.
fn Lower.boxVal(var self, v: [Int], t: Int, line: Int) -> [Int] {
    let out = self.newReg('I')
    let done = self.label()
    if t >= 0 and self.tk(t) == Kind.Enum and self.hasData(t) {
        let d = self.tdecl(t)
        var table = -1
        for k in 0..len(self.dl(d).cases) {
            if len(self.caseFields(d, k)) > 0 {
                continue
            }
            if table < 0 {
                table = self.sharedBoxes(t, len(v))
            }
            let other = self.label()
            let kk = self.iconst(k)
            let same = self.cmp(condEq, v[0], kk)
            self.jz(same, other)
            let off = self.iconst(8 * k * len(v))
            let base = self.dataAddress(table)
            let addr = self.op2(.Add, base, off, 'I')
            self.mov(out, addr)
            self.jmp(done)
            self.place(other)
        }
    }
    let ptr = self.allocFixed(len(v) * 8, line)
    let z = self.iconst(0)
    self.storeSlots(ptr, z, 8, 0, v)
    self.mov(out, ptr)
    self.place(done)
    [out]
}

fn Lower.fieldVal(var self, prm: Int, slots: [Int]) -> [Int] {
    let t = self.ptype(prm)
    if self.boxed(prm) {
        return self.loadSlots(slots[0], t)
    }
    let n = self.slots(t)
    slots[..n]
}

fn Lower.setField(var self, prm: Int, slots: [Int], v: [Int], line: Int) {
    let n = self.fieldSlots(prm)
    let part = slots[..n]
    if self.boxed(prm) {
        let b = self.boxVal(v, self.ptype(prm), line)
        self.movVal(part, b)
    } else {
        self.movVal(part, v)
    }
}

// Case k of enum t, with its data (one value per field, or none).
fn Lower.caseValue(var self, t: Int, k: Int, fields: [[Int]]?) -> [Int] {
    let v = self.valOf(t)
    let kk = self.iconst(k)
    self.mov(v[0], kk)
    let d = self.tdecl(t)
    if fields is Some(fs) {
        let cf = self.caseFields(d, k)
        for f in 0..len(cf) {
            let off = self.fieldOffset(d, k, f)
            self.setField(cf[f], v[off..], fs[f], 0)
        }
    }
    v
}

// ---- text ----
fn Lower.literalText(var self, s: Text) -> [Int] {
    let d = self.dataText(s)
    let a = self.dataAddress(d)
    let n = self.iconst(len(s))
    [a, n]
}

fn Lower.unpackText(var self, p: Int) -> [Int] {
    let k8 = self.iconst(8)
    let a = self.op2(.Add, p, k8, 'I')
    let n = self.newReg('I')
    let z = self.iconst(0)
    self.emit(.Load, n, p, z, imm: 8, c: 0)
    [a, n]
}

fn Lower.joinText(var self, a: [Int], b: [Int]) -> [Int] {
    let p = self.rtcall(rtTextJoin, [a[0], a[1], b[0], b[1]], 'I', 0)
    self.unpackText(p)
}

fn Lower.caseNameTable(var self, d: Int) -> Int {
    var table: Bytes = []
    for c in self.dl(d).cases {
        let at = self.dataText(c)
        table += le64(at)
        table += le64(len(c))
    }
    let at = len(self.data)
    self.data += table
    at
}

fn Lower.caseName(var self, d: Int, tag: Int) -> [Int] {
    let ta = self.caseNameTable(d)
    let tableAt = self.dataAddress(ta)
    let base = self.dataAddress(0)
    let off = self.newReg('I')
    self.emit(.Load, off, tableAt, tag, imm: 16, c: 0)
    let n = self.newReg('I')
    self.emit(.Load, n, tableAt, tag, imm: 16, c: 8)
    let a = self.op2(.Add, base, off, 'I')
    [a, n]
}

fn Lower.textOf(var self, e: Int) -> [Int] {
    let v = self.lowerExpr(e)
    self.textOfVal(v, self.ty(e), self.lineOf(e))
}

fn Lower.textOfVal(var self, v: [Int], t: Int, line: Int) -> [Int] {
    let k = self.tk(t)
    if k == Kind.Text {
        return v
    }
    if k == Kind.Int {
        let p = self.rtcall(rtTextOfInt, v[..1], 'I', line)
        return self.unpackText(p)
    }
    if k == Kind.Float {
        let p = self.rtcall(rtTextOfFloat, v[..1], 'I', line)
        return self.unpackText(p)
    }
    if k == Kind.Bool {
        let r = [self.newReg('I'), self.newReg('I')]
        let yes = self.literalText("true")
        let no = self.literalText("false")
        let other = self.label()
        let done = self.label()
        self.jz(v[0], other)
        self.movVal(r, yes)
        self.jmp(done)
        self.place(other)
        self.movVal(r, no)
        self.place(done)
        return r
    }
    if k == Kind.Enum and not self.hasData(t) and self.p.fallibleValue(t) < 0 {
        return self.caseName(self.tdecl(t), v[0])
    }
    self.rtv(rtCaptureBegin, [], line)
    self.printVal(v, t)
    let p = self.rtcall(rtCaptureEnd, [], 'I', line)
    let text = self.unpackText(p)
    if k != Kind.Enum or self.p.fallibleValue(t) >= 0 {
        return text
    }
    let head = self.iconst(len(self.shownName(self.tdecl(t))) + 1)
    let a = self.op2(.Add, text[0], head, 'I')
    let n = self.op2(.Sub, text[1], head, 'I')
    [a, n]
}

// ---- printing ----
fn Lower.helperIndex(var self, t: Int, byValue: Bool, owns: Bool) -> Int {
    var index = -1
    for h in self.helpers {
        if not h.textFind and h.t == t and (if owns { h.owns } else { h.byValue == byValue and not h.owns }) {
            index = h.index
        }
    }
    if index < 0 {
        index = self.outCount - self.helpersDone + len(self.helpers)
        self.helpers.push(Helper(t, index, byValue, owns))
    }
    index
}

// the program's function that finds a text key in a map (Lower.textFindHelper), its index
fn Lower.textFindIndex(var self) -> Int {
    for h in self.helpers {
        if h.textFind {
            return h.index
        }
    }
    let index = self.outCount - self.helpersDone + len(self.helpers)
    self.helpers.push(Helper(-1, index, false, false, textFind: true))
    index
}

fn Lower.printCall(var self, v: [Int], t: Int, byValue: Bool) {
    let index = self.helperIndex(t, byValue, false)
    let k = self.emitAt(.Call, -1, -1, -1, imm: index)
    self.cur.setArgs(k, v)
    for r in v {
        self.touch(r)
    }
    self.maxOut(len(v))
}

// ---- a value dumped: written so that compiler/construn.qk reads it back by its type (a constant worked out by
// running it). An Int its digits and ";", a Text its length, ":" and its bytes, what holds values its count (or its
// case) and then them.
fn Lower.dumpInt(var self, r: Int) {
    self.rtv(rtPrintInt, [r], 0)
    self.printLiteral(";")
}

fn Lower.dumpFields(var self, v: [Int], d: Int, k: Int, fields: [Int]) {
    for (f, prm) in fields.enumerate() {
        let ft = self.ptype(prm)
        let at = self.fieldOffset(d, k, f)
        self.dumpVal(v[at..at + self.slots(ft)], ft)
    }
}

// the value at a case's place, when the case is k
fn Lower.dumpCase(var self, v: [Int], d: Int, k: Int, t: Int) {
    let skip = self.label()
    let kk = self.iconst(k)
    let same = self.cmp(condEq, v[0], kk)
    self.jz(same, skip)
    let at = self.caseOffset(d, k)
    self.dumpVal(v[at..at + self.slots(t)], t)
    self.place(skip)
}

fn Lower.dumpVal(var self, v: [Int], t: Int) {
    match self.tk(t) {
        Int | Bool => {
            self.dumpInt(v[0])
        }
        Float => {
            let p = self.spill(v[..1], 0) // its bits, read as an Int
            let bits = self.newReg('I')
            let z = self.iconst(0)
            self.emit(.Load, bits, p, z, imm: 8, c: 0)
            self.dumpInt(bits)
        }
        Text | Bytes => {
            self.rtv(rtPrintInt, [v[1]], 0)
            self.printLiteral(":")
            self.rtv(rtPrintText, v[..2], 0) // its bytes as they are
        }
        Array => {
            self.dumpInt(v[1])
            let arr = self.copyVal(v)
            let k = self.iconst(0)
            let top = self.label()
            let done = self.label()
            self.place(top)
            let end = self.cmp(condGe, k, arr[1])
            self.jnz(end, done)
            let elem = self.loadElem(arr, k, self.elemOf(t))
            self.sink(.DumpElem(self.elemOf(t)), elem, k)
            let one = self.iconst(1)
            self.emit(.Add, k, k, one)
            self.jmp(top)
            self.place(done)
        }
        Map => {
            let n = self.rtcall(rtMapLen, v[..1], 'I', 0)
            self.dumpInt(n)
            let none = self.label()
            self.jz(n, none)
            self.forEachEntry(v, t, .DumpEntry(t), 0)
            self.place(none)
        }
        Enum => {
            let d = self.tdecl(t)
            let x = self.dl(d)
            self.dumpInt(v[0])
            if x.resultOf >= 0 {
                self.dumpCase(v, d, 0, x.errorOf)
                self.dumpCase(v, d, 1, x.resultOf)
            } else if x.optionOf >= 0 {
                self.dumpCase(v, d, 1, x.optionOf)
            } else if self.hasData(t) {
                for k in 0..len(x.cases) {
                    let cf = self.caseFields(d, k)
                    if len(cf) == 0 {
                        continue
                    }
                    let skip = self.label()
                    let kk = self.iconst(k)
                    let same = self.cmp(condEq, v[0], kk)
                    self.jz(same, skip)
                    self.dumpFields(v, d, k, cf)
                    self.place(skip)
                }
            }
        }
        Record => {
            var at = 0
            for prm in self.dl(self.tdecl(t)).params {
                let ft = self.ptype(prm)
                self.dumpVal(v[at..at + self.slots(ft)], ft)
                at += self.fieldSlots(prm)
            }
        }
        _ => {}
    }
}

fn Lower.printVal(var self, v: [Int], t: Int) {
    if self.tk(t) is Enum | Record {
        if self.printing.contains(t) {
            self.printCall(v, t, true)
            return
        }
        if len(self.printing) < 64 {
            self.printing.push(t)
        }
        self.printValInline(v, t)
        self.printing.pop()
        return
    }
    self.printValInline(v, t)
}

fn Lower.printValInline(var self, v: [Int], t: Int) {
    match self.tk(t) {
        Int => {
            self.rtv(rtPrintInt, v[..1], 0)
        }
        Float => {
            self.rtv(rtPrintFloat, v[..1], 0)
        }
        Bool => {
            self.rtv(rtPrintBool, v[..1], 0)
        }
        Text => {
            self.rtv(rtPrintText, v[..2], 0)
        }
        Bytes => {
            self.rtv(rtPrintBytes, v[..2], 0)
        }
        Pointer => {
            self.rtv(rtPrintPointer, v[..1], 0)
        }
        Handle => {
            let name = self.declName(self.tdecl(t))
            let d = self.dataText(name)
            let a = self.dataAddress(d)
            let n = self.iconst(len(name))
            self.rtv(rtPrintHandle, [a, n, v[0]], 0)
        }
        Map => {
            let empty = self.label()
            let done = self.label()
            let set = self.p.isSet(t)
            let n = self.rtcall(rtMapLen, v[..1], 'I', 0)
            self.jz(n, empty)
            self.printLiteral(if set { "Set(" } else { "[" })
            let first = self.newReg('I')
            let one = self.iconst(1)
            self.mov(first, one)
            self.forEachEntry(v, t, .PrintEntry(t, first), 0)
            self.printLiteral(if set { ")" } else { "]" })
            self.jmp(done)
            self.place(empty)
            self.printLiteral(if set { "Set()" } else { "[:]" })
            self.place(done)
        }
        Enum => {
            let d = self.tdecl(t)
            let x = self.dl(d)
            if x.resultOf >= 0 {
                let ok = self.label()
                let done = self.label()
                self.jnz(v[0], ok)
                self.printLiteral("Err(")
                let o0 = self.caseOffset(d, 0)
                let n0 = self.slots(x.errorOf)
                self.printVal(v[o0..o0 + n0], x.errorOf)
                self.printLiteral(")")
                self.jmp(done)
                self.place(ok)
                self.printLiteral("Ok(")
                let o1 = self.caseOffset(d, 1)
                let n1 = self.slots(x.resultOf)
                self.printVal(v[o1..o1 + n1], x.resultOf)
                self.printLiteral(")")
                self.place(done)
                return
            }
            if x.optionOf >= 0 {
                let some = self.label()
                let done = self.label()
                self.jnz(v[0], some)
                self.printLiteral("None")
                self.jmp(done)
                self.place(some)
                self.printLiteral("Some(")
                let o1 = self.caseOffset(d, 1)
                let n1 = self.slots(x.optionOf)
                self.printVal(v[o1..o1 + n1], x.optionOf)
                self.printLiteral(")")
                self.place(done)
                return
            }
            self.printLiteral(self.shownName(d) + ".")
            let name = self.caseName(d, v[0])
            self.rtv(rtPrintText, name, 0)
            if not self.hasData(t) {
                return
            }
            for k in 0..len(x.cases) {
                let cf = self.caseFields(d, k)
                if len(cf) == 0 {
                    continue
                }
                let skip = self.label()
                let kk = self.iconst(k)
                let same = self.cmp(condEq, v[0], kk)
                self.jz(same, skip)
                for (f, prm) in cf.enumerate() {
                    let ft = self.ptype(prm)
                    let lead = if f > 0 { ", " } else { "(" }
                    self.printLiteral(lead + self.p.ast.params[prm].name + ": ")
                    let at = self.fieldOffset(d, k, f)
                    if self.boxed(prm) {
                        self.printCall([v[at]], ft, false)
                    } else {
                        let n = self.slots(ft)
                        self.printVal(v[at..at + n], ft)
                    }
                }
                self.printLiteral(")")
                self.place(skip)
            }
        }
        Record => {
            let d = self.tdecl(t)
            let x = self.dl(d)
            if x.isInterface {
                self.printLiteral(x.name)
                return
            }
            let head = if x.isTuple {
                ""
            } else if x.isEntry {
                "Entry"
            } else {
                self.shownName(d)
            }
            self.printLiteral(head + "(")
            var at = 0
            for (f, prm) in x.params.enumerate() {
                let ft = self.ptype(prm)
                let name = if x.isTuple {
                    if f > 0 { ", " } else { "" }
                } else {
                    (if f > 0 { ", " } else { "" }) + self.p.ast.params[prm].name + ": "
                }
                self.printLiteral(name)
                if self.boxed(prm) {
                    self.printCall([v[at]], ft, false)
                } else {
                    let n = self.slots(ft)
                    self.printVal(v[at..at + n], ft)
                }
                at += self.fieldSlots(prm)
            }
            self.printLiteral(")")
        }
        Array => {
            self.printLiteral("[")
            let arr = self.copyVal(v)
            let k = self.iconst(0)
            let top = self.label()
            let done = self.label()
            self.place(top)
            let end = self.cmp(condGe, k, arr[1])
            self.jnz(end, done)
            let elem = self.loadElem(arr, k, self.elemOf(t))
            self.sink(.PrintElem(self.elemOf(t)), elem, k)
            let one = self.iconst(1)
            self.emit(.Add, k, k, one)
            self.jmp(top)
            self.place(done)
            self.printLiteral("]")
        }
        _ => {}
    }
}

// ---- the newer built-ins: helpers ----
// A loop or an array, as an array.
fn Lower.arrayOf(var self, src: Int, line: Int) -> [Int] {
    let s = self.stripImplicit(src)
    if self.ek(s) == Kind.Array and not self.isLazyName(s) {
        return self.lowerExpr(s)
    }
    self.materialize(src, self.elemOf(self.ty(s)), line)
}

// Slots the runtime left at p.
fn Lower.loadSlots(var self, p: Int, t: Int) -> [Int] {
    let r = self.valOf(t)
    for i in 0..len(r) {
        let z = self.iconst(0)
        self.emit(.Load, r[i], p, z, imm: 8, c: 8 * i)
    }
    r
}

// ---- a deep var's own copy ----
fn Lower.ownInsides(var self, c: [Int], t: Int) {
    let index = self.helperIndex(t, true, true)
    let k = self.emitAt(.Call, -1, -1, -1, imm: index)
    self.cur.setArgs(k, c)
    for r in c {
        self.touch(r)
    }
    self.maxOut(len(c))
}

fn Lower.deepCopy(var self, v: [Int], t: Int, line: Int) -> [Int] {
    if not self.holdsContainers(t) {
        return v
    }
    if self.tk(t) is Array | Map {
        let c = self.copyOf(v, t, line)
        if self.holdsContainers(self.elemOf(t)) {
            self.ownInsides(c, t)
        }
        return c
    }
    var c = self.copyVal(v)
    let d = self.tdecl(t)
    for (f, prm) in self.dl(d).params.enumerate() {
        let ft = self.ptype(prm)
        if self.boxed(prm) or not self.holdsContainers(ft) {
            continue
        }
        let at = self.recordOffset(d, f)
        let n = self.slots(ft)
        let part = self.deepCopy(c[at..at + n], ft, line)
        for j in 0..len(part) {
            c[at + j] = part[j]
        }
    }
    c
}

fn Lower.mapKeySlots(var self, m: Int) -> Int = self.slots(self.keyOf(m))

fn Lower.mapKeyArea(var self, m: Int) -> Int = max(self.mapKeySlots(m), 2)

// the helper's body: each element (each entry's value) copied, and put back where it was
fn Lower.lowerOwnHelper(var self, t: Int) {
    let c = self.valOf(t)
    self.cur.params = c
    self.cur.maxOut = len(c)
    let i = self.newReg('I')
    let z = self.iconst(0)
    self.mov(i, z)
    let top = self.label()
    let test = self.label()
    let next = self.label()
    let isMap = self.tk(t) == Kind.Map
    let n = if isMap { self.rtcall(rtMapUsed, c[..1], 'I', 0) } else { c[1] }
    self.depth += 1
    self.jmp(test)
    self.place(top)
    if isMap {
        let p = self.rtcall(rtMapEntry, [c[0], i], 'I', 0)
        self.jz(p, next)
        let value = self.valOf(self.elemOf(t))
        let area = self.mapKeyArea(t)
        for j in 0..len(value) {
            let z2 = self.iconst(0)
            self.emit(.Load, value[j], p, z2, imm: 8, c: 8 * area + 8 * j)
        }
        let copied = self.deepCopy(value, self.elemOf(t), 0)
        let z3 = self.iconst(0)
        self.storeSlots(p, z3, 8, 8 * area, copied)
    } else {
        let elem = self.loadElem(c, i, self.elemOf(t))
        let copied = self.deepCopy(elem, self.elemOf(t), 0)
        let bytes = self.elemBytes(t)
        self.storeSlots(c[0], i, bytes, 0, copied)
    }
    self.place(next)
    let one = self.iconst(1)
    self.emit(.Add, i, i, one)
    self.place(test)
    let more = self.cmp(condLt, i, n)
    self.jnz(more, top)
    self.depth -= 1
}

// the first of the program's declarations of this name
fn Lower.findDecl(self, name: Text) -> Int {
    for d in self.p.decls {
        let x = self.p.ast.decls[d]
        if x.kind != DeclKind.Use and x.name == name {
            return d
        }
    }
    -1
}

// a < b: numbers, texts, Bools, cases, or through the type's compare
fn Lower.lessThan(var self, a: [Int], b: [Int], t: Int, line: Int) -> Int {
    match self.tk(t) {
        Text | Bytes => {
            let z = self.iconst(0)
            let r = self.rtcall(rtTextCompare, [a[0], a[1], b[0], b[1]], 'I', line)
            self.cmp(condLt, r, z)
        }
        Record | Enum | Handle => {
            let d = self.findDecl(self.declName(self.tdecl(t)) + ".compare")
            if d >= 0 {
                let z = self.iconst(0)
                let r = self.callDecl(d, [a, b], line)[0]
                return self.cmp(condLt, r, z)
            }
            self.cmp(condLt, a[0], b[0])
        }
        _ => self.cmp(condLt, a[0], b[0])
    }
}

fn Lower.sortKey(var self, lambda: Int, elem: [Int]) -> [Int] {
    if lambda < 0 {
        return elem
    }
    self.bindLambda(lambda, [elem])
    let v = self.lowerExpr(self.lambdaBody(lambda))
    self.copyVal(v)
}

fn Lower.plainSort(self, elem: Int) -> Int = match self.tk(elem) {
    Int | Bool => 0
    Float => 1
    Text | Bytes => 2
    Enum => if self.hasData(elem) or self.findDecl(self.declName(self.tdecl(elem)) + ".compare") >= 0 {
        -1
    } else {
        0
    }
    _ => -1
}

fn Lower.lowerSort(
    var self,
    arr: [Int],
    elem: Int,
    lambda: Int,
    keyType: Int,
    descending: Int,
    fresh: Bool,
    line: Int,
) -> [Int] {
    self.branchDepth += 1
    let r = self.lowerSortInner(arr, elem, lambda, keyType, descending, fresh, line)
    self.branchDepth -= 1
    r
}

fn Lower.lowerSortInner(
    var self,
    arr: [Int],
    elem: Int,
    lambda: Int,
    keyType: Int,
    descending: Int,
    fresh: Bool,
    line: Int,
) -> [Int] {
    let bytes = self.slots(elem) * 8
    let plain = if lambda >= 0 { -1 } else { self.plainSort(elem) }
    if plain >= 0 {
        let out = if fresh { arr } else { self.copyArray(arr, bytes, line) }
        let kp = self.iconst(plain)
        let desc = if descending >= 0 { descending } else { self.iconst(0) }
        self.rtv(rtSort, [out[0], out[1], kp, desc], line)
        return out
    }
    let n = self.newReg('I')
    self.mov(n, arr[1])
    let first = self.copyArray(arr, bytes, line)
    let src = self.newReg('I')
    let dst = self.newReg('I')
    self.mov(src, first[0])
    let room = self.alloc(n, bytes, line)
    self.mov(dst, room)
    let width = self.newReg('I')
    let k1 = self.iconst(1)
    self.mov(width, k1)
    let outerTop = self.label()
    let outerDone = self.label()
    self.depth += 1
    self.place(outerTop)
    let c1 = self.cmp(condGe, width, n)
    self.jnz(c1, outerDone)
    let i = self.newReg('I')
    let z = self.iconst(0)
    self.mov(i, z)
    let runTop = self.label()
    let runDone = self.label()
    self.depth += 1
    self.place(runTop)
    let c2 = self.cmp(condGe, i, n)
    self.jnz(c2, runDone)
    let mid = self.newReg('I')
    let hi = self.newReg('I')
    let m0 = self.op2(.Add, i, width, 'I')
    self.mov(mid, m0)
    let midOk = self.label()
    let c3 = self.cmp(condGt, mid, n)
    self.jz(c3, midOk)
    self.mov(mid, n)
    self.place(midOk)
    let h0 = self.op2(.Add, mid, width, 'I')
    self.mov(hi, h0)
    let hiOk = self.label()
    let c4 = self.cmp(condGt, hi, n)
    self.jz(c4, hiOk)
    self.mov(hi, n)
    self.place(hiOk)
    let l = self.newReg('I')
    let r = self.newReg('I')
    let k = self.newReg('I')
    self.mov(l, i)
    self.mov(r, mid)
    self.mov(k, i)
    let mergeTop = self.label()
    let mergeDone = self.label()
    let takeRight = self.label()
    let stored = self.label()
    self.depth += 1
    self.place(mergeTop)
    let c5 = self.cmp(condGe, k, hi)
    self.jnz(c5, mergeDone)
    let takeLeft = self.label()
    let c6 = self.cmp(condGe, l, mid)
    self.jnz(c6, takeRight)
    let c7 = self.cmp(condGe, r, hi)
    self.jnz(c7, takeLeft)
    let left = self.loadElem([src, n], l, elem)
    let right = self.loadElem([src, n], r, elem)
    let kl = self.sortKey(lambda, left)
    let kr = self.sortKey(lambda, right)
    if descending >= 0 {
        let ascending = self.label()
        self.jz(descending, ascending)
        let lt = self.lessThan(kl, kr, keyType, line)
        self.jnz(lt, takeRight)
        self.jmp(takeLeft)
        self.place(ascending)
    }
    let lt2 = self.lessThan(kr, kl, keyType, line)
    self.jnz(lt2, takeRight)
    self.place(takeLeft)
    let fromLeft = self.loadElem([src, n], l, elem)
    self.storeSlots(dst, k, bytes, 0, fromLeft)
    let o1 = self.iconst(1)
    self.emit(.Add, l, l, o1)
    self.jmp(stored)
    self.place(takeRight)
    let fromRight = self.loadElem([src, n], r, elem)
    self.storeSlots(dst, k, bytes, 0, fromRight)
    let o2 = self.iconst(1)
    self.emit(.Add, r, r, o2)
    self.place(stored)
    let o3 = self.iconst(1)
    self.emit(.Add, k, k, o3)
    self.jmp(mergeTop)
    self.depth -= 1
    self.place(mergeDone)
    let w2 = self.op2(.Add, width, width, 'I')
    self.emit(.Add, i, i, w2)
    self.jmp(runTop)
    self.depth -= 1
    self.place(runDone)
    let t = self.newReg('I')
    self.mov(t, src)
    self.mov(src, dst)
    self.mov(dst, t)
    self.emit(.Add, width, width, width)
    self.jmp(outerTop)
    self.depth -= 1
    self.place(outerDone)
    [src, n]
}

fn Lower.searchSink(var self, s: Search, elem: [Int], index: Int) {
    if s.builtin is 47 | 48 {
        let same = self.equalVals(elem, s.needle, s.elem, s.line)
        self.jz(same, self.loopContinue)
        let one = self.iconst(1)
        self.mov(s.result[0], one)
        if s.builtin == bIndexOf {
            self.mov(s.result[1], index)
        }
        self.jmp(self.loopBreak)
        return
    }
    if s.builtin is 59 | 60 {
        if s.lambda >= 0 {
            self.bindLambda(s.lambda, [elem])
            let t = self.lowerExpr(self.lambdaBody(s.lambda))[0]
            self.jz(t, self.loopContinue)
        }
        let one = self.iconst(1)
        self.mov(s.result[0], one)
        self.movVal(s.result[1..], elem)
        if s.builtin == bFirst {
            self.jmp(self.loopBreak)
        }
        return
    }
    if s.builtin == bCountOf {
        self.bindLambda(s.lambda, [elem])
        let t = self.lowerExpr(self.lambdaBody(s.lambda))[0]
        self.jz(t, self.loopContinue)
        let one = self.iconst(1)
        self.emit(.Add, s.result[0], s.result[0], one)
        return
    }
    let key = self.sortKey(s.lambda, elem)
    let take = self.label()
    let done = self.label()
    self.jz(s.has, take)
    let better = if s.builtin == bMaxBy {
        self.lessThan(s.bestKey, key, s.keyType, s.line)
    } else {
        self.lessThan(key, s.bestKey, s.keyType, s.line)
    }
    self.jz(better, done)
    self.place(take)
    self.movVal(s.result, elem)
    self.movVal(s.bestKey, key)
    let one = self.iconst(1)
    self.mov(s.has, one)
    self.place(done)
}

// ---- maps ----
fn Lower.keyByAddress(var self, key: Int) -> Bool = mapKeyKind(self.typeDesc(key)) == 3

// how a map hashes its key (runtime.c's qkMapKeyKind): 0 one plain slot, 1 a text, 2 two, 3 by its description
fn mapKeyKind(d: Bytes) -> Int {
    var plain = 0
    var texts = 0
    for c in d {
        if c == 'I' {
            plain += 1
        } else if c == 'T' {
            texts += 1
        } else if c != '(' and c != ')' {
            return 3
        }
    }
    if texts == 1 and plain == 0 {
        return 1
    }
    if texts == 0 and plain == 1 {
        return 0
    }
    if texts == 0 and plain == 2 {
        return 2
    }
    3
}

fn Lower.keyArgs(var self, k: [Int], key: Int) -> [Int] {
    if self.keyByAddress(key) {
        let one = self.iconst(1)
        let p = self.alloc(one, len(k) * 8, 0)
        let z = self.iconst(0)
        self.storeSlots(p, z, 8, 0, k)
        let z2 = self.iconst(0)
        return [p, z2]
    }
    if len(k) > 1 {
        return [k[0], k[1]]
    }
    let z = self.iconst(0)
    [k[0], z]
}

fn Lower.descAddress(var self, t: Int) -> Int {
    let d = self.dataBytes(self.typeDesc(t))
    self.dataAddress(d)
}

fn Lower.newMap(var self, t: Int, line: Int) -> [Int] {
    let d = self.descAddress(t)
    [self.rtcall(rtMapNew, [d], 'I', line)]
}

fn Lower.lineHere(var self, line: Int) -> Int = self.iconst(line | self.inl << 32)

fn Lower.mapSet(var self, m: [Int], k: [Int], key: Int, v: [Int], line: Int) {
    let where = self.lineHere(line)
    let ka = self.keyArgs(k, key)
    let p = self.rtcall(rtMapSet, [m[0], ka[0], ka[1], where], 'I', line)
    let z = self.iconst(0)
    self.storeSlots(p, z, 0, 0, v)
}

// x >> n as the runtime's shr does it (logical): the arithmetic shift, masked
fn Lower.shrLogical(var self, x: Int, n: Int) -> Int {
    let kn = self.iconst(n)
    let shifted = self.op2(.Sar, x, kn, 'I')
    let mask = self.iconst(1 << (64 - n) - 1)
    self.op2(.And, shifted, mask, 'I')
}

// runtime/base.qk's mix, here in the code
fn Lower.mixHere(var self, x: Int) -> Int {
    let a1 = self.shrLogical(x, 30)
    let a2 = self.op2(.Xor, x, a1, 'I')
    let m1 = self.iconst(-4658895280553007687)
    let a = self.op2(.Mul, a2, m1, 'I')
    let b1 = self.shrLogical(a, 27)
    let b2 = self.op2(.Xor, a, b1, 'I')
    let m2 = self.iconst(-7723592293110705685)
    let b = self.op2(.Mul, b2, m2, 'I')
    let c1 = self.shrLogical(b, 31)
    self.op2(.Xor, b, c1, 'I')
}

// where m's value for the key ka (keyArgs) is, 0 when it has none: the runtime's mapGet. A key of one plain slot (an
// Int, a Bool, a case without data) is looked for here in the code, as runtime/map.qk's mapFindHashed does: its hash,
// then the table's slots from there (a slot: the entry's index + 1, the hash's high 32 bits above), the entry's
// key compared where the tags match. The words read are map.qk's (mValueBytes 3, mTableCap 5, mEntries 6, mTable 7,
// mKeySlots 9; an entry: [alive][key's slots][value]).
fn Lower.mapLookup(var self, m: Int, ka: [Int], key: Int, line: Int) -> Int {
    let kind = mapKeyKind(self.typeDesc(key))
    if not self.opts.runtime and kind == 1 {
        // a text: the program's own function for it (one, called from every place)
        let index = self.textFindIndex()
        let c = self.emitAt(.Call, -1, -1, -1, imm: index, line: line)
        self.cur.setArgs(c, [m] + ka)
        let r = self.newReg('I')
        self.setRets(c, [r])
        self.maxOut(3)
        return r
    }
    if self.opts.runtime or kind != 0 {
        return self.rtcall(rtMapGet, [m] + ka, 'I', line)
    }
    let k = ka[0]
    let r = self.newReg('I')
    let z = self.iconst(0)
    self.mov(r, z)
    let done = self.label()
    self.jz(m, done)
    let tableCap = self.loadMem('I', m, -1, 1, 8 * 5, mem64)
    self.jz(tableCap, done)
    let seed = self.iconst(-7046029254386353131)
    let seeded = self.op2(.Add, k, seed, 'I')
    let h = self.mixHere(seeded)
    let one = self.iconst(1)
    let mask = self.op2(.Sub, tableCap, one, 'I')
    let table = self.loadMem('I', m, -1, 1, 8 * 7, mem64)
    let tagBits = self.iconst(-4294967296)
    let tag = self.op2(.And, h, tagBits, 'I')
    let i = self.newReg('I')
    let i0 = self.op2(.And, h, mask, 'I')
    self.mov(i, i0)
    let entries = self.loadMem('I', m, -1, 1, 8 * 6, mem64)
    let keySlots = self.loadMem('I', m, -1, 1, 8 * 9, mem64)
    let valueBytes = self.loadMem('I', m, -1, 1, 8 * 3, mem64)
    let k3 = self.iconst(3)
    let keyBytes = self.op2(.Shl, keySlots, k3, 'I')
    let k8 = self.iconst(8)
    let valueAt = self.op2(.Add, keyBytes, k8, 'I')
    let stride = self.op2(.Add, valueAt, valueBytes, 'I')
    let top = self.label()
    let next = self.label()
    self.place(top)
    let slot = self.loadMem('I', table, i, 8, 0, mem64)
    self.jz(slot, done)
    let slotTag = self.op2(.And, slot, tagBits, 'I')
    let tagged = self.cmp(condEq, slotTag, tag)
    self.jz(tagged, next)
    let indexBits = self.iconst(4294967295)
    let index1 = self.op2(.And, slot, indexBits, 'I')
    let index = self.op2(.Sub, index1, one, 'I')
    let off = self.op2(.Mul, index, stride, 'I')
    let e = self.op2(.Add, entries, off, 'I')
    let alive = self.loadMem('I', e, -1, 1, 0, mem64)
    self.jz(alive, next)
    let held = self.loadMem('I', e, -1, 1, 8, mem64)
    let same = self.cmp(condEq, held, k)
    self.jz(same, next)
    let at = self.op2(.Add, e, valueAt, 'I')
    self.mov(r, at)
    self.jmp(done)
    self.place(next)
    let i1 = self.op2(.Add, i, one, 'I')
    let i2 = self.op2(.And, i1, mask, 'I')
    self.mov(i, i2)
    self.jmp(top)
    self.place(done)
    r
}

// runtime/map.qk's textHash of n bytes at p, here in the code: eight bytes at a time multiplied in, the last few
// as one word, mixed at the end
fn Lower.textHashHere(var self, p: Int, n: Int) -> Int {
    let mul = self.iconst(-7046029254386353131)
    let h = self.newReg('I')
    let n1 = self.op2(.Mul, n, mul, 'I')
    let basis = self.iconst(1469598103934665603)
    let h0 = self.op2(.Xor, n1, basis, 'I')
    self.mov(h, h0)
    let i = self.newReg('I')
    let z = self.iconst(0)
    self.mov(i, z)
    let words = self.label()
    let tail = self.label()
    self.place(words)
    let k8 = self.iconst(8)
    let i8 = self.op2(.Add, i, k8, 'I')
    let past = self.cmp(condGt, i8, n)
    self.jnz(past, tail)
    let w = self.loadMem('I', p, i, 1, 0, mem64)
    let hw = self.op2(.Xor, h, w, 'I')
    let hm = self.op2(.Mul, hw, mul, 'I')
    let hs = self.shrLogical(hm, 29)
    let hx = self.op2(.Xor, hm, hs, 'I')
    self.mov(h, hx)
    self.mov(i, i8)
    self.jmp(words)
    self.place(tail)
    let last = self.newReg('I')
    let shift = self.newReg('I')
    let z2 = self.iconst(0)
    self.mov(last, z2)
    self.mov(shift, z2)
    let bytes = self.label()
    let fin = self.label()
    self.place(bytes)
    let more = self.cmp(condLt, i, n)
    self.jz(more, fin)
    let b = self.loadByte(p, i)
    let bs = self.op2(.Shl, b, shift, 'I')
    let l2 = self.op2(.Or, last, bs, 'I')
    self.mov(last, l2)
    let k8b = self.iconst(8)
    let s2 = self.op2(.Add, shift, k8b, 'I')
    self.mov(shift, s2)
    let one = self.iconst(1)
    let i2 = self.op2(.Add, i, one, 'I')
    self.mov(i, i2)
    self.jmp(bytes)
    self.place(fin)
    let hl = self.op2(.Xor, h, last, 'I')
    self.mixHere(hl)
}

// The program's function for a map's text key (m, p, n): where its value is, or 0 (runtime/map.qk's mapGet of a
// text key: the hash, the table's slots from there, an entry's length and then its bytes compared where the tags
// match), here in the program rather than a call to the runtime.
fn Lower.textFindHelper(var self) {
    let m = self.newReg('I')
    let p = self.newReg('I')
    let n = self.newReg('I')
    self.cur.params = [m, p, n]
    self.cur.maxOut = 3
    let r = self.newReg('I')
    let z = self.iconst(0)
    self.mov(r, z)
    let done = self.label()
    self.jz(m, done)
    let tableCap = self.loadMem('I', m, -1, 1, 8 * 5, mem64)
    self.jz(tableCap, done)
    let h = self.textHashHere(p, n)
    let one = self.iconst(1)
    let mask = self.op2(.Sub, tableCap, one, 'I')
    let table = self.loadMem('I', m, -1, 1, 8 * 7, mem64)
    let tagBits = self.iconst(-4294967296)
    let tag = self.op2(.And, h, tagBits, 'I')
    let i = self.newReg('I')
    let i0 = self.op2(.And, h, mask, 'I')
    self.mov(i, i0)
    let entries = self.loadMem('I', m, -1, 1, 8 * 6, mem64)
    let keySlots = self.loadMem('I', m, -1, 1, 8 * 9, mem64)
    let valueBytes = self.loadMem('I', m, -1, 1, 8 * 3, mem64)
    let k3 = self.iconst(3)
    let keyBytes = self.op2(.Shl, keySlots, k3, 'I')
    let k8 = self.iconst(8)
    let valueAt = self.op2(.Add, keyBytes, k8, 'I')
    let stride = self.op2(.Add, valueAt, valueBytes, 'I')
    let top = self.label()
    let next = self.label()
    self.place(top)
    let slot = self.loadMem('I', table, i, 8, 0, mem64)
    self.jz(slot, done)
    let slotTag = self.op2(.And, slot, tagBits, 'I')
    let tagged = self.cmp(condEq, slotTag, tag)
    self.jz(tagged, next)
    let indexBits = self.iconst(4294967295)
    let index1 = self.op2(.And, slot, indexBits, 'I')
    let index = self.op2(.Sub, index1, one, 'I')
    let off = self.op2(.Mul, index, stride, 'I')
    let e = self.op2(.Add, entries, off, 'I')
    let alive = self.loadMem('I', e, -1, 1, 0, mem64)
    self.jz(alive, next)
    let len2 = self.loadMem('I', e, -1, 1, 16, mem64)
    let sameLen = self.cmp(condEq, len2, n)
    self.jz(sameLen, next)
    // the bytes: eight at a time, then one at a time
    let q = self.loadMem('I', e, -1, 1, 8, mem64)
    let j = self.newReg('I')
    let z3 = self.iconst(0)
    self.mov(j, z3)
    let words = self.label()
    let bytes = self.label()
    let found = self.label()
    self.place(words)
    let k8w = self.iconst(8)
    let j8 = self.op2(.Add, j, k8w, 'I')
    let past = self.cmp(condGt, j8, n)
    self.jnz(past, bytes)
    let wa = self.loadMem('I', p, j, 1, 0, mem64)
    let wb = self.loadMem('I', q, j, 1, 0, mem64)
    let same8 = self.cmp(condEq, wa, wb)
    self.jz(same8, next)
    self.mov(j, j8)
    self.jmp(words)
    self.place(bytes)
    let more = self.cmp(condLt, j, n)
    self.jz(more, found)
    let ba = self.loadByte(p, j)
    let bb = self.loadByte(q, j)
    let same1 = self.cmp(condEq, ba, bb)
    self.jz(same1, next)
    let j1 = self.op2(.Add, j, one, 'I')
    self.mov(j, j1)
    self.jmp(bytes)
    self.place(found)
    let at = self.op2(.Add, e, valueAt, 'I')
    self.mov(r, at)
    self.jmp(done)
    self.place(next)
    let i1 = self.op2(.Add, i, one, 'I')
    let i2 = self.op2(.And, i1, mask, 'I')
    self.mov(i, i2)
    self.jmp(top)
    self.place(done)
    self.cur.resultCount = 1
    let rt = self.emitAt(.Ret, -1, -1, -1)
    self.cur.setArgs(rt, [r])
    self.touch(r)
}

fn Lower.mapGet(var self, m: [Int], k: [Int], key: Int, option: Int, line: Int) -> [Int] {
    let ka = self.keyArgs(k, key)
    let p = self.mapLookup(m[0], ka, key, line)
    let r = self.valOf(option)
    let z = self.iconst(0)
    let found = self.cmp(condNe, p, z)
    self.mov(r[0], found)
    let none = self.label()
    self.jz(r[0], none)
    for i in 1..len(r) {
        let z2 = self.iconst(0)
        self.emit(.Load, r[i], p, z2, imm: 8, c: 8 * (i - 1))
    }
    self.place(none)
    r
}

// m[k] in a place: where its value is; a key the map does not hold stops the program
fn Lower.mapAt(var self, m: [Int], k: [Int], t: Int, line: Int) -> Int {
    let ka = self.keyArgs(k, self.keyOf(t))
    let p = self.mapLookup(m[0], ka, self.keyOf(t), line)
    let found = self.label()
    self.jnz(p, found)
    var why = self.literalText("no key ")
    let kt = self.keyOf(t)
    if self.tk(kt) == Kind.Text {
        let q1 = self.literalText("\"")
        let right = self.joinText(k, q1)
        let q2 = self.literalText("\"")
        let left = self.joinText(why, q2)
        why = self.joinText(left, right)
    } else {
        let record = self.tk(kt) == Kind.Record
        let fs = if record { self.fields(kt) } else { [] }
        let count = if record { len(fs) } else { 1 }
        var at = 0
        for f in 0..count {
            let ft = if record { self.ptype(fs[f]) } else { kt }
            let n = self.slots(ft)
            let held = k[at..at + n]
            at += n
            if count > 1 {
                let sep = self.literalText(if f > 0 { ", " } else { "(" })
                why = self.joinText(why, sep)
            }
            let text = self.textOfVal(held, ft, line)
            why = self.joinText(why, text)
        }
        if count > 1 {
            let close = self.literalText(")")
            why = self.joinText(why, close)
        }
    }
    let tail = self.literalText(" in the map")
    why = self.joinText(why, tail)
    let where = self.lineHere(line)
    self.rtv(rtFailId, [why[0], why[1], where], line)
    self.place(found)
    p
}

// Every entry of a map, in the order the keys came.
fn Lower.forEachEntry(var self, m: [Int], t: Int, body: EntrySink, line: Int) {
    let map = self.newReg('I')
    self.mov(map, m[0])
    let n = self.rtcall(rtMapUsed, [map], 'I', line)
    let k = self.newReg('I')
    let z = self.iconst(0)
    self.mov(k, z)
    let top = self.label()
    let next = self.label()
    let done = self.label()
    let test = self.label()
    self.depth += 1
    self.jmp(test)
    self.place(top)
    self.fuel(line)
    let p = self.rtcall(rtMapEntry, [map, k], 'I', line)
    self.jz(p, next)
    let ks = self.mapKeySlots(t)
    let key = self.valOf(self.keyOf(t))
    for i in 0..len(key) {
        if i < ks {
            let z2 = self.iconst(0)
            self.emit(.Load, key[i], p, z2, imm: 8, c: 8 * i)
        }
    }
    let value = self.valOf(self.elemOf(t))
    let area = self.mapKeyArea(t)
    for i in 0..len(value) {
        let z3 = self.iconst(0)
        self.emit(.Load, value[i], p, z3, imm: 8, c: 8 * area + 8 * i)
    }
    let saved = self.loopFrame(done, next)
    self.entrySink(body, key, value)
    self.loopBreak = saved.0
    self.loopContinue = saved.1
    self.place(next)
    let one = self.iconst(1)
    self.emit(.Add, k, k, one)
    self.place(test)
    let more = self.cmp(condLt, k, n)
    self.jnz(more, top)
    self.depth -= 1
    self.place(done)
}

// ---- calls ----
fn Lower.lowerParallelMap(var self, e: Int) -> [Int] {
    let a0 = self.arrayOf(self.arg(e, 0), self.lineOf(e))
    let arr = self.copyVal(a0)
    let f = self.lowerExpr(self.arg(e, 1))
    let ft = self.ty(self.arg(e, 1))
    let s1 = self.iconst(self.slots(self.p.types[ft].params[0]))
    let s2 = self.iconst(self.slots(self.elemOf(ft)))
    let ln = self.iconst(self.lineOf(e))
    // results that hold memory: their array's description, to copy them out of each thread's memory (else 0)
    let desc = if self.own.holdsMemory(self.elemOf(ft)) {
        self.descAddress(self.ty(e))
    } else {
        self.iconst(0)
    }
    let r = self.rtcall(rtParallelMap, [f[0], f[1], arr[0], arr[1], s1, s2, ln, desc], 'I', self.lineOf(e))
    [r, arr[1]]
}

// xs.parallelFold(start, step, combine): the runtime's block (threads.qk), its accumulator back
fn Lower.lowerParallelFold(var self, e: Int) -> [Int] {
    let line = self.lineOf(e)
    let a0 = self.arrayOf(self.arg(e, 0), line)
    let arr = self.copyVal(a0)
    let start = self.lowerExpr(self.arg(e, 1))
    let step = self.lowerExpr(self.arg(e, 2))
    let combine = if len(self.argsOf(e)) > 3 {
        self.lowerExpr(self.arg(e, 3))
    } else {
        step
    }
    let acc = self.ty(e)
    let accSlots = self.slots(acc)
    let inSlots = self.slots(self.p.types[self.ty(self.arg(e, 2))].params[1])
    let one = self.iconst(1)
    let b = self.alloc(one, 8 * (9 + accSlots), line)
    let z = self.iconst(0)
    let words = [
        step[0],
        step[1],
        combine[0],
        combine[1],
        arr[0],
        arr[1],
        self.iconst(inSlots),
        self.iconst(accSlots),
        self.iconst(line),
    ]
    self.storeSlots(b, z, 8, 0, words)
    self.storeSlots(b, z, 8, 72, start)
    let r = self.rtcall(rtParallelFold, [b], 'I', line)
    self.loadSlots(r, acc)
}

fn Lower.floatToInt(var self, x: Int, line: Int) -> Int {
    let r = self.newReg('I')
    self.emit(.FloatToInt, r, x, -1, cond: 1, line: line)
    r
}

// "-" * 40, [v] * n, xs * n
fn Lower.lowerRepeat(var self, e: Int) -> [Int] {
    let a = self.aOf(e)
    let b = self.bOf(e)
    let line = self.lineOf(e)
    if self.builtinOf(e) == bRepeat {
        let t = self.lowerExpr(a)
        let n = self.lowerExpr(b)[0]
        let p = self.rtcall(rtRepeat, [t[0], t[1], n], 'I', line)
        return self.unpackText(p)
    }
    let one = self.unwrapAll(a)
    let single = self.p.ast.exprs[one].node is ArrayLit(items) and len(items) == 1
    let arr = if single { [] } else { self.lowerExpr(a) }
    let v = if single { self.lowerExpr(self.argsOf(one)[0]) } else { [] }
    let written = self.unwrapAll(b)
    var times = 0
    if self.p.ast.exprs[written].node is IntLit(value, _) and value >= 0 {
        times = self.iconst(value)
    } else {
        times = self.newReg('I')
        let tv = self.lowerExpr(b)[0]
        self.mov(times, tv)
        let counted = self.label()
        let z = self.iconst(0)
        let neg = self.cmp(condLt, times, z)
        self.jz(neg, counted)
        let z2 = self.iconst(0)
        self.mov(times, z2)
        self.place(counted)
    }
    let bytes = self.elemBytes(self.ty(e))
    let count = if single { times } else { self.op2(.Mul, times, arr[1], 'I') }
    let ptr = self.alloc(count, bytes, line)
    let k = self.newReg('I')
    let z3 = self.iconst(0)
    self.mov(k, z3)
    let top = self.label()
    let done = self.label()
    self.depth += 1
    self.place(top)
    let end = self.cmp(condGe, k, count)
    self.jnz(end, done)
    if single {
        self.storeSlots(ptr, k, bytes, 0, v)
    } else {
        let at = self.op2(.Mod, k, arr[1], 'I')
        let x = self.loadElem(arr, at, self.elemOf(self.ty(e)))
        self.storeSlots(ptr, k, bytes, 0, x)
    }
    let o = self.iconst(1)
    self.emit(.Add, k, k, o)
    self.jmp(top)
    self.depth -= 1
    self.place(done)
    [ptr, count]
}

// an optional or a result the runtime left at p, by an rtcall of id
// runtime(group, name, values...) (a built-in's body, compiler/prelude.qk): the runtime's function by its name,
// each value's slots in order (and for runtimeLine the line of the call that reached the built-in); what it gives
// by the type: nothing, one slot as it is, or the slots at the address it gives (a result, an optional, a record)
fn Lower.lowerRuntimeCall(var self, e: Int, a: [Int], t: Int, line: Int) -> [Int] {
    let name = match self.p.ast.exprs[a[1]].node {
        TextLit(text, _, _) => text
        _ => ""
    }
    let id = runtimeNames.indexOf(name) ?? panic("the runtime has no function {name} (compiler/prelude.qk)")
    let at = if self.callerLine != 0 { self.callerLine } else { line }
    var args: [Int] = []
    for x in a[2..] {
        args += self.lowerExpr(x)
    }
    if name == "channel" {
        // a channel of T's: what its values are, for the copies it keeps
        let elem = self.p.ast.decls[self.p.types[t].decl].typeArgs[0]
        let desc = if self.own.holdsMemory(elem) {
            self.descAddress(self.p.arrayType(elem))
        } else {
            self.iconst(0)
        }
        args = [desc, self.iconst(self.slots(elem))]
    } else if name == "send" {
        // the value whole, by the address of its slots (a T of any size)
        args = [args[0], self.spill(args[1..], line)]
    } else if name == "receive" {
        args.push(self.iconst(self.slots(t))) // the T? it gives: its slots
    }
    let withLine = match self.p.ast.exprs[e].node {
        Call(called, _, _, _, _, _) => called == "runtimeLine"
        _ => false
    }
    if withLine {
        args.push(self.iconst(at))
    }
    let k = self.tk(t)
    if k is Void | Never {
        self.rtv(id, args, at)
        return []
    }
    if k == Kind.Float {
        return [self.rtcall(id, args, 'F', at)]
    }
    if k is Text | Bytes | Array {
        return self.unpackText(self.rtcall(id, args, 'I', at)) // [count][what it holds]: args()'s texts
    }
    if self.slots(t) == 1 and not (k == Kind.Enum and self.hasData(t)) {
        return [self.rtcall(id, args, 'I', at)]
    }
    self.slotsCall(id, args, t, at)
}

fn Lower.slotsCall(var self, id: Int, args: [Int], t: Int, line: Int) -> [Int] {
    let p = self.rtcall(id, args, 'I', line)
    self.loadSlots(p, t)
}

fn Lower.lowerBuiltin(var self, e: Int) -> [Int] {
    let x = self.p.ast.exprs[e]
    let a = self.argsOf(e)
    let line = x.line
    let b = x.builtin
    let t = x.ty
    if b == bParallelFold {
        return self.lowerParallelFold(e)
    }
    if b == bParallelMap {
        return self.lowerParallelMap(e)
    }
    if b == bCBytes or b == bTextOf and len(a) == 2 {
        return self.lowerCBytes(e)
    }
    if b == bInterface {
        let v0 = self.lowerExpr(a[0])
        let held = self.copyVal(v0)
        self.bind(x.binding, held)
        let r = self.valOf(t)
        if len(a) == 1 {
            let z = self.iconst(0)
            self.mov(r[0], z)
            let z2 = self.iconst(0)
            self.mov(r[1], z2)
            return r
        }
        let env = self.fnAddress(self.p.ast.exprs[a[1]].decl)[1]
        self.mov(r[1], env)
        let have = self.ty(a[0])
        var at = -1
        for tb in self.tables {
            if at < 0 and tb.have == have and tb.want == t {
                at = tb.at
            }
        }
        if at < 0 {
            while len(self.data) % 8 != 0 {
                self.data.push(0)
            }
            at = len(self.data)
            var fns: [Int] = []
            for f in 1..len(a) {
                self.data += le64(0)
                fns.push(self.fnIndex[self.dl(self.p.ast.exprs[a[f]].decl).index])
            }
            self.out.tables.push(IrTable(at, fns))
            self.tables.push(TableKey(have, t, at))
        }
        var fns: [Int] = []
        for tb in self.out.tables {
            if tb.at == at {
                fns = tb.fns
            }
        }
        let base = self.dataAddress(at)
        let zero = self.iconst(0)
        let ready = self.label()
        let first = self.newReg('I')
        self.emit(.Load, first, base, zero, imm: 8, c: 0)
        self.jnz(first, ready)
        var f = len(fns) - 1
        while f >= 0 {
            let fr = self.newReg('I')
            self.emit(.Const, fr, -1, -1, imm: fns[f], c: 2)
            self.emit(.Store, fr, base, zero, imm: 8, c: 8 * f)
            f -= 1
        }
        self.place(ready)
        self.mov(r[0], base)
        return r
    }
    if b == bOk {
        let v = self.lowerStored(a[0])
        return self.caseValue(t, 1, Some([v]))
    }
    if b == bErr {
        let m = self.lowerExpr(a[0])
        return self.caseValue(t, 0, Some([m]))
    }
    if b == bMapErr {
        let rv = self.lowerExpr(a[0])
        let r = self.copyVal(rv)
        let d = self.tdecl(self.ty(a[0]))
        let out = self.valOf(t)
        let err = self.label()
        let done = self.label()
        self.jz(r[0], err)
        let okAt = self.fieldOffset(d, 1, 0)
        let ok = self.fieldVal(self.caseFields(d, 1)[0], r[okAt..])
        let okv = self.caseValue(t, 1, Some([ok]))
        self.movVal(out, okv)
        self.jmp(done)
        self.place(err)
        let errAt = self.fieldOffset(d, 0, 0)
        let why = self.fieldVal(self.caseFields(d, 0)[0], r[errAt..])
        self.bindLambda(a[1], [why])
        let cv = self.lowerStored(self.lambdaBody(a[1]))
        let changed = self.copyVal(cv)
        let errv = self.caseValue(t, 0, Some([changed]))
        self.movVal(out, errv)
        self.place(done)
        return out
    }
    if b is 45 | 46 | 52 | 53 {
        let tv = self.lowerExpr(a[0])
        let id = if b == bWords {
            rtWords
        } else if b == bLines {
            rtLines
        } else if b == bUpper {
            rtUpper
        } else {
            rtLower
        }
        let p = self.rtcall(id, tv[..2], 'I', line)
        return self.unpackText(p)
    }
    if b is 49 | 50 {
        let tv = self.lowerExpr(a[0])
        let s = self.lowerExpr(a[1])
        return [
            self.rtcall(if b == bStartsWith { rtStartsWith } else { rtEndsWith }, [tv[0], tv[1], s[0], s[1]], 'I', line),
        ]
    }
    if b == bReplace {
        let tv = self.lowerExpr(a[0])
        let o = self.lowerExpr(a[1])
        let n = self.lowerExpr(a[2])
        let p = self.rtcall(rtReplace, [tv[0], tv[1], o[0], o[1], n[0], n[1]], 'I', line)
        return self.unpackText(p)
    }
    if b == bRepeat {
        let tv = self.lowerExpr(a[0])
        let n = self.lowerExpr(a[1])[0]
        let p = self.rtcall(rtRepeat, [tv[0], tv[1], n], 'I', line)
        return self.unpackText(p)
    }
    if b == bJoin {
        let arr = self.arrayOf(a[0], line)
        let sep = self.lowerExpr(a[1])
        let p = self.rtcall(rtJoin, [arr[0], arr[1], sep[0], sep[1]], 'I', line)
        return self.unpackText(p)
    }
    if b is 47 | 48 {
        let st = self.ty(self.stripImplicit(a[0]))
        if self.tk(st) == Kind.Text {
            let h = self.lowerExpr(a[0])
            let n = self.lowerExpr(a[1])
            let at = self.rtcall(rtFind, [h[0], h[1], n[0], n[1]], 'I', line)
            let z = self.iconst(0)
            let found = self.cmp(condGe, at, z)
            if b == bContains {
                return [found]
            }
            let r = self.valOf(t)
            self.mov(r[0], found)
            self.mov(r[1], at)
            return r
        }
        if self.tk(st) == Kind.Map {
            let m = self.lowerExpr(a[0])
            let k = self.lowerExpr(a[1])
            let ka = self.keyArgs(k, self.keyOf(st))
            let z = self.iconst(0)
            let p = self.mapLookup(m[0], ka, self.keyOf(st), line)
            return [self.cmp(condNe, p, z)]
        }
        let nv = self.lowerExpr(a[1])
        let needle = self.copyVal(nv)
        let result = if b == bContains { [self.iconst(0)] } else { self.valOf(t) }
        let z = self.iconst(0)
        self.mov(result[0], z)
        let elemT = if self.p.types[st].elem >= 0 {
            self.p.types[st].elem
        } else {
            tyError
        }
        self.forEach(a[0], .Searching(Search(result: result, needle: needle, elem: elemT, builtin: b, line: line)))
        return result
    }
    if b is 59 | 60 | 61 | 62 | 63 {
        let src = a[0]
        let st = self.ty(self.stripImplicit(src))
        let elem = if self.p.types[st].elem >= 0 {
            self.p.types[st].elem
        } else {
            tyError
        }
        if b == bLast and len(a) == 1 {
            let arr = self.lowerExpr(src)
            let r = self.valOf(t)
            let z = self.iconst(0)
            let some = self.cmp(condGt, arr[1], z)
            self.mov(r[0], some)
            let none = self.label()
            self.jz(r[0], none)
            let one = self.iconst(1)
            let at = self.op2(.Sub, arr[1], one, 'I')
            let last = self.loadElem(arr, at, elem)
            self.movVal(r[1..], last)
            self.place(none)
            return r
        }
        var s = Search(elem: elem, builtin: b, line: line, lambda: if len(a) > 1 { a[1] } else { -1 })
        if b == bCountOf {
            let c = self.newReg('I')
            s.result = [c]
            let z = self.iconst(0)
            self.mov(c, z)
        } else if b is 59 | 60 {
            let r = self.valOf(t)
            s.result = r
            let z = self.iconst(0)
            self.mov(r[0], z)
        } else {
            let r = self.valOf(elem)
            s.result = r
            s.keyType = self.ty(s.lambda)
            let bk = self.valOf(s.keyType)
            s.bestKey = bk
            let has = self.newReg('I')
            s.has = has
            let z = self.iconst(0)
            self.mov(has, z)
            for reg in r {
                let zz = if self.cur.kinds[reg] == 'F' {
                    self.fconst(0.0)
                } else {
                    self.iconst(0)
                }
                self.mov(reg, zz)
            }
            for reg in bk {
                let zz = if self.cur.kinds[reg] == 'F' {
                    self.fconst(0.0)
                } else {
                    self.iconst(0)
                }
                self.mov(reg, zz)
            }
        }
        self.forEach(src, .Searching(s))
        if b is 62 | 63 {
            let z = self.iconst(0)
            self.bounds(z, s.has, panicEmpty, line)
        }
        return s.result
    }
    if b is 56 | 57 {
        let arr = self.lowerExpr(a[0])
        let elem = self.elemOf(t)
        let lambda = if b == bSortBy { a[1] } else { -1 }
        let base = if b == bSortBy { 2 } else { 1 }
        var descending = -1
        if len(a) > base {
            let dv = self.lowerExpr(a[base])
            descending = self.copyVal(dv)[0]
        }
        return self.lowerSort(
            arr,
            elem,
            lambda,
            if lambda >= 0 { self.ty(lambda) } else { elem },
            descending,
            self.own.isFresh(a[0]),
            line,
        )
    }
    if b == bReverse {
        let av = self.lowerExpr(a[0])
        let arr = self.copyVal(av)
        let bytes = self.elemBytes(t)
        let ptr = self.alloc(arr[1], bytes, line)
        let k = self.newReg('I')
        let z = self.iconst(0)
        self.mov(k, z)
        let top = self.label()
        let done = self.label()
        self.depth += 1
        self.place(top)
        let end = self.cmp(condGe, k, arr[1])
        self.jnz(end, done)
        let one = self.iconst(1)
        let back = self.op2(.Sub, arr[1], k, 'I')
        let from = self.op2(.Sub, back, one, 'I')
        let v = self.loadElem(arr, from, self.elemOf(t))
        self.storeSlots(ptr, k, bytes, 0, v)
        let o = self.iconst(1)
        self.emit(.Add, k, k, o)
        self.jmp(top)
        self.depth -= 1
        self.place(done)
        return [ptr, arr[1]]
    }
    if b is 64 | 65 {
        let m = self.lowerExpr(a[0])
        let p = self.rtcall(if b == bKeys { rtMapKeys } else { rtMapValues }, m[..1], 'I', line)
        return self.unpackText(p)
    }
    if b == bAdd {
        let k = self.lowerExpr(a[1])
        let m = self.ownedPlaceValue(a[0])
        self.mapSet(m, k, self.keyOf(self.ty(a[0])), [], line)
        return []
    }
    if b == bToSet {
        let m = self.newMap(t, line)
        self.forEach(a[0], .ToSet(m[0], self.keyOf(t), line))
        return m
    }
    if b == bRemove {
        let k = self.lowerExpr(a[1])
        let m = self.ownedPlaceValue(a[0])
        let ka = self.keyArgs(k, self.keyOf(self.ty(a[0])))
        self.rtv(rtMapRemove, [m[0], ka[0], ka[1]], line)
        return []
    }
    if b == bIndex {
        return [self.lowerExpr(a[0])[0]]
    }
    if b == bCodePointCount {
        let tv = self.lowerExpr(a[0])
        return [self.rtcall(rtCodePointCount, tv[..2], 'I', line)]
    }
    if b == bAssert {
        let cond = self.lowerExpr(a[0])[0]
        let ok = self.label()
        self.jnz(cond, ok)
        let why = if len(a) > 1 {
            self.lowerExpr(a[1])
        } else {
            self.literalText("assert failed")
        }
        let where = self.lineHere(line)
        self.rtv(rtFailId, [why[0], why[1], where], line)
        self.place(ok)
        return []
    }
    if b == bSqrt {
        let v = self.lowerExpr(a[0])[0]
        return [self.op2(.Sqrt, v, -1, 'F')]
    }
    if b is 2 | 3 | 4 | 5 | 6 | 7 | 9 | 10 {
        let ids = [rtSin, rtCos, rtTan, rtAsin, rtAcos, rtAtan, 0, rtExp, rtLog]
        let v = self.lowerExpr(a[0])[0]
        return [self.rtcall(ids[b - bSin], [v], 'F', line)]
    }
    if b is 8 | 11 {
        let v0 = self.lowerExpr(a[0])[0]
        let v1 = self.lowerExpr(a[1])[0]
        return [self.rtcall(if b == bPow { rtPow } else { rtAtan2 }, [v0, v1], 'F', line)]
    }
    if b == bAbs {
        let v = self.lowerExpr(a[0])[0]
        if self.cur.kinds[v] == 'F' {
            let neg = self.op2(.Fneg, v, -1, 'F')
            return [self.op2(.Fmax, v, neg, 'F')]
        }
        let r = self.newReg('I')
        self.mov(r, v)
        let fine = self.label()
        let z = self.iconst(0)
        let neg = self.cmp(condLt, v, z)
        self.jz(neg, fine)
        self.emit(.Sub, r, z, v, line: self.lineOf(e), cond: 1) // abs(intMin): past the limits
        self.place(fine)
        return [r]
    }
    if b is 13 | 14 | 15 {
        var v = self.lowerExpr(a[0])[0]
        if self.cur.kinds[v] == 'I' {
            return [v]
        }
        if b == bRound {
            let half = self.fconst(0.5)
            v = self.op2(.Fadd, v, half, 'F')
        }
        let f = self.newReg('F')
        self.emit(.Round, f, v, -1, imm: if b == bCeil { 2 } else { 1 })
        return [self.floatToInt(f, line)]
    }
    if b == bToFloat {
        let v = self.lowerExpr(a[0])[0]
        return [if self.cur.kinds[v] == 'F' {
            v
        } else {
            self.op2(.IntToFloat, v, -1, 'F')
        }]
    }
    if b == bToInt {
        let v = self.lowerExpr(a[0])[0]
        return [if self.cur.kinds[v] == 'I' { v } else { self.floatToInt(v, line) }]
    }
    if b is 18 | 19 {
        let isMax = b == bMax
        if len(a) == 1 {
            let acc = self.valOf(t)
            let has = self.iconst(0)
            let z = if self.cur.kinds[acc[0]] == 'F' {
                self.fconst(0.0)
            } else {
                self.iconst(0)
            }
            self.mov(acc[0], z)
            self.forEach(a[0], .Extreme(acc[0], has, isMax))
            let z2 = self.iconst(0)
            self.bounds(z2, has, panicEmpty, line)
            return acc
        }
        let v0 = self.lowerExpr(a[0])[0]
        let v1 = self.lowerExpr(a[1])[0]
        if self.cur.kinds[v0] == 'F' {
            return [self.op2(if isMax { Op.Fmax } else { Op.Fmin }, v0, v1, 'F')]
        }
        let r = self.newReg('I')
        self.mov(r, v0)
        let fine = self.label()
        let c = self.cmp(if isMax { condGt } else { condLt }, v1, v0)
        self.jz(c, fine)
        self.mov(r, v1)
        self.place(fine)
        return [r]
    }
    if b == bClamp {
        let v = self.lowerExpr(a[0])[0]
        let lo = self.lowerExpr(a[1])[0]
        let hi = self.lowerExpr(a[2])[0]
        if self.cur.kinds[v] == 'F' {
            let m = self.op2(.Fmin, v, hi, 'F')
            return [self.op2(.Fmax, lo, m, 'F')]
        }
        let r = self.newReg('I')
        self.mov(r, v)
        let notHigh = self.label()
        let done = self.label()
        let c1 = self.cmp(condGt, r, hi)
        self.jz(c1, notHigh)
        self.mov(r, hi)
        self.place(notHigh)
        let c2 = self.cmp(condLt, r, lo)
        self.jz(c2, done)
        self.mov(r, lo)
        self.place(done)
        return [r]
    }
    if b == bLerp {
        let v0 = self.lowerExpr(a[0])[0]
        let v1 = self.lowerExpr(a[1])[0]
        let v2 = self.lowerExpr(a[2])[0]
        let d = self.op2(.Fsub, v1, v0, 'F')
        let m = self.op2(.Fmul, d, v2, 'F')
        return [self.op2(.Fadd, v0, m, 'F')]
    }
    if b == bLen {
        let src = self.stripImplicit(a[0])
        let sx = self.p.ast.exprs[src]
        if sx.node is Call(_, _, _, _, _, _) and sx.builtin == bCodePoints {
            let tv = self.lowerExpr(self.arg(src, 0))
            return [self.rtcall(rtCodePointCount, tv[..2], 'I', line)]
        }
        let sk = self.tk(sx.ty)
        if sk is Text | Bytes {
            return [self.lowerExpr(src)[1]]
        }
        if sk == Kind.Map {
            let m = self.lowerExpr(src)
            return [self.rtcall(rtMapLen, m[..1], 'I', line)]
        }
        if sk == Kind.Array and sx.node is Name(_) and sx.binding < 0 and sx.decl >= 0 {
            // a constant array's length: known, no array made for it
            let d = self.dl(sx.decl)
            let v = if d.folded >= 0 { d.folded } else { d.body }
            if d.kind == DeclKind.Const and v >= 0 and self.p.ast.exprs[v].node is ArrayLit(items) {
                return [self.iconst(len(items))]
            }
        }
        if sk == Kind.Array and not self.isLazyName(src) {
            return [self.lowerExpr(src)[1]]
        }
        let acc = self.iconst(0)
        self.forEach(a[0], .Count(acc))
        return [acc]
    }
    if b == bFill {
        let n = self.lowerExpr(a[0])[0]
        let v = self.lowerExpr(a[1])
        let bytes = len(v) * 8
        let count = self.newReg('I')
        self.mov(count, n)
        let ptr = self.alloc(count, bytes, line)
        let k = self.iconst(0)
        let top = self.label()
        let done = self.label()
        self.depth += 1
        self.place(top)
        let end = self.cmp(condGe, k, count)
        self.jnz(end, done)
        self.storeSlots(ptr, k, bytes, 0, v)
        let o = self.iconst(1)
        self.emit(.Add, k, k, o)
        self.jmp(top)
        self.depth -= 1
        self.place(done)
        return [ptr, count]
    }
    if b is 24 | 25 | 30 {
        return self.materialize(if b == bToArray { a[0] } else { e }, self.elemOf(t), line)
    }
    if b == bMean {
        let acc = self.newReg('F')
        let z = self.fconst(0.0)
        self.mov(acc, z)
        let has = self.newReg('I')
        let z2 = self.iconst(0)
        self.mov(has, z2)
        self.forEach(a[0], .Mean(acc, has))
        let z3 = self.iconst(0)
        self.bounds(z3, has, panicEmpty, line)
        let hf = self.op2(.IntToFloat, has, -1, 'F')
        return [self.op2(.Fdiv, acc, hf, 'F')]
    }
    if b == bCountBy {
        let m = self.newMap(t, line)
        self.forEach(a[0], .CountBy(m[0], self.keyOf(t), a[1], line))
        return m
    }
    if b == bGet {
        if self.ek(a[0]) == Kind.Bytes {
            let bv = self.lowerExpr(a[0])
            let bc = self.copyVal(bv)
            let i = self.lowerExpr(a[1])[0]
            let r = self.zeroOf(t)
            let none = self.label()
            let c1 = self.cmp(condLt, i, bc[1])
            self.jz(c1, none)
            let z = self.iconst(0)
            let c2 = self.cmp(condLt, i, z)
            self.jnz(c2, none)
            let one = self.iconst(1)
            self.mov(r[0], one)
            let byte = self.loadByte(bc[0], i)
            self.mov(r[1], byte)
            self.place(none)
            return r
        }
        let av = self.lowerExpr(a[0])
        let arr = self.copyVal(av)
        let i = self.lowerExpr(a[1])[0]
        let r = self.valOf(t)
        for reg in r {
            let zz = if self.cur.kinds[reg] == 'F' {
                self.fconst(0.0)
            } else {
                self.iconst(0)
            }
            self.mov(reg, zz)
        }
        let none = self.label()
        let c1 = self.cmp(condLt, i, arr[1])
        self.jz(c1, none)
        let z = self.iconst(0)
        let c2 = self.cmp(condLt, i, z)
        self.jnz(c2, none)
        let v = self.loadElem(arr, i, self.dl(self.tdecl(t)).optionOf)
        let one = self.iconst(1)
        self.mov(r[0], one)
        self.movVal(r[1..1 + len(v)], v)
        self.place(none)
        return r
    }
    if b == bPanic {
        let why = self.lowerExpr(a[0])
        let where = self.lineHere(line)
        self.rtv(rtFailId, [why[0], why[1], where], line)
        return []
    }
    if b == bNever {
        let _ = self.lowerExpr(a[0])
        return self.zeroOf(t)
    }
    if b is 81 | 82 | 91 | 92 {
        return self.materialize(e, self.elemOf(t), line)
    }
    if b == bSum {
        let acc = self.zeroOf(t)
        self.forEach(a[0], .Sum(acc, self.lineOf(e)))
        return acc
    }
    if b == bFold {
        let init = self.lowerExpr(a[1])
        let acc = self.valOf(t)
        self.movVal(acc, init)
        self.forEach(a[0], .Fold(acc, a[2]))
        return acc
    }
    if b is 28 | 29 {
        let acc = self.iconst(if b == bAll { 1 } else { 0 })
        self.forEach(a[0], .AnyOf(acc, a[1], b == bAll))
        return [acc]
    }
    if b is 31 | 68 {
        var vals: [[Int]] = []
        for v in a {
            let lv = self.lowerExpr(v)
            vals.push(if len(a) > 1 { self.copyVal(lv) } else { lv })
        }
        if b == bPrintErr {
            let two = self.iconst(2)
            self.rtv(rtPrintTo, [two], line)
        }
        for (i, v) in a.enumerate() {
            if i > 0 {
                self.rtv(rtPrintSep, [], 0)
            }
            self.printVal(vals[i], self.ty(v))
        }
        self.rtv(rtPrintEnd, [], 0)
        if b == bPrintErr {
            let one = self.iconst(1)
            self.rtv(rtPrintTo, [one], line)
        }
        return []
    }
    if b is 41 | 42 | 100 {
        let tv = self.lowerExpr(a[0])
        let args = [tv[0], tv[1]]
        let id = match b {
            41 => rtParseInt
            42 => rtParseFloat
            _ => rtTextOfBytes
        }
        let p = self.rtcall(id, args, 'I', line)
        let r = self.valOf(t)
        for i in 0..len(r) {
            let z = self.iconst(0)
            self.emit(.Load, r[i], p, z, imm: 8, c: 8 * i)
        }
        return r
    }
    if b == bRuntime {
        return self.lowerRuntimeCall(e, a, t, line)
    }
    if b == bDump {
        let v = self.lowerExpr(a[0])
        self.dumpVal(self.copyVal(v), self.ty(a[0]))
        return []
    }
    if b == bBytes {
        return self.lowerExpr(a[0])
    }
    if b == bChar {
        let v = self.lowerExpr(a[0])[0]
        let where = self.lineHere(line)
        let p = self.rtcall(rtChar, [v, where], 'I', line)
        return self.unpackText(p)
    }
    if b == bToBytes {
        return self.bytesOf(a[0], line)
    }
    if b == bCodePoints {
        return self.materialize(e, self.elemOf(t), line)
    }
    if b == bTrim {
        let tv = self.lowerExpr(a[0])
        let p = self.rtcall(rtTrim, [tv[0], tv[1]], 'I', line)
        return self.unpackText(p)
    }
    if b == bSplit {
        let tv = self.lowerExpr(a[0])
        let sep = self.lowerExpr(a[1])
        let p = self.rtcall(rtSplit, [tv[0], tv[1], sep[0], sep[1]], 'I', line)
        return self.unpackText(p)
    }
    if b == bSome {
        let v = self.lowerStored(a[0])
        return self.caseValue(t, 1, Some([v]))
    }
    if b == bToText {
        return self.textOf(a[0])
    }
    if b == bPop {
        let own = self.p.ast.exprs[a[0]].node is Name(_)
        var p = PlaceRef()
        if not own {
            p = self.changePlace(a[0])
        }
        let at0 = self.ty(a[0])
        let arr = if own {
            self.regsOf(self.p.ast.exprs[a[0]].binding)[..2]
        } else {
            self.readPlace(p, at0)
        }
        let r = self.valOf(t)
        let empty = self.label()
        let done = self.label()
        self.jz(arr[1], empty)
        let one = self.iconst(1)
        let n = self.op2(.Sub, arr[1], one, 'I')
        let last = if self.tk(at0) == Kind.Bytes {
            [self.loadByte(arr[0], n)]
        } else {
            self.loadElem(arr, n, self.elemOf(at0))
        }
        let some = self.caseValue(t, 1, Some([last]))
        self.movVal(r, some)
        if own {
            let shorter = self.copyVal([arr[0], n])
            self.movVal(arr, shorter)
        } else {
            self.writePlaceRaw(p, [arr[0], n])
        }
        self.jmp(done)
        self.place(empty)
        let none = self.caseValue(t, 0, None)
        self.movVal(r, none)
        self.place(done)
        return r
    }
    if b == bPush {
        let at0 = self.ty(a[0])
        let own = self.p.ast.exprs[a[0]].node is Name(_)
        if self.tk(at0) == Kind.Bytes {
            let v = self.lowerExpr(a[1])[0]
            if not self.p.ast.exprs[a[1]].node is IntLit(_, _) {
                let k = self.iconst(256)
                self.bounds(v, k, panicByte, line)
            }
            var p = PlaceRef()
            if not own {
                p = self.changePlace(a[0])
            }
            let bv = if own {
                self.regsOf(self.p.ast.exprs[a[0]].binding)[..2]
            } else {
                self.readPlace(p, at0)
            }
            let q = self.rtcall(rtBytesPush, [bv[0], bv[1], v], 'I', line)
            let grown = self.unpackText(q)
            if own { self.movVal(bv, grown) } else { self.writePlace(p, grown) }
            return []
        }
        let v = self.lowerInto(a[1], self.own.rootBinding(a[0]))
        let bytes = self.slots(self.elemOf(at0)) * 8
        if own {
            let holder = self.p.ast.exprs[a[0]].binding
            let arr = self.regsOf(holder)[..2]
            let ptr = self.pushRoom(arr[0], arr[1], bytes, holder, line)
            self.mov(arr[0], ptr)
            self.storeSlots(arr[0], arr[1], bytes, 0, v)
            let one = self.iconst(1)
            self.emit(.Add, arr[1], arr[1], one)
            if self.own.holdsMemory(self.elemOf(at0)) {
                let d = self.descAddress(at0)
                self.rtv(rtRemember, [arr[0], arr[1], d], line)
            }
            return []
        }
        let p = self.changePlace(a[0])
        let arr = self.readPlace(p, at0)
        let g0 = self.pushRoom(arr[0], arr[1], bytes, -1, line)
        self.storeSlots(g0, arr[1], bytes, 0, v)
        let one = self.iconst(1)
        let g1 = self.op2(.Add, arr[1], one, 'I')
        if self.own.holdsMemory(self.elemOf(at0)) {
            let d = self.descAddress(at0)
            self.rtv(rtRemember, [g0, g1, d], line)
        }
        self.writePlaceRaw(p, [g0, g1])
        return []
    }
    []
}

// How big a function's body is, in nodes (C's exprSize: the arguments as written).
fn Lower.exprSize(self, e: Int) -> Int {
    if e < 0 {
        return 0
    }
    var n = 1 + self.exprSize(self.aOf(e)) + self.exprSize(self.bOf(e))
    let x = self.p.ast.exprs[e]
    match x.node {
        Lambda(_, body) => {
            n += self.exprSize(body)
        }
        If(_, then, other) => {
            n += self.exprSize(other) + self.blockSize(then)
        }
        BlockExpr(block, _) => {
            n += self.blockSize(block)
        }
        _ => {}
    }
    for a in self.writtenArgs(e) {
        n += self.exprSize(a)
    }
    for a in self.armsOf(e) {
        n += self.exprSize(self.p.ast.arms[a].body)
    }
    n
}

fn Lower.stmtParts(self, s: Int) -> (Int, Int, Int, Int) = match self.p.ast.stmts[s].node {
    Let(_, _, _, value, _, _) => (value, -1, -1, -1)
    Assign(target, _, value) => (value, target, -1, -1)
    ExprStmt(value) => (value, -1, -1, -1)
    For(_, _, iter, body) => (-1, -1, iter, body)
    While(cond, body) => (cond, -1, -1, body)
    Return(value) => (value, -1, -1, -1)
    Defer(body) => (-1, -1, -1, body)
    _ => (-1, -1, -1, -1)
}

fn Lower.blockSize(self, b: Int) -> Int {
    if b < 0 {
        return 0
    }
    var n = 0
    for s in self.p.ast.blocks[b].stmts {
        let (value, target, iter, body) = self.stmtParts(s)
        n += 1 + self.exprSize(value) + self.exprSize(target) + self.exprSize(iter) + self.blockSize(body)
    }
    n
}

fn Lower.bodySize(var self, d: Int) -> Int {
    let i = self.dl(d).index
    if i < 0 {
        return self.exprSize(self.dl(d).body)
    }
    if self.sizeMemo[i] < 0 {
        let n = self.exprSize(self.dl(d).body)
        self.sizeMemo[i] = n
    }
    self.sizeMemo[i]
}

fn Lower.exprCost(var self, e: Int) -> Int {
    if e < 0 {
        return 0
    }
    var n = 1 + self.exprCost(self.aOf(e)) + self.exprCost(self.bOf(e))
    let x = self.p.ast.exprs[e]
    match x.node {
        Lambda(_, body) => {
            n += self.exprCost(body)
        }
        If(_, then, other) => {
            n += self.exprCost(other) + self.blockCost(then)
        }
        BlockExpr(block, _) => {
            n += self.blockCost(block)
        }
        _ => {}
    }
    for a in self.writtenArgs(e) {
        n += self.exprCost(a)
    }
    for a in self.armsOf(e) {
        n += self.exprCost(self.p.ast.arms[a].body)
    }
    let d = x.decl
    if d >= 0
        and self.dl(d).kind == DeclKind.Fn
        and not self.isCFunction(d)
        and self.dl(d).body >= 0
        and x.node is Call(_, _, _, _, _, _) | Binary(_, _, _) | Unary(_, _) {
        let c = self.inlineCostOf(d)
        if self.dl(d).inlineOnly or self.bodySize(d) <= inlineBody and c <= inlineCostMax {
            n += c
        }
    }
    n
}

fn Lower.blockCost(var self, b: Int) -> Int {
    if b < 0 {
        return 0
    }
    var n = 0
    for s in self.p.ast.blocks[b].stmts {
        let (value, target, iter, body) = self.stmtParts(s)
        n += 1 + self.exprCost(value) + self.exprCost(target) + self.exprCost(iter) + self.blockCost(body)
    }
    n
}

fn Lower.inlineCostOf(var self, d: Int) -> Int {
    let i = self.dl(d).index
    let c = self.inlineCost[i]
    if c < 0 {
        return 1
    }
    if c == 0 {
        self.inlineCost[i] = -1
        let n = self.exprCost(self.dl(d).body)
        self.inlineCost[i] = min(n, 1 << 20)
    }
    self.inlineCost[i]
}

// ---- C: its types' layout, values across the boundary, calls both ways ----
fn Lower.isCStruct(self, t: Int) -> Bool =
    t >= 0 and self.tk(t) == Kind.Record and self.tdecl(t) >= 0 and self.dl(self.tdecl(t)).cStruct

// Pointer<T>? and CText?: None is C's NULL (one slot in C)
fn Lower.cNullable(self, t: Int) -> Bool {
    let inner = self.p.fallibleValue(t)
    inner >= 0
        and self.tdecl(t) >= 0
        and self.dl(self.tdecl(t)).optionOf >= 0
        and (self.tk(inner) is Pointer | CFn or self.tk(inner) == Kind.Text and self.p.types[inner].c != 0)
}

fn Lower.cSize(self, t: Int) -> Int {
    let c = self.p.types[t].c
    if c == ctI8 or c == ctU8 {
        return 1
    }
    if c == ctI16 or c == ctU16 {
        return 2
    }
    if c == ctI32 or c == ctU32 or c == ctF32 {
        return 4
    }
    if self.tk(t) == Kind.Bool {
        return 1
    }
    if self.isCStruct(t) {
        var size = 0
        for ct in self.dl(self.tdecl(t)).cTypes {
            let a = self.cAlign(ct)
            size = (size + a - 1) / a * a + self.cSize(ct)
        }
        let a = self.cAlign(t)
        return (size + a - 1) / a * a
    }
    8
}

fn Lower.cAlign(self, t: Int) -> Int {
    if not self.isCStruct(t) {
        return self.cSize(t)
    }
    var a = 1
    for ct in self.dl(self.tdecl(t)).cTypes {
        a = max(a, self.cAlign(ct))
    }
    a
}

fn Lower.cFieldOffset(self, d: Int, field: Int) -> Int {
    let cts = self.dl(d).cTypes
    var at = 0
    for f in 0..field + 1 {
        let a = self.cAlign(cts[f])
        at = (at + a - 1) / a * a
        if f < field {
            at += self.cSize(cts[f])
        }
    }
    at
}

fn Lower.memKind(self, t: Int) -> Int {
    let c = self.p.types[t].c
    if c == ctI8 {
        return memI8
    }
    if c == ctU8 {
        return memU8
    }
    if c == ctI16 {
        return memI16
    }
    if c == ctU16 {
        return memU16
    }
    if c == ctI32 {
        return memI32
    }
    if c == ctU32 {
        return memU32
    }
    if c == ctF32 {
        return memF32
    }
    if self.tk(t) == Kind.Bool { memU8 } else { mem64 }
}

fn Lower.loadMem(var self, kind: Int, base: Int, index: Int, scale: Int, offset: Int, mem: Int) -> Int {
    let r = self.newReg(kind)
    let i = if index < 0 { self.iconst(0) } else { index }
    self.emit(.Load, r, base, i, imm: scale, c: offset, cond: mem)
    r
}

fn Lower.storeMem(var self, v: Int, base: Int, index: Int, scale: Int, offset: Int, mem: Int) {
    let i = if index < 0 { self.iconst(0) } else { index }
    self.emit(.Store, v, base, i, imm: scale, c: offset, cond: mem)
}

fn Lower.narrowInt(var self, r: Int, c: Int) -> Int {
    let bits = if c == ctI8 or c == ctU8 {
        8
    } else if c == ctI16 or c == ctU16 {
        16
    } else if c == ctI32 or c == ctU32 {
        32
    } else {
        64
    }
    if bits == 64 {
        return r
    }
    if c == ctU8 or c == ctU16 or c == ctU32 {
        let m = self.iconst(1 << bits - 1)
        return self.op2(.And, r, m, 'I')
    }
    let shift = self.iconst(64 - bits)
    let up = self.op2(.Shl, r, shift, 'I')
    self.op2(.Sar, up, shift, 'I')
}

fn Lower.floatBits32(var self, r: Int, toC: Bool) -> Int {
    var x = r
    if toC and self.cur.kinds[x] == 'I' {
        x = self.op2(.IntToFloat, x, -1, 'F')
    }
    let d = self.newReg('F')
    self.emit(.Round, d, x, -1, imm: if toC { 3 } else { 4 })
    d
}

fn Lower.cScalar(var self, t: Int, r: Int, toC: Bool) -> Int {
    let c = self.p.types[t].c
    if c == ctF32 {
        return self.floatBits32(r, toC)
    }
    if self.tk(t) == Kind.Int and c != 0 {
        return self.narrowInt(r, c)
    }
    if self.tk(t) == Kind.Float and toC and self.cur.kinds[r] == 'I' {
        return self.op2(.IntToFloat, r, -1, 'F')
    }
    r
}

fn Lower.cTextOf(var self, text: [Int], line: Int) -> Int =
    self.rtcall(rtCText, [text[0], text[1]], 'I', line)

fn Lower.textOfC(var self, p: Int, n: Int, line: Int) -> [Int] {
    let count = if n >= 0 { n } else { self.iconst(-1) }
    let q = self.rtcall(rtTextOfC, [p, count], 'I', line)
    self.loadSlots(q, tyText)
}

fn Lower.loadC(var self, t: Int, base: Int, index: Int, scale: Int, offset: Int, line: Int) -> [Int] {
    if self.isCStruct(t) {
        let d = self.tdecl(t)
        var r: [Int] = []
        for (f, ct) in self.dl(d).cTypes.enumerate() {
            let off = self.cFieldOffset(d, f)
            r += self.loadC(ct, base, index, scale, offset + off, line)
        }
        return r
    }
    if self.cNullable(t) {
        // a field that may be NULL: None
        return self.nullable(t, self.loadMem('I', base, index, scale, offset, mem64), line)
    }
    if self.tk(t) == Kind.Text {
        let p = self.loadMem('I', base, index, scale, offset, mem64)
        return self.textOfC(p, -1, line)
    }
    [self.loadMem(if self.tk(t) == Kind.Float { 'F' } else { 'I' }, base, index, scale, offset, self.memKind(t))]
}

fn Lower.storeC(var self, t: Int, v: [Int], base: Int, index: Int, scale: Int, offset: Int, line: Int) {
    if self.isCStruct(t) {
        let d = self.tdecl(t)
        var at = 0
        let ps = self.dl(d).params
        for (f, ct) in self.dl(d).cTypes.enumerate() {
            let n = self.slots(self.ptype(ps[f]))
            let off = self.cFieldOffset(d, f)
            self.storeC(ct, v[at..at + n], base, index, scale, offset + off, line)
            at += n
        }
        return
    }
    if self.cNullable(t) {
        self.storeMem(self.nullableToC(t, v, line), base, index, scale, offset, mem64)
        return
    }
    var r = if self.tk(t) == Kind.Text { self.cTextOf(v, line) } else { v[0] }
    if self.tk(t) == Kind.Float and self.cur.kinds[r] == 'I' {
        r = self.op2(.IntToFloat, r, -1, 'F')
    }
    self.storeMem(r, base, index, scale, offset, self.memKind(t))
}

// a struct's scalars, flattened: their offsets and kinds (4 a C float, 8 a double, < 0 an int of that many bytes)
fn Lower.flatMembers(self, t: Int, offset: Int, out: [(Int, Int)]) -> [(Int, Int)] {
    if self.isCStruct(t) {
        var o = out
        let d = self.tdecl(t)
        for (f, ct) in self.dl(d).cTypes.enumerate() {
            o = self.flatMembers(ct, offset + self.cFieldOffset(d, f), o)
        }
        return o
    }
    let kind = if self.p.types[t].c == ctF32 {
        4
    } else if self.tk(t) == Kind.Float {
        8
    } else {
        -self.cSize(t)
    }
    out + [(offset, kind)]
}

fn Lower.classify(var self, t: Int, result: Bool) -> CPass {
    if self.isCArray(t) {
        return CPass(kinds: ['I'])
    }
    if not self.isCStruct(t) {
        if self.cNullable(t) or self.tk(t) is Pointer | CFn or self.tk(t) == Kind.Text and self.p.types[t].c != 0 {
            return CPass(kinds: ['I'])
        }
        let k = self.slotKinds(t)
        return CPass(kinds: if len(k) > 64 { k[..64] } else { k })
    }
    let size = self.cSize(t)
    let words = (size + 7) / 8
    var p = CPass()
    if self.opts.arch == Arch.Arm64 {
        let members = self.flatMembers(t, 0, [])
        var hfa = len(members) >= 1 and len(members) <= 4 and members[0].1 > 0
        for i in 1..len(members) {
            if hfa {
                hfa = members[i].1 == members[0].1
            }
        }
        if hfa {
            p.hfa = true
            p.kinds = []
            for m in members {
                p.kinds.push('F')
                p.offsets.push(m.0)
                p.memberKinds.push(m.1)
            }
        } else if size <= 16 {
            p.kinds = []
            for _ in 0..words {
                p.kinds.push('I')
            }
        } else {
            p.byRef = true
        }
    } else if not self.opts.sysv {
        if size == 1 or size == 2 or size == 4 or size == 8 {
            p.kinds = ['I']
        } else {
            p.byRef = true
        }
    } else if size <= 16 {
        let members = self.flatMembers(t, 0, [])
        for w in 0..words {
            var floats = true
            for m in members {
                if m.0 / 8 == w and m.1 < 0 {
                    floats = false
                }
            }
            p.kinds.push(if floats { 'F' } else { 'I' })
        }
    } else if not result {
        for _ in 0..min(words, 64) {
            p.kinds.push('M')
        }
    } else {
        p.byRef = true
    }
    if p.byRef {
        let n = if result { min(words, 64) } else { 1 }
        p.kinds = []
        for _ in 0..n {
            p.kinds.push('I')
        }
    }
    p
}

fn Lower.structSlots(var self, pass: CPass, p: Int) -> [Int] {
    var out: [Int] = []
    for i in 0..len(pass.kinds) {
        if pass.hfa {
            out.push(
                self.loadMem('F', p, -1, 1, pass.offsets[i], if pass.memberKinds[i] == 4 { memF32Bits } else { mem64 }),
            )
        } else {
            out.push(self.loadMem(if pass.kinds[i] == 'F' { 'F' } else { 'I' }, p, -1, 1, 8 * i, mem64))
        }
    }
    out
}

fn Lower.slotsToStruct(var self, pass: CPass, regs: [Int], p: Int) {
    for i in 0..len(pass.kinds) {
        if pass.hfa {
            self.storeMem(regs[i], p, -1, 1, pass.offsets[i], if pass.memberKinds[i] == 4 { memF32Bits } else { mem64 })
        } else {
            self.storeMem(regs[i], p, -1, 1, 8 * i, mem64)
        }
    }
}

fn Lower.structRoom(var self, t: Int, line: Int) -> Int {
    let bytes = (self.cSize(t) + 15) / 8 * 8
    let one = self.iconst(1)
    self.alloc(one, bytes, line)
}

fn Lower.nullable(var self, t: Int, p: Int, line: Int) -> [Int] {
    let plain = self.p.plainType(t)
    var r = [0] * self.slots(plain)
    let z = self.iconst(0)
    r[0] = self.cmp(condNe, p, z)
    let inner = self.p.fallibleValue(t)
    if self.tk(inner) == Kind.Text {
        let text = self.textOfC(p, -1, line)
        r[1] = text[0]
        r[2] = text[1]
    } else {
        r[1] = p
    }
    r
}

fn Lower.nullableToC(var self, t: Int, v: [Int], line: Int) -> Int {
    let r = self.newReg('I')
    let z = self.iconst(0)
    self.mov(r, z)
    let none = self.label()
    self.jz(v[0], none)
    let x = if self.tk(self.p.fallibleValue(t)) == Kind.Text {
        self.cTextOf(v[1..3], line)
    } else {
        v[1]
    }
    self.mov(r, x)
    self.place(none)
    r
}

// An array of C's elements ([Float32], [Int16], [CText], [DivT]) given to C: C's array (its first element's address,
// as C's float xs[] is a float*), each element as C lays it out
fn Lower.isCArray(self, t: Int) -> Bool {
    if self.tk(t) != Kind.Array {
        return false
    }
    let e = self.elemOf(t)
    self.p.types[e].c != 0 or self.isCStruct(e)
}

// a Quark array as C's: a copy in the arena (a CText element zero-ended), its address
fn Lower.cArrayOf(var self, t: Int, v: [Int], line: Int) -> [Int] {
    let elem = self.elemOf(t)
    let plain = self.p.plainType(elem)
    let size = self.cSize(elem)
    let p = self.alloc(v[1], size, line)
    let i = self.countFrom()
    let top = self.label()
    let test = self.label()
    self.jmp(test)
    self.place(top)
    let x = self.loadElem(v, i, plain)
    self.storeC(elem, x, p, i, size, 0, line)
    self.countTo(i, v[1], top, test)
    [p]
}

// a loop's index: 0 (countTo: one more, and back to top while below n)
fn Lower.countFrom(var self) -> Int {
    let i = self.newReg('I')
    let zero = self.iconst(0)
    self.mov(i, zero)
    i
}

fn Lower.countTo(var self, i: Int, n: Int, top: Int, test: Int) {
    let one = self.iconst(1)
    self.emit(.Add, i, i, one)
    self.place(test)
    let more = self.cmp(condLt, i, n)
    self.jnz(more, top)
}

fn Lower.toCSlots(var self, t: Int, v: [Int], pass: CPass, line: Int) -> [Int] {
    if self.isCArray(t) {
        return self.cArrayOf(t, v, line)
    }
    if self.isCStruct(t) {
        let p = self.structRoom(t, line)
        self.storeC(t, v, p, -1, 1, 0, line)
        if pass.byRef {
            return [p]
        }
        return self.structSlots(pass, p)
    }
    if self.cNullable(t) {
        return [self.nullableToC(t, v, line)]
    }
    if self.tk(t) == Kind.Text and self.p.types[t].c != 0 {
        return [self.cTextOf(v, line)]
    }
    if self.p.types[t].c != 0 {
        return [self.cScalar(t, v[0], true)]
    }
    let n = min(len(v), len(pass.kinds))
    v[..n]
}

fn Lower.fromCSlots(var self, t: Int, regs: [Int], pass: CPass, result: Bool, line: Int) -> [Int] {
    if self.isCStruct(t) {
        if pass.byRef and not result {
            return self.loadC(t, regs[0], -1, 1, 0, line)
        }
        var p = 0
        if pass.byRef {
            let one = self.iconst(1)
            p = self.alloc(one, 8 * len(pass.kinds), line)
        } else {
            p = self.structRoom(t, line)
        }
        self.slotsToStruct(pass, regs, p)
        return self.loadC(t, p, -1, 1, 0, line)
    }
    if self.cNullable(t) {
        return self.nullable(t, regs[0], line)
    }
    if self.tk(t) == Kind.Text and self.p.types[t].c != 0 {
        return self.textOfC(regs[0], -1, line)
    }
    if self.p.types[t].c != 0 {
        return [self.cScalar(t, regs[0], false)]
    }
    if self.tk(t) == Kind.Bool {
        let z = self.iconst(0)
        let k = self.iconst(255)
        let low = self.op2(.And, regs[0], k, 'I')
        return [self.cmp(condNe, low, z)]
    }
    regs[..len(pass.kinds)]
}

// std.machine's built-ins
fn Lower.machineKind(self, d: Int) -> Int {
    let x = self.dl(d)
    if not self.isCFunction(d)
        or x.module == 0
        or x.module >= len(self.p.modules)
        or self.p.modules[x.module].path != "std/machine.qk" {
        return machineNone
    }
    match x.name {
        "switchStack" => machineSwitchStack
        "frame" => machineFrame
        "cpu" => machineCpu
        "call" => machineCall
        "address" => machineAddress
        "context" => machineContext
        "setContext" => machineSetContext
        "fillRuntime" => machineFillRuntime
        _ => machineNone
    }
}

fn Lower.lateFor(var self, kind: Int, d: Int, cTypes: [Int], exportName: Text?) -> Int {
    for (i, l) in self.lates.enumerate() {
        if l.kind != kind or len(l.cTypes) != len(cTypes) {
            continue
        }
        if kind != 0 and self.declName(l.decl) != self.declName(d) {
            continue
        }
        if kind == 0 and l.decl != d {
            continue
        }
        if (l.exportName != None) != (exportName != None) {
            continue
        }
        if l.cTypes == cTypes {
            return i
        }
    }
    self.lates.push(Late(kind, d, cTypes, exportName))
    len(self.lates) - 1
}

fn Lower.latePatch(var self, late: Int) {
    self.latePatches.push(LatePatch(self.fnId, len(self.cur.code) - 1, late))
}

fn Lower.cFunctionValue(var self, d: Int, cfn: Int) -> [Int] {
    let ty = self.p.types[cfn]
    let late = self.lateFor(0, d, ty.params + [ty.elem], None)
    let r = self.newReg('I')
    self.emit(.Const, r, -1, -1, imm: 0, c: 2)
    self.latePatch(late)
    [r]
}

fn flat(args: [[Int]]) -> [Int] {
    var out: [Int] = []
    for a in args {
        out += a
    }
    out
}

fn Lower.machineCall(var self, line: Int, d: Int, kind: Int, args: [[Int]]) -> [Int] {
    let late = self.lateFor(kind, d, [], None)
    let all = flat(args)
    let k = self.emitAt(.Call, -1, -1, -1, imm: 0, line: line)
    self.latePatch(late)
    self.cur.setArgs(k, all)
    let r = self.valOf(self.dl(d).retType)
    self.setRets(k, r)
    self.maxOut(max(len(all), len(r)))
    r
}

// A call to C (or to the host): its function, its arguments as C takes them.
fn Lower.hostCall(var self, line: Int, d: Int, args: [[Int]], cTypes: [Int]) -> [Int] {
    let kind = self.machineKind(d)
    if kind == machineAddress {
        return [args[0][0]] // a text's first slot: its bytes' address
    }
    if kind == machineContext {
        let r = self.newReg('I')
        self.emit(.Ctx, r, -1, -1)
        return [r]
    }
    if kind == machineSetContext {
        self.emit(.Ctx, -1, args[0][0], -1, cond: 1)
        return []
    }
    if kind == machineFillRuntime {
        // each runtime function's address (its Quark function: qk_<name>), by its number; 0 where none is
        var bySymbol: [Text: Int] = [:]
        for rd in self.p.decls {
            let y = self.dl(rd)
            if y.kind == DeclKind.Fn and y.isExtern and y.body >= 0 and y.externSymbol.startsWith("qk_") {
                bySymbol[y.externSymbol] = self.fnIndex[y.index]
            }
        }
        let z = self.iconst(0)
        for (i, name) in runtimeNames.enumerate() {
            let fr = self.newReg('I')
            if bySymbol["qk_" + name] is Some(f) {
                self.emit(.Const, fr, -1, -1, imm: f, c: 2)
            } else {
                self.emit(.Const, fr, -1, -1, imm: 0)
            }
            self.emit(.Store, fr, args[0][0], z, imm: 8, c: 8 * i)
        }
        return []
    }
    if kind != machineNone {
        return self.machineCall(line, d, kind, args)
    }
    let x = self.dl(d)
    let count = len(args)
    var pass: [CPass] = []
    var slots = 0
    for i in 0..count {
        let c = self.classify(cTypes[i], false)
        slots += len(c.kinds)
        pass.push(c)
    }
    let ret = self.classify(cTypes[count], true)
    let retHidden = ret.byRef
    var kinds: Bytes = []
    var fixed = -1 // a variadic call: the C slots before its variadic ones
    for (i, c) in pass.enumerate() {
        if x.variadic and i == len(x.params) {
            fixed = len(kinds)
        }
        kinds += c.kinds
    }
    if x.variadic and fixed < 0 {
        fixed = len(kinds)
    }
    // one extern a declaration (a variadic one: one for each way its values are given)
    let key = "{x.index}:" + bytesText(kinds)
    var index = if x.variadic {
        self.variadicExterns[key] ?? -1
    } else {
        self.externIndex[x.index]
    }
    if index < 0 {
        index = len(self.out.externs)
        if x.variadic {
            self.variadicExterns[key] = index
        } else {
            self.externIndex[x.index] = index
        }
        self.out.externs.push(
            IrExtern(
                if x.externSymbol != "" { x.externSymbol } else { x.name },
                lib: if x.externLib != "" { Some(x.externLib) } else { None },
                retHidden: retHidden,
                argKinds: kinds,
                retKinds: ret.kinds,
                fixed: fixed,
            ),
        )
    }
    var cArgs: [Int] = []
    for i in 0..count {
        cArgs += self.toCSlots(cTypes[i], args[i], pass[i], line)
    }
    let k = self.emitAt(.HostCall, -1, -1, -1, imm: index, line: line)
    self.cur.setArgs(k, cArgs)
    var rets: [Int] = []
    for c in ret.kinds {
        rets.push(self.newReg(if c == 'F' { 'F' } else { 'I' }))
    }
    self.setRets(k, rets)
    let hidden = if len(ret.kinds) > 1 or retHidden { 1 } else { 0 }
    let room = max(slots + hidden, 4) + (if hidden == 1 { len(ret.kinds) } else { 0 })
    self.maxOut(room)
    if self.tk(cTypes[count]) == Kind.Void {
        return []
    }
    self.fromCSlots(cTypes[count], rets, ret, true, line)
}

// f(a, b) of a C function value: a call of its address the platform's C way, its values as C's types take them
fn Lower.lowerCCall(var self, e: Int) -> [Int] {
    let x = self.p.ast.exprs[e]
    let line = x.line
    let ft = self.p.types[self.ty(x.callee)]
    let address = self.copyVal(self.lowerExpr(x.callee))[0]
    var args: [[Int]] = []
    for o in x.ordered {
        args.push(self.lowerExpr(o))
    }
    let cTypes = ft.params + [ft.elem]
    var pass: [CPass] = []
    var slots = 0
    var kinds: Bytes = []
    for i in 0..len(args) {
        let c = self.classify(cTypes[i], false)
        slots += len(c.kinds)
        kinds += c.kinds
        pass.push(c)
    }
    let ret = self.classify(ft.elem, true)
    let key = bytesText(kinds) + ">" + bytesText(ret.kinds) + (if ret.byRef { "&" } else { "" })
    var index = self.cSigIndex[key] ?? -1
    if index < 0 {
        index = len(self.out.cSigs)
        self.cSigIndex[key] = index
        self.out.cSigs.push(IrExtern("", retHidden: ret.byRef, argKinds: kinds, retKinds: ret.kinds))
    }
    var cArgs: [Int] = []
    for i in 0..len(args) {
        cArgs += self.toCSlots(cTypes[i], args[i], pass[i], line)
    }
    self.touch(address)
    let k = self.emitAt(.HostCall, -1, address, -1, imm: index, line: line)
    self.cur.setArgs(k, cArgs)
    var rets: [Int] = []
    for c in ret.kinds {
        rets.push(self.newReg(if c == 'F' { 'F' } else { 'I' }))
    }
    self.setRets(k, rets)
    let hidden = if len(ret.kinds) > 1 or ret.byRef { 1 } else { 0 }
    self.maxOut(max(slots + hidden, 4) + (if hidden == 1 { len(ret.kinds) } else { 0 }))
    if self.tk(ft.elem) == Kind.Void {
        return []
    }
    self.fromCSlots(ft.elem, rets, ret, true, line)
}

fn Lower.isCPlace(self, e: Int) -> Bool {
    var x = e
    while self.p.ast.exprs[x].node is Field(t, _) and self.isCStruct(self.ty(t)) {
        x = self.aOf(x)
    }
    let Index(t, _) = self.p.ast.exprs[x].node else {
        return false
    }
    self.ty(t) >= 0 and self.ek(t) == Kind.Pointer
}

fn Lower.cPlaceOf(var self, e: Int) -> CPlace {
    let x = self.p.ast.exprs[e]
    if x.node is Field(t, _) {
        var p = self.cPlaceOf(t)
        let d = self.tdecl(self.ty(t))
        p.offset += self.cFieldOffset(d, x.caseIndex)
        p.t = self.dl(d).cTypes[x.caseIndex]
        return p
    }
    let a = self.aOf(e)
    let base = self.lowerExpr(a)[0]
    let index = self.lowerExpr(self.bOf(e))[0]
    let t = self.elemOf(self.ty(a))
    CPlace(base: base, index: index, t: t, scale: self.cSize(t))
}

fn Lower.readCPlace(var self, e: Int) -> [Int] {
    let p = self.cPlaceOf(e)
    self.loadC(p.t, p.base, p.index, p.scale, p.offset, self.lineOf(e))
}

fn Lower.lowerCAssign(var self, s: Int, target: Int, op: Int, value: Int) {
    let line = self.p.ast.stmts[s].line
    let p = self.cPlaceOf(target)
    var v = self.lowerExpr(value)
    if op != 0 {
        let cur = self.loadC(p.t, p.base, p.index, p.scale, p.offset, line)
        let f = self.cur.kinds[cur[0]] == 'F'
        var y = v[0]
        if f and self.cur.kinds[y] == 'I' {
            y = self.op2(.IntToFloat, y, -1, 'F')
        }
        let irOp = if op == 1 {
            if f { Op.Fadd } else { Op.Add }
        } else if op == 2 {
            if f { Op.Fsub } else { Op.Sub }
        } else if op == 3 {
            if f { Op.Fmul } else { Op.Mul }
        } else if f {
            Op.Fdiv
        } else {
            Op.Div
        }
        let r = self.newReg(if f { 'F' } else { 'I' })
        self.emit(irOp, r, cur[0], y, line: line)
        v = [r]
    }
    self.storeC(p.t, v, p.base, p.index, p.scale, p.offset, line)
}

// The C entry of Quark function late.decl: C's arguments made Quark's, the function called, its result made C's.
fn Lower.lowerCEntry(var self, late: Late) {
    let d = late.decl
    let x = self.dl(d)
    let n = len(late.cTypes) - 1
    let cRet = late.cTypes[n]
    self.cur = IrFn(x.name + " (from C)", line: x.line, exportName: late.exportName)
    self.current = d
    self.depth = 0
    self.inl = 0
    self.inlining = []
    let ret = self.classify(cRet, true)
    let hidden = self.isCStruct(cRet) and ret.byRef
    var params: [Int] = []
    var kinds: Bytes = []
    var hiddenAt = -1
    if hidden {
        hiddenAt = self.newReg('I')
        params.push(hiddenAt)
        kinds.push('I')
    }
    var firsts: [Int] = []
    var pass: [CPass] = []
    for i in 0..n {
        let c = self.classify(late.cTypes[i], false)
        firsts.push(len(params))
        for k in c.kinds {
            params.push(self.newReg(if k == 'F' { 'F' } else { 'I' }))
            kinds.push(k)
        }
        pass.push(c)
    }
    self.cur.params = params
    self.cur.cArgs = Some(kinds)
    self.cur.cHidden = hidden
    var args: [[Int]] = []
    for i in 0..n {
        let from = firsts[i]
        let v = self.fromCSlots(late.cTypes[i], params[from..from + len(pass[i].kinds)], pass[i], false, x.line)
        args.push(v)
    }
    if x.lifted {
        args.push([self.iconst(0)])
    }
    let all = flat(args)
    let k = self.emitAt(.Call, -1, -1, -1, imm: self.fnIndex[x.index], line: x.line)
    self.cur.setArgs(k, all)
    let r = self.valOf(x.retType)
    self.setRets(k, r)
    self.maxOut(len(all))
    self.maxOut(len(r))
    var out: [Int] = []
    var retKinds: Bytes = []
    if self.tk(cRet) == Kind.Void {} else if hidden {
        self.storeC(cRet, r, hiddenAt, -1, 1, 0, x.line)
        out = [hiddenAt]
        retKinds = ['I']
    } else {
        out = self.toCSlots(cRet, r, ret, x.line)
        retKinds = ret.kinds
    }
    self.cur.cRets = retKinds
    self.cur.resultCount = len(out)
    self.maxOut(len(out))
    let rt = self.emitAt(.Ret, -1, -1, -1)
    self.cur.setArgs(rt, out)
    for o in out {
        self.touch(o)
    }
}

fn Lower.lowerMachine(var self, late: Late) {
    let names = ["", "machine.switchStack", "machine.frame", "machine.cpu", "machine.call"]
    self.cur = IrFn(names[late.kind], machine: late.kind, line: self.dl(late.decl).line)
    let count = if late.kind == machineSwitchStack {
        2
    } else if late.kind == machineCall {
        5
    } else {
        0
    }
    var params: [Int] = []
    for _ in 0..count {
        params.push(self.newReg('I'))
    }
    self.cur.params = params
    self.cur.resultCount = if late.kind == machineSwitchStack { 0 } else { 1 }
    self.cur.maxOut = max(count, 2)
}

// A call with its values lowered already.
fn Lower.callDecl(var self, d: Int, given: [[Int]], line: Int) -> [Int] {
    var args = given
    for i in 0..len(args) {
        if self.paramByRef(d, i) {
            args[i] = self.refOf(args[i])
        }
    }
    let all = flat(args)
    let k = self.emitAt(.Call, -1, -1, -1, imm: self.fnIndex[self.dl(d).index], line: line)
    self.cur.setArgs(k, all)
    let r = self.valOf(self.dl(d).retType)
    self.setRets(k, r)
    self.maxOut(max(len(all), len(r)))
    r
}

fn Lower.inlinedSmall(var self, g: Int) -> Bool =
    self.dl(g).inlineOnly or self.bodySize(g) <= inlineBody and self.inlineCostOf(g) <= inlineCostMax

fn Lower.wantsPlace(var self, g: Int) -> Bool {
    if not self.selfByAddress(g) {
        return false
    }
    not self.inlinedSmall(g) or self.keepsSelfInMemory(g)
}

fn Lower.keepsSelfInMemory(var self, d: Int) -> Bool {
    let i = self.dl(d).index
    if self.selfMemo[i] == 3 {
        return true
    }
    if self.selfMemo[i] == 0 {
        self.selfMemo[i] = 3
        let x = self.dl(d)
        if x.body >= 0 {
            let selfBinding = self.pbind(x.params[0])
            for e in self.own.visitExpr(x.body, []) {
                if e < 0 {
                    continue
                }
                let b = self.own.selfCallOn(e)
                if b >= 0 and b == selfBinding and self.wantsPlace(self.p.ast.exprs[e].decl) {
                    self.selfMemo[i] = 2
                }
            }
        }
        if self.selfMemo[i] == 3 {
            self.selfMemo[i] = 1
        }
    }
    self.selfMemo[i] == 2
}

fn Lower.selfInRegs(var self, d: Int) -> Bool {
    if not self.selfByAddress(d)
        or self.keepsSelfInMemory(d)
        or self.slots(self.bt(self.pbind(self.dl(d).params[0]))) > selfRegistersMost {
        return false
    }
    let body = self.dl(d).body
    if body < 0 {
        return false
    }
    for e in self.own.visitExpr(body, []) {
        if e < 0 and self.p.ast.stmts[-1 - e].node is For(_, _, _, _) | While(_, _) {
            return true
        }
    }
    false
}

// A read of a var kept in memory (a large var self, by address), or of its fields: read when its value is used, after
// what is worked out next to it (f(self, self.add(t)): self as the call left it, as a var in registers is).
fn Lower.addressRead(self, e: Int) -> Bool {
    var x = e
    while x >= 0 and self.p.ast.exprs[x].node is Field(t, _) and self.p.ast.exprs[x].callee < 0 {
        x = t
    }
    x >= 0
        and self.p.ast.exprs[x].node is Name(_)
        and self.p.ast.exprs[x].binding >= 0
        and self.atAddress[self.p.ast.exprs[x].binding]
}

fn Lower.placeAddress(var self, p: PlaceRef) -> Int {
    var at = p.base
    if p.stride != 0 {
        let s = self.iconst(p.stride)
        let m = self.op2(.Mul, p.index, s, 'I')
        at = self.op2(.Add, at, m, 'I')
    }
    if p.offset != 0 {
        let o = self.iconst(p.offset)
        at = self.op2(.Add, at, o, 'I')
    }
    at
}

fn Lower.lowerCall(var self, e: Int) -> [Int] {
    let x = self.p.ast.exprs[e]
    if x.builtin != 0 {
        return self.lowerBuiltin(e)
    }
    let Call(name, _, args, _, _, _) = x.node else {
        return self.callOperator(e)
    }
    if name.startsWith("Pointer<") {
        return [self.lowerExpr(x.ordered[0])[0]]
    }
    if x.callee >= 0 and self.tk(self.ty(x.callee)) == Kind.CFn {
        return self.lowerCCall(e)
    }
    let kept = x.binding >= 0 and self.tk(self.bt(x.binding)) == Kind.Fn and self.p.bindings[x.binding].lambda < 0
    if kept or x.callee >= 0 {
        let fv = if x.callee >= 0 {
            self.lowerExpr(x.callee)
        } else {
            self.nameValue(x.binding, 0)
        }
        let f = self.copyVal(fv)
        let ft = if x.callee >= 0 { self.ty(x.callee) } else { self.bt(x.binding) }
        var vals: [[Int]] = []
        for o in x.ordered {
            vals.push(self.lowerExpr(o))
        }
        vals.push([f[1]])
        let all = flat(vals)
        let k = self.emitAt(.Call, -1, f[0], -1, imm: -1, line: x.line)
        self.cur.setArgs(k, all)
        let r = self.valOf(self.elemOf(ft))
        self.setRets(k, r)
        self.maxOut(max(len(all), len(r)))
        return r
    }
    if x.binding >= 0 and self.tk(self.bt(x.binding)) == Kind.Fn {
        let lam = self.p.bindings[x.binding].lambda
        var vals: [[Int]] = []
        for a in args {
            let v = self.lowerExpr(a)
            vals.push(self.copyVal(v))
        }
        self.bindLambda(lam, vals)
        let v = self.lowerExpr(self.lambdaBody(lam))
        return self.copyVal(v)
    }
    self.callOperator(e)
}

// a record's or a case's making (x.decl a type or an enum): each field's value kept (deep: all it holds its own,
// as a deep var's value is, so the value made needs no deep copy after)
fn Lower.construct(var self, e: Int, deep: Bool) -> [Int] {
    let x = self.p.ast.exprs[e]
    let d = self.boundExtern(x.decl)
    let dx = self.dl(d)
    if dx.kind == DeclKind.Type {
        let r = self.valOf(dx.ty)
        for pass in 0..2 {
            for (f, prm) in dx.params.enumerate() {
                if self.addressRead(x.ordered[f]) == (pass == 1) {
                    let v = if deep {
                        self.lowerOwned(x.ordered[f], true)
                    } else {
                        self.lowerStored(x.ordered[f])
                    }
                    let off = self.recordOffset(d, f)
                    self.setField(prm, r[off..], v, x.line)
                }
            }
        }
        return r
    }
    let n = len(self.caseFields(d, x.caseIndex))
    var fields: [[Int]] = []
    for i in 0..n {
        fields.push(if deep {
            self.lowerOwned(x.ordered[i], true)
        } else {
            self.lowerStored(x.ordered[i])
        })
    }
    self.caseValue(dx.ty, x.caseIndex, Some(fields))
}

// a call of a function, a record's or a case's making, or an operator of a type (its function)
fn Lower.callOperator(var self, e: Int) -> [Int] {
    let x = self.p.ast.exprs[e]
    let d = self.boundExtern(x.decl)
    let dx = self.dl(d)
    if dx.kind is Type | Enum {
        return self.construct(e, false)
    }
    let values = if len(x.ordered) > 0 { x.ordered } else { self.writtenArgs(e) }
    let count = len(values)
    var args: [[Int]] = [[]] * count
    let changes = self.own.changesSelf(d) and count > 0
    var byRef = [false] * count // args[i]: the address of its value, in memory
    let selfRoot = if changes { self.own.rootBinding(values[0]) } else { -1 }
    for pass in 0..2 {
        for i in (if changes { 1 } else { 0 })..count {
            if self.addressRead(values[i]) != (pass == 1) {
                continue
            }
            if self.paramByRef(d, i)
                and self.memoryPlace(values[i])
                and (selfRoot < 0 or self.own.rootBinding(values[i]) != selfRoot) {
                let pl = self.placeOf(values[i]) // where it is: nothing read, nothing copied
                args[i] = [self.placeAddress(pl)]
                byRef[i] = true
                continue
            }
            var v = self.lowerExpr(values[i])
            if changes
                and self.holdsContainers(self.ty(values[i]))
                and self.own.aliasesDeep(values[i])
                and self.own.sharedWithCall(values[i], selfRoot) {
                v = self.deepCopy(v, self.ty(values[i]), x.line)
            }
            args[i] = v
        }
    }
    var selfPlace = PlaceRef()
    var selfAt = -1
    if changes {
        selfPlace = self.changePlace(values[0])
        var alone = true // a var's own memory (its fields): no value reaches it (none did where its address was taken)
        if not self.memoryPlace(values[0]) {
            for i in 1..count {
                if alone {
                    alone = self.own.reachesNoPlace(self.ty(values[i]))
                }
            }
        }
        if selfPlace.memory
            and not selfPlace.boxed
            and alone
            and not self.opts.debug
            and self.slots(self.ty(values[0])) > selfInRegisters {
            selfAt = self.placeAddress(selfPlace)
        } else {
            args[0] = self.readPlace(selfPlace, self.ty(values[0]))
        }
    }
    if self.isCFunction(d) {
        var cTypes = dx.cTypes
        if dx.variadic {
            // C's variadic arguments: each value as C takes it (a Text zero-ended)
            let fixed = len(dx.params)
            cTypes = dx.cTypes[..fixed]
            for v in values[fixed..] {
                let t = self.ty(v)
                cTypes.push(if self.tk(t) == Kind.Text { tyC + ctText } else { t })
            }
            cTypes.push(dx.cTypes[fixed])
        }
        return self.hostCall(x.line, d, args, cTypes)
    }
    var inside = false
    for fr in self.inlining {
        if fr.d == d {
            inside = true
        }
    }
    let depth = len(self.inlining)
    var small = not self.opts.debug
        and not inside
        and depth < 8
        and d != self.current
        and self.bodySize(d) <= inlineBody
    if small and not dx.inlineOnly {
        let cost = self.inlineCostOf(d)
        small = cost <= inlineCostMax and self.inlined + cost <= inlineBudget
    }
    if small or dx.inlineOnly and depth < 32 {
        self.inlined += self.bodySize(d)
        var saved: [([Int], Bool, Int, Bool)] = []
        for (i, prm) in dx.params.enumerate() {
            let b = self.pbind(prm)
            saved.push((self.regs[b], self.atAddress[b], self.addrReg[b], self.bound[b]))
            if byRef[i] {
                self.bind(b, [])
                self.atAddress[b] = true
                self.addrReg[b] = args[i][0]
            } else {
                self.bind(b, args.get(i) ?? [])
                self.atAddress[b] = false
            }
        }
        let inPlace = changes and selfAt >= 0 and not self.selfInRegs(d)
        if changes and selfAt >= 0 and not inPlace {
            let rv = self.readPlace(selfPlace, self.ty(values[0]))
            args[0] = rv // a loop over its fields: registers
        }
        let selfB = if len(dx.params) > 0 { self.pbind(dx.params[0]) } else { -1 }
        if inPlace {
            self.regs[selfB] = []
            self.atAddress[selfB] = true
            self.addrReg[selfB] = selfAt
        } else if changes {
            let c = self.copyVal(args[0])
            self.bind(selfB, c)
        }
        let savedInl = self.inl
        let savedCaller = self.callerLine
        if dx.builtin {
            // the language's own: no frame of its own in a trace, its lines the caller's
            if self.callerLine == 0 {
                self.callerLine = x.line
            }
        } else {
            let call = InlineCall(savedInl, self.shownName(d), x.line)
            if len(self.inlines) == 0 {
                self.inlines.push(call)
            }
            self.inl = len(self.inlines)
            self.inlines.push(call)
        }
        let end = self.label()
        let result = self.valOf(dx.retType)
        self.inlining.push(Frame(d, end, result))
        let savedBreak = self.userBreak
        let savedContinue = self.userContinue
        let v = if self.isBlockExpr(dx.body) {
            self.lowerBlock(self.blockOfExpr(dx.body), dx.retType)
        } else {
            self.lowerStored(dx.body)
        }
        if len(v) > 0 {
            self.movVal(result, v)
        }
        self.place(end)
        if inPlace {
            self.rememberPlace(selfPlace)
        } else if changes {
            let back = self.regsOf(selfB)[..len(args[0])]
            self.writePlaceRaw(selfPlace, back)
        }
        self.userBreak = savedBreak
        self.userContinue = savedContinue
        self.inlining.pop()
        self.inl = savedInl
        self.callerLine = savedCaller
        for (i, prm) in dx.params.enumerate() {
            let b = self.pbind(prm)
            let (r, at, reg, was) = saved[i]
            self.regs[b] = r
            self.bound[b] = was
            self.atAddress[b] = at and reg >= 0
            self.addrReg[b] = reg
        }
        return result
    }
    for i in (if changes { 1 } else { 0 })..count {
        if self.paramByRef(d, i) and not byRef[i] {
            args[i] = self.refOf(args[i])
        }
    }
    let byAddress = changes and self.selfByAddress(d)
    var area = -1
    if byAddress and selfAt < 0 {
        area = self.areaTake(len(args[0]))
        let z = self.iconst(0)
        self.storeSlots(area, z, 0, 0, args[0])
        selfAt = area
    }
    if byAddress {
        args[0] = [selfAt]
    } else if changes and selfAt >= 0 {
        let rv = self.readPlace(selfPlace, self.ty(values[0]))
        args[0] = rv
    }
    let all = flat(args)
    let k = self.emitAt(.Call, -1, -1, -1, imm: self.fnIndex[dx.index], line: x.line)
    self.cur.setArgs(k, all)
    let r = self.valOf(dx.retType)
    let changed = if changes and not byAddress {
        self.valOf(self.ty(values[0]))
    } else {
        []
    }
    self.setRets(k, r + changed)
    self.maxOut(max(len(all), len(r) + len(changed)))
    if area >= 0 {
        let back = self.loadSlots(area, self.ty(values[0]))
        self.writePlaceRaw(selfPlace, back)
    } else if byAddress {
        self.rememberPlace(selfPlace)
    } else if changes {
        self.writePlaceRaw(selfPlace, changed)
    }
    r
}

// == that looks inside arrays, maps and boxes: the runtime's
fn Lower.comparesDeep(self, t: Int) -> Bool {
    match self.tk(t) {
        Array | Map => true
        Record => {
            for prm in self.dl(self.tdecl(t)).params {
                if self.boxed(prm) or self.comparesDeep(self.ptype(prm)) {
                    return true
                }
            }
            false
        }
        Enum => {
            if not self.hasData(t) {
                return false
            }
            for fs in self.dl(self.tdecl(t)).caseFields {
                for prm in fs {
                    if self.boxed(prm) or self.comparesDeep(self.ptype(prm)) {
                        return true
                    }
                }
            }
            false
        }
        _ => false
    }
}

fn Lower.spill(var self, v: [Int], line: Int) -> Int {
    let p = self.allocFixed(max(len(v), 1) * 8, line)
    if len(v) > 0 {
        let z = self.iconst(0)
        self.storeSlots(p, z, 8, 0, v)
    }
    p
}

fn Lower.equalVals(var self, a: [Int], b: [Int], t: Int, line: Int) -> Int {
    if self.comparesDeep(t) {
        let sa = self.spill(a, line)
        let sb = self.spill(b, line)
        let d = self.descAddress(t)
        return self.rtcall(rtValueEqual, [sa, sb, d], 'I', line)
    }
    let k = self.tk(t)
    if k is Text | Bytes {
        // lengths first: the bytes only when they are as long
        let all = self.newReg('I')
        let sameLen = self.cmp(condEq, a[1], b[1])
        self.mov(all, sameLen)
        let done = self.label()
        self.jz(all, done)
        let z = self.iconst(0)
        let r = self.rtcall(rtTextCompare, [a[0], a[1], b[0], b[1]], 'I', line)
        let eq = self.cmp(condEq, r, z)
        self.mov(all, eq)
        self.place(done)
        return all
    }
    if k == Kind.Enum and self.hasData(t) {
        let d = self.tdecl(t)
        let all = self.newReg('I')
        let same = self.cmp(condEq, a[0], b[0])
        self.mov(all, same)
        let done = self.label()
        self.jz(all, done)
        for kk in 0..len(self.dl(d).cases) {
            let cf = self.caseFields(d, kk)
            if len(cf) == 0 {
                continue
            }
            let skip = self.label()
            let kc = self.iconst(kk)
            let isK = self.cmp(condEq, a[0], kc)
            self.jz(isK, skip)
            for (f, prm) in cf.enumerate() {
                let ft = self.ptype(prm)
                let at = self.fieldOffset(d, kk, f)
                let n = self.slots(ft)
                let eq = self.equalVals(a[at..at + n], b[at..at + n], ft, line)
                self.emit(.Mul, all, all, eq)
            }
            self.place(skip)
        }
        self.place(done)
        return all
    }
    if k != Kind.Record {
        return self.cmp(condEq, a[0], b[0])
    }
    let all = self.newReg('I')
    let one = self.iconst(1)
    self.mov(all, one)
    var at = 0
    for prm in self.dl(self.tdecl(t)).params {
        let ft = self.ptype(prm)
        let n = self.slots(ft)
        let eq = self.equalVals(a[at..at + n], b[at..at + n], ft, line)
        self.emit(.Mul, all, all, eq)
        at += n
    }
    all
}

// i <cond> f of an Int and a Float, exactly
fn Lower.compareExact(var self, cond: Int, i: Int, f: Int) -> Int {
    let r = self.newReg('I')
    let d = self.op2(.IntToFloat, i, -1, 'F')
    let differ = self.label()
    let top = self.label()
    let done = self.label()
    let eq = self.cmp(condEq, d, f)
    self.jz(eq, differ)
    let big = self.fconst(9223372036854775808.0)
    let ge = self.cmp(condGe, f, big)
    self.jnz(ge, top)
    let fi = self.op2(.FloatToInt, f, -1, 'I')
    let c = self.cmp(cond, i, fi)
    self.mov(r, c)
    self.jmp(done)
    self.place(top)
    let k = self.iconst(if cond == condNe or cond == condLt or cond == condLe { 1 } else { 0 })
    self.mov(r, k)
    self.jmp(done)
    self.place(differ)
    let c2 = self.cmp(cond, d, f)
    self.mov(r, c2)
    self.place(done)
    r
}

fn flipped(cond: Int) -> Int = if cond == condLt {
    condGt
} else if cond == condGt {
    condLt
} else if cond == condLe {
    condGe
} else if cond == condGe {
    condLe
} else {
    cond
}

fn Lower.compareFloatInt(var self, cond: Int, v: Int, k: Int) -> Int {
    let d = toFloat(k)
    if d < 9223372036854775808.0 and toInt(d) == k {
        let fc = self.fconst(d)
        return self.cmp(cond, v, fc)
    }
    let kc = self.iconst(k)
    self.compareExact(flipped(cond), kc, v)
}

fn Lower.lowerBinary(var self, e: Int) -> [Int] {
    let x = self.p.ast.exprs[e]
    let Binary(op, l, rt) = x.node else {
        return []
    }
    let comparison = op is Eq | Ne | Lt | Le | Gt | Ge
    let cond = match op {
        Eq => condEq
        Ne => condNe
        Lt => condLt
        Le => condLe
        Gt => condGt
        _ => condGe
    }
    if x.decl >= 0 and not comparison {
        return self.callOperator(e)
    }
    if x.ty >= 0 and self.tk(x.ty) == Kind.Pointer and op is Plus | Minus {
        let p = self.lowerExpr(l)[0]
        let n = self.lowerExpr(rt)[0]
        let size = self.cSize(self.elemOf(x.ty))
        let bytes = if size == 1 { n } else { self.op2(.Mul, n, self.iconst(size), 'I') }
        return [self.op2(if op == .Plus { Op.Add } else { Op.Sub }, p, bytes, 'I')]
    }
    if op is And | Or {
        let r = self.newReg('I')
        let a = self.lowerExpr(l)[0]
        self.mov(r, a)
        let done = self.label()
        if op == .And { self.jz(r, done) } else { self.jnz(r, done) }
        let b = self.lowerExpr(rt)[0]
        self.mov(r, b)
        self.place(done)
        return [r]
    }
    if x.decl >= 0 and comparison {
        let order = self.callOperator(e)[0]
        let z = self.iconst(0)
        return [self.cmp(cond, order, z)]
    }
    if op == .Coalesce {
        let ov = self.lowerExpr(l)
        let opt = self.copyVal(ov)
        let d = self.tdecl(self.ty(l))
        let r = self.valOf(x.ty)
        let none = self.label()
        let done = self.label()
        self.jz(opt[0], none)
        if x.ty == self.ty(l) {
            self.movVal(r, opt)
        } else {
            let at = self.caseOffset(d, 1)
            let n = self.slots(self.p.fallibleValue(self.ty(l)))
            self.movVal(r, opt[at..at + n])
        }
        self.jmp(done)
        self.place(none)
        let other = self.lowerStored(rt)
        self.movVal(r, other)
        self.place(done)
        return r
    }
    var a: [Int] = []
    var b: [Int] = []
    if self.addressRead(l) {
        b = self.lowerExpr(rt)
        a = self.lowerExpr(l)
    } else {
        a = self.lowerExpr(l)
        b = self.lowerExpr(rt)
    }
    let ta = self.ty(l)
    let ka = self.tk(ta)
    let sameness = op is Eq | Ne
    if ka == Kind.Record or ka == Kind.Enum and self.hasData(ta) or sameness and ka is Array | Map {
        let same = self.equalVals(a, b, ta, x.line)
        return [if op == .Eq { same } else { self.op2(.Not, same, -1, 'I') }]
    }
    if ka == Kind.Array and op == .Plus {
        let eb = self.iconst(self.elemBytes(ta))
        let p = self.rtcall(rtArrayJoin, [a[0], a[1], b[0], b[1], eb], 'I', x.line)
        let n = self.op2(.Add, a[1], b[1], 'I')
        return [p, n]
    }
    if ka is Text | Bytes {
        if op == .Plus {
            return self.joinText(a, b)
        }
        let order = self.rtcall(rtTextCompare, [a[0], a[1], b[0], b[1]], 'I', x.line)
        let z = self.iconst(0)
        return [self.cmp(cond, order, z)]
    }
    if self.p.isSet(ta) {
        let out = if op == .Pipe {
            self.copyMap(a, x.line)
        } else {
            self.newMap(ta, x.line)
        }
        self.forEachEntry(
            if op == .Pipe { b } else { a },
            ta,
            .SetOpEntry(out[0], b[0], op == .Pipe, op == .Amp, x.line, self.keyOf(ta)),
            x.line,
        )
        return out
    }
    if op is PlusWrap | MinusWrap | StarWrap {
        let irOp = match op {
            PlusWrap => Op.Add
            MinusWrap => Op.Sub
            _ => Op.Mul
        }
        return [self.op2(irOp, a[0], b[0], 'I')]
    }
    if op is Amp | Pipe | Caret | Shl | Shr {
        let irOp = match op {
            Amp => Op.And
            Pipe => Op.Or
            Caret => Op.Xor
            Shl => Op.Shl
            _ => Op.Sar
        }
        return [self.op2(irOp, a[0], b[0], 'I')]
    }
    if op is Plus | Minus | Star | Slash | Percent {
        let f = self.tk(x.ty) == Kind.Float
        let irOp = match op {
            Plus => if f { Op.Fadd } else { Op.Add }
            Minus => if f { Op.Fsub } else { Op.Sub }
            Star => if f { Op.Fmul } else { Op.Mul }
            Slash => if f { Op.Fdiv } else { Op.Div }
            _ => Op.Mod
        }
        let r = self.newReg(if f { 'F' } else { 'I' })
        let checked = irOp is Add | Sub | Mul // past an Int's limits: a panic (+% -% *% wrap around)
        self.emit(irOp, r, a[0], b[0], line: x.line, cond: if checked { 1 } else { 0 })
        return [r]
    }
    let kb = self.ek(rt)
    if ka == Kind.Int and kb == Kind.Float {
        return [self.compareExact(cond, a[0], b[0])]
    }
    if ka == Kind.Float and kb == Kind.Int {
        return [self.compareExact(flipped(cond), b[0], a[0])]
    }
    [self.cmp(cond, a[0], b[0])]
}

fn Lower.lowerIf(var self, e: Int) -> [Int] {
    let x = self.p.ast.exprs[e]
    let If(c, then, other) = x.node else {
        return []
    }
    let value = not self.tk(x.ty) is Void | Error
    let r = if value { self.valOf(x.ty) } else { [] }
    let elseL = self.label()
    let done = self.label()
    let cv = self.lowerExpr(c)[0]
    self.jz(cv, elseL)
    let tv = self.lowerBlock(then, if value { x.ty } else { tyVoid })
    if value {
        self.movVal(r, tv)
    }
    self.jmp(done)
    self.place(elseL)
    if other >= 0 {
        let fv = if self.isBlockExpr(other) {
            self.lowerBlock(self.blockOfExpr(other), if value { x.ty } else { tyVoid })
        } else {
            self.lowerExpr(other)
        }
        if value {
            self.movVal(r, fv)
        }
    }
    self.place(done)
    r
}

// Tests a pattern on v (of type t), jumping to fail when it does not match; its names get their slots.
fn Lower.matchPattern(var self, arm: Int, v: [Int], t: Int, fail: Int, checkCase: Bool, noAlternatives: Bool = false) {
    let a = self.p.ast.arms[arm]
    if a.valuePattern >= 0 {
        // a constant: equal to it, or the next arm
        let c = self.lowerExpr(a.valuePattern)
        let same = self.equalVals(v, c, t, self.lineOf(a.valuePattern))
        self.jz(same, fail)
        return
    }
    if a.whole != "" {
        if a.wholeBinding >= 0 {
            self.bind(a.wholeBinding, v)
        }
        return
    }
    if a.textPattern >= 0 {
        let TextLit(text, _, _) = self.p.ast.exprs[a.textPattern].node else {
            return
        }
        let lit = self.literalText(text)
        let r = self.rtcall(rtTextCompare, [v[0], v[1], lit[0], lit[1]], 'I', self.lineOf(a.textPattern))
        self.jnz(r, fail)
        return
    }
    let isF = self.tk(t) == Kind.Float
    if a.isRange {
        if a.intPattern >= 0 {
            let k = self.intOf(a.intPattern)
            let c = if isF {
                self.compareFloatInt(condGe, v[0], k)
            } else {
                self.cmp(condGe, v[0], self.iconst(k))
            }
            self.jz(c, fail)
        }
        if a.intHigh >= 0 {
            let k = self.intOf(a.intHigh)
            let c = if isF {
                self.compareFloatInt(condLt, v[0], k)
            } else {
                self.cmp(condLt, v[0], self.iconst(k))
            }
            self.jz(c, fail)
        }
        return
    }
    if a.intPattern >= 0 {
        let k = self.intOf(a.intPattern)
        let c = if isF {
            self.compareFloatInt(condEq, v[0], k)
        } else {
            self.cmp(condEq, v[0], self.iconst(k))
        }
        self.jz(c, fail)
        return
    }
    if a.pattern == "" {
        return
    }
    let d = self.tdecl(t)
    let record = self.tk(t) == Kind.Record
    if not record and checkCase and len(self.dl(d).cases) > 1 {
        let kc = self.iconst(a.caseIndex)
        let c = self.cmp(condEq, v[0], kc)
        self.jz(c, fail)
    }
    for f in 0..len(a.binds) {
        let prm = if record {
            self.dl(d).params[f]
        } else {
            self.caseFields(d, a.caseIndex)[f]
        }
        let at = if record {
            self.recordOffset(d, f)
        } else {
            self.fieldOffset(d, a.caseIndex, f)
        }
        let sub = if f < len(a.subs) { a.subs[f] } else { -1 }
        let b = if f < len(a.bindings) { a.bindings[f] } else { -1 }
        if sub < 0 and b < 0 {
            continue
        }
        let fv = self.fieldVal(prm, v[at..])
        let ft = self.ptype(prm)
        if sub >= 0 and len(self.p.ast.arms[sub].alternatives) > 0 {
            let alts = self.p.ast.arms[sub].alternatives
            let ok = self.label()
            for k in 0..len(alts) + 1 {
                let miss = if k == len(alts) { fail } else { self.label() }
                self.matchPattern(if k > 0 { alts[k - 1] } else { sub }, fv, ft, miss, true, true)
                self.jmp(ok)
                if k < len(alts) {
                    self.place(miss)
                }
            }
            self.place(ok)
        } else if sub >= 0 {
            self.matchPattern(sub, fv, ft, fail, true)
        } else {
            self.bind(b, fv)
        }
    }
}

fn Lower.lowerIs(var self, e: Int) -> [Int] {
    let Is(value, arm) = self.p.ast.exprs[e].node else {
        return []
    }
    let vv = self.lowerExpr(value)
    let v = self.copyVal(vv)
    let r = self.newReg('I')
    let matched = self.label()
    let done = self.label()
    let z = self.iconst(0)
    self.mov(r, z)
    let alts = self.p.ast.arms[arm].alternatives
    for k in 0..len(alts) + 1 {
        let miss = self.label()
        self.matchPattern(if k > 0 { alts[k - 1] } else { arm }, v, self.ty(value), miss, true)
        self.jmp(matched)
        self.place(miss)
    }
    self.jmp(done)
    self.place(matched)
    let one = self.iconst(1)
    self.mov(r, one)
    self.place(done)
    [r]
}

fn Lower.bindsNames(self, e: Int) -> Bool {
    let x = self.p.ast.exprs[e]
    if x.node is Is(_, _) {
        return true
    }
    let Binary(op, l, r) = x.node else {
        return false
    }
    op == .And and (self.bindsNames(l) or self.bindsNames(r))
}

fn Lower.lowerMatch(var self, e: Int) -> [Int] {
    let x = self.p.ast.exprs[e]
    let Match(subject, arms, _) = x.node else {
        return []
    }
    let value = not self.tk(x.ty) is Void | Error
    let r = if value { self.valOf(x.ty) } else { [] }
    let wv = self.lowerExpr(subject)
    let whole = self.copyVal(wv)
    let done = self.label()
    let st = self.ty(subject)
    var i = 0
    while i < len(arms) {
        let a = self.p.ast.arms[arms[i]]
        let next = self.label()
        if len(a.alternatives) > 0 {
            let matched = self.label()
            let end = i + len(a.alternatives)
            for k in i..end + 1 {
                let miss = if k == end { next } else { self.label() }
                self.matchPattern(arms[k], whole, st, miss, true)
                self.jmp(matched)
                if k != end {
                    self.place(miss)
                }
            }
            self.place(matched)
            i = end
        } else {
            let last = i == len(arms) - 1
            let exhaustiveLast = last and a.guard < 0 and len(a.subs) == 0
            self.matchPattern(arms[i], whole, st, next, not exhaustiveLast)
        }
        if self.opts.debug {
            for b in a.bindings {
                self.traceValue(b, 0) // the arm's names
            }
            self.traceValue(a.wholeBinding, 0)
        }
        if a.guard >= 0 {
            let g = self.lowerExpr(a.guard)[0]
            self.jz(g, next)
        }
        let body = a.body
        let v = if self.isBlockExpr(body) {
            self.lowerBlock(self.blockOfExpr(body), if value { x.ty } else { tyVoid })
        } else {
            self.lowerExpr(body)
        }
        if value {
            self.movVal(r, v)
        }
        self.jmp(done)
        self.place(next)
        i += 1
    }
    self.place(done)
    r
}

// A constant: its value, worked out already; an array of plain numbers is the program's data.
fn Lower.lowerConst(var self, d: Int) -> [Int] {
    let x = self.dl(d)
    let v = if x.folded >= 0 { x.folded } else { x.body }
    let items = match self.p.ast.exprs[v].node {
        ArrayLit(items) => items
        _ => []
    }
    var plain = len(items) > 0 and self.slots(self.elemOf(self.ty(v))) == 1
    for i in items {
        if plain {
            plain = self.p.ast.exprs[i].node is IntLit(_, _) | FloatLit(_, _) | BoolLit(_)
        }
    }
    if not plain {
        return self.lowerExpr(v)
    }
    if not self.constAt.contains(d) {
        var bytes: Bytes = []
        for i in items {
            bytes += le64(match self.p.ast.exprs[i].node {
                FloatLit(f, _) => floatBits(f)
                other => self.intOf(i)
            })
        }
        let at = self.dataBytes(bytes)
        self.constAt[d] = at
    }
    let a = self.dataAddress(self.constAt[d] ?? 0)
    let n = self.iconst(len(items))
    [a, n]
}

// a constant whose value is an array of text literals: its table of (offset, length) in the data, made once; else -1
fn Lower.constTexts(var self, d: Int) -> Int {
    if self.dl(d).kind != DeclKind.Const {
        return -1
    }
    if self.constTextAt[d] is Some(at) {
        return at
    }
    let x = self.dl(d)
    let v = if x.folded >= 0 { x.folded } else { x.body }
    let ArrayLit(items) = self.p.ast.exprs[v].node else {
        return -1
    }
    if len(items) == 0 or not items.all(i => self.p.ast.exprs[i].node is TextLit(_, _, _)) {
        return -1
    }
    var bytes: Bytes = []
    for i in items {
        let TextLit(text, _, _) = self.p.ast.exprs[i].node else {
            return -1
        }
        bytes += le64(self.dataText(text)) + le64(len(text))
    }
    let at = self.dataBytes(bytes)
    self.constTextAt[d] = at
    at
}

fn Lower.constTextCount(self, d: Int) -> Int {
    let x = self.dl(d)
    let v = if x.folded >= 0 { x.folded } else { x.body }
    match self.p.ast.exprs[v].node {
        ArrayLit(items) => len(items)
        _ => 0
    }
}

// "a{x}b" joined onto start (a text's slots; [] for none): each piece added in turn, so onto a text with room to grow
// (s += "{w} ") every piece goes in place and no text is made for the whole
fn Lower.interpOnto(var self, start: [Int], values: [Int], parts: [Text], formats: [Text], line: Int) -> [Int] {
    var acc = start
    var empty = len(start) == 0
    if parts[0] != "" or empty {
        let lit = self.literalText(parts[0])
        acc = if empty { lit } else { self.joinText(acc, lit) }
        empty = empty and parts[0] == ""
    }
    for (i, value) in values.enumerate() {
        let f = if len(formats) > i { formats[i] } else { "" }
        let width = atoi(f)
        let dot = f.indexOf(".") ?? -1
        var t: [Int] = []
        if dot >= 0 {
            var v = self.lowerExpr(value)[0]
            if self.cur.kinds[v] == 'I' {
                v = self.op2(.IntToFloat, v, -1, 'F')
            }
            let digits = self.iconst(atoi(f[dot + 1..]))
            let p = self.rtcall(rtTextFixed, [v, digits], 'I', line)
            t = self.unpackText(p)
        } else if width == 0 and not empty and self.tk(self.ty(value)) == Kind.Int {
            // a number onto the text: its digits written there, no text made for them
            let v = self.lowerExpr(value)[0]
            acc = self.unpackText(self.rtcall(rtJoinInt, [acc[0], acc[1], v], 'I', line))
            if parts[i + 1] != "" {
                let lit = self.literalText(parts[i + 1])
                acc = self.joinText(acc, lit)
            }
            continue
        } else {
            t = self.textOf(value)
        }
        if width > 0 {
            let w = self.iconst(width)
            let p = self.rtcall(rtPad, [t[0], t[1], w], 'I', line)
            t = self.unpackText(p)
        }
        acc = if empty { t } else { self.joinText(acc, t) }
        empty = false
        if parts[i + 1] != "" {
            let lit = self.literalText(parts[i + 1])
            acc = self.joinText(acc, lit)
        }
    }
    acc
}

// C's atoi: the number a text starts with (0: none)
fn atoi(t: Text) -> Int {
    var n = 0
    var neg = false
    var i = 0
    let b = t.bytes()
    if i < len(b) and b[i] is '-' | '+' {
        neg = b[i] == '-'
        i += 1
    }
    while i < len(b) and b[i] is '0'..='9' {
        n = n * 10 + (b[i] - '0')
        i += 1
    }
    if neg { -n } else { n }
}

// An expression's value. Counted: what it makes is the statement's (let go of when the statement ends) unless a holder
// takes it (claim); what is made in a branch, a lambda or a pipeline's loop is not (it may not be made at all, or be
// made many times)
fn Lower.lowerExpr(var self, e: Int) -> [Int] {
    return self.lowerExprInner(e)
}

fn Lower.lowerExprInner(var self, e: Int) -> [Int] {
    let x = self.p.ast.exprs[e]
    let line = x.line
    match x.node {
        IntLit(v, _) => [self.iconst(v)]
        FloatLit(v, _) => [self.fconst(v)]
        BoolLit(v) => [self.iconst(if v { 1 } else { 0 })]
        Hole => {
            // a value not written yet: reached, the program stops (Never: nothing comes back)
            let msg = self.literalText("a hole (_) was reached: this value is not written yet")
            let where = self.lineHere(line)
            self.rtv(rtFailId, [msg[0], msg[1], where], line)
            []
        }
        Case(_, _, _) => if self.hasData(x.ty) {
            self.caseValue(x.ty, max(x.caseIndex, 0), None)
        } else {
            [self.iconst(max(x.caseIndex, 0))]
        }
        With(target, values, names) => {
            let base = self.lowerExpr(target)
            let r = self.copyVal(base)
            let t = self.ty(target)
            let d = self.tdecl(t)
            let ps = self.dl(d).params
            for (i, value) in values.enumerate() {
                let v = self.lowerStored(value)
                var f = 0
                while f < len(ps) - 1 and self.p.ast.params[ps[f]].name != names[i] {
                    f += 1
                }
                let off = self.recordOffset(d, f)
                self.setField(ps[f], r[off..], v, line)
            }
            r
        }
        Interp(values, parts, _, formats, _) => self.interpOnto([], values, parts, formats, line)
        TextLit(text, _, _) => self.literalText(text)
        Try(value) => self.lowerTry(e, value)
        MapLit(items) => {
            let m = self.newMap(x.ty, line)
            var i = 0
            while i + 1 < len(items) {
                let k = self.lowerExpr(items[i])
                let v = if self.p.isSet(x.ty) { [] } else { self.lowerStored(items[i + 1]) }
                self.mapSet(m, k, self.keyOf(x.ty), v, line)
                i += 2
            }
            m
        }
        Name(_) => {
            if x.ty >= 0 and self.tk(x.ty) == Kind.CFn and x.decl >= 0 {
                return self.cFunctionValue(x.decl, x.ty)
            }
            if x.binding < 0 {
                if x.decl >= 0 and self.dl(x.decl).kind == DeclKind.Const {
                    return self.lowerConst(x.decl)
                }
                if x.decl >= 0 and self.dl(x.decl).kind == DeclKind.Fn {
                    return self.fnAddress(x.decl)
                }
                return self.caseValue(x.ty, 0, None)
            }
            self.nameValue(x.binding, line)
        }
        Field(target, _) => {
            if self.isCPlace(e) {
                return self.readCPlace(e)
            }
            let tt = self.ty(target)
            if self.tk(tt) == Kind.Pointer {
                return [self.lowerExpr(target)[0]]
            }
            if self.memoryPlace(e) {
                // in memory: that field alone, read there
                let pl = self.placeOf(e)
                return self.readPlace(pl, x.ty)
            }
            let v = self.lowerExpr(target)
            let d = self.tdecl(tt)
            if self.dl(d).isInterface {
                let f0 = self.newReg('I')
                let z = self.iconst(0)
                self.emit(.Load, f0, v[0], z, imm: 8, c: 8 * x.caseIndex)
                return [f0, v[1]]
            }
            let off = self.recordOffset(d, x.caseIndex)
            self.fieldVal(self.dl(d).params[x.caseIndex], v[off..])
        }
        Index(target, index) => self.lowerIndex(e, target, index)
        Unary(op, operand) => {
            if x.decl >= 0 {
                return self.callOperator(e)
            }
            let v = self.lowerExpr(operand)
            if op == .Not {
                return [self.op2(.Not, v[0], -1, 'I')]
            }
            if op == .Tilde {
                let m = self.iconst(-1)
                return [self.op2(.Xor, v[0], m, 'I')]
            }
            var r: [Int] = []
            for reg in v {
                if self.cur.kinds[reg] == 'F' {
                    r.push(self.op2(.Fneg, reg, -1, 'F'))
                } else {
                    // -x is 0 - x: -intMin is past the limits
                    let n = self.newReg('I')
                    let z = self.iconst(0)
                    self.emit(.Sub, n, z, reg, line: x.line, cond: 1)
                    r.push(n)
                }
            }
            r
        }
        Binary(_, _, _) => if x.builtin == bRepeat or x.builtin == bFill {
            self.lowerRepeat(e)
        } else {
            self.lowerBinary(e)
        }
        Range(_, _) => self.materialize(e, tyInt, line)
        If(_, _, _) => self.lowerIf(e)
        Match(_, _, _) => self.lowerMatch(e)
        Is(_, _) => self.lowerIs(e)
        BlockExpr(block, _) => self.lowerBlock(block, x.ty)
        ArrayLit(items) => {
            let bytes = self.slots(self.elemOf(x.ty)) * 8
            let n = self.iconst(len(items))
            let ptr = self.alloc(n, bytes, line)
            for (i, item) in items.enumerate() {
                let v = self.lowerStored(item)
                let at = self.iconst(i)
                self.storeSlots(ptr, at, bytes, 0, v)
            }
            [ptr, n]
        }
        Call(_, _, _, _, _, _) => self.lowerCall(e)
        Lambda(_, _) => {
            if x.decl >= 0 and x.ty >= 0 and self.tk(x.ty) == Kind.CFn {
                return self.cFunctionValue(x.decl, x.ty)
            }
            if x.decl >= 0 {
                return self.fnAddress(x.decl)
            }
            []
        }
    }
}

fn Lower.lowerTry(var self, e: Int, value: Int) -> [Int] {
    let line = self.lineOf(e)
    let wv = self.lowerExpr(value)
    let whole = self.copyVal(wv)
    let d = self.tdecl(self.ty(value))
    let x = self.dl(d)
    let ok = self.label()
    self.jnz(whole[0], ok)
    let f = if len(self.inlining) > 0 {
        self.inlining[len(self.inlining) - 1].d
    } else {
        self.current
    }
    let fx = self.dl(f)
    var msg: [Int] = []
    if x.resultOf >= 0 {
        let at = self.caseOffset(d, 0)
        msg = whole[at..at + self.slots(x.errorOf)]
    } else {
        msg = self.literalText("no value (None)")
    }
    let rt = fx.retType
    let returnsResult = rt >= 0 and self.tdecl(rt) >= 0 and self.dl(self.tdecl(rt)).resultOf >= 0
    if fx.isTest or fx.name == "main" and not returnsResult {
        if x.resultOf >= 0 and self.tk(x.errorOf) != Kind.Text {
            msg = self.textOfVal(msg, x.errorOf, 0)
        }
        msg = self.copyVal(msg)
        self.runDefers(0, 0)
        let where = self.lineHere(line)
        self.rtv(rtFailId, [msg[0], msg[1], where], line)
    } else {
        let fail = self.caseValue(rt, 0, if x.resultOf >= 0 { Some([msg]) } else { None })
        self.lowerReturn(fail)
    }
    self.place(ok)
    let at = self.caseOffset(d, 1)
    whole[at..at + self.slots(self.ty(e))]
}

fn Lower.lowerIndex(var self, e: Int, target: Int, index: Int) -> [Int] {
    let line = self.lineOf(e)
    if self.isCPlace(e) {
        return self.readCPlace(e)
    }
    let tt = self.ty(target)
    if self.p.ast.exprs[index].node is Range(lo, hi) {
        let src = self.lowerExpr(target)
        let n = src[1]
        let low = if lo >= 0 { self.lowerExpr(lo)[0] } else { self.iconst(0) }
        let high = if hi >= 0 { self.lowerExpr(hi)[0] } else { n }
        let one = self.iconst(1)
        let n1 = self.op2(.Add, n, one, 'I')
        self.bounds(high, n1, panicSliceEnd, line)
        let one2 = self.iconst(1)
        let h1 = self.op2(.Add, high, one2, 'I')
        self.bounds(low, h1, panicSliceStart, line)
        let et = self.ty(e)
        if self.tk(et) == Kind.Text {
            let one3 = self.iconst(1)
            let cut = self.rtcall(rtTextCut, [src[0], n, low, high], 'I', line)
            self.bounds(cut, one3, panicTextCut, line)
        }
        let bytes = if self.tk(et) is Text | Bytes { 1 } else { self.elemBytes(et) }
        var off = low
        if bytes != 1 {
            let kb = self.iconst(bytes)
            off = self.op2(.Mul, low, kb, 'I')
        }
        let a = self.op2(.Add, src[0], off, 'I')
        let len2 = self.op2(.Sub, high, low, 'I')
        return [a, len2]
    }
    let x = self.p.ast.exprs[e]
    if self.tk(tt) == Kind.Map and x.place {
        let m = self.lowerExpr(target)
        let k = self.lowerExpr(index)
        let p = self.mapAt(m, k, tt, line)
        return self.loadSlots(p, x.ty)
    }
    let late = self.addressRead(target) // self.xs[self.add(x)]: xs as the call left it
    let key = if late { self.lowerExpr(index) } else { [] }
    if self.tk(tt) == Kind.Map {
        let m = self.lowerExpr(target)
        let k = if late { key } else { self.lowerExpr(index) }
        return self.mapGet(m, k, self.keyOf(tt), x.ty, line)
    }
    let tc = self.p.ast.exprs[target]
    if not late and tc.node is Name(_) and tc.binding < 0 and tc.decl >= 0 and self.constTexts(tc.decl) >= 0 {
        // names[i] of a constant array of texts: read from its table in the data, no array made for it
        let table = self.constTextAt[tc.decl] ?? 0
        let i = self.lowerExpr(index)[0]
        let n = self.iconst(self.constTextCount(tc.decl))
        self.bounds(i, n, panicIndex, line)
        let base = self.dataAddress(table)
        let off = self.newReg('I')
        self.emit(.Load, off, base, i, imm: 16, c: 0)
        let size = self.newReg('I')
        self.emit(.Load, size, base, i, imm: 16, c: 8)
        let data = self.dataAddress(0)
        return [self.op2(.Add, data, off, 'I'), size]
    }
    let arr = self.lowerExpr(target)
    let i = if late { key[0] } else { self.lowerExpr(index)[0] }
    let tx = self.p.ast.exprs[target]
    let ix = self.p.ast.exprs[index]
    let proven = tx.node is Name(_)
        and ix.node is Name(_)
        and ix.binding >= 0
        and tx.binding >= 0
        and self.p.bindings[ix.binding].safeIn == tx.binding
    if not proven {
        self.bounds(i, arr[1], panicIndex, line)
    }
    if self.tk(tt) == Kind.Bytes {
        return [self.loadByte(arr[0], i)]
    }
    self.loadElem(arr, i, x.ty)
}

// ---- statements ----
// defer: run where its block is left (the last one written first)
fn Lower.runDefers(var self, from: Int, loopLevel: Int) {
    var i = len(self.defers) - 1
    while i >= from {
        let at = self.defers[i]
        if at.inlineDepth == len(self.inlining) and at.loopLevel >= loopLevel {
            let saved = self.defers
            self.defers = saved[..i]
            let _ = self.lowerBlock(at.body, tyVoid)
            self.defers = saved
        }
        i -= 1
    }
}

fn Lower.endsHere(self, b: Int, e: Int) -> Bool {
    let x = self.p.ast.exprs[e]
    if not x.node is Name(_)
        or x.binding < 0
        or not self.p.bindings[x.binding].mutable
        or self.p.bindings[x.binding].isParam {
        return false
    }
    for s in self.p.ast.blocks[b].stmts {
        let st = self.p.ast.stmts[s]
        if st.node is Let(true, _, _, _, _, _) and st.binding == x.binding {
            return true
        }
    }
    false
}

fn Lower.lowerBlock(var self, b: Int, t: Int) -> [Int] {
    let value = t >= 0 and not self.tk(t) is Void | Error
    let mark = len(self.defers)
    let stmts = self.p.ast.blocks[b].stmts
    for (i, s) in stmts.enumerate() {
        let st = self.p.ast.stmts[s]
        if value and i == len(stmts) - 1 and st.node is ExprStmt(v0) {
            self.debugLine(st.line) // the block's value: a line of its own too
            var v = if self.endsHere(b, v0) and len(self.defers) == mark {
                self.lowerExpr(v0)
            } else {
                self.lowerStored(v0)
            }
            if len(self.defers) > mark {
                v = self.copyVal(v)
                self.runDefers(mark, 0)
                self.defers = self.defers[..mark]
            }
            return v
        }
        if st.node is Defer(body) {
            self.defers.push(DeferAt(body, len(self.inlining), self.loopLevel))
            continue
        }
        self.lowerStmt(s)
    }
    self.runDefers(mark, 0)
    self.defers = self.defers[..mark]
    []
}

// A type's description for the runtime (rtLoopCollect, maps' keys, ==)
type Desc { out: Bytes = [] }

// a number in three characters, six bits each from '0' (as a reference's)
fn Desc.number(var self, n: Int) {
    var d = 2
    while d >= 0 {
        self.out.push('0' + n >> (6 * d) & 63)
        d -= 1
    }
}

fn Desc.ref(var self, at: Int) {
    self.out.push('R')
    var d = 2
    while d >= 0 {
        self.out.push('0' + at >> (6 * d) & 63)
        d -= 1
    }
}

fn Desc.field(var self, l: Lower, prm: Int, open: [(Int, Int)]) {
    let ft = l.ptype(prm)
    if not l.boxed(prm) {
        self.typeIn(l, ft, open)
        return
    }
    self.out.push('B')
    for (t, at) in open {
        if t == ft {
            self.ref(at)
            return
        }
    }
    self.typeIn(l, ft, open)
}

fn Desc.typeIn(var self, l: Lower, t: Int, given: [(Int, Int)]) {
    var open = given
    let k = l.tk(t)
    if k is Record | Enum {
        for (ot, at) in open {
            if ot == t {
                self.ref(at)
                return
            }
        }
    }
    match k {
        Text | Bytes => {
            self.out.push('T')
        }
        Fn => {
            self.out += "(IC)".bytes()
        }
        Array => {
            self.out.push('A')
            self.typeIn(l, l.elemOf(t), open)
        }
        Map => {
            self.out.push('M')
            self.typeIn(l, l.keyOf(t), open)
            self.typeIn(l, l.elemOf(t), open)
        }
        Record => {
            let d = l.tdecl(t)
            if l.dl(d).isInterface {
                self.out += "(IC)".bytes()
                return
            }
            if len(open) < 64 {
                open.push((t, len(self.out)))
            }
            self.out.push('(')
            for prm in l.dl(d).params {
                self.field(l, prm, open)
            }
            self.out.push(')')
        }
        Enum => {
            if not l.hasData(t) {
                self.out.push('I')
                return
            }
            let d = l.tdecl(t)
            if len(open) < 64 {
                open.push((t, len(self.out)))
            }
            // E, the cases' count, the slots, then each case: where its data starts, its fields, '.'
            let layout = l.p.caseLayout(d)
            self.out.push('E')
            self.out.push(32 + len(l.dl(d).cases))
            self.number(len(layout.kinds))
            for (ci, fs) in l.dl(d).caseFields.enumerate() {
                self.number(layout.starts[ci])
                for prm in fs {
                    self.field(l, prm, open)
                }
                self.out.push('.')
            }
        }
        Float => {
            self.out.push('F')
        }
        _ => {
            let n = l.p.slots(t)
            if n == 0 {
                self.out += "()".bytes()
            }
            for _ in 0..n {
                self.out.push('I')
            }
        }
    }
}

fn Lower.typeDesc(self, t: Int) -> Bytes {
    var d = Desc()
    d.typeIn(self, t, [])
    d.out
}

fn Lower.loopBegin(var self, body: Int) -> Int {
    let scan = self.own.scanLoop(body)
    var kept: [Int] = []
    var slots = 0
    for b in scan.roots {
        if scan.inside.contains(b)
            or not self.bound[b] and not self.atAddress[b]
            or not self.own.holdsMemory(self.bt(b)) {
            continue
        }
        kept.push(b)
        slots += if self.atAddress[b] { 1 } else { self.slots(self.bt(b)) }
    }
    let slotsReg = self.iconst(slots)
    let nopAt = len(self.cur.code)
    self.emit(.Nop, -1, -1, -1)
    let frame = self.newReg('I')
    self.memories.push(
        LoopMemory(
            frame: frame,
            slotsReg: slotsReg,
            nopAt: nopAt,
            bodyStart: len(self.cur.code),
            roots: kept,
            inside: scan.inside,
            changed: scan.changed,
        ),
    )
    len(self.memories) - 1
}

fn Lower.onlyGrows(self, m: LoopMemory, at: Int) -> Bool {
    var i = len(self.growths) - 1
    while i >= 0 {
        let g = self.growths[i]
        i -= 1
        if g.fnId != self.fnId or g.at != at {
            continue
        }
        return not m.inside.contains(g.holder) and not m.changed.contains(g.holder)
    }
    false
}

fn Lower.loopTurnEnd(var self, mi: Int, line: Int) {
    let m = self.memories[mi]
    var allocates = false
    var k = m.bodyStart
    while k < len(self.cur.code) and not allocates and not self.opts.linked {
        let ins = self.cur.code[k]
        allocates = ins.mayAllocate() and not (ins.op == Op.RtCall and ins.imm == rtPush and self.onlyGrows(m, k))
        k += 1
    }
    if not allocates {
        return
    }
    if not m.started {
        self.memories[mi].started = true
        var ins = self.cur.code[m.nopAt]
        ins.op = .RtCall
        ins.imm = rtLoopStart
        ins.line = line
        self.cur.code[m.nopAt] = ins
        self.cur.setOperands(m.nopAt, [m.slotsReg], [m.frame])
        self.touch(m.slotsReg)
        self.touch(m.frame)
        self.maxOut(1)
    }
    // the turn's check, here (runtime/loops.qk's frame): what the arena made since the mark past the frame's limit.
    // The frame's generations (word 5) hold the arena (word 4), whose word 4 is what it made
    let skip = self.label()
    let gen = self.loadMem('I', m.frame, -1, 1, 40, mem64)
    let arena = self.loadMem('I', gen, -1, 1, 32, mem64)
    let made = self.loadMem('I', arena, -1, 1, 32, mem64)
    let since = self.loadMem('I', m.frame, -1, 1, 16, mem64)
    let limit = self.loadMem('I', m.frame, -1, 1, 24, mem64)
    let grown = self.op2(.Sub, made, since, 'I')
    let check = self.cmp(condGt, grown, limit)
    self.jz(check, skip)
    var desc = Desc() // the vars' types, one description (a reference counts from its start)
    let zero = self.iconst(0)
    var at = 48
    for b in m.roots {
        // the vars into the frame (one in memory: its address, P)
        let v = if self.atAddress[b] { [self.addrReg[b]] } else { self.regsOf(b) }
        self.storeSlots(m.frame, zero, 8, at, v)
        at += 8 * len(v)
        if self.atAddress[b] {
            desc.out.push('P')
        }
        desc.typeIn(self, self.bt(b), [])
    }
    let dd = self.dataBytes(desc.out)
    let da = self.dataAddress(dd)
    self.rtv(rtLoopCollect, [m.frame, da], line)
    at = 48
    for b in m.roots {
        // and back, where the copies are (one in memory: changed there)
        if self.atAddress[b] {
            at += 8
            continue
        }
        for r in self.regsOf(b) {
            self.emit(.Load, r, m.frame, zero, imm: 8, c: at)
            at += 8
        }
    }
    self.place(skip)
}

// a built-in a loop goes through to its source (xs.map(f), .filter, .enumerate, .entries, .take, .skip): what is made
// for the source is made before the loop's mark
fn passesThrough(b: Int) -> Bool =
    b == bMap or b == bFilter or b == bEnumerate or b == bEntries or b == bTake or b == bSkip

// a for loop's source worked out before the loop's mark
fn Lower.preLowerSource(var self, iter: Int) {
    var base = self.stripImplicit(iter)
    while true {
        let x = self.p.ast.exprs[base]
        if x.node is Name(_) and x.binding >= 0 and self.p.bindings[x.binding].lazy {
            base = self.stripImplicit(self.p.bindings[x.binding].init)
        } else if x.node is Call(_, _, _, _, _, _) and passesThrough(x.builtin) {
            base = self.stripImplicit(self.arg(base, 0))
        } else {
            break
        }
    }
    let bx = self.p.ast.exprs[base]
    if bx.node is Call(_, _, _, _, _, _) and (bx.builtin == bWords or bx.builtin == bCodePoints) {
        // its words (code points) are found as the loop goes, in the text: made before the mark, so that no
        // collection of the loop's turns takes it back
        let tv = self.lowerExpr(self.arg(base, 0))
        self.preText = base
        self.preTextVal = self.copyVal(tv)
        return
    }
    if bx.node is Range(lo, hi) {
        let a = self.lowerExpr(lo)[0]
        let b = self.lowerExpr(hi)[0]
        self.preRange = base
        let pa = self.newReg('I')
        self.preA = pa
        let pb = self.newReg('I')
        self.preB = pb
        self.mov(pa, a)
        self.mov(pb, b)
    } else if self.tk(bx.ty) is Array | Map | Bytes
        and not (bx.node is Name(_) and bx.binding < 0 and bx.decl >= 0 and self.constTexts(bx.decl) >= 0) {
        // (a constant array of texts is read from the data as the loop goes: nothing made)
        let v = self.lowerExpr(base)
        var arr = self.copyVal(v)
        if self.tk(bx.ty) == Kind.Map and self.snapshot >= 0 and self.own.rootBinding(base) == self.snapshot {
            let c = self.copyMap(arr, bx.line)
            arr = self.copyVal(c)
        }
        self.preArray = base
        self.preArrayVal = arr
    }
}

// Leaves the function with v: its result, and a var self function's self after it.
fn Lower.emitReturn(var self, given: [Int]) {
    let d = self.current
    let x = self.dl(d)
    var v = given
    let selfB = if len(x.params) > 0 { self.pbind(x.params[0]) } else { -1 }
    let extra = if self.own.changesSelf(d) and not self.selfByAddress(d) {
        self.slots(self.bt(selfB))
    } else {
        0
    }
    if extra > 0 and len(v) == 0 and self.slots(x.retType) > 0 {
        v = []
        for _ in 0..self.slots(x.retType) {
            v.push(self.iconst(0))
        }
    }
    if self.selfHome >= 0 {
        let z = self.iconst(0)
        self.storeSlots(self.selfHome, z, 0, 0, self.regsOf(selfB))
    }
    var args = v
    if extra > 0 {
        args += self.regs[selfB][..extra]
    }
    let k = self.emitAt(.Ret, -1, -1, -1)
    self.cur.setArgs(k, args)
    for a in args {
        self.touch(a)
    }
}

fn Lower.lowerReturn(var self, given: [Int]) {
    var v = given
    if len(self.defers) > 0 {
        v = self.copyVal(v)
        self.runDefers(0, 0)
    }
    if len(self.inlining) > 0 {
        let fr = self.inlining[len(self.inlining) - 1]
        if len(v) > 0 {
            self.movVal(fr.result, v)
        }
        self.jmp(fr.end)
        return
    }
    if self.opts.debug {
        self.rtv(rtDebugLeave, [], 0)
    }
    self.emitReturn(v)
}

fn Lower.forSink(var self, s: Int, memory: Int, elem: [Int]) {
    let st = self.p.ast.stmts[s]
    let For(_, pattern, iter, body) = st.node else {
        return
    }
    let savedBreak = self.userBreak
    let savedContinue = self.userContinue
    let turnEnd = self.label()
    if pattern >= 0 {
        self.matchPattern(pattern, elem, self.elemOf(self.ty(iter)), turnEnd, false)
    } else if st.binding >= 0 {
        self.bind(st.binding, elem)
        self.traceValue(st.binding, st.line)
    }
    self.userBreak = self.loopBreak
    self.userContinue = turnEnd
    self.loopLevel += 1
    let _ = self.lowerBlock(body, tyVoid)
    self.loopLevel -= 1
    self.place(turnEnd)
    self.loopTurnEnd(memory, st.line)
    self.userBreak = savedBreak
    self.userContinue = savedContinue
}

fn Lower.forEntrySink(var self, s: Int, memory: Int, key: [Int]) {
    let st = self.p.ast.stmts[s]
    let For(_, _, _, body) = st.node else {
        return
    }
    if st.binding >= 0 {
        self.bind(st.binding, key)
    }
    let savedBreak = self.userBreak
    let savedContinue = self.userContinue
    let turnEnd = self.label()
    self.userBreak = self.loopBreak
    self.userContinue = turnEnd
    self.loopLevel += 1
    let _ = self.lowerBlock(body, tyVoid)
    self.loopLevel -= 1
    self.place(turnEnd)
    self.loopTurnEnd(memory, st.line)
    self.userBreak = savedBreak
    self.userContinue = savedContinue
}

fn Lower.readPlace(var self, p: PlaceRef, t: Int) -> [Int] {
    if not p.memory {
        return p.regs
    }
    let v = self.valOf(t)
    for j in 0..len(v) {
        self.emit(.Load, v[j], p.base, p.index, imm: p.stride, c: p.offset + j * 8)
    }
    v
}

fn Lower.placeValue(var self, e: Int) -> [Int] {
    let x = self.p.ast.exprs[e]
    let isPlace = match x.node {
        Name(_) => true
        Field(_, _) => true
        Index(_, i) => not self.p.ast.exprs[i].node is Range(_, _)
        _ => false
    }
    if isPlace {
        let p = self.placeOf(e)
        return self.readPlace(p, x.ty)
    }
    self.lowerExpr(e)
}

fn Lower.placeOf(var self, e: Int) -> PlaceRef {
    let x = self.p.ast.exprs[e]
    match x.node {
        Name(_) => {
            let b = x.binding
            if self.atAddress[b] {
                let z = self.iconst(0)
                return PlaceRef(memory: true, base: self.addrReg[b], index: z, ty: x.ty)
            }
            PlaceRef(regs: self.regsOf(b), ty: x.ty)
        }
        Index(target, index) => {
            let tt = self.ty(target)
            let late = self.addressRead(target)
            let writing = self.writing
            self.writing = false
            if self.tk(tt) == Kind.Map {
                let early = if late { self.lowerExpr(index) } else { [] }
                self.writing = writing
                let m = if writing {
                    self.ownedPlaceValue(target)
                } else {
                    self.placeValue(target)
                }
                self.writing = false
                let k = if late { early } else { self.lowerExpr(index) }
                self.writing = writing
                let base = self.mapAt(m, k, tt, x.line)
                let z = self.iconst(0)
                let z2 = self.iconst(0)
                return PlaceRef(
                    memory: true,
                    base: base,
                    index: z,
                    stride: 0,
                    holder: m[0],
                    holderLen: z2,
                    holderType: tt,
                    ty: x.ty,
                )
            }
            let early = if late { self.lowerExpr(index)[0] } else { -1 }
            self.writing = writing
            let arr = if writing {
                self.ownedPlaceValue(target)
            } else {
                self.placeValue(target)
            }
            self.writing = false
            let i = if late { early } else { self.lowerExpr(index)[0] }
            self.writing = writing
            self.bounds(i, arr[1], panicIndex, x.line)
            PlaceRef(
                memory: true,
                base: arr[0],
                index: i,
                stride: self.slots(x.ty) * 8,
                offset: 0,
                holder: arr[0],
                holderType: tt,
                ty: x.ty,
            )
        }
        Field(target, _) => {
            var outer = self.placeOf(target)
            let d = self.tdecl(self.ty(target))
            let at = self.recordOffset(d, x.caseIndex)
            let prm = self.dl(d).params[x.caseIndex]
            outer.boxed = self.boxed(prm)
            if outer.memory {
                outer.offset += at * 8
                outer.ty = x.ty
                return outer
            }
            let n = self.fieldSlots(prm)
            outer.regs = outer.regs[at..at + n]
            outer.ty = x.ty
            outer
        }
        _ => {
            let v = self.lowerExpr(e)
            PlaceRef(regs: self.copyVal(v), ty: x.ty)
        }
    }
}

fn Lower.rememberPlace(var self, p: PlaceRef) {
    if p.holderType >= 0 and (p.boxed or self.own.holdsMemory(p.ty)) {
        var upTo = p.holderLen
        if self.tk(p.holderType) == Kind.Array {
            let one = self.iconst(1)
            upTo = self.op2(.Add, p.index, one, 'I')
        }
        let d = self.descAddress(p.holderType)
        self.rtv(rtRemember, [p.holder, upTo, d], 0)
    }
}

// the place of e, for a change in place
fn Lower.changePlace(var self, e: Int) -> PlaceRef {
    let was = self.writing
    self.writing = true
    let p = self.placeOf(e)
    self.writing = was
    p
}

// the container e names (a place: a var, a field, an element), for a change in place: counted, made the place's own
// and written back there
fn Lower.ownedPlaceValue(var self, e: Int) -> [Int] {
    let x = self.p.ast.exprs[e]
    let isPlace = match x.node {
        Name(_) => true
        Field(_, _) => true
        Index(_, i) => not self.p.ast.exprs[i].node is Range(_, _)
        _ => false
    }
    if not isPlace {
        return self.lowerExpr(e)
    }
    let p = self.changePlace(e)
    let v = self.readPlace(p, x.ty)
    v
}

fn Lower.writePlace(var self, p: PlaceRef, given: [Int]) {
    self.writePlaceRaw(p, given)
}

// a write that lets go of nothing: what the place held is the same memory, or was let go of already
fn Lower.writePlaceRaw(var self, p: PlaceRef, given: [Int]) {
    var v = given
    if p.boxed {
        v = self.boxVal(v, p.ty, 0)
    }
    if not p.memory {
        self.movVal(p.regs, v)
        return
    }
    self.storeSlots(p.base, p.index, p.stride, p.offset, v)
    self.rememberPlace(p)
}

fn Lower.lowerAssign(var self, s: Int) {
    let st = self.p.ast.stmts[s]
    let Assign(target, op, value) = st.node else {
        return
    }
    let line = st.line
    let opNum = match op {
        Assign => 0
        PlusEq => 1
        MinusEq => 2
        StarEq => 3
        _ => 4
    }
    if self.isCPlace(target) {
        self.lowerCAssign(s, target, opNum, value)
        return
    }
    let root = self.own.rootBinding(target)
    let tx = self.p.ast.exprs[target]
    if tx.node is Index(mt, key) and self.ek(mt) == Kind.Map {
        let v = self.lowerInto(value, root)
        let m = self.ownedPlaceValue(mt)
        let k = self.lowerExpr(key)
        self.mapSet(m, k, self.keyOf(self.ty(mt)), v, line)
        return
    }
    let more = self.own.appended(s)
    if more >= 0 {
        let ys = self.lowerInto(more, root)
        let bytes = self.slots(self.elemOf(tx.ty)) * 8
        let own = tx.node is Name(_)
        var p = PlaceRef()
        if not own {
            p = self.changePlace(target)
        }
        let xs0 = if own {
            self.regsOf(tx.binding)[..2]
        } else {
            self.readPlace(p, tx.ty)
        }
        let xs = xs0
        let kb = self.iconst(bytes)
        let g0 = self.rtcall(rtArrayAppend, [xs[0], xs[1], ys[0], ys[1], kb], 'I', line)
        let g1 = self.op2(.Add, xs[1], ys[1], 'I')
        if self.own.holdsMemory(self.elemOf(tx.ty)) {
            let desc = self.descAddress(tx.ty)
            let none = self.label()
            self.jz(ys[1], none)
            let one = self.iconst(1)
            let from = self.op2(.Add, xs[1], one, 'I')
            self.rtv(rtRemember, [g0, from, desc], line)
            self.rtv(rtRemember, [g0, g1, desc], line)
            self.place(none)
        }
        if own {
            self.movVal(xs, [g0, g1])
        } else {
            self.writePlaceRaw(p, [g0, g1])
        }
        return
    }
    if opNum == 1
        and tx.node is Name(_)
        and self.tk(tx.ty) == Kind.Text
        and self.p.ast.exprs[value].node is Interp(_, _, _, _, _) {
        // s += "{w}{n} ": each piece onto s, in its room
        let Interp(values, parts, _, formats, _) = self.p.ast.exprs[value].node else {
            return
        }
        let cur = self.lowerExpr(target)
        let joined = self.interpOnto(cur, values, parts, formats, line)
        let fresh = self.copyVal(joined)
        let p = self.changePlace(target)
        self.writePlace(p, fresh)
        return
    }
    if opNum == 0 and tx.node is Name(_) {
        let v = self.lowerOwned(value, root >= 0 and self.p.bindings[root].deep)
        let fresh = self.copyVal(v)
        let p = self.changePlace(target)
        self.writePlace(p, fresh)
        return
    }
    if opNum == 0 or st.opValue >= 0 {
        let v = if opNum == 0 {
            self.lowerInto(value, root)
        } else {
            self.lowerStored(st.opValue)
        }
        let fresh = self.copyVal(v)
        let p = self.changePlace(target)
        self.writePlace(p, fresh)
        return
    }
    let p = self.changePlace(target)
    let cur = self.readPlace(p, tx.ty)
    let v = self.lowerExpr(value)
    var r: [Int] = []
    for i in 0..len(cur) {
        let f = self.cur.kinds[cur[i]] == 'F'
        let irOp = if opNum == 1 {
            if f { Op.Fadd } else { Op.Add }
        } else if opNum == 2 {
            if f { Op.Fsub } else { Op.Sub }
        } else if opNum == 3 {
            if f { Op.Fmul } else { Op.Mul }
        } else if f {
            Op.Fdiv
        } else {
            Op.Div
        }
        let reg = self.newReg(if f { 'F' } else { 'I' })
        let checked = not f and irOp != Op.Div
        self.emit(irOp, reg, cur[i], v[i], line: line, cond: if checked { 1 } else { 0 })
        r.push(reg)
    }
    self.writePlace(p, r)
}

// A pattern's names that a var keeps: their arrays and maps copied.
fn Lower.ownBindings(var self, arm: Int, line: Int) {
    let a = self.p.ast.arms[arm]
    for f in 0..len(a.binds) {
        if f < len(a.subs) and a.subs[f] >= 0 {
            self.ownBindings(a.subs[f], line)
        }
        let b = if f < len(a.bindings) { a.bindings[f] } else { -1 }
        if b < 0 or not self.bound[b] {
            continue
        }
        var v = self.regsOf(b)
        let t = self.bt(b)
        if self.p.bindings[b].deep {
            v = self.deepCopy(v, t, line)
        } else if self.tk(t) is Array | Map {
            v = self.copyOf(v, t, line)
        }
        let c = self.copyVal(v)
        self.regs[b] = c
    }
}

// ---- for the debugger: lines, values, frames ----
fn Lower.traceable(self, t: Int) -> Bool =
    t != tyNone
        and t != tyErr
        and self.tk(t) is Int | Float | Bool | Text | Bytes | Enum | Record | Array | Map | Handle

// the name's new value, as print writes it, to the debugger: in its frame, and under its node's graph key
fn Lower.traceValue(var self, b: Int, line: Int) {
    if not self.opts.debug or b < 0 or not self.bound[b] or self.atAddress[b] or len(self.regs[b]) == 0 {
        return
    }
    let t = self.bt(b)
    let name = self.p.bindings[b].name
    if t < 0 or not self.traceable(t) or name.startsWith("#") {
        return
    }
    var key = ""
    if line != 0 and self.opts.debugKeys[line] is Some(k) {
        let parts = k.split("/")
        if len(parts) > 1 and parts[len(parts) - 1] == name {
            key = k // the statement's key, when it is this name's node
        }
    }
    if key == "" {
        key = "{self.shownName(self.current)}/{name}"
    }
    self.rtv(rtCaptureBegin, [], line)
    self.printVal(self.regs[b], t)
    let text = self.unpackText(self.rtcall(rtCaptureEnd, [], 'I', line))
    let n = self.literalText(name)
    let k = self.literalText(key)
    self.rtv(rtDebugValue, [n[0], n[1], k[0], k[1], text[0], text[1]], line)
}

fn Lower.debugLine(var self, line: Int) {
    if self.opts.debug and line > 0 {
        let x = self.iconst(line)
        self.rtv(rtDebugLine, [x], line)
    }
}

fn Lower.lowerStmt(var self, s: Int) {
    self.debugLine(self.p.ast.stmts[s].line)
    let depth = self.branchDepth
    self.branchDepth = 0
    self.lowerStmtInner(s)
    self.branchDepth = depth
    if not self.opts.debug {
        return
    }
    let st = self.p.ast.stmts[s]
    match st.node {
        Let(_, _, _, _, pattern, _) => {
            if pattern >= 0 {
                for b in self.p.ast.arms[pattern].bindings {
                    self.traceValue(b, st.line)
                }
            } else if st.binding >= 0 and not self.p.bindings[st.binding].lazy {
                self.traceValue(st.binding, st.line)
            }
        }
        Assign(target, _, _) => self.traceValue(self.own.rootBinding(target), 0)
        ExprStmt(value) => {
            let x = self.p.ast.exprs[value]
            if x.node is Call(_, _, _, _, _, _)
                and len(self.argsOf(value)) > 0
                and (x.builtin == bPush
                    or x.builtin == bPop
                    or x.builtin == bRemove
                    or x.builtin == bAdd
                    or self.own.changesSelfCall(value)) {
                self.traceValue(self.own.rootBinding(self.argsOf(value)[0]), 0) // xs.push(x), p.next(): the var it changed
            }
        }
        _ => {}
    }
}

fn Lower.lowerStmtInner(var self, s: Int) {
    let st = self.p.ast.stmts[s]
    let line = st.line
    match st.node {
        Let(mutable, _, _, value, pattern, otherwise) => {
            if pattern >= 0 {
                let wv = self.lowerExpr(value)
                let whole = self.copyVal(wv)
                let fail = self.label()
                let ok = self.label()
                self.matchPattern(pattern, whole, self.ty(value), fail, true)
                if mutable {
                    self.ownBindings(pattern, line)
                }
                self.jmp(ok)
                self.place(fail)
                if otherwise >= 0 {
                    let _ = self.lowerBlock(otherwise, tyVoid)
                }
                self.place(ok)
                return
            }
            let b = st.binding
            let vt = self.ty(value)
            if b < 0 {
                if self.tk(vt) is Iter | Range {
                    let _ = self.materialize(value, self.elemOf(vt), line)
                } else {
                    let _ = self.lowerExpr(value)
                }
                return
            }
            if self.p.bindings[b].lazy {
                return
            }
            var v: [Int] = []
            var borrowed = false
            if self.tk(vt) is Range | Iter {
                v = self.materialize(value, self.elemOf(vt), line)
            } else if mutable {
                v = self.lowerOwned(value, self.p.bindings[b].deep)
            } else if self.own.borrowed[s] > 0 {
                // borrowed (what it holds is the var's: kept anywhere else, it is copied), or taken (its own)
                v = self.lowerExpr(value)
                borrowed = true
            } else {
                v = self.lowerStored(value)
            }
            self.atAddress[b] = false
            if self.selfInPlace[b]
                and mutable
                and not self.opts.debug
                and self.areaAt >= 0
                and self.slots(self.bt(b)) > selfInRegisters {
                self.regs[b] = []
                self.bound[b] = true
                self.atAddress[b] = true
                let at = self.areaTake(len(v))
                self.addrReg[b] = at
                let z = self.iconst(0)
                self.storeSlots(at, z, 0, 0, v)
                return
            }
            let c = self.valOf(self.bt(b))
            self.movVal(c, v)
            self.bind(b, c)
        }
        Assign(_, _, _) => self.lowerAssign(s)
        ExprStmt(value) => {
            let _ = self.lowerExpr(value)
        }
        For(_, _, iter, body) => {
            let changes = self.own.scanLoop(body)
            let it = self.ty(iter)
            if self.tk(it) == Kind.Map {
                let mv = self.lowerExpr(iter)
                var m = self.copyVal(mv)
                let root = self.own.rootBinding(iter)
                for r in changes.roots {
                    if root >= 0 and r == root {
                        let c = self.copyMap(m, line)
                        m = self.copyVal(c)
                    }
                }
                let mem = self.loopBegin(body)
                self.forEachEntry(m, it, .ForEntry(s, mem), line)
            } else {
                var base = self.stripImplicit(iter)
                while self.p.ast.exprs[base].node is Call(_, _, _, _, _, _)
                    and passesThrough(self.p.ast.exprs[base].builtin) {
                    base = self.stripImplicit(self.arg(base, 0))
                }
                let root = if self.ek(base) == Kind.Map {
                    self.own.rootBinding(base)
                } else {
                    -1
                }
                for r in changes.roots {
                    if root >= 0 and r == root {
                        self.snapshot = root
                    }
                }
                self.preLowerSource(iter)
                self.snapshot = -1
                let mem = self.loopBegin(body)
                self.forEach(iter, .ForBody(s, mem))
            }
        }
        While(cond, body) => {
            let mem = self.loopBegin(body)
            let top = self.label()
            let test = self.label()
            let done = self.label()
            let turnEnd = self.label()
            let names = self.bindsNames(cond)
            self.depth += 1
            if not names {
                self.jmp(test)
            }
            self.place(top)
            self.fuel(line)
            if names {
                self.branchDepth += 1
                let c = self.lowerExpr(cond)[0]
                self.branchDepth -= 1
                self.jz(c, done)
            }
            let savedBreak = self.userBreak
            let savedContinue = self.userContinue
            self.userBreak = done
            self.userContinue = turnEnd
            self.loopLevel += 1
            let _ = self.lowerBlock(body, tyVoid)
            self.loopLevel -= 1
            self.place(turnEnd)
            self.loopTurnEnd(mem, line)
            self.userBreak = savedBreak
            self.userContinue = savedContinue
            if names {
                self.jmp(top)
            } else {
                self.place(test)
                self.branchDepth += 1
                let c = self.lowerExpr(cond)[0]
                self.branchDepth -= 1
                self.jnz(c, top)
            }
            self.depth -= 1
            self.place(done)
        }
        Defer(_) => {}
        Return(value) => {
            let v = if value >= 0 { self.lowerStored(value) } else { [] }
            self.lowerReturn(v)
        }
        Break => {
            self.runDefers(0, self.loopLevel)
            self.jmp(self.userBreak)
        }
        Continue => {
            self.runDefers(0, self.loopLevel)
            self.jmp(self.userContinue)
        }
    }
}

// ---- functions ----
fn Lower.lowerFn(var self, d: Int, index: Int) {
    let x = self.dl(d)
    self.cur = IrFn(x.name, line: x.line)
    self.fnId = index
    self.current = d
    self.depth = 0
    self.inlined = 0
    self.selfHome = -1
    let byAddress = self.selfByAddress(d)
    var params: [Int] = []
    for (i, prm) in x.params.enumerate() {
        let b = self.pbind(prm)
        let atAddr = i == 0 and byAddress
        self.atAddress[b] = atAddr
        if atAddr {
            self.regs[b] = []
            self.bound[b] = true
            let r = self.newReg('I')
            self.addrReg[b] = r
            params.push(r)
            if self.selfInRegs(d) {
                self.selfHome = r
                self.atAddress[b] = false
                let v = self.loadSlots(r, self.bt(b))
                self.regs[b] = v
            }
            continue
        }
        if self.paramByRef(d, i) {
            // a large record: the address of the caller's slots, read where they are
            self.regs[b] = []
            self.bound[b] = true
            self.atAddress[b] = true
            let r = self.newReg('I')
            self.addrReg[b] = r
            params.push(r)
            continue
        }
        let v = self.valOf(self.bt(b))
        self.bind(b, v)
        params += v
    }
    self.cur.params = params
    var at = 8
    for inner in x.captureInner {
        let v = self.valOf(self.bt(inner))
        let env = self.regs[x.env][0]
        for r in v {
            let z = self.iconst(0)
            self.emit(.Load, r, env, z, imm: 8, c: at)
            at += 8
        }
        self.bind(inner, v)
    }
    let ret = if x.retType >= 0 { x.retType } else { tyVoid }
    let selfB = if len(x.params) > 0 { self.pbind(x.params[0]) } else { -1 }
    self.cur.resultCount = self.slots(ret) + (if self.own.changesSelf(d) and not byAddress {
        self.slots(self.bt(selfB))
    } else {
        0
    })
    self.maxOut(self.cur.resultCount)
    self.maxOut(len(params))
    if self.opts.debug {
        // its frame, and its parameters' values
        let name = self.literalText(self.shownName(d))
        self.rtv(rtDebugEnter, name, x.line)
        for prm in x.params {
            self.traceValue(self.pbind(prm), 0)
        }
    }
    self.areaAt = len(self.cur.code)
    self.areaSlots = 0
    for _ in 0..3 {
        self.emit(.Nop, -1, -1, -1)
    }
    self.fuel(x.line)
    let v = if self.isBlockExpr(x.body) {
        self.lowerBlock(self.blockOfExpr(x.body), ret)
    } else {
        self.lowerStored(x.body)
    }
    if self.opts.debug {
        self.rtv(rtDebugLeave, [], 0)
    }
    self.emitReturn(if self.slots(ret) > 0 and len(v) > 0 { v } else { [] })
    self.areaAt = -1
    self.selfHome = -1
}

// fn main() -> Int as an executable's entry: its value the exit status
fn Lower.lowerEntry(var self, main: Int, index: Int) {
    let x = self.dl(main)
    self.cur = IrFn("#entry", line: x.line)
    self.fnId = index
    self.current = main
    self.depth = 0
    let result = self.callDecl(main, [], x.line)
    let t = x.retType
    let done = self.label()
    if self.tk(t) == Kind.Enum {
        let d = self.tdecl(t)
        let dx = self.dl(d)
        let success = self.label()
        self.jnz(result[0], success)
        let two = self.iconst(2)
        self.rtv(rtPrintTo, [two], x.line)
        let at = self.caseOffset(d, 0)
        self.printVal(result[at..at + self.slots(dx.errorOf)], dx.errorOf)
        self.rtv(rtPrintEnd, [], x.line)
        let one = self.iconst(1)
        self.rtv(rtPrintTo, [one], x.line)
        let one2 = self.iconst(1)
        self.rtv(rtExit, [one2], x.line)
        self.place(success)
        if dx.resultOf == tyInt {
            let code = result[self.caseOffset(d, 1)]
            self.jz(code, done)
            self.rtv(rtExit, [code], x.line)
        }
    } else {
        self.jz(result[0], done)
        self.rtv(rtExit, result[..1], x.line)
    }
    self.place(done)
    self.emit(.Ret, -1, -1, -1)
}

fn Lower.lowerHelper(var self, h: Helper, index: Int) {
    let name = if h.textFind {
        "find a text key"
    } else if h.owns {
        "own " + self.p.typeName(h.t)
    } else {
        "print " + self.p.typeName(h.t)
    }
    self.cur = IrFn(name)
    self.fnId = index
    self.current = -1
    self.depth = 0
    self.inl = 0
    self.inlining = []
    self.printing = []
    self.areaAt = -1 // (no area of its own: refOf allocates)
    self.defers = []
    if h.textFind {
        self.textFindHelper()
        return
    } else if h.owns {
        self.lowerOwnHelper(h.t)
    } else if h.byValue {
        let v = self.valOf(h.t)
        self.cur.params = v
        self.cur.maxOut = len(v)
        self.printVal(v, h.t)
    } else {
        let p = self.newReg('I')
        self.cur.params = [p]
        self.cur.maxOut = 1
        let v = self.loadSlots(p, h.t)
        self.printVal(v, h.t)
    }
    self.emit(.Ret, -1, -1, -1)
}

// Text(p, n), Bytes(p, n): n bytes of C's memory, copied into the arena
fn Lower.lowerCBytes(var self, e: Int) -> [Int] {
    let p = self.lowerExpr(self.arg(e, 0))[0]
    let n = self.lowerExpr(self.arg(e, 1))[0]
    if self.builtinOf(e) == bTextOf {
        return self.textOfC(p, n, self.lineOf(e))
    }
    let one = self.iconst(1)
    let r = self.rtcall(rtCopy, [p, n, one], 'I', self.lineOf(e))
    [r, n]
}

// The program lowered.
pub fn lowerProgram(p: Program, opts: LowerOptions) -> Lowered {
    var low = Lowered(IrProgram(), [], [])
    low.lowerFrom(p, opts)
    low
}

// lowerProgram's work, into a var: its program is never copied (the caller optimizes it there)
pub fn Lowered.lowerFrom(var self, p: Program, opts: LowerOptions) {
    let n = len(p.decls)
    let nb = len(p.bindings)
    var l = Lower(p, Ownership(p, debug: opts.debug), opts: opts)
    let noRegs: [Int] = []
    l.regs = [noRegs] * nb
    l.bound = [false] * nb
    l.atAddress = [false] * nb
    l.addrReg = [-1] * nb
    l.selfInPlace = [false] * nb
    l.fnIndex = [0] * n
    l.inlineCost = [0] * n
    l.sizeMemo = [-1] * n
    l.selfMemo = [0] * n
    l.asValue = [false] * n
    l.externIndex = [-1] * n
    l.out.fuel = opts.fuel
    l.out.runtime = runtimeTable()
    l.own.decideAliases()
    l.own.decideTakes()
    l.own.decideResults()
    l.markInPlace()
    var count = 0
    var main = -1
    for (i, d) in p.decls.enumerate() {
        let x = p.ast.decls[d]
        if x.kind == DeclKind.Fn and not l.isCFunction(d) and not x.isTemplate and not x.inlineOnly {
            l.fnIndex[i] = count
            count += 1
        }
        if p.executable
            and x.kind == DeclKind.Fn
            and x.module == 0
            and x.name == "main"
            and not x.isExtern
            and not x.isTemplate
            and x.retType >= 0
            and (x.retType == tyInt or p.types[x.retType].kind == Kind.Enum) {
            main = d
        }
    }
    let entryAt = if main >= 0 { count } else { -1 }
    l.outCount = if main >= 0 { count + 1 } else { count }
    l.fns = [IrFn("")] * l.outCount
    main = -1
    l.out.mainIndex = -1
    for (i, d) in p.decls.enumerate() {
        let x = p.ast.decls[d]
        if x.kind != DeclKind.Fn or l.isCFunction(d) or x.isTemplate or x.inlineOnly {
            continue
        }
        let sym = if x.externSymbol != "" { x.externSymbol } else { x.name }
        let runtimeFn = x.isExtern and sym.startsWith("qk_") // the runtime's: called the Quark way, by that name
        if x.isExtern and not runtimeFn {
            l.lateFor(0, d, x.cTypes, if x.isPub { Some(sym) } else { None })
        }
        let at = l.fnIndex[i]
        l.lowerFn(d, at)
        if runtimeFn and x.isPub {
            l.cur.exportName = Some(sym)
        }
        let done = l.cur // taken: l.cur gets a new function next
        l.cur = IrFn("")
        l.fns[at] = done
        if x.module == 0 and x.name == "main" {
            l.out.mainIndex = at
            main = d
        }
    }
    if entryAt >= 0 and main >= 0 {
        l.lowerEntry(main, entryAt)
        let done = l.cur // taken: l.cur gets a new function next
        l.cur = IrFn("")
        l.fns[entryAt] = done
        l.out.mainIndex = entryAt
    }
    var h = 0
    while h < len(l.helpers) {
        let slot = l.outCount
        l.outCount += 1
        l.helpersDone += 1
        l.fns.push(IrFn(""))
        l.lowerHelper(l.helpers[h], slot)
        let done = l.cur // taken: l.cur gets a new function next
        l.cur = IrFn("")
        l.fns[slot] = done
        h += 1
    }
    var k = 0
    while k < len(l.lates) {
        let slot = l.outCount
        l.lates[k].index = slot
        l.outCount += 1
        l.fns.push(IrFn(""))
        l.fnId = slot
        let late = l.lates[k]
        if late.kind != 0 {
            l.lowerMachine(late)
        } else {
            l.lowerCEntry(late)
        }
        let done = l.cur // taken: l.cur gets a new function next
        l.cur = IrFn("")
        l.fns[slot] = done
        k += 1
    }
    for lp in l.latePatches {
        let target = l.lates[lp.late].index
        l.fns[lp.fnId].code[lp.at].imm = target
    }
    for i in 0..len(l.fns) {
        let nk = len(l.fns[i].kinds)
        l.fns[i].isConst = [false] * nk
        l.fns[i].constValue = [0] * nk
    }
    let fns = l.fns // taken: no copy of the program
    l.fns = []
    l.out.fns = fns
    l.out.dataLen = len(l.data)
    let out = l.out // taken
    l.out = IrProgram()
    self.program = out
    self.data = l.data
    self.inlines = l.inlines
}

// The vars that calls want in memory (p.parse(), p.lexer.next()): kept there.
fn Lower.markInPlace(var self) {
    for d in self.p.decls {
        let x = self.dl(d)
        if x.kind != DeclKind.Fn or x.body < 0 {
            continue
        }
        for e in self.own.visitExpr(x.body, []) {
            if e < 0 {
                continue
            }
            let b = self.own.selfCallOn(e)
            if b >= 0 and not self.p.bindings[b].isParam and self.wantsPlace(self.p.ast.exprs[e].decl) {
                self.selfInPlace[b] = true
            }
            // a function kept as a value (f in xs.map(f), an interface's table): called with slots
            let ex = self.p.ast.exprs[e]
            if ex.node is Name(_) and ex.binding < 0 and ex.decl >= 0 and self.p.ast.decls[ex.decl].kind == DeclKind.Fn {
                self.asValue[self.p.ast.decls[ex.decl].index] = true
            }
        }
    }
}

// ---- the IR as text: quark ir's JSON (every field), and its readable dump ----
fn jsonText(s: Text) -> Text {
    var out = "\""
    for c in s.bytes() {
        if c == '"' or c == '\\' {
            out += "\\" + char(c)
        } else if c < 0x20 {
            let hex = "0123456789abcdef"
            out += "\\u00" + hex[c >> 4..c >> 4 + 1] + hex[c & 15..c & 15 + 1]
        } else {
            out += char(c)
        }
    }
    out + "\""
}

fn jsonMaybe(s: Text?) -> Text = match s {
    Some(t) => jsonText(t)
    None => "null"
}

fn jsonInts(v: [Int]) -> Text = "[" + v.map(x => x.toText()).join(",") + "]"

fn bytesText(b: Bytes) -> Text = Text(b) ?? ""

// a weight as C's %.17g writes it (they are whole numbers, sums of powers of 8)
fn weightText(w: Float) -> Text {
    if w == toFloat(toInt(w)) and w < 1.0e17 {
        return toInt(w).toText()
    }
    w.toText()
}

// quark ir --json --lowered: what lowering made, and what the optimizers read besides
pub fn irJson(p: IrProgram, lowered: Bool) -> Text {
    let t = p.target
    var parts: [Text] = []
    parts.push(
        "\{\"arch\":\"{if t.arch == Arch.Arm64 { "arm64" } else { "x64" }}\",\"abi\":\"{if t.sysv { "sysv" } else { "win64" }}\",\"object\":{t.objectMode},\"avx\":{t.avx},\"lanes\":{t.lanes},\"mainIndex\":{p.mainIndex},\"fuel\":{p.fuel},\"dataLen\":{p.dataLen},\n",
    )
    if lowered {
        var tables: [Text] = []
        for tb in p.tables {
            tables.push("[{tb.at},{jsonInts(tb.fns)}]")
        }
        parts.push("\"sse42\":{t.sse42},\"tables\":[{tables.join(",")}],\n")
    }
    var rt: [Text] = []
    for r in p.runtime {
        rt.push("[{jsonText(bytesText(r.args))},\"{char(r.ret)}\"]")
    }
    parts.push("\"runtime\":[{rt.join(",")}],\n\"externs\":[")
    for (i, x) in p.externs.enumerate() {
        parts.push(
            (if i > 0 { ",\n\{\"name\":" } else { "\n\{\"name\":" })
                + jsonText(x.name)
                + ",\"lib\":"
                + jsonMaybe(x.lib)
                + ",\"retHidden\":{x.retHidden},\"args\":\"{bytesText(x.argKinds)}\",\"rets\":\"{bytesText(x.retKinds)}\""
                + (if x.fixed >= 0 { ",\"fixed\":{x.fixed}" } else { "" })
                + "\}",
        )
    }
    parts.push("],\n\"fns\":[")
    for (i, f) in p.fns.enumerate() {
        var s = (if i > 0 { ",\n\{\"name\":" } else { "\n\{\"name\":" }) + jsonText(f.name)
        s += ",\"line\":{f.line},\"params\":{jsonInts(f.params)},\"results\":{f.resultCount},\"labels\":{f.labelCount},\"maxOut\":{f.maxOut},\"machine\":{f.machine},\"cHidden\":{f.cHidden},\"cArgs\":"
        let cArgs = match f.cArgs {
            Some(b) => Some(bytesText(b))
            None => None
        }
        s += jsonMaybe(cArgs)
            + ",\"cRets\":"
            + (if cArgs != None { jsonText(bytesText(f.cRets)) } else { "null" })
            + ",\"export\":"
            + jsonMaybe(f.exportName)
        s += ",\"kinds\":\"{bytesText(f.kinds)}\",\"weights\":["
            + f.weight.map(w => weightText(w)).join(",")
            + "],\"consts\":["
        var consts: [Text] = []
        for v in 0..len(f.isConst) {
            if f.isConst[v] {
                consts.push("{v},{f.constValue[v]}")
            }
        }
        s += consts.join(",") + "],\"code\":["
        var code: [Text] = []
        for ins in f.code {
            code.push(
                "[{ins.op.index()},{ins.cond},{ins.dst},{ins.a},{ins.b},{ins.c},{ins.imm},{ins.line},{ins.inl},{jsonInts(f.argsOf(ins))},{jsonInts(f.retsOf(ins))}]",
            )
        }
        s += code.join(",") + "]\}"
        parts.push(s)
    }
    parts.push("]\}\n")
    parts.join("")
}

const opNames = [
    "const", "mov", "add", "sub", "mul", "div", "mod", "neg", "fadd", "fsub", "fmul", "fdiv", "fneg", "sqrt", "fmin",
    "fmax", "cmp", "fcmp", "not", "i2f", "f2i", "round", "load", "store", "bounds", "label", "jmp", "jz", "jnz", "call",
    "rtcall", "ret", "fuel", "hostcall", "nop", "and", "or", "xor", "shl", "sar", "vload", "vstore", "vsplat", "vop",
    "vlane", "vend", "ctx",
]

const condNames = ["==", "!=", "<", "<=", ">", ">="]
const widthNames = ["", "", "i8", "u16", "i16", "u32", "i32", "f32", "f32 bits"]

fn regName(f: IrFn, r: Int) -> Text = (if f.kinds[r] == 'F' { "f" } else { "r" }) + r.toText()

// quark ir: a readable dump
pub fn irDump(p: IrProgram) -> Text {
    var out: [Text] = []
    for f in p.fns {
        out.push("fn {f.name} ({len(f.params)} params, {f.resultCount} results, {len(f.kinds)} registers)\n")
        for ins in f.code {
            if ins.op == Op.Label {
                out.push("  L{ins.imm}:\n")
                continue
            }
            let name = opNames[ins.op.index()]
            var s = "    " + name + " " * max(7 - len(name), 0)
            if ins.dst >= 0 {
                s += " " + regName(f, ins.dst)
            }
            if ins.op is Cmp | Fcmp {
                s += " = r{ins.a} {condNames[ins.cond]} r{ins.b}"
            } else {
                if ins.a >= 0 {
                    s += " " + regName(f, ins.a)
                }
                if ins.b >= 0 {
                    s += " " + regName(f, ins.b)
                }
            }
            if ins.op is Const | Jmp | Jz | Jnz | Load | Store | Call | RtCall | Round | HostCall {
                s += " #{ins.imm}"
            }
            if ins.op is Load | Store | Vload | Vstore | Vlane and ins.c != 0 {
                s += " +{ins.c}"
            }
            if ins.op is Load | Store and ins.cond >= memI8 and ins.cond <= memF32Bits {
                s += " ({widthNames[ins.cond]})"
            }
            if ins.op == Op.Vop {
                let cmpOp = ins.imm == 16 or ins.imm == 17
                s += " " + opNames[ins.imm] + (if cmpOp { " " + condNames[ins.cond] } else { "" })
            }
            if ins.op == Op.Const and ins.c == 1 {
                s += " (data)"
            }
            if ins.op == Op.Const and ins.c == 2 {
                s += " (function)"
            }
            for (j, a) in f.argsOf(ins).enumerate() {
                s += (if j > 0 { ", " } else { " (" }) + regName(f, a)
            }
            if ins.argCount > 0 {
                s += ")"
            }
            for (j, r) in f.retsOf(ins).enumerate() {
                s += (if j > 0 { ", r" } else { " -> r" }) + r.toText()
            }
            out.push(s + "\n")
        }
    }
    out.join("")
}
