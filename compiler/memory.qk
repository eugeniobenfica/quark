// Programs run in memory and built into executables by the compiler, with
// its own runtime: the runtime written in Quark (compiled from the texts the compiler keeps, compiler/stdlib.qk) is
// mapped into this process and runs the program (quark run, test, debug, repl), or goes in front of the program in
// an executable (quark build). The runtime's side of it is compiler/runtime/host.qk.
use std.machine as machine
use source
use types
use ast
use module
use parser
use check
use ir
use lower
use ownership
use release
use cachedir
use format
use construn
use cache
use x64
use arm64
use image
use dwarf
use wasm
use imagecli
use stdlib
use graph

// what the command line was given (compiler/cli.qk)
pub type RunOptions {
    command: Text = ""
    path: Text = ""
    outPath: Text? = None
    symbol: Text? = None
    target: Text? = None
    libc: Text = "" // build --target ...-linux: glibc (the default) or musl
    fuel: Int = 0
    memory: Int = 0 // bytes (--memory MB)
    release: Bool = false
    debugInfo: Bool = false // -g: debug information (compiler/dwarf.qk) in the object, the executable, or for the JIT
    noAvx: Bool = false
    sysv: Bool = false // --abi sysv
    linked: Bool = false
    allowed: Text? = None
    prelude: Text = ""
    timed: Bool = false
    profile: Bool = false
    tracePath: Text = ""
    breaks: [Int] = []
    programArgs: [Text] = []
    filter: Text = "" // quark test --filter part: only the tests whose name has it
    coverage: Bool = false // quark test --coverage: which lines of the file the tests ran
}

// a program compiled: its IR, machine code, data and inlined calls; its tests (each function's name and the test's)
pub type Compiled {
    prog: IrProgram
    mc: MachineCode
    data: Bytes
    inlines: [InlineCall] = []
    tests: [(Text, Text)] = []
    features: Int = 0
    os: Os = .Windows
    linked: Bool = false
}

// ---- compiling ----
// What a compile is for: this machine (target ""), or the one named (--target: object, code, ir), for objects (each
// address from a table) or not, the runtime itself (linked: its table filled by the linker), debugging.
pub type Purpose {
    target: Text = ""
    object: Bool = false
    linked: Bool = false
    runtime: Bool = false
    needMain: Bool = false
    debug: Bool = false
    used: [Bool] = [] // the runtime for one program: the functions of its table it calls (empty: all of them)
}

fn targetOs(host: Host, target: Text) -> Os = if target == "" {
    host.os
} else if target.endsWith("windows") {
    Os.Windows
} else if target.endsWith("linux") or target.startsWith("wasm32") {
    Os.Linux // (wasm32: the IR is made as for System V; compiler/wasm.qk makes the module)
} else {
    Os.Macos
}

// --target's names (x86_64 or arm64, then windows, linux or macos), as setTarget reads them: the
// canonical one, or "" when it names none
pub fn targetName(t: Text) -> Text {
    if t is "wasm32" | "wasm32-wasi" | "wasm32-wasip1" {
        return "wasm32-wasi"
    }
    let arm = t.startsWith("arm64") or t.startsWith("aarch64")
    let x64 = t.startsWith("x86_64") or t.startsWith("x64")
    let dash = t.indexOf("-") ?? -1
    let os = if dash >= 0 { t[dash + 1..] } else { "" }
    if not arm and not x64 or not os is "windows" | "linux" | "macos" | "ios" {
        return ""
    }
    (if arm { "arm64-" } else { "x86_64-" }) + (if os == "ios" { "macos" } else { os })
}

// the program at path (its text given: the REPL's), checked, lowered, optimized and made machine code; its errors
// said (unless quiet) and None when it has any
pub fn compileText(host: Host, src: Source, o: RunOptions, purpose: Purpose, quiet: Bool) -> Compiled? {
    let t0 = monotonicTime()
    var preludeSrc: Source? = None
    if o.prelude != "" and not purpose.runtime {
        let Ok(text) = readFile(o.prelude) else {
            printErr("quark: cannot read {o.prelude}")
            return None
        }
        preludeSrc = Source(o.prelude, text)
    }
    // read, checked and its constants worked out: as an earlier build left it (its image), when every file it read is
    // as it was; else here, and its image kept for the next build (docs/PLANO.md B13)
    let imageKey = "{compilerSources}|{src.path}|{purpose.needMain}|{o.allowed ?? "-"}|{o.prelude}"
    // (QUARK_IMAGES=off: none; build.sh's stage1 runs so: a compiler built by an older one has its runtime, which may
    // have no images)
    let imageAt = if purpose.runtime or env("QUARK_CACHE") == Some("off") or env("QUARK_IMAGES") == Some("off") {
        ""
    } else {
        var h = Hash128()
        h.add(imageKey.bytes())
        cachePath("quark-check-{h.text()}.bin")
    }
    var fromImage: Program? = None
    var wasBuilt: Built? = None
    var base: CheckImage? = None // an image of files that have changed since: what a build after an edit goes on from
    if imageAt != "" {
        let kept: CheckImage? = machine.loadImage(imageAt)
        if kept is Some(image) and image.key == imageKey {
            if sameSources(image.program, src, preludeSrc) {
                fromImage = Some(image.program)
                wasBuilt = image.built
            } else {
                base = Some(image)
            }
        }
    }
    // after an edit of function bodies only: from the base, those bodies checked and lowered again
    if base is Some(image) and not purpose.runtime and not o.release and not purpose.target.startsWith("wasm32") {
        match afterEdit(host, image, src, preludeSrc, o, purpose, quiet, t0) {
            Done(c) => return Some(c)
            Failed => return None
            NotHere => {}
        }
    }
    var checkedProgram = fromImage ?? (checkedHere(host, src, preludeSrc, o, purpose, quiet) ?? return None)
    // (kept when reading and checking it took long enough for its image to be read faster: not a small program's)
    // (QUARK_IMAGES=always: whatever its size, for the tests)
    let keepImage = fromImage is None
        and imageAt != ""
        and (monotonicTime() - t0 > 0.15 or env("QUARK_IMAGES") == Some("always"))
    let t1 = monotonicTime()
    let cpu = machine.cpu()
    let target = purpose.target
    let arm = if target == "" { host.arm } else { target.startsWith("arm64") }
    let os = targetOs(host, target)
    let avx = target == "" and not arm and not o.noAvx and cpu & 1 != 0
    let sysv = if target == "" {
        os != .Windows or o.sysv and not purpose.runtime
    } else {
        os != .Windows
    }
    let arch = if arm { Arch.Arm64 } else { Arch.X64 }
    let runtime = purpose.runtime
    let release = o.release and not runtime
    // for the debugger (compiler/debugrun.qk), each line's graph key names its values
    let debug = purpose.debug and not runtime
    let keys = if debug { lineKeys(checkedProgram) } else { [:] }
    let lowering = LowerOptions(
        fuel: o.fuel > 0 and not runtime,
        runtime: runtime,
        linked: purpose.linked,
        arch: arch,
        sysv: sysv,
        debug: debug,
        debugKeys: keys,
        coverage: o.coverage and not runtime,
        runtimeUsed: purpose.used,
    )
    let wasm = target.startsWith("wasm32")
    let lanes = if wasm {
        0 // (no vector loops: the wasm backend makes none)
    } else if arm {
        2
    } else if avx and cpu & 2 != 0 {
        4
    } else {
        2
    }
    let made = Target(
        arch: arch,
        sysv: sysv,
        objectMode: purpose.object,
        avx: avx,
        lanes: lanes,
        sse42: cpu & 4 != 0 and target == "",
        apple: os == .Macos,
        lines: o.debugInfo and not runtime,
        checks: false,
    )
    if not runtime and not release and not wasm {
        // as the image's build made it, when the files and what they are built for are the same
        let builtKey = "{arch}|{sysv}|{avx}|{lanes}|{target}|{purpose.object}|{purpose.linked}|{debug}|{o.fuel > 0}|{o.coverage}|{o.debugInfo}|{len(purpose.used)}"
        if wasBuilt is Some(b) and b.key == builtKey {
            if o.timed {
                printErr(
                    "quark: parsed and checked in {fixed((t1 - t0) * 1000, 2)} ms, compiled in {fixed((monotonicTime() - t1) * 1000, 2)} ms ({len(b.mc.code)} bytes of machine code): as the last build made it",
                )
            }
            return Some(
                Compiled(
                    b.prog,
                    b.mc,
                    b.data,
                    b.inlines,
                    testsOf(checkedProgram),
                    if avx { 1 } else { 0 },
                    os,
                    purpose.linked,
                ),
            )
        }
        // in batches: each lowered, then optimized (the quick tier, which makes no vector loops) and made machine code
        // on the threads while the next is lowered; only the code is kept, so the whole program's IR never is at once
        var l = lowerBegin(checkedProgram, lowering)
        let quick = made with { lanes: 0 }
        var x64Parts: [X64Part] = []
        var arm64Parts: [Arm64Part] = []
        let mc = match arch {
            X64 => {
                x64Parts = l.streamX64(quick)
                genX64Join(quick, l.out.runtime, l.out.externs, l.out.cSigs, len(l.fns), x64Parts)
            }
            Arm64 => {
                arm64Parts = l.streamArm64(quick)
                genArm64Join(quick, l.out.runtime, l.out.externs, l.out.cSigs, len(l.fns), arm64Parts)
            }
        }
        var low = l.lowered()
        low.program.target = quick
        if o.timed {
            let t4 = monotonicTime()
            printErr(
                "quark: parsed and checked in {fixed((t1 - t0) * 1000, 2)} ms, compiled in {fixed((t4 - t1) * 1000, 2)} ms ({len(mc.code)} bytes of machine code): lowered, optimized and made machine code in batches",
            )
        }
        let prog = low.program // taken
        low.program = IrProgram()
        if keepImage or fromImage is Some(_) and imageAt != "" {
            // the program and what it was built into, for the next build
            // (with what lowering worked out, and each function's code on its own: what a build after an edit takes up)
            var x64Kept: [X64Part] = []
            for p in x64Parts {
                x64Kept += splitX64Part(p)
            }
            var arm64Kept: [Arm64Part] = []
            for p in arm64Parts {
                arm64Kept += splitArm64Part(p)
            }
            let _ = machine.saveImage(
                CheckImage(
                    imageKey,
                    checkedProgram,
                    Some(Built(builtKey, prog, mc, low.data, low.inlines, Some(l.kept()), x64Kept, arm64Kept)),
                ),
                imageAt,
            )
        }
        return Some(
            Compiled(
                prog,
                mc,
                low.data,
                low.inlines,
                testsOf(checkedProgram),
                if avx { 1 } else { 0 },
                os,
                purpose.linked,
            ),
        )
    }
    if keepImage {
        let _ = machine.saveImage(CheckImage(imageKey, checkedProgram), imageAt)
    }
    var low = Lowered(IrProgram(), [], []) // lowered, optimized and made code in place: the program is never copied
    low.lowerFrom(checkedProgram, lowering)
    if runtime and len(purpose.used) > 0 {
        // only what the program reaches: from the executable's entry (Windows', Linux's, macOS's), its table's
        // functions through fillRuntime
        var roots: [Int] = []
        for (i, f) in low.program.fns.enumerate() {
            if f.exportName is Some(sym) and sym is "qkWinEntry" | "main" | "qkMacMain" {
                roots.push(i)
            }
        }
        low.program.keepReachable(roots)
    }
    low.program.target = made
    let t2 = monotonicTime()
    // --release: each function's optimized code kept by content, in a pack for this program (QUARK_CACHE=off: none),
    // when the program is big enough for that to take less than optimizing it does (reading the compiler to know
    // it, the pack...: some milliseconds)
    var hits = ""
    // (QUARK_CACHE=on: whatever its size)
    let keep = release
        and (env("QUARK_CACHE") == Some("on") or env("QUARK_CACHE") != Some("off") and low.program.size() >= 5000)
    let id = if keep { compilerId(host) } else { 0 }
    if id != 0 {
        var where = Hash128()
        where.add("{src.path}|{target}|{purpose.object}|{debug}|{lanes}|{o.fuel > 0}".bytes())
        let pack = "quark-cache-{where.text()}.bin"
        let (hit, all) = low.program.optimizeCached(release, low.data, cachePath(pack), hex64(id))
        cacheUsed(pack, len(readBytes(cachePath(pack)) ?? []))
        hits = " ({hit} of {all} functions kept from an earlier build)"
    } else {
        low.program.optimize(release)
    }
    let t3 = monotonicTime()
    let mc = if wasm {
        MachineCode() // the module is made from the IR (compiler/wasm.qk)
    } else {
        match low.program.target.arch {
            X64 => genX64(low.program)
            Arm64 => genArm64(low.program)
        }
    }
    if o.timed and not runtime {
        let t4 = monotonicTime()
        printErr(
            "quark: parsed and checked in {fixed((t1 - t0) * 1000, 2)} ms, compiled in {fixed((t4 - t1) * 1000, 2)} ms ({len(mc.code)} bytes of machine code): lowered in {fixed((t2 - t1) * 1000, 2)}, optimized in {fixed((t3 - t2) * 1000, 2)}{hits}, made machine code in {fixed((t4 - t3) * 1000, 2)}",
        )
    }
    let prog = low.program // taken
    low.program = IrProgram()
    Compiled(prog, mc, low.data, low.inlines, testsOf(checkedProgram), if avx { 1 } else { 0 }, os, purpose.linked)
}

// ---- a build after an edit (docs/PLANO.md B13, step 2) ----
// What afterEdit did: built the program, said its errors, or found it is not a build it can do (the whole one then).
enum EditBuild { Done(c: Compiled), Failed, NotHere }

// The program, when only bodies of its functions changed since image's build (no declaration came or went, no
// header, type or constant changed): from image, each changed file's functions checked again (their bodies are new,
// and their lines moved), and lowered again with those that put one of them in line or read a fact of one that
// changed; every other function's machine code as image's build made it.
fn afterEdit(
    host: Host,
    image: CheckImage,
    src: Source,
    preludeSrc: Source?,
    o: RunOptions,
    purpose: Purpose,
    quiet: Bool,
    t0: Float,
) -> EditBuild {
    let Some(b) = image.built else {
        return .NotHere
    }
    let Some(kept) = b.lower else {
        return .NotHere
    }
    var p = image.program
    // each changed file: read as it was and as it is, declaration by declaration
    var again: [Int] = [] // the functions whose bodies are new
    var wasEffect: [Bool] = []
    var moved: [Int: Int] = [:] // the functions whose text is the same but its place moved: by how many lines
    for (k, m) in image.program.modules.enumerate() {
        let now = if k == 0 {
            Some(src.text)
        } else if m.path == preludePath {
            Some(preludeText())
        } else if preludeSrc is Some(given) and m.path == given.path {
            Some(given.text)
        } else {
            readModule(m.path, m.path.startsWith("std/"), None)
        }
        let Some(text) = now else {
            return .NotHere
        }
        if text == m.src.text {
            continue
        }
        let old = parse(Source(m.path, m.src.text))
        let new = parse(Source(m.path, text))
        if not new.ok or not old.ok or len(old.ast.decls) != len(new.ast.decls) {
            return .NotHere
        }
        // the program's declarations of this file, in their order (not the ones checking made)
        var mine: [Int] = []
        for d in p.decls {
            let x = p.ast.decls[d]
            if x.module == k and not x.lifted and x.templateOf < 0 and not x.fromDefault {
                mine.push(d)
            }
        }
        if len(mine) != len(new.ast.decls) {
            return .NotHere
        }
        // (each declaration's header: its text with an empty body)
        var oldHeads = old.ast
        var newHeads = new.ast
        let oldEmpty = oldHeads.expr(.BlockExpr(oldHeads.block(Block()), false), 0, 0)
        let newEmpty = newHeads.expr(.BlockExpr(newHeads.block(Block()), false), 0, 0)
        for j in 0..len(new.ast.decls) {
            if oldHeads.decls[j].body >= 0 {
                oldHeads.decls[j].body = oldEmpty
            }
            if newHeads.decls[j].body >= 0 {
                newHeads.decls[j].body = newEmpty
            }
        }
        let at = len(p.ast.decls)
        p.ast.append(new.ast)
        let oldLines = m.src.text.split("\n")
        let newLines = text.split("\n")
        for j in 0..len(new.ast.decls) {
            let x = new.ast.decls[j]
            let d = mine[j]
            if x.name != p.ast.decls[d].name or x.kind != old.ast.decls[j].kind {
                return .NotHere
            }
            // the same text (each declaration's lines, to the next one's): the same declaration, moved if anything
            if spanOf(oldLines, old.ast, j) == spanOf(newLines, new.ast, j) {
                if x.kind == DeclKind.Fn and x.body >= 0 and x.line != old.ast.decls[j].line {
                    moved[d] = x.line - old.ast.decls[j].line
                }
                continue
            }
            if declText(oldHeads, j) != declText(newHeads, j) {
                return .NotHere // a header, a type, a constant, a use
            }
            if x.kind != DeclKind.Fn or x.body < 0 {
                continue
            }
            let y = p.ast.decls[d]
            if y.isTemplate or y.isExtern {
                return .NotHere // a generic function's instances, or C's: made again by the whole build
            }
            // its body: the new one (its lines moved, if nothing else)
            wasEffect.push(y.isEffect)
            p.ast.decls[d].body = p.ast.decls[at + j].body
            p.ast.decls[d].line = x.line
            p.ast.decls[d].col = x.col
            p.ast.decls[d].isEffect = x.isEffect
            again.push(d)
        }
    }
    if len(again) == 0 and len(moved) == 0 {
        return .NotHere
    }
    // a moved function's lines in the tree (its instances' too, and its lambdas'), and by how much each one's
    // machine code is moved
    var delta: [Int: Int] = [:]
    let walks = movedItems(p, moved)
    for (e, by, items) in walks {
        delta[e] = by
        p.ast.decls[e].line += by
        for it in items {
            if it >= 0 {
                p.ast.exprs[it].line += by
            } else {
                p.ast.stmts[-1 - it].line += by
            }
        }
    }
    for (f, by) in movedLambdas(p, walks) {
        delta[f] = by
        p.ast.decls[f].line += by
    }
    let oldCount = len(p.decls)
    let oldInlines = len(b.inlines)
    let checked = recheckBodies(p, again, o.allowed)
    if not quiet {
        for e in checked.errors.shown {
            printErr(e)
        }
    }
    if not checked.ok {
        return .Failed
    }
    let q = checked.program
    for (i, d) in again.enumerate() {
        if q.ast.decls[d].isEffect != wasEffect[i] {
            return .NotHere // its callers' effects: the whole check
        }
    }
    let t1 = monotonicTime()
    // lowered again: the new bodies, the new declarations, and those that depend on one of them
    let lowering = LowerOptions(
        fuel: o.fuel > 0,
        runtime: false,
        linked: purpose.linked,
        arch: b.prog.target.arch,
        sysv: b.prog.target.sysv,
        debug: purpose.debug,
        debugKeys: if purpose.debug { lineKeys(q) } else { [:] },
        coverage: o.coverage,
        runtimeUsed: purpose.used,
    )
    var l = lowerResume(kept, q, lowering, b.prog, b.data, b.inlines)
    var todo: Set<Int> = []
    for d in again {
        todo.add(d)
    }
    for i in oldCount..len(q.decls) {
        todo.add(q.decls[i])
    }
    // the number of each function, to its declaration
    var declAt: [Int: Int] = [:]
    for (i, d) in q.decls.enumerate() {
        if i < len(l.fnIndex) and l.fnIndex[i] >= 0 and l.numbered(d) {
            declAt[l.fnIndex[i]] = d
        }
    }
    for d in again {
        for slot in kept.inliners[d] ?? [] {
            if declAt[slot] is Some(e) {
                todo.add(e)
            }
        }
        // a fact its callers read, changed: they are lowered again
        let changesNow = l.own.changes.get(d) ?? []
        let wasChanges = if d < len(kept.keptChanges) { kept.keptChanges[d] } else { [] }
        let wasOwned = d < len(kept.keptResults) and kept.keptResults[d]
        if changesNow != wasChanges or l.own.ownedResults[d] != wasOwned {
            let slot = l.fnIndex[q.ast.decls[d].index]
            for (s, f) in l.fns.enumerate() {
                if f.code.any(ins => ins.op == Op.Call and ins.a < 0 and ins.imm == slot) and declAt[s] is Some(e) {
                    todo.add(e)
                }
            }
        }
    }
    // a function kept as a value now, or no longer: called otherwise
    for i in 0..min(len(kept.asValue), len(q.decls)) {
        if kept.asValue[i] != l.asValue[i] {
            todo.add(q.decls[i])
        }
    }
    var decls: [Int] = []
    for d in q.decls {
        if todo.contains(d) and l.numbered(d) {
            decls.push(d)
        }
    }
    let lowered = l.lowerAgain(decls)
    let quick = b.prog.target
    // what moved: each kept function's line, its inlined calls' lines, and its machine code's lines
    var slotOf: [Int: Int] = [:]
    for (s, d) in declAt {
        slotOf[d] = s
    }
    for (d, by) in delta {
        if slotOf[d] is Some(s) and s < len(l.fns) {
            l.fns[s].line += by
        }
    }
    let inl = l.inlines
    for i in 0..min(oldInlines, len(inl)) {
        let r = inl[i]
        let frame = if r.parent == 0 { r.owner } else { inl[r.parent].decl }
        if delta[frame] is Some(by) {
            l.inlines[i].line = r.line + by
        }
    }
    var rebase: Set<Int> = [] // the kept functions some of whose lines moved
    for (d, _) in delta {
        if slotOf[d] is Some(s) {
            rebase.add(s)
        }
        for s in kept.inliners[d] ?? [] {
            rebase.add(s)
        }
    }
    let lineDelta = (slot: Int, frame: Int) => if frame == 0 {
        delta[declAt[slot] ?? -1] ?? 0
    } else if frame < len(inl) {
        delta[inl[frame].decl] ?? 0
    } else {
        0
    }
    let mc = match quick.arch {
        X64 => {
            var made: [Int: X64Part] = [:]
            for part in genX64Parts(quick, l.out.runtime, l.out.externs, l.out.cSigs, lowered, true) {
                for f in splitX64Part(part) {
                    made[f.numbers[0]] = f
                }
            }
            var all: [X64Part] = []
            for f in b.x64 {
                let s = f.numbers[0]
                if not made.contains(s) {
                    all.push(if rebase.contains(s) {
                        f.rebased(frame => lineDelta(s, frame))
                    } else {
                        f
                    })
                }
            }
            for (_, f) in made {
                all.push(f)
            }
            genX64Join(quick, l.out.runtime, l.out.externs, l.out.cSigs, len(l.fns), all.sortedBy(f => f.numbers[0]))
        }
        Arm64 => {
            var made: [Int: Arm64Part] = [:]
            for part in genArm64Parts(quick, l.out.runtime, l.out.externs, l.out.cSigs, lowered, true) {
                for f in splitArm64Part(part) {
                    made[f.numbers[0]] = f
                }
            }
            var all: [Arm64Part] = []
            for f in b.arm64 {
                let s = f.numbers[0]
                if not made.contains(s) {
                    all.push(if rebase.contains(s) {
                        f.rebased(frame => lineDelta(s, frame))
                    } else {
                        f
                    })
                }
            }
            for (_, f) in made {
                all.push(f)
            }
            genArm64Join(quick, l.out.runtime, l.out.externs, l.out.cSigs, len(l.fns), all.sortedBy(f => f.numbers[0]))
        }
    }
    var low = l.lowered()
    low.program.target = quick
    if o.timed {
        let t4 = monotonicTime()
        printErr(
            "quark: parsed and checked in {fixed((t1 - t0) * 1000, 2)} ms, compiled in {fixed((t4 - t1) * 1000, 2)} ms ({len(mc.code)} bytes of machine code): after an edit, {len(again)} bodies checked again, {len(lowered)} functions lowered again and {len(rebase)} moved",
        )
    }
    let prog = low.program // taken
    low.program = IrProgram()
    let os = targetOs(host, purpose.target)
    let avx = purpose.target == "" and not host.arm and not o.noAvx and machine.cpu() & 1 != 0
    .Done(Compiled(prog, mc, low.data, low.inlines, testsOf(q), if avx { 1 } else { 0 }, os, purpose.linked))
}

// the lines of a file's j-th declaration, up to the next one's (comments above the next one among them)
fn spanOf(lines: [Text], a: Ast, j: Int) -> [Text] {
    let from = max(a.decls[j].line - 1, 0)
    let to = if j + 1 < len(a.decls) {
        a.decls[j + 1].line - 1
    } else {
        len(lines)
    }
    if to <= from { [] } else { lines[from..min(to, len(lines))] }
}

// each moved function's declarations (itself, the copy its instances are made from, its instances) with by how much
// they moved and the nodes of their bodies (expressions, and statements as -1 - s)
fn movedItems(p: Program, moved: [Int: Int]) -> [(Int, Int, [Int])] {
    let walk = Ownership(p)
    var out: [(Int, Int, [Int])] = []
    for (d, by) in moved {
        var these = [d]
        if p.ast.decls[d].pristine >= 0 {
            these.push(p.ast.decls[d].pristine)
        }
        for e in p.decls {
            if p.ast.decls[e].templateOf == d {
                these.push(e)
            }
        }
        for e in these {
            out.push((e, by, walk.visitExpr(p.ast.decls[e].body, [])))
        }
    }
    out
}

// the lambdas lifted out of the moved functions (their bodies are among the walked nodes): by how much each moved
fn movedLambdas(p: Program, walks: [(Int, Int, [Int])]) -> [(Int, Int)] {
    var by: [Int: Int] = [:]
    for (_, n, items) in walks {
        for it in items {
            if it >= 0 {
                by[it] = n
            }
        }
    }
    var out: [(Int, Int)] = []
    for f in p.decls {
        if p.ast.decls[f].lifted and by[p.ast.decls[f].body] is Some(n) {
            out.push((f, n))
        }
    }
    out
}

// a checked program as a build left it, for the next one (its key: the compiler, the file, what checking it took),
// and what that build made of it (its key: what it was built for)
type CheckImage { key: Text, program: Program, built: Built? = None }

type Built {
    key: Text
    prog: IrProgram
    mc: MachineCode
    data: Bytes
    inlines: [InlineCall]
    lower: Lower? = None // its state when it was done (its program's, data and functions given out)
    x64: [X64Part] = [] // each function's code, on its own (x64's or ARM64's)
    arm64: [Arm64Part] = []
}

// is every file p was read from as it was (the file given, the prelude, the standard library's, the others')
fn sameSources(p: Program, src: Source, preludeSrc: Source?) -> Bool {
    for (k, m) in p.modules.enumerate() {
        let now = if k == 0 {
            Some(src.text)
        } else if m.path == preludePath {
            Some(preludeText())
        } else if preludeSrc is Some(given) and m.path == given.path {
            Some(given.text)
        } else {
            readModule(m.path, m.path.startsWith("std/"), None)
        }
        if now != Some(m.src.text) {
            return false
        }
    }
    true
}

// the program read, checked, and its constants worked out; its errors said (unless quiet); None when it has any
fn checkedHere(host: Host, src: Source, preludeSrc: Source?, o: RunOptions, purpose: Purpose, quiet: Bool) -> Program? {
    // read and checked as a task: what those two work with (most of the memory they make, little of it kept) goes
    // when the task ends, and only the checked program is copied out
    var checked: Program? = None
    let out: Channel<Program?> = channel()
    let _ = go(() => send(out, readAndCheck(src, preludeSrc, purpose, o.allowed, quiet)))
    if receive(out) is Some(got) {
        checked = got
    }
    closeChannel(out)
    let Some(program) = checked else {
        return None
    }
    var checkedProgram = program
    if not purpose.runtime {
        let problems = checkedProgram.runConsts(host)
        if len(problems) > 0 {
            var errors = Errors()
            for problem in problems {
                errors.add(checkedProgram.modules[problem.module].src, problem.line, problem.col, problem.message)
            }
            if not quiet {
                for e in errors.shown {
                    printErr(e)
                }
            }
            return None
        }
    }
    Some(checkedProgram)
}

// the program read and checked, its errors said (unless quiet); None when it has any
fn readAndCheck(src: Source, preludeSrc: Source?, purpose: Purpose, allowed: Text?, quiet: Bool) -> Program? {
    let loaded = loadProgram(src, preludeSrc)
    if not loaded.ok {
        if not quiet {
            for e in loaded.errors.shown {
                printErr(e)
            }
        }
        return None
    }
    let checked = checkProgram(
        loaded.program,
        loaded.errors,
        purpose.needMain,
        if purpose.runtime { None } else { allowed },
    )
    if not quiet {
        for e in checked.errors.shown {
            printErr(e)
        }
    }
    if not checked.ok {
        return None
    }
    Some(checked.program)
}

// the program's tests: each one's function and name
fn testsOf(p: Program) -> [(Text, Text)] {
    var tests: [(Text, Text)] = []
    for d in p.decls {
        let x = p.ast.decls[d]
        if x.kind == DeclKind.Fn and x.isTest {
            tests.push((x.name, x.testName))
        }
    }
    tests
}

// the program's functions, lowered in batches of about this many instructions (each batch's threads load the program
// again: a few batches)
const streamBatch = 2000000

// lowered in batches, each one's machine code made on the threads (compileText)
fn Lower.streamX64(var self, target: Target) -> [X64Part] {
    let shift = rebaseTest()
    var parts = genX64Parts(target, self.out.runtime, self.out.externs, self.out.cSigs, [], true)
    var batch: [(Int, IrFn)] = []
    var made = 0
    // (one loop for the whole program: its collections' pace is set once)
    while not self.allLowered() {
        if self.lowerNext() is Some(f) {
            made += len(f.1.code)
            batch.push(if shift != 0 { (f.0, f.1.linesMoved(shift)) } else { f })
        }
        if made >= streamBatch or self.allLowered() {
            parts += genX64Proved(
                genX64Parts(target, self.out.runtime, self.out.externs, self.out.cSigs, batch, true),
                shift,
            )
            batch = []
            made = 0
        }
    }
    let rest = self.lowerRest()
    let rest2 = if shift != 0 {
        rest.map(f => (f.0, f.1.linesMoved(shift))).toArray()
    } else {
        rest
    }
    parts += genX64Proved(genX64Parts(target, self.out.runtime, self.out.externs, self.out.cSigs, rest2, true), shift)
    parts
}

fn Lower.streamArm64(var self, target: Target) -> [Arm64Part] {
    let shift = rebaseTest()
    var parts = genArm64Parts(target, self.out.runtime, self.out.externs, self.out.cSigs, [], true)
    var batch: [(Int, IrFn)] = []
    var made = 0
    // (one loop for the whole program: its collections' pace is set once)
    while not self.allLowered() {
        if self.lowerNext() is Some(f) {
            made += len(f.1.code)
            batch.push(if shift != 0 { (f.0, f.1.linesMoved(shift)) } else { f })
        }
        if made >= streamBatch or self.allLowered() {
            parts += genArm64Proved(
                genArm64Parts(target, self.out.runtime, self.out.externs, self.out.cSigs, batch, true),
                shift,
            )
            batch = []
            made = 0
        }
    }
    let rest = self.lowerRest()
    let rest2 = if shift != 0 {
        rest.map(f => (f.0, f.1.linesMoved(shift))).toArray()
    } else {
        rest
    }
    parts += genArm64Proved(
        genArm64Parts(target, self.out.runtime, self.out.externs, self.out.cSigs, rest2, true),
        shift,
    )
    parts
}

// quark build --target wasm32-wasi: the program and the runtime (runtime/wasi.qk) as one WebAssembly module
fn buildWasm(host: Host, c: Compiled, o: RunOptions) -> Int {
    let Some(text) = runtimeText("wasi") else {
        printErr("quark: this compiler keeps no runtime for WebAssembly")
        return 1
    }
    let Some(rt) = compileText(
        host,
        Source(embeddedRuntime + "wasi.qk", text),
        RunOptions(),
        Purpose(target: "wasm32-wasi", linked: true, runtime: true),
        false,
    ) else {
        return 1
    }
    let (module, missing) = wasmModule(rt.prog, rt.data, c.prog, c.data, o.fuel, o.memory)
    if env("QUARK_WASM_MISSING") == Some("on") {
        for name in missing {
            printErr("quark: wasm32: {name} is not here (a trap where it is called)")
        }
    }
    let out = o.outPath ?? fileNameOf(o.path).replace(".qk", "") + ".wasm"
    if writeBytes(out, module) is Err(_) {
        printErr("quark: cannot write {out}")
        return 1
    }
    printErr("quark: wrote {out} ({len(module)} bytes)")
    0
}

// -g: the program's debug information (its inlined calls shown at their outermost call), its files' paths whole
pub fn debugInfoOf(host: Host, c: Compiled) -> DebugInfo {
    var d = debugOf(
        c.mc,
        c.prog,
        outerLinesOf(c.inlines.map(k => k.parent).toArray(), c.inlines.map(k => k.line).toArray()),
    )
    let here = currentDir(host)
    let windows = host.os == .Windows
    d.files = d.files.map(f => {
        let whole = f.startsWith("/") or f.startsWith("<") or len(f) > 1 and f[1..2] == ":" or here == ""
        let path = if whole { f } else { here + "/" + f }
        if windows and not f.startsWith("<") {
            path.replace("/", "\\")
        } else {
            path
        }
    }).toArray()
    d
}

// the process's working folder ("" when the system does not say)
pub fn currentDir(host: Host) -> Text {
    let f = host.cFunction(if host.os == .Windows { "_getcwd" } else { "getcwd" })
    if f == 0 {
        return ""
    }
    let room = malloc(4096) // (once a compile)
    let p = machine.call(Pointer<UInt8>(f), room, 4096, 0, 0)
    if p == 0 { "" } else { textAtC(room) }
}

// ---- constants worked out by running them (compiler/construn.qk) ----
// The program compiled for this machine with a function for each constant (what the constants reach of it: the rest
// a hole), each run with a budget of steps and of memory, its dump read back into the literal nodes lowering puts
// where the constant is used. What could not be worked out: the problems (a constant that names a host's function, or
// holds a function; a panic; too many steps). QUARK_CONSTS=off: none worked out (each worked out where it is used).
const constFuel = 200000000
const constMemory = 1073741824
const constTail = "compute it when the program runs (a let in main)"

pub fn Program.runConsts(var self, host: Host) -> [ConstProblem] {
    if env("QUARK_CONSTS") == Some("off") {
        return []
    }
    var problems: [ConstProblem] = []
    var which: [Int] = []
    for d in self.decls {
        let x = self.ast.decls[d]
        if x.kind != DeclKind.Const or x.builtin or x.body < 0 or x.retType < 0 {
            continue
        }
        if self.holdsFunction(x.retType, 0) {
            problems.push(
                ConstProblem(
                    x.module,
                    x.line,
                    x.col,
                    "constant {x.name} holds a function: a constant is a value kept in the program's data; make it a fn",
                ),
            )
        } else if self.dumpable(x.retType, 0) {
            which.push(d)
        }
    }
    if len(which) == 0 {
        return problems
    }
    // a constant that reaches a host's (or C's) function cannot be worked out here
    var reached = self.reachedFrom(which)
    var outside = false
    for d in self.decls {
        let x = self.ast.decls[d]
        if reached[d] and x.kind == DeclKind.Fn and x.isExtern and x.body < 0 {
            outside = true
        }
    }
    if outside {
        var kept: [Int] = []
        for c in which {
            let alone = self.reachedFrom([c])
            var foreign = -1
            for d in self.decls {
                let x = self.ast.decls[d]
                if foreign < 0 and alone[d] and x.kind == DeclKind.Fn and x.isExtern and x.body < 0 {
                    foreign = d
                }
            }
            let x = self.ast.decls[c]
            if foreign >= 0 {
                problems.push(
                    ConstProblem(
                        x.module,
                        x.line,
                        x.col,
                        "constant {x.name} is worked out when the program is compiled, and the host's function is not ({self.ast.decls[foreign].name}): {constTail}",
                    ),
                )
            } else {
                kept.push(c)
            }
        }
        which = kept
        if len(which) == 0 {
            return problems
        }
        reached = self.reachedFrom(which)
    }
    // worked out before, from the same code: each one's dump read back, nothing compiled or run
    let key = self.constsKey(which, reached, host)
    let cacheName = "quark-consts-{key}.bin"
    if readBytes(cachePath(cacheName)) is Ok(saved) {
        let kept = constDumps(saved)
        if which.all(d => kept.contains(self.constId(d))) {
            var r = ConstReader(self)
            for d in which {
                let x = r.p.ast.decls[d]
                r.begin(kept[self.constId(d)] ?? [], x.line, x.col)
                let node = r.value(x.retType)
                if r.ok and r.at == len(r.b) {
                    r.p.ast.decls[d].folded = node
                    r.p.ast.decls[d].foldedAgain = false
                }
            }
            self = r.p
            cacheUsed(cacheName, len(saved))
            return problems
        }
    }
    // the program with every constant as written, what they do not reach a hole, and a function that dumps each
    var p2 = self
    for d in p2.decls {
        let x = p2.ast.decls[d]
        if x.kind == DeclKind.Const {
            p2.ast.decls[d].folded = -1
            p2.ast.decls[d].foldedAgain = false
            p2.ast.decls[d].dataAt = -1
        }
        if not reached[d] and x.kind == DeclKind.Fn and x.body >= 0 and not x.isExtern and not x.isTemplate {
            p2.ast.exprs.push(Expr(.Hole, x.line, x.col, ty: if x.retType >= 0 { x.retType } else { tyVoid }))
            p2.ast.decls[d].body = len(p2.ast.exprs) - 1
            p2.ast.decls[d].inlineOnly = false
        }
    }
    for d in which {
        let x = p2.ast.decls[d]
        p2.ast.exprs.push(Expr(.Name(x.name), x.line, x.col, ty: x.retType, decl: d))
        let value = len(p2.ast.exprs) - 1
        p2.ast.exprs.push(
            Expr(.Call("#dump", "", [value], [""], false, false), x.line, x.col, ty: tyVoid, builtin: bDump),
        )
        let body = len(p2.ast.exprs) - 1
        let at = p2.ast.decl(
            Decl(
                kind: .Fn,
                name: "#const{d}",
                line: x.line,
                col: x.col,
                body: body,
                isEffect: true,
                module: x.module,
                retType: tyVoid,
                state: 2,
            ),
        )
        p2.ast.decls[at].index = len(p2.decls)
        p2.decls.push(at)
    }
    let arch = if host.arm { Arch.Arm64 } else { Arch.X64 }
    let sysv = host.os != .Windows
    var low = Lowered(IrProgram(), [], [])
    low.lowerFrom(p2, LowerOptions(fuel: true, arch: arch, sysv: sysv))
    low.program.target = Target(
        arch: arch,
        sysv: sysv,
        objectMode: false,
        avx: false,
        lanes: 2,
        sse42: false,
        apple: host.os == .Macos,
        checks: false,
    )
    low.program.optimize(false)
    let mc = match arch {
        X64 => genX64(low.program)
        Arm64 => genArm64(low.program)
    }
    let prog = low.program
    low.program = IrProgram()
    let c = Compiled(prog, mc, low.data, low.inlines, [], 0, host.os, false)
    let Some(m) = loadRuntime(host) else {
        return problems
    }
    m.begin(if len(self.modules) > 0 { self.modules[0].path } else { "program" }, [])
    let code = loadedCode(host, c)
    let l = m.load(c, code, 0, constFuel, constMemory, quiet: true) // (a C function not here: worked out where used)
    if l == 0 {
        return problems
    }
    let sink = m.call("qkHostKeepOutput", 0, 0, 0, 0)
    var r = ConstReader(self)
    var dumps: Bytes = [] // what goes into the cache: each one's name and dump
    var all = true
    for d in which {
        var f = -1
        for (k, fx) in c.prog.fns.enumerate() {
            if f < 0 and fx.name == "#const{d}" {
                f = k
            }
        }
        if f < 0 {
            all = false
            continue
        }
        let ok = m.call("qkHostCall", l, code.fnAt[f], constFuel, 0) != 0
        m.flush()
        let n = peekWord(sink, 1)
        let none: Bytes = []
        let bytes = if n > 0 { Bytes(Pointer<UInt8>(peekWord(sink, 0)), n) } else { none }
        pokeWord(sink, 1, 0)
        let x = r.p.ast.decls[d]
        if not ok {
            let why = m.panicText()
            let message = if why.contains("ran too long") {
                "constant {x.name} takes too long to work out when the program is compiled (more than {constFuel / 1000000} million steps): {constTail}"
            } else if why.contains("too many calls deep") {
                "constant {x.name} calls functions nested too deep to work out when the program is compiled: {constTail}"
            } else {
                "constant {x.name} cannot be worked out when the program is compiled: {why}"
            }
            problems.push(ConstProblem(x.module, x.line, x.col, message))
            all = false
            continue
        }
        dumps += self.constId(d).bytes()
        dumps.push(0)
        for k in 0..8 {
            dumps.push(len(bytes) >> (8 * k) & 255)
        }
        dumps += bytes
        r.begin(bytes, x.line, x.col)
        let node = r.value(x.retType)
        if not r.ok or r.at != len(r.b) {
            continue // not folded: worked out where it is used
        }
        r.p.ast.decls[d].folded = node
        r.p.ast.decls[d].foldedAgain = false
    }
    if all and writeBytes(cachePath(cacheName), dumps) is Ok(_) {
        cacheUsed(cacheName, len(dumps))
    }
    self = r.p
    problems
}

// a constant by what names it from one build to the next: its file and its name (not its number, which other
// declarations move)
fn Program.constId(self, d: Int) -> Text {
    let x = self.ast.decls[d]
    let file = if x.module >= 0 and x.module < len(self.modules) {
        self.modules[x.module].path
    } else {
        ""
    }
    "{file}:{x.name}"
}

// The constants' cache key: what their values depend on. The text of every declaration they reach (as the
// formatter writes it), every type of the program (a case's number, a field's place, is in a dump), the constants'
// names, the compiler and the machine: two FNV-1a sums of it, as hex.
fn Program.constsKey(self, which: [Int], reached: [Bool], host: Host) -> Text {
    var a = -3750763034362895579 ^ compilerId(host)
    var b = 1469598103934665603 ^ (if host.arm { 1 } else { 2 }) ^ (match host.os {
        Windows => 4
        Linux => 8
        Macos => 16
    })
    var texts: [Text] = []
    for d in which {
        texts.push(self.constId(d))
    }
    for d in self.decls {
        let x = self.ast.decls[d]
        if x.templateOf >= 0 or x.lifted or x.fromDefault {
            continue
        }
        if reached[d] or x.kind is Type | Enum {
            texts.push("{self.constId(d)}\n{declText(self.ast, d)}")
        }
    }
    for t in texts {
        for c in t.bytes() {
            a = (a ^ c) *% 1099511628211
            b = (b ^ c) *% 1099511628211 +% 7
        }
        a = (a ^ 255) *% 1099511628211
    }
    "{hex64(a)}{hex64(b)}"
}

// a cache file's dumps, by constant
fn constDumps(saved: Bytes) -> [Text: Bytes] {
    var out: [Text: Bytes] = [:]
    var at = 0
    while at < len(saved) {
        var end = at
        while end < len(saved) and saved[end] != 0 {
            end += 1
        }
        if end + 9 > len(saved) {
            return [:]
        }
        let id = Text(saved[at..end]) ?? return [:]
        var n = 0
        for k in 0..8 {
            n |= saved[end + 1 + k] << (8 * k)
        }
        let from = end + 9
        if n < 0 or from + n > len(saved) {
            return [:]
        }
        out[id] = saved[from..from + n]
        at = from + n
    }
    out
}

pub fn compileFile(host: Host, path: Text, o: RunOptions, purpose: Purpose) -> Compiled? {
    let Ok(text) = readFile(path) else {
        printErr("quark: cannot read {path}")
        return None
    }
    compileText(host, Source(path, text), o, purpose, false)
}

// the runtime for this machine (or target's), from the texts the compiler keeps: compiled for objects, linked
pub fn compileRuntime(host: Host, target: Text) -> Compiled? = compileRuntimeFor(host, target, [])

// the runtime, only what a program reaches of it (used: its table's functions the program calls; [] all)
pub fn compileRuntimeFor(host: Host, target: Text, used: [Bool]) -> Compiled? {
    let os = targetOs(host, target)
    let name = match os {
        Windows => "windows"
        Linux => "linux"
        Macos => "macos"
    }
    let Some(text) = runtimeText(name) else {
        printErr("quark: this compiler keeps no runtime for {name}")
        return None
    }
    compileText(
        host,
        Source(embeddedRuntime + name + ".qk", text),
        RunOptions(),
        Purpose(target: target, object: true, linked: true, runtime: true, used: used),
        false,
    )
}

// x with digits after the point, as C's %.Nf writes it
pub fn fixed(x: Float, digits: Int) -> Text {
    var scale = 1
    for _ in 0..digits {
        scale *= 10
    }
    let negative = x < 0.0
    let n = toInt(round(abs(x) * toFloat(scale)))
    let whole = n / scale
    var part = "{n % scale}"
    while len(part) < digits {
        part = "0" + part
    }
    (if negative and n != 0 { "-" } else { "" }) + "{whole}" + (if digits > 0 { "." + part } else { "" })
}

// ---- the program as a built executable carries it: the payload, then the trailer ----
pub fn programBytes(
    c: Compiled,
    mc: MachineCode,
    entry: Int,
    fuel: Int,
    memory: Int,
    jit: JitObject = JitObject([], []),
) -> Bytes {
    var b = Buf()
    b.add(mc.code)
    b.add(c.data)
    for r in mc.relocs {
        b.u32(r.at)
        b.u32(r.kind)
        b.u64(r.target)
    }
    let externsAt = b.len()
    for x in c.prog.externs {
        b.cText(x.name)
        b.cText(x.lib ?? "")
    }
    let externBytes = b.len() - externsAt
    // -g: the object a debugger reads of the code once loaded (compiler/dwarf.qk), and its addresses to make whole
    b.add(jit.bytes)
    for at in jit.patches {
        b.u64(at)
    }
    let size = b.len()
    b.add("QUARKPRG".bytes())
    b.u64(len(mc.code))
    b.u64(len(c.data))
    b.u64(len(mc.relocs))
    b.u64(entry)
    b.u64(mc.enter)
    b.u64(mc.escape)
    b.u64(fuel)
    b.u64(memory)
    b.u64(c.features)
    b.u64(len(c.prog.externs))
    b.u64(externBytes)
    b.u64(size)
    b.u64(len(jit.bytes))
    b.u64(len(jit.patches))
    b.b
}

// --abi sysv on Windows (testing the System V calls): the runtime is called the Quark way, the same in both, so only
// the way in changes: the trampoline takes its argument in rdi (mov rdi, rcx; jmp enter)
fn sysvAdapted(mc: MachineCode) -> MachineCode {
    var code = mc.code
    while len(code) % 16 != 0 {
        code.push(0xCC)
    }
    let enter = len(code)
    let rel = mc.enter - (enter + 8)
    code += [0x48, 0x89, 0xCF, 0xE9, rel & 255, rel >> 8 & 255, rel >> 16 & 255, rel >> 24 & 255]
    MachineCode(code, mc.relocs, mc.sites, mc.fnAt, enter, mc.escape)
}

// ---- C's memory ----
pub fn poke(at: Int, b: Bytes) {
    let p = Pointer<UInt8>(at)
    for (i, x) in b.enumerate() {
        p[i] = x
    }
}

pub fn peekWord(at: Int, i: Int) -> Int = Pointer<Int64>(at)[i]

pub fn pokeWord(at: Int, i: Int, v: Int) {
    Pointer<Int64>(at)[i] = v
}

// a zero-ended copy of t in C's memory
pub fn cText(t: Text) -> Int {
    let b = t.bytes()
    let p = malloc(len(b) + 1)
    poke(p, b)
    Pointer<UInt8>(p)[len(b)] = 0
    p
}

extern fn strlen(p: Int64) -> UInt64

// the zero-ended text at p
pub fn textAtC(p: Int) -> Text = if p == 0 { "" } else { Text(Pointer<UInt8>(p), strlen(p)) }

fn wordsInC(xs: [Int]) -> Int {
    let p = malloc(8 * len(xs) + 8)
    for (i, x) in xs.enumerate() {
        pokeWord(p, i, x)
    }
    p
}

// ---- the runtime, in this process ----
// names and starts: the runtime's functions (offsets in its text), so a profile says where in it the time goes
pub type Mapped {
    base: Int = 0
    symbols: [Text: Int] = [:]
    names: [Text] = []
    starts: [Int] = []
    textSize: Int = 0
}

// The runtime linked at address 0 (every pointer in its data then moved by where it is mapped): what a run maps, and
// what is kept between runs (the runtime is the same until its text is)
pub type RuntimeImage {
    linked: Linked = Linked()
    textSize: Int = 0
    dataAt: Int = 0
    size: Int = 0
    names: [Text] = []
    starts: [Int] = []
}

fn linkRuntime(host: Host, rt: Compiled) -> RuntimeImage {
    let arm = rt.prog.target.arch == .Arm64
    let info = ImageInfo(rt.os, true, rt.features, rt.data, runtimeNames)
    let o = layout(rt.mc, rt.prog, info)
    let stubs = stubsFor(host.os, arm)
    let imports = linkImports(rt.mc, o, stubs, host.os)
    var cellAt: [Int] = []
    for i in 0..len(imports) {
        cellAt.push(8 * i)
    }
    let textSize = linkedTextSize(rt.mc, o, stubs)
    let dataAt = alignUp(textSize, 65536)
    let size = dataAt + linkedDataSize(o, 8 * len(imports))
    var names: [Text] = []
    for f in rt.prog.fns {
        names.push(f.name)
    }
    RuntimeImage(
        link(rt.mc, o, stubs, host.os, arm, imports, cellAt, 8 * len(imports), 0, dataAt, 0),
        textSize,
        dataAt,
        size,
        names,
        rt.mc.fnAt,
    )
}

// the image mapped here, its pointers moved, its C functions found, this thread made ready for it
fn mapImage(host: Host, img: RuntimeImage) -> Mapped? {
    let l = img.linked
    let base = host.mapMemory(img.size)
    if base == 0 {
        printErr("quark: no memory for the runtime")
        return None
    }
    poke(base, l.text)
    let data = base + img.dataAt
    poke(data, l.data)
    for p in l.pointers {
        pokeWord(data + p, 0, peekWord(data + p, 0) + base)
    }
    for (i, f) in l.imports.enumerate() {
        let address = host.cFunction(f)
        if address == 0 {
            printErr("quark: cannot find {f} for the runtime")
            return None
        }
        pokeWord(data + l.importAt + l.cellAt[i], 0, address)
    }
    if not host.protectCode(base, img.textSize) {
        printErr("quark: cannot make the runtime's code runnable")
        return None
    }
    let m = Mapped(base, l.symbols, img.names, img.starts, img.textSize)
    let _ = m.call("qkosHostInit", 0, 0, 0, 0)
    Some(m)
}

const imageMagic = "QKRTIMG2"

fn imageBytes(img: RuntimeImage) -> Bytes {
    let l = img.linked
    var b = Buf()
    b.add(imageMagic.bytes())
    for v in [
        img.textSize,
        img.dataAt,
        img.size,
        l.importAt,
        len(l.text),
        len(l.data),
        len(l.pointers),
        len(l.imports),
        len(l.symbols),
    ] {
        b.u64(v)
    }
    b.add(l.text)
    b.add(l.data)
    for p in l.pointers {
        b.u64(p)
    }
    for (i, f) in l.imports.enumerate() {
        b.cText(f)
        b.u64(l.cellAt[i])
    }
    for (name, at) in l.symbols {
        b.cText(name)
        b.u64(at)
    }
    b.u64(len(img.names))
    for (i, name) in img.names.enumerate() {
        b.cText(name)
        b.u64(img.starts[i])
    }
    b.add(imageMagic.bytes()) // whole: a file cut short is not read
    b.b
}

type Reader { b: Bytes, at: Int = 0 }

fn Reader.u64(var self) -> Int {
    let v = u64At(self.b, self.at)
    self.at += 8
    v
}

fn Reader.cText(var self) -> Text {
    var end = self.at
    while self.b[end] != 0 {
        end += 1
    }
    let t = Text(self.b[self.at..end]) ?? ""
    self.at = end + 1
    t
}

fn Reader.bytes(var self, n: Int) -> Bytes {
    let out = self.b[self.at..self.at + n]
    self.at += n
    out
}

fn readImage(b: Bytes) -> RuntimeImage? {
    let n = len(b)
    if n < 88 or b[..8] != imageMagic.bytes() or b[n - 8..] != imageMagic.bytes() {
        return None
    }
    var r = Reader(b, 8)
    let textSize = r.u64()
    let dataAt = r.u64()
    let size = r.u64()
    let importAt = r.u64()
    let textLen = r.u64()
    let dataLen = r.u64()
    let pointerCount = r.u64()
    let importCount = r.u64()
    let symbolCount = r.u64()
    if r.at + textLen + dataLen > n {
        return None
    }
    var l = Linked(text: r.bytes(textLen), data: r.bytes(dataLen), importAt: importAt)
    for _ in 0..pointerCount {
        l.pointers.push(r.u64())
    }
    for _ in 0..importCount {
        l.imports.push(r.cText())
        l.cellAt.push(r.u64())
    }
    for _ in 0..symbolCount {
        let name = r.cText()
        l.symbols[name] = r.u64()
    }
    var names: [Text] = []
    var starts: [Int] = []
    for _ in 0..r.u64() {
        names.push(r.cText())
        starts.push(r.u64())
    }
    RuntimeImage(l, textSize, dataAt, size, names, starts)
}

// what this compiler is: its sources' checksum (compiler/embed.sh). Two compilers built
// from the same sources make the same runtime (the bootstrap's fixed point): reading the executable to know it cost
// 15 to 20 ms a run.
fn compilerId(host: Host) -> Int {
    var h = -3750763034362895579
    for ch in compilerSources.bytes() {
        h = (h ^ ch) *% 1099511628211
    }
    if h == 0 { 1 } else { h }
}

// FNV-1a over the runtime's texts and the compiler that makes it: the cache's name
fn runtimeKey(name: Text, id: Int) -> Text {
    var h = -3750763034362895579 ^ id
    for file in runtimeFiles {
        for ch in (runtimeText(file) ?? "").bytes() {
            h = (h ^ ch) *% 1099511628211
        }
    }
    let digits = "0123456789abcdef"
    var out = name + "-"
    for k in 0..16 {
        let d = h >> (60 - 4 * k) & 15
        out += digits[d..d + 1]
    }
    out
}

// The runtime for this machine, mapped here: compiled from the texts the compiler keeps, or read from the temporary
// folder where an earlier run kept it (quark-runtime-NAME-HASH.bin; QUARK_RUNTIME_CACHE=off keeps none)
pub fn loadRuntime(host: Host) -> Mapped? {
    let name = (match host.os {
        Windows => "windows"
        Linux => "linux"
        Macos => "macos"
    }) + (if host.arm { "-arm64" } else { "" })
    let id = compilerId(host)
    let keep = env("QUARK_RUNTIME_CACHE") != Some("off") and id != 0
    let file = "quark-runtime-{runtimeKey(name, id)}.bin"
    let cache = cachePath(file)
    if keep and readBytes(cache) is Ok(b) and readImage(b) is Some(img) {
        cacheUsed(file, len(b))
        return mapImage(host, img)
    }
    let Some(rt) = compileRuntime(host, "") else {
        return None
    }
    let img = linkRuntime(host, rt)
    if keep {
        let bytes = imageBytes(img)
        let _ = writeBytes(cache, bytes)
        cacheUsed(file, len(bytes))
    }
    mapImage(host, img)
}

// the runtime's function name, called (four integers at most)
pub fn Mapped.call(self, name: Text, a: Int, b: Int, c: Int, d: Int) -> Int {
    let at = self.symbols[name] ?? panic("the runtime has no {name}")
    machine.call(Pointer<UInt8>(self.base + at), a, b, c, d)
}

// t to the program's output (buffered with what it prints) or, after that, to the errors
pub fn Mapped.out(self, t: Text) {
    let p = cText(t)
    let _ = self.call("qkHostWrite", 1, p, len(t.bytes()), 0)
}

pub fn Mapped.err(self, t: Text) {
    let p = cText(t)
    let _ = self.call("qkHostWrite", 2, p, len(t.bytes()), 0)
}

pub fn Mapped.flush(self) {
    let _ = self.call("qkHostFlush", 0, 0, 0, 0)
}

// the runtime's state for a program: its arguments (args() gives them), the path its panics say
pub fn Mapped.begin(self, path: Text, programArgs: [Text]) {
    var argv = [cText("quark")]
    for a in programArgs {
        argv.push(cText(a))
    }
    argv.push(0)
    let _ = self.call("qkHostBegin", len(programArgs) + 1, wordsInC(argv), cText(path), 0)
}

// a program loaded: its Loaded, or 0 with why said ("quark: cannot find f in the C library")
pub fn Mapped.load(self, c: Compiled, mc: MachineCode, entry: Int, fuel: Int, memory: Int, quiet: Bool = false) -> Int {
    let program = programBytes(c, mc, entry, fuel, memory)
    let size = len(program) - trailerBytes
    let payload = malloc(size + 1)
    poke(payload, program[..size])
    let trailer = malloc(trailerBytes)
    poke(trailer, program[size..])
    let why = malloc(512)
    Pointer<UInt8>(why)[0] = 0
    let l = self.call("qkHostLoad", payload, trailer, why, 0)
    if l == 0 {
        self.flush()
        if not quiet {
            printErr("quark: {textAtC(why)}")
        }
        return 0
    }
    // its trace: what a panic says of the calls it went through, and in which file (0: the program's own)
    let t = malloc(9 * 8)
    var names: [Int] = []
    var files: [Int] = []
    let fileOf = (k: Int) => if k > 0 and k < len(c.prog.files) {
        cText(c.prog.files[k])
    } else {
        0
    }
    for f in c.prog.fns {
        names.push(cText(f.name))
        files.push(fileOf(f.file))
    }
    pokeWord(t, 0, len(c.prog.fns))
    pokeWord(t, 1, wordsInC(names))
    pokeWord(t, 2, wordsInC(mc.fnAt))
    pokeWord(t, 3, len(mc.sites))
    var sites: [Int] = []
    for s in mc.sites {
        sites += [s.ret, s.line, s.caller, s.callee, s.inl]
    }
    pokeWord(t, 4, wordsInC(sites))
    pokeWord(t, 5, len(c.inlines))
    var inlines: [Int] = []
    for x in c.inlines {
        inlines += [x.parent, x.line, cText(x.callee), fileOf(x.file)]
    }
    pokeWord(t, 6, wordsInC(inlines))
    pokeWord(t, 7, wordsInC(files))
    let _ = self.call("qkHostTrace", l, t, 0, 0)
    l
}

// the program's machine code as it is loaded: through adapters when it calls the System V way on Windows
pub fn loadedCode(host: Host, c: Compiled) -> MachineCode = if c.prog.target.sysv
    and host.os == .Windows
    and c.prog.target.arch == .X64 {
    sysvAdapted(c.mc)
} else {
    c.mc
}

pub fn Mapped.panicText(self) -> Text = textAtC(self.call("qkHostPanicText", 0, 0, 0, 0))

// the C functions a program calls, when it calls the System V way on Windows: none can be
pub fn sysvRefuses(host: Host, c: Compiled) -> Bool {
    if host.os == .Windows and c.prog.target.sysv and len(c.prog.externs) > 0 {
        printErr(
            "quark: --abi sysv tests the System V calls on Windows, and {c.prog.externs[0].name} is a Windows function: run it without --abi",
        )
        return true
    }
    false
}

// ---- --profile ----
// the C functions a profile names (the libraries' others: "(C's libraries)")
const profiledC = [
    "memset", "memcpy", "memmove", "memcmp", "malloc", "calloc", "realloc", "free", "strlen", "strtod", "VirtualAlloc",
    "VirtualFree", "TlsGetValue", "TlsSetValue", "WriteFile", "ReadFile", "pthread_getspecific", "mmap", "munmap",
]

pub fn profileReport(host: Host, m: Mapped, c: Compiled, l: Int, p: Int) {
    var cAt: [Int] = []
    for name in profiledC {
        cAt.push(host.cFunction(name))
    }
    let code = peekWord(l, 0)
    let codeLen = peekWord(l, 1)
    let count = len(c.prog.fns)
    var hits = [0] * (count + 1)
    var inRuntime = [0] * (len(m.names) + 1)
    var inC = [0] * (len(profiledC) + 1)
    var calledFrom = [0] * (count + 1) // the runtime's samples, by the program's function that called it
    var inclusive = [0] * (count + 1) // each function's samples with what it calls
    let samples = peekWord(p, 3)
    for k in 0..peekWord(p, 4) {
        let pc = peekWord(samples, profileWords * k)
        // with what it calls: each function in the frames once
        var seen: [Int] = []
        for j in 0..profileWords {
            let a = peekWord(samples, profileWords * k + j)
            if a >= code and a < code + codeLen {
                let fi = fnOfCode(c, a - code)
                if not seen.contains(fi) {
                    seen.push(fi)
                    inclusive[fi] += 1
                }
            }
        }
        if pc < code or pc >= code + codeLen {
            hits[count] += 1
            var caller = count
            for j in 1..profileWords {
                let ret = peekWord(samples, profileWords * k + j)
                if caller == count and ret >= code and ret < code + codeLen {
                    caller = fnOfCode(c, ret - code)
                }
            }
            calledFrom[caller] += 1
            let r = runtimeFunction(m, pc - m.base)
            if r < len(m.names) {
                inRuntime[r] += 1
            } else {
                // the C function it is in: the nearest named one below it (within 64 KB), else the libraries'
                var best = -1
                for (ci, at) in cAt.enumerate() {
                    if at != 0 and at <= pc and pc - at < 65536 and (best < 0 or at > cAt[best]) {
                        best = ci
                    }
                }
                inC[best + 1] += 1
            }
            continue
        }
        let at = pc - code
        hits[fnOfCode(c, at)] += 1
    }
    let total = hits.sum()
    if total == 0 {
        m.err("quark: profile: no samples (the program ran under a millisecond)\n")
        return
    }
    var out = "quark: profile, {total} samples (one a millisecond):\n"
    var shown = [false] * (count + 1)
    while true {
        var best = -1
        for i in 0..count + 1 {
            if not shown[i] and hits[i] > 0 and (best < 0 or hits[i] > hits[best]) {
                best = i
            }
        }
        if best < 0 {
            break
        }
        shown[best] = true
        var share = fixed(100.0 * toFloat(hits[best]) / toFloat(total), 1)
        while len(share) < 5 {
            share = " " + share
        }
        out += "  {share}%  {if best < count { c.prog.fns[best].name } else { "(the runtime: printing, text, maps, memory)" }}\n"
        if best == count {
            out += runtimeShares(m, inRuntime, total)
            out += "    the runtime's share, by the program's function that called it:\n"
            for (fi, n) in calledFrom.enumerate() {
                if 200 * n >= total {
                    out += "      {fixed(100.0 * toFloat(n) / toFloat(total), 1)}%  {if fi < count { c.prog.fns[fi].name } else { "(not found)" }}\n"
                }
            }
            for (k, n) in inC.enumerate() {
                if 1000 * n >= total {
                    out += "      {fixed(100.0 * toFloat(n) / toFloat(total), 1)}%  C: {if k > 0 { profiledC[k - 1] } else { "the libraries' others" }}\n"
                }
            }
        }
    }
    // the copies values make (the "own" functions): who makes them, a frame up
    var copiers: [Int: Int] = [:]
    for k in 0..peekWord(p, 4) {
        var found = -1
        for j in 0..profileWords {
            let a = peekWord(samples, profileWords * k + j)
            if a >= code and a < code + codeLen {
                let fi = fnOfCode(c, a - code)
                if found >= 0 and fi != found {
                    copiers[found * 65536 + fi] = (copiers[found * 65536 + fi] ?? 0) + 1
                    break
                }
                if found < 0 and c.prog.fns[fi].name.startsWith("own ") {
                    found = fi
                }
            }
        }
    }
    for (key, n) in copiers {
        if 200 * n >= total {
            out += "  copies: {fixed(100.0 * toFloat(n) / toFloat(total), 1)}%  {c.prog.fns[key / 65536].name} made by {c.prog.fns[key % 65536].name}\n"
        }
    }
    out += "quark: profile with what each function calls (frames the sampler could walk):\n"
    var shownIn = [false] * (count + 1)
    for _ in 0..30 {
        var best = -1
        for i in 0..count {
            if not shownIn[i] and inclusive[i] > 0 and (best < 0 or inclusive[i] > inclusive[best]) {
                best = i
            }
        }
        if best < 0 {
            break
        }
        shownIn[best] = true
        out += "  {fixed(100.0 * toFloat(inclusive[best]) / toFloat(total), 1)}%  {c.prog.fns[best].name}\n"
    }
    m.err(out)
}

const profileWords = 32 // runtime/host.qk's sampleWords

// the program's function at offset at of its code (len(fns): none)
fn fnOfCode(c: Compiled, at: Int) -> Int {
    var f = -1
    for (i, start) in c.mc.fnAt.enumerate() {
        if start <= at and (f < 0 or start > c.mc.fnAt[f]) {
            f = i
        }
    }
    if f >= 0 { f } else { len(c.prog.fns) }
}

// the runtime's function at offset at of its text (len(m.names): outside it, in C's libraries)
fn runtimeFunction(m: Mapped, at: Int) -> Int {
    let outside = len(m.names)
    if at < 0 or at >= m.textSize {
        return outside
    }
    var f = outside
    for (i, start) in m.starts.enumerate() {
        if start <= at and (f == outside or start > m.starts[f]) {
            f = i
        }
    }
    f
}

// the runtime's share by function, down to a tenth of a percent of all the samples
fn runtimeShares(m: Mapped, hits: [Int], total: Int) -> Text {
    var out = ""
    var shown = [false] * len(hits)
    while true {
        var best = -1
        for i in 0..len(hits) {
            if not shown[i] and 1000 * hits[i] >= total and (best < 0 or hits[i] > hits[best]) {
                best = i
            }
        }
        if best < 0 {
            break
        }
        shown[best] = true
        var share = fixed(100.0 * toFloat(hits[best]) / toFloat(total), 1)
        while len(share) < 5 {
            share = " " + share
        }
        out += "      {share}%  {if best < len(m.names) { m.names[best] } else { "(C's libraries)" }}\n"
    }
    out
}

// ---- quark run ----
// The program run in memory by the runtime mapped here: its exit status (exit(code) ends the process itself).
pub fn runProgram(host: Host, m: Mapped, c: Compiled, o: RunOptions) -> Int {
    if c.prog.mainIndex < 0 {
        printErr("quark: a program starts at fn main() \{ ... \}")
        return 1
    }
    if sysvRefuses(host, c) {
        return 1
    }
    let mc = loadedCode(host, c)
    let l = m.load(c, mc, mc.fnAt[c.prog.mainIndex], o.fuel, o.memory)
    if l == 0 {
        return 1
    }
    let t0 = monotonicTime()
    let p = if o.profile {
        m.call("qkHostProfileStart", 262144, 0, 0, 0)
    } else {
        0
    }
    let ok = m.call("qkHostCall", l, mc.fnAt[c.prog.mainIndex], 0, 0) != 0
    if p != 0 {
        let _ = m.call("qkHostProfileStop", p, 0, 0, 0)
        m.flush()
        profileReport(host, m, c, l, p)
    }
    m.flush()
    if not ok {
        m.err(m.panicText() + "\n")
        return 1
    }
    if o.timed {
        m.err("quark: ran in {fixed((monotonicTime() - t0) * 1000, 2)} ms\n")
    }
    0
}

// ---- quark test: each test "name" { ... } on its own, with its own memory; a failed assert or a panic fails only it
pub fn runTests(host: Host, m: Mapped, c: Compiled, o: RunOptions) -> Int {
    if sysvRefuses(host, c) {
        return 1
    }
    let mc = loadedCode(host, c)
    let l = m.load(c, mc, 0, 0, o.memory)
    if l == 0 {
        return 1
    }
    var passed = 0
    var failed = 0
    for (fnName, testName) in c.tests {
        if o.filter != "" and not testName.contains(o.filter) {
            continue
        }
        var f = -1
        for (k, x) in c.prog.fns.enumerate() {
            if f < 0 and x.name == fnName {
                f = k
            }
        }
        if f < 0 {
            continue
        }
        let fuel = if o.fuel > 0 { o.fuel } else { 9223372036854775807 }
        let t0 = monotonicTime()
        let ok = m.call("qkHostCall", l, mc.fnAt[f], fuel, 0) != 0
        let ms = (monotonicTime() - t0) * 1000
        if ok {
            passed += 1
            m.out("ok    {testName} ({fixed(ms, 1)} ms)\n")
        } else {
            failed += 1
            m.out("FAIL  {testName}\n      {m.panicText()}\n")
        }
        m.flush()
    }
    m.out("{passed} passed, {failed} failed\n")
    if o.coverage {
        m.out(coverageReport(o.path, c.prog.coverLines.sorted(), m.call("qkHostCoverage", 0, 0, 0, 0)))
    }
    m.flush()
    if failed > 0 { 1 } else { 0 }
}

// the lines of the file that can run, and of those the ones the tests ran (map: a byte a line, 1 when run; 0 none
// ran): how many, and the ones not run, in runs (12, 20-23)
fn coverageReport(path: Text, lines: [Int], map: Int) -> Text {
    var run = 0
    var missed: [Text] = []
    var i = 0
    while i < len(lines) {
        if map != 0 and Pointer<UInt8>(map)[lines[i]] != 0 {
            run += 1
            i += 1
            continue
        }
        var j = i
        while j + 1 < len(lines) and not (map != 0 and Pointer<UInt8>(map)[lines[j + 1]] != 0) {
            j += 1
        }
        missed.push(if j > i { "{lines[i]}-{lines[j]}" } else { "{lines[i]}" })
        i = j + 1
    }
    let share = if len(lines) == 0 {
        100.0
    } else {
        100.0 * toFloat(run) / toFloat(len(lines))
    }
    let rest = if len(missed) == 0 { "" } else { "; not run: " + missed.join(", ") }
    "coverage of {path}: {run} of {len(lines)} lines run ({fixed(share, 1)}%){rest}\n"
}

// ---- quark build ----
// An executable for target ("": this machine): the runtime (compiled, linked and laid out as the system wants), then
// the program. The runtime's part is the same for every program, so it is kept made in the temporary folder
// (quark-exe-NAME-HASH.bin, as quark run keeps its runtime; QUARK_RUNTIME_CACHE=off keeps none). macOS signs the
// program with the rest: there the runtime is made each time.
pub fn buildExecutable(host: Host, target: Text, c: Compiled, o: RunOptions) -> Int {
    if c.prog.mainIndex < 0 {
        printErr("quark: an executable starts at fn main()")
        return 1
    }
    if target.startsWith("wasm32") {
        return buildWasm(host, c, o)
    }
    let jit = if o.debugInfo {
        jitObjectOf(debugInfoOf(host, c))
    } else {
        JitObject([], [])
    }
    let program = programBytes(c, c.mc, c.mc.fnAt[c.prog.mainIndex], o.fuel, o.memory, jit)
    let os = c.os
    let arm = c.prog.target.arch == .Arm64
    let out = o.outPath ?? defaultOutput(os, o.path)
    var libc = Libc.Glibc
    if host.os == .Linux and (pathExists("/lib/ld-musl-x86_64.so.1") or pathExists("/lib/ld-musl-aarch64.so.1")) {
        libc = .Musl // the system's own C library, when it is musl
    }
    if o.libc == "musl" {
        libc = .Musl
    } else if o.libc == "glibc" {
        libc = .Glibc
    }
    let id = compilerId(host)
    let keep = env("QUARK_RUNTIME_CACHE") != Some("off") and id != 0 and os != .Macos
    let name = (match os {
        Windows => "windows"
        Linux => if libc == .Musl { "linux-musl" } else { "linux" }
        Macos => "macos"
    }) + (if arm { "-arm64" } else { "-x64" })
    // the runtime's functions the program calls (its code's addresses of them): the executable holds those and what
    // they reach, not the whole runtime; kept by that set
    var used = [false] * len(runtimeNames)
    let reached = c.prog.reached([c.prog.mainIndex]) // (the prelude's built-ins it does not call are not its)
    // and those its machine code calls (a bounds check's panic, the fuel...): each address of one, in a function it
    // reaches (the functions' code in order: fnAt)
    var starts: [(Int, Int)] = []
    for (k, at) in c.mc.fnAt.enumerate() {
        starts.push((at, k))
    }
    starts = starts.sortedBy(p => p.0)
    for r in c.mc.relocs {
        if r.kind != relocRuntime or r.target < 0 or r.target >= len(used) {
            continue
        }
        var lo = 0 // the last function starting at or before it
        var hi = len(starts)
        while lo < hi {
            let mid = (lo + hi) / 2
            if starts[mid].0 <= r.at {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        let owner = if lo > 0 { starts[lo - 1].1 } else { -1 }
        // (the way in and out, and the stubs the code calls the runtime through, are after every function: a cold
        // path's panic calls rtPanic through one)
        let outside = r.at >= min(c.mc.enter, c.mc.escape)
        if outside or owner < 0 or owner >= len(reached) or reached[owner] {
            used[r.target] = true // (outside any function: the trampolines')
        }
    }
    for (k, f) in c.prog.fns.enumerate() {
        if not reached[k] {
            continue
        }
        for ins in f.code {
            if ins.op == Op.RtCall and ins.imm >= 0 and ins.imm < len(used) {
                used[ins.imm] = true
            }
        }
    }
    var set = Hash128()
    set.add(used.map(u => if u { 49 } else { 48 }).toArray())
    let file = "quark-exe-{runtimeKey(name, id)}-{set.text()[..16]}.bin"
    let cache = cachePath(file)
    var image: Bytes = []
    if keep and readBytes(cache) is Ok(b) and len(b) > 16 and b[len(b) - 8..] == "QKEXEIMG".bytes() {
        cacheUsed(file, len(b))
        image = b[..len(b) - 8] + program
    } else {
        let Some(rt) = compileRuntimeFor(host, target, used) else {
            return 1
        }
        let info = ImageInfo(rt.os, true, rt.features, rt.data, runtimeNames)
        let o2 = layout(rt.mc, rt.prog, info)
        let none: Bytes = []
        let front = match os {
            Windows => peImage(rt.mc, o2, none, arm)
            Linux => elfImage(rt.mc, o2, none, arm, libc)
            Macos => none
        }
        if keep {
            let _ = writeBytes(cache, front + "QKEXEIMG".bytes())
            cacheUsed(file, len(front) + 8)
        }
        image = if os == .Macos {
            machoImage(rt.mc, o2, program, arm, fileNameOf(out))
        } else {
            front + program
        }
    }
    if writeBytes(out, image) is Err(_) {
        printErr("quark: cannot write {out}")
        return 1
    }
    if host.os != .Windows {
        let _ = runProcess("chmod", ["755", out]) // it runs
    }
    printErr("quark: wrote {out} ({len(c.mc.code)} bytes of machine code)")
    0
}

// a path's last part: its file's name
fn fileNameOf(path: Text) -> Text {
    var from = 0
    for (i, ch) in path.bytes().enumerate() {
        if ch is '/' | '\\' {
            from = i + 1
        }
    }
    path[from..]
}

// file.qk's executable: file.exe on Windows, file elsewhere
fn defaultOutput(os: Os, path: Text) -> Text {
    let b = path.bytes()
    var dot = -1
    for (i, ch) in b.enumerate() {
        if ch == '.' {
            dot = i
        } else if ch is '/' | '\\' {
            dot = -1
        }
    }
    let stem = if dot >= 0 { path[..dot] } else { path }
    if os == .Windows { stem + ".exe" } else { stem }
}
