// Modules: `use geometry` in a file brings in the pub declarations of geometry.qk, the file next to it (`use
// shapes.round`: shapes/round.qk), or of a package quark.toml names (`use geom.shapes`: .quark/pkg/geom/shapes.qk,
// checked against quark.lock: package.qk). Every file of a program is parsed into the one tree, each declaration marked with
// the file (module) it comes from; the checker lets a file see its own declarations, the host's, and the pub ones of
// the files it uses (not the files those use). `use std.json`: the standard library, std/json.qk.
use ast
use source
use parser
use types
use package
use stdlib

// a program read: its files parsed into one tree (the host's declarations first, when it gives some), the errors
// said, and whether there was none
pub type Loaded { program: Program, errors: Errors, ok: Bool }

// The program in a file's text, after the host's declarations (prelude), with the files its uses name. at: where
// the file is, when its name is not its path (the language server's file:///... texts); "": src.path. hostFiles: the
// texts of the files a host gives (qkModuleReader, compiler/api.qk): then every file the program uses but the
// standard library's comes from them, none from the disk. open: texts that stand for files on the disk (an editor's,
// not saved yet: the language server's), by path.
pub fn loadProgram(
    src: Source,
    prelude: Source?,
    at: Text = "",
    hostFiles: [Text: Text]? = None,
    open: [Text: Text] = [:],
) -> Loaded {
    var errors = Errors()
    let first = parse(src)
    errors.shown += first.errors
    if not first.ok {
        return Loaded(newProgram(first.ast, []), errors, false)
    }
    var tree = first.ast
    if prelude is Some(host) {
        let own = len(tree.decls)
        let pre = parse(host)
        errors.shown += pre.errors
        if not pre.ok {
            return Loaded(newProgram(tree, []), errors, false)
        }
        tree.append(pre.ast)
        var given = tree.decls[own..]
        for i in 0..len(given) {
            given[i].fromPrelude = true
        }
        tree.decls = given + tree.decls[..own]
    }
    var modules = [Module(if at != "" { at } else { src.path }, src)]
    var ok = true
    var packages = Packages()
    var m = 0
    while m < len(modules) {
        // the list grows as files name more files
        var i = 0
        while i < len(tree.decls) {
            // (looked at in place: a copy of each declaration, for each file, would be most of reading a program)
            if tree.decls[i].kind != DeclKind.Use or tree.decls[i].module != m {
                i += 1
                continue
            }
            let d = tree.decls[i]
            i += 1
            let from = modules[m].src
            let std = d.name.startsWith("std.")
            var file = modulePath(if std { "" } else { modules[m].path }, d.name)
            if not std {
                // geom.shapes, geom in quark.toml: .quark/pkg/geom/shapes.qk (compiler/package.qk)
                let pkg = packages.fileFor(modules[m].path, d.name)
                if pkg.error is Some(why) {
                    errors.add(from, d.line, d.col, "use {d.name}: {why}")
                    ok = false
                    continue
                }
                if pkg.file is Some(f) {
                    file = f
                }
            }
            var found = -1
            for (k, mod) in modules.enumerate() {
                if found < 0 and mod.path == file {
                    found = k
                }
            }
            if found == m {
                errors.add(from, d.line, d.col, "a file cannot use itself")
                ok = false
                continue
            }
            if found < 0 {
                let Some(text) = (if std { None } else { open[file] }) ?? readModule(file, std, hostFiles) else {
                    errors.add(from, d.line, d.col, "use {d.name}: cannot read {file}")
                    ok = false
                    continue
                }
                let sub = Source(file, text)
                let before = len(tree.decls)
                let parsed = parse(sub)
                errors.shown += parsed.errors
                if not parsed.ok {
                    ok = false
                    continue
                }
                tree.append(parsed.ast)
                modules.push(Module(file, sub, useName: d.name))
                found = len(modules) - 1
                for k in before..len(tree.decls) {
                    tree.decls[k].module = found
                }
            }
            if modules[m].uses.contains(found) {
                errors.add(from, d.line, d.col, "{d.name} is used twice")
                ok = false
            } else {
                modules[m].uses.push(found)
                modules[m].aliases.push(d.alias)
            }
        }
        m += 1
    }
    if not src.path.startsWith(embeddedRuntime) {
        // the language's own declarations (compiler/prelude.qk), after the program's: a program's own name hides one
        let pre = Source(preludePath, preludeText())
        let before = len(tree.decls)
        let parsed = parse(pre)
        errors.shown += parsed.errors
        if parsed.ok {
            tree.append(parsed.ast)
            modules.push(Module(preludePath, pre))
            for k in before..len(tree.decls) {
                tree.decls[k].module = len(modules) - 1
                tree.decls[k].builtin = true
            }
        } else {
            ok = false
        }
    }
    Loaded(newProgram(tree, modules), errors, ok)
}

pub const preludePath = "<quark>/prelude.qk"

// where the runtime's files are, as the compiler keeps them (compiler/stdlib.qk): quark run and quark build compile
// "<quark>/runtime/windows.qk" (or linux.qk) and the files it uses from there
pub const embeddedRuntime = "<quark>/runtime/"

// a file's text: the standard library's as the compiler keeps it (compiler/stdlib.qk; else from std/ next to where
// quark runs, or $QUARK_STD), the runtime's as the compiler keeps it, another one from disk
fn readModule(file: Text, std: Bool, hostFiles: [Text: Text]?) -> Text? {
    if std and stdText(file[4..len(file) - 3]) is Some(text) {
        return text
    }
    if file.startsWith(embeddedRuntime) {
        return runtimeText(file[len(embeddedRuntime)..len(file) - 3])
    }
    if not std and hostFiles is Some(files) {
        return files[file] // the host's reader's (compiler/api.qk)
    }
    if readFile(file) is Ok(text) {
        return text
    }
    if not std {
        return None
    }
    let dir = env("QUARK_STD") ?? return None
    if readFile(dir + "/" + file[4..]) is Ok(text) {
        return text
    }
    None
}

// dir of `from` + name with its dots as folders + ".qk"
pub fn modulePath(from: Text, name: Text) -> Text {
    let b = from.bytes()
    var slash = -1
    for (i, c) in b.enumerate() {
        if c is '/' | '\\' {
            slash = i
        }
    }
    from[..slash + 1] + name.replace(".", "/") + ".qk"
}
