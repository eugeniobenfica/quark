extern effect fn findFirstFileW(w: Int64, data: Int64) -> Int64 as "FindFirstFileW"
extern effect fn findNextFileW(h: Int64, data: Int64) -> Int32 as "FindNextFileW"
extern effect fn findClose(h: Int64) -> Int32 as "FindClose"
extern effect fn virtualAlloc(p: Int64, n: UInt64, kind: UInt32, protect: UInt32) -> Int64 as "VirtualAlloc"
extern effect fn virtualProtect(p: Int64, n: UInt64, protect: UInt32, old: Int64) -> Int32 as "VirtualProtect"
extern effect fn virtualFree(p: Int64, n: UInt64, kind: UInt32) -> Int32 as "VirtualFree"
extern effect fn flushInstructionCache(process: Int64, p: Int64, n: UInt64) -> Int32 as "FlushInstructionCache"
extern effect fn getCurrentProcess() -> Int64 as "GetCurrentProcess"
extern effect fn getCurrentThreadStackLimits(low: Int64, high: Int64) as "GetCurrentThreadStackLimits"
extern effect fn loadLibraryW(w: Int64) -> Int64 as "LoadLibraryW"
extern effect fn getProcAddress(m: Int64, name: Int64) -> Int64 as "GetProcAddress"
extern effect fn getSystemInfo(info: Int64) as "GetSystemInfo"
extern effect fn createThread(security: Int64, stack: UInt64, f: Int64, arg: Int64, flags: UInt32, id: Int64) -> Int64 as "CreateThread"
extern effect fn waitForSingleObject(h: Int64, ms: UInt32) -> UInt32 as "WaitForSingleObject"
extern effect fn closeHandle(h: Int64) -> Int32 as "CloseHandle"
extern effect fn queryPerformanceCounter(at: Int64) -> Int32 as "QueryPerformanceCounter"
extern effect fn queryPerformanceFrequency(at: Int64) -> Int32 as "QueryPerformanceFrequency"
extern effect fn getSystemTimePreciseAsFileTime(at: Int64) as "GetSystemTimePreciseAsFileTime"
extern effect fn winSleep(ms: UInt32) as "Sleep"
extern effect fn createPipe(read: Int64, write: Int64, security: Int64, size: UInt32) -> Int32 as "CreatePipe"
