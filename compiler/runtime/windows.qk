// The runtime's system calls on Windows: kernel32 alone (and ntdll's memcpy, memset, memcmp, strlen), each behind a
// symbol of the runtime's own (qkos*, C's calls; linux.qk gives the same ones), and the executable's entry, wmain.
// What the C library gives elsewhere is made here over kernel32: the heap (malloc...: the process's heap), files (a
// FILE* is a word of ours over a handle), the environment, the time and its zone, the command line's arguments. Names
// are UTF-8 in the runtime and UTF-16 here: Windows' wide functions take any name, its ANSI ones only the code
// page's.
use base
use io
use start
use host

extern effect fn tlsAlloc() -> UInt32 as "TlsAlloc"
extern effect fn tlsGetValue(index: UInt32) -> Int64 as "TlsGetValue"
extern effect fn tlsSetValue(index: UInt32, v: Int64) -> Int32 as "TlsSetValue"
extern effect fn getStdHandle(which: UInt32) -> Int64 as "GetStdHandle"
extern effect fn winWriteFile(h: Int64, p: Int64, n: UInt32, done: Int64, overlapped: Int64) -> Int32 as "WriteFile"
extern effect fn winReadFile(h: Int64, p: Int64, n: UInt32, done: Int64, overlapped: Int64) -> Int32 as "ReadFile"
extern effect fn getConsoleMode(h: Int64, mode: Int64) -> Int32 as "GetConsoleMode"
extern effect fn readConsoleW(h: Int64, p: Int64, n: UInt32, done: Int64, control: Int64) -> Int32 as "ReadConsoleW"
extern effect fn setConsoleOutputCP(page: UInt32) -> Int32 as "SetConsoleOutputCP"
extern effect fn multiByteToWideChar(page: UInt32, flags: UInt32, s: Int64, n: Int32, w: Int64, wn: Int32) -> Int32 as "MultiByteToWideChar"

extern effect fn wideCharToMultiByte(
    page: UInt32,
    flags: UInt32,
    w: Int64,
    wn: Int32,
    s: Int64,
    n: Int32,
    d: Int64,
    u: Int64,
) -> Int32 as "WideCharToMultiByte"

extern effect fn getModuleFileNameW(m: Int64, w: Int64, n: UInt32) -> UInt32 as "GetModuleFileNameW"
extern effect fn getFileAttributesW(w: Int64) -> UInt32 as "GetFileAttributesW"
extern effect fn createDirectoryW(w: Int64, security: Int64) -> Int32 as "CreateDirectoryW"
extern effect fn removeDirectoryW(w: Int64) -> Int32 as "RemoveDirectoryW"
extern effect fn deleteFileW(w: Int64) -> Int32 as "DeleteFileW"
