    args: Int64,
) -> UInt32 as "FormatMessageA"

extern effect fn getCommandLineW() -> Int64 as "GetCommandLineW"
extern effect fn getProcessHeap() -> Int64 as "GetProcessHeap"
extern effect fn heapAlloc(h: Int64, flags: UInt32, n: UInt64) -> Int64 as "HeapAlloc"
extern effect fn heapReAlloc(h: Int64, flags: UInt32, p: Int64, n: UInt64) -> Int64 as "HeapReAlloc"
extern effect fn heapFree(h: Int64, flags: UInt32, p: Int64) -> Int32 as "HeapFree"
