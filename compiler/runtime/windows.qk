extern effect fn getSystemTimeAsFileTime(at: Int64) as "GetSystemTimeAsFileTime"
extern effect fn fileTimeToSystemTime(ft: Int64, st: Int64) -> Int32 as "FileTimeToSystemTime"
extern effect fn systemTimeToTzSpecificLocalTime(zone: Int64, utc: Int64, local: Int64) -> Int32 as "SystemTimeToTzSpecificLocalTime"
extern effect fn systemTimeToFileTime(st: Int64, ft: Int64) -> Int32 as "SystemTimeToFileTime"

extern effect fn createFileW(
    name: Int64,
    access: UInt32,
    share: UInt32,
    security: Int64,
    how: UInt32,
    flags: UInt32,
    template: Int64,
) -> Int64 as "CreateFileW"

extern fn fnAddress(f: extern (Int64) -> Int64) -> Int64 as "qkTextAddress"

const utf8 = 65001

// ---- text both ways ----
// a UTF-8 text (zero-ended) as UTF-16, malloc'd
fn wide(s: Int) -> Int {
    let n = multiByteToWideChar(utf8, 0, s, -1, 0, 0)
    let w = calloc(if n > 0 { n } else { 1 }, 2)
    if n > 0 {
        let _ = multiByteToWideChar(utf8, 0, s, -1, w, n)
    }
    w
}

// n bytes of UTF-8 as UTF-16 (zero-ended), malloc'd
fn wideOf(s: Int, n: Int) -> Int {
    let k = if n > 0 { multiByteToWideChar(utf8, 0, s, n, 0, 0) } else { 0 }
    let w = calloc(k + 1, 2)
    if k > 0 {
        let _ = multiByteToWideChar(utf8, 0, s, n, w, k)
    }
    w
}

// UTF-16 (zero-ended) as UTF-8, malloc'd
fn utf8Of(w: Int) -> Int {
    let n = wideCharToMultiByte(utf8, 0, w, -1, 0, 0, 0, 0)
    let s = calloc(if n > 0 { n } else { 1 }, 1)
    if n > 0 {
        let _ = wideCharToMultiByte(utf8, 0, w, -1, s, n, 0, 0)
    }
    s
}

fn wideLen(w: Int) -> Int {
    var n = 0
    while Pointer<UInt16>(w)[n] != 0 {
        n += 1
    }
    n
}

// ---- the context, the output, numbers ----
pub extern effect fn osCtxImpl() -> Int64 as "qkosCtx" = tlsGetValue(word(cell(), 1))

pub extern effect fn osSetCtxImpl(c: Int64) as "qkosSetCtx" {
    let _ = tlsSetValue(word(cell(), 1), c)
}

fn writeAll(h: Int, p: Int, n: Int) {
    let done = calloc(1, 8)
    var at = 0
    while at < n {
        if winWriteFile(h, p + at, n - at, done, 0) == 0 or int32At(done, 0) == 0 {
            break
        }
        at += int32At(done, 0)
    }
    free(done)
}

// the output's bytes as they are; the errors' as C's stderr writes them (a text stream: \n made \r\n)
pub extern effect fn osWriteImpl(fd: Int64, p: Int64, n: Int64) as "qkosWrite" {
    if fd != 2 {
        writeAll(getStdHandle(-11), p, n)
        return
    }
    let h = getStdHandle(-12)
    var from = 0
    for i in 0..n {
        if byte(p, i) == '\n' {
            writeAll(h, p + from, i - from)
            writeAll(h, textAt("\r\n"), 2)
            from = i + 1
        }
    }
    writeAll(h, p + from, n - from)
}

// errno: C's numbers (POSIX's), in the runtime's cell (one for the process: it is read right after it is set)
pub extern effect fn osErrnoImpl() -> Int64 as "qkosErrno" = word(cell(), 2)

pub extern effect fn osSetErrnoImpl(e: Int64) as "qkosSetErrno" = setWord(cell(), 2, e)

pub extern effect fn osNowImpl() -> Float64 as "qkosNow" {
    let q = calloc(2, 8)
    let _ = queryPerformanceFrequency(q)
    let _ = queryPerformanceCounter(q + 8)
    let t = toFloat(word(q, 1)) / toFloat(word(q, 0))
    free(q)
    t
}

pub extern effect fn osTimeImpl() -> Float64 as "qkosTime" {
    let q = calloc(1, 8)
    getSystemTimePreciseAsFileTime(q)
    let ticks = word(q, 0) - 116444736000000000 // 100 ns since 1601, made since 1970
    free(q)
    toFloat(ticks / 10000000) + toFloat(ticks % 10000000) * 0.0000001
}

// (code is loaded here: a program is never the runtime's own, as in WebAssembly)
pub extern effect fn osRunSlotsImpl(
    f: Int64,
    args: Int64,
    argCount: Int64,
    results: Int64,
    resultCount: Int64,
) -> Int64 as "qkosRunSlots" =
    f - f + args - args + argCount - argCount + results - results + resultCount - resultCount

pub extern effect fn osSleepImpl(ms: Int64) as "qkosSleep" = winSleep(ms)

// ---- files and folders ----
// GetLastError's numbers as errno's: ENOENT, EACCES, EEXIST, ENOTEMPTY, EINVAL, else EIO
fn errnoOf(e: Int) -> Int = if e == 2 or e == 3 or e == 15 or e == 161 {
    2
} else if e == 5 or e == 32 or e == 33 {
    13
} else if e == 80 or e == 183 {
    17
} else if e == 145 {
    41
} else if e == 87 or e == 123 {
    22
} else {
    5
}

// a FILE* here: the handle, an error seen, the end seen; "rb", "wb", "ab", "r+b", "w+b" as C opens them
pub extern effect fn osOpenImpl(path: Int64, mode: Int64) -> Int64 as "qkosOpen" {
    let m = byte(mode, 0)
    let plus = byte(mode, 1) == '+' or byte(mode, 2) == '+'
    let read = 2147483648
    let write = 1073741824
    let access = if m == 'r' {
        read | (if plus { write } else { 0 })
    } else if m == 'w' {
        write | (if plus { read } else { 0 })
    } else {
        4 | 1048576 | (if plus {
            read // FILE_APPEND_DATA | SYNCHRONIZE
        } else {
            0
        })
    }
    let how = if m == 'r' {
        3 // OPEN_EXISTING, CREATE_ALWAYS, OPEN_ALWAYS
    } else if m == 'w' {
        2
    } else {
        4
    }
    let w = wide(path)
    let h = createFileW(w, access, 7, 0, how, 128, 0)
    free(w)
    if h == -1 {
        setErrno(errnoOf(getLastError()))
        return 0
    }
    let f = calloc(3, 8)
    setWord(f, 0, h)
    f
}

pub extern effect fn winFread(p: Int64, size: UInt64, n: UInt64, f: Int64) -> UInt64 as "fread" {
    let total = size * n
    let got = calloc(1, 8)
    var at = 0
    while at < total {
        let chunk = if total - at > 1073741824 { 1073741824 } else { total - at }
        if winReadFile(word(f, 0), p + at, chunk, got, 0) == 0 {
            setWord(f, 1, 1)
            break
        }
        let k = int32At(got, 0)
        if k == 0 {
            setWord(f, 2, 1)
            break
        }
        at += k
    }
    free(got)
    if size > 0 { at / size } else { 0 }
}

pub extern effect fn winFwrite(p: Int64, size: UInt64, n: UInt64, f: Int64) -> UInt64 as "fwrite" {
    let total = size * n
    let done = calloc(1, 8)
    var at = 0
    while at < total {
        let chunk = if total - at > 1073741824 { 1073741824 } else { total - at }
        if winWriteFile(word(f, 0), p + at, chunk, done, 0) == 0 or int32At(done, 0) == 0 {
            setWord(f, 1, 1)
            break
        }
        at += int32At(done, 0)
    }
    free(done)
    if size > 0 { at / size } else { 0 }
}

pub extern effect fn winFclose(f: Int64) -> Int32 as "fclose" {
    let ok = closeHandle(word(f, 0))
    free(f)
    if ok != 0 { 0 } else { -1 }
}

pub extern effect fn winFerror(f: Int64) -> Int32 as "ferror" = word(f, 1)

pub extern effect fn winFflush(f: Int64) -> Int32 as "fflush" = f - f // (nothing kept: every write is the system's)

pub extern effect fn winFseek(f: Int64, offset: Int32, whence: Int32) -> Int32 as "fseek" = if setFilePointerEx(
    word(f, 0),
    offset,
    0,
    whence,
) != 0 {
    0
} else {
    -1
}

pub extern effect fn osEnvImpl(name: Int64) -> Int64 as "qkosEnv" {
    let w = wide(name)
    let n = getEnvironmentVariableW(w, 0, 0)
    if n == 0 {
        free(w)
        return 0
    }
    let v = calloc(n + 1, 2)
    let _ = getEnvironmentVariableW(w, v, n + 1)
    free(w)
    let s = utf8Of(v)
    free(v)
    s
}

// ---- the C library's functions the runtime calls, over kernel32 ----
pub extern effect fn winMalloc(size: UInt64) -> Int64 as "malloc" =
    heapAlloc(getProcessHeap(), 0, if size > 0 { size } else { 1 })

pub extern effect fn winCalloc(count: UInt64, size: UInt64) -> Int64 as "calloc" {
    let n = count * size
    heapAlloc(getProcessHeap(), 8, if n > 0 {
        n // HEAP_ZERO_MEMORY
    } else {
        1
    })
}

pub extern effect fn winRealloc(p: Int64, size: UInt64) -> Int64 as "realloc" = if p == 0 {
    winMalloc(size)
} else {
    heapReAlloc(getProcessHeap(), 0, p, if size > 0 { size } else { 1 })
}

pub extern effect fn winFree(p: Int64) as "free" {
    if p != 0 {
        let _ = heapFree(getProcessHeap(), 0, p)
    }
}

pub extern effect fn winExit(code: Int32) as "exit" = exitProcess(code)

pub extern fn winFloor(x: Float64) -> Float64 as "floor" = floor(x)

pub extern fn winFabs(x: Float64) -> Float64 as "fabs" = if x < 0.0 { -x } else { x }

// seconds since 1970 (C's time)
pub extern effect fn winTime(t: Int64) -> Int64 as "time" {
    let q = calloc(1, 8)
    getSystemTimeAsFileTime(q)
    let s = (word(q, 0) - 116444736000000000) / 10000000
    free(q)
    if t != 0 {
        setWord(t, 0, s)
    }
    s
}

pub extern effect fn winStrtoll(s: Int64, end: Int64, base: Int32) -> Int64 as "strtoll" {
    var i = 0
    while byte(s, i) == ' ' or byte(s, i) == '\t' {
        i += 1
    }
    var negative = false
    if byte(s, i) == '-' or byte(s, i) == '+' {
        negative = byte(s, i) == '-'
        i += 1
    }
    var v = 0
    while true {
        let c = byte(s, i)
        let d = if c >= '0' and c <= '9' {
            c - '0'
        } else if c >= 'a' and c <= 'z' {
            c - 'a' + 10
        } else if c >= 'A' and c <= 'Z' {
            c - 'A' + 10
        } else {
            99
        }
        if d >= base {
            break
        }
        v = v *% base +% d
        i += 1
    }
    if end != 0 {
        setWord(end, 0, s + i)
    }
    if negative { 0 -% v } else { v }
}

// errno's numbers said as C's strerror says them
pub extern effect fn winStrerror(code: Int32) -> Int64 as "strerror" = textAt(match code {
    2 => "No such file or directory\0"
    5 => "Input/output error\0"
    9 => "Bad file descriptor\0"
    12 => "Not enough space\0"
    13 => "Permission denied\0"
    17 => "File exists\0"
    20 => "Not a directory\0"
    21 => "Is a directory\0"
    22 => "Invalid argument\0"
    28 => "No space left on device\0"
    41 => "Directory not empty\0"
    _ => "Unknown error\0"
})

pub extern effect fn osPathKindImpl(path: Int64) -> Int64 as "qkosPathKind" {
    let w = wide(path)
    let a = getFileAttributesW(w)
    free(w)
    if a == 4294967295 {
        -1
    } else if a & 16 != 0 {
        1
    } else {
        0
    }
}

fn setErrno(code: Int) = setWord(cell(), 2, code)

pub extern effect fn osMakeDirImpl(path: Int64) -> Int64 as "qkosMakeDir" {
    let w = wide(path)
    let done = createDirectoryW(w, 0)
    free(w)
    if done != 0 {
        return 0
    }
    let e = getLastError() // as errno says it: EEXIST, ENOENT, EACCES, else EIO
    setErrno(if e == 183 {
        17
    } else if e == 3 or e == 2 {
        2
    } else if e == 5 {
        13
    } else {
        5
    })
    -1
}

pub extern effect fn osRemoveImpl(path: Int64, folder: Int64) -> Int64 as "qkosRemove" {
    let w = wide(path)
    let done = if folder == 1 { removeDirectoryW(w) } else { deleteFileW(w) }
    free(w)
    if done != 0 {
        return 0
    }
    let e = getLastError() // ENOTEMPTY, EACCES, else EIO
    setErrno(if e == 145 {
        41
    } else if e == 5 or e == 32 {
        13
    } else {
        5
    })
    -1
}

pub extern effect fn osSeparatorImpl(c: Int64) -> Int64 as "qkosSeparator" =
    if c == '/' or c == '\\' { 1 } else { 0 }

// the names in a folder: each zero-ended, then a zero (malloc'd); 0 when it cannot be listed
pub extern effect fn osListDirImpl(path: Int64) -> Int64 as "qkosListDir" {
    let n = strlen(path)
    let pattern = calloc(n + 3, 1)
    copyBytes(pattern, path, n)
    setByte(pattern, n, '\\')
    setByte(pattern, n + 1, '*')
    let w = wide(pattern)
    free(pattern)
    let fd = calloc(1, 600)
    let h = findFirstFileW(w, fd)
    free(w)
    if h == -1 {
        free(fd)
        setErrno(2)
        return 0
    }
    var cap = 1024
    var out = malloc(cap)
    var used = 0
    while true {
        let name = fd + 44
        let dot = Pointer<UInt16>(name)
        let skip = dot[0] == '.' and dot[1] == 0 or dot[0] == '.' and dot[1] == '.' and dot[2] == 0
        if not skip {
            let s = utf8Of(name)
            let k = strlen(s)
            while used + k + 2 > cap {
                cap *= 2
                out = realloc(out, cap)
            }
            copyBytes(out + used, s, k + 1)
            used += k + 1
            free(s)
        }
        if findNextFileW(h, fd) == 0 {
            break
        }
    }
    let _ = findClose(h)
    free(fd)
    setByte(out, used, 0)
    out
}

// ---- the input ----
pub extern effect fn osReadInImpl(p: Int64, n: Int64) -> Int64 as "qkosReadIn" {
    let got = calloc(1, 8)
    let ok = winReadFile(getStdHandle(-10), p, n, got, 0)
    let k = int32At(got, 0)
    free(got)
    if ok != 0 { k } else { 0 }
}

// a line typed at a console: its characters as UTF-16 (the console's code page may not have them)
pub extern effect fn osReadLineImpl(out: Int64) -> Int64 as "qkosReadLine" {
    let console = getStdHandle(-10)
    let mode = calloc(1, 16)
    if getConsoleMode(console, mode) == 0 {
        free(mode)
        return -1
    }
    var cap = 256
    var w = malloc(2 * cap)
    var n = 0
    var any = false
    while readConsoleW(console, mode + 8, 1, mode, 0) != 0 and int32At(mode, 0) != 0 {
        let ch = Pointer<UInt16>(mode + 8)[0]
        if ch == 26 and n == 0 {
            // Ctrl+Z first: the end
            break
        }
        any = true
        if ch == '\n' {
            break
        }
        if ch != '\r' {
            if n + 2 > cap {
                cap *= 2
                w = realloc(w, 2 * cap)
            }
            Pointer<UInt16>(w)[n] = ch
            n += 1
        }
    }
    free(mode)
    if not any {
        free(w)
        return 0
    }
    Pointer<UInt16>(w)[n] = 0
    let s = utf8Of(w)
    free(w)
    setWord(out, 0, s)
    setWord(out, 1, strlen(s))
    1
}

// ---- other programs ----
type Line { p: Int, n: Int, cap: Int }

fn Line.add(self, c: Int) -> Line {
    var l = self
    if l.n + 1 > l.cap {
        l = Line(realloc(l.p, 2 * l.cap), l.n, 2 * l.cap)
    }
    setByte(l.p, l.n, c)
    Line(l.p, l.n + 1, l.cap)
}

// one argument on a command line, as the C runtime's parser reads it back
fn Line.quoted(self, s: Int, n: Int) -> Line {
    var plain = n > 0
    for i in 0..n {
        let c = byte(s, i)
        if c == ' ' or c == '\t' or c == '"' or c == '\n' or c == 11 {
            plain = false
        }
    }
    var l = self
    if plain {
        for i in 0..n {
            l = l.add(byte(s, i))
        }
        return l
    }
    l = l.add('"')
    var i = 0
    while true {
        var slashes = 0
        while i < n and byte(s, i) == '\\' {
            i += 1
            slashes += 1
        }
        if i == n {
            for k in 0..slashes * 2 {
                l = l.add('\\')
            }
            break
        }
        let times = if byte(s, i) == '"' { slashes * 2 + 1 } else { slashes }
        for k in 0..times {
            l = l.add('\\')
        }
        l = l.add(byte(s, i))
        i += 1
    }
    l.add('"')
}

// what a pipe gives until its end: (handle, bytes, length, room)
fn drain(r: Int) -> Int {
    let chunk = malloc(16384)
    let got = calloc(1, 8)
    while winReadFile(word(r, 0), chunk, 16384, got, 0) != 0 and int32At(got, 0) != 0 {
        let k = int32At(got, 0)
        while word(r, 2) + k > word(r, 3) {
            setWord(r, 3, word(r, 3) * 2)
            setWord(r, 1, realloc(word(r, 1), word(r, 3)))
        }
        copyBytes(word(r, 1) + word(r, 2), chunk, k)
        setWord(r, 2, word(r, 2) + k)
    }
    free(chunk)
    free(got)
    0
}

fn cannotRun(out: Int, name: Int, e: Int) -> Int {
    let why = calloc(1, 300)
    let _ = formatMessageA(4096 | 512, 0, e, 0, why, 300, 0)
    var k = strlen(why)
    while k > 0
        and (byte(why, k - 1) == '\r' or byte(why, k - 1) == '\n' or byte(why, k - 1) == '.' or byte(why, k - 1) == ' ') {
        k -= 1
        setByte(why, k, 0)
    }
    let m = malloc(700)
    var b = bufAt(m, 700).text("cannot run ").zeroText(name).text(": ")
    b = if k == 0 { b.text("error ").int(e) } else { b.zeroText(why) }
    free(why)
    setWord(out, 1, m)
    1
}

fn pipeRecord(h: Int) -> Int {
    let r = calloc(4, 8)
    setWord(r, 0, h)
    setWord(r, 1, malloc(4096))
    setWord(r, 3, 4096)
    r
}

// runs name with args ((bytes, length) pairs) and an empty input: 0 and (status, out, its length, err, its length)
// in out; 1 and the message (malloc'd) in out[1] when it cannot be started
pub extern effect fn osRunProcessImpl(name: Int64, args: Int64, count: Int64, out: Int64) -> Int64 as "qkosRunProcess" {
    let n = strlen(name)
    for i in 0..n {
        if byte(name, i) == '/' {
            setByte(name, i, '\\') // CreateProcess finds build\quark.exe, not build/quark.exe
        }
    }
    var line = Line(malloc(256), 0, 256).quoted(name, n)
    for i in 0..count {
        line = line.add(' ').quoted(word(args, 2 * i), word(args, 2 * i + 1))
    }
    let wline = wideOf(line.p, line.n)
    free(line.p)
    let sa = calloc(1, 24) // SECURITY_ATTRIBUTES: its size, no descriptor, inherited
    setInt32(sa, 0, 24)
    setInt32(sa, 4, 1)
    let hs = calloc(4, 8) // outRead, outWrite, errRead, errWrite
    if createPipe(hs, hs + 8, sa, 0) == 0 {
        free(wline)
        return cannotRun(out, name, getLastError())
    }
    if createPipe(hs + 16, hs + 24, sa, 0) == 0 {
        let e = getLastError()
        let _ = closeHandle(word(hs, 0))
        let _ = closeHandle(word(hs, 1))
        free(wline)
        return cannotRun(out, name, e)
    }
    let _ = setHandleInformation(word(hs, 0), 1, 0)
    let _ = setHandleInformation(word(hs, 2), 1, 0)
    let input = createFileA(textAt("NUL\0"), 2147483648, 3, sa, 3, 0, 0)
    let si = calloc(1, 104) // STARTUPINFOW
    setInt32(si, 0, 104)
    setInt32(si, 15, 256) // dwFlags (at 60): STARTF_USESTDHANDLES
    setWord(si, 10, input) // hStdInput at 80
    setWord(si, 11, word(hs, 1))
    setWord(si, 12, word(hs, 3))
    let pi = calloc(1, 24)
    let started = createProcessW(0, wline, 0, 0, 1, 0, 0, 0, si, pi)
    let startError = getLastError()
    free(wline)
    let _ = closeHandle(word(hs, 1))
    let _ = closeHandle(word(hs, 3))
    if input != -1 {
        let _ = closeHandle(input)
    }
    if started == 0 {
        let _ = closeHandle(word(hs, 0))
        let _ = closeHandle(word(hs, 2))
        return cannotRun(out, name, startError)
    }
    let errPipe = pipeRecord(word(hs, 2))
    let outPipe = pipeRecord(word(hs, 0))
    let t = createThread(0, 0, fnAddress(r => drain(r)), errPipe, 0, 0)
    let _ = drain(outPipe)
    if t != 0 {
        let _ = waitForSingleObject(t, 4294967295)
        let _ = closeHandle(t)
    } else {
        let _ = drain(errPipe) // no thread: the errors after the output
    }
    let _ = waitForSingleObject(word(pi, 0), 4294967295)
    let code = calloc(1, 8)
    let _ = getExitCodeProcess(word(pi, 0), code)
    let _ = closeHandle(word(pi, 0))
    let _ = closeHandle(word(pi, 1))
    let _ = closeHandle(word(hs, 0))
    let _ = closeHandle(word(hs, 2))
    setWord(out, 0, int32At(code, 0))
    setWord(out, 1, word(outPipe, 1))
    setWord(out, 2, word(outPipe, 2))
    setWord(out, 3, word(errPipe, 1))
    setWord(out, 4, word(errPipe, 2))
    free(code)
    free(outPipe)
    free(errPipe)
    free(hs)
    free(sa)
    free(si)
    free(pi)
    0
}

// ---- code in memory, the stack, C's libraries, threads ----
pub extern effect fn osMapCodeImpl(n: Int64) -> Int64 as "qkosMapCode" =
    virtualAlloc(0, n, 12288, 4)

pub extern effect fn osProtectCodeImpl(p: Int64, n: Int64) as "qkosProtectCode" {
    let old = calloc(1, 8)
    let _ = virtualProtect(p, n, 32, old)
    free(old)
    let _ = flushInstructionCache(getCurrentProcess(), p, n)
}

pub extern effect fn osUnmapCodeImpl(p: Int64, n: Int64) as "qkosUnmapCode" {
    let _ = virtualFree(p, 0, 32768) + n - n
}

// the heap's range (heap.qk): reserved (MEM_RESERVE, no access), committed as it is used (MEM_COMMIT, read and write)
pub extern effect fn osReserveImpl(n: Int64) -> Int64 as "qkosReserve" = virtualAlloc(0, n, 8192, 1)

// addresses at p (64 KB aligned), when they are free: p, else 0
pub extern effect fn osReserveAtImpl(p: Int64, n: Int64) -> Int64 as "qkosReserveAt" =
    virtualAlloc(p, n, 8192, 1)

pub extern effect fn osCommitImpl(p: Int64, n: Int64) -> Int64 as "qkosCommit" =
    if virtualAlloc(p, n, 4096, 4) != 0 { 1 } else { 0 }

pub extern effect fn osReleaseImpl(p: Int64, n: Int64) as "qkosRelease" {
    let _ = virtualFree(p, 0, 32768) + n - n
}

// a task's stack: 8 MB (the heap commits all of it at once)
pub extern effect fn osTaskStackImpl() -> Int64 as "qkosTaskStack" = 8388608

pub extern effect fn osStackLowImpl() -> Int64 as "qkosStackLow" {
    let lh = calloc(2, 8)
    getCurrentThreadStackLimits(lh, lh + 8)
    let low = word(lh, 0)
    free(lh)
    low
}

fn hasAny(s: Int, a: Int, b: Int, c: Int) -> Bool {
    let n = strlen(s)
    for i in 0..n {
        let x = byte(s, i)
        if x == a or x == b or x == c {
            return true
        }
    }
    false
}

fn isText(s: Int, t: Text) -> Bool = strlen(s) == len(t) and sameBytes(s, textAt(t), len(t))

pub extern effect fn osCFunctionImpl(symbol: Int64, lib: Int64, why: Int64) -> Int64 as "qkosCFunction" {
    if lib == 0 or isText(lib, "c") or isText(lib, "m") {
        // the C runtime: the universal one, else the old one
        let ucrt = loadLibraryW(wide(textAt("ucrtbase.dll\0")))
        let f = if ucrt != 0 { getProcAddress(ucrt, symbol) } else { 0 }
        if f != 0 {
            return f
        }
        let old = loadLibraryW(wide(textAt("msvcrt.dll\0")))
        let g = if old != 0 { getProcAddress(old, symbol) } else { 0 }
        if g != 0 {
            return g
        }
        let _ = bufAt(why, 512).text("cannot find ").zeroText(symbol).text(
            " in the C library (ucrtbase.dll, msvcrt.dll)",
        )
        return 0
    }
    let path = hasAny(lib, '.', '/', '\\')
    var h = 0
    let name = calloc(1, 1024)
    for attempt in 0..(if path {
        1 // m.dll, then libm.dll (as MinGW names them)
    } else {
        2
    }) {
        if h == 0 {
            let b = bufAt(name, 1024)
            let _ = if path {
                b.zeroText(lib)
            } else if attempt == 1 {
                b.text("lib").zeroText(lib).text(".dll")
            } else {
                b.zeroText(lib).text(".dll")
            }
            let w = wide(name)
            h = loadLibraryW(w)
            free(w)
        }
    }
    free(name)
    if h == 0 {
        let b = bufAt(why, 512).text("cannot load the library ").zeroText(lib).text(" (").zeroText(lib)
        let _ = if path { b.text(")") } else { b.text(".dll)") }
        return 0
    }
    let f = getProcAddress(h, symbol)
    if f == 0 {
        let _ = bufAt(why, 512).text("cannot find ").zeroText(symbol).text(" in the library ").zeroText(lib)
    }
    f
}

pub extern effect fn osProcessorsImpl() -> Int64 as "qkosProcessors" {
    let info = calloc(1, 64)
    getSystemInfo(info)
    let n = int32At(info, 8) // dwNumberOfProcessors, at 32
    free(info)
    n
}

pub extern effect fn osThreadStartImpl(f: Int64, arg: Int64) -> Int64 as "qkosThreadStart" =
    createThread(0, 67108864, f, arg, 65536, 0) // 64 MB of stack, reserved

pub extern effect fn osThreadJoinImpl(h: Int64) as "qkosThreadJoin" {
    let _ = waitForSingleObject(h, 4294967295)
    let _ = closeHandle(h)
}

// ---- the executable's entry: the arguments as Windows has them (UTF-16), made UTF-8 ----
pub extern effect fn wmain(argc: Int32, argv: Int64) -> Int32 as "wmain" {
    setWord(cell(), 1, tlsAlloc())
    setWord(cell(), 2, 0) // errno
    setWord(cell(), 3, 0) // Winsock, not loaded yet (the cell is a literal's bytes until its words are set)
    let _ = setConsoleOutputCP(utf8)
    let args = calloc(argc + 1, 8)
    for i in 0..argc {
        setWord(args, i, utf8Of(word(argv, i)))
    }
    let w = calloc(32768, 2)
    let n = getModuleFileNameW(0, w, 32768)
    let self = if n != 0 and n < 32768 { utf8Of(w) } else { 0 }
    free(w)
    qkStart(argc, args, self)
}

// ---- an executable with no C start (compiler/image.qk writes the PE): its entry point, the command line read here ----
extern effect fn exitProcess(code: UInt32) as "ExitProcess"

pub extern effect fn winEntry() -> Int32 as "qkWinEntry" {
    let count = calloc(1, 8)
    let argv = argvOf(getCommandLineW(), count)
    exitProcess(wmain(int32At(count, 0), argv))
    0
}

// The command line's arguments as Windows' C programs read them (CommandLineToArgvW's rules): the program's name up to
// a space, or within quotes; then arguments between spaces, where quotes group, 2n backslashes and a quote are n
// backslashes and the quote's meaning, 2n + 1 of them n and a quote, other backslashes themselves, and "" inside quotes
// a quote. Each argument UTF-16 and zero-ended, malloc'd; their count in count.
fn argvOf(line: Int, count: Int) -> Int {
    var n = 0
    while unitAt(line, n) != 0 {
        n += 1
    }
    var argv = calloc(n / 2 + 2, 8)
    var argc = 0
    let buf = calloc(n + 1, 2)
    var i = 0
    // the program's name
    var k = 0
    if unitAt(line, 0) == '"' {
        i = 1
        while unitAt(line, i) != 0 and unitAt(line, i) != '"' {
            Pointer<UInt16>(buf)[k] = unitAt(line, i)
            k += 1
            i += 1
        }
        if unitAt(line, i) == '"' {
            i += 1
        }
    } else {
        while unitAt(line, i) != 0 and unitAt(line, i) != ' ' and unitAt(line, i) != '\t' {
            Pointer<UInt16>(buf)[k] = unitAt(line, i)
            k += 1
            i += 1
        }
    }
    setWord(argv, argc, wideCopy(buf, k))
    argc += 1
    while true {
        while unitAt(line, i) == ' ' or unitAt(line, i) == '\t' {
            i += 1
        }
        if unitAt(line, i) == 0 {
            break
        }
        k = 0
        var quoted = false
        while unitAt(line, i) != 0 and (quoted or unitAt(line, i) != ' ' and unitAt(line, i) != '\t') {
            if unitAt(line, i) == '\\' {
                var slashes = 0
                while unitAt(line, i) == '\\' {
                    slashes += 1
                    i += 1
                }
                if unitAt(line, i) == '"' {
                    for _ in 0..slashes / 2 {
                        Pointer<UInt16>(buf)[k] = '\\'
                        k += 1
                    }
                    if slashes % 2 == 1 {
                        Pointer<UInt16>(buf)[k] = '"'
                        k += 1
                        i += 1
                    }
                } else {
                    for _ in 0..slashes {
                        Pointer<UInt16>(buf)[k] = '\\'
                        k += 1
                    }
                }
            } else if unitAt(line, i) == '"' {
                if quoted and unitAt(line, i + 1) == '"' {
                    Pointer<UInt16>(buf)[k] = '"'
                    k += 1
                    i += 2
                } else {
                    quoted = not quoted
                    i += 1
                }
            } else {
                Pointer<UInt16>(buf)[k] = unitAt(line, i)
                k += 1
                i += 1
            }
        }
        setWord(argv, argc, wideCopy(buf, k))
        argc += 1
    }
    free(buf)
    setInt32(count, 0, argc)
    argv
}

// the i-th UTF-16 unit at w (no closure: this runs before the runtime has its context)
fn unitAt(w: Int, i: Int) -> Int = Pointer<UInt16>(w)[i]

// k UTF-16 units of buf, zero-ended, malloc'd
fn wideCopy(buf: Int, k: Int) -> Int {
    let w = calloc(k + 1, 2)
    copyBytes(w, buf, 2 * k)
    w
}

// ---- a program run from memory (quarkimg run): the runtime mapped by the caller, the arguments UTF-8 already ----
pub extern effect fn memoryMain(argc: Int64, argv: Int64, payload: Int64, trailer: Int64) -> Int64 as "qkMemoryMain" {
    setWord(cell(), 1, tlsAlloc())
    setWord(cell(), 2, 0) // errno
    setWord(cell(), 3, 0) // Winsock, not loaded yet (the cell is a literal's bytes until its words are set)
    let _ = setConsoleOutputCP(utf8)
    qkStartMemory(argc, argv, payload, trailer)
}

// ---- the command line's own runs (host.qk, compiler/memory.qk): this thread made ready for the runtime ----
pub extern effect fn hostInit() as "qkosHostInit" {
    setWord(cell(), 1, tlsAlloc())
    setWord(cell(), 2, 0) // errno
    setWord(cell(), 3, 0) // Winsock, not loaded yet (the cell is a literal's bytes until its words are set)
    let _ = setConsoleOutputCP(utf8)
}

// ---- --profile: another thread stops this one every millisecond and reads where it is ----
extern effect fn getCurrentThread() -> Int64 as "GetCurrentThread"

extern effect fn duplicateHandle(
    fromProcess: Int64,
    h: Int64,
    toProcess: Int64,
    to: Int64,
    access: UInt32,
    inherit: Int32,
    options: UInt32,
) -> Int32 as "DuplicateHandle"

extern effect fn suspendThread(h: Int64) -> UInt32 as "SuspendThread"
extern effect fn resumeThread(h: Int64) -> UInt32 as "ResumeThread"
extern effect fn getThreadContext(h: Int64, context: Int64) -> Int32 as "GetThreadContext"
extern effect fn timeBeginPeriod(ms: UInt32) -> UInt32 as "timeBeginPeriod"
extern effect fn createWaitableTimerExW(security: Int64, name: Int64, flags: UInt32, access: UInt32) -> Int64 as "CreateWaitableTimerExW"
extern effect fn setWaitableTimer(h: Int64, due: Int64, period: Int32, f: Int64, arg: Int64, resume: Int32) -> Int32 as "SetWaitableTimer"
extern effect fn timeEndPeriod(ms: UInt32) -> UInt32 as "timeEndPeriod"

// p's words (host.qk): on, the sampled thread, the sampling one, the samples, their count, their room
fn sampler(p: Int) -> Int {
    let raw = calloc(1, 1248)
    let context = (raw + 15) & -16 // a CONTEXT: 16-aligned
    // x86-64 (its functions start with push rbp): ContextFlags at byte 48, Rip at 248; ARM64: at 0, Pc at 264
    let x64 = byte(fnAddress(x => sampler(x)), 0) == 85
    let _ = timeBeginPeriod(1)
    // a high-resolution timer: Windows 11 lets a process with no window sleep no less than its 15.6 ms tick
    let timer = createWaitableTimerExW(0, 0, 2, 2031619) // CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS
    let due = calloc(1, 8)
    setWord(due, 0, -10000) // a millisecond from now, in 100 ns
    while word(p, 0) != 0 {
        if timer != 0 and setWaitableTimer(timer, due, 0, 0, 0, 0) != 0 {
            let _ = waitForSingleObject(timer, 4294967295)
        } else {
            winSleep(1)
        }
        if suspendThread(word(p, 1)) == 4294967295 {
            continue
        }
        // CONTEXT_CONTROL | CONTEXT_INTEGER of CONTEXT_AMD64 (Rbp is an integer register), or CONTEXT_CONTROL of
        // CONTEXT_ARM64 (Fp is a control one)
        setInt32(context, if x64 { 12 } else { 0 }, if x64 { 1048579 } else { 4194305 })
        if getThreadContext(word(p, 1), context) != 0 and word(p, 4) < word(p, 5) {
            let s = word(p, 3) + 8 * sampleWords * word(p, 4)
            setWord(s, 0, word(context, if x64 {
                31 // Rip, Pc
            } else {
                33
            }))
            // the frames above: rbp / x29 holds the saved one, then the return address
            var fp = word(context, if x64 { 20 } else { 30 })
            for j in 1..sampleWords {
                if fp < word(p, 6) or fp >= word(p, 7) - 16 or fp & 7 != 0 {
                    break
                }
                setWord(s, j, word(fp, 1))
                let next = word(fp, 0)
                fp = if next > fp { next } else { 0 }
            }
            setWord(p, 4, word(p, 4) + 1)
        }
        let _ = resumeThread(word(p, 1))
    }
    let _ = timeEndPeriod(1)
    if timer != 0 {
        let _ = closeHandle(timer)
    }
    free(due)
    free(raw)
    0
}

pub extern effect fn osProfileStartImpl(p: Int64) as "qkosProfileStart" {
    getCurrentThreadStackLimits(p + 48, p + 56) // the sampled thread's own: where its frames can be
    let h = calloc(1, 8)
    let _ = duplicateHandle(getCurrentProcess(), getCurrentThread(), getCurrentProcess(), h, 0, 0, 2) // the same access
    setWord(p, 1, word(h, 0))
    free(h)
    setWord(p, 2, createThread(0, 0, fnAddress(x => sampler(x)), p, 0, 0))
}

pub extern effect fn osProfileStopImpl(p: Int64) as "qkosProfileStop" {
    if word(p, 2) != 0 {
        let _ = waitForSingleObject(word(p, 2), 4294967295)
        let _ = closeHandle(word(p, 2))
    }
    let _ = closeHandle(word(p, 1))
}

// ---- sockets (ws2_32: Winsock), seeking, the local time ----
// Winsock, loaded the first time a socket is used (programs without sockets depend on kernel32 alone): each function
// found by its name in ws2_32.dll, then called through its address
fn winsock() -> Int {
    let have = word(cell(), 3)
    if have != 0 {
        return have
    }
    let w = wide(textAt("ws2_32.dll\0"))
    let m = loadLibraryW(w)
    free(w)
    setWord(cell(), 3, m)
    m
}

extern effect fn findWsaStartup(m: Int64, name: Int64) -> (extern (UInt16, Int64) -> Int32)? as "GetProcAddress"

fn wsaStartup(version: Int, data: Int) -> Int = match findWsaStartup(winsock(), textAt("WSAStartup\0")) {
    Some(f) => f(version, data)
    None => -1
}

