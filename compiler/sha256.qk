// SHA-256 (FIPS 180-4): packages' content hashes (package.qk), Mach-O executables' code signatures (image.qk).
// ---- the rounds ---------------------------------------------------------------------------------------------------
const shaK: [Int] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98,
    0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
    0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8,
    0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819,
    0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
    0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7,
    0xc67178f2,
]

fn rotr(x: Int, n: Int) -> Int = (x >> n | x << (32 - n)) & 0xffffffff

fn hex8(x: Int) -> Text {
    let digits = "0123456789abcdef"
    var out = ""
    var shift = 28
    while shift >= 0 {
        let d = x >> shift & 15
        out += digits[d..d + 1]
        shift -= 4
    }
    out
}

// the SHA-256 of the bytes, in hex
pub fn sha256(data: Bytes) -> Text {
    var out = ""
    for x in sha256Words(data) {
        out += hex8(x)
    }
    out
}

// the SHA-256 of the bytes, as its 32 bytes (a code signature's page hashes)
pub fn sha256Bytes(data: Bytes) -> Bytes {
    var out: Bytes = []
    for x in sha256Words(data) {
        out += [x >> 24 & 255, x >> 16 & 255, x >> 8 & 255, x & 255]
    }
    out
}

// its eight 32-bit words
fn sha256Words(data: Bytes) -> [Int] {
    var m: Bytes = data
    m.push(0x80)
    while len(m) % 64 != 56 {
        m.push(0)
    }
    let bits = len(data) * 8
    var s = 56
    while s >= 0 {
        m.push(bits >> s & 255)
        s -= 8
    }
    var h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    var w = [0] * 64
    var at = 0
    while at < len(m) {
        for i in 0..16 {
            w[i] = m[at + 4 * i] << 24 | m[at + 4 * i + 1] << 16 | m[at + 4 * i + 2] << 8 | m[at + 4 * i + 3]
        }
        for i in 16..64 {
            let s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ w[i - 15] >> 3
            let s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ w[i - 2] >> 10
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & 0xffffffff
        }
        var a = h[0]
        var b = h[1]
        var c = h[2]
        var d = h[3]
        var e = h[4]
        var f = h[5]
        var g = h[6]
        var hh = h[7]
        for i in 0..64 {
            let t1 = (hh + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + (e & f ^ (e ^ 0xffffffff) & g) + shaK[i] + w[i]) & 0xffffffff
            let t2 = (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22) + (a & b ^ a & c ^ b & c)) & 0xffffffff
            hh = g
            g = f
            f = e
            e = (d + t1) & 0xffffffff
            d = c
            c = b
            b = a
            a = (t1 + t2) & 0xffffffff
        }
        h[0] = (h[0] + a) & 0xffffffff
        h[1] = (h[1] + b) & 0xffffffff
        h[2] = (h[2] + c) & 0xffffffff
        h[3] = (h[3] + d) & 0xffffffff
        h[4] = (h[4] + e) & 0xffffffff
        h[5] = (h[5] + f) & 0xffffffff
        h[6] = (h[6] + g) & 0xffffffff
        h[7] = (h[7] + hh) & 0xffffffff
        at += 64
    }
    h
}
