// Sources and errors: a file's text, and what is wrong with it, said as the command line says it.
pub type Source { path: Text, text: Text }

// The errors said, in order, each as it is printed (without its last line break): "path:line:col: message", then
// the line itself and a caret under the column. One said again since the program's text was read (said) is not shown twice.
pub type Errors { shown: [Text] = [], said: Set<Text> = [], count: Int = 0 }

pub fn Errors.add(var self, src: Source, line: Int, col: Int, message: Text) {
    self.count += 1
    let path = if src.path == "" { "quark" } else { src.path }
    let head = "{path}:{line}:{col}: {cut(message, 1023)}"
    if self.said.contains(head) {
        return
    }
    if len(self.said) < 256 {
        self.said.add(head)
    }
    self.shown.push(if line > 0 { head + "\n" + caret(src.text, line, col) } else { head })
}

// a new program's text: errors said before may be said again
pub fn Errors.forget(var self) {
    self.said = []
}

// the line, and a caret under the column (tabs kept, so it lines up)
fn caret(text: Text, line: Int, col: Int) -> Text {
    let b = text.bytes()
    var p = 0
    var l = 1
    while l < line and p < len(b) {
        if b[p] == '\n' {
            l += 1
        }
        p += 1
    }
    var stop = p
    while stop < len(b) and b[stop] != '\n' and b[stop] != '\r' {
        stop += 1
    }
    var pad = ""
    var i = 1
    while i < col and p + i - 1 < stop {
        pad += if b[p + i - 1] == '\t' { "\t" } else { " " }
        i += 1
    }
    "  {text[p..stop]}\n  {pad}^"
}

// at most n bytes of t, as C's fixed buffers keep them (never cutting a character in two)
pub fn cut(t: Text, n: Int) -> Text {
    if len(t) <= n {
        return t
    }
    let b = t.bytes()
    var end = n
    while end > 0 and b[end] >= 0x80 and b[end] < 0xc0 {
        end -= 1
    }
    t[..end]
}
