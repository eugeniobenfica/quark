}

extern effect fn findWsListen(m: Int64, name: Int64) -> (extern (Int64, Int32) -> Int32)? as "GetProcAddress"

fn wsListen(s: Int, backlog: Int) -> Int = match findWsListen(winsock(), textAt("listen\0")) {
    Some(f) => f(s, backlog)
    None => -1
