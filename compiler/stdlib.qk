        return r"""
""" + "\n"
    }
    if name == "debug" {
        return r"""
// The debugger's hooks: code compiled for debugging (quark debug, quark run --trace, quark dap) says where each
// function starts and ends, each statement's line and each name's value as print writes it. A built executable has
// no debugger (gDebug is 0: the hooks do nothing); the command line (compiler/memory.qk) makes one for its runs:
// - quark debug: stops at its breakpoints (or every line while stepping) and reads commands from the input, as
//   the debugger's;
// - --trace: every name's last value, by its graph key, written as JSON when the program ends;
// - quark dap: stops by giving the turn back (the program runs as a task of the debugger's, host.qk), and the
//   adapter reads the calls and their names from the state below.
use base
use print

extern effect fn osReadIn(p: Int64, n: Int64) -> Int64 as "qkosReadIn"
extern effect fn osOpen(path: Int64, mode: Int64) -> Int64 as "qkosOpen"
extern effect fn fwrite(p: Int64, size: UInt64, n: UInt64, f: Int64) -> UInt64
extern effect fn fclose(f: Int64) -> Int32
extern effect fn yieldNow() as "qk_yield"

// the debugger's words (gDebug)
pub const dInteractive = 0 // quark debug: commands from the input
pub const dStepping = 1 // stop at the next line
pub const dBreaks = 2 // lines (any file's), dBreakCount of them
pub const dBreakCount = 3
pub const dBreakCap = 4
pub const dFrames = 5 // the calls the program is in, main first: fWords each
pub const dFrameCount = 6
pub const dFrameCap = 7
pub const dTraced = 8 // --trace: every name's last value, by key (vWords each)
pub const dTracedCount = 9
pub const dTracedCap = 10
pub const dTracePath = 11 // zero-ended, or 0
pub const dRemote = 12 // quark dap: stops give the turn back to the task's stepper
pub const dStopLine = 13 // the line it stopped at
pub const dTask = 14 // the task the program runs as (quark dap)
pub const dWords = 16

// a call's words: its function's name (zero-ended), the line it is at, its names (vWords each)
pub const fFn = 0
pub const fLine = 1
pub const fVars = 2
pub const fVarCount = 3
pub const fVarCap = 4
pub const fWords = 5

// a name's words: the name, its graph key, its last value as print writes it (each zero-ended), how often it was set
pub const vName = 0
pub const vKey = 1
pub const vText = 2
pub const vHits = 3
pub const vWords = 4

fn state() -> Int = gGet(gDebug)

fn dup(p: Int, n: Int) -> Int {
    let s = malloc(n + 1)
    copyBytes(s, p, n)
    setByte(s, n, 0)
    s
}

// one more of size words at list (count and capacity in d's words at countAt, countAt + 1): its address
fn grow(d: Int, listAt: Int, countAt: Int, size: Int) -> Int {
    let n = word(d, countAt)
    if n == word(d, countAt + 1) {
        let cap = if n != 0 { n * 2 } else { 16 }
        setWord(d, listAt, realloc(word(d, listAt), 8 * size * cap))
        setWord(d, countAt + 1, cap)
    }
    setWord(d, countAt, n + 1)
    word(d, listAt) + 8 * size * n
}

fn setVar(owner: Int, listAt: Int, countAt: Int, name: Int, nn: Int, key: Int, kn: Int, text: Int, tn: Int) {
    let list = word(owner, listAt)
    for i in 0..word(owner, countAt) {
        let v = list + 8 * vWords * i
        let k = word(v, vKey)
        if strlen(k) == kn and sameBytes(k, key, kn) {
            free(word(v, vText))
            setWord(v, vText, dup(text, tn))
            setWord(v, vHits, word(v, vHits) + 1)
            return
        }
    }
    let v = grow(owner, listAt, countAt, vWords)
    setWord(v, vName, dup(name, nn))
    setWord(v, vKey, dup(key, kn))
    setWord(v, vText, dup(text, tn))
    setWord(v, vHits, 1)
}

fn top(d: Int) -> Int = if word(d, dFrameCount) > 0 {
    word(d, dFrames) + 8 * fWords * (word(d, dFrameCount) - 1)
} else {
    0
}

pub extern effect fn rtDebugEnter(name: Int64, n: Int64) as "qk_debugEnter" {
    let d = state()
    if d == 0 {
        return
    }
    let f = grow(d, dFrames, dFrameCount, fWords)
    setWord(f, fFn, dup(name, n))
    setWord(f, fLine, 0)
    setWord(f, fVars, 0)
    setWord(f, fVarCount, 0)
    setWord(f, fVarCap, 0)
}

pub extern effect fn rtDebugLeave() as "qk_debugLeave" {
    let d = state()
    let f = if d != 0 { top(d) } else { 0 }
    if f == 0 {
        return
    }
    for i in 0..word(f, fVarCount) {
        let v = word(f, fVars) + 8 * vWords * i
        free(word(v, vName))
        free(word(v, vKey))
        free(word(v, vText))
    }
    free(word(f, fVars))
    free(word(f, fFn))
    setWord(d, dFrameCount, word(d, dFrameCount) - 1)
}

// a stop: the calls are gone
pub extern effect fn debugUnwind() as "qkDebugUnwind" {
    let d = state()
    while d != 0 and word(d, dFrameCount) > 0 {
        rtDebugLeave()
    }
}

pub extern effect fn rtDebugValue(name: Int64, nn: Int64, key: Int64, kn: Int64, text: Int64, tn: Int64) as "qk_debugValue" {
    let d = state()
    if d == 0 {
        return
    }
    let shown = if tn > 300 {
        300 // a long array: its start
    } else {
        tn
    }
    let f = top(d)
    if f != 0 {
        setVar(f, fVars, fVarCount, name, nn, key, kn, text, shown)
    }
    if word(d, dTracePath) != 0 {
        setVar(d, dTraced, dTracedCount, name, nn, key, kn, text, shown)
    }
}

fn isBreak(d: Int, line: Int) -> Bool {
    for i in 0..word(d, dBreakCount) {
        if word(word(d, dBreaks), i) == line {
            return true
        }
    }
    false
}

pub fn addBreak(d: Int, line: Int) {
    let n = word(d, dBreakCount)
    if n == word(d, dBreakCap) {
        let cap = if n != 0 { n * 2 } else { 8 }
        setWord(d, dBreaks, realloc(word(d, dBreaks), 8 * cap))
        setWord(d, dBreakCap, cap)
    }
    setWord(word(d, dBreaks), n, line)
    setWord(d, dBreakCount, n + 1)
}

fn removeBreak(d: Int, line: Int) {
    var i = 0
    while i < word(d, dBreakCount) {
        if word(word(d, dBreaks), i) == line {
            let last = word(d, dBreakCount) - 1
            setWord(word(d, dBreaks), i, word(word(d, dBreaks), last))
            setWord(d, dBreakCount, last)
        } else {
            i += 1
        }
    }
}

// ---- quark debug: the commands ----
fn scratch() -> Buf = bufAt(word(state(), dWords - 1), 2048)

fn say(b: Buf) = osWrite(2, b.p, b.n)

fn showLocals(d: Int) {
    let f = top(d)
    if f == 0 {
        return
    }
    for i in 0..word(f, fVarCount) {
        let v = word(f, fVars) + 8 * vWords * i
        say(scratch().text("  ").zeroText(word(v, vName)).text(" = ").zeroText(word(v, vText)).text("\n"))
    }
    if word(f, fVarCount) == 0 {
        say(scratch().text("  (no names yet)\n"))
    }
}

// a line of the input (zero-ended, without its line break) into p (cap bytes); false at the input's end
fn readCommand(p: Int, cap: Int) -> Bool {
    var n = 0
    var any = false
    let c = calloc(1, 8)
    while osReadIn(c, 1) == 1 {
        any = true
        let ch = byte(c, 0)
        if ch == '\n' {
            break
        }
        if n < cap - 1 {
            setByte(p, n, ch)
            n += 1
        }
    }
    free(c)
    setByte(p, n, 0)
    any
}

fn isWord(p: Int, n: Int, w: Text) -> Bool = n == len(w) and sameBytes(p, textAt(w), n)

// quark test --coverage: a line of the program's file runs
pub const coverRoom = 1 << 20 // lines

pub extern effect fn rtCoverLine(line: Int64) as "qk_coverLine" {
    var map = gGet(gCover)
    if map == 0 {
        map = calloc(coverRoom, 1)
        gSet(gCover, map)
    }
    if line > 0 and line < coverRoom {
        setByte(map, line, 1)
    }
}

// a statement starts: stop when it is a breakpoint, or the debugger is stepping; then read commands
pub extern effect fn rtDebugLine(line: Int64) as "qk_debugLine" {
    let d = state()
    if d == 0 {
        return
    }
    let f = top(d)
    if f != 0 {
        setWord(f, fLine, line)
    }
    let stops = word(d, dStepping) != 0 or isBreak(d, line)
    if word(d, dRemote) != 0 {
        if stops and ctxGet(ctxTask) == word(d, dTask) {
            setWord(d, dStopLine, line)
            yieldNow() // back to the adapter, until it resumes
        }
        return
    }
    if word(d, dInteractive) == 0 or not stops {
        return
    }
    flush()
    let path = gGet(gRunPath)
    let head = scratch().text("stopped at ")
    let named = if path != 0 { head.zeroText(path) } else { head.text("program") }
    say(named.text(":").int(line).text(" in ").zeroText(if f != 0 { word(f, fFn) } else { textAt("?\0") }).text("\n"))
    showLocals(d)
    let cmd = calloc(1, 256)
    while true {
        say(scratch().text("(quark) "))
        if not readCommand(cmd, 256) {
            setWord(d, dInteractive, 0)
            free(cmd)
            return
        }
        var c = cmd
        while byte(c, 0) == ' ' {
            c += 1
        }
        var n = strlen(c)
        while n > 0 and byte(c, n - 1) is '\n' | '\r' | ' ' {
            n -= 1
            setByte(c, n, 0)
        }
        if isWord(c, n, "c") or isWord(c, n, "continue") {
            setWord(d, dStepping, 0)
            free(cmd)
            return
        }
        if isWord(c, n, "s") or isWord(c, n, "step") or isWord(c, n, "n") or n == 0 {
            setWord(d, dStepping, 1)
            free(cmd)
            return
        }
        let arg = n > 2 and byte(c, 1) == ' '
        if isWord(c, n, "l") or isWord(c, n, "locals") {
            showLocals(d)
        } else if isWord(c, n, "bt") or isWord(c, n, "where") {
            var i = word(d, dFrameCount) - 1
            while i >= 0 {
                let fr = word(d, dFrames) + 8 * fWords * i
                say(scratch().text("  ").zeroText(word(fr, fFn)).text(" at line ").int(word(fr, fLine)).text("\n"))
                i -= 1
            }
        } else if arg and byte(c, 0) == 'p' {
            let want = c + 2
            var found = false
            let fr = top(d)
            if fr != 0 {
                for i in 0..word(fr, fVarCount) {
                    let v = word(fr, fVars) + 8 * vWords * i
                    let name = word(v, vName)
                    if strlen(name) == strlen(want) and sameBytes(name, want, strlen(want)) {
                        say(scratch().text("  ").zeroText(want).text(" = ").zeroText(word(v, vText)).text("\n"))
                        found = true
                    }
                }
            }
            if not found {
                say(scratch().text("  ").zeroText(want).text(" has no value here yet\n"))
            }
        } else if arg and byte(c, 0) == 'b' {
            let at = strtoll(c + 2, 0, 10)
            addBreak(d, at)
            say(scratch().text("  a breakpoint at line ").int(at).text("\n"))
        } else if arg and byte(c, 0) == 'd' {
            removeBreak(d, strtoll(c + 2, 0, 10))
        } else if isWord(c, n, "q") or isWord(c, n, "quit") {
            flush()
            cExit(0)
        } else {
            say(scratch().text("  c continue, s step (or Enter), p name, l locals, bt calls, b LINE, d LINE, q quit\n"))
        }
    }
}

// ---- --trace: {"key": {"value": "...", "hits": n}}: what an editor shows on each node's wire ----
type Out { p: Int, n: Int, cap: Int }

fn Out.add(var self, p: Int, n: Int) {
    if self.n + n > self.cap {
        while self.n + n > self.cap {
            self.cap *= 2
        }
        self.p = realloc(self.p, self.cap)
    }
    copyBytes(self.p + self.n, p, n)
    self.n += n
}

fn Out.text(var self, t: Text) = self.add(textAt(t), len(t))

fn Out.json(var self, s: Int) {
    self.text("\"")
    let hex = textAt("0123456789abcdef")
    let one = calloc(1, 8)
    for i in 0..strlen(s) {
        let ch = byte(s, i)
        if ch == '"' or ch == '\\' {
            setByte(one, 0, '\\')
            setByte(one, 1, ch)
            self.add(one, 2)
        } else if ch == '\n' {
            self.text("\\n")
        } else if ch < 32 {
            self.text("\\u00")
            setByte(one, 0, byte(hex, ch >> 4))
            setByte(one, 1, byte(hex, ch & 15))
            self.add(one, 2)
        } else {
            self.add(s + i, 1)
        }
    }
    free(one)
    self.text("\"")
}

pub extern effect fn debugFinish() as "qkDebugFinish" {
    let d = state()
    if d == 0 or word(d, dTracePath) == 0 {
        return
    }
    let path = word(d, dTracePath)
    setWord(d, dTracePath, 0)
    let f = osOpen(path, textAt("wb\0"))
    if f == 0 {
        return
    }
    var out = Out(malloc(4096), 0, 4096)
    out.text("\{")
    for i in 0..word(d, dTracedCount) {
        let v = word(d, dTraced) + 8 * vWords * i
        out.text(if i != 0 { ",\n " } else { "\n " })
        out.json(word(v, vKey))
        out.text(": \{\"value\": ")
        out.json(word(v, vText))
        let b = scratch().text(", \"hits\": ").int(word(v, vHits)).text("\}")
        out.add(b.p, b.n)
    }
    out.text("\n\}\n")
    let _ = fwrite(out.p, 1, out.n, f)
    let _ = fclose(f)
    free(out.p)
}

// the debugger made (host.qk): its state, which the hooks find through gDebug
pub fn debugNew(interactive: Bool, tracePath: Int, remote: Bool) -> Int {
    let d = calloc(dWords, 8)
    setWord(d, dInteractive, if interactive { 1 } else { 0 })
    setWord(d, dStepping, if interactive { 1 } else { 0 })
    setWord(d, dTracePath, tracePath)
    setWord(d, dRemote, if remote { 1 } else { 0 })
    setWord(d, dWords - 1, malloc(2048)) // the messages' room
    gSet(gDebug, d)
    d
}

// ---- other debuggers (gdb, lldb): the code a built executable loads, made known (quark build -g) ----
// gdb's JIT interface: the descriptor a debugger reads (its version 1 and what changed, that entry, the first entry)
// at the C name __jit_debug_descriptor, which the executable's symbols give (compiler/image.qk writes the version
// in), and the function it breaks on, __jit_debug_register_code, called once an entry is in.
pub fn jitDescriptor() -> Int = textAt("__jit_debug_descriptor: quark!!!")

// (a parameter its definition has not: a C call, to the address the debugger breaks on, not the function inlined)
extern effect fn jitDebugHook(unused: Int64) as "__jit_debug_register_code"

pub extern effect fn jitDebugRegisterCode() as "__jit_debug_register_code" {
    let _ = 0 // nothing: where the debugger breaks
}

// The object the compiler made for code now at `code` (n bytes at obj: an ELF, compiler/dwarf.qk's jitObjectOf),
// its addresses made the code's (patches: count offsets of 8-byte addresses), put in the debugger's list.
pub fn registerDebug(code: Int, obj: Int, n: Int, patches: Int, count: Int) {
    let copy = malloc(n)
    copyBytes(copy, obj, n)
    for i in 0..count {
        let at = copy + word(patches, i)
        setWord(at, 0, word(at, 0) + code)
    }
    let entry = calloc(4, 8) // next, previous, the object, its size
    let d = jitDescriptor()
    let first = word(d, 2)
    setWord(entry, 0, first)
    setWord(entry, 2, copy)
    setWord(entry, 3, n)
    if first != 0 {
        setWord(first, 1, entry)
    }
    setWord(d, 2, entry)
    setWord(d, 1, entry)
    setWord(d, 0, 1 | 1 << 32) // version 1, an object registered
    jitDebugHook(0)
    setWord(d, 0, 1)
}
""" + "\n"
    }
    if name == "files" {
        return r"""
// Files, folders, the input, the environment, the arguments, and other programs. The bytes come and go through C's
// streams (fread, fwrite) opened by the system's layer (UTF-8 names on every system); messages say why with C's
// strerror.
use base
use arena
use text
use print
use tasks

extern effect fn fread(p: Int64, size: UInt64, n: UInt64, f: Int64) -> UInt64
extern effect fn fwrite(p: Int64, size: UInt64, n: UInt64, f: Int64) -> UInt64
extern effect fn fclose(f: Int64) -> Int32
extern effect fn ferror(f: Int64) -> Int32
extern effect fn osOpen(path: Int64, mode: Int64) -> Int64 as "qkosOpen" // a FILE*, or 0 (errno set)
extern effect fn osEnv(name: Int64) -> Int64 as "qkosEnv" // malloc'd UTF-8, or 0
extern effect fn osPathKind(path: Int64) -> Int64 as "qkosPathKind" // -1 nothing, 0 a file, 1 a folder
extern effect fn osMakeDir(path: Int64) -> Int64 as "qkosMakeDir" // 0, or -1 (errno set)
extern effect fn osRemove(path: Int64, folder: Int64) -> Int64 as "qkosRemove" // 0, or -1 (errno set)
extern effect fn osListDir(path: Int64) -> Int64 as "qkosListDir" // malloc'd names, each zero-ended, then a zero; or 0
extern effect fn osReadIn(p: Int64, n: Int64) -> Int64 as "qkosReadIn" // the input's bytes: how many (0 at its end)
extern effect fn osReadLine(out: Int64) -> Int64 as "qkosReadLine" // a typed line (a console): 1 and (malloc'd, length) in out, 0 at the end, -1 not a console
extern effect fn osRunProcess(name: Int64, args: Int64, count: Int64, out: Int64) -> Int64 as "qkosRunProcess"
extern effect fn osSeparator(c: Int64) -> Int64 as "qkosSeparator"

const errnoNoEnt = 2
const errnoIo = 5
const errnoExist = 17
const errnoNotDir = 20

fn cannot(what: Text, name: Int) -> Int =
    errResult(message().text("cannot ").text(what).text(" ").zeroText(name).text(": ").zeroText(strerror(osErrno())))

type Read { p: Int, n: Int, ok: Bool }

// the whole file, in the arena
fn readWhole(name: Int) -> Read {
    let f = osOpen(name, textAt("rb\0"))
    if f == 0 {
        return Read(0, 0, false)
    }
    var cap = 65536
    var p = malloc(cap)
    var n = 0
    while true {
        if n == cap {
            cap *= 2
            p = realloc(p, cap)
        }
        let got = fread(p + n, 1, cap - n, f)
        if got == 0 {
            break
        }
        n += got
    }
    let failed = ferror(f) != 0
    let _ = fclose(f)
    if failed {
        free(p)
        return Read(0, 0, false)
    }
    let bytes = cString(p, n)
    free(p)
    Read(bytes, n, true)
}

pub extern effect fn rtReadFile(path: Int64, pathLen: Int64) -> Int64 as "qk_readFile" {
    let name = cString(path, pathLen)
    let r = readWhole(name)
    if not r.ok {
        return cannot("read", name)
    }
    let bad = utf8Invalid(r.p, r.n)
    if bad >= 0 {
        return errResult(
            message().text("cannot read ").zeroText(name).text(": it is not UTF-8 text (byte ").int(bad).text(
                "): readBytes reads any file",
            ),
        )
    }
    okResult(r.p, r.n)
}

pub extern effect fn rtReadBytes(path: Int64, pathLen: Int64) -> Int64 as "qk_readBytes" {
    let name = cString(path, pathLen)
    let r = readWhole(name)
    if not r.ok {
        return cannot("read", name)
    }
    okResult(r.p, r.n)
}

fn writeWhole(path: Int, pathLen: Int, text: Int, n: Int, mode: Text, what: Text) -> Int {
    let name = cString(path, pathLen)
    let f = osOpen(name, textAt(mode))
    if f == 0 {
        return cannot(what, name)
    }
    let written = if n > 0 { fwrite(text, 1, n, f) } else { 0 }
    let writeError = if written == n { 0 } else { osErrno() }
    let closed = fclose(f)
    if written != n {
        osSetErrno(if writeError != 0 { writeError } else { errnoIo })
        return cannot(what, name)
    }
    if closed != 0 {
        return cannot("close", name)
    }
    okResult(0, 0)
}

pub extern effect fn rtWriteFile(path: Int64, pathLen: Int64, text: Int64, n: Int64) -> Int64 as "qk_writeFile" =
    writeWhole(path, pathLen, text, n, "wb\0", "write")

pub extern effect fn rtAppendFile(path: Int64, pathLen: Int64, text: Int64, n: Int64) -> Int64 as "qk_appendFile" =
    writeWhole(path, pathLen, text, n, "ab\0", "append to")

extern fn jobAddress(f: extern (Int64) -> Int64) -> Int64 as "qkTextAddress"

// a process started with pipes: 0 and (its handle, the input's write end, the output's and the errors' read ends) in
// out; 1 and the message (malloc'd) in out[1]
extern effect fn osStartProcess(name: Int64, args: Int64, count: Int64, out: Int64) -> Int64 as "qkosStartProcess"
extern effect fn osPipeRead(h: Int64, p: Int64, n: Int64) -> Int64 as "qkosPipeRead" // bytes read, 0 at the end, -1
extern effect fn osPipeWrite(h: Int64, p: Int64, n: Int64) -> Int64 as "qkosPipeWrite" // bytes written, or -1
extern effect fn osPipeClose(h: Int64) as "qkosPipeClose"
extern effect fn osProcessWait(h: Int64) -> Int64 as "qkosProcessWait" // its exit status (the handle let go of)
extern effect fn osProcessKill(h: Int64) as "qkosProcessKill"

// The calls that wait for the input or a process, on a thread of their own in a task (tasks.qk offThread): the
// others go on meanwhile. Their jobs: what the call takes, then what it gives.
fn readInJob(j: Int) -> Int {
    jobBegins(j)
    setWord(j, jobArgs + 2, osReadIn(word(j, jobArgs), word(j, jobArgs + 1)))
    setWord(j, jobDone, 1)
    0
}

fn readLineJob(j: Int) -> Int {
    jobBegins(j)
    setWord(j, jobArgs + 1, osReadLine(word(j, jobArgs)))
    setWord(j, jobDone, 1)
    0
}

fn runProcessJob(j: Int) -> Int {
    jobBegins(j)
    setWord(
        j,
        jobArgs + 4,
        osRunProcess(word(j, jobArgs), word(j, jobArgs + 1), word(j, jobArgs + 2), word(j, jobArgs + 3)),
    )
    setWord(j, jobDone, 1)
    0
}

fn pipeReadJob(j: Int) -> Int {
    jobBegins(j)
    setWord(j, jobArgs + 3, osPipeRead(word(j, jobArgs), word(j, jobArgs + 1), word(j, jobArgs + 2)))
    setWord(j, jobDone, 1)
    0
}

fn pipeWriteJob(j: Int) -> Int {
    jobBegins(j)
    setWord(j, jobArgs + 3, osPipeWrite(word(j, jobArgs), word(j, jobArgs + 1), word(j, jobArgs + 2)))
    setWord(j, jobDone, 1)
    0
}

fn processWaitJob(j: Int) -> Int {
    jobBegins(j)
    setWord(j, jobArgs + 1, osProcessWait(word(j, jobArgs)))
    setWord(j, jobDone, 1)
    0
}

// the word at give of the job, once done
fn jobGives(j: Int, give: Int) -> Int {
    let r = word(j, jobArgs + give)
    free(j)
    r
}

fn readIn(p: Int, n: Int) -> Int {
    let j = calloc(jobArgs + 3, 8)
    setWord(j, jobArgs, p)
    setWord(j, jobArgs + 1, n)
    if not offThread(jobAddress(x => readInJob(x)), j) {
        let _ = readInJob(j)
    }
    jobGives(j, 2)
}

fn readLineTyped(out: Int) -> Int {
    let j = calloc(jobArgs + 2, 8)
    setWord(j, jobArgs, out)
    if not offThread(jobAddress(x => readLineJob(x)), j) {
        let _ = readLineJob(j)
    }
    jobGives(j, 1)
}

fn runProcessWaited(name: Int, args: Int, count: Int, out: Int) -> Int {
    let j = calloc(jobArgs + 5, 8)
    setWord(j, jobArgs, name)
    setWord(j, jobArgs + 1, args)
    setWord(j, jobArgs + 2, count)
    setWord(j, jobArgs + 3, out)
    if not offThread(jobAddress(x => runProcessJob(x)), j) {
        let _ = runProcessJob(j)
    }
    jobGives(j, 4)
}

// the input, a byte at a time from a buffer of the program's own
fn nextByte() -> Int {
    let g = globals()
    if word(g, gInAt) >= word(g, gInLen) {
        if word(g, gInBuf) == 0 {
            setWord(g, gInBuf, malloc(65536))
        }
        let got = readIn(word(g, gInBuf), 65536)
        setWord(g, gInAt, 0)
        setWord(g, gInLen, if got > 0 { got } else { 0 })
        if got <= 0 {
            return -1
        }
    }
    let c = byte(word(g, gInBuf), word(g, gInAt))
    setWord(g, gInAt, word(g, gInAt) + 1)
    c
}

// readLine() -> Text?: the next line, without its line break; None at the end
pub extern effect fn rtReadLine() -> Int64 as "qk_readLine" {
    flush() // what was printed before the question shows first
    let typed = alloc(2, 8)
    let console = readLineTyped(typed)
    if console >= 0 {
        if console == 0 {
            return optional(false, 0, 0)
        }
        let line = cString(word(typed, 0), word(typed, 1))
        free(word(typed, 0))
        return optional(true, line, word(typed, 1))
    }
    var cap = 256
    var p = malloc(cap)
    var n = 0
    var any = false
    while true {
        let c = nextByte()
        if c < 0 {
            break
        }
        any = true
        if c == '\n' {
            break
        }
        if n == cap {
            cap *= 2
            p = realloc(p, cap)
        }
        setByte(p, n, c)
        n += 1
    }
    if not any {
        free(p)
        return optional(false, 0, 0)
    }
    if n > 0 and byte(p, n - 1) == '\r' {
        n -= 1
    }
    let bytes = cString(p, n)
    free(p)
    optional(true, bytes, n)
}

// args() -> [Text]: the command line after the program
pub extern effect fn rtArgs() -> Int64 as "qk_args" {
    let count = gGet(gArgCount)
    let p = textArray(count)
    copyBytes(p + 8, gGet(gArgs), 16 * count)
    p
}

pub extern effect fn rtEnv(name: Int64, n: Int64) -> Int64 as "qk_env" {
    let v = osEnv(cString(name, n))
    if v == 0 {
        return optional(false, 0, 0)
    }
    let k = strlen(v)
    let t = cString(v, k)
    free(v)
    optional(true, t, k)
}

pub extern effect fn rtPathExists(path: Int64, n: Int64) -> Int64 as "qk_pathExists" =
    if osPathKind(cString(path, n)) >= 0 { 1 } else { 0 }

// listDir(path) -> [Text]!: the names in a folder, sorted
pub extern effect fn rtListDir(path: Int64, n: Int64) -> Int64 as "qk_listDir" {
    let dir = cString(path, n)
    let names = osListDir(dir)
    if names == 0 {
        return cannot("list", dir)
    }
    var count = 0
    var at = names
    while byte(at, 0) != 0 {
        at += strlen(at) + 1
        count += 1
    }
    let arr = textArray(count)
    at = names
    for i in 0..count {
        let k = strlen(at)
        setWord(arr, 1 + 2 * i, cString(at, k))
        setWord(arr, 2 + 2 * i, k)
        at += k + 1
    }
    free(names)
    for i in 1..count {
        // sorted as strcmp sorts: by bytes
        var j = i
        while j > 0
            and textCompare(word(arr, 2 * j + 1), word(arr, 2 * j + 2), word(arr, 2 * j - 1), word(arr, 2 * j)) < 0 {
            let p = word(arr, 2 * j + 1)
            let k = word(arr, 2 * j + 2)
            setWord(arr, 2 * j + 1, word(arr, 2 * j - 1))
            setWord(arr, 2 * j + 2, word(arr, 2 * j))
            setWord(arr, 2 * j - 1, p)
            setWord(arr, 2 * j, k)
            j -= 1
        }
    }
    okResult(arr + 8, count)
}

// makeDir(path) -> Unit!: the folder, and the folders above it that are missing
pub extern effect fn rtMakeDir(path: Int64, n: Int64) -> Int64 as "qk_makeDir" {
    let name = cString(path, n)
    for i in 1..n + 1 {
        if i < n and osSeparator(byte(name, i)) == 0 {
            continue
        }
        if osSeparator(byte(name, i - 1)) != 0 {
            // a//b, the root, or a separator at the end
            continue
        }
        if i < n and byte(name, i - 1) == ':' {
            // C:\
            continue
        }
        let kept = byte(name, i)
        setByte(name, i, 0)
        if osPathKind(name) != 1 and osMakeDir(name) != 0 and not (osErrno() == errnoExist and osPathKind(name) == 1) {
            if osErrno() == errnoExist {
                osSetErrno(errnoNotDir)
            }
            let r = cannot("make the folder", name)
            setByte(name, i, kept)
            return r
        }
        setByte(name, i, kept)
    }
    okResult(0, 0)
}

// removePath(path) -> Unit!: a file, or a folder with nothing in it
pub extern effect fn rtRemovePath(path: Int64, n: Int64) -> Int64 as "qk_removePath" {
    let name = cString(path, n)
    let kind = osPathKind(name)
    if kind < 0 {
        osSetErrno(errnoNoEnt)
        return cannot("remove", name)
    }
    if osRemove(name, kind) != 0 {
        return cannot("remove", name)
    }
    okResult(0, 0)
}

// runProcess(program, args) -> Process!: [ok], then the message or the Process (status, out, err), from slot 1
pub extern effect fn rtRunProcess(prog: Int64, progLen: Int64, args: Int64, count: Int64) -> Int64 as "qk_runProcess" {
    let name = cString(prog, progLen)
    flush() // what was printed before comes first
    let out = alloc(5, 8) // status, out (malloc'd), its length, err, its length; or the message (malloc'd)
    let p = alloc(6, 8)
    if runProcessWaited(name, args, count, out) != 0 {
        let m = word(out, 1)
        let k = strlen(m)
        setWord(p, 1, cString(m, k))
        setWord(p, 2, k)
        free(m)
        return p
    }
    setWord(p, 0, 1)
    setWord(p, 1, word(out, 0))
    setWord(p, 2, cString(word(out, 1), word(out, 2)))
    setWord(p, 3, word(out, 2))
    setWord(p, 4, cString(word(out, 3), word(out, 4)))
    setWord(p, 5, word(out, 4))
    free(word(out, 1))
    free(word(out, 3))
    p
}

// ---- a process running beside this one (startProcess): its words ----
const spHandle = 0
const spIn = 1 // -1 once closed
const spOut = 2
const spErr = 3
const spEnded = 4 // waited for: 1, and its status then
const spStatus = 5

pub extern effect fn rtStartProcess(prog: Int64, progLen: Int64, args: Int64, count: Int64) -> Int64 as "qk_startProcess" {
    let name = cString(prog, progLen)
    flush() // what was printed before comes first
    let out = calloc(5, 8)
    if osStartProcess(name, args, count, out) != 0 {
        let m = word(out, 1)
        let r = errResult(message().zeroText(m))
        free(m)
        free(out)
        return r
    }
    let p = calloc(6, 8) // (malloc'd: a process may outlive the arena it was started in)
    for i in 0..4 {
        setWord(p, i, word(out, i))
    }
    free(out)
    okResult(p, 0)
}

pub extern effect fn rtProcessWrite(p: Int64, bytes: Int64, n: Int64) -> Int64 as "qk_processWrite" {
    if word(p, spIn) == -1 or word(p, spEnded) != 0 {
        return errResult(message().text("writeProcess: the process's input is closed"))
    }
    var at = 0
    while at < n {
        let j = calloc(jobArgs + 4, 8)
        setWord(j, jobArgs, word(p, spIn))
        setWord(j, jobArgs + 1, bytes + at)
        setWord(j, jobArgs + 2, n - at)
        if not offThread(jobAddress(x => pipeWriteJob(x)), j) {
            let _ = pipeWriteJob(j)
        }
        let k = jobGives(j, 3)
        if k <= 0 {
            return errResult(message().text("writeProcess: the process no longer reads its input"))
        }
        at += k
    }
    okResult(0, 0)
}

pub extern effect fn rtProcessCloseInput(p: Int64) as "qk_processCloseInput" {
    if word(p, spIn) != -1 {
        osPipeClose(word(p, spIn))
        setWord(p, spIn, -1)
    }
}

pub extern effect fn rtProcessRead(p: Int64, most: Int64, errors: Int64) -> Int64 as "qk_processRead" {
    let h = word(p, if errors != 0 { spErr } else { spOut })
    let room = allocRaw(if most > 0 { most } else { 1 }, 1)
    if h == -1 or most <= 0 {
        return okResult(room, 0)
    }
    let j = calloc(jobArgs + 4, 8)
    setWord(j, jobArgs, h)
    setWord(j, jobArgs + 1, room)
    setWord(j, jobArgs + 2, most)
    if not offThread(jobAddress(x => pipeReadJob(x)), j) {
        let _ = pipeReadJob(j)
    }
    let k = jobGives(j, 3)
    if k < 0 {
        return errResult(message().text("readProcess: the process's output cannot be read"))
    }
    if k == 0 {
        // its end: the pipe let go of
        osPipeClose(h)
        setWord(p, if errors != 0 { spErr } else { spOut }, -1)
    }
    okResult(room, k)
}

pub extern effect fn rtProcessWait(p: Int64) -> Int64 as "qk_processWait" {
    if word(p, spEnded) == 0 {
        rtProcessCloseInput(p)
        let j = calloc(jobArgs + 2, 8)
        setWord(j, jobArgs, word(p, spHandle))
        if not offThread(jobAddress(x => processWaitJob(x)), j) {
            let _ = processWaitJob(j)
        }
        setWord(p, spStatus, jobGives(j, 1))
        setWord(p, spEnded, 1)
        for at in [spOut, spErr] {
            if word(p, at) != -1 {
                osPipeClose(word(p, at))
                setWord(p, at, -1)
            }
        }
    }
    okResult(word(p, spStatus), 0)
}

pub extern effect fn rtProcessKill(p: Int64) as "qk_processKill" {
    if word(p, spEnded) == 0 {
        osProcessKill(word(p, spHandle))
    }
}
