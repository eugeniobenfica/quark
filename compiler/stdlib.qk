// Hashes of bytes: CRC-32 (what zip, gzip and PNG check), FNV-1a (64 bits, quick, for tables), SHA-256 (FIPS 180-4)
// and HMAC-SHA256 (RFC 2104: a message signed with a key, as web tokens and APIs sign).
use std.encoding

// CRC-32's table (the reflected polynomial 0xEDB88320), made when the program is compiled
fn crcEntry(n: Int) -> Int {
    var c = n
    for _ in 0..8 {
        c = if c & 1 != 0 { 0xEDB88320 ^ c >> 1 } else { c >> 1 }
    }
    c
}

const crcTable: [Int] = (0..256).map(crcEntry).toArray()

// CRC-32 of b, from 0 (go on from an earlier part's with crc32(more, from: earlier))
pub fn crc32(b: Bytes, from: Int = 0) -> Int {
    var c = from ^ 0xFFFFFFFF
    for x in b {
        c = crcTable[(c ^ x) & 255] ^ c >> 8
    }
    c ^ 0xFFFFFFFF
}

// FNV-1a of b, 64 bits (as a signed Int)
pub fn fnv1a(b: Bytes) -> Int {
    var h = -3750763034362895579 // 0xcbf29ce484222325
    for x in b {
        h = (h ^ x) *% 1099511628211
    }
    h
}

const roundConstants = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98,
    0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
    0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8,
    0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819,
    0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
    0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7,
    0xc67178f2,
]

const low32 = 0xFFFFFFFF

fn rotr(x: Int, n: Int) -> Int = (x >> n | x << (32 - n)) & low32

// SHA-256 of b: 32 bytes (hex(sha256(b)) is how it is usually written)
pub fn sha256(b: Bytes) -> Bytes {
    var h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    // the message, a 1 bit, zeros, and its length in bits: a multiple of 64 bytes
    var m = b
    m.push(0x80)
    while len(m) % 64 != 56 {
        m.push(0)
    }
    let bits = len(b) * 8
    for k in 0..8 {
        m.push(bits >> (56 - 8 * k) & 255)
    }
    var w = [0] * 64
    var at = 0
    while at < len(m) {
        for t in 0..16 {
            let i = at + 4 * t
            w[t] = m[i] << 24 | m[i + 1] << 16 | m[i + 2] << 8 | m[i + 3]
        }
        for t in 16..64 {
            let s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ w[t - 15] >> 3
            let s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ w[t - 2] >> 10
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & low32
        }
        var a = h[0]
        var bb = h[1]
        var c = h[2]
        var d = h[3]
        var e = h[4]
        var f = h[5]
        var g = h[6]
        var hh = h[7]
        for t in 0..64 {
            let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            let choice = e & f ^ ~e & low32 & g
            let t1 = (hh + s1 + choice + roundConstants[t] + w[t]) & low32
            let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            let major = a & bb ^ a & c ^ bb & c
            let t2 = (s0 + major) & low32
            hh = g
            g = f
            f = e
            e = (d + t1) & low32
            d = c
            c = bb
            bb = a
            a = (t1 + t2) & low32
        }
        h[0] = (h[0] + a) & low32
        h[1] = (h[1] + bb) & low32
        h[2] = (h[2] + c) & low32
        h[3] = (h[3] + d) & low32
        h[4] = (h[4] + e) & low32
        h[5] = (h[5] + f) & low32
        h[6] = (h[6] + g) & low32
        h[7] = (h[7] + hh) & low32
        at += 64
    }
    var out: Bytes = []
    for x in h {
        out.push(x >> 24 & 255)
        out.push(x >> 16 & 255)
        out.push(x >> 8 & 255)
        out.push(x & 255)
    }
    out
}

// HMAC-SHA256 of message with key: 32 bytes
pub fn hmacSha256(key: Bytes, message: Bytes) -> Bytes {
    var k = if len(key) > 64 { sha256(key) } else { key }
    while len(k) < 64 {
        k.push(0)
    }
    let inner: Bytes = k.map(x => x ^ 0x36)
    let outer: Bytes = k.map(x => x ^ 0x5c)
    sha256(outer + sha256(inner + message))
}

// the hex of SHA-256 of a text's UTF-8 bytes: what checksum files and APIs show
pub fn sha256Hex(text: Text) -> Text = hex(sha256(text.bytes()))
