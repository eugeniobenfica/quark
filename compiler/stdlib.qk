        return r"""
// The start of a built executable ( job): quark build writes this program (the runtime and nothing of
// the compiler), then the program's machine code, data and relocations, the C functions it calls, then a trailer
// that says where they are. It reads only those bytes of its own file, loads them and runs main.
use std.machine as machine
use base
use arena
use print
use panic
use text
use map
use loops
use numbers
use files
use io
use loader
use tasks
use threads
use debug

extern effect fn fseek(f: Int64, offset: Int32, whence: Int32) -> Int32
extern effect fn fread(p: Int64, size: UInt64, n: UInt64, f: Int64) -> UInt64
extern effect fn fclose(f: Int64) -> Int32
extern effect fn osOpen(path: Int64, mode: Int64) -> Int64 as "qkosOpen"
extern effect fn osCFunction(symbol: Int64, lib: Int64, why: Int64) -> Int64 as "qkosCFunction"

// ---- the debugger's hooks are debug.qk's (an executable has none: they do nothing there) ----
// ---- each runtime function's address, by its number: its Quark function, which the
// program calls the Quark way ----
const runtimeCount = 138 // len(runtimeNames) in compiler/ir.qk: one more there, one more here

fn runtimeTable() -> Int {
    let t = calloc(runtimeCount, 8)
    machine.fillRuntime(Pointer<Int64>(t))
    t
}

// ---- the start ----
const trailerBytes = 120

fn say(t: Text) {
    flush()
    osWrite(2, textAt(t), len(t))
}

// the process's state, its first context and arena: what every runtime function finds through osCtx
pub fn begin(argc: Int, argv: Int) {
    let g = calloc(gWords, 8)
    setWord(cell(), 0, g)
    let c = calloc(ctxWords, 8)
    setWord(c, ctxFuel, -1 - intMin)
    setWord(c, ctxGlobals, g)
    setWord(c, ctxArena, arenaNew())
    setCtx(c)
    setWord(g, gMainCtx, c)
    setWord(g, gMainArena, word(c, ctxArena))
    setWord(g, gOutBuf, malloc(65536))
    setWord(g, gOutFd, 1)
    setWord(g, gExitEnds, 1)
    let count = if argc > 1 {
        argc - 1 // everything after the executable's own name
    } else {
        0
    }
    let args = malloc(16 * count + 16)
    for i in 0..count {
        let s = word(argv, i + 1)
        setWord(args, 2 * i, s)
        setWord(args, 2 * i + 1, strlen(s))
    }
    setWord(g, gArgs, args)
    setWord(g, gArgCount, count)
    setWord(g, gRuntime, runtimeTable())
}

// runs the program this executable carries: its exit status
pub extern effect fn qkStart(argc: Int64, argv: Int64, self: Int64) -> Int64 as "qkStart" {
    begin(argc, argv)
    let f = if self != 0 { osOpen(self, textAt("rb\0")) } else { 0 }
    let t = calloc(1, trailerBytes)
    if f == 0
        or fseek(f, -trailerBytes, 2) != 0
        or fread(t, trailerBytes, 1, f) != 1
        or not sameBytes(t, textAt("QUARKPRG"), 8)
        or fseek(f, -(trailerBytes + word(t, 12)), 2) != 0 {
        say("this executable carries no Quark program\n")
        return 1
    }
    let payloadSize = word(t, 12)
    let payload = malloc(payloadSize + 1)
    if payload == 0 or fread(payload, 1, payloadSize, f) != payloadSize {
        return 1
    }
    let _ = fclose(f)
    runProgram(t, payload, true)
}

// runs a program from memory (quarkimg run, compiler/image.qk): its payload (payloadSize + 1 bytes of the caller's)
// and trailer laid out as a built executable carries them; its exit status
pub extern effect fn qkStartMemory(argc: Int64, argv: Int64, payload: Int64, trailer: Int64) -> Int64 as "qkStartMemory" {
    begin(argc, argv)
    runProgram(trailer, payload, false)
}

// the program a trailer describes, from its payload (freed once loaded when it is the start's own)
fn runProgram(t: Int, payload: Int, owned: Bool) -> Int {
    let codeLen = word(t, 1)
    let dataLen = word(t, 2)
    let relocCount = word(t, 3)
    let entry = word(t, 4)
    let fuel = word(t, 7)
    let memory = word(t, 8)
    let features = word(t, 9)
    let externCount = word(t, 10)
    let payloadSize = word(t, 12)
    if fuel > 0 {
        ctxSet(ctxFuel, fuel)
    }
    if memory > 0 {
        setLimit(arena(), memory)
    }
    let cpu = machine.cpu()
    if features & 1 != 0 and cpu & 1 == 0 or features & 2 != 0 and cpu & 2 == 0 or features & 4 != 0 and cpu & 4 == 0 {
        say("this program was built for processors with AVX (or AVX2, SSE4.2), and this one has none\n")
        return 1
    }
    setByte(payload, payloadSize, 0)
    let code = payload
    let data = code + codeLen
    let relocs = data + dataLen
    // the C functions it calls, from their libraries: each one's name, then its library ("" for the C library)
    var names = relocs + 16 * relocCount
    let hosts = calloc(if externCount != 0 { externCount } else { 1 }, 8)
    let why = calloc(1, 512)
    for i in 0..externCount {
        let name = names
        names += strlen(names) + 1
        let lib = if byte(names, 0) != 0 { names } else { 0 }
        names += strlen(names) + 1
        let address = osCFunction(name, lib, why)
        if address == 0 {
            flush()
            let n = strlen(why)
            setByte(why, n, '\n')
            osWrite(2, why, n + 1)
            return 1
        }
        setWord(hosts, i, address)
    }
    let l = load(code, codeLen, data, dataLen, relocs, relocCount, word(t, 5), word(t, 6), hosts)
    if l == 0 {
        return 1
    }
    if word(t, 13) > 0 {
        // -g: its debug information, for gdb and lldb (after the C functions' names: the object, its patches)
        let obj = relocs + 16 * relocCount + word(t, 11)
        registerDebug(word(l, lCode), obj, word(t, 13), obj + word(t, 13), word(t, 14))
    }
    if owned {
        free(payload) // loaded: the code and data have places of their own
    }
    let ok = runEntry(l, word(l, lCode) + entry, 0, 0, 0, 0)
    flush()
    if not ok {
        let p = panicText()
        let n = panicTextLen()
        setByte(p, n, '\n')
        osWrite(2, p, n + 1)
        return 1
    }
    0
}
""" + "\n"
    }
    if name == "tasks" {
        return r"""
// Tasks: a function on a stack of its own, run a step at a time. machine.switchStack saves the registers calls keep
// and the stack pointer, and takes up another stack where it was left. A task allocates in an arena of its own (what
// it captured is copied there when it is made): values never go from a task to anyone else.
use std.machine as machine
use base
use arena
use loops
use loader
use numbers
use text

const taskStack = 8388608

// a task's words: its state, then the context's per-call fields (its own while it runs, the caller's kept), then
// its registers and its caller's (machine.switchStack's 29 words each)
const tState = 0 // 0 not started, 1 gave its turn back, 2 done, 3 stopped
const tWakeAt = 1 // in sleep(seconds): when it is over (0: not sleeping)
const tArena = 2
const tHome = 3 // the arena of the machine it runs in
const tOuterArena = 4
const tFn = 5
const tArgs = 6 // 16 words
const tArgCount = 22
const tCaller = 23
const tEscapeRsp = 24
const tEscapeStub = 25
const tStackLimit = 26
const tCode = 27
const tCodeEntry = 28
const tOuterEscape = 29
const tOuterStub = 30
const tOuterLimit = 31
const tOuterLow = 32
const tOuterRunning = 33
const tOuterEntry = 34
const tStack = 35
const tLoaded = 36
const tError = 37 // 512 bytes of its own
const tRegs = 38 // 32 words
const tCallerRegs = 70 // 32 words
const tWaitFd = 102 // a socket it waits on (its number + 1), 0 none: it is stepped again when the socket is ready
const tWaitWrite = 103 // ... to write to it, else to read
const tWaitChannel = 104 // a channel it waits on (its number + 1), 0 none: stepped again when it has a message
const tWaitThread = 105 // a system call it waits for, on a thread of its own (its job: offThread), 0 none
const tCancelled = 106 // cancel(task) was called: it is let go of where it next gives its turn back
const tScope = 107 // the scope it was started in (its number + 1), 0 none
const tStartLine = 108 // ... the line that started it, for its panic's message
const tWaitScope = 109 // a scope whose tasks it waits for (its number + 1), 0 none
const taskWords = 110

extern fn startAddress(f: extern () -> Int64) -> Int64 as "qkTextAddress"

// the context's per-call fields: the task's in, the caller's out (or back)
fn enterTask(t: Int) {
    let c = ctx()
    setWord(t, tOuterEscape, word(c, ctxEscapeRsp))
    setWord(t, tOuterStub, word(c, ctxEscapeStub))
    setWord(t, tOuterLimit, word(c, ctxStackLimit))
    setWord(t, tOuterLow, word(c, ctxTaskStackLow))
    setWord(t, tOuterRunning, word(c, ctxRunning))
    setWord(t, tOuterEntry, word(c, ctxRunningEntry))
    setWord(t, tCaller, word(c, ctxTask))
    setWord(c, ctxTask, t)
    setWord(c, ctxEscapeRsp, word(t, tEscapeRsp))
    setWord(c, ctxEscapeStub, word(t, tEscapeStub))
    setWord(c, ctxStackLimit, word(t, tStackLimit))
    setWord(c, ctxTaskStackLow, word(t, tStack))
    setWord(c, ctxRunning, word(t, tCode))
    setWord(c, ctxRunningEntry, word(t, tCodeEntry))
    setWord(t, tOuterArena, word(c, ctxArena))
    setWord(c, ctxArena, word(t, tArena))
}

fn leaveTask(t: Int) {
    let c = ctx()
    setWord(t, tEscapeRsp, word(c, ctxEscapeRsp))
    setWord(t, tEscapeStub, word(c, ctxEscapeStub))
    setWord(t, tStackLimit, word(c, ctxStackLimit))
    setWord(t, tCode, word(c, ctxRunning))
    setWord(t, tCodeEntry, word(c, ctxRunningEntry))
    setWord(c, ctxEscapeRsp, word(t, tOuterEscape))
    setWord(c, ctxEscapeStub, word(t, tOuterStub))
    setWord(c, ctxStackLimit, word(t, tOuterLimit))
    setWord(c, ctxTaskStackLow, word(t, tOuterLow))
    setWord(c, ctxRunning, word(t, tOuterRunning))
    setWord(c, ctxRunningEntry, word(t, tOuterEntry))
    setWord(c, ctxArena, word(t, tOuterArena))
    setWord(c, ctxTask, word(t, tCaller))
}

fn regs(t: Int, at: Int) -> Pointer<Int64> = Pointer<Int64>(t + 8 * at)

// a task's first switch lands here, on its own stack: the task is the context's
fn taskStart() -> Int {
    let t = ctxGet(ctxTask)
    ctxSet(ctxEscapeRsp, 1) // not the outermost call: its arena is not reset
    let ok = runEntry(word(t, tLoaded), word(t, tFn), t + 8 * tArgs, word(t, tArgCount), 0, 0)
    if not ok {
        copyBytes(word(t, tError), panicText(), panicTextLen() + 1)
    }
    setWord(t, tState, if ok { 2 } else { 3 })
    leaveTask(t)
    machine.switchStack(regs(t, tRegs), regs(t, tCallerRegs)) // never back
    0
}

// A task that ends leaves its stack and its arena (emptied) for the next ones, up to taskSpares of them: a stack
// is 8 MB, which a system may map and zero again each time (macOS: milliseconds a task).
const taskSpares = 16
const taskSpareMost = 1048576 // the most memory an arena kept for a new task holds

pub fn taskNew(l: Int, f: Int, args: Int, argCount: Int) -> Int {
    if argCount > 16 {
        return 0
    }
    let t = calloc(taskWords, 8)
    var stack = 0
    var a = 0
    let spares = gGet(gTaskSpareCount)
    if spares > 0 {
        let at = gGet(gTaskSpares) + 16 * (spares - 1)
        stack = word(at, 0)
        a = word(at, 1)
        gSet(gTaskSpareCount, spares - 1)
    } else {
        stack = malloc(taskStack)
        a = arenaLike()
    }
    if t == 0 or stack == 0 or a == 0 {
        free(t)
        free(stack)
        arenaFree(a)
        return 0
    }
    setWord(t, tStack, stack)
    setWord(t, tLoaded, l)
    setWord(t, tError, calloc(1, panicTextSize))
    setWord(t, tArena, a)
    setLimit(a, word(arena(), aLimit))
    let caller = ctxGet(ctxTask)
    setWord(t, tHome, if caller != 0 { word(caller, tHome) } else { arena() })
    setWord(t, tFn, f)
    setWord(t, tArgCount, argCount)
    copyBytes(t + 8 * tArgs, args, 8 * argCount)
    setWord(t, tCode, l)
    setWord(t, tStackLimit, stack + 65536)
    let top = (stack + taskStack) & -16
    let start = startAddress(() => taskStart())
    if byte(start, 0) == 85 {
        // x86-64 (push rbp): the start's address on top, as a call leaves it
        setWord(top - 16, 0, start)
        setWord(top - 16, 1, 0)
        setWord(t, tRegs, top - 16)
    } else {
        // ARM64: sp, and x30 where its ret goes
        setWord(t, tRegs, top)
        setWord(t, tRegs + 2, start)
    }
    t
}

// 1: it gave its turn back (more to do), 0: it is done, -1: it stopped (a panic)
pub fn taskStep(t: Int) -> Int {
    if t == 0 or word(t, tState) >= 2 {
        return if t != 0 and word(t, tState) == 2 { 0 } else { -1 }
    }
    enterTask(t)
    machine.switchStack(regs(t, tCallerRegs), regs(t, tRegs)) // back when it gives its turn back, or ends
    let s = word(t, tState)
    if s == 1 {
        1
    } else if s == 2 {
        0
    } else {
        -1
    }
}

// why it stopped (a step gave -1): its panic's text, zero-ended
pub fn taskError(t: Int) -> Int = word(t, tError)

pub fn taskFree(t: Int) {
    if t == 0 {
        return
    }
    free(word(t, tError))
    let spares = gGet(gTaskSpareCount)
    if spares < taskSpares and word(word(t, tArena), aReserved) <= taskSpareMost {
        // kept: the arena emptied, as a new one is (one that grew large is let go of: its memory with it)
        if gGet(gTaskSpares) == 0 {
            gSet(gTaskSpares, malloc(16 * taskSpares))
        }
        let was = ctxGet(ctxArena)
        setWord(ctx(), ctxArena, word(t, tArena))
        arenaReset()
        setWord(ctx(), ctxArena, was)
        let at = gGet(gTaskSpares) + 16 * spares
        setWord(at, 0, word(t, tStack))
        setWord(at, 1, word(t, tArena))
        gSet(gTaskSpareCount, spares + 1)
    } else {
        free(word(t, tStack))
        arenaFree(word(t, tArena))
    }
    free(t)
}

pub extern effect fn rtYield() as "qk_yield" {
    let t = ctxGet(ctxTask)
    if t == 0 {
        return
    }
    setWord(t, tState, 1)
    leaveTask(t)
    machine.switchStack(regs(t, tRegs), regs(t, tCallerRegs))
}

// sleep(seconds): in a task, the turn back until the time went by; outside one, a sleep
pub extern effect fn rtWait(seconds: Float64) as "qk_wait" {
    let until = osNow() + seconds
    let t = ctxGet(ctxTask)
    if t == 0 {
        while osNow() < until {
            osSleep(1)
        }
        return
    }
    setFloat(t, tWakeAt, until)
    rtYield()
    while osNow() < until {
        rtYield()
    }
    setFloat(ctxGet(ctxTask), tWakeAt, 0.0)
}

pub extern effect fn rtSpawn(f: Int64, env: Int64) -> Int64 as "qk_spawn" {
    let t = taskNew(ctxGet(ctxRunning), f, 0, 0)
    if t == 0 {
        panicNow(panicSize, 0, taskStack, 0)
    }
    setWord(t, tArgs, copyIntoArena(word(t, tArena), env)) // what it captured, its own
    setWord(t, tArgCount, 1)
    let g = globals()
    if word(g, gTaskCount) == word(g, gTaskCap) {
        let cap = if word(g, gTaskCap) != 0 { word(g, gTaskCap) * 2 } else { 16 }
        setWord(g, gTasks, realloc(word(g, gTasks), 8 * cap))
        setWord(g, gTaskCap, cap)
    }
    let n = word(g, gTaskCount)
    setWord(word(g, gTasks), n, t)
    setWord(g, gTaskCount, n + 1)
    n
}

pub extern effect fn rtStep(n: Int64, line: Int64) -> Int64 as "qk_step" {
    let g = globals()
    let tasks = word(g, gTasks)
    let caller = ctxGet(ctxTask)
    let home = if caller != 0 { word(caller, tHome) } else { arena() }
    if n < 0 or n >= word(g, gTaskCount) {
        panicNow(panicTask, line, n, 0)
    }
    let t = word(tasks, n)
    if t == 0 {
        return 0 // it ended (or was cancelled)
    }
    if word(t, tHome) != home {
        panicNow(panicTask, line, n, 0)
    }
    var active = caller
    while active != 0 {
        if active == t {
            panicNow(panicTask, line, n, 0)
        }
        active = word(active, tCaller)
    }
    if word(t, tCancelled) != 0 {
        if waitsOnThread(t) {
            return 1 // let go of when its call is done
        }
        cancelledEnds(n, t)
        return 0
    }
    let r = taskStep(t)
    if r < 0 {
        // the task stopped: so does the one that stepped it, with its message (and where a scope's task was started)
        copyBytes(panicText(), word(t, tError), panicTextSize)
        if word(t, tStartLine) != 0 {
            let n0 = strlen(panicText())
            let _ = bufAt(panicText() + n0, panicTextSize - n0).text(" (in the task started at line ").int(
                word(t, tStartLine),
            ).text(")")
        }
        taskFree(t)
        setWord(tasks, n, 0)
        stopNow()
    }
    if r == 0 {
        taskEnds(t)
        taskFree(t)
        setWord(tasks, n, 0)
    }
    if r == 1 { 1 } else { 0 }
}

// joinTask(task): steps it to its end, without a pause between its turns unless it sleeps
pub extern effect fn rtJoinTask(n: Int64, line: Int64) as "qk_joinTask" {
    while rtStep(n, line) != 0 {
        let t = word(gGet(gTasks), n)
        if word(t, tWaitFd) != 0 {
            let items = alloc(3, 8)
            setWord(items, 0, word(t, tWaitFd) - 1)
            setWord(items, 1, word(t, tWaitWrite))
            let _ = osPoll(items, 1, -1)
            setWord(t, tWaitFd, 0)
        }
        if waitsOnThread(t) {
            osSleep(threadLookAgain)
        }
        let wake = floatAt(t, tWakeAt)
        let left = if wake != 0.0 { wake - osNow() } else { 0.0 }
        if left > 0.0 {
            rtWait(left)
        }
    }
}

// ---- waiting: on a socket, on a channel; go(f) and runTasks(); channels ----
extern effect fn osPoll(items: Int64, count: Int64, ms: Int64) -> Int64 as "qkosPoll" // items: (socket, write, ready)

// the socket ready to read (write: to write) for this task: in a task, its turn back until it is (runTasks and
// joinTask wait for it); outside one, a wait here
pub fn waitSocket(fd: Int, write: Bool) {
    let t = ctxGet(ctxTask)
    if t == 0 {
        let items = alloc(3, 8)
        setWord(items, 0, fd)
        setWord(items, 1, if write { 1 } else { 0 })
        let _ = osPoll(items, 1, -1)
        return
    }
    setWord(t, tWaitFd, fd + 1)
    setWord(t, tWaitWrite, if write { 1 } else { 0 })
    rtYield()
    setWord(ctxGet(ctxTask), tWaitFd, 0)
}

// ---- system calls that wait, on a thread of their own ----
// A call the system makes wait (a name looked up, a connection made, a process run, a line typed) made in a task
// runs on a thread of its own, and the task gives its turn back until it is done: the others go on meanwhile. The
// call's job is malloc'd words: [done][the thread][its context][what the call takes and gives...]. The thread runs
// with a copy of the waiting task's context (its globals, its arena: the task does not run meanwhile); the call
// touches only the job, malloc'd memory and the task's, and does not panic.
// The scheduler cannot be woken by the thread (a pipe would be no socket on Windows): while a task waits on one, it
// looks again every few milliseconds. Outside a task, the call is made here.
pub const jobDone = 0
const jobThread = 1
const jobCtx = 2 // the thread's context, or 0: the call made where it was asked for
pub const jobArgs = 3 // the call's own words from here
const threadLookAgain = 2 // ms between looks while a task waits on a thread and nothing else is ready

extern effect fn osThreadStart(f: Int64, arg: Int64) -> Int64 as "qkosThreadStart" // a handle, or 0
extern effect fn osThreadJoin(h: Int64) as "qkosThreadJoin"
extern fn jobAddress(f: extern (Int64) -> Int64) -> Int64 as "qkTextAddress"

// f(job) (an extern fn that sets job's jobDone last) run on a thread while this task waits: false outside a task, or
// when no thread could be made (the caller makes the call itself)
pub fn offThread(f: Int, job: Int) -> Bool {
    let t = ctxGet(ctxTask)
    if t == 0 {
        return false
    }
    setWord(job, jobDone, 0)
    let c = malloc(8 * ctxWords)
    copyBytes(c, ctx(), 8 * ctxWords)
    setWord(job, jobCtx, c)
    let h = osThreadStart(f, job)
    if h == 0 {
        setWord(job, jobCtx, 0)
        free(c)
        return false
    }
    setWord(job, jobThread, h)
    setWord(t, tWaitThread, job)
    while word(job, jobDone) == 0 {
        rtYield()
    }
    setWord(ctxGet(ctxTask), tWaitThread, 0)
    osThreadJoin(h) // what the thread wrote, seen from here on
    free(c)
    true
}

// first in a job's function: on its thread, the context offThread made for it
pub fn jobBegins(job: Int) {
    if word(job, jobCtx) != 0 {
        setCtx(word(job, jobCtx))
    }
}

fn waitsOnThread(t: Int) -> Bool =
    word(t, tWaitThread) != 0 and word(word(t, tWaitThread), jobDone) == 0

// A channel: [closed][count][capacity][head][slots][description][items: a value's slots each]. The values in the
// queues are copies, in an arena of the channels' own (gChannelArena): they go from one task's memory to another's.
// It is emptied when every queue is, and made again from what they hold when it grows to twice what that was.
const chClosed = 0
const chCount = 1
const chCap = 2
const chHead = 3
const chSlots = 4 // the values' slots
const chDesc = 5 // an array of their type's description (lower.qk's Desc), 0 when they hold no memory
const chItems = 6
const channelArenaLeast = 1048576 // made again only past this

// the place of the queue's i-th value (from its head)
fn channelItem(c: Int, i: Int) -> Int =
    c + 8 * (chItems + word(c, chSlots) * ((word(c, chHead) + i) % word(c, chCap)))

// the channels' arena a made the one the running code allocates in: the one it was, to put back
fn inChannelArena(a: Int) -> Int {
    let was = ctxGet(ctxArena)
    setWord(ctx(), ctxArena, a)
    was
}

// the channels' copier, into the arena the running code allocates in
fn channelCopier() -> Int {
    let c = copierFresh(gGet(gChannelCopier))
    gSet(gChannelCopier, c)
    c
}

// the value of slots at the place, its memory copied into the channels' arena (as it is now)
fn channelKeep(slotsAt: Int, desc: Int) {
    var a = gGet(gChannelArena)
    if a == 0 {
        a = arenaNew()
        gSet(gChannelArena, a)
    }
    let was = inChannelArena(a)
    let c = channelCopier()
    copyValue(c, slotsAt, desc)
    copierFreshDone(c)
    setWord(ctx(), ctxArena, was)
}

// the channels' arena made again from the values queued (what was received goes)
fn channelArenaRemade() {
    let old = gGet(gChannelArena)
    let a = arenaNew()
    let was = inChannelArena(a)
    let c = channelCopier()
    for n in 0..gGet(gChannelCount) {
        let ch = word(channelEntry(n), 0)
        if ch != 0 and word(ch, chDesc) != 0 {
            for i in 0..word(ch, chCount) {
                copyValue(c, channelItem(ch, i), word(ch, chDesc))
            }
        }
    }
    copierFreshDone(c)
    setWord(ctx(), ctxArena, was)
    arenaFree(old)
    gSet(gChannelArena, a)
    gSet(gChannelKept, word(a, aAllocated))
}

// A channel's number: its place in the table, and the place's generation above bit 32. A channel closed and empty
// is let go of: its place is used again, a generation later, and its number from then on is a closed, empty
// channel's (receive gives None, send stops the program, closeChannel does nothing). The table: [its queue, or 0
// once let go of][its generation][the next free place + 1] for each place.
const chanEntry = 3

fn channelEntry(n: Int) -> Int = gGet(gChannels) + 8 * chanEntry * (n & 4294967295)

// the channel numbered n: its queue, or 0 when it was let go of
fn channelAt(n: Int, line: Int) -> Int {
    if n < 0 or n & 4294967295 >= gGet(gChannelCount) {
        panicNow(panicNoChannel, line, n, 0)
    }
    let e = channelEntry(n)
    if word(e, 1) != shr(n, 32) {
        return 0
    }
    word(e, 0)
}

fn channelReady(n: Int) -> Bool {
    let c = channelAt(n, 0)
    c == 0 or word(c, chCount) > 0 or word(c, chClosed) != 0
}

// the channel n, closed and empty, let go of
fn channelGone(n: Int) {
    let e = channelEntry(n)
    free(word(e, 0))
    setWord(e, 0, 0)
    setWord(e, 1, word(e, 1) + 1)
    setWord(e, 2, gGet(gChannelFree))
    gSet(gChannelFree, n & 4294967295 + 1)
}

// whether the task can be stepped now: not waiting, or what it waits for came
fn ready(t: Int, now: Float) -> Bool {
    if word(t, tWaitFd) != 0 {
        return false // runTasks' poll says when
    }
    if word(t, tWaitChannel) != 0 {
        // a value came (or the channel closed); receiveWithin's time (tWakeAt) is over
        let until = floatAt(t, tWakeAt)
        return channelReady(word(t, tWaitChannel) - 1) or until != 0.0 and until <= now
    }
    if waitsOnThread(t) {
        return false
    }
    if word(t, tWaitScope) != 0 and scopeAlive(word(t, tWaitScope) - 1) > 0 {
        return false // its scope's tasks are not all done
    }
    let wake = floatAt(t, tWakeAt)
    wake == 0.0 or wake <= now
}

// go(f): a task of f that runTasks (or a receive outside a task) runs; it is no one's to step
pub extern effect fn rtGo(f: Int64, env: Int64) -> Int64 as "qk_go" {
    let n = rtSpawn(f, env)
    let g = globals()
    if word(g, gBackgroundCount) == word(g, gBackgroundCap) {
        let cap = if word(g, gBackgroundCap) != 0 {
            word(g, gBackgroundCap) * 2
        } else {
            16
        }
        setWord(g, gBackground, realloc(word(g, gBackground), 8 * cap))
        setWord(g, gBackgroundCap, cap)
    }
    setWord(word(g, gBackground), word(g, gBackgroundCount), n)
    setWord(g, gBackgroundCount, word(g, gBackgroundCount) + 1)
    n
}

// one round of the background tasks: each that can go, stepped once (those done let go of); when none could, a
// wait for the first socket ready or sleep over (until: the caller's own time, 0 none: the wait ends then too).
// false when no task is left.
fn backgroundRound(line: Int, until: Float) -> Bool {
    let g = globals()
    let now = osNow()
    // sleeps over by now wake in the order they end (a late round finds several over): only the first to end this
    // round, the others the next
    var first = 0.0
    for k in 0..word(g, gBackgroundCount) {
        let t = word(word(g, gTasks), word(word(g, gBackground), k))
        let wake = if t != 0 and ready(t, now) { floatAt(t, tWakeAt) } else { 0.0 }
        if wake != 0.0 and (first == 0.0 or wake < first) {
            first = wake
        }
    }
    var stepped = false
    var i = 0
    while i < word(g, gBackgroundCount) {
        let n = word(word(g, gBackground), i)
        let t = word(word(g, gTasks), n) // (read each time: a task that runs may make others, and the list grow)
        if t != 0 and ready(t, now) and floatAt(t, tWakeAt) <= first {
            stepped = true
            let _ = rtStep(n, line)
        }
        i += 1
    }
    // the tasks done: out of the list
    var kept = 0
    for k in 0..word(g, gBackgroundCount) {
        let n = word(word(g, gBackground), k)
        if word(word(g, gTasks), n) != 0 {
            setWord(word(g, gBackground), kept, n)
            kept += 1
        }
    }
    setWord(g, gBackgroundCount, kept)
    if kept == 0 {
        return false
    }
    // the sockets they wait on: polled (not waiting when some task just ran), the ready ones' tasks woken
    var sockets = 0
    var soonest = -1.0
    let later = osNow()
    for k in 0..kept {
        let t = word(word(g, gTasks), word(word(g, gBackground), k))
        if word(t, tWaitFd) != 0 {
            sockets += 1
        } else if waitsOnThread(t) {
            let left = 0.002 // threadLookAgain: looked at again soon
            if soonest < 0.0 or left < soonest {
                soonest = left
            }
        } else if word(t, tWaitChannel) == 0 or channelReady(word(t, tWaitChannel) - 1) or floatAt(t, tWakeAt) != 0.0 {
            let wake = floatAt(t, tWakeAt)
            let left = if wake == 0.0 { 0.0 } else { max(wake - later, 0.0) }
            if soonest < 0.0 or left < soonest {
                soonest = left
            }
        }
    }
    if sockets == 0 and soonest < 0.0 {
        if stepped {
            return true // a channel may have a message now: the next round sees
        }
        if until == 0.0 {
            panicNow(panicDeadlock, line, 0, 0) // each waits on a channel, and none ran to send
        }
        soonest = max(until - later, 0.0) // none will send: the caller's time waited out
    }
    var ms = if stepped {
        0
    } else if soonest < 0.0 {
        -1
    } else {
        toInt(soonest * 1000.0) + 1
    }
    if until != 0.0 {
        let left = toInt(max(until - later, 0.0) * 1000.0) + 1
        if ms < 0 or ms > left {
            ms = left
        }
    }
    if sockets == 0 {
        if ms > 0 {
            osSleep(ms)
        }
        return true
    }
    let items = alloc(3 * sockets, 8)
    var at = 0
    for k in 0..kept {
        let t = word(word(g, gTasks), word(word(g, gBackground), k))
        if word(t, tWaitFd) != 0 {
            setWord(items, 3 * at, word(t, tWaitFd) - 1)
            setWord(items, 3 * at + 1, word(t, tWaitWrite))
            at += 1
        }
    }
    let _ = osPoll(items, sockets, ms)
    at = 0
    for k in 0..kept {
        let t = word(word(g, gTasks), word(word(g, gBackground), k))
        if word(t, tWaitFd) != 0 {
            if word(items, 3 * at + 2) != 0 {
                setWord(t, tWaitFd, 0) // ready: its next step tries again
            }
            at += 1
        }
    }
    true
}

// runTasks(): every task go(f) made, run until all are done (go(f) inside them adds more)
pub extern effect fn rtRunTasks(line: Int64) as "qk_runTasks" {
    if ctxGet(ctxTask) != 0 {
        return // inside a task: whoever runs the tasks runs them
    }
    while backgroundRound(line, 0.0) {}
}

// channel(): a new channel of values of slots slots each (desc: an array of their type's description, 0 when they
// hold no memory), its number
pub extern effect fn rtChannel(desc: Int64, slots: Int64) -> Int64 as "qk_channel" {
    let g = globals()
    let c = calloc(chItems, 8)
    setWord(c, chSlots, slots)
    setWord(c, chDesc, desc)
    if word(g, gChannelFree) != 0 {
        // a place let go of, a generation later
        let slot = word(g, gChannelFree) - 1
        let e = word(g, gChannels) + 8 * chanEntry * slot
        setWord(g, gChannelFree, word(e, 2))
        setWord(e, 0, c)
        return slot | word(e, 1) << 32
    }
    if word(g, gChannelCount) == word(g, gChannelCap) {
        let cap = if word(g, gChannelCap) != 0 { word(g, gChannelCap) * 2 } else { 8 }
        setWord(g, gChannels, realloc(word(g, gChannels), 8 * chanEntry * cap))
        setWord(g, gChannelCap, cap)
    }
    let n = word(g, gChannelCount)
    let e = word(g, gChannels) + 8 * chanEntry * n
    setWord(e, 0, c)
    setWord(e, 1, 0)
    setWord(e, 2, 0)
    setWord(g, gChannelCount, n + 1)
    n
}

// send(channel, value): the value (its slots at p) at the end of the queue, a copy of its own
pub extern effect fn rtSend(n: Int64, p: Int64, line: Int64) as "qk_send" {
    var c = channelAt(n, line)
    if c == 0 or word(c, chClosed) != 0 {
        panicNow(panicClosedChannel, line, n, 0)
    }
    let slots = word(c, chSlots)
    if word(c, chCount) == word(c, chCap) {
        // grown, its values from the head on put back at the start
        let cap = if word(c, chCap) != 0 { word(c, chCap) * 2 } else { 8 }
        let grown = calloc(chItems + slots * cap, 8)
        copyBytes(grown, c, 8 * chItems)
        for i in 0..word(c, chCount) {
            copyBytes(grown + 8 * (chItems + slots * i), channelItem(c, i), 8 * slots)
        }
        setWord(grown, chHead, 0)
        setWord(grown, chCap, cap)
        free(c)
        setWord(channelEntry(n), 0, grown)
        c = grown
    }
    let at = channelItem(c, word(c, chCount))
    copyBytes(at, p, 8 * slots)
    setWord(c, chCount, word(c, chCount) + 1)
    gSet(gChannelQueued, gGet(gChannelQueued) + 1)
    if word(c, chDesc) != 0 {
        channelKeep(at, word(c, chDesc))
        let made = word(gGet(gChannelArena), aAllocated)
        if made > channelArenaLeast and made > 2 * gGet(gChannelKept) {
            channelArenaRemade()
        }
    }
}

// receive(channel) -> T? (within: seconds at most, -1 as long as it takes; optSlots: the T?'s slots): the first
// value sent and not yet received; None once it is closed and empty, or when the time is over. Waits: in a task,
// its turn back until a value comes; outside one, the background tasks run until one does.
pub extern effect fn rtReceive(n: Int64, within: Float64, optSlots: Int64, line: Int64) -> Int64 as "qk_receive" {
    let _ = channelAt(n, line)
    let p = alloc(optSlots, 8) // the optional: [Some or None][the value's slots]
    let until = if within >= 0.0 { osNow() + within } else { 0.0 }
    while not channelReady(n) {
        if until != 0.0 and osNow() >= until {
            return p // the time is over
        }
        let t = ctxGet(ctxTask)
        if t != 0 {
            setWord(t, tWaitChannel, n + 1)
            setFloat(t, tWakeAt, until)
            rtYield()
            setWord(ctxGet(ctxTask), tWaitChannel, 0)
            setFloat(ctxGet(ctxTask), tWakeAt, 0.0)
        } else if not backgroundRound(line, until) and not channelReady(n) {
            if until == 0.0 {
                panicNow(panicDeadlock, line, 0, 0) // no task is left to send on it
            }
            return p // nor will one ever come
        }
    }
    let c = channelAt(n, line)
    if c == 0 {
        return p // closed and empty: let go of
    }
    let slots = word(c, chSlots)
    if word(c, chCount) == 0 {
        channelGone(n) // closed, and every value received
        return p
    }
    setWord(p, 0, 1)
    copyBytes(p + 8, channelItem(c, 0), 8 * slots)
    setWord(c, chHead, (word(c, chHead) + 1) % word(c, chCap))
    setWord(c, chCount, word(c, chCount) - 1)
    if word(c, chDesc) != 0 {
        let k = channelCopier() // into this task's memory
        copyValue(k, p + 8, word(c, chDesc))
        copierFreshDone(k)
    }
    if word(c, chCount) == 0 and word(c, chClosed) != 0 {
        channelGone(n)
    }
    gSet(gChannelQueued, gGet(gChannelQueued) - 1)
    if gGet(gChannelQueued) == 0 and gGet(gChannelArena) != 0 {
        let was = inChannelArena(gGet(gChannelArena))
        arenaReset()
        setWord(ctx(), ctxArena, was)
        gSet(gChannelKept, 0)
    }
    p
}

// closeChannel(channel): no more values go in; receive gives those left, then None (closed and empty, it is let go
// of)
pub extern effect fn rtCloseChannel(n: Int64, line: Int64) as "qk_closeChannel" {
    let c = channelAt(n, line)
    if c == 0 {
        return
    }
    setWord(c, chClosed, 1)
    if word(c, chCount) == 0 {
        channelGone(n)
    }
}

// ---- cancelling ----
// the task t is running: it, or one that stepped it on the way here
fn running(t: Int) -> Bool {
    var a = ctxGet(ctxTask)
    while a != 0 {
        if a == t {
            return true
        }
        a = word(a, tCaller)
    }
    false
}

// the task t ends: its scope (if any) has one task less alive
fn taskEnds(t: Int) {
    let s = word(t, tScope)
    if s != 0 {
        let at = gGet(gScopes) + 16 * (s - 1)
        setWord(at, 1, word(at, 1) - 1)
    }
}

// the task n, cancelled, let go of (the call it waited for on a thread is done: its job too)
fn cancelledEnds(n: Int, t: Int) {
    let job = word(t, tWaitThread)
    if job != 0 {
        osThreadJoin(word(job, jobThread))
        free(word(job, jobCtx))
        free(job)
    }
    taskEnds(t)
    taskFree(t)
    setWord(gGet(gTasks), n, 0)
}

// cancel(task): it stops, as a panic stops it (its defers do not run), and is let go of: now when it is not running,
// else where it next gives its turn back. Waiting on a call on a thread of its own, when the call is done (it writes
// to the task's memory). Ended already: nothing.
pub extern effect fn rtCancel(n: Int64, line: Int64) as "qk_cancel" {
    let g = globals()
    if n < 0 or n >= word(g, gTaskCount) {
        panicNow(panicTask, line, n, 0)
    }
    let t = word(word(g, gTasks), n)
    if t == 0 {
        return
    }
    setWord(t, tCancelled, 1)
    if not running(t) and not waitsOnThread(t) {
        cancelledEnds(n, t)
    }
}

// ---- scopes: tasks that end before what started them goes on ----
// scope(body) opens a scope, runs body(scope) and then waits for every task scope.start(f) made in it (those they
// start in it too): no task of it outlives it. A task's panic stops the program, its message saying the line that
// started the task.
fn scopeAlive(s: Int) -> Int = word(gGet(gScopes) + 16 * s, 1)

pub extern effect fn rtScopeOpen() -> Int64 as "qk_scopeOpen" {
    let g = globals()
    if word(g, gScopeCount) == word(g, gScopeCap) {
        let cap = if word(g, gScopeCap) != 0 { word(g, gScopeCap) * 2 } else { 8 }
        setWord(g, gScopes, realloc(word(g, gScopes), 16 * cap))
        setWord(g, gScopeCap, cap)
    }
    let n = word(g, gScopeCount)
    let at = word(g, gScopes) + 16 * n
    setWord(at, 0, 1)
    setWord(at, 1, 0)
    setWord(g, gScopeCount, n + 1)
    n
}

// scope.start(f): a task of f, in the background, the scope's
pub extern effect fn rtScopeStart(s: Int64, f: Int64, env: Int64, line: Int64) -> Int64 as "qk_scopeStart" {
    if s < 0 or s >= gGet(gScopeCount) or word(gGet(gScopes) + 16 * s, 0) == 0 {
        panicNow(panicScopeClosed, line, s, 0)
    }
    let n = rtGo(f, env)
    let t = word(gGet(gTasks), n)
    setWord(t, tScope, s + 1)
    setWord(t, tStartLine, line)
    let at = gGet(gScopes) + 16 * s
    setWord(at, 1, word(at, 1) + 1)
    n
}

// the end of scope s's body: every task of it run to its end (in a task, its turn back meanwhile), then it closes
pub extern effect fn rtScopeClose(s: Int64, line: Int64) as "qk_scopeClose" {
    while scopeAlive(s) > 0 {
        let t = ctxGet(ctxTask)
        if t != 0 {
            setWord(t, tWaitScope, s + 1)
            rtYield()
            setWord(ctxGet(ctxTask), tWaitScope, 0)
        } else if not backgroundRound(line, 0.0) {
            break
        }
    }
    setWord(gGet(gScopes) + 16 * s, 0, 0)
    // its place used again when it was the last one opened (scopes nest)
    if s == gGet(gScopeCount) - 1 {
        gSet(gScopeCount, s)
    }
}
""" + "\n"
    }
    if name == "text" {
        return r"""
// Texts: made in the arena as [length: 8 bytes][bytes], and the code reads both. Optionals and results as the
// code reads them, and what texts are made of: UTF-8, numbers, cases.
use base
use arena

pub fn makeText(p: Int, n: Int) -> Int {
    let t = allocRaw(n + 8, 1)
    setWord(arena(), aLastText, t)
    setWord(t, 0, n)
    copyBytes(t + 8, p, n)
    t
}

pub fn literal(t: Text) -> Int = makeText(textAt(t), len(t))

// an optional: [1 or 0][the value's two slots]
pub fn optional(has: Bool, a: Int, b: Int) -> Int {
    let p = alloc(3, 8)
    if has {
        setWord(p, 0, 1)
        setWord(p, 1, a)
        setWord(p, 2, b)
    }
    p
}

// a result: [1 or 0][the message (bytes, length)][the value's two slots]
// a result's slots (types.qk's caseLayout): its case, then Err's message or Ok's value from slot 1, a Float's after
// the message (a slot keeps its kind)
pub fn okResult(a: Int, b: Int) -> Int {
    let p = alloc(5, 8)
    setWord(p, 0, 1)
    setWord(p, 1, a)
    setWord(p, 2, b)
    p
}

pub fn okFloatResult(bits: Int) -> Int {
    let p = alloc(5, 8)
    setWord(p, 0, 1)
    setWord(p, 3, bits)
    p
}

pub fn errResult(m: Buf) -> Int {
    let p = alloc(5, 8)
    let bytes = alloc(m.n + 1, 1)
    copyBytes(bytes, m.p, m.n)
    setWord(p, 1, bytes)
    setWord(p, 2, m.n)
    p
}

// room for a message, in the arena (what a result keeps is copied out of it)
pub fn message() -> Buf = bufAt(alloc(1024, 1), 1024)

// a text as a C string (zero-ended), in the arena
pub fn cString(p: Int, n: Int) -> Int {
    let s = alloc(n + 1, 1)
    copyBytes(s, p, n)
    s
}

// an array of texts as the code reads it: [count][(bytes, length)...]
pub fn textArray(count: Int) -> Int {
    let p = alloc(1 + 2 * count, 8)
    setWord(p, 0, count)
    p
}

// ---- joining ----
// s + t where s is the last text the arena made and nothing came after it: t goes on its end, in place
fn appendInPlace(x: Int, xn: Int, y: Int, yn: Int) -> Int {
    let ar = arena()
    let cur = word(ar, aCurrent)
    let p = word(ar, aLastText)
    if cur == 0 or p == 0 or p + 8 != x or xn <= 0 {
        return 0
    }
    let had = word(p, 0)
    let oldBytes = align16(had + 8)
    let newBytes = align16(xn + yn + 8)
    if had != xn
        or p + oldBytes != word(cur, bData) + word(cur, bUsed)
        or word(cur, bUsed) - oldBytes + newBytes > word(cur, bSize) {
        return 0
    }
    setWord(cur, bUsed, word(cur, bUsed) + newBytes - oldBytes)
    setWord(ar, aAllocated, word(ar, aAllocated) + newBytes - oldBytes)
    moveBytes(p + 8 + xn, y, yn)
    setWord(p, 0, xn + yn)
    p
}

const textRoomFrom = 128

// the room of the text (bytes, n) when it is the whole of what its room holds, else 0
pub fn textRoom(a: Int, p: Int, n: Int) -> Int {
    if n < textRoomFrom {
        return 0
    }
    let room = growingRoom(a, p - 8)
    if room == 0 {
        return 0
    }
    if word(p - 8, 0) == n { room } else { 0 }
}

pub fn textJoin(x: Int, xn: Int, y: Int, yn: Int) -> Int {
    let q = appendInPlace(x, xn, y, yn)
    if q != 0 {
        return q
    }
    let n = xn + yn
    let room = textRoom(arena(), x, xn)
    if n + 8 <= room {
        // in its room
        let t = x - 8
        moveBytes(t + 8 + xn, y, yn)
        setWord(t, 0, n)
        return t
    }
    let cap = if xn >= textRoomFrom {
        2 * n + 8 // room to grow: the next join writes in place
    } else {
        n + 8
    }
    let p = allocRaw(cap, 1)
    setWord(arena(), aLastText, p)
    setWord(p, 0, n)
    copyBytes(p + 8, x, xn)
    copyBytes(p + 8 + xn, y, yn)
    if cap > n + 8 {
        growingAdd(arena(), p, cap)
    }
    p
}

pub extern effect fn rtTextJoin(x: Int64, xn: Int64, y: Int64, yn: Int64) -> Int64 as "qk_textJoin" =
    textJoin(x, xn, y, yn)

pub fn textCompare(x: Int, xn: Int, y: Int, yn: Int) -> Int {
    let c = compareBytes(x, y, if xn < yn { xn } else { yn })
    if c != 0 {
        return if c < 0 { -1 } else { 1 }
    }
    if xn < yn {
        -1
    } else if xn > yn {
        1
    } else {
        0
    }
}

pub extern effect fn rtTextCompare(x: Int64, xn: Int64, y: Int64, yn: Int64) -> Int64 as "qk_textCompare" =
    textCompare(x, xn, y, yn)

pub extern effect fn rtTextOfInt(v: Int64) -> Int64 as "qk_textOfInt" {
    let b = bufAt(ctx() + 8 * ctxScratch, 32).int(v) // (the digits in the context's scratch: nothing made for them)
    makeText(b.p, b.n)
}

// the digits of v (and its sign): how many
fn digitCount(v: Int) -> Int {
    if v == intMin {
        return 20
    }
    var n = if v < 0 { 2 } else { 1 }
    var u = if v < 0 { -v } else { v }
    while u >= 10 {
        u = u / 10
        n += 1
    }
    n
}

// "a{x}b{n}...": the text of an interpolation's k pieces at d, made at once (its length first, then its bytes):
// each piece three words, [0][bytes][length] a text, [1][the Int][0] an Int's digits
pub extern effect fn rtInterp(d: Int64, k: Int64) -> Int64 as "qk_interp" {
    var n = 0
    for i in 0..k {
        let at = d + 24 * i
        n += if word(at, 0) == 0 { word(at, 2) } else { digitCount(word(at, 1)) }
    }
    let t = allocRaw(n + 8, 1)
    setWord(arena(), aLastText, t)
    setWord(t, 0, n)
    var w = t + 8
    for i in 0..k {
        let at = d + 24 * i
        if word(at, 0) == 0 {
            copyBytes(w, word(at, 1), word(at, 2))
            w += word(at, 2)
        } else {
            let b = bufAt(ctx() + 8 * ctxScratch, 32).int(word(at, 1))
            copyBytes(w, b.p, b.n)
            w += b.n
        }
    }
    t
}

// x + the digits of v: written from the context's scratch onto x (in place when x has room)
pub extern effect fn rtJoinInt(x: Int64, xn: Int64, v: Int64) -> Int64 as "qk_joinInt" {
    let b = bufAt(ctx() + 8 * ctxScratch, 32).int(v)
    textJoin(x, xn, b.p, b.n)
}

pub extern effect fn rtTextOfFloat(v: Float64) -> Int64 as "qk_textOfFloat" {
    let s = ctx() + 8 * ctxScratch
    makeText(s, floatText(s, v))
}

// ---- pieces ----
pub fn isSpace(c: Int) -> Bool = c <= ' ' and (c == ' ' or c == '\t' or c == '\n' or c == '\r')

const spaceBytes = 2387225703656530209 // 0x2121212121212121: a byte below it is ' ' or a control byte

// the first byte at or after i that may be a space (one at most ' '), eight at a time; else where the words end
fn nextSpaceLike(t: Int, i0: Int, n: Int) -> Int {
    var i = i0
    while i + 8 <= n {
        let x = Pointer<Int64>(t + i)[0]
        if (x -% spaceBytes) & ~x & highBits != 0 {
            break
        }
        i += 8
    }
    i
}

// the pieces of t between separators (sn 0: words, between spaces), in one pass: each piece's (bytes, length) into
// a buffer of C's that grows, then the array made once, of the right size
pub fn splitText(t: Int, n: Int, sep: Int, sn: Int) -> Int {
    var cap = 256
    var buf = malloc(cap * 16)
    var count = 0
    var i = 0
    while i <= n {
        var start = 0
        var end = 0
        if sn == 0 {
            // words
            while i < n and isSpace(byte(t, i)) {
                i += 1
            }
            if i >= n {
                break
            }
            start = i
            while i < n {
                i = nextSpaceLike(t, i, n) // a word's bytes, skipped eight at a time
                if i >= n or isSpace(byte(t, i)) {
                    break
                }
                i += 1
            }
            end = i
        } else {
            start = i
            let k = findBytes(t, i, n, sep, sn)
            end = if k < 0 { n } else { k }
            i = end + sn // past the separator; past the end after the last piece
            if end == n {
                i = n + 1
            }
        }
        if count == cap {
            cap *= 2
            buf = realloc(buf, cap * 16)
        }
        setWord(buf, 2 * count, t + start)
        setWord(buf, 2 * count + 1, end - start)
        count += 1
    }
    let p = textArray(count)
    copyBytes(p + 8, buf, count * 16)
    free(buf)
    p
}

pub extern effect fn rtSplit(t: Int64, n: Int64, sep: Int64, sn: Int64) -> Int64 as "qk_split" =
    splitText(t, n, sep, sn)

pub extern effect fn rtWords(t: Int64, n: Int64) -> Int64 as "qk_words" = splitText(t, n, 0, 0)

pub extern effect fn rtLines(t: Int64, n0: Int64) -> Int64 as "qk_lines" {
    var n = n0
    if n != 0 and byte(t, n - 1) == '\n' {
        n -= 1
    }
    if n == 0 {
        return textArray(0)
    }
    let p = splitText(t, n, textAt("\n"), 1)
    for i in 0..word(p, 0) {
        let s = word(p, 1 + 2 * i)
        let k = word(p, 2 + 2 * i)
        if k != 0 and byte(s, k - 1) == '\r' {
            setWord(p, 2 + 2 * i, k - 1)
        }
    }
    p
}

pub extern effect fn rtTrim(t: Int64, n: Int64) -> Int64 as "qk_trim" {
    var a = 0
    var b = n
    while a < b and isSpace(byte(t, a)) {
        a += 1
    }
    while b > a and isSpace(byte(t, b - 1)) {
        b -= 1
    }
    makeText(t + a, b - a)
}

pub extern effect fn rtCodePointCount(t: Int64, n: Int64) -> Int64 as "qk_codePointCount" {
    var count = 0
    for i in 0..n {
        if i == 0 or byte(t, i) & 192 != 128 {
            count += 1
        }
    }
    count
}

// t[lo..hi]: 0 when both ends are between characters, else 1 + the byte that cuts one
pub extern effect fn rtTextCut(t: Int64, n: Int64, lo: Int64, hi: Int64) -> Int64 as "qk_textCut" {
    if lo > 0 and lo < n and byte(t, lo) & 192 == 128 {
        return lo + 1
    }
    if hi > 0 and hi < n and byte(t, hi) & 192 == 128 {
        return hi + 1
    }
    0
}

pub extern effect fn rtStartsWith(t: Int64, n: Int64, s: Int64, sn: Int64) -> Int64 as "qk_startsWith" =
    if sn <= n and sameBytes(t, s, sn) { 1 } else { 0 }

pub extern effect fn rtEndsWith(t: Int64, n: Int64, s: Int64, sn: Int64) -> Int64 as "qk_endsWith" =
    if sn <= n and sameBytes(t + n - sn, s, sn) { 1 } else { 0 }

pub fn find(t: Int, n: Int, part: Int, pn: Int) -> Int = findBytes(t, 0, n, part, pn)

pub extern effect fn rtFind(t: Int64, n: Int64, part: Int64, pn: Int64) -> Int64 as "qk_find" =
    find(t, n, part, pn)

pub extern effect fn rtReplace(t: Int64, n: Int64, old: Int64, on: Int64, by: Int64, wn: Int64) -> Int64 as "qk_replace" {
    if on == 0 {
        return makeText(t, n)
    }
    var total = 0 // first how long, then the bytes
    var i = 0
    while i < n {
        let k = findBytes(t, i, n, old, on)
        if k < 0 {
            total += n - i
            break
        }
        total += k - i + wn
        i = k + on
    }
    let p = allocRaw(total + 8, 1)
    setWord(arena(), aLastText, p)
    setWord(p, 0, total)
    var w = p + 8
    i = 0
    while i < n {
        let k = findBytes(t, i, n, old, on)
        let upTo = if k < 0 { n } else { k }
        copyBytes(w, t + i, upTo - i)
        w += upTo - i
        if k < 0 {
            break
        }
        copyBytes(w, by, wn)
        w += wn
        i = k + on
    }
    p
}

pub extern effect fn rtRepeat(t: Int64, n: Int64, times: Int64) -> Int64 as "qk_repeat" {
    if times <= 0 or n == 0 {
        return makeText(0, 0)
    }
    let p = allocRaw(n * times + 8, 1)
    setWord(p, 0, n * times)
    for i in 0..times {
        copyBytes(p + 8 + i * n, t, n)
    }
    p
}

// join(texts, separator): an array of (bytes, length) pairs
pub extern effect fn rtJoin(items: Int64, count: Int64, sep: Int64, sn: Int64) -> Int64 as "qk_join" {
    var total = 0
    for i in 0..count {
        total += word(items, 2 * i + 1) + (if i != 0 { sn } else { 0 })
    }
    let p = allocRaw(total + 8, 1)
    setWord(p, 0, total)
    var w = p + 8
    for i in 0..count {
        if i != 0 and sn != 0 {
            copyBytes(w, sep, sn)
            w += sn
        }
        copyBytes(w, word(items, 2 * i), word(items, 2 * i + 1))
        w += word(items, 2 * i + 1)
    }
    p
}

// "{x:.2}": a number with so many decimals
pub extern effect fn rtTextFixed(v: Float64, decimals: Int64) -> Int64 as "qk_textFixed" {
    let d = if decimals < 0 {
        0
    } else if decimals > 40 {
        40
    } else {
        decimals
    }
    let s = alloc(400, 1)
    let n = fixedText(s, v, d)
    makeText(s, if n < 400 { n } else { 399 })
}

// "{x:8}": at least so wide, with spaces in front
pub extern effect fn rtPad(t: Int64, n: Int64, width: Int64) -> Int64 as "qk_pad" {
    var chars = 0
    for i in 0..n {
        if byte(t, i) & 192 != 128 {
            chars += 1
        }
    }
    let pad = if width > chars { width - chars } else { 0 }
    let p = allocRaw(n + pad + 8, 1)
    setWord(p, 0, n + pad)
    let _ = memset(p + 8, ' ', pad)
    copyBytes(p + 8 + pad, t, n)
    p
}

// ---- characters (UTF-8) ----
// the bytes that are not UTF-8: the first one that is not part of a character, or -1
pub fn utf8Invalid(s: Int, n: Int) -> Int {
    var i = 0
    while i < n {
        let c = byte(s, i)
        if c < 128 {
            i += 1
            continue
        }
        var more = 0
        var lo = 128
        var hi = 191 // what the second byte may be
        if c >= 194 and c <= 223 {
            more = 1
        } else if c >= 224 and c <= 239 {
            more = 2
            if c == 224 {
                lo = 160 // overlong
            } else if c == 237 {
                hi = 159 // a surrogate
            }
        } else if c >= 240 and c <= 244 {
            more = 3
            if c == 240 {
                lo = 144
            } else if c == 244 {
                hi = 143 // past 0x10FFFF
            }
        } else {
            return i
        }
        if i + more >= n {
            return i
        }
        if byte(s, i + 1) < lo or byte(s, i + 1) > hi {
            return i
        }
        for k in 2..more + 1 {
            if byte(s, i + k) < 128 or byte(s, i + k) > 191 {
                return i
            }
        }
        i += 1 + more
    }
    -1
}

pub type Decoded { c: Int, next: Int }

// the character at t[i] (and where the next one starts); a byte that starts no character is itself
pub fn decodeChar(t: Int, n: Int, i: Int) -> Decoded {
    let c = byte(t, i)
    var more = if c >= 240 and c < 248 {
        3
    } else if c >= 224 {
        2
    } else if c >= 192 {
        1
    } else {
        0
    }
    if c >= 248 or c >= 128 and c < 192 or i + more >= n + (if more != 0 { 0 } else { 1 }) {
        more = 0
    }
    var v = if more == 3 {
        c & 7
    } else if more == 2 {
        c & 15
    } else if more == 1 {
        c & 31
    } else {
        c
    }
    for k in 1..more + 1 {
        if byte(t, i + k) & 192 != 128 {
            more = 0
            v = c
            break
        }
        v = v << 6 | byte(t, i + k) & 63
    }
    Decoded(v, i + 1 + more)
}

pub fn charBytes(c: Int) -> Int = if c < 128 {
    1
} else if c < 2048 {
    2
} else if c < 65536 {
    3
} else {
    4
}

pub fn encodeChar(c: Int, out: Int) -> Int {
    if c < 128 {
        setByte(out, 0, c)
        return 1
    }
    if c < 2048 {
        setByte(out, 0, 192 | c >> 6)
        setByte(out, 1, 128 | c & 63)
        return 2
    }
    if c < 65536 {
        setByte(out, 0, 224 | c >> 12)
        setByte(out, 1, 128 | c >> 6 & 63)
        setByte(out, 2, 128 | c & 63)
        return 3
    }
    setByte(out, 0, 240 | c >> 18)
    setByte(out, 1, 128 | c >> 12 & 63)
    setByte(out, 2, 128 | c >> 6 & 63)
    setByte(out, 3, 128 | c & 63)
    4
}

fn odd(c: Int) -> Bool = c & 1 == 1

// a letter's other case: Latin (with its accents), Greek, Cyrillic, Armenian, the full-width Latin letters
fn otherCase(c: Int, upper: Bool) -> Int {
    if upper {
        if c >= 'a' and c <= 'z' {
            return c - 32
        }
        if c >= 224 and c <= 254 and c != 247 {
            return c - 32
        }
        if c == 255 {
            return 376
        }
        if (c >= 256 and c <= 311 or c >= 330 and c <= 375) and odd(c) {
            return c - 1
        }
        if (c >= 313 and c <= 328 or c >= 377 and c <= 382) and not odd(c) {
            return c - 1
        }
        if c >= 945 and c <= 969 and c != 962 {
            return c - 32
        }
        if c == 962 {
            return 931
        }
        if c == 940 {
            return 902
        }
        if c >= 941 and c <= 943 {
            return c - 37
        }
        if c == 972 {
            return 908
        }
        if c == 973 or c == 974 {
            return c - 63
        }
        if c >= 1072 and c <= 1103 {
            return c - 32
        }
        if c >= 1104 and c <= 1119 {
            return c - 80
        }
        if (c >= 1120 and c <= 1153 or c >= 1162 and c <= 1215 or c >= 1232 and c <= 1327) and odd(c) {
            return c - 1
        }
        if c >= 1377 and c <= 1414 {
            return c - 48
        }
        if (c >= 7680 and c <= 7829 or c >= 7840 and c <= 7935) and odd(c) {
            return c - 1
        }
        if c >= 65345 and c <= 65370 {
            return c - 32
        }
        return c
    }
    if c >= 'A' and c <= 'Z' {
        return c + 32
    }
    if c >= 192 and c <= 222 and c != 215 {
        return c + 32
    }
    if c == 376 {
        return 255
    }
    if (c >= 256 and c <= 311 or c >= 330 and c <= 375) and not odd(c) {
        return c + 1
    }
    if (c >= 313 and c <= 328 or c >= 377 and c <= 382) and odd(c) {
        return c + 1
    }
    if c >= 913 and c <= 937 and c != 930 {
        return c + 32
    }
    if c == 902 {
        return 940
    }
    if c >= 904 and c <= 906 {
        return c + 37
    }
    if c == 908 {
        return 972
    }
    if c == 910 or c == 911 {
        return c + 63
    }
    if c >= 1040 and c <= 1071 {
        return c + 32
    }
    if c >= 1024 and c <= 1039 {
        return c + 80
    }
    if (c >= 1120 and c <= 1153 or c >= 1162 and c <= 1215 or c >= 1232 and c <= 1327) and not odd(c) {
        return c + 1
    }
    if c >= 1329 and c <= 1366 {
        return c + 48
    }
    if (c >= 7680 and c <= 7829 or c >= 7840 and c <= 7935) and not odd(c) {
        return c + 1
    }
    if c >= 65313 and c <= 65338 {
        return c + 32
    }
    c
}

// upper / lower: into out when not 0; the length either way
fn caseInto(t: Int, n: Int, upper: Bool, out: Int) -> Int {
    var w = 0
    var i = 0
    while i < n {
        let at = i
        let d = decodeChar(t, n, i)
        i = d.next
        if d.c >= 128 and i - at == 1 {
            // a stray byte: as it was
            if out != 0 {
                setByte(out, w, d.c)
            }
            w += 1
            continue
        }
        let c = otherCase(d.c, upper)
        if out != 0 {
            let _ = encodeChar(c, out + w)
        }
        w += charBytes(c)
    }
    w
}

fn textCase(t: Int, n: Int, upper: Bool) -> Int {
    var ascii = true
    for i in 0..n {
        if byte(t, i) >= 128 {
            ascii = false
        }
    }
    if ascii {
        let p = makeText(t, n)
        for i in 0..n {
            let c = byte(p, 8 + i)
            if upper and c >= 'a' and c <= 'z' {
                setByte(p, 8 + i, c - 32)
            }
            if not upper and c >= 'A' and c <= 'Z' {
                setByte(p, 8 + i, c + 32)
            }
        }
        return p
    }
    let total = caseInto(t, n, upper, 0)
    let p = allocRaw(total + 8, 1)
    setWord(arena(), aLastText, p)
    setWord(p, 0, total)
    let _ = caseInto(t, n, upper, p + 8)
    p
}

pub extern effect fn rtUpper(t: Int64, n: Int64) -> Int64 as "qk_upper" = textCase(t, n, true)

pub extern effect fn rtLower(t: Int64, n: Int64) -> Int64 as "qk_lower" = textCase(t, n, false)

// char(n): the code point's character; a panic for what is not one
pub extern effect fn rtChar(cp: Int64, line: Int64) -> Int64 as "qk_char" {
    if cp < 0 or cp > 1114111 or cp >= 55296 and cp <= 57343 {
        panicNow(panicChar, line, cp, 0)
    }
    let p = alloc(16, 1)
    let n = encodeChar(cp, p + 8)
    setWord(p, 0, n)
    setWord(arena(), aLastText, p)
    p
}

// ---- bytes ----
// Text(b) -> Text!: the same bytes when they are UTF-8 (no copy)
pub extern effect fn rtTextOfBytes(p: Int64, n: Int64) -> Int64 as "qk_textOfBytes" {
    let bad = utf8Invalid(p, n)
    if bad < 0 {
        return okResult(p, n)
    }
    errResult(message().text("not UTF-8: byte ").int(bad).text(" is not part of a character"))
}

// b.push(x): one byte more, as s + t grows a text
pub extern effect fn rtBytesPush(p: Int64, n: Int64, b: Int64) -> Int64 as "qk_bytesPush" {
    let one = ctx() + 8 * ctxScratch
    setByte(one, 0, b)
    textJoin(p, n, one, 1)
}

// ---- C: texts across the boundary ----
// a Text for C: its bytes and a zero, in the arena
pub extern effect fn rtCText(p: Int64, n: Int64) -> Int64 as "qk_cText" = cString(p, n)

// bytes C gives as a Text (n < 0: up to their zero; 0: an empty text), copied: the address of its two slots
pub extern effect fn rtTextOfC(p: Int64, n0: Int64) -> Int64 as "qk_textOfC" {
    let r = alloc(2, 8)
    let n = if p == 0 {
        0
    } else if n0 < 0 {
        strlen(p)
    } else {
        n0
    }
    setWord(r, 0, cString(p, n))
    setWord(r, 1, n)
    r
}

// ---- numbers ----
// Err's message: why, and the text in quotes (its first 40 characters, then "…")
fn notANumber(why: Text, t: Int, n: Int) -> Int {
    var cut = 0
    var chars = 0
    while cut < n and chars < 40 {
        cut += 1
        while cut < n and byte(t, cut) & 192 == 128 {
            cut += 1
        }
        chars += 1
    }
    let m = message().text(why).text(": \"").bytes(t, cut)
    errResult(if cut < n { m.text("…\"") } else { m.text("\"") })
}

// the whole text is an Int: a sign or none, then decimal digits (as C's strtoll reads them, without spaces); past an
// Int's limits, "too big" (counted negative, so the least Int fits)
pub extern effect fn rtParseInt(t: Int64, n: Int64) -> Int64 as "qk_parseInt" {
    var i = 0
    let negative = n > 0 and byte(t, 0) == '-'
    if n > 0 and (byte(t, 0) == '-' or byte(t, 0) == '+') {
        i = 1
    }
    if i >= n {
        return notANumber("not a number", t, n)
    }
    var v = 0 // minus the number so far
    var over = false
    while i < n {
        let c = byte(t, i)
        if c < '0' or c > '9' {
            return notANumber("not a number", t, n)
        }
        let d = c - '0'
        if v < (intMin + d + 9) / 10 {
            // (v * 10 - d would go past the least Int: / rounds down, so + 9 makes it the ceiling)
            over = true
        } else {
            v = v * 10 - d
        }
        i += 1
    }
    if over or not negative and v == intMin {
        return notANumber("too big for an Int", t, n)
    }
    okResult(if negative { v } else { -v }, 0)
}

pub extern effect fn rtParseFloat(t: Int64, n: Int64) -> Int64 as "qk_parseFloat" {
    let out = alloc(1, 8)
    if not textFloat(t, n, out) {
        return notANumber("not a number", t, n)
    }
    okFloatResult(word(out, 0))
}
""" + "\n"
    }
    if name == "threads" {
        return r"""
// parallelMap and parallelFold: the elements shared out to threads. Each worker has a context of its own and loads the
// code again (its addresses are its thread's), then runs f on its elements (parallelFold: folds its part from the
// start); a panic in one stops the call with its message. Results that hold memory (texts, arrays, maps) are copied
// out of the worker's memory as each is made, into memory the worker keeps, and from there into the caller's when
// every worker is done.
use base
use arena
use loader
use loops

extern effect fn osProcessors() -> Int64 as "qkosProcessors"
extern effect fn osThreadStart(f: Int64, arg: Int64) -> Int64 as "qkosThreadStart" // a handle, or 0
extern effect fn osThreadJoin(h: Int64) as "qkosThreadJoin"
extern fn workerAddress(f: extern (Int64) -> Int64) -> Int64 as "qkTextAddress"

// a worker's words
const wFrom = 0
const wEntry = 1 // the function's offset in the code
const wEnv = 2 // its captured values, after the element's slots
const wIn = 3
const wOut = 4
const wFirst = 5
const wLast = 6
const wInSlots = 7
const wOutSlots = 8
const wFuel = 9
const wFailed = 10
const wGlobals = 11
const wHandle = 12
const wFold = 13 // 0: map; else the accumulator (malloc'd, wOutSlots of it), its part folded into it
const wCounted = 14 // the program counts (heap.qk): the worker's memory from a counted heap of its own
const wDesc = 15 // results that hold memory: an array of them's description (else 0)
const wKeep = 16 // ... and the arena they are kept in
const wStride = 17 // the worker's elements: wFirst, then every wStride-th before wLast
const wText = 18 // 512 bytes
const workerWords = 82

fn runWorker(w: Int) -> Int {
    let c = calloc(ctxWords, 8)
    setWord(c, ctxFuel, word(w, wFuel))
    let a = arenaNew()
    setWord(c, ctxArena, a)
    setWord(c, ctxGlobals, word(w, wGlobals))
    let was = ctx()
    setCtx(c)
    let copy = loadAgain(word(w, wFrom))
    if copy == 0 {
        setWord(w, wFailed, 1)
        let _ = bufAt(w + 8 * wText, panicTextSize).text("parallelMap: a thread could not load the program")
    } else {
        let args = malloc(8 * 64)
        let inSlots = word(w, wInSlots)
        let outSlots = word(w, wOutSlots)
        let acc = word(w, wFold)
        let lead = if acc != 0 {
            outSlots // fold: the accumulator first
        } else {
            0
        }
        let desc = word(w, wDesc)
        var keeper = 0
        if desc != 0 {
            let main = word(w, wFrom)
            setWord(w, wKeep, arenaNew())
            keeper = copierInto(word(w, wKeep), word(copy, lData), word(main, lDataLen), word(main, lData))
        }
        var i = word(w, wFirst)
        while i < word(w, wLast) and word(w, wFailed) == 0 {
            if acc != 0 {
                copyBytes(args, acc, 8 * outSlots)
            }
            copyBytes(args + 8 * lead, word(w, wIn) + 8 * i * inSlots, 8 * inSlots)
            setWord(args, lead + inSlots, word(w, wEnv))
            let to = if acc != 0 { acc } else { word(w, wOut) + 8 * i * outSlots }
            if not runEntry(copy, word(copy, lCode) + word(w, wEntry), args, lead + inSlots + 1, to, outSlots) {
                setWord(w, wFailed, 1)
                copyBytes(w + 8 * wText, c + 8 * ctxPanicText, panicTextSize)
            } else if desc != 0 {
                // before the next element's run clears this thread's memory
                copyValue(keeper, to, desc)
                copierForget(keeper)
            }
            i += word(w, wStride)
        }
        free(args)
        if keeper != 0 {
            copierDone(keeper)
        }
        unload(copy)
    }
    arenaFree(word(c, ctxArena))
    setCtx(was)
    free(c)
    0
}

pub extern effect fn rtParallelMap(
    f: Int64,
    env: Int64,
    input: Int64,
    n: Int64,
    inSlots: Int64,
    outSlots: Int64,
    line: Int64,
    desc: Int64,
) -> Int64 as "qk_parallelMap" {
    if inSlots > 63 {
        panicNow(panicSize, line, inSlots, 0)
    }
    let out = alloc(n, outSlots * 8)
    let l = ctxGet(ctxRunning)
    let threads = threadsFor(n)
    // (results that hold memory in a counted program: here, made in its heap)
    if l == 0 or threads <= 1 or n < 2 {
        // here, one after the other
        let args = malloc(8 * 64)
        for i in 0..n {
            copyBytes(args, input + 8 * i * inSlots, 8 * inSlots)
            setWord(args, inSlots, env)
            if not runEntry(l, f, args, inSlots + 1, out + 8 * i * outSlots, outSlots) {
                free(args)
                stopNow()
            }
        }
        free(args)
        return out
    }
    // the elements dealt out in turn (worker t: t, t + threads, ...): the slow ones, often side by side, are shared
    let ws = calloc(threads * workerWords, 8)
    for t in 0..threads {
        let w = ws + 8 * workerWords * t
        setWord(w, wFrom, l)
        setWord(w, wEntry, f - word(l, lCode))
        setWord(w, wEnv, env)
        setWord(w, wIn, input)
        setWord(w, wOut, out)
        setWord(w, wFirst, t)
        setWord(w, wLast, n)
        setWord(w, wStride, threads)
        setWord(w, wInSlots, inSlots)
        setWord(w, wOutSlots, outSlots)
        setWord(w, wFuel, ctxGet(ctxFuel))
        setWord(w, wGlobals, globals())
        setWord(w, wDesc, desc)
    }
    let start = workerAddress(w => runWorker(w))
    for t in 0..threads {
        let w = ws + 8 * workerWords * t
        setWord(w, wHandle, osThreadStart(start, w))
    }
    for t in 0..threads {
        let w = ws + 8 * workerWords * t
        if word(w, wHandle) != 0 {
            osThreadJoin(word(w, wHandle))
        } else {
            let _ = runWorker(w)
        }
    }
    var failed = -1
    let into = if desc != 0 { copierInto(arena(), 0, 0, 0) } else { 0 }
    for t in 0..threads {
        let w = ws + 8 * workerWords * t
        if word(w, wFailed) != 0 and failed < 0 {
            failed = t
        }
        if word(w, wKeep) != 0 {
            var i = t
            while failed < 0 and i < n {
                copyValue(into, out + 8 * i * outSlots, desc)
                i += threads
            }
            arenaFree(word(w, wKeep))
        }
    }
    if into != 0 {
        copierDone(into)
    }
    if failed >= 0 {
        copyBytes(panicText(), ws + 8 * workerWords * failed + 8 * wText, panicTextSize)
        free(ws)
        stopNow()
    }
    free(ws)
    out
}

// the threads for n elements: the processor's (64 at most), fewer for few elements
fn threadsFor(n: Int) -> Int {
    var threads = osProcessors()
    if threads > 64 {
        threads = 64
    }
    if n < 2 * threads {
        threads = if n > 1 { n } else { 1 }
    }
    threads
}

// parallelFold: b holds step's code and captured values, combine's, the elements, their count, an element's slots, the
// accumulator's, the line, then the start's slots. Each thread folds its part from the start with step; the parts are
// then combined in order, from the start. Gives the accumulator's slots.
const fStep = 0
const fStepEnv = 1
const fCombine = 2
const fCombineEnv = 3
const fIn = 4
const fCount = 5
const fInSlots = 6
const fAccSlots = 7
const fLine = 8
const fStart = 9

pub extern effect fn rtParallelFold(b: Int64) -> Int64 as "qk_parallelFold" {
    let n = word(b, fCount)
    let inSlots = word(b, fInSlots)
    let accSlots = word(b, fAccSlots)
    if accSlots + inSlots > 63 or 2 * accSlots > 63 {
        panicNow(panicSize, word(b, fLine), accSlots + inSlots, 0)
    }
    let out = alloc(1, 8 * (accSlots + 1))
    copyBytes(out, b + 8 * fStart, 8 * accSlots)
    let l = ctxGet(ctxRunning)
    let threads = threadsFor(n)
    let args = malloc(8 * 64)
    if l == 0 or threads <= 1 or n < 2 {
        // here, one after the other
        for i in 0..n {
            copyBytes(args, out, 8 * accSlots)
            copyBytes(args + 8 * accSlots, word(b, fIn) + 8 * i * inSlots, 8 * inSlots)
            setWord(args, accSlots + inSlots, word(b, fStepEnv))
            if not runEntry(l, word(b, fStep), args, accSlots + inSlots + 1, out, accSlots) {
                free(args)
                stopNow()
            }
        }
        free(args)
        return out
    }
    let ws = calloc(threads * workerWords, 8)
    let each = (n + threads - 1) / threads
    for t in 0..threads {
        let w = ws + 8 * workerWords * t
        let acc = malloc(8 * (accSlots + 1))
        copyBytes(acc, b + 8 * fStart, 8 * accSlots)
        setWord(w, wFrom, l)
        setWord(w, wEntry, word(b, fStep) - word(l, lCode))
        setWord(w, wEnv, word(b, fStepEnv))
        setWord(w, wIn, word(b, fIn))
        setWord(w, wFirst, t * each)
        setWord(w, wLast, if (t + 1) * each < n { (t + 1) * each } else { n })
        setWord(w, wStride, 1)
        setWord(w, wInSlots, inSlots)
        setWord(w, wOutSlots, accSlots)
        setWord(w, wFuel, ctxGet(ctxFuel))
        setWord(w, wGlobals, globals())
        setWord(w, wFold, acc)
    }
    let start = workerAddress(w => runWorker(w))
    for t in 0..threads {
        let w = ws + 8 * workerWords * t
        setWord(w, wHandle, osThreadStart(start, w))
    }
    for t in 0..threads {
        let w = ws + 8 * workerWords * t
        if word(w, wHandle) != 0 {
            osThreadJoin(word(w, wHandle))
        } else {
            let _ = runWorker(w)
        }
    }
    var failed = false
    for t in 0..threads {
        let w = ws + 8 * workerWords * t
        if not failed and word(w, wFailed) != 0 {
            copyBytes(panicText(), w + 8 * wText, panicTextSize)
            failed = true
        }
        if not failed {
            // the parts in order: out = combine(out, part)
            copyBytes(args, out, 8 * accSlots)
            copyBytes(args + 8 * accSlots, word(w, wFold), 8 * accSlots)
            setWord(args, 2 * accSlots, word(b, fCombineEnv))
            failed = not runEntry(l, word(b, fCombine), args, 2 * accSlots + 1, out, accSlots)
        }
        free(word(w, wFold))
    }
    free(ws)
    free(args)
    if failed {
        stopNow()
    }
    out
}
""" + "\n"
    }
    if name == "trace" {
        return r"""
// The calls a panic went through, for code the command line runs (quark run, quark test): "  in pick", then
// "  called from main at line 20" for each call out to the way in, through inlined calls (which have no frames) and
// real ones (every Quark function keeps its frame pointer). The command line gives each
// program it loads its trace (host.qk); a built executable has none, and its panics say only the line.
use base

// a Loaded's word that holds its trace, 0 for none (loader.qk's words end before it)
pub const lTrace = 14

// a trace's words: what the command line fills in (compiler/memory.qk)
pub const trFnCount = 0
pub const trNames = 1 // each function's name, zero-ended
pub const trFnAt = 2 // each function's offset in the code
pub const trSiteCount = 3
pub const trSites = 4 // each call's 5 words: where it returns to, its line, caller, callee, inlined call
pub const trInlineCount = 5
pub const trInlines = 6 // each inlined call's 4 words: the one it is in (0: the function), its line, the callee's

// name, its file (0: the program's)
pub const trFiles = 7 // each function's file, zero-ended (0: the program's)

fn functionAt(t: Int, offset: Int) -> Int {
    for i in 0..word(t, trFnCount) {
        if word(word(t, trFnAt), i) == offset {
            return i
        }
    }
    -1
}

fn fnName(t: Int, i: Int) -> Int = word(word(t, trNames), i)

fn inlineAt(t: Int, i: Int) -> Int = word(t, trInlines) + 32 * i

// the file of the code a panic is in (inl: the inlined calls it is in), zero-ended; 0 the program's, or not known
pub fn panicFile(inl: Int) -> Int {
    let c = ctx()
    let l = word(c, ctxRunning)
    if l == 0 or word(l, lTrace) == 0 {
        return 0
    }
    let t = word(l, lTrace)
    if inl > 0 and inl < word(t, trInlineCount) {
        return word(inlineAt(t, inl), 3)
    }
    // the function it stopped in: the callee of the call its frame returns through, else the one the call began with
    var f = functionAt(t, word(c, ctxRunningEntry))
    let frame = word(c, ctxPanicFrame)
    if frame != 0 {
        let ret = word(frame, 1)
        for i in 0..word(t, trSiteCount) {
            let s = word(t, trSites) + 40 * i
            if word(s, 0) == ret - word(l, 0) {
                f = word(s, 3)
            }
        }
    }
    if f >= 0 and f < word(t, trFnCount) {
        word(word(t, trFiles), f)
    } else {
        0
    }
}

fn calledFrom(b: Buf, name: Int, line: Int) -> Buf =
    b.text("\n  called from ").zeroText(name).text(" at line ").int(line)

// code of the function named fnName, inside the inlined calls inl: each one, outwards
fn addInlined(b: Buf, t: Int, inl: Int, name: Int) -> Buf {
    var out = b
    var i = inl
    while i > 0 and i < word(t, trInlineCount) {
        let c = inlineAt(t, i)
        let parent = word(c, 0)
        out = calledFrom(out, if parent > 0 { word(inlineAt(t, parent), 2) } else { name }, word(c, 1))
        i = parent
    }
    out
}

fn sameCall(a: Int, b: Int) -> Bool = word(a, 2) == word(b, 2) and word(a, 1) == word(b, 1)

// the panic text so far, with the calls it went through (inl: the inlined calls the panic is in)
pub fn appendTrace(inl: Int) {
    let c = ctx()
    let l = word(c, ctxRunning)
    if l == 0 or word(l, lTrace) == 0 or word(c, ctxPanicFrame) == 0 {
        return
    }
    let t = word(l, lTrace)
    var frame = word(c, ctxPanicFrame)
    setWord(c, ctxPanicFrame, 0)
    let code = word(l, 0)
    let codeLen = word(l, 1)
    let calls = calloc(16, 8)
    var depth = 0
    while frame != 0 and depth < 16 {
        // the frames, out to the way in from C
        let ret = word(frame, 1)
        if ret < code or ret >= code + codeLen {
            break
        }
        var site = 0
        for i in 0..word(t, trSiteCount) {
            let s = word(t, trSites) + 40 * i
            if site == 0 and word(s, 0) == ret - code {
                site = s
            }
        }
        if site == 0 {
            break
        }
        setWord(calls, depth, site)
        depth += 1
        frame = word(frame, 0)
    }
    if depth == 0 and inl <= 0 {
        free(calls)
        return // it stopped in the function the call began with: nothing to add
    }
    var here = 0 // the function it stopped in: its name, 0 for one kept as a value, -1 not known
    if depth > 0 {
        let callee = word(word(calls, 0), 3)
        here = if callee >= 0 { fnName(t, callee) } else { 0 }
    } else {
        let entry = functionAt(t, word(c, ctxRunningEntry))
        here = if entry >= 0 { fnName(t, entry) } else { -1 }
    }
    let hereName = if here > 0 {
        here
    } else if here == 0 {
        textAt("a function kept as a value\0")
    } else {
        textAt("?\0")
    }
    var b = Buf(panicText(), panicTextSize, panicTextLen())
    b = b.text("\n  in ").zeroText(if inl > 0 and inl < word(t, trInlineCount) {
        word(inlineAt(t, inl), 2)
    } else {
        hereName
    })
    b = addInlined(b, t, inl, hereName)
    var i = 0
    while i < depth {
        let s = word(calls, i)
        let caller = fnName(t, word(s, 2))
        if i >= 2 and sameCall(s, word(calls, i - 1)) and sameCall(s, word(calls, i - 2)) {
            // the same call again and again: said once
            while i + 1 < depth and sameCall(word(calls, i + 1), s) {
                i += 1
            }
            b = b.text("\n  ... called from ").zeroText(caller).text(" at line ").int(word(s, 1)).text(
                ", again and again",
            )
            i += 1
            continue
        }
        let inlined = word(s, 4)
        b = calledFrom(b, if inlined > 0 and inlined < word(t, trInlineCount) {
            word(inlineAt(t, inlined), 2)
        } else {
            caller
        }, word(s, 1))
        b = addInlined(b, t, inlined, caller)
        i += 1
    }
    free(calls)
}
""" + "\n"
    }
    if name == "wasi" {
        return r"""
// The runtime's system calls in WebAssembly (wasm32, WASI preview 1: wasmtime, wasmer, a browser's shim): WASI's
// functions behind the runtime's own symbols (qkos*, as linux.qk gives them), and what the C library gives elsewhere,
// made here: the heap (malloc...), the C names the runtime calls (strlen, strtoll...), files over WASI's file
// descriptors (a FILE* is a word of ours), and the mathematics (sin, exp, pow...). memcpy, memset, floor and fabs are
// instructions (compiler/wasm.qk). One thread: no tasks on stacks of their own, no other programs, no sockets.
use std.machine as machine
use base
use print
use arena
use panic
use text
use map
use loops
use numbers
use files
use io
use tasks
use threads
use debug
use wasimath

const wasi = "wasi_snapshot_preview1"

extern effect fn fdWrite(fd: Int64, iovs: Int64, count: Int64, written: Int64) -> Int64 in "wasi_snapshot_preview1" as "fd_write"
extern effect fn fdRead(fd: Int64, iovs: Int64, count: Int64, read: Int64) -> Int64 in "wasi_snapshot_preview1" as "fd_read"
extern effect fn fdClose(fd: Int64) -> Int64 in "wasi_snapshot_preview1" as "fd_close"
extern effect fn fdSeek(fd: Int64, offset: Int64, whence: Int64, at: Int64) -> Int64 in "wasi_snapshot_preview1" as "fd_seek"
extern effect fn fdReaddir(fd: Int64, buf: Int64, n: Int64, cookie: Int64, used: Int64) -> Int64 in "wasi_snapshot_preview1" as "fd_readdir"
extern effect fn fdPrestatGet(fd: Int64, buf: Int64) -> Int64 in "wasi_snapshot_preview1" as "fd_prestat_get"
extern effect fn fdPrestatDirName(fd: Int64, path: Int64, n: Int64) -> Int64 in "wasi_snapshot_preview1" as "fd_prestat_dir_name"

extern effect fn pathOpen(
    fd: Int64,
    dirflags: Int64,
    path: Int64,
    n: Int64,
    oflags: Int64,
    base: Int64,
    inheriting: Int64,
    fdflags: Int64,
    out: Int64,
) -> Int64 in "wasi_snapshot_preview1" as "path_open"

extern effect fn pathFilestatGet(fd: Int64, flags: Int64, path: Int64, n: Int64, out: Int64) -> Int64 in "wasi_snapshot_preview1" as "path_filestat_get"
extern effect fn pathCreateDirectory(fd: Int64, path: Int64, n: Int64) -> Int64 in "wasi_snapshot_preview1" as "path_create_directory"
extern effect fn pathUnlinkFile(fd: Int64, path: Int64, n: Int64) -> Int64 in "wasi_snapshot_preview1" as "path_unlink_file"
extern effect fn pathRemoveDirectory(fd: Int64, path: Int64, n: Int64) -> Int64 in "wasi_snapshot_preview1" as "path_remove_directory"
extern effect fn argsSizesGet(count: Int64, size: Int64) -> Int64 in "wasi_snapshot_preview1" as "args_sizes_get"
extern effect fn argsGet(argv: Int64, buf: Int64) -> Int64 in "wasi_snapshot_preview1" as "args_get"
extern effect fn environSizesGet(count: Int64, size: Int64) -> Int64 in "wasi_snapshot_preview1" as "environ_sizes_get"
extern effect fn environGet(env: Int64, buf: Int64) -> Int64 in "wasi_snapshot_preview1" as "environ_get"
extern effect fn clockTimeGet(id: Int64, precision: Int64, out: Int64) -> Int64 in "wasi_snapshot_preview1" as "clock_time_get"
extern effect fn randomGet(buf: Int64, n: Int64) -> Int64 in "wasi_snapshot_preview1" as "random_get"
extern effect fn pollOneoff(subs: Int64, events: Int64, n: Int64, count: Int64) -> Int64 in "wasi_snapshot_preview1" as "poll_oneoff"
extern effect fn procExit(code: Int64) in "wasi_snapshot_preview1" as "proc_exit"

// what compiler/wasm.qk makes of these: memory.grow (pages; the old size, or -1), memory.size, the heap's start
extern effect fn memoryGrow(pages: Int64) -> Int64 as "__wasm_memory_grow"
extern effect fn memorySize() -> Int64 as "__wasm_memory_size"
extern effect fn heapBase() -> Int64 as "__wasm_heap_base"
extern effect fn slotsBase() -> Int64 as "__wasm_slots_base" // f's way in by slots: at f + this in the table

// ---- the runtime's words here (cell(): the globals, the context, errno, the heap's state) ----
fn wasiCell() -> Int = textAt("quark-wasi-runtime-cell-words-64-bytes-of-state-kept-here!!!!!!")

const wHeap = 0 // the heap's state (malloc)
const wPreopens = 1 // the folders the runtime may open: fd, name (malloc'd), as pairs; then a zero
const wErrno = 2
const wCtx = 3

// ---- the heap: sizes in steps of 16 (a free list each) up to 4 KB, larger ones by 4 KB, first fit; a block's
// size in the word before it ----
const smallMost = 4096
const largeList = 257 // the free list of larger blocks (the heap's state: 258 words, the lists' heads, then the top)
const topWord = 258

fn heap() -> Int {
    let h = word(wasiCell(), wHeap)
    if h != 0 {
        return h
    }
    // the state at the heap's start, then the blocks
    let start = (heapBase() + 15) & -16
    let have = memorySize() * 65536
    if start + 8 * 260 > have {
        let _ = memoryGrow((start + 8 * 260 - have + 65535) / 65536)
    }
    for i in 0..260 {
        setWord(start, i, 0)
    }
    setWord(start, topWord, start + 8 * 260)
    setWord(wasiCell(), wHeap, start)
    start
}

// n bytes more at the top: their address (after a word for the size), or 0
fn bump(h: Int, n: Int) -> Int {
    let at = (word(h, topWord) + 15) & -16
    let end = at + 16 + n
    let have = memorySize() * 65536
    if end > have {
        let pages = (end - have + 65535) / 65536
        if memoryGrow(max(pages, 16)) < 0 and memoryGrow(pages) < 0 {
            return 0
        }
    }
    setWord(h, topWord, end)
    setWord(at + 8, 0, n)
    at + 16
}

fn roundedSize(n: Int) -> Int = if n <= smallMost {
    max((n + 15) & -16, 16)
} else {
    (n + 4095) & -4096
}

pub extern effect fn wasiMalloc(size: UInt64) -> Int64 as "malloc" {
    let h = heap()
    let n = roundedSize(size)
    if n <= smallMost {
        let list = n / 16
        let p = word(h, list)
        if p != 0 {
            setWord(h, list, word(p, 0))
            return p
        }
        return bump(h, n)
    }
    // the first large free block big enough (kept whole)
    var prev = 0
    var p = word(h, largeList)
    while p != 0 {
        if word(p - 8, 0) >= n {
            let next = word(p, 0)
            if prev == 0 {
                setWord(h, largeList, next)
            } else {
                setWord(prev, 0, next)
            }
            return p
        }
        prev = p
        p = word(p, 0)
    }
    bump(h, n)
}

pub extern effect fn wasiFree(p: Int64) as "free" {
    if p == 0 {
        return
    }
    let h = heap()
    let n = word(p - 8, 0)
    let list = if n <= smallMost { n / 16 } else { largeList }
    setWord(p, 0, word(h, list))
    setWord(h, list, p)
}

pub extern effect fn wasiCalloc(count: UInt64, size: UInt64) -> Int64 as "calloc" {
    let n = count * size
    let p = wasiMalloc(n)
    if p != 0 {
        let _ = memset(p, 0, roundedSize(n))
    }
    p
}

pub extern effect fn wasiRealloc(p: Int64, size: UInt64) -> Int64 as "realloc" {
    if p == 0 {
        return wasiMalloc(size)
    }
    let had = word(p - 8, 0)
    if roundedSize(size) <= had {
        return p
    }
    let q = wasiMalloc(size)
    if q != 0 {
        let _ = memcpy(q, p, had)
        wasiFree(p)
    }
    q
}

// ---- what else the runtime asks of the C library ----
pub extern effect fn wasiMemcmp(a: Int64, b: Int64, n: UInt64) -> Int32 as "memcmp" {
    for i in 0..n {
        let x = byte(a, i)
        let y = byte(b, i)
        if x != y {
            return x - y
        }
    }
    0
}

pub extern effect fn wasiStrlen(s: Int64) -> UInt64 as "strlen" {
    var n = 0
    while byte(s, n) != 0 {
        n += 1
    }
    n
}

pub extern effect fn wasiStrtoll(s: Int64, end: Int64, base: Int32) -> Int64 as "strtoll" {
    var i = 0
    while byte(s, i) == ' ' or byte(s, i) == '\t' {
        i += 1
    }
    var negative = false
    if byte(s, i) == '-' or byte(s, i) == '+' {
        negative = byte(s, i) == '-'
        i += 1
    }
    var v = 0
    while true {
        let c = byte(s, i)
        let d = if c >= '0' and c <= '9' {
            c - '0'
        } else if c >= 'a' and c <= 'z' {
            c - 'a' + 10
        } else if c >= 'A' and c <= 'Z' {
            c - 'A' + 10
        } else {
            99
        }
        if d >= base {
            break
        }
        v = v *% base +% d
        i += 1
    }
    if end != 0 {
        setWord(end, 0, s + i)
    }
    if negative { 0 -% v } else { v }
}

// WASI's errno numbers, said as C's strerror says POSIX's
pub extern effect fn wasiStrerror(code: Int32) -> Int64 as "strerror" = textAt(match code {
    2 => "Permission denied\0"
    8 => "Bad file descriptor\0"
    20 => "File exists\0"
    28 => "Invalid argument\0"
    29 => "Input/output error\0"
    31 => "Is a directory\0"
    44 => "No such file or directory\0"
    48 => "Not enough space\0"
    51 => "No space left on device\0"
    52 => "Function not implemented\0"
    54 => "Not a directory\0"
    55 => "Directory not empty\0"
    58 => "Not supported\0"
    63 => "Operation not permitted\0"
    76 => "Capabilities insufficient\0"
    _ => "Unknown error\0"
})

pub extern effect fn wasiExit(code: Int32) as "exit" = procExit(code)

pub extern effect fn wasiTime(t: Int64) -> Int64 as "time" {
    let s = toInt(clock(0))
    if t != 0 {
        setWord(t, 0, s)
    }
    s
}

// ---- the context, the output, numbers ----
pub extern effect fn wasiCtx() -> Int64 as "qkosCtx" = word(wasiCell(), wCtx)

pub extern effect fn wasiSetCtx(c: Int64) as "qkosSetCtx" = setWord(wasiCell(), wCtx, c)

// iovec's two i32s, with n bytes at p, in a scratch of 16 bytes: how many went
fn ioOnce(write: Bool, fd: Int, p: Int, n: Int) -> Int {
    let v = calloc(2, 8)
    setInt32(v, 0, p)
    setInt32(v, 1, n)
    let e = if write { fdWrite(fd, v, 1, v + 8) } else { fdRead(fd, v, 1, v + 8) }
    let done = if e == 0 { int32At(v, 2) & 4294967295 } else { -1 }
    free(v)
    if e != 0 {
        setWord(wasiCell(), wErrno, e)
    }
    done
}

pub extern effect fn wasiWrite(fd: Int64, p: Int64, n: Int64) as "qkosWrite" {
    var at = 0
    while at < n {
        let k = ioOnce(true, fd, p + at, n - at)
        if k <= 0 {
            break
        }
        at += k
    }
}

pub extern effect fn wasiErrno() -> Int64 as "qkosErrno" = word(wasiCell(), wErrno)

pub extern effect fn wasiSetErrno(e: Int64) as "qkosSetErrno" = setWord(wasiCell(), wErrno, e)

fn clock(which: Int) -> Float {
    let t = calloc(1, 8)
    let _ = clockTimeGet(which, 1000, t)
    let ns = word(t, 0)
    free(t)
    toFloat(ns / 1000000000) + toFloat(ns % 1000000000) * 0.000000001
}

pub extern effect fn wasiNow() -> Float64 as "qkosNow" = clock(1) // monotonic

pub extern effect fn wasiTimeNow() -> Float64 as "qkosTime" = clock(0) // realtime

pub extern effect fn wasiSleep(ms: Int64) as "qkosSleep" {
    // poll_oneoff with one clock subscription, relative
    let sub = calloc(6, 8)
    setByte(sub, 8, 0) // a clock
    setInt32(sub, 4, 1) // monotonic
    setWord(sub, 3, ms * 1000000)
    setWord(sub, 4, 1000)
    let event = calloc(4, 8)
    let n = calloc(1, 8)
    let _ = pollOneoff(sub, event, 1, n)
    free(sub)
    free(event)
    free(n)
}

pub extern effect fn wasiLocalOffset(seconds: Float64) -> Int64 as "qkosLocalOffset" =
    toInt(seconds - seconds) // UTC

pub extern effect fn wasiProcessors() -> Int64 as "qkosProcessors" = 1

// f (a function's number) called with its argument slots from args and its results to results (parallelMap's way,
// on this one thread): its slots' way in (compiler/wasm.qk makes one for each function whose address is taken)
pub extern effect fn wasiRunSlots(f: Int64, args: Int64, argCount: Int64, results: Int64, resultCount: Int64) -> Int64 as "qkosRunSlots" {
    let _ = machine.call(Pointer<UInt8>(f + slotsBase()), args, results, 0, 0)
    let _ = argCount + resultCount
    1
}

// ---- files: over the folders the runtime was given (wasmtime --dir: the preopens) ----
fn preopens() -> Int {
    let have = word(wasiCell(), wPreopens)
    if have != 0 {
        return have
    }
    var list = calloc(65, 16)
    var k = 0
    let buf = calloc(1, 8)
    for fd in 3..64 {
        if fdPrestatGet(fd, buf) != 0 {
            break
        }
        if byte(buf, 0) == 0 and k < 64 {
            let n = int32At(buf, 1)
            let name = calloc(1, n + 1)
            let _ = fdPrestatDirName(fd, name, n)
            setWord(list, 2 * k, fd)
            setWord(list, 2 * k + 1, name)
            k += 1
        }
    }
    free(buf)
    setWord(list, 2 * k, -1)
    setWord(wasiCell(), wPreopens, list)
    list
}

// a path's folder (a preopen's fd) and the rest of it, past that folder's name; (-1, 0) when none has it
fn resolve(path: Int) -> (Int, Int) {
    let list = preopens()
    var best = -1
    var bestLen = -1
    var rest = path
    var i = 0
    while word(list, 2 * i) >= 0 {
        let name = word(list, 2 * i + 1)
        let n = strlen(name)
        let dot = n == 1 and byte(name, 0) == '.'
        // "." takes a path that is not absolute; another name its own beginning, then a separator or the end
        let fits = if dot {
            byte(path, 0) != '/'
        } else {
            n > 0
                and sameBytes(path, name, n)
                and (byte(path, n) == 0 or byte(path, n) == '/' or byte(name, n - 1) == '/')
        }
        if fits and n > bestLen {
            best = word(list, 2 * i)
            bestLen = n
            rest = if dot { path } else { path + n }
        }
        i += 1
    }
    while byte(rest, 0) == '/' {
        rest += 1
    }
    if byte(rest, 0) == '.' and byte(rest, 1) == '/' {
        rest += 2
    }
    if byte(rest, 0) == 0 {
        rest = textAt(".\0")
    }
    (best, rest)
}

const allRights = 536870911 // every right WASI names (29)
const folderRights = 2383872 // a folder's: path_open, fd_readdir, path_filestat_get, fd_filestat_get (reading or

// writing it as a file is refused: EISDIR)
// path opened: its fd, or -1 (errno set); oflags 1 create, 2 a folder, 8 truncate; fdflags 1 append
fn openPath(path: Int, oflags: Int, fdflags: Int) -> Int {
    let (dir, rest) = resolve(path)
    if dir < 0 {
        setWord(wasiCell(), wErrno, 76)
        return -1
    }
    let out = calloc(1, 8)
    let rights = if oflags & 2 != 0 { folderRights } else { allRights }
    let e = pathOpen(dir, 1, rest, strlen(rest), oflags, rights, allRights, fdflags, out)
    let fd = int32At(out, 0)
    free(out)
    if e != 0 {
        setWord(wasiCell(), wErrno, e)
        return -1
    }
    fd
}

// a FILE* here: the fd, an error seen, the end seen
pub extern effect fn wasiOpen(path: Int64, mode: Int64) -> Int64 as "qkosOpen" {
    let m = byte(mode, 0)
    let plus = byte(mode, 1) == '+' or byte(mode, 2) == '+'
    let oflags = if m == 'w' {
        9
    } else if m == 'a' {
        1
    } else {
        0
    }
    let fdflags = if m == 'a' { 1 } else { 0 }
    let fd = openPath(path, oflags, fdflags)
    let _ = plus
    if fd < 0 {
        return 0
    }
    let f = calloc(3, 8)
    setWord(f, 0, fd)
    f
}

pub extern effect fn wasiFread(p: Int64, size: UInt64, n: UInt64, f: Int64) -> UInt64 as "fread" {
    let total = size * n
    var at = 0
    while at < total {
        let k = ioOnce(false, word(f, 0), p + at, total - at)
        if k < 0 {
            setWord(f, 1, 1)
            break
        }
        if k == 0 {
            setWord(f, 2, 1)
            break
        }
        at += k
    }
    if size > 0 { at / size } else { 0 }
}

pub extern effect fn wasiFwrite(p: Int64, size: UInt64, n: UInt64, f: Int64) -> UInt64 as "fwrite" {
    let total = size * n
    var at = 0
    while at < total {
        let k = ioOnce(true, word(f, 0), p + at, total - at)
        if k <= 0 {
            setWord(f, 1, 1)
            break
        }
        at += k
    }
    if size > 0 { at / size } else { 0 }
}

pub extern effect fn wasiFclose(f: Int64) -> Int32 as "fclose" {
    let e = fdClose(word(f, 0))
    free(f)
    if e == 0 { 0 } else { -1 }
}

pub extern effect fn wasiFerror(f: Int64) -> Int32 as "ferror" = word(f, 1)

pub extern effect fn wasiFflush(f: Int64) -> Int32 as "fflush" = f - f

pub extern effect fn wasiSeek(f: Int64, at: Int64, from: Int64) -> Int64 as "qkosSeek" {
    let out = calloc(1, 8)
    let e = fdSeek(word(f, 0), at, from, out)
    let now = word(out, 0)
    free(out)
    if e != 0 {
        setWord(wasiCell(), wErrno, e)
        return -1
    }
    now
}

pub extern effect fn wasiEnv(name: Int64) -> Int64 as "qkosEnv" {
    let sizes = calloc(2, 8)
    let _ = environSizesGet(sizes, sizes + 8)
    let count = word(sizes, 0)
    let bytes = word(sizes, 1)
    free(sizes)
    let ptrs = calloc(count + 1, 4)
    let buf = calloc(1, bytes + 1)
    let _ = environGet(ptrs, buf)
    let n = strlen(name)
    var found = 0
    for i in 0..count {
        let e = int32At(ptrs, i) & 4294967295
        if sameBytes(e, name, n) and byte(e, n) == '=' {
            let v = e + n + 1
            let k = strlen(v)
            found = malloc(k + 1)
            copyBytes(found, v, k + 1)
            break
        }
    }
    free(ptrs)
    free(buf)
    found
}

pub extern effect fn wasiPathKind(path: Int64) -> Int64 as "qkosPathKind" {
    let (dir, rest) = resolve(path)
    if dir < 0 {
        return -1
    }
    let st = calloc(8, 8)
    let e = pathFilestatGet(dir, 1, rest, strlen(rest), st)
    let kind = byte(st, 16)
    free(st)
    if e != 0 {
        -1
    } else if kind == 3 {
        1
    } else {
        0
    }
}

pub extern effect fn wasiMakeDir(path: Int64) -> Int64 as "qkosMakeDir" {
    let (dir, rest) = resolve(path)
    let e = if dir < 0 {
        76
    } else {
        pathCreateDirectory(dir, rest, strlen(rest))
    }
    if e != 0 {
        setWord(wasiCell(), wErrno, e)
        return -1
    }
    0
}

pub extern effect fn wasiRemove(path: Int64, folder: Int64) -> Int64 as "qkosRemove" {
    let (dir, rest) = resolve(path)
    let e = if dir < 0 {
        76
    } else if folder == 1 {
        pathRemoveDirectory(dir, rest, strlen(rest))
    } else {
        pathUnlinkFile(dir, rest, strlen(rest))
    }
    if e != 0 {
        setWord(wasiCell(), wErrno, e)
        return -1
    }
    0
}

pub extern effect fn wasiSeparator(c: Int64) -> Int64 as "qkosSeparator" =
    if c == '/' { 1 } else { 0 }

// the folder's names, each zero-ended, then a zero (not . or ..)
pub extern effect fn wasiListDir(path: Int64) -> Int64 as "qkosListDir" {
    let fd = openPath(path, 2, 0)
    if fd < 0 {
        return 0
    }
    var cap = 1024
    var out = malloc(cap)
    var used = 0
    let size = 8192
    let buf = malloc(size)
    let got = calloc(1, 8)
    var cookie = 0
    while true {
        if fdReaddir(fd, buf, size, cookie, got) != 0 {
            break
        }
        let n = int32At(got, 0) & 4294967295
        var at = 0
        var whole = 0
        // each entry: d_next, d_ino, d_namlen (u32), d_type, then its name
        while at + 24 <= n {
            let k = int32At(buf + at, 4) & 4294967295
            if at + 24 + k > n {
                break
            }
            let name = buf + at + 24
            let dots = k == 1 and byte(name, 0) == '.' or k == 2 and byte(name, 0) == '.' and byte(name, 1) == '.'
            if not dots {
                while used + k + 2 > cap {
                    cap *= 2
                    out = realloc(out, cap)
                }
                copyBytes(out + used, name, k)
                setByte(out, used + k, 0)
                used += k + 1
            }
            cookie = word(buf + at, 0)
            at += 24 + k
            whole += 1
        }
        if n < size or whole == 0 {
            break
        }
    }
    free(got)
    free(buf)
    let _ = fdClose(fd)
    setByte(out, used, 0)
    out
}

pub extern effect fn wasiReadIn(p: Int64, n: Int64) -> Int64 as "qkosReadIn" {
    let k = ioOnce(false, 0, p, n)
    if k > 0 { k } else { 0 }
}

pub extern effect fn wasiReadLine(out: Int64) -> Int64 as "qkosReadLine" = -1 + out - out

pub extern effect fn wasiRunProcess(name: Int64, args: Int64, count: Int64, out: Int64) -> Int64 as "qkosRunProcess" {
    let m = malloc(200)
    let _ = bufAt(m, 200).text("cannot run ").zeroText(name).text(": WebAssembly runs no other programs")
    setWord(out, 1, m)
    let _ = args + count
    1
}

pub extern effect fn wasiThreadStart(f: Int64, arg: Int64) -> Int64 as "qkosThreadStart" =
    f - f + arg - arg

pub extern effect fn wasiStackLow() -> Int64 as "qkosStackLow" = 0

pub extern effect fn wasiCFunction(symbol: Int64, lib: Int64, why: Int64) -> Int64 as "qkosCFunction" {
    let _ = bufAt(why, 512).text("cannot find ").zeroText(symbol).text(": WebAssembly links no C library")
    let _ = lib
    0
}

// ---- the start: the arguments, the state; and the end: what print kept written, the status ----
pub extern effect fn wasiBegin() as "qkWasiBegin" {
    for i in 0..8 {
        setWord(wasiCell(), i, 0) // its words zero (a literal's bytes until now)
    }
    let sizes = calloc(2, 8)
    let _ = argsSizesGet(sizes, sizes + 8)
    let count = word(sizes, 0) & 4294967295
    let bytes = word(sizes, 1) & 4294967295
    free(sizes)
    let ptrs = calloc(count + 1, 4)
    let buf = calloc(1, bytes + 1)
    let _ = argsGet(ptrs, buf)
    let argv = calloc(count + 1, 8)
    for i in 0..count {
        setWord(argv, i, int32At(ptrs, i) & 4294967295)
    }
    begin(count, argv)
}

// the process's state, its first context and arena, as start.qk's begin makes them, without the runtime's table
// (what loaded code reads: none is loaded here)
fn begin(argc: Int, argv: Int) {
    let g = calloc(gWords, 8)
    setWord(cell(), 0, g)
    let c = calloc(ctxWords, 8)
    setWord(c, ctxFuel, -1 - intMin)
    setWord(c, ctxGlobals, g)
    setWord(c, ctxArena, arenaNew())
    setCtx(c)
    setWord(g, gMainCtx, c)
    setWord(g, gMainArena, word(c, ctxArena))
    setWord(g, gOutBuf, malloc(65536))
    setWord(g, gOutFd, 1)
    setWord(g, gExitEnds, 1)
    let count = if argc > 1 { argc - 1 } else { 0 }
    let args = malloc(16 * count + 16)
    for i in 0..count {
        let s = word(argv, i + 1)
        setWord(args, 2 * i, s)
        setWord(args, 2 * i + 1, strlen(s))
    }
    setWord(g, gArgs, args)
    setWord(g, gArgCount, count)
}

// quark build --memory: the program's limit
pub extern effect fn wasiLimit(bytes: Int64) as "qkWasiLimit" = setLimit(arena(), bytes)

pub extern effect fn wasiEnd(status: Int64) as "qkWasiEnd" {
    flush()
    procExit(status)
}

// ---- a process with pipes: none in WebAssembly ----
pub extern effect fn wasiStartProcess(name: Int64, args: Int64, count: Int64, out: Int64) -> Int64 as "qkosStartProcess" {
    let m = malloc(200)
    let _ = bufAt(m, 200).text("cannot run ").zeroText(name).text(": WebAssembly runs no other programs")
    setWord(out, 1, m)
    let _ = args + count
    1
}

// ---- TLS: none in WebAssembly (WASI has no TLS, and no system library to take it from) ----
pub extern effect fn wasiTlsNew(host: Int64, why: Int64) -> Int64 as "qkosTlsNew" {
    let _ = bufAt(why, 256).text("WebAssembly has no TLS")
    0
}

pub extern effect fn wasiTlsWork(t: Int64, why: Int64) -> Int64 as "qkosTlsWork" = -1

pub extern effect fn wasiTlsSeal(t: Int64, p: Int64, n: Int64, why: Int64) -> Int64 as "qkosTlsSeal" =
    -1

pub extern effect fn wasiTlsEnd(t: Int64) as "qkosTlsEnd" {}
""" + "\n"
    }
    if name == "wasimath" {
        return r"""
// The mathematics C's library gives elsewhere, for WebAssembly (runtime/wasi.qk): fdlibm's ways (Sun's, as musl
// keeps them), below one unit in the last place: sin, cos, tan, asin, acos, atan, atan2, exp, log, log10, pow.
// The arguments of sin, cos and tan are reduced by pi/2 in three parts (Cody and Waite), exact to 2^20 * pi/2;
// past that the reduction loses digits (fdlibm's reduction by the bits of 2/pi is not here).
use base

// a Float's high and low 32 bits (the high signed), and back
fn hi(x: Float) -> Int = bitsOf(x) >> 32

fn lo(x: Float) -> Int = bitsOf(x) & 4294967295

fn ofWords(h: Int, l: Int) -> Float = floatOf(h << 32 | l & 4294967295)

fn lowZero(x: Float) -> Float = floatOf(bitsOf(x) & -4294967296)

// 2^e, for e from -1022 to 1023
fn two(e: Int) -> Float = floatOf((1023 + e) << 52)

fn isNan(x: Float) -> Bool = x != x

fn magnitude(x: Float) -> Float = if x < 0.0 { -x } else { x }

// x * 2^n
fn scalbn(x: Float, n: Int) -> Float {
    var y = x
    var k = n
    if k > 1023 {
        y *= two(1023)
        k -= 1023
        if k > 1023 {
            y *= two(1023)
            k -= 1023
            if k > 1023 {
                k = 1023
            }
        }
    } else if k < -1022 {
        y *= two(-1022) * two(53)
        k += 1022 - 53
        if k < -1022 {
            y *= two(-1022) * two(53)
            k += 1022 - 53
            if k < -1022 {
                k = -1022
            }
        }
    }
    y * two(k)
}

// ---- sin, cos, tan ----
fn kernelSin(x: Float, y: Float, iy: Int) -> Float {
    let z = x * x
    let w = z * z
    let r = 0.00833333333332248946124
        + z * (-0.000198412698298579493134 + z * 0.00000275573137070700676789)
        + z * w * (-0.0000000250507602534068634195 + z * 0.000000000158969099521155010221)
    let v = z * x
    if iy == 0 {
        x + v * (-0.166666666666666324348 + z * r)
    } else {
        x - (z * (0.5 * y - v * r) - y - v * -0.166666666666666324348)
    }
}

fn kernelCos(x: Float, y: Float) -> Float {
    let z = x * x
    let w = z * z
    let r = z * (0.0416666666666666019037 + z * (-0.00138888888888741095749 + z * 0.0000248015872894767294178))
        + w * w * (-0.000000275573143513906633035
            + z * (0.00000000208757232129817482790 + z * -0.0000000000113596475577881948265))
    let hz = 0.5 * z
    let v = 1.0 - hz
    v + (1.0 - v - hz + (z * r - x * y))
}

const tanT = [
    0.333333333333334091986, 0.133333333333201242699, 0.0539682539762260521377, 0.0218694882948595424599,
    0.00886323982359930005737, 0.00359207910759131235356, 0.00145620945432529025516, 0.000588041240820264096874,
    0.000246463134818469906812, 0.0000781794442939557092300, 0.0000714072491382608190305, -0.0000185586374855275456654,
    0.0000259073051863633712884,
]

fn kernelTan(x0: Float, y0: Float, odd: Int) -> Float {
    var x = x0
    var y = y0
    let hx = hi(x)
    let big = hx & 0x7fffffff >= 0x3FE59428 // |x| >= 0.6744
    let negative = hx < 0
    if big {
        if negative {
            x = -x
            y = -y
        }
        x = 0.785398163397448278999 - x + (0.0000000000000000306161699786838301793 - y)
        y = 0.0
    }
    let t = tanT
    let z = x * x
    let w = z * z
    let r0 = t[1] + w * (t[3] + w * (t[5] + w * (t[7] + w * (t[9] + w * t[11]))))
    let v0 = z * (t[2] + w * (t[4] + w * (t[6] + w * (t[8] + w * (t[10] + w * t[12])))))
    let s = z * x
    let r = y + z * (s * (r0 + v0) + y) + s * t[0]
    let sum = x + r
    if big {
        let sg = toFloat(1 - 2 * odd)
        let v = sg - 2.0 * (x + (r - sum * sum / (sum + sg)))
        return if negative { -v } else { v }
    }
    if odd == 0 {
        return sum
    }
    // -1 / (x + r), accurately
    let w0 = lowZero(sum)
    let v = r - (w0 - x)
    let a = -1.0 / sum
    let a0 = lowZero(a)
    a0 + a * (1.0 + a0 * w0 + a0 * v)
}

// x reduced by pi/2: n (the quarter turns), and the rest as two Floats
fn remPio2(x: Float) -> (Int, Float, Float) {
    let ix = hi(x) & 0x7fffffff
    if ix >= 0x7ff00000 {
        return (0, x - x, x - x)
    }
    let toint = 6755399441055744.0 // 1.5 / epsilon: adding it rounds to an integer
    let q = x * 0.636619772367581382433 + toint - toint
    let n = toInt(q)
    var r = x - q * 1.57079632673412561417
    var w = q * 0.0000000000607710050650619224932
    var y0 = r - w
    let ex = ix >> 20
    var ey = hi(y0) >> 20 & 0x7ff
    if ex - ey > 16 {
        // a second part of pi/2: 118 bits
        var t = r
        w = q * 0.0000000000607710050630396597660
        r = t - w
        w = q * 0.00000000000000000000202226624879595063154 - (t - r - w)
        y0 = r - w
        ey = hi(y0) >> 20 & 0x7ff
        if ex - ey > 49 {
            // a third: 151 bits
            t = r
            w = q * 0.00000000000000000000202226624871116645580
            r = t - w
            w = q * 0.0000000000000000000000000000000847842766036889956997 - (t - r - w)
            y0 = r - w
        }
    }
    let y1 = r - y0 - w
    (n, y0, y1)
}

pub extern fn wasiSin(x: Float64) -> Float64 as "sin" {
    let ix = hi(x) & 0x7fffffff
    if ix <= 0x3fe921fb {
        return if ix < 0x3e500000 { x } else { kernelSin(x, 0.0, 0) }
    }
    if ix >= 0x7ff00000 {
        return x - x
    }
    let (n, a, b) = remPio2(x)
    match n & 3 {
        0 => kernelSin(a, b, 1)
        1 => kernelCos(a, b)
        2 => -kernelSin(a, b, 1)
        _ => -kernelCos(a, b)
    }
}

pub extern fn wasiCos(x: Float64) -> Float64 as "cos" {
    let ix = hi(x) & 0x7fffffff
    if ix <= 0x3fe921fb {
        return if ix < 0x3e46a09e { 1.0 } else { kernelCos(x, 0.0) }
    }
    if ix >= 0x7ff00000 {
        return x - x
    }
    let (n, a, b) = remPio2(x)
    match n & 3 {
        0 => kernelCos(a, b)
        1 => -kernelSin(a, b, 1)
        2 => -kernelCos(a, b)
        _ => kernelSin(a, b, 1)
    }
}

pub extern fn wasiTan(x: Float64) -> Float64 as "tan" {
    let ix = hi(x) & 0x7fffffff
    if ix <= 0x3fe921fb {
        return if ix < 0x3e400000 { x } else { kernelTan(x, 0.0, 0) }
    }
    if ix >= 0x7ff00000 {
        return x - x
    }
    let (n, a, b) = remPio2(x)
    kernelTan(a, b, n & 1)
}

// ---- atan, atan2, asin, acos ----
const atanHi = [0.463647609000806093515, 0.785398163397448278999, 0.982793723247329054082, 1.57079632679489655800]

const atanLo = [
    0.0000000000000000226987774529616870924, 0.0000000000000000306161699786838301793,
    0.0000000000000000139033110312309984516, 0.0000000000000000612323399573676603587,
]

const aT = [
    0.333333333333329318027, -0.199999999998764832476, 0.142857142725034663711, -0.111111104054623557880,
    0.0909088713343650656196, -0.0769187620504482999495, 0.0666107313738753120669, -0.0583357013379057348645,
    0.0497687799461593236017, -0.0365315727442169155270, 0.0162858201153657823623,
]

pub extern fn wasiAtan(x0: Float64) -> Float64 as "atan" {
    var x = x0
    let hx = hi(x)
    let ix = hx & 0x7fffffff
    let negative = hx < 0
    if ix >= 0x44100000 {
        // |x| >= 2^66
        if isNan(x) {
            return x
        }
        let z = atanHi[3] + two(-120)
        return if negative { -z } else { z }
    }
    var id = -1
    if ix < 0x3fdc0000 {
        if ix < 0x3e400000 {
            return x
        }
    } else {
        x = magnitude(x)
        if ix < 0x3ff30000 {
            if ix < 0x3fe60000 {
                id = 0
                x = (2.0 * x - 1.0) / (2.0 + x)
            } else {
                id = 1
                x = (x - 1.0) / (x + 1.0)
            }
        } else if ix < 0x40038000 {
            id = 2
            x = (x - 1.5) / (1.0 + 1.5 * x)
        } else {
            id = 3
            x = -1.0 / x
        }
    }
    let z = x * x
    let w = z * z
    let s1 = z * (aT[0] + w * (aT[2] + w * (aT[4] + w * (aT[6] + w * (aT[8] + w * aT[10])))))
    let s2 = w * (aT[1] + w * (aT[3] + w * (aT[5] + w * (aT[7] + w * aT[9]))))
    if id < 0 {
        return x - x * (s1 + s2)
    }
    let r = atanHi[id] - (x * (s1 + s2) - atanLo[id] - x)
    if negative { -r } else { r }
}

const pi = 3.14159265358979311600
const piLo = 0.000000000000000122464679914735317720

pub extern fn wasiAtan2(y: Float64, x: Float64) -> Float64 as "atan2" {
    if isNan(x) or isNan(y) {
        return x + y
    }
    var ix = hi(x)
    let lx = lo(x)
    var iy = hi(y)
    let ly = lo(y)
    if ix - 0x3ff00000 | lx == 0 {
        return wasiAtan(y) // x is 1
    }
    let m = (if iy < 0 { 1 } else { 0 }) | (if ix < 0 { 2 } else { 0 })
    ix &= 0x7fffffff
    iy &= 0x7fffffff
    if iy | ly == 0 {
        // y is 0
        return match m {
            0 | 1 => y
            2 => pi
            _ => -pi
        }
    }
    if ix | lx == 0 {
        return if m & 1 != 0 { -pi / 2.0 } else { pi / 2.0 }
    }
    if ix == 0x7ff00000 {
        if iy == 0x7ff00000 {
            return match m {
                0 => pi / 4.0
                1 => -pi / 4.0
                2 => 3.0 * pi / 4.0
                _ => -3.0 * pi / 4.0
            }
        }
        return match m {
            0 => 0.0
            1 => -0.0
            2 => pi
            _ => -pi
        }
    }
    if ix + 64 << 20 < iy or iy == 0x7ff00000 {
        return if m & 1 != 0 { -pi / 2.0 } else { pi / 2.0 }
    }
    let z = if m & 2 != 0 and iy + 64 << 20 < ix {
        0.0
    } else {
        wasiAtan(magnitude(y / x))
    }
    match m {
        0 => z
        1 => -z
        2 => pi - (z - piLo)
        _ => z - piLo - pi
    }
}

const pio2Hi = 1.57079632679489655800
const pio2Lo = 0.0000000000000000612323399573676603587

fn rAsin(z: Float) -> Float {
    let p = z * (0.166666666666666657415
        + z * (-0.325565818622400915405
            + z * (0.201212532134862925881
                + z * (-0.0400555345006794114027 + z * (0.000791534994289814532176 + z * 0.0000347933107596021167570)))))
    let q = 1.0
        + z * (-2.40339491173441421878
            + z * (2.02094576023350569471 + z * (-0.688283971605453293030 + z * 0.0770381505559019352791)))
    p / q
}

pub extern fn wasiAsin(x: Float64) -> Float64 as "asin" {
    let hx = hi(x)
    let ix = hx & 0x7fffffff
    if ix >= 0x3ff00000 {
        if ix - 0x3ff00000 | lo(x) == 0 {
            return x * pio2Hi + two(-120) // asin(1) = pi/2
        }
        return (x - x) / (x - x) // past 1: NaN
    }
    if ix < 0x3fe00000 {
        if ix < 0x3e500000 and ix >= 0x00100000 {
            return x
        }
        return x + x * rAsin(x * x)
    }
    let z = (1.0 - magnitude(x)) * 0.5
    let s = sqrt(z)
    let r = rAsin(z)
    var v = 0.0
    if ix >= 0x3fef3333 {
        v = pio2Hi - (2.0 * (s + s * r) - pio2Lo)
    } else {
        let f = lowZero(s)
        let c = (z - f * f) / (s + f)
        v = 0.5 * pio2Hi - (2.0 * s * r - (pio2Lo - 2.0 * c) - (0.5 * pio2Hi - 2.0 * f))
    }
    if hx < 0 { -v } else { v }
}

pub extern fn wasiAcos(x: Float64) -> Float64 as "acos" {
    let hx = hi(x)
    let ix = hx & 0x7fffffff
    if ix >= 0x3ff00000 {
        if ix - 0x3ff00000 | lo(x) == 0 {
            return if hx < 0 { 2.0 * pio2Hi + two(-120) } else { 0.0 }
        }
        return (x - x) / (x - x)
    }
    if ix < 0x3fe00000 {
        if ix <= 0x3c600000 {
            return pio2Hi + two(-120)
        }
        return pio2Hi - (x - (pio2Lo - x * rAsin(x * x)))
    }
    if hx < 0 {
        let z = (1.0 + x) * 0.5
        let s = sqrt(z)
        let w = rAsin(z) * s - pio2Lo
        return 2.0 * (pio2Hi - (s + w))
    }
    let z = (1.0 - x) * 0.5
    let s = sqrt(z)
    let df = lowZero(s)
    let c = (z - df * df) / (s + df)
    let w = rAsin(z) * s + c
    2.0 * (df + w)
}

// ---- exp, log, log10 ----
const ln2Hi = 0.693147180369123816490
const ln2Lo = 0.000000000190821492927058770002

fn expPoly(t: Float) -> Float =
    t * (0.166666666666666019037
        + t * (-0.00277777777770155933842
            + t * (0.0000661375632143793436117
                + t * (-0.00000165339022054652515390 + t * 0.0000000413813679705723846039))))

pub extern fn wasiExp(x0: Float64) -> Float64 as "exp" {
    var x = x0
    let h = hi(x)
    let negative = h < 0
    let hx = h & 0x7fffffff
    if hx >= 0x4086232b {
        // |x| >= 708.39
        if isNan(x) {
            return x
        }
        if x > 709.782712893383973096 {
            return x * two(1023) // overflow: infinity
        }
        if x < -745.13321910194110842 {
            return 0.0
        }
    }
    var k = 0
    var hiPart = 0.0
    var loPart = 0.0
    if hx > 0x3fd62e42 {
        // |x| > ln2 / 2
        if hx >= 0x3ff0a2b2 {
            k = toInt(1.44269504088896338700 * x + (if negative { -0.5 } else { 0.5 }))
        } else {
            k = if negative { -1 } else { 1 }
        }
        hiPart = x - toFloat(k) * ln2Hi
        loPart = toFloat(k) * ln2Lo
        x = hiPart - loPart
    } else if hx > 0x3e300000 {
        hiPart = x
    } else {
        return 1.0 + x
    }
    let xx = x * x
    let c = x - xx * (0.166666666666666019037
        + xx * (-0.00277777777770155933842
            + xx * (0.0000661375632143793436117
                + xx * (-0.00000165339022054652515390 + xx * 0.0000000413813679705723846039))))
    let y = 1.0 + (x * c / (2.0 - c) - loPart + hiPart)
    if k == 0 { y } else { scalbn(y, k) }
}

pub extern fn wasiLog(x0: Float64) -> Float64 as "log" {
    var x = x0
    var hx = hi(x) & 4294967295
    var k = 0
    if hx < 0x00100000 or hx >> 31 != 0 {
        if bitsOf(x) << 1 == 0 {
            return -1.0 / (x * x) // log(0) = -infinity
        }
        if hx >> 31 != 0 {
            return (x - x) / 0.0 // log of a negative: NaN
        }
        // subnormal: scaled up
        k -= 54
        x *= two(54)
        hx = hi(x) & 4294967295
    } else if hx >= 0x7ff00000 {
        return x
    } else if hx == 0x3ff00000 and lo(x) == 0 {
        return 0.0
    }
    // x = 2^k * (1 + f), with sqrt(2)/2 < 1 + f < sqrt(2)
    hx += 0x3ff00000 - 0x3fe6a09e
    k += hx >> 20 - 0x3ff
    hx = hx & 0x000fffff + 0x3fe6a09e
    x = ofWords(hx, lo(x))
    let f = x - 1.0
    let hfsq = 0.5 * f * f
    let s = f / (2.0 + f)
    let z = s * s
    let w = z * z
    let t1 = w * (0.3999999999940941908 + w * (0.2222219843214978396 + w * 0.1531383769920937332))
    let t2 = z * (0.6666666666666735130
        + w * (0.2857142874366239149 + w * (0.1818357216161805012 + w * 0.1479819860511658591)))
    let r = t2 + t1
    let dk = toFloat(k)
    s * (hfsq + r) + dk * ln2Lo - hfsq + f + dk * ln2Hi
}

pub extern fn wasiLog10(x: Float64) -> Float64 as "log10" = wasiLog(x) * 0.434294481903251827651

// ---- pow ----
pub extern fn wasiPow(x: Float64, y: Float64) -> Float64 as "pow" {
    let hx = hi(x)
    let lx = lo(x)
    let hy = hi(y)
    let ly = lo(y)
    var ix = hx & 0x7fffffff
    let iy = hy & 0x7fffffff
    if iy | ly == 0 {
        return 1.0 // x^0, even for NaN
    }
    if hx == 0x3ff00000 and lx == 0 {
        return 1.0 // 1^y, even for NaN
    }
    if ix > 0x7ff00000 or ix == 0x7ff00000 and lx != 0 or iy > 0x7ff00000 or iy == 0x7ff00000 and ly != 0 {
        return x + y
    }
    // y an odd integer (1), an even one (2), or not one (0), when x < 0
    var yisint = 0
    if hx < 0 {
        if iy >= 0x43400000 {
            yisint = 2
        } else if iy >= 0x3ff00000 {
            let k = iy >> 20 - 0x3ff
            if k > 20 {
                let j = ly >> (52 - k)
                if j << (52 - k) == ly {
                    yisint = 2 - j & 1
                }
            } else if ly == 0 {
                let j = iy >> (20 - k)
                if j << (20 - k) == iy {
                    yisint = 2 - j & 1
                }
            }
        }
    }
    if ly == 0 {
        if iy == 0x7ff00000 {
            // y is +-infinity
            if ix - 0x3ff00000 | lx == 0 {
                return 1.0
            }
            if ix >= 0x3ff00000 {
                return if hy >= 0 { y } else { 0.0 }
            }
            return if hy >= 0 { 0.0 } else { -y }
        }
        if iy == 0x3ff00000 {
            return if hy >= 0 { x } else { 1.0 / x }
        }
        if hy == 0x40000000 {
            return x * x
        }
        if hy == 0x3fe00000 and hx >= 0 {
            return sqrt(x)
        }
    }
    var ax = magnitude(x)
    if lx == 0 and (ix == 0x7ff00000 or ix == 0 or ix == 0x3ff00000) {
        // x is +-0, +-infinity, +-1
        var z = ax
        if hy < 0 {
            z = 1.0 / z
        }
        if hx < 0 {
            if ix - 0x3ff00000 | yisint == 0 {
                z = (z - z) / (z - z)
            } else if yisint == 1 {
                z = -z
            }
        }
        return z
    }
    var s = 1.0
    if hx < 0 {
        if yisint == 0 {
            return (x - x) / (x - x)
        }
        if yisint == 1 {
            s = -1.0
        }
    }
    let huge = 1.0e300
    let tiny = 1.0e-300
    var t1 = 0.0
    var t2 = 0.0
    if iy > 0x41e00000 {
        // |y| > 2^31
        if iy > 0x43f00000 {
            if ix <= 0x3fefffff {
                return if hy < 0 { huge * huge } else { tiny * tiny }
            }
            if ix >= 0x3ff00000 {
                return if hy > 0 { huge * huge } else { tiny * tiny }
            }
        }
        if ix < 0x3fefffff {
            return if hy < 0 { s * huge * huge } else { s * tiny * tiny }
        }
        if ix > 0x3ff00000 {
            return if hy > 0 { s * huge * huge } else { s * tiny * tiny }
        }
        // |1 - x| is tiny: log(x) by x - x^2/2 + x^3/3 - x^4/4
        let t = ax - 1.0
        let w = t * t * (0.5 - t * (0.3333333333333333333333 - t * 0.25))
        let u = 1.44269502162933349609 * t
        let v = t * 0.0000000192596299112661746887 - w * 1.44269504088896338700
        t1 = lowZero(u + v)
        t2 = v - (t1 - u)
    } else {
        var n = 0
        if ix < 0x00100000 {
            ax *= 9007199254740992.0
            n -= 53
            ix = hi(ax)
        }
        n += ix >> 20 - 0x3ff
        let j = ix & 0x000fffff
        ix = j | 0x3ff00000
        var k = 0
        if j <= 0x3988E {
            k = 0
        } else if j < 0xBB67A {
            k = 1
        } else {
            k = 0
            n += 1
            ix -= 0x00100000
        }
        ax = ofWords(ix, lo(ax))
        let bp = if k == 0 { 1.0 } else { 1.5 }
        let dpH = if k == 0 { 0.0 } else { 0.584962487220764160156 }
        let dpL = if k == 0 { 0.0 } else { 0.0000000135003920212974897128 }
        // ss = (x - 1) / (x + 1) or (x - 1.5) / (x + 1.5)
        let u0 = ax - bp
        let v0 = 1.0 / (ax + bp)
        let ss = u0 * v0
        let sH = lowZero(ss)
        let tH0 = ofWords(ix >> 1 | 0x20000000 + 0x00080000 + k << 18, 0)
        let tL0 = ax - (tH0 - bp)
        let sL = v0 * (u0 - sH * tH0 - sH * tL0)
        // log(ax)
        var s2 = ss * ss
        var r = s2 * s2 * (0.599999999999994648725
            + s2 * (0.428571428578550184252
                + s2 * (0.333333329818377432918
                    + s2 * (0.272728123808534006489 + s2 * (0.230660745775561754067 + s2 * 0.206975017800338417784)))))
        r += sL * (sH + ss)
        s2 = sH * sH
        let tH = lowZero(3.0 + s2 + r)
        let tL = r - (tH - 3.0 - s2)
        let u = sH * tH
        let v = sL * tH + tL * ss
        let pH = lowZero(u + v)
        let pL = v - (pH - u)
        let zH = 0.961796700954437255859 * pH
        let zL = -0.00000000702846165095275826516 * pH + pL * 0.961796693925975554329 + dpL
        let t = toFloat(n)
        t1 = lowZero(zH + zL + dpH + t)
        t2 = zL - (t1 - t - dpH - zH)
    }
    // (y1 + y2) * (t1 + t2)
    let y1 = lowZero(y)
    let pL0 = (y - y1) * t1 + y * t2
    var pH = y1 * t1
    var z = pL0 + pH
    var j = hi(z)
    let i = lo(z)
    if j >= 0x40900000 {
        // z >= 1024
        if j - 0x40900000 | i != 0 {
            return s * huge * huge
        }
        if pL0 + 0.000000000000000080085662595372944372 > z - pH {
            return s * huge * huge
        }
    } else if j & 0x7fffffff >= 0x4090cc00 {
        // z <= -1075
        if j - (0xc090cc00 - 4294967296) | i != 0 {
            return s * tiny * tiny
        }
        if pL0 <= z - pH {
            return s * tiny * tiny
        }
    }
    // 2^(pH + pL0)
    let i2 = j & 0x7fffffff
    var k = i2 >> 20 - 0x3ff
    var n = 0
    if i2 > 0x3fe00000 {
        n = j + 0x00100000 >> (k + 1)
        k = n & 0x7fffffff >> 20 - 0x3ff
        let t = ofWords(n & ~(0x000fffff >> k), 0)
        n = (n & 0x000fffff | 0x00100000) >> (20 - k)
        if j < 0 {
            n = -n
        }
        pH -= t
    }
    let t = lowZero(pL0 + pH)
    let u = t * 0.693147182464599609375
    let v = (pL0 - (t - pH)) * 0.693147180559945286227 + t * -0.00000000190465429995776804525
    z = u + v
    let w = v - (z - u)
    let tt = z * z
    let r1 = z - tt * (0.166666666666666019037
        + tt * (-0.00277777777770155933842
            + tt * (0.0000661375632143793436117
                + tt * (-0.00000165339022054652515390 + tt * 0.0000000413813679705723846039))))
    let r = z * r1 / (r1 - 2.0) - (w + z * w)
    z = 1.0 - (r - z)
    j = hi(z) + n << 20
    if j >> 20 <= 0 {
        z = scalbn(z, n) // subnormal
    } else {
        z = ofWords(j, lo(z))
    }
    s * z
}
""" + "\n"
    }
    if name == "windows" {
        return r"""
// The runtime's system calls on Windows: kernel32 alone (and ntdll's memcpy, memset, memcmp, strlen), each behind a
// symbol of the runtime's own (qkos*, C's calls; linux.qk gives the same ones), and the executable's entry, wmain.
// What the C library gives elsewhere is made here over kernel32: the heap (malloc...: the process's heap), files (a
// FILE* is a word of ours over a handle), the environment, the time and its zone, the command line's arguments. Names
// are UTF-8 in the runtime and UTF-16 here: Windows' wide functions take any name, its ANSI ones only the code
// page's.
use base
use io
use start
use host

extern effect fn tlsAlloc() -> UInt32 as "TlsAlloc"
extern effect fn tlsGetValue(index: UInt32) -> Int64 as "TlsGetValue"
extern effect fn tlsSetValue(index: UInt32, v: Int64) -> Int32 as "TlsSetValue"
extern effect fn getStdHandle(which: UInt32) -> Int64 as "GetStdHandle"
extern effect fn winWriteFile(h: Int64, p: Int64, n: UInt32, done: Int64, overlapped: Int64) -> Int32 as "WriteFile"
extern effect fn winReadFile(h: Int64, p: Int64, n: UInt32, done: Int64, overlapped: Int64) -> Int32 as "ReadFile"
extern effect fn getConsoleMode(h: Int64, mode: Int64) -> Int32 as "GetConsoleMode"
extern effect fn readConsoleW(h: Int64, p: Int64, n: UInt32, done: Int64, control: Int64) -> Int32 as "ReadConsoleW"
extern effect fn setConsoleOutputCP(page: UInt32) -> Int32 as "SetConsoleOutputCP"
extern effect fn multiByteToWideChar(page: UInt32, flags: UInt32, s: Int64, n: Int32, w: Int64, wn: Int32) -> Int32 as "MultiByteToWideChar"

extern effect fn wideCharToMultiByte(
    page: UInt32,
    flags: UInt32,
    w: Int64,
    wn: Int32,
    s: Int64,
    n: Int32,
    d: Int64,
    u: Int64,
) -> Int32 as "WideCharToMultiByte"

extern effect fn getModuleFileNameW(m: Int64, w: Int64, n: UInt32) -> UInt32 as "GetModuleFileNameW"
extern effect fn getFileAttributesW(w: Int64) -> UInt32 as "GetFileAttributesW"
extern effect fn createDirectoryW(w: Int64, security: Int64) -> Int32 as "CreateDirectoryW"
extern effect fn removeDirectoryW(w: Int64) -> Int32 as "RemoveDirectoryW"
extern effect fn deleteFileW(w: Int64) -> Int32 as "DeleteFileW"
extern effect fn getLastError() -> UInt32 as "GetLastError"
extern effect fn findFirstFileW(w: Int64, data: Int64) -> Int64 as "FindFirstFileW"
extern effect fn findNextFileW(h: Int64, data: Int64) -> Int32 as "FindNextFileW"
extern effect fn findClose(h: Int64) -> Int32 as "FindClose"
extern effect fn virtualAlloc(p: Int64, n: UInt64, kind: UInt32, protect: UInt32) -> Int64 as "VirtualAlloc"
extern effect fn virtualProtect(p: Int64, n: UInt64, protect: UInt32, old: Int64) -> Int32 as "VirtualProtect"
extern effect fn virtualFree(p: Int64, n: UInt64, kind: UInt32) -> Int32 as "VirtualFree"
extern effect fn flushInstructionCache(process: Int64, p: Int64, n: UInt64) -> Int32 as "FlushInstructionCache"
extern effect fn getCurrentProcess() -> Int64 as "GetCurrentProcess"
extern effect fn getCurrentThreadStackLimits(low: Int64, high: Int64) as "GetCurrentThreadStackLimits"
extern effect fn loadLibraryW(w: Int64) -> Int64 as "LoadLibraryW"
extern effect fn getProcAddress(m: Int64, name: Int64) -> Int64 as "GetProcAddress"
extern effect fn getSystemInfo(info: Int64) as "GetSystemInfo"
extern effect fn createThread(security: Int64, stack: UInt64, f: Int64, arg: Int64, flags: UInt32, id: Int64) -> Int64 as "CreateThread"
extern effect fn waitForSingleObject(h: Int64, ms: UInt32) -> UInt32 as "WaitForSingleObject"
extern effect fn closeHandle(h: Int64) -> Int32 as "CloseHandle"
extern effect fn queryPerformanceCounter(at: Int64) -> Int32 as "QueryPerformanceCounter"
extern effect fn queryPerformanceFrequency(at: Int64) -> Int32 as "QueryPerformanceFrequency"
extern effect fn getSystemTimePreciseAsFileTime(at: Int64) as "GetSystemTimePreciseAsFileTime"
extern effect fn winSleep(ms: UInt32) as "Sleep"
extern effect fn createPipe(read: Int64, write: Int64, security: Int64, size: UInt32) -> Int32 as "CreatePipe"
extern effect fn setHandleInformation(h: Int64, mask: UInt32, flags: UInt32) -> Int32 as "SetHandleInformation"

extern effect fn createFileA(
    name: Int64,
    access: UInt32,
    share: UInt32,
    security: Int64,
    how: UInt32,
    flags: UInt32,
    template: Int64,
) -> Int64 as "CreateFileA"

extern effect fn createProcessW(
    app: Int64,
    line: Int64,
    ps: Int64,
    ts: Int64,
    inherit: Int32,
    flags: UInt32,
    env: Int64,
    dir: Int64,
    si: Int64,
    pi: Int64,
) -> Int32 as "CreateProcessW"

extern effect fn getExitCodeProcess(h: Int64, code: Int64) -> Int32 as "GetExitCodeProcess"

extern effect fn formatMessageA(
    flags: UInt32,
    source: Int64,
    id: UInt32,
    lang: UInt32,
    buf: Int64,
    n: UInt32,
    args: Int64,
) -> UInt32 as "FormatMessageA"

extern effect fn getCommandLineW() -> Int64 as "GetCommandLineW"
extern effect fn getProcessHeap() -> Int64 as "GetProcessHeap"
extern effect fn heapAlloc(h: Int64, flags: UInt32, n: UInt64) -> Int64 as "HeapAlloc"
extern effect fn heapReAlloc(h: Int64, flags: UInt32, p: Int64, n: UInt64) -> Int64 as "HeapReAlloc"
extern effect fn heapFree(h: Int64, flags: UInt32, p: Int64) -> Int32 as "HeapFree"
extern effect fn getEnvironmentVariableW(name: Int64, buf: Int64, n: UInt32) -> UInt32 as "GetEnvironmentVariableW"
extern effect fn setFilePointerEx(h: Int64, at: Int64, now: Int64, how: UInt32) -> Int32 as "SetFilePointerEx"
extern effect fn getSystemTimeAsFileTime(at: Int64) as "GetSystemTimeAsFileTime"
extern effect fn fileTimeToSystemTime(ft: Int64, st: Int64) -> Int32 as "FileTimeToSystemTime"
extern effect fn systemTimeToTzSpecificLocalTime(zone: Int64, utc: Int64, local: Int64) -> Int32 as "SystemTimeToTzSpecificLocalTime"
extern effect fn systemTimeToFileTime(st: Int64, ft: Int64) -> Int32 as "SystemTimeToFileTime"

extern effect fn createFileW(
    name: Int64,
    access: UInt32,
    share: UInt32,
    security: Int64,
    how: UInt32,
    flags: UInt32,
    template: Int64,
) -> Int64 as "CreateFileW"

extern fn fnAddress(f: extern (Int64) -> Int64) -> Int64 as "qkTextAddress"

const utf8 = 65001

// ---- text both ways ----
// a UTF-8 text (zero-ended) as UTF-16, malloc'd
fn wide(s: Int) -> Int {
    let n = multiByteToWideChar(utf8, 0, s, -1, 0, 0)
    let w = calloc(if n > 0 { n } else { 1 }, 2)
    if n > 0 {
        let _ = multiByteToWideChar(utf8, 0, s, -1, w, n)
    }
    w
}

// n bytes of UTF-8 as UTF-16 (zero-ended), malloc'd
fn wideOf(s: Int, n: Int) -> Int {
    let k = if n > 0 { multiByteToWideChar(utf8, 0, s, n, 0, 0) } else { 0 }
    let w = calloc(k + 1, 2)
    if k > 0 {
        let _ = multiByteToWideChar(utf8, 0, s, n, w, k)
    }
    w
}

// UTF-16 (zero-ended) as UTF-8, malloc'd
fn utf8Of(w: Int) -> Int {
    let n = wideCharToMultiByte(utf8, 0, w, -1, 0, 0, 0, 0)
    let s = calloc(if n > 0 { n } else { 1 }, 1)
    if n > 0 {
        let _ = wideCharToMultiByte(utf8, 0, w, -1, s, n, 0, 0)
    }
    s
}

fn wideLen(w: Int) -> Int {
    var n = 0
    while Pointer<UInt16>(w)[n] != 0 {
        n += 1
    }
    n
}

// ---- the context, the output, numbers ----
pub extern effect fn osCtxImpl() -> Int64 as "qkosCtx" = tlsGetValue(word(cell(), 1))

pub extern effect fn osSetCtxImpl(c: Int64) as "qkosSetCtx" {
    let _ = tlsSetValue(word(cell(), 1), c)
}

fn writeAll(h: Int, p: Int, n: Int) {
    let done = calloc(1, 8)
    var at = 0
    while at < n {
        if winWriteFile(h, p + at, n - at, done, 0) == 0 or int32At(done, 0) == 0 {
            break
        }
        at += int32At(done, 0)
    }
    free(done)
}

// the output's bytes as they are; the errors' as C's stderr writes them (a text stream: \n made \r\n)
pub extern effect fn osWriteImpl(fd: Int64, p: Int64, n: Int64) as "qkosWrite" {
    if fd != 2 {
        writeAll(getStdHandle(-11), p, n)
        return
    }
    let h = getStdHandle(-12)
    var from = 0
    for i in 0..n {
        if byte(p, i) == '\n' {
            writeAll(h, p + from, i - from)
            writeAll(h, textAt("\r\n"), 2)
            from = i + 1
        }
    }
    writeAll(h, p + from, n - from)
}

// errno: C's numbers (POSIX's), in the runtime's cell (one for the process: it is read right after it is set)
pub extern effect fn osErrnoImpl() -> Int64 as "qkosErrno" = word(cell(), 2)

pub extern effect fn osSetErrnoImpl(e: Int64) as "qkosSetErrno" = setWord(cell(), 2, e)

pub extern effect fn osNowImpl() -> Float64 as "qkosNow" {
    let q = calloc(2, 8)
    let _ = queryPerformanceFrequency(q)
    let _ = queryPerformanceCounter(q + 8)
    let t = toFloat(word(q, 1)) / toFloat(word(q, 0))
    free(q)
    t
}

pub extern effect fn osTimeImpl() -> Float64 as "qkosTime" {
    let q = calloc(1, 8)
    getSystemTimePreciseAsFileTime(q)
    let ticks = word(q, 0) - 116444736000000000 // 100 ns since 1601, made since 1970
    free(q)
    toFloat(ticks / 10000000) + toFloat(ticks % 10000000) * 0.0000001
}

// (code is loaded here: a program is never the runtime's own, as in WebAssembly)
pub extern effect fn osRunSlotsImpl(
    f: Int64,
    args: Int64,
    argCount: Int64,
    results: Int64,
    resultCount: Int64,
) -> Int64 as "qkosRunSlots" =
    f - f + args - args + argCount - argCount + results - results + resultCount - resultCount

pub extern effect fn osSleepImpl(ms: Int64) as "qkosSleep" = winSleep(ms)

// ---- files and folders ----
// GetLastError's numbers as errno's: ENOENT, EACCES, EEXIST, ENOTEMPTY, EINVAL, else EIO
fn errnoOf(e: Int) -> Int = if e == 2 or e == 3 or e == 15 or e == 161 {
    2
} else if e == 5 or e == 32 or e == 33 {
    13
} else if e == 80 or e == 183 {
    17
} else if e == 145 {
    41
} else if e == 87 or e == 123 {
    22
} else {
    5
}

// a FILE* here: the handle, an error seen, the end seen; "rb", "wb", "ab", "r+b", "w+b" as C opens them
pub extern effect fn osOpenImpl(path: Int64, mode: Int64) -> Int64 as "qkosOpen" {
    let m = byte(mode, 0)
    let plus = byte(mode, 1) == '+' or byte(mode, 2) == '+'
    let read = 2147483648
    let write = 1073741824
    let access = if m == 'r' {
        read | (if plus { write } else { 0 })
    } else if m == 'w' {
        write | (if plus { read } else { 0 })
    } else {
        4 | 1048576 | (if plus {
            read // FILE_APPEND_DATA | SYNCHRONIZE
        } else {
            0
        })
    }
    let how = if m == 'r' {
        3 // OPEN_EXISTING, CREATE_ALWAYS, OPEN_ALWAYS
    } else if m == 'w' {
        2
    } else {
        4
    }
    let w = wide(path)
    let h = createFileW(w, access, 7, 0, how, 128, 0)
    free(w)
    if h == -1 {
        setErrno(errnoOf(getLastError()))
        return 0
    }
    let f = calloc(3, 8)
    setWord(f, 0, h)
    f
}

pub extern effect fn winFread(p: Int64, size: UInt64, n: UInt64, f: Int64) -> UInt64 as "fread" {
    let total = size * n
    let got = calloc(1, 8)
    var at = 0
    while at < total {
        let chunk = if total - at > 1073741824 { 1073741824 } else { total - at }
        if winReadFile(word(f, 0), p + at, chunk, got, 0) == 0 {
            setWord(f, 1, 1)
            break
        }
        let k = int32At(got, 0)
        if k == 0 {
            setWord(f, 2, 1)
            break
        }
        at += k
    }
    free(got)
    if size > 0 { at / size } else { 0 }
}

pub extern effect fn winFwrite(p: Int64, size: UInt64, n: UInt64, f: Int64) -> UInt64 as "fwrite" {
    let total = size * n
    let done = calloc(1, 8)
    var at = 0
    while at < total {
        let chunk = if total - at > 1073741824 { 1073741824 } else { total - at }
        if winWriteFile(word(f, 0), p + at, chunk, done, 0) == 0 or int32At(done, 0) == 0 {
            setWord(f, 1, 1)
            break
        }
        at += int32At(done, 0)
    }
    free(done)
    if size > 0 { at / size } else { 0 }
}

pub extern effect fn winFclose(f: Int64) -> Int32 as "fclose" {
    let ok = closeHandle(word(f, 0))
    free(f)
    if ok != 0 { 0 } else { -1 }
}

pub extern effect fn winFerror(f: Int64) -> Int32 as "ferror" = word(f, 1)

pub extern effect fn winFflush(f: Int64) -> Int32 as "fflush" = f - f // (nothing kept: every write is the system's)

pub extern effect fn winFseek(f: Int64, offset: Int32, whence: Int32) -> Int32 as "fseek" = if setFilePointerEx(
    word(f, 0),
    offset,
    0,
    whence,
) != 0 {
    0
} else {
    -1
}

pub extern effect fn osEnvImpl(name: Int64) -> Int64 as "qkosEnv" {
    let w = wide(name)
    let n = getEnvironmentVariableW(w, 0, 0)
    if n == 0 {
        free(w)
        return 0
    }
    let v = calloc(n + 1, 2)
    let _ = getEnvironmentVariableW(w, v, n + 1)
    free(w)
    let s = utf8Of(v)
    free(v)
    s
}

// ---- the C library's functions the runtime calls, over kernel32 ----
pub extern effect fn winMalloc(size: UInt64) -> Int64 as "malloc" =
    heapAlloc(getProcessHeap(), 0, if size > 0 { size } else { 1 })

pub extern effect fn winCalloc(count: UInt64, size: UInt64) -> Int64 as "calloc" {
    let n = count * size
    heapAlloc(getProcessHeap(), 8, if n > 0 {
        n // HEAP_ZERO_MEMORY
    } else {
        1
    })
}

pub extern effect fn winRealloc(p: Int64, size: UInt64) -> Int64 as "realloc" = if p == 0 {
    winMalloc(size)
} else {
    heapReAlloc(getProcessHeap(), 0, p, if size > 0 { size } else { 1 })
}

pub extern effect fn winFree(p: Int64) as "free" {
    if p != 0 {
        let _ = heapFree(getProcessHeap(), 0, p)
    }
}

pub extern effect fn winExit(code: Int32) as "exit" = exitProcess(code)

pub extern fn winFloor(x: Float64) -> Float64 as "floor" = floor(x)

pub extern fn winFabs(x: Float64) -> Float64 as "fabs" = if x < 0.0 { -x } else { x }

// seconds since 1970 (C's time)
pub extern effect fn winTime(t: Int64) -> Int64 as "time" {
    let q = calloc(1, 8)
    getSystemTimeAsFileTime(q)
    let s = (word(q, 0) - 116444736000000000) / 10000000
    free(q)
    if t != 0 {
        setWord(t, 0, s)
    }
    s
}

pub extern effect fn winStrtoll(s: Int64, end: Int64, base: Int32) -> Int64 as "strtoll" {
    var i = 0
    while byte(s, i) == ' ' or byte(s, i) == '\t' {
        i += 1
    }
    var negative = false
    if byte(s, i) == '-' or byte(s, i) == '+' {
        negative = byte(s, i) == '-'
        i += 1
    }
    var v = 0
    while true {
        let c = byte(s, i)
        let d = if c >= '0' and c <= '9' {
            c - '0'
        } else if c >= 'a' and c <= 'z' {
            c - 'a' + 10
        } else if c >= 'A' and c <= 'Z' {
            c - 'A' + 10
        } else {
            99
        }
        if d >= base {
            break
        }
        v = v *% base +% d
        i += 1
    }
    if end != 0 {
        setWord(end, 0, s + i)
    }
    if negative { 0 -% v } else { v }
}

// errno's numbers said as C's strerror says them
pub extern effect fn winStrerror(code: Int32) -> Int64 as "strerror" = textAt(match code {
    2 => "No such file or directory\0"
    5 => "Input/output error\0"
    9 => "Bad file descriptor\0"
    12 => "Not enough space\0"
    13 => "Permission denied\0"
    17 => "File exists\0"
    20 => "Not a directory\0"
    21 => "Is a directory\0"
    22 => "Invalid argument\0"
    28 => "No space left on device\0"
    41 => "Directory not empty\0"
    _ => "Unknown error\0"
})

pub extern effect fn osPathKindImpl(path: Int64) -> Int64 as "qkosPathKind" {
    let w = wide(path)
    let a = getFileAttributesW(w)
    free(w)
    if a == 4294967295 {
        -1
    } else if a & 16 != 0 {
        1
    } else {
        0
    }
}

fn setErrno(code: Int) = setWord(cell(), 2, code)

pub extern effect fn osMakeDirImpl(path: Int64) -> Int64 as "qkosMakeDir" {
    let w = wide(path)
    let done = createDirectoryW(w, 0)
    free(w)
    if done != 0 {
        return 0
    }
    let e = getLastError() // as errno says it: EEXIST, ENOENT, EACCES, else EIO
    setErrno(if e == 183 {
        17
    } else if e == 3 or e == 2 {
        2
    } else if e == 5 {
        13
    } else {
        5
    })
    -1
}

pub extern effect fn osRemoveImpl(path: Int64, folder: Int64) -> Int64 as "qkosRemove" {
    let w = wide(path)
    let done = if folder == 1 { removeDirectoryW(w) } else { deleteFileW(w) }
    free(w)
    if done != 0 {
        return 0
    }
    let e = getLastError() // ENOTEMPTY, EACCES, else EIO
    setErrno(if e == 145 {
        41
    } else if e == 5 or e == 32 {
        13
    } else {
        5
    })
    -1
}

pub extern effect fn osSeparatorImpl(c: Int64) -> Int64 as "qkosSeparator" =
    if c == '/' or c == '\\' { 1 } else { 0 }

// the names in a folder: each zero-ended, then a zero (malloc'd); 0 when it cannot be listed
pub extern effect fn osListDirImpl(path: Int64) -> Int64 as "qkosListDir" {
    let n = strlen(path)
    let pattern = calloc(n + 3, 1)
    copyBytes(pattern, path, n)
    setByte(pattern, n, '\\')
    setByte(pattern, n + 1, '*')
    let w = wide(pattern)
    free(pattern)
    let fd = calloc(1, 600)
    let h = findFirstFileW(w, fd)
    free(w)
    if h == -1 {
        free(fd)
        setErrno(2)
        return 0
    }
    var cap = 1024
    var out = malloc(cap)
    var used = 0
    while true {
        let name = fd + 44
        let dot = Pointer<UInt16>(name)
        let skip = dot[0] == '.' and dot[1] == 0 or dot[0] == '.' and dot[1] == '.' and dot[2] == 0
        if not skip {
            let s = utf8Of(name)
            let k = strlen(s)
            while used + k + 2 > cap {
                cap *= 2
                out = realloc(out, cap)
            }
            copyBytes(out + used, s, k + 1)
            used += k + 1
            free(s)
        }
        if findNextFileW(h, fd) == 0 {
            break
        }
    }
    let _ = findClose(h)
    free(fd)
    setByte(out, used, 0)
    out
}

// ---- the input ----
pub extern effect fn osReadInImpl(p: Int64, n: Int64) -> Int64 as "qkosReadIn" {
    let got = calloc(1, 8)
    let ok = winReadFile(getStdHandle(-10), p, n, got, 0)
    let k = int32At(got, 0)
    free(got)
    if ok != 0 { k } else { 0 }
}

// a line typed at a console: its characters as UTF-16 (the console's code page may not have them)
pub extern effect fn osReadLineImpl(out: Int64) -> Int64 as "qkosReadLine" {
    let console = getStdHandle(-10)
    let mode = calloc(1, 16)
    if getConsoleMode(console, mode) == 0 {
        free(mode)
        return -1
    }
    var cap = 256
    var w = malloc(2 * cap)
    var n = 0
    var any = false
    while readConsoleW(console, mode + 8, 1, mode, 0) != 0 and int32At(mode, 0) != 0 {
        let ch = Pointer<UInt16>(mode + 8)[0]
        if ch == 26 and n == 0 {
            // Ctrl+Z first: the end
            break
        }
        any = true
        if ch == '\n' {
            break
        }
        if ch != '\r' {
            if n + 2 > cap {
                cap *= 2
                w = realloc(w, 2 * cap)
            }
            Pointer<UInt16>(w)[n] = ch
            n += 1
        }
    }
    free(mode)
    if not any {
        free(w)
        return 0
    }
    Pointer<UInt16>(w)[n] = 0
    let s = utf8Of(w)
    free(w)
    setWord(out, 0, s)
    setWord(out, 1, strlen(s))
    1
}

// ---- other programs ----
type Line { p: Int, n: Int, cap: Int }

fn Line.add(self, c: Int) -> Line {
    var l = self
    if l.n + 1 > l.cap {
        l = Line(realloc(l.p, 2 * l.cap), l.n, 2 * l.cap)
    }
    setByte(l.p, l.n, c)
    Line(l.p, l.n + 1, l.cap)
}

// one argument on a command line, as the C runtime's parser reads it back
fn Line.quoted(self, s: Int, n: Int) -> Line {
    var plain = n > 0
    for i in 0..n {
        let c = byte(s, i)
        if c == ' ' or c == '\t' or c == '"' or c == '\n' or c == 11 {
            plain = false
        }
    }
    var l = self
    if plain {
        for i in 0..n {
            l = l.add(byte(s, i))
        }
        return l
    }
    l = l.add('"')
    var i = 0
    while true {
        var slashes = 0
        while i < n and byte(s, i) == '\\' {
            i += 1
            slashes += 1
        }
        if i == n {
            for k in 0..slashes * 2 {
                l = l.add('\\')
            }
            break
        }
        let times = if byte(s, i) == '"' { slashes * 2 + 1 } else { slashes }
        for k in 0..times {
            l = l.add('\\')
        }
        l = l.add(byte(s, i))
        i += 1
    }
    l.add('"')
}

// what a pipe gives until its end: (handle, bytes, length, room)
fn drain(r: Int) -> Int {
    let chunk = malloc(16384)
    let got = calloc(1, 8)
    while winReadFile(word(r, 0), chunk, 16384, got, 0) != 0 and int32At(got, 0) != 0 {
        let k = int32At(got, 0)
        while word(r, 2) + k > word(r, 3) {
            setWord(r, 3, word(r, 3) * 2)
            setWord(r, 1, realloc(word(r, 1), word(r, 3)))
        }
        copyBytes(word(r, 1) + word(r, 2), chunk, k)
        setWord(r, 2, word(r, 2) + k)
    }
    free(chunk)
    free(got)
    0
}

fn cannotRun(out: Int, name: Int, e: Int) -> Int {
    let why = calloc(1, 300)
    let _ = formatMessageA(4096 | 512, 0, e, 0, why, 300, 0)
    var k = strlen(why)
    while k > 0
        and (byte(why, k - 1) == '\r' or byte(why, k - 1) == '\n' or byte(why, k - 1) == '.' or byte(why, k - 1) == ' ') {
        k -= 1
        setByte(why, k, 0)
    }
    let m = malloc(700)
    var b = bufAt(m, 700).text("cannot run ").zeroText(name).text(": ")
    b = if k == 0 { b.text("error ").int(e) } else { b.zeroText(why) }
    free(why)
    setWord(out, 1, m)
    1
}

fn pipeRecord(h: Int) -> Int {
    let r = calloc(4, 8)
    setWord(r, 0, h)
    setWord(r, 1, malloc(4096))
    setWord(r, 3, 4096)
    r
}

// runs name with args ((bytes, length) pairs) and an empty input: 0 and (status, out, its length, err, its length)
// in out; 1 and the message (malloc'd) in out[1] when it cannot be started
pub extern effect fn osRunProcessImpl(name: Int64, args: Int64, count: Int64, out: Int64) -> Int64 as "qkosRunProcess" {
    let n = strlen(name)
    for i in 0..n {
        if byte(name, i) == '/' {
            setByte(name, i, '\\') // CreateProcess finds build\quark.exe, not build/quark.exe
        }
    }
    var line = Line(malloc(256), 0, 256).quoted(name, n)
    for i in 0..count {
        line = line.add(' ').quoted(word(args, 2 * i), word(args, 2 * i + 1))
    }
    let wline = wideOf(line.p, line.n)
    free(line.p)
    let sa = calloc(1, 24) // SECURITY_ATTRIBUTES: its size, no descriptor, inherited
    setInt32(sa, 0, 24)
    setInt32(sa, 4, 1)
    let hs = calloc(4, 8) // outRead, outWrite, errRead, errWrite
    if createPipe(hs, hs + 8, sa, 0) == 0 {
        free(wline)
        return cannotRun(out, name, getLastError())
    }
    if createPipe(hs + 16, hs + 24, sa, 0) == 0 {
        let e = getLastError()
        let _ = closeHandle(word(hs, 0))
        let _ = closeHandle(word(hs, 1))
        free(wline)
        return cannotRun(out, name, e)
    }
    let _ = setHandleInformation(word(hs, 0), 1, 0)
    let _ = setHandleInformation(word(hs, 2), 1, 0)
    let input = createFileA(textAt("NUL\0"), 2147483648, 3, sa, 3, 0, 0)
    let si = calloc(1, 104) // STARTUPINFOW
    setInt32(si, 0, 104)
    setInt32(si, 15, 256) // dwFlags (at 60): STARTF_USESTDHANDLES
    setWord(si, 10, input) // hStdInput at 80
    setWord(si, 11, word(hs, 1))
    setWord(si, 12, word(hs, 3))
    let pi = calloc(1, 24)
    let started = createProcessW(0, wline, 0, 0, 1, 0, 0, 0, si, pi)
    let startError = getLastError()
    free(wline)
    let _ = closeHandle(word(hs, 1))
    let _ = closeHandle(word(hs, 3))
    if input != -1 {
        let _ = closeHandle(input)
    }
    if started == 0 {
        let _ = closeHandle(word(hs, 0))
        let _ = closeHandle(word(hs, 2))
        return cannotRun(out, name, startError)
    }
    let errPipe = pipeRecord(word(hs, 2))
    let outPipe = pipeRecord(word(hs, 0))
    let t = createThread(0, 0, fnAddress(r => drain(r)), errPipe, 0, 0)
    let _ = drain(outPipe)
    if t != 0 {
        let _ = waitForSingleObject(t, 4294967295)
        let _ = closeHandle(t)
    } else {
        let _ = drain(errPipe) // no thread: the errors after the output
    }
    let _ = waitForSingleObject(word(pi, 0), 4294967295)
    let code = calloc(1, 8)
    let _ = getExitCodeProcess(word(pi, 0), code)
    let _ = closeHandle(word(pi, 0))
    let _ = closeHandle(word(pi, 1))
    let _ = closeHandle(word(hs, 0))
    let _ = closeHandle(word(hs, 2))
    setWord(out, 0, int32At(code, 0))
    setWord(out, 1, word(outPipe, 1))
    setWord(out, 2, word(outPipe, 2))
    setWord(out, 3, word(errPipe, 1))
    setWord(out, 4, word(errPipe, 2))
    free(code)
    free(outPipe)
    free(errPipe)
    free(hs)
    free(sa)
    free(si)
    free(pi)
    0
}

// ---- code in memory, the stack, C's libraries, threads ----
pub extern effect fn osMapCodeImpl(n: Int64) -> Int64 as "qkosMapCode" =
    virtualAlloc(0, n, 12288, 4)

pub extern effect fn osProtectCodeImpl(p: Int64, n: Int64) as "qkosProtectCode" {
    let old = calloc(1, 8)
    let _ = virtualProtect(p, n, 32, old)
    free(old)
    let _ = flushInstructionCache(getCurrentProcess(), p, n)
}

pub extern effect fn osUnmapCodeImpl(p: Int64, n: Int64) as "qkosUnmapCode" {
    let _ = virtualFree(p, 0, 32768) + n - n
}

// the heap's range (heap.qk): reserved (MEM_RESERVE, no access), committed as it is used (MEM_COMMIT, read and write)
pub extern effect fn osReserveImpl(n: Int64) -> Int64 as "qkosReserve" = virtualAlloc(0, n, 8192, 1)

pub extern effect fn osCommitImpl(p: Int64, n: Int64) -> Int64 as "qkosCommit" =
    if virtualAlloc(p, n, 4096, 4) != 0 { 1 } else { 0 }

pub extern effect fn osReleaseImpl(p: Int64, n: Int64) as "qkosRelease" {
    let _ = virtualFree(p, 0, 32768) + n - n
}

pub extern effect fn osStackLowImpl() -> Int64 as "qkosStackLow" {
    let lh = calloc(2, 8)
    getCurrentThreadStackLimits(lh, lh + 8)
    let low = word(lh, 0)
    free(lh)
    low
}

fn hasAny(s: Int, a: Int, b: Int, c: Int) -> Bool {
    let n = strlen(s)
    for i in 0..n {
        let x = byte(s, i)
        if x == a or x == b or x == c {
            return true
        }
    }
    false
}

fn isText(s: Int, t: Text) -> Bool = strlen(s) == len(t) and sameBytes(s, textAt(t), len(t))

pub extern effect fn osCFunctionImpl(symbol: Int64, lib: Int64, why: Int64) -> Int64 as "qkosCFunction" {
    if lib == 0 or isText(lib, "c") or isText(lib, "m") {
        // the C runtime: the universal one, else the old one
        let ucrt = loadLibraryW(wide(textAt("ucrtbase.dll\0")))
        let f = if ucrt != 0 { getProcAddress(ucrt, symbol) } else { 0 }
        if f != 0 {
            return f
        }
        let old = loadLibraryW(wide(textAt("msvcrt.dll\0")))
        let g = if old != 0 { getProcAddress(old, symbol) } else { 0 }
        if g != 0 {
            return g
        }
        let _ = bufAt(why, 512).text("cannot find ").zeroText(symbol).text(
            " in the C library (ucrtbase.dll, msvcrt.dll)",
        )
        return 0
    }
    let path = hasAny(lib, '.', '/', '\\')
    var h = 0
    let name = calloc(1, 1024)
    for attempt in 0..(if path {
        1 // m.dll, then libm.dll (as MinGW names them)
    } else {
        2
    }) {
        if h == 0 {
            let b = bufAt(name, 1024)
            let _ = if path {
                b.zeroText(lib)
            } else if attempt == 1 {
                b.text("lib").zeroText(lib).text(".dll")
            } else {
                b.zeroText(lib).text(".dll")
            }
            let w = wide(name)
            h = loadLibraryW(w)
            free(w)
        }
    }
    free(name)
    if h == 0 {
        let b = bufAt(why, 512).text("cannot load the library ").zeroText(lib).text(" (").zeroText(lib)
        let _ = if path { b.text(")") } else { b.text(".dll)") }
        return 0
    }
    let f = getProcAddress(h, symbol)
    if f == 0 {
        let _ = bufAt(why, 512).text("cannot find ").zeroText(symbol).text(" in the library ").zeroText(lib)
    }
    f
}

pub extern effect fn osProcessorsImpl() -> Int64 as "qkosProcessors" {
    let info = calloc(1, 64)
    getSystemInfo(info)
    let n = int32At(info, 8) // dwNumberOfProcessors, at 32
    free(info)
    n
}

pub extern effect fn osThreadStartImpl(f: Int64, arg: Int64) -> Int64 as "qkosThreadStart" =
    createThread(0, 67108864, f, arg, 65536, 0) // 64 MB of stack, reserved

pub extern effect fn osThreadJoinImpl(h: Int64) as "qkosThreadJoin" {
    let _ = waitForSingleObject(h, 4294967295)
    let _ = closeHandle(h)
}

// ---- the executable's entry: the arguments as Windows has them (UTF-16), made UTF-8 ----
pub extern effect fn wmain(argc: Int32, argv: Int64) -> Int32 as "wmain" {
    setWord(cell(), 1, tlsAlloc())
    setWord(cell(), 2, 0) // errno
    setWord(cell(), 3, 0) // Winsock, not loaded yet (the cell is a literal's bytes until its words are set)
    let _ = setConsoleOutputCP(utf8)
    let args = calloc(argc + 1, 8)
    for i in 0..argc {
        setWord(args, i, utf8Of(word(argv, i)))
    }
    let w = calloc(32768, 2)
    let n = getModuleFileNameW(0, w, 32768)
    let self = if n != 0 and n < 32768 { utf8Of(w) } else { 0 }
    free(w)
    qkStart(argc, args, self)
}

// ---- an executable with no C start (compiler/image.qk writes the PE): its entry point, the command line read here ----
extern effect fn exitProcess(code: UInt32) as "ExitProcess"

pub extern effect fn winEntry() -> Int32 as "qkWinEntry" {
    let count = calloc(1, 8)
    let argv = argvOf(getCommandLineW(), count)
    exitProcess(wmain(int32At(count, 0), argv))
    0
}

// The command line's arguments as Windows' C programs read them (CommandLineToArgvW's rules): the program's name up to
// a space, or within quotes; then arguments between spaces, where quotes group, 2n backslashes and a quote are n
// backslashes and the quote's meaning, 2n + 1 of them n and a quote, other backslashes themselves, and "" inside quotes
// a quote. Each argument UTF-16 and zero-ended, malloc'd; their count in count.
fn argvOf(line: Int, count: Int) -> Int {
    var n = 0
    while unitAt(line, n) != 0 {
        n += 1
    }
    var argv = calloc(n / 2 + 2, 8)
    var argc = 0
    let buf = calloc(n + 1, 2)
    var i = 0
    // the program's name
    var k = 0
    if unitAt(line, 0) == '"' {
        i = 1
        while unitAt(line, i) != 0 and unitAt(line, i) != '"' {
            Pointer<UInt16>(buf)[k] = unitAt(line, i)
            k += 1
            i += 1
        }
        if unitAt(line, i) == '"' {
            i += 1
        }
    } else {
        while unitAt(line, i) != 0 and unitAt(line, i) != ' ' and unitAt(line, i) != '\t' {
            Pointer<UInt16>(buf)[k] = unitAt(line, i)
            k += 1
            i += 1
        }
    }
    setWord(argv, argc, wideCopy(buf, k))
    argc += 1
    while true {
        while unitAt(line, i) == ' ' or unitAt(line, i) == '\t' {
            i += 1
        }
        if unitAt(line, i) == 0 {
            break
        }
        k = 0
        var quoted = false
        while unitAt(line, i) != 0 and (quoted or unitAt(line, i) != ' ' and unitAt(line, i) != '\t') {
            if unitAt(line, i) == '\\' {
                var slashes = 0
                while unitAt(line, i) == '\\' {
                    slashes += 1
                    i += 1
                }
                if unitAt(line, i) == '"' {
                    for _ in 0..slashes / 2 {
                        Pointer<UInt16>(buf)[k] = '\\'
                        k += 1
                    }
                    if slashes % 2 == 1 {
                        Pointer<UInt16>(buf)[k] = '"'
                        k += 1
                        i += 1
                    }
                } else {
                    for _ in 0..slashes {
                        Pointer<UInt16>(buf)[k] = '\\'
                        k += 1
                    }
                }
            } else if unitAt(line, i) == '"' {
                if quoted and unitAt(line, i + 1) == '"' {
                    Pointer<UInt16>(buf)[k] = '"'
                    k += 1
                    i += 2
                } else {
                    quoted = not quoted
                    i += 1
                }
            } else {
                Pointer<UInt16>(buf)[k] = unitAt(line, i)
                k += 1
                i += 1
            }
        }
        setWord(argv, argc, wideCopy(buf, k))
        argc += 1
    }
    free(buf)
    setInt32(count, 0, argc)
    argv
}

// the i-th UTF-16 unit at w (no closure: this runs before the runtime has its context)
fn unitAt(w: Int, i: Int) -> Int = Pointer<UInt16>(w)[i]

// k UTF-16 units of buf, zero-ended, malloc'd
fn wideCopy(buf: Int, k: Int) -> Int {
    let w = calloc(k + 1, 2)
    copyBytes(w, buf, 2 * k)
    w
}

// ---- a program run from memory (quarkimg run): the runtime mapped by the caller, the arguments UTF-8 already ----
pub extern effect fn memoryMain(argc: Int64, argv: Int64, payload: Int64, trailer: Int64) -> Int64 as "qkMemoryMain" {
    setWord(cell(), 1, tlsAlloc())
    setWord(cell(), 2, 0) // errno
    setWord(cell(), 3, 0) // Winsock, not loaded yet (the cell is a literal's bytes until its words are set)
    let _ = setConsoleOutputCP(utf8)
    qkStartMemory(argc, argv, payload, trailer)
}

// ---- the command line's own runs (host.qk, compiler/memory.qk): this thread made ready for the runtime ----
pub extern effect fn hostInit() as "qkosHostInit" {
    setWord(cell(), 1, tlsAlloc())
    setWord(cell(), 2, 0) // errno
    setWord(cell(), 3, 0) // Winsock, not loaded yet (the cell is a literal's bytes until its words are set)
    let _ = setConsoleOutputCP(utf8)
}

// ---- --profile: another thread stops this one every millisecond and reads where it is ----
extern effect fn getCurrentThread() -> Int64 as "GetCurrentThread"

extern effect fn duplicateHandle(
    fromProcess: Int64,
    h: Int64,
    toProcess: Int64,
    to: Int64,
    access: UInt32,
    inherit: Int32,
    options: UInt32,
) -> Int32 as "DuplicateHandle"

extern effect fn suspendThread(h: Int64) -> UInt32 as "SuspendThread"
extern effect fn resumeThread(h: Int64) -> UInt32 as "ResumeThread"
extern effect fn getThreadContext(h: Int64, context: Int64) -> Int32 as "GetThreadContext"
extern effect fn timeBeginPeriod(ms: UInt32) -> UInt32 as "timeBeginPeriod"
extern effect fn createWaitableTimerExW(security: Int64, name: Int64, flags: UInt32, access: UInt32) -> Int64 as "CreateWaitableTimerExW"
extern effect fn setWaitableTimer(h: Int64, due: Int64, period: Int32, f: Int64, arg: Int64, resume: Int32) -> Int32 as "SetWaitableTimer"
extern effect fn timeEndPeriod(ms: UInt32) -> UInt32 as "timeEndPeriod"

// p's words (host.qk): on, the sampled thread, the sampling one, the samples, their count, their room
fn sampler(p: Int) -> Int {
    let raw = calloc(1, 1248)
    let context = (raw + 15) & -16 // a CONTEXT: 16-aligned
    // x86-64 (its functions start with push rbp): ContextFlags at byte 48, Rip at 248; ARM64: at 0, Pc at 264
    let x64 = byte(fnAddress(x => sampler(x)), 0) == 85
    let _ = timeBeginPeriod(1)
    // a high-resolution timer: Windows 11 lets a process with no window sleep no less than its 15.6 ms tick
    let timer = createWaitableTimerExW(0, 0, 2, 2031619) // CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS
    let due = calloc(1, 8)
    setWord(due, 0, -10000) // a millisecond from now, in 100 ns
    while word(p, 0) != 0 {
        if timer != 0 and setWaitableTimer(timer, due, 0, 0, 0, 0) != 0 {
            let _ = waitForSingleObject(timer, 4294967295)
        } else {
            winSleep(1)
        }
        if suspendThread(word(p, 1)) == 4294967295 {
            continue
        }
        // CONTEXT_CONTROL | CONTEXT_INTEGER of CONTEXT_AMD64 (Rbp is an integer register), or CONTEXT_CONTROL of
        // CONTEXT_ARM64 (Fp is a control one)
        setInt32(context, if x64 { 12 } else { 0 }, if x64 { 1048579 } else { 4194305 })
        if getThreadContext(word(p, 1), context) != 0 and word(p, 4) < word(p, 5) {
            let s = word(p, 3) + 8 * sampleWords * word(p, 4)
            setWord(s, 0, word(context, if x64 {
                31 // Rip, Pc
            } else {
                33
            }))
            // the frames above: rbp / x29 holds the saved one, then the return address
            var fp = word(context, if x64 { 20 } else { 30 })
            for j in 1..sampleWords {
                if fp < word(p, 6) or fp >= word(p, 7) - 16 or fp & 7 != 0 {
                    break
                }
                setWord(s, j, word(fp, 1))
                let next = word(fp, 0)
                fp = if next > fp { next } else { 0 }
            }
            setWord(p, 4, word(p, 4) + 1)
        }
        let _ = resumeThread(word(p, 1))
    }
    let _ = timeEndPeriod(1)
    if timer != 0 {
        let _ = closeHandle(timer)
    }
    free(due)
    free(raw)
    0
}

pub extern effect fn osProfileStartImpl(p: Int64) as "qkosProfileStart" {
    getCurrentThreadStackLimits(p + 48, p + 56) // the sampled thread's own: where its frames can be
    let h = calloc(1, 8)
    let _ = duplicateHandle(getCurrentProcess(), getCurrentThread(), getCurrentProcess(), h, 0, 0, 2) // the same access
    setWord(p, 1, word(h, 0))
    free(h)
    setWord(p, 2, createThread(0, 0, fnAddress(x => sampler(x)), p, 0, 0))
}

pub extern effect fn osProfileStopImpl(p: Int64) as "qkosProfileStop" {
    if word(p, 2) != 0 {
        let _ = waitForSingleObject(word(p, 2), 4294967295)
        let _ = closeHandle(word(p, 2))
    }
    let _ = closeHandle(word(p, 1))
}

// ---- sockets (ws2_32: Winsock), seeking, the local time ----
// Winsock, loaded the first time a socket is used (programs without sockets depend on kernel32 alone): each function
// found by its name in ws2_32.dll, then called through its address
fn winsock() -> Int {
    let have = word(cell(), 3)
    if have != 0 {
        return have
    }
    let w = wide(textAt("ws2_32.dll\0"))
    let m = loadLibraryW(w)
    free(w)
    setWord(cell(), 3, m)
    m
}

extern effect fn findWsaStartup(m: Int64, name: Int64) -> (extern (UInt16, Int64) -> Int32)? as "GetProcAddress"

fn wsaStartup(version: Int, data: Int) -> Int = match findWsaStartup(winsock(), textAt("WSAStartup\0")) {
    Some(f) => f(version, data)
    None => -1
}

extern effect fn findWsaGetLastError(m: Int64, name: Int64) -> (extern () -> Int32)? as "GetProcAddress"

fn wsaGetLastError() -> Int = match findWsaGetLastError(winsock(), textAt("WSAGetLastError\0")) {
    Some(f) => f()
    None => -1
}

