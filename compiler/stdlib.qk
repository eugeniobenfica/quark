// Made by compiler/embed.sh from std/*.qk and compiler/runtime/*.qk: the standard library and the runtime, as
// the compiler keeps them (module.qk reads them; memory.qk compiles the runtime from them).

// compiler/prelude.qk: the built-ins written in Quark
pub fn preludeText() -> Text =
    r"""
// The built-ins written in Quark: declarations every program sees (after its own: a program's name hides one of
// these), kept in the compiler (compiler/embed.sh). A built-in here is a function like any other: its values have
// names, defaults and types, its errors are a call's, a.f(b) calls it. What only the runtime can do is one call,
// runtime(group, name, values...): the runtime's function `name` (compiler/ir.qk's runtimeNames, qk_<name> in
// compiler/runtime/) with the values' slots in order, giving what the function says it gives. group is the
// capability a caller needs (quark run --allow, qkVmCapabilities), "" none. runtimeLine gives the runtime the line
// of the program's call too, last, for its messages.
// ---- files whole, and folders (runtime/files.qk) ----
// the file's text; Err says why it could not be read (not UTF-8 too)
pub effect fn readFile(path: Text) -> Text! = runtime("files", "readFile", path)

// the file made, or written over; Err says why it could not be written
pub effect fn writeFile(path: Text, text: Text) -> Unit! = runtime("files", "writeFile", path, text)

// the text at the end of the file (made when missing)
pub effect fn appendFile(path: Text, text: Text) -> Unit! =
    runtime("files", "appendFile", path, text)

pub effect fn readBytes(path: Text) -> Bytes! = runtime("files", "readBytes", path)

pub effect fn writeBytes(path: Text, bytes: Bytes) -> Unit! =
    runtime("files", "writeFile", path, bytes)

// a file or a folder is there
pub effect fn pathExists(path: Text) -> Bool = runtime("files", "pathExists", path)

// the names in a folder
pub effect fn listDir(path: Text) -> [Text]! = runtime("files", "listDir", path)

// a folder made, and the folders above it that are missing
pub effect fn makeDir(path: Text) -> Unit! = runtime("files", "makeDir", path)

// a file removed, or a folder that is empty
pub effect fn removePath(path: Text) -> Unit! = runtime("files", "removePath", path)

// ---- the process and what is around it ----
// what a program that ran gave: its exit status, what it wrote to its output and to its errors
pub type Process { status: Int, out: Text, err: Text }

// program run to its end with args; Err says why it could not be started
pub effect fn runProcess(program: Text, args: [Text]) -> Process! =
    runtime("process", "runProcess", program, args)

// a program running beside this one, its input, output and errors in pipes (startProcess)
pub type Subprocess { handle: Int }

// program started with args: what it reads, writes and leaves are this program's to give and take as it runs
// (writeProcess, readProcess, readProcessErrors, closeProcessInput, waitProcess, killProcess). A read, a write or the
// wait that would wait gives a task's turn back.
pub effect fn startProcess(program: Text, args: [Text]) -> Subprocess! =
    runtime("process", "startProcess", program, args)

// bytes to the process's input (every one: the task waits while the pipe is full)
pub effect fn writeProcess(p: Subprocess, bytes: Bytes) -> Unit! =
    runtime("process", "processWrite", p, bytes)

// the process's input ended: it reads its end (a program that reads to the end of its input goes on)
pub effect fn closeProcessInput(p: Subprocess) = runtime("process", "processCloseInput", p)

// up to most bytes of what the process wrote to its output, as they come; none: it ended its output
pub effect fn readProcess(p: Subprocess, most: Int) -> Bytes! =
    runtime("process", "processRead", p, most, 0)

// the same of its errors
pub effect fn readProcessErrors(p: Subprocess, most: Int) -> Bytes! =
    runtime("process", "processRead", p, most, 1)

// its end waited for: its exit status (its input closed first; what it still writes is not read)
pub effect fn waitProcess(p: Subprocess) -> Int! = runtime("process", "processWait", p)

// stopped now (waitProcess then gives the status it stopped with)
pub effect fn killProcess(p: Subprocess) = runtime("process", "processKill", p)

// an environment variable's value
pub effect fn env(name: Text) -> Text? = runtime("env", "env", name)

// the program's arguments (quark run file.qk -- a b; a built executable's)
pub effect fn args() -> [Text] = runtime("args", "args")

// the program ends, with this status
pub effect fn exit(code: Int) -> Never = runtime("exit", "exit", code)

// a line of the input; None at its end
pub effect fn readLine() -> Text? = runtime("stdin", "readLine")

// ---- files a part at a time (runtime/io.qk) ----
// an open file: C's stream
pub type File { handle: Int }

// path opened: "r" read, "w" written from nothing, "a" added to, "r+" read and written, "w+" both from nothing (its
// bytes as they are)
pub effect fn openFile(path: Text, mode: Text) -> File! = runtime("files", "openFile", path, mode)

// up to most bytes from where the file is; none at its end
pub effect fn readChunk(file: File, most: Int) -> Bytes! = runtime("files", "readChunk", file, most)

// every byte, where the file is
pub effect fn writeChunk(file: File, bytes: Bytes) -> Unit! =
    runtime("files", "writeChunk", file, bytes)

// the file's place moved to `at` bytes from the start (from: 0), from where it is (1) or from its end (2): the
// place it is now
pub effect fn seekFile(file: File, at: Int, from: Int = 0) -> Int! =
    runtime("files", "seekFile", file, at, from)

// written out and closed
pub effect fn closeFile(file: File) = runtime("files", "closeFile", file)

// ---- sockets: TCP (runtime/io.qk); a read, write or accept that would wait gives the task's turn back ----
pub type Socket { handle: Int }

// a socket that listens on host:port ("0.0.0.0": every address of this machine)
pub effect fn listen(host: Text, port: Int) -> Socket! = runtime("net", "listen", host, port)

// a connection to host:port
pub effect fn connect(host: Text, port: Int) -> Socket! = runtime("net", "connect", host, port)

// the next connection to a listening socket
pub effect fn accept(listener: Socket) -> Socket! = runtime("net", "accept", listener)

// what came, up to most bytes; none when the other end closed it
pub effect fn readSocket(socket: Socket, most: Int) -> Bytes! =
    runtime("net", "readSocket", socket, most)

// every byte sent
pub effect fn writeSocket(socket: Socket, bytes: Bytes) -> Unit! =
    runtime("net", "writeSocket", socket, bytes)

pub effect fn closeSocket(socket: Socket) = runtime("net", "closeSocket", socket)

// TLS over a connected socket, by the system's library (Schannel, OpenSSL, SecureTransport): the server's certificate
// checked for serverName by the system's trust (std.net's connectTls and std.http's https:// use it)
pub type Tls { handle: Int }

// the handshake with the server at the other end of the socket
pub effect fn tlsConnect(socket: Socket, serverName: Text) -> Tls! =
    runtime("net", "tlsConnect", socket, serverName)

// what the server said, decrypted, up to most bytes; none when it ended the connection
pub effect fn readTls(t: Tls, most: Int) -> Bytes! = runtime("net", "readTls", t, most)

// every byte sent, encrypted
pub effect fn writeTls(t: Tls, bytes: Bytes) -> Unit! = runtime("net", "writeTls", t, bytes)

// the end sent, and the socket closed
pub effect fn closeTls(t: Tls) = runtime("net", "closeTls", t)

// ---- tasks: functions run a step at a time (runtime/tasks.qk) ----
// a task of f: step runs it until it gives its turn back
pub effect fn spawn(f: effect () -> Unit) -> Task = runtime("tasks", "spawn", f)

// the task run until it yields or sleeps: true while it has more to do
pub effect fn step(task: Task) -> Bool = runtimeLine("tasks", "step", task)

// the task run to its end
pub effect fn joinTask(task: Task) = runtimeLine("tasks", "joinTask", task)

// the turn back to whoever runs this task (nothing, outside one)
pub effect fn yield() = runtime("tasks", "yield")

// the turn back until so many seconds went by (outside a task: a sleep)
pub effect fn sleep(seconds: Float) = runtime("tasks", "wait", seconds)

// ---- tasks in the background, and channels (runtime/tasks.qk) ----
// f as a task the background runs (runTasks, or a receive outside a task)
pub effect fn go(f: effect () -> Unit) -> Task = runtime("tasks", "go", f)

// every background task, run until all are done
pub effect fn runTasks() = runtimeLine("tasks", "runTasks")

// values from task to task, in the order they were sent: each a copy of its own (it goes from one task's memory
// to another's). Its T is told where it goes: let results: Channel<Int> = channel()
pub type Channel<T> { id: Int }

pub effect fn channel<T>() -> Channel<T> = runtime("tasks", "channel")

// the value at the end of the channel's queue (it never waits)
pub effect fn send<T>(channel: Channel<T>, value: T) = runtimeLine("tasks", "send", channel, value)

// the first value sent and not yet received (it waits for one); None once the channel is closed and empty
pub effect fn receive<T>(channel: Channel<T>) -> T? = runtimeLine("tasks", "receive", channel, -1.0)

// receive, waiting so many seconds at most: None when none came by then too
pub effect fn receiveWithin<T>(channel: Channel<T>, seconds: Float) -> T? =
    runtimeLine("tasks", "receive", channel, max(seconds, 0.0))

// no more values go in: receive gives those left, then None (closed and empty, its memory is let go of)
pub effect fn closeChannel<T>(channel: Channel<T>) = runtimeLine("tasks", "closeChannel", channel)

// the task stops, as a panic stops it (its defers do not run), where it next gives its turn back (now, when it is
// not running); a call it waits for on a thread (runProcess, connect) ends first. Ended already: nothing.
pub effect fn cancel(task: Task) = runtimeLine("tasks", "cancel", task)

// A scope: the tasks started in it end before scope(...) gives its value
pub type Scope { id: Int }

// body(scope)'s value, once every task scope.start(f) made has ended (the others go on meanwhile): no task of it
// outlives it. A task's panic stops the program, saying the line that started it.
pub effect fn scope<T>(body: effect (Scope) -> T) -> T {
    let s: Scope = runtime("tasks", "scopeOpen")
    defer {
        runtimeLine("tasks", "scopeClose", s)
    }
    body(s)
}

// f as a task of the scope, in the background: scope(...) waits for it
pub effect fn start(scope: Scope, f: effect () -> Unit) -> Task =
    runtimeLine("tasks", "scopeStart", scope, f)

// f's value, when f ends within so many seconds; None when it does not (it is cancelled then). f runs as a task in
// the background: what it waits for lets the others go on.
pub effect fn withTimeout<T>(seconds: Float, f: effect () -> T) -> T? {
    let out: Channel<T> = channel()
    let task = go(() => send(out, f()))
    let got = receiveWithin(out, seconds)
    cancel(task)
    closeChannel(out)
    got
}

// ---- the clock, and chance ----
// seconds, for timing: only differences mean something
pub effect fn monotonicTime() -> Float = runtime("clock", "now")

// seconds since 1970-01-01T00:00:00Z
pub effect fn unixTime() -> Float = runtime("clock", "time")

// a Float in [0, 1)
pub effect fn random() -> Float = runtime("random", "random")

// an Int from low up to high, high not included
pub effect fn randomInt(low: Int, high: Int) -> Int = runtimeLine("random", "randomInt", low, high)

// the same numbers from here on, for the same seed
pub effect fn seedRandom(seed: Int) = runtime("random", "seedRandom", seed)

// the local time's offset from UTC at that moment (seconds since 1970), in seconds east
pub effect fn localOffset(seconds: Float) -> Int = runtime("clock", "localOffset", seconds)
""" + "\n"

// std/NAME.qk's text
pub fn stdText(name: Text) -> Text? {
    if name == "args" {
        return r"""
// A program's command line read by what it takes: flags (--verbose, -v), options with a value (--out file,
// --out=file, -o file, -ofile), short flags together (-vq), the rest positional (all of it after --), and the usage
// text written from the same list.
//
//     let spec = [flag("verbose", short: "v", help: "say more"), option("out", short: "o", default: "a.txt")]
//     let given = parseArgs(args(), spec)?
//     if given.has("verbose") { ... }
//     let out = given.value("out") ?? "a.txt"
// one thing the command line may say: a flag, or an option with a value
pub type Arg {
    name: Text
    short: Text = "" // one letter, or none
    help: Text = ""
    takesValue: Bool = false
    default: Text? = None // an option's value when it is not given
}

// a flag: there or not (--name, -s)
pub fn flag(name: Text, short: Text = "", help: Text = "") -> Arg = Arg(name, short, help)

// an option with a value (--name value, --name=value, -s value, -svalue)
pub fn option(name: Text, short: Text = "", help: Text = "", default: Text? = None) -> Arg =
    Arg(name, short, help, takesValue: true, default: default)

// what the command line said
pub type Args { flags: Set<Text> = [], values: [Text: Text] = [:], positional: [Text] = [] }

// the flag was given
pub fn Args.has(self, name: Text) -> Bool = self.flags.contains(name)

// the option's value (its default when it was not given)
pub fn Args.value(self, name: Text) -> Text? = self.values[name]

// the option's value as an Int: Err when it was not given (and has no default) or is not a number
pub fn Args.int(self, name: Text) -> Int! {
    let Some(v) = self.values[name] else {
        return Err("--{name} was not given")
    }
    v.parseInt().mapErr(why => "--{name}: {why}")
}

fn byName(spec: [Arg], name: Text) -> Arg? = spec.first(a => a.name == name)

fn byShort(spec: [Arg], letter: Text) -> Arg? = spec.first(a => a.short != "" and a.short == letter)

// args read by spec (args(): what the program was given); Err says what was wrong, for the user to read
pub fn parseArgs(given: [Text], spec: [Arg]) -> Args! {
    var out = Args()
    for a in spec {
        if a.default is Some(d) {
            out.values[a.name] = d
        }
    }
    var i = 0
    var rest = false
    while i < len(given) {
        let word = given[i]
        i += 1
        if rest or word == "-" or not word.startsWith("-") {
            out.positional.push(word)
            continue
        }
        if word == "--" {
            rest = true
            continue
        }
        if word.startsWith("--") {
            let body = word[2..]
            let at = body.indexOf("=")
            let name = if at is Some(k) { body[..k] } else { body }
            let Some(a) = byName(spec, name) else {
                return Err("unknown option --{name}")
            }
            if not a.takesValue {
                if at != None {
                    return Err("--{name} takes no value")
                }
                out.flags.add(name)
                continue
            }
            if at is Some(k) {
                out.values[name] = body[k + 1..]
            } else if i < len(given) {
                out.values[name] = given[i]
                i += 1
            } else {
                return Err("--{name} needs a value")
            }
            continue
        }
        // -v, -vq (flags together), -o value, -ovalue
        var k = 1
        while k < len(word) {
            let letter = word[k..k + 1]
            let Some(a) = byShort(spec, letter) else {
                return Err("unknown option -{letter}")
            }
            if not a.takesValue {
                out.flags.add(a.name)
                k += 1
                continue
            }
            if k + 1 < len(word) {
                out.values[a.name] = word[k + 1..]
            } else if i < len(given) {
                out.values[a.name] = given[i]
                i += 1
            } else {
                return Err("-{letter} (--{a.name}) needs a value")
            }
            k = len(word)
        }
    }
    Ok(out)
}

// the usage text: the program's line, then each flag and option with its help
pub fn usage(program: Text, spec: [Arg], positional: Text = "") -> Text {
    var out = "usage: {program}" + (if len(spec) > 0 { " [options]" } else { "" })
    if positional != "" {
        out += " " + positional
    }
    var lefts: [Text] = []
    for a in spec {
        var left = if a.short != "" {
            "-{a.short}, --{a.name}"
        } else {
            "    --{a.name}"
        }
        if a.takesValue {
            left += " VALUE"
        }
        lefts.push(left)
    }
    let width = lefts.fold(0, (w, l) => max(w, len(l)))
    for (i, a) in spec.enumerate() {
        var help = a.help
        if a.default is Some(d) {
            help += (if help != "" { " " } else { "" }) + "(default: {d})"
        }
        out += "\n  " + lefts[i] + (if help != "" { " " * (width - len(lefts[i]) + 2) + help } else { "" })
    }
    out
}
""" + "\n"
    }
    if name == "collections" {
        return r"""
// Collections that are values: Queue (a double-ended queue) and Heap (a priority queue). A change gives a
// new collection and leaves the old one as it was; the two share what they hold.
pub enum Queue<T> { Empty, Items(front: Chain<T>, back: Chain<T>, size: Int) }

// a min-heap: top() is the smallest by <, so T is a number, a text, or a type with compare
pub enum Heap<T> { Empty, Node(size: Int, rank: Int, top: T, left: Heap<T>, right: Heap<T>) }

// a value ordered by its key alone, for a heap that ranks values by something else: Keyed(priority, job)
pub type Keyed<K, V> { key: K, value: V }

pub fn Keyed.compare(self, b: Self) -> Int {
    if self.key < b.key {
        return -1
    }
    if b.key < self.key { 1 } else { 0 }
}

// the values in order, first to last
pub fn queueOf<T>(xs: [T]) -> Queue<T> = balance(chainOf(xs), .End, len(xs))

pub fn Queue.size(self) -> Int = match self {
    Empty => 0
    Items(_, _, n) => n
}

pub fn Queue.isEmpty(self) -> Bool = self is Empty

// the first value, or None
pub fn Queue.front(self) -> T? = match self {
    Empty => None
    Items(f, b, _) => if f.isEnd() { b.head() } else { f.head() }
}

// the last value, or None
pub fn Queue.back(self) -> T? = match self {
    Empty => None
    Items(f, b, _) => if b.isEnd() { f.head() } else { b.head() }
}

// the queue with x after the last
pub fn Queue.pushBack(self, x: T) -> Self = match self {
    Empty => .Items(.End, .Link(x, .End), 1)
    Items(f, b, n) => balance(f, .Link(x, b), n + 1)
}

// the queue with x before the first
pub fn Queue.pushFront(self, x: T) -> Self = match self {
    Empty => .Items(.Link(x, .End), .End, 1)
    Items(f, b, n) => balance(.Link(x, f), b, n + 1)
}

// the queue without its first value (an empty one stays empty)
pub fn Queue.popFront(self) -> Self = match self {
    Empty => self
    Items(f, b, n) => if f.isEnd() { .Empty } else { balance(f.tail(), b, n - 1) }
}

// the queue without its last value (an empty one stays empty)
pub fn Queue.popBack(self) -> Self = match self {
    Empty => self
    Items(f, b, n) => if b.isEnd() { .Empty } else { balance(f, b.tail(), n - 1) }
}

// the values, first to last
pub fn Queue.toArray(self) -> [T] = match self {
    Empty => []
    Items(f, b, _) => f.toArray() + b.toArray().reversed()
}

// the values in a heap, smallest on top
pub fn heapOf<T>(xs: [T]) -> Heap<T> {
    var h: Heap<T> = .Empty
    for x in xs {
        h = h.push(x)
    }
    h
}

pub fn Heap.size(self) -> Int = match self {
    Empty => 0
    Node(n, _, _, _, _) => n
}

pub fn Heap.isEmpty(self) -> Bool = self is Empty

// the smallest value, or None
pub fn Heap.top(self) -> T? = match self {
    Empty => None
    Node(_, _, x, _, _) => x
}

// the heap with x in it
pub fn Heap.push(self, x: T) -> Self = meld(self, .Node(1, 1, x, .Empty, .Empty))

// the heap without its smallest value (an empty one stays empty)
pub fn Heap.pop(self) -> Self = match self {
    Empty => self
    Node(_, _, _, l, r) => meld(l, r)
}

// both heaps' values in one
pub fn Heap.merge(self, b: Self) -> Self = meld(self, b)

// the values, smallest first
pub fn Heap.toArray(self) -> [T] {
    var out: [T] = []
    var h = self
    while h is Node(_, _, x, l, r) {
        out.push(x)
        h = meld(l, r)
    }
    out
}

// a list linked from its head: the front of a queue, or its back from the last value
enum Chain<T> { End, Link(head: T, tail: Chain<T>) }

fn chainOf<T>(xs: [T]) -> Chain<T> {
    var c: Chain<T> = .End
    for i in 0..len(xs) {
        c = .Link(xs[len(xs) - 1 - i], c)
    }
    c
}

fn Chain.head(self) -> T? = match self {
    End => None
    Link(x, _) => x
}

fn Chain.isEnd(self) -> Bool = self is End

fn Chain.tail(self) -> Self = match self {
    End => self
    Link(_, rest) => rest
}

fn Chain.toArray(self) -> [T] {
    var out: [T] = []
    var c = self
    while c is Link(x, rest) {
        out.push(x)
        c = rest
    }
    out
}

// a queue whose sides are both full once it holds two values, so its two ends are each a step away: when
// one side runs out, it takes half the other's (a cost spread over the steps that emptied it)
fn balance<T>(f: Chain<T>, b: Chain<T>, n: Int) -> Queue<T> {
    if n == 0 {
        return .Empty
    }
    if n == 1 or not (f.isEnd() or b.isEnd()) {
        return .Items(f, b, n)
    }
    let xs = if f.isEnd() { b.toArray().reversed() } else { f.toArray() }
    .Items(chainOf(xs[..n / 2]), chainOf(xs[n / 2..].reversed()), n)
}

fn rank<T>(h: Heap<T>) -> Int = match h {
    Empty => 0
    Node(_, r, _, _, _) => r
}

// a node over two heaps, the one of higher rank on the left (a leftist heap: its right spine is short)
fn node<T>(x: T, a: Heap<T>, b: Heap<T>) -> Heap<T> {
    let n = a.size() + b.size() + 1
    if rank(a) >= rank(b) {
        .Node(n, rank(b) + 1, x, a, b)
    } else {
        .Node(n, rank(a) + 1, x, b, a)
    }
}

fn meld<T>(a: Heap<T>, b: Heap<T>) -> Heap<T> = match a {
    Empty => b
    Node(_, _, x, al, ar) => match b {
        Empty => a
        Node(_, _, y, bl, br) => if y < x {
            node(y, bl, meld(a, br))
        } else {
            node(x, al, meld(ar, b))
        }
    }
}
""" + "\n"
    }
    if name == "csv" {
        return r"""
// CSV as RFC 4180 has it: rows of fields split by a separator (a comma, or another byte), a field in double quotes
// when it holds the separator, a quote ("" inside) or a line break, rows ending at \n or \r\n. Read whole
// (parseCsv) or written (toCsv); a first row of names makes records of maps (csvRecords).
//
//     let rows = parseCsv(readFile("data.csv")?)?
//     for r in csvRecords(rows) { print(r["name"] ?? "?") }
// the rows of a CSV text (the last line break, if any, ends the last row); Err says where it stops being CSV
pub fn parseCsv(text: Text, separator: Int = ',') -> [[Text]]! {
    let b = text.bytes()
    var rows: [[Text]] = []
    var row: [Text] = []
    var field: Bytes = []
    var i = 0
    var quoted = false
    var line = 1
    var rowStarted = false
    while i < len(b) {
        let c = b[i]
        if quoted {
            if c == '"' {
                if i + 1 < len(b) and b[i + 1] == '"' {
                    field.push('"')
                    i += 2
                    continue
                }
                quoted = false
                i += 1
                if i < len(b) and b[i] != separator and b[i] != '\n' and b[i] != '\r' {
                    return Err("line {line}: a quoted field goes on after its closing quote")
                }
                continue
            }
            if c == '\n' {
                line += 1
            }
            field.push(c)
            i += 1
            continue
        }
        if c == '"' and len(field) == 0 {
            quoted = true
            rowStarted = true
            i += 1
            continue
        }
        if c == separator {
            row.push(Text(field) ?? "")
            field = []
            rowStarted = true
            i += 1
            continue
        }
        if c == '\r' and i + 1 < len(b) and b[i + 1] == '\n' {
            i += 1
            continue
        }
        if c == '\n' {
            row.push(Text(field) ?? "")
            rows.push(row)
            row = []
            field = []
            rowStarted = false
            line += 1
            i += 1
            continue
        }
        field.push(c)
        rowStarted = true
        i += 1
    }
    if quoted {
        return Err("line {line}: a quoted field is not closed")
    }
    if rowStarted or len(field) > 0 or len(row) > 0 {
        row.push(Text(field) ?? "")
        rows.push(row)
    }
    Ok(rows)
}

fn needsQuotes(t: Text, separator: Int) -> Bool =
    t.bytes().any(c => c == separator or c == '"' or c == '\n' or c == '\r')

// a field as CSV writes it: in quotes (its quotes doubled) when it must be
pub fn csvField(t: Text, separator: Int = ',') -> Text = if needsQuotes(t, separator) {
    "\"" + t.replace("\"", "\"\"") + "\""
} else {
    t
}

// the rows as CSV text, each row ending with \n
pub fn toCsv(rows: [[Text]], separator: Int = ',') -> Text {
    var out = ""
    let sep = char(separator)
    for row in rows {
        for (i, f) in row.enumerate() {
            if i > 0 {
                out += sep
            }
            out += csvField(f, separator)
        }
        out += "\n"
    }
    out
}

// the rows after the first, each a map from the first row's names to its fields (a row with fewer fields: those
// names left out)
pub fn csvRecords(rows: [[Text]]) -> [[Text: Text]] {
    if len(rows) == 0 {
        return []
    }
    let names = rows[0]
    var out: [[Text: Text]] = []
    for row in rows[1..] {
        var r: [Text: Text] = [:]
        for (i, f) in row.enumerate() {
            if i < len(names) {
                r[names[i]] = f
            }
        }
        out.push(r)
    }
    out
}
