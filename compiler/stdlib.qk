// Paths as text: joined, taken apart and normalized. Both / and \ separate parts, and a drive (C:) or a
// leading separator makes a path absolute; the paths given back use /, and windowsPath turns them to \.
//
// joinPath(a, b): b after a, with one separator between; an absolute b stands alone
pub fn joinPath(a: Text, b: Text) -> Text {
    if a == "" or isAbsolute(b) {
        return b
    }
    if b == "" {
        return a
    }
    if a.endsWith("/") or a.endsWith("\\") { a + b } else { a + "/" + b }
}

// the path without "." parts, separators doubled or at the end, or a part followed by ".." (at the root,
// ".." stays there); "a/./b/../c/" is "a/c", and an empty path is "."
pub fn normalize(path: Text) -> Text {
    let r = root(path)
    var parts: [Text] = []
    for p in partsOf(path[len(r)..]) {
        if p == ".." and len(parts) > 0 and parts[len(parts) - 1] != ".." {
            parts = parts[..len(parts) - 1]
        } else if p == ".." and r.endsWith("/") {
            continue
        } else {
            parts.push(p)
        }
    }
    let rest = parts.join("/")
    if r == "" and rest == "" { "." } else { r + rest }
}

// the parts after the root: "/usr/lib/" is ["usr", "lib"]
pub fn pathParts(path: Text) -> [Text] {
    let n = normalize(path)
    if n == "." { [] } else { partsOf(n[len(root(n))..]) }
}

// the folder the path is in: "a/b/c.txt" is "a/b", "c.txt" is ".", and a root is itself
pub fn parent(path: Text) -> Text {
    let n = normalize(path)
    let r = root(n)
    let parts = partsOf(n[len(r)..])
    if len(parts) == 0 {
        return if r == "" { ".." } else { r }
    }
    if parts[len(parts) - 1] == ".." {
        return n + "/.."
    }
    let up = r + parts[..len(parts) - 1].join("/")
    if up == "" { "." } else { up }
}

// the last part: "a/b/c.txt" is "c.txt", and a root has none ("")
pub fn fileName(path: Text) -> Text {
    let parts = pathParts(path)
    if len(parts) == 0 { "" } else { parts[len(parts) - 1] }
}

// the file name's text after its last dot, without it: "a/b.tar.gz" is "gz"; ".profile" and "make" have none
pub fn extension(path: Text) -> Text = splitName(fileName(path)).1

// the file name without its extension: "a/b.tar.gz" is "b.tar"
pub fn stem(path: Text) -> Text = splitName(fileName(path)).0

// the path with its file name's extension changed (or added, or taken away with "")
pub fn withExtension(path: Text, ext: Text) -> Text {
    let old = fileName(path)
    if old == "" or old == ".." {
        return normalize(path)
    }
    let name = stem(path) + (if ext == "" { "" } else { "." + ext })
    let up = parent(path)
    if up == "." { name } else { joinPath(up, name) }
}

// whether it starts at a root: "/x", "\x", "C:/x", "C:\x"
pub fn isAbsolute(path: Text) -> Bool = root(path).endsWith("/")

// the path with \ between its parts, as Windows writes it
pub fn windowsPath(path: Text) -> Text = path.replace("/", "\\")

// a file name before and after its last dot: "b.tar.gz" is ("b.tar", "gz"), ".profile" is (".profile", "")
fn splitName(name: Text) -> (Text, Text) {
    let dots = name.split(".")
    let dot = len(name) - len(dots[len(dots) - 1]) - 1
    if dot <= 0 or name == ".." {
        (name, "")
    } else {
        (name[..dot], name[dot + 1..])
    }
}

fn isSeparator(c: Int) -> Bool = c is '/' | '\\'

// where the path starts, written with /: "/", "C:/", "C:" (a drive's current folder), or "" (relative)
fn root(path: Text) -> Text {
    let b = path.bytes()
    if len(b) >= 2 and b[1] == ':' and b[0] is 'a'..='z' | 'A'..='Z' {
        return if len(b) >= 3 and isSeparator(b[2]) {
            path[..2] + "/"
        } else {
            path[..2]
        }
    }
    if len(b) >= 1 and isSeparator(b[0]) { "/" } else { "" }
}

// the parts between separators, without empty ones and "."
fn partsOf(path: Text) -> [Text] =
    path.replace("\\", "/").split("/").filter(p => p != "" and p != ".")
""" + "\n"
    }
    if name == "regex" {
        return r"""
// Patterns that match text. regex(pattern) understands literal characters, . (any but a line break),
// classes [a-z_] and [^0-9], the escapes \d \w \s (and \D \W \S, outside classes), \b \B (a word's edge
// or not), \n \t \r and \ before any other character for that character, ^ and $ (the text's start and end),
// x* x+ x? x{n} x{n,} x{n,m} (as many as can be; with ? after, as few), x|y, groups ( ) whose text a match
// keeps, and (?: ) that keeps none. A character is a code point: . and a class match one, however many
// bytes it takes. The first match is the leftmost, and among those the one the pattern prefers. A search
// takes time in step with the text's length times the pattern's, never more.
pub type Regex { pattern: Text, groups: Int, prog: [Inst] }

// where a match is (bytes, as t[start..end] slices it), its text, and each group's ("" when it took no part)
pub type Match { start: Int, end: Int, text: Text, groups: [Text] }

// the pattern, ready to search with, or why it is not one
pub fn regex(pattern: Text) -> Regex! {
    var p = Parser(pattern.codePoints(), 0, 0)
    let node = p.alt()?
    if p.at < len(p.cs) {
        return Err("regex: a ) without its (, at character {p.at}")
    }
    let start: [Inst] = [.Split(3, 1), .Set([], true), .Jump(0)] // anywhere: skip a character, or begin here
    Regex(pattern, p.groups, start + emit(.Group(0, node), len(start)) + [Inst.Done])
}

// whether the whole text matches
pub fn Regex.matches(self, text: Text) -> Bool = len(search(self, text.bytes(), false, true)) > 0

// the first match, or None
pub fn Regex.find(self, text: Text) -> Match? {
    let found = search(self, text.bytes(), false, false)
    if len(found) == 0 { None } else { matchOf(text, found[0]) }
}

// every match, one after the other, from the first
pub fn Regex.findAll(self, text: Text) -> [Match] =
    search(self, text.bytes(), true, false).map(slots => matchOf(text, slots)).toArray()

// the text with every match replaced: $0 in the replacement is the match, $1 to $9 its groups, $$ a $
pub fn Regex.replaceAll(self, text: Text, replacement: Text) -> Text =
    self.replaceEach(text, m => expand(replacement, m))

// the text with every match replaced by what f makes of it
pub fn Regex.replaceEach(self, text: Text, f: (Match) -> Text) -> Text {
    var out = ""
    var last = 0
    for m in self.findAll(text) {
        out += text[last..m.start] + f(m)
        last = m.end
    }
    out + text[last..]
}

// the parts of the text between the matches
pub fn Regex.split(self, text: Text) -> [Text] {
    var parts: [Text] = []
    var last = 0
    for m in self.findAll(text) {
        if m.end > m.start {
            parts.push(text[last..m.start])
            last = m.end
        }
    }
    parts.push(text[last..])
    parts
}

// a range of code points, low and high included
type Span { low: Int, high: Int }

// the pattern as a tree
enum Node {
    Lit(c: Int)
    Set(spans: [Span], negated: Bool)
    Start
    Finish
    Edge(word: Bool)
    Group(index: Int, inner: Node)
    Cat(items: [Node])
    Alt(options: [Node])
    Repeat(inner: Node, low: Int, high: Int, greedy: Bool)
}

// the pattern as a program over code points: Split goes on at first and, if that fails, at second; Save
// keeps where a group starts or ends
enum Inst {
    Char(c: Int)
    Set(spans: [Span], negated: Bool)
    Start
    Finish
    Edge(word: Bool)
    Split(first: Int, second: Int)
    Jump(to: Int)
    Save(slot: Int)
    Done
}

// a step of the search still to try (slot below 0), or a slot to set back when the search comes back past it
type Job { pc: Int, at: Int, slot: Int }

// where parsing is: the pattern's code points, how many are read, how many groups it has seen
type Parser { cs: [Int], at: Int, groups: Int }

// the code point k after where parsing is, -1 past the end
fn Parser.ahead(self, k: Int) -> Int = self.cs.get(self.at + k) ?? -1

fn Parser.alt(var self) -> Node! {
    var options = [self.cat()?]
    while self.ahead(0) == '|' {
        self.at += 1
        options.push(self.cat()?)
    }
    if len(options) == 1 { options[0] } else { Node.Alt(options) }
}

fn Parser.cat(var self) -> Node! {
    var items: [Node] = []
    while self.at < len(self.cs) and self.ahead(0) != '|' and self.ahead(0) != ')' {
        items.push(self.repeat()?)
    }
    if len(items) == 1 { items[0] } else { Node.Cat(items) }
}

fn Parser.repeat(var self) -> Node! {
    var node = self.atom()?
    while self.at < len(self.cs) {
        let at = self.at
        let (low, high) = self.count() ?? break
        if node is Start | Finish | Edge(_) {
            return Err("regex: nothing to repeat before \"{char(self.cs[at])}\", at character {at}")
        }
        if high >= 0 and high < low or high > 1000 or low > 1000 {
            return Err("regex: a count from 0 to 1000, the smaller first, at character {at}")
        }
        let lazy = self.ahead(0) == '?'
        if lazy {
            self.at += 1
        }
        node = .Repeat(node, low, high, not lazy)
    }
    node
}

// * + ? {n} {n,} {n,m}: how many (m -1 for no end), parsing past it; or None, parsing where it was
fn Parser.count(var self) -> (Int, Int)? {
    let at = self.at
    self.at += 1
    let count: (Int, Int)? = match self.cs[at] {
        '*' => Some((0, -1))
        '+' => Some((1, -1))
        '?' => Some((0, 1))
        '{' => self.bounds()
        _ => None
    }
    if count is None {
        self.at = at
    }
    count
}

// n}, n,} or n,m} after a {
fn Parser.bounds(var self) -> (Int, Int)? {
    let low = self.number()?
    if self.ahead(0) == ',' {
        self.at += 1
        if self.ahead(0) == '}' {
            self.at += 1
            return (low, -1)
        }
        let high = self.number()?
        return if self.ahead(0) == '}' {
            self.at += 1
            (low, high)
        } else {
            None
        }
    }
    if self.ahead(0) != '}' {
        return None
    }
    self.at += 1
    (low, low)
}

fn Parser.number(var self) -> Int? {
    let from = self.at
    var n = 0
    while self.ahead(0) is '0'..='9' and n <= 100_000 {
        n = n * 10 + self.ahead(0) - '0'
        self.at += 1
    }
    if self.at == from { None } else { n }
}

fn Parser.atom(var self) -> Node! {
    let at = self.at
    let c = self.cs[at]
    self.at += 1
    if c == '(' {
        let keeps = not (self.ahead(0) == '?' and self.ahead(1) == ':')
        if keeps {
            self.groups += 1
        } else {
            self.at += 2
        }
        let index = self.groups
        let inner = self.alt()?
        if self.at >= len(self.cs) {
            return Err("regex: a ( without its ), at character {at}")
        }
        self.at += 1
        return if keeps { Node.Group(index, inner) } else { inner }
    }
    if c == '[' {
        return self.class()
    }
    if c == '\\' {
        let e = self.ahead(0)
        if e < 0 {
            return Err(r"regex: a \ at the end")
        }
        self.at += 1
        return if e == 'b' or e == 'B' {
            Node.Edge(e == 'b')
        } else {
            escapeSet(e) ?? Node.Lit(escapeChar(e))
        }
    }
    if c == '*' or c == '+' or c == '?' {
        return Err("regex: nothing to repeat before \"{char(c)}\", at character {at}")
    }
    let node: Node = match c {
        '.' => .Set([Span('\n', '\n')], true)
        '^' => .Start
        '$' => .Finish
        _ => .Lit(c)
    }
    node
}

// [...] after its [: the ranges and characters in it, up to its ]
fn Parser.class(var self) -> Node! {
    let from = self.at
    let negated = self.ahead(0) == '^'
    if negated {
        self.at += 1
    }
    var spans: [Span] = []
    var first = true
    while self.at < len(self.cs) and (self.ahead(0) != ']' or first) {
        first = false
        var low = self.ahead(0)
        if low == '\\' and self.ahead(1) >= 0 {
            match escapeSet(self.ahead(1)) {
                Some(Set(more, out)) => {
                    if out {
                        return Err(
                            "regex: \\{char(self.ahead(1))} inside [ ], at character {self.at}: write [^...] instead",
                        )
                    }
                    spans += more
                    self.at += 2
                    continue
                }
                _ => {
                    low = escapeChar(self.ahead(1))
                    self.at += 1
                }
            }
        }
        self.at += 1
        var high = low
        if self.ahead(0) == '-' and self.ahead(1) != ']' and self.ahead(1) >= 0 {
            high = self.ahead(1)
            self.at += 2
            if high == '\\' and self.ahead(0) >= 0 {
                high = escapeChar(self.ahead(0))
                self.at += 1
            }
            if high < low {
                return Err("regex: the range {char(low)}-{char(high)} goes backwards, at character {self.at}")
            }
        }
        spans.push(Span(low, high))
    }
    if self.at >= len(self.cs) {
        return Err("regex: a [ without its ], at character {from - 1}")
    }
    self.at += 1
    Node.Set(spans, negated)
}

// \d \w \s and \D \W \S: digits, a word's characters, spaces
fn escapeSet(e: Int) -> Node? = match e {
    'd' => .Set(digitSpans(), false)
    'D' => .Set(digitSpans(), true)
    'w' => .Set(wordSpans(), false)
    'W' => .Set(wordSpans(), true)
    's' => .Set(spaceSpans(), false)
    'S' => .Set(spaceSpans(), true)
    _ => None
}

fn escapeChar(e: Int) -> Int = match e {
    'n' => '\n'
    't' => '\t'
    'r' => '\r'
    _ => e
}

fn digitSpans() -> [Span] = [Span('0', '9')]

fn wordSpans() -> [Span] = [Span('a', 'z'), Span('A', 'Z'), Span('0', '9'), Span('_', '_')]

fn spaceSpans() -> [Span] = [Span(' ', ' '), Span('\t', '\t'), Span('\n', '\n'), Span('\r', '\r')]

// the program for the node, to go at base in the whole program
fn emit(node: Node, base: Int) -> [Inst] {
    var p: [Inst] = []
    match node {
        Lit(c) => p.push(.Char(c))
        Set(spans, negated) => p.push(.Set(spans, negated))
        Start => p.push(.Start)
        Finish => p.push(.Finish)
        Edge(word) => p.push(.Edge(word))
        Group(i, inner) => {
            p.push(.Save(2 * i))
            p += emit(inner, base + len(p))
            p.push(.Save(2 * i + 1))
        }
        Cat(items) => {
            for item in items {
                p += emit(item, base + len(p))
            }
        }
        Alt(options) => {
            var ends: [Int] = []
            for (k, option) in options.enumerate() {
                if k == len(options) - 1 {
                    p += emit(option, base + len(p))
                } else {
                    let split = len(p)
                    p.push(.Done)
                    p += emit(option, base + len(p))
                    ends.push(len(p))
                    p.push(.Done)
                    p[split] = .Split(base + split + 1, base + len(p))
                }
            }
            for e in ends {
                p[e] = .Jump(base + len(p))
            }
        }
        Repeat(inner, low, high, greedy) => {
            for i in 0..low {
                p += emit(inner, base + len(p))
            }
            var forks: [Int] = []
            for i in 0..(if high < 0 { 1 } else { high - low }) {
                forks.push(len(p))
                p.push(.Done)
                p += emit(inner, base + len(p))
                if high < 0 {
                    p.push(.Jump(base + forks[0]))
                }
            }
            for f in forks {
                p[f] = if greedy {
                    .Split(base + f + 1, base + len(p))
                } else {
                    .Split(base + len(p), base + f + 1)
                }
            }
        }
    }
    p
}

// the slots (the match's start and end, as byte offsets, then each group's) of the first match, or of every
// match when all; whole: only one that is all the text. The bytes are UTF-8, and a step over a character
// reads one code point. A step (an instruction at a byte) that was tried once and came to nothing never
// matches, so it is never tried again: that keeps the search linear.
fn search(r: Regex, bs: Bytes, all: Bool, whole: Bool) -> [[Int]] {
    let n = len(bs)
    let m = len(r.prog)
    let slots = 2 * (r.groups + 1)
    var tried = [0] * (((n + 1) * m + 63) / 64)
    var found: [[Int]] = []
    var jobs: [Job] = []
    var from = 0
    while from <= n {
        var caps = [-1] * slots
        jobs = [Job(if whole { 3 } else { 0 }, from, -1)]
        var top = 1
        var matched = false
        while top > 0 and not matched {
            top -= 1
            let job = jobs[top]
            if job.slot >= 0 {
                caps[job.slot] = job.at
                continue
            }
            var pc = job.pc
            var sp = job.at
            var going = true
            while going {
                let k = sp * m + pc
                let bit = 1 << (k & 63)
                if tried[k >> 6] & bit != 0 {
                    break
                }
                tried[k >> 6] = tried[k >> 6] | bit
                match r.prog[pc] {
                    Char(c) => {
                        going = sp < n and codeAt(bs, sp) == c
                        pc += 1
                        sp += if going { width(bs[sp]) } else { 1 }
                    }
                    Set(spans, negated) => {
                        going = sp < n and inSet(spans, codeAt(bs, sp)) != negated
                        pc += 1
                        sp += if going { width(bs[sp]) } else { 1 }
                    }
                    Start => {
                        going = sp == 0
                        pc += 1
                    }
                    Finish => {
                        going = sp == n
                        pc += 1
                    }
                    Edge(word) => {
                        going = ((sp > 0 and isWord(bs[sp - 1])) != (sp < n and isWord(bs[sp]))) == word
                        pc += 1
                    }
                    Split(first, second) => {
                        let next = Job(second, sp, -1)
                        if top == len(jobs) {
                            jobs.push(next)
                        } else {
                            jobs[top] = next
                        }
                        top += 1
                        pc = first
                    }
                    Jump(to) => {
                        pc = to
                    }
                    Save(slot) => {
                        let next = Job(0, caps[slot], slot)
                        if top == len(jobs) {
                            jobs.push(next)
                        } else {
                            jobs[top] = next
                        }
                        top += 1
                        caps[slot] = sp
                        pc += 1
                    }
                    Done => {
                        matched = not whole or sp == n
                        going = false
                    }
                }
            }
        }
        if not matched {
            break
        }
        found.push(caps)
        if not all {
            break
        }
        let end = caps[1]
        if end == caps[0] {
            from = end + (if end < n { width(bs[end]) } else { 1 })
        } else {
            from = end
            for pc in 0..m {
                // what led to this match at its end may lead to the next one
                let k = end * m + pc
                tried[k >> 6] = tried[k >> 6] & ~(1 << (k & 63))
            }
        }
    }
    found
}

// how many bytes the character whose first byte is b takes
fn width(b: Int) -> Int = match b {
    ..0x80 => 1
    ..0xe0 => 2
    ..0xf0 => 3
    _ => 4
}

// the code point whose bytes start at i
fn codeAt(bs: Bytes, i: Int) -> Int {
    let b = bs[i]
    if b < 0x80 {
        b
    } else if b < 0xe0 {
        b & 0x1f << 6 | bs[i + 1] & 0x3f
    } else if b < 0xf0 {
        b & 0x0f << 12 | bs[i + 1] & 0x3f << 6 | bs[i + 2] & 0x3f
    } else {
        b & 0x07 << 18 | bs[i + 1] & 0x3f << 12 | bs[i + 2] & 0x3f << 6 | bs[i + 3] & 0x3f
    }
}

fn inSet(spans: [Span], c: Int) -> Bool = spans.any(s => c >= s.low and c <= s.high)

// whether the byte is a word's (a word's characters are ASCII; no byte of a longer character is one)
fn isWord(b: Int) -> Bool = b is 'a'..='z' | 'A'..='Z' | '0'..='9' | '_'

fn matchOf(text: Text, slots: [Int]) -> Match {
    let groups = (1..len(slots) / 2).map(g => if slots[2 * g] < 0 {
        ""
    } else {
        text[slots[2 * g]..slots[2 * g + 1]]
    })
    Match(slots[0], slots[1], text[slots[0]..slots[1]], groups)
}

// the replacement with $0 to $9 put in
fn expand(replacement: Text, m: Match) -> Text {
    let bs = replacement.bytes()
    var out = ""
    var last = 0
    var i = 0
    while i + 1 < len(bs) {
        let next = bs[i + 1]
        if bs[i] == '$' and (next == '$' or next is '0'..='9') {
            let piece = match next {
                '$' => "$"
                '0' => m.text
                _ => m.groups.get(next - '1') ?? ""
            }
            out += replacement[last..i] + piece
            i += 2
            last = i
        } else {
            i += 1
        }
    }
    out + replacement[last..]
}
""" + "\n"
    }
    if name == "testing" {
        return r"""
// Checks for tests (quark test) and programs, beyond assert: each one that fails says what it found and
// what it wanted, then stops (in a test, only that test). what, when given, names what is checked.
// assertEqual(actual, expected): when they differ, both values go to the error output, whatever their
// type, and the program stops.
pub fn assertEqual<T>(actual: T, expected: T, what: Text = "") {
    let same = actual == expected
    if not same {
        printErr("{named(what)}expected:", expected)
        printErr("{named(what)}     got:", actual)
    }
    assert(same, "{named(what)}assertEqual: the values differ")
}

// actual and other differ, or stop, showing the value
pub fn assertNotEqual<T>(actual: T, other: T, what: Text = "") {
    let same = actual == other
    if same {
        printErr("{named(what)}both are:", actual)
    }
    assert(not same, "{named(what)}assertNotEqual: the values are the same")
}

// actual is within tolerance of expected, or stop: for Floats, which a computation seldom gives exactly
pub fn assertNear(actual: Float, expected: Float, tolerance: Float = 1e-9, what: Text = "") {
    assert(
        abs(actual - expected) <= tolerance,
        "{named(what)}assertNear: {actual} is not within {tolerance} of {expected}",
    )
}

// the result is an Err whose message has part in it, or stop: for code that must refuse what it is given
pub fn assertErr<T>(result: T!, part: Text = "", what: Text = "") {
    let wrong = match result {
        Ok(value) => {
            printErr("{named(what)}got Ok:", value)
            "the result is Ok"
        }
        Err(why) => if contains(why, part) {
            ""
        } else {
            "the error \"{why}\" does not say \"{part}\""
        }
    }
    assert(wrong == "", "{named(what)}assertErr: {wrong}")
}

fn named(what: Text) -> Text = if what == "" { "" } else { "{what}: " }
""" + "\n"
    }
    if name == "time" {
        return r"""
// Dates and times in UTC, on the Gregorian calendar: from and to the seconds unixTime() gives, weekdays, days
// added, and ISO 8601 text both ways (2026-11-13, 2026-11-13T09:30:05.250Z); and the local time, by the system's
// time zone (localOffset).
pub type Date { year: Int, month: Int, day: Int }

// a moment to the millisecond, in UTC
pub type DateTime {
    year: Int
    month: Int
    day: Int
    hour: Int
    minute: Int
    second: Int
    millisecond: Int
}

pub enum Weekday { Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday }

// the moment that many seconds after 1970-01-01T00:00:00Z: utc(unixTime()) is now
pub fn utc(seconds: Float) -> DateTime {
    let ms = round(seconds * 1000)
    let d = dateOfDays(ms / 86_400_000)
    let inDay = ms % 86_400_000
    DateTime(d.year, d.month, d.day, inDay / 3_600_000, inDay / 60_000 % 60, inDay / 1000 % 60, inDay % 1000)
}

// the date that many days after 1970-01-01 (before it, below 0)
pub fn dateOfDays(days: Int) -> Date {
    let z = days + 719_468
    let era = z / 146_097
    let doe = z - era * 146_097
    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let month = if mp < 10 { mp + 3 } else { mp - 9 }
    Date(yoe + era * 400 + (if month <= 2 { 1 } else { 0 }), month, doy - (153 * mp + 2) / 5 + 1)
}

pub fn isLeapYear(year: Int) -> Bool = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)

pub fn daysInMonth(year: Int, month: Int) -> Int = match month {
    2 => if isLeapYear(year) { 29 } else { 28 }
    _ if month == 4 or month == 6 or month == 9 or month == 11 => 30
    _ => 31
}

// the days from 1970-01-01 to it (before it, below 0)
pub fn Date.days(self) -> Int {
    let y = if self.month <= 2 { self.year - 1 } else { self.year }
    let era = y / 400
    let yoe = y - era * 400
    let doy = (153 * (if self.month > 2 { self.month - 3 } else { self.month + 9 }) + 2) / 5 + self.day - 1
    era * 146_097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719_468
}

// whether the month is 1 to 12 and the day is in it
pub fn Date.isValid(self) -> Bool =
    self.month >= 1 and self.month <= 12 and self.day >= 1 and self.day <= daysInMonth(self.year, self.month)

pub fn Date.weekday(self) -> Weekday = match (self.days() + 3) % 7 {
    0 => .Monday
    1 => .Tuesday
    2 => .Wednesday
    3 => .Thursday
    4 => .Friday
    5 => .Saturday
    _ => .Sunday
}

// the date n days later (earlier, for n below 0)
pub fn Date.addDays(self, n: Int) -> Self = dateOfDays(self.days() + n)

// the same day n months later, or the month's last day when it has fewer: 01-31 plus a month is 02-28
pub fn Date.addMonths(self, n: Int) -> Self {
    let m = self.year * 12 + self.month - 1 + n
    let year = m / 12
    let month = m % 12 + 1
    Self(year, month, min(self.day, daysInMonth(year, month)))
}

// the moment at that time of the day: Date(2026, 11, 13).at(9, 30)
pub fn Date.at(self, hour: Int, minute: Int, second: Int = 0, millisecond: Int = 0) -> DateTime =
    DateTime(self.year, self.month, self.day, hour, minute, second, millisecond)

pub fn Date.compare(self, b: Self) -> Int = self.days() - b.days()

// as ISO 8601: 2026-11-13
pub fn Date.toIso(self) -> Text =
    "{padded(self.year, 4)}-{padded(self.month, 2)}-{padded(self.day, 2)}"

pub fn DateTime.date(self) -> Date = Date(self.year, self.month, self.day)

// the seconds from 1970-01-01T00:00:00Z to it, as unixTime() gives them
pub fn DateTime.seconds(self) -> Float = toFloat(self.milliseconds()) / 1000

pub fn DateTime.weekday(self) -> Weekday = self.date().weekday()

pub fn DateTime.addSeconds(self, s: Float) -> Self = utc(self.seconds() + s)

pub fn DateTime.addDays(self, n: Int) -> Self {
    let d = self.date().addDays(n)
    self with { year: d.year, month: d.month, day: d.day }
}

pub fn DateTime.compare(self, b: Self) -> Int = self.milliseconds() - b.milliseconds()

// as ISO 8601 in UTC: 2026-11-13T09:30:05Z, with .250 before the Z when there are milliseconds
pub fn DateTime.toIso(self) -> Text {
    let ms = if self.millisecond == 0 {
        ""
    } else {
        ".{padded(self.millisecond, 3)}"
    }
    "{self.date().toIso()}T{padded(self.hour, 2)}:{padded(self.minute, 2)}:{padded(self.second, 2)}{ms}Z"
}

// an ISO 8601 date, YYYY-MM-DD, or why it is not one
pub fn parseDate(text: Text) -> Date! {
    let t = text.trim()
    let d = readDate(t.bytes(), text)?
    if len(t) > 10 {
        return Err("date: \"{charAt(t, 10)}\" after the date in \"{text}\"")
    }
    d
}

// an ISO 8601 date and time: 2026-11-13T09:30, with seconds (:05), their fraction (.25) and Z or an offset
// (+02:00, -0530) after it if it has them; the time may follow a space instead of the T, and a date alone is
// its midnight. Without Z or an offset it is taken as UTC; with an offset it is turned to UTC.
pub fn parseDateTime(text: Text) -> DateTime! {
    let t = text.trim()
    let b = t.bytes()
    let d = readDate(b, text)?
    if len(b) == 10 {
        return d.at(0, 0)
    }
    if not b[10] is 'T' | 't' | ' ' {
        return Err("date: a T before the time in \"{text}\"")
    }
    let hour = number(b, 11, 2) ?? -1
    let minute = if b.get(13) == ':' { number(b, 14, 2) ?? -1 } else { -1 }
    if hour < 0 or hour > 23 or minute < 0 or minute > 59 {
        return Err("date: expected the time as hh:mm in \"{text}\"")
    }
    var at = 16
    var second = 0
    var ms = 0
    if b.get(at) == ':' {
        second = number(b, at + 1, 2) ?? -1
        if second < 0 or second > 59 {
            return Err("date: expected seconds (00 to 59) after hh:mm in \"{text}\"")
        }
        at += 3
        if at < len(b) and b[at] is '.' | ',' {
            at += 1
            var scale = 100
            while at < len(b) and b[at] is '0'..='9' {
                ms += (b[at] - '0') * scale
                scale /= 10
                at += 1
            }
        }
    }
    let moment = d.at(hour, minute, second, ms)
    if at == len(b) {
        return moment
    }
    if b[at] is 'Z' | 'z' and at + 1 == len(b) {
        return moment
    }
    if b[at] is '+' | '-' {
        let sign = if b[at] == '+' { 1 } else { -1 }
        let oh = number(b, at + 1, 2) ?? -1
        let colon = b.get(at + 3) == ':'
        let om = if at + 3 == len(b) {
            0
        } else {
            number(b, at + (if colon { 4 } else { 3 }), 2) ?? -1
        }
        let end = if at + 3 == len(b) {
            at + 3
        } else if colon {
            at + 6
        } else {
            at + 5
        }
        if oh >= 0 and oh <= 23 and om >= 0 and om <= 59 and end == len(b) {
            return moment.addSeconds(toFloat(-sign * (oh * 3600 + om * 60)))
        }
    }
    Err("date: \"{t[at..]}\" is not Z or an offset (+hh:mm) in \"{text}\"")
}

fn DateTime.milliseconds(self) -> Int =
    self.date().days() * 86_400_000
        + self.hour * 3_600_000
        + self.minute * 60_000
        + self.second * 1000
        + self.millisecond

// the date at the start of the bytes (the text's, for a message)
fn readDate(b: Bytes, text: Text) -> Date! {
    let y = number(b, 0, 4)
    let m = if b.get(4) == '-' { number(b, 5, 2) } else { None }
    let d = if b.get(7) == '-' { number(b, 8, 2) } else { None }
    let missing = "date: expected YYYY-MM-DD, found \"{text}\""
    let year = y ?? return Err(missing)
    let month = m ?? return Err(missing)
    let day = d ?? return Err(missing)
    let date = Date(year, month, day)
    if not date.isValid() {
        return Err("date: {date.toIso()} is not a day of the calendar")
    }
    date
}

// the n digits at b[at..] as a number, or None
fn number(b: Bytes, at: Int, n: Int) -> Int? {
    if at + n > len(b) {
        return None
    }
    var v = 0
    for c in b[at..at + n] {
        if c < '0' or c > '9' {
            return None
        }
        v = v * 10 + c - '0'
    }
    v
}

// the character that starts at byte i, for a message
fn charAt(t: Text, i: Int) -> Text = char(t[i..].codePoints().first() ?? 0)

// n's digits, with zeros in front to make at least the width
fn padded(n: Int, width: Int) -> Text {
    let t = abs(n).toText()
    let sign = if n < 0 { "-" } else { "" }
    sign + "0" * max(0, width - len(t)) + t
}

// now, in UTC
pub fn now() -> DateTime = utc(unixTime())

// the local date and time at that moment, by the system's time zone (its daylight saving time too)
pub fn local(seconds: Float) -> DateTime = utc(seconds + toFloat(localOffset(seconds)))

// now, in local time
pub fn localNow() -> DateTime = local(unixTime())
""" + "\n"
    }
    None
}

// the runtime's files
pub const runtimeFiles: [Text] = ["arena", "base", "counted", "debug", "files", "host", "io", "linux", "loader", "loops", "macos", "map", "numbers", "panic", "print", "start", "tasks", "text", "threads", "trace", "windows"]

// compiler/runtime/NAME.qk's text
pub fn runtimeText(name: Text) -> Text? {
    if name == "arena" {
        return r"""
// The arena: memory comes from blocks, by bumping a pointer. Blocks after the current one are empty, so the list is
// in the order things were made, and going back to a mark frees everything made after it at once (loops.qk). A large
// allocation (largeFrom bytes or more) gets a block of its own, outside the list: a loop keeps it in place while its
// vars reach it. Arrays and texts that grow keep their room in a table by address; containers from before a loop's
// mark that the loop changes in place are remembered, an array's by its cards (16 elements each).
use base

// an arena's words
pub const aBlocks = 0
pub const aCurrent = 1
pub const aExtras = 2 // survivors: what loops copied out, outside the blocks
pub const aClock = 3
pub const aAllocated = 4 // bytes handed out, ever
pub const aGrowing = 5 // the rooms: growingEntries (address, bytes) pairs
pub const aGrowingBits = 6 // the table's buckets: 2^bits
pub const aGrowingUsed = 7
pub const aLastText = 8 // the last text made: s + t appends in place while it is the top
pub const aReserved = 9
pub const aLimit = 10
pub const aMarkBlock = 11
pub const aMarkUsed = 12
pub const aMarked = 13
pub const aRemembered = 14 // remembered entries (rememberedWords each) by address, open addressing
pub const aRememberedCap = 15
pub const aRememberedCount = 16
pub const aLarge = 17 // the large blocks, the latest first
pub const aSpare = 18 // large blocks given back, kept for one of the same size (a few: memory touched already)
pub const aSpareCount = 19
pub const aGrowingEvicted = 20 // rooms a full bucket gave its place away to make, since the table was made
pub const aUnused21 = 21 // (free)
pub const aSide = 22 // the loop collections' side table (loops.qk sideSlot), kept from one to the next
pub const aSideBytes = 23
pub const aSideEpoch = 24 // the collection its entries are of (1 to 15): an entry of another is empty
pub const arenaWords = 25

// a block's words, then its bytes (16-aligned)
pub const bNext = 0
pub const bSize = 1
pub const bUsed = 2
pub const bData = 3

// a survivor's
pub const xNext = 0
pub const xTime = 1
pub const xSize = 2
pub const xUsed = 3
pub const xData = 4

// a large block's words (its time: the clock when it was made; marked: reached by the collection under way), then its
// bytes (16-aligned)
pub const bigNext = 0
pub const bigTime = 1
pub const bigSize = 2
pub const bigMarked = 3
pub const bigData = 4
pub const largeFrom = 65536
const largeSpare = 4
const growingFirstBits = 10 // 1024 buckets to start with
const growingWays = 4
const blockSize = 16777216

pub fn arena() -> Int = ctxGet(ctxArena)

pub fn arenaNew() -> Int {
    let a = calloc(1, 8 * arenaWords)
    if a != 0 {
        setWord(a, aGrowing, calloc(1 << growingFirstBits * growingWays, 16))
        setWord(a, aGrowingBits, growingFirstBits)
    }
    a
}

// an arena for code the running program's (a task's, a thread's)
pub fn arenaLike() -> Int = arenaNew()

// the memory an arena may use (--memory, a host's limit)
pub fn setLimit(a: Int, bytes: Int) {
    setWord(a, aLimit, if bytes > 0 { bytes } else { 0 })
}

pub extern effect fn qkArenaNew() -> Int64 as "qkArenaNew" = arenaNew()

pub extern effect fn qkArenaLimit(a: Int64, bytes: Int64) as "qkArenaLimit" {
    if a != 0 {
        setLimit(a, bytes)
    }
}

// survivors made in (after, before): their bytes
pub fn freeExtras(a: Int, after: Int, before: Int) -> Int {
    var at = a + 8 * aExtras // the word that points to the next one (newest first: the older ones stay)
    var bytes = 0
    while word(at, 0) != 0 and word(word(at, 0), xTime) > after {
        let x = word(at, 0)
        if word(x, xTime) < before {
            setWord(at, 0, word(x, xNext))
            bytes += word(x, xSize)
            free(x)
        } else {
            at = x + 8 * xNext
        }
    }
    bytes
}

// the large blocks made in [from, before) that no collection marked: their bytes (marks are cleared)
pub fn freeLarge(a: Int, from: Int, before: Int) -> Int {
    var at = a + 8 * aLarge // newest first: the older ones stay, and only younger ones are marked
    var bytes = 0
    while word(at, 0) != 0 and word(word(at, 0), bigTime) >= from {
        let x = word(at, 0)
        if word(x, bigTime) < before and word(x, bigMarked) == 0 {
            setWord(at, 0, word(x, bigNext))
            bytes += word(x, bigSize)
            setWord(a, aReserved, word(a, aReserved) - word(x, bigSize))
            if word(a, aSpareCount) < largeSpare and before != -1 - intMin {
                setWord(x, bigNext, word(a, aSpare))
                setWord(a, aSpare, x)
                setWord(a, aSpareCount, word(a, aSpareCount) + 1)
            } else {
                free(x)
            }
        } else {
            setWord(x, bigMarked, 0)
            at = x + 8 * bigNext
        }
    }
    bytes
}

// a large block of bytes, made at time
pub fn freeSpare(a: Int) {
    while word(a, aSpare) != 0 {
        let x = word(a, aSpare)
        setWord(a, aSpare, word(x, bigNext))
        free(x)
    }
    setWord(a, aSpareCount, 0)
}

pub fn largeNew(a: Int, bytes: Int, time: Int) -> Int {
    var x = 0
    var at = a + 8 * aSpare
    while x == 0 and word(at, 0) != 0 {
        let s = word(at, 0)
        if word(s, bigSize) == bytes {
            // a block given back of this size: zeroed again
            x = s
            setWord(at, 0, word(s, bigNext))
            setWord(a, aSpareCount, word(a, aSpareCount) - 1)
            zeroBytes(word(s, bigData), bytes)
            setWord(s, bigMarked, 0)
        } else {
            at = s + 8 * bigNext
        }
    }
    if x == 0 {
        x = calloc(1, bytes + 64)
    }
    if x == 0 {
        panicNow(panicSize, 0, bytes, 0)
    }
    setWord(x, bigSize, bytes)
    setWord(x, bigTime, time)
    setWord(x, bigData, align16(x + 40))
    setWord(x, bigNext, word(a, aLarge))
    setWord(a, aLarge, x)
    setWord(a, aReserved, word(a, aReserved) + bytes)
    x
}

// the remembered containers, and their cards, gone
pub fn rememberedFree(a: Int) {
    let r = word(a, aRemembered)
    for i in 0..word(a, aRememberedCap) {
        free(word(r + 8 * rememberedWords * i, rCards))
    }
    free(r)
    setWord(a, aRemembered, 0)
    setWord(a, aRememberedCap, 0)
    setWord(a, aRememberedCount, 0)
}

pub fn arenaFree(a: Int) {
    if a == 0 {
        return
    }
    var b = word(a, aBlocks)
    while b != 0 {
        let next = word(b, bNext)
        free(b)
        b = next
    }
    let _ = freeExtras(a, intMin, -1 - intMin)
    let _ = freeLarge(a, intMin, -1 - intMin)
    freeSpare(a)
    rememberedFree(a)
    free(word(a, aGrowing))
    free(word(a, aSide))
    free(a)
}

pub extern effect fn qkArenaFree(a: Int64) as "qkArenaFree" = arenaFree(a)

// count elements of bytesEach bytes, zeroed, 16-aligned
// the usual allocation: small, and room in the current block (no division, no loop); allocSlow for the rest
pub fn alloc(count: Int, bytesEach: Int) -> Int {
    if count >= 0 and count < 16777216 and bytesEach >= 0 and bytesEach < 65536 {
        let bytes = align16(count * bytesEach)
        let a = arena()
        let cur = word(a, aCurrent)
        if bytes != 0 and bytes < largeFrom and cur != 0 and word(cur, bUsed) + bytes <= word(cur, bSize) {
            let used = word(cur, bUsed)
            setWord(cur, bUsed, used + bytes)
            setWord(a, aAllocated, word(a, aAllocated) + bytes)
            return word(cur, bData) + used
        }
    }
    allocSlow(count, bytesEach)
}

// count of bytesEach for what the caller writes all of (a text's bytes)
pub fn allocRaw(count: Int, bytesEach: Int) -> Int = alloc(count, bytesEach)

fn allocSlow(count: Int, bytesEach: Int) -> Int {
    let a = arena()
    if count < 0 or count != 0 and bytesEach > 1099511627776 / count {
        panicNow(panicSize, 0, count, 0)
    }
    var bytes = align16(count * bytesEach)
    if bytes == 0 {
        bytes = 16
    }
    if bytes >= largeFrom and (word(a, aLimit) == 0 or word(a, aReserved) + bytes <= word(a, aLimit)) {
        // a block of its own (else the room the limit leaves)
        setWord(a, aAllocated, word(a, aAllocated) + bytes)
        return word(largeNew(a, bytes, word(a, aClock)), bigData)
    }
    var cur = word(a, aCurrent)
    while cur != 0 and word(cur, bUsed) + bytes > word(cur, bSize) {
        let next = word(cur, bNext)
        if next == 0 or word(next, bSize) < bytes {
            break
        }
        cur = next // blocks after the current one are empty and zeroed
    }
    if cur == 0 or word(cur, bUsed) + bytes > word(cur, bSize) {
        var size = if bytes > blockSize { bytes } else { blockSize }
        let limit = word(a, aLimit)
        if limit != 0 and word(a, aReserved) + size > limit {
            if word(a, aReserved) + bytes > limit {
                panicNow(panicMemory, 0, limit, 0)
            }
            size = bytes // the last room the limit leaves
        }
        let blk = calloc(1, size + 64)
        if blk == 0 {
            panicNow(panicSize, 0, count, 0)
        }
        setWord(blk, bSize, size)
        setWord(a, aReserved, word(a, aReserved) + size)
        setWord(blk, bData, align16(blk + 32))
        if cur != 0 {
            // in after the current block
            setWord(blk, bNext, word(cur, bNext))
            setWord(cur, bNext, blk)
        } else {
            setWord(a, aBlocks, blk)
        }
        cur = blk
    }
    setWord(a, aCurrent, cur)
    let p = word(cur, bData) + word(cur, bUsed)
    setWord(cur, bUsed, word(cur, bUsed) + bytes)
    setWord(a, aAllocated, word(a, aAllocated) + bytes)
    p
}

// back to a mark (block, used): what was made after it goes, zeroed again
pub fn resetTo(a: Int, block: Int, used: Int) {
    var b = if block != 0 { word(block, bNext) } else { word(a, aBlocks) }
    while b != 0 and word(b, bUsed) != 0 {
        zeroBytes(word(b, bData), word(b, bUsed))
        setWord(b, bUsed, 0)
        b = word(b, bNext)
    }
    if block != 0 {
        zeroBytes(word(block, bData) + used, word(block, bUsed) - used)
        setWord(block, bUsed, used)
    }
    setWord(a, aCurrent, if block != 0 { block } else { word(a, aBlocks) })
}

// everything the last call allocated goes; the memory stays
pub fn arenaReset() {
    let a = arena()
    resetTo(a, 0, 0)
    let _ = freeExtras(a, intMin, -1 - intMin)
    let _ = freeLarge(a, intMin, -1 - intMin)
    freeSpare(a)
    if word(a, aGrowingUsed) != 0 {
        zeroBytes(word(a, aGrowing), growingSlots(a) * 16)
    }
    setWord(a, aGrowingUsed, 0)
    rememberedFree(a)
    setWord(a, aMarked, 0)
    setWord(a, aMarkBlock, 0)
    setWord(a, aLastText, 0)
}

pub extern effect fn qkArenaReset() as "qkArenaReset" = arenaReset()

// ---- room to grow: arrays that push, long texts made by s + t, by address (four to a bucket) ----
// A full bucket gives the smallest room's place away (a room lost costs a copy of what it holds). When that has
// happened as many times as there are buckets, the program grows more things at once than the table holds (thousands
// of elements that push): it doubles, and keeps them all.
fn growingBucket(a: Int, p: Int) -> Int {
    var h = shr(p, 4)
    h ^= shr(h, 17)
    h *%= -7046029254386353131
    word(a, aGrowing) + shr(h, 64 - word(a, aGrowingBits)) * growingWays * 16 // the top bits: the bucket
}

// the room known at p (bytes), or 0
pub fn growingRoom(a: Int, p: Int) -> Int {
    let b = growingBucket(a, p)
    for i in 0..growingWays {
        if word(b, 2 * i) == p {
            return word(b, 2 * i + 1)
        }
    }
    0
}

pub fn growingForget(a: Int, p: Int) {
    let b = growingBucket(a, p)
    for i in 0..growingWays {
        if word(b, 2 * i) == p {
            setWord(b, 2 * i, 0)
        }
    }
}

pub fn growingAdd(a: Int, p: Int, capBytes: Int) {
    let b = growingBucket(a, p)
    var at = -1
    for i in 0..growingWays {
        if at < 0 and (word(b, 2 * i) == 0 or word(b, 2 * i) == p) {
            at = i
        }
    }
    if at < 0 {
        let evicted = word(a, aGrowingEvicted) + 1
        setWord(a, aGrowingEvicted, evicted)
        if evicted > 1 << word(a, aGrowingBits) and word(a, aGrowingBits) < 24 {
            growingDouble(a)
            growingAdd(a, p, capBytes)
            return
        }
        // a full bucket: the smallest room gives its place
        at = 0
        for i in 1..growingWays {
            if word(b, 2 * i + 1) < word(b, 2 * at + 1) {
                at = i
            }
        }
    }
    setWord(b, 2 * at, p)
    setWord(b, 2 * at + 1, capBytes)
    setWord(a, aGrowingUsed, word(a, aGrowingUsed) + 1)
}

// twice the buckets, the rooms put in again
fn growingDouble(a: Int) {
    let old = word(a, aGrowing)
    let oldSlots = growingSlots(a)
    setWord(a, aGrowingBits, word(a, aGrowingBits) + 1)
    setWord(a, aGrowing, calloc(growingSlots(a), 16))
    setWord(a, aGrowingEvicted, 0)
    for i in 0..oldSlots {
        let p = word(old, 2 * i)
        if p != 0 {
            growingAdd(a, p, word(old, 2 * i + 1))
        }
    }
    free(old)
}

// the table's slots, for the loops' collections to look through (loops.qk)
pub fn growingSlots(a: Int) -> Int = 1 << word(a, aGrowingBits) * growingWays

// ---- the runtime's functions the code calls ----
pub extern effect fn rtAlloc(count: Int64, bytesEach: Int64) -> Int64 as "qk_alloc" =
    alloc(count, bytesEach)

pub extern effect fn rtGrow(p: Int64, oldCount: Int64, newCount: Int64, bytesEach: Int64) -> Int64 as "qk_grow" {
    let q = alloc(newCount, bytesEach)
    copyBytes(q, p, oldCount * bytesEach)
    q
}

pub extern effect fn rtCopy(p: Int64, count: Int64, bytesEach: Int64) -> Int64 as "qk_copy" {
    let q = alloc(count, bytesEach)
    copyBytes(q, p, count * bytesEach)
    q
}

// xs.push(v): the array's address with room for one more (in place, or moved to twice the room)
pub extern effect fn rtPush(p: Int64, n: Int64, bytesEach: Int64) -> Int64 as "qk_push" {
    let a = arena()
    if p != 0 {
        let room = growingRoom(a, p)
        if (n + 1) * bytesEach <= room {
            return p
        }
        if room != 0 {
            growingForget(a, p) // it moves: its room is known by its new address
        }
    }
    let cap = if n * 2 > 8 { n * 2 } else { 8 }
    let q = alloc(cap, bytesEach)
    copyBytes(q, p, n * bytesEach)
    growingAdd(a, q, cap * bytesEach)
    q
}

// xs + ys: a new array
pub extern effect fn rtArrayJoin(x: Int64, xn: Int64, y: Int64, yn: Int64, bytesEach: Int64) -> Int64 as "qk_arrayJoin" {
    let p = alloc(xn + yn, bytesEach)
    copyBytes(p, x, xn * bytesEach)
    copyBytes(p + xn * bytesEach, y, yn * bytesEach)
    p
}

// xs += ys on a var: in xs's room when it has it, else moved to twice the room
pub extern effect fn rtArrayAppend(x: Int64, xn: Int64, y: Int64, yn: Int64, bytesEach: Int64) -> Int64 as "qk_arrayAppend" {
    let a = arena()
    let n = xn + yn
    var p = x
    let room = if x != 0 { growingRoom(a, x) } else { 0 }
    if x == 0 or n * bytesEach > room {
        if room != 0 {
            growingForget(a, x)
        }
        let cap = if n * 2 > 8 { n * 2 } else { 8 }
        p = alloc(cap, bytesEach)
        copyBytes(p, x, xn * bytesEach)
        growingAdd(a, p, cap * bytesEach)
    }
    moveBytes(p + xn * bytesEach, y, yn * bytesEach)
    p
}

// ---- containers loops must look into again ----
pub fn setMark(a: Int, block: Int, used: Int) {
    setWord(a, aMarkBlock, block)
    setWord(a, aMarkUsed, used)
    setWord(a, aMarked, 1)
}

// made after the latest mark: above it in its block, or in the block allocation is in now
fn newSinceMark(a: Int, p: Int) -> Bool {
    let b = word(a, aMarkBlock)
    let data = word(b, bData)
    if p >= data + word(a, aMarkUsed) and p < data + word(b, bSize) {
        return true
    }
    let c = word(a, aCurrent)
    c != b and p >= word(c, bData) and p < word(c, bData) + word(c, bSize)
}

// a remembered entry: its address, its length (an array's elements written so far, at most), its description (A<elem>
// or M<key><value>), the clock when it last changed, then an array's cards: (malloc'd) the clock when one of elements
// k * 16 to k * 16 + 15 was last written (0: never), and how many there is room for: a loop looks again only at the
// cards written since its mark, not at the whole array
pub const rPtr = 0
pub const rLen = 1
pub const rDesc = 2
pub const rTime = 3
pub const rCards = 4
pub const rCardCap = 5
pub const rememberedWords = 6
pub const cardShift = 4

pub fn rememberedAt(r: Int, cap: Int, p: Int) -> Int {
    var k = mix(p) & (cap - 1)
    while word(r, rememberedWords * k) != 0 and word(r, rememberedWords * k) != p {
        k = (k + 1) & (cap - 1)
    }
    r + 8 * rememberedWords * k
}

pub fn rememberedGrow(a: Int, cap: Int) {
    let grown = calloc(cap, 8 * rememberedWords)
    if grown == 0 {
        panicNow(panicSize, 0, cap, 0)
    }
    let old = word(a, aRemembered)
    for i in 0..word(a, aRememberedCap) {
        let e = old + 8 * rememberedWords * i
        if word(e, rPtr) != 0 {
            copyBytes(rememberedAt(grown, cap, word(e, rPtr)), e, 8 * rememberedWords)
        }
    }
    free(old)
    setWord(a, aRemembered, grown)
    setWord(a, aRememberedCap, cap)
}

pub fn remember(p: Int, n: Int, desc: Int) {
    let a = arena()
    if word(a, aMarked) == 0 or p == 0 or newSinceMark(a, p) {
        return
    }
    if (word(a, aRememberedCount) + 1) * 2 > word(a, aRememberedCap) {
        rememberedGrow(a, if word(a, aRememberedCap) != 0 {
            word(a, aRememberedCap) * 2
        } else {
            256
        })
    }
    let r = rememberedAt(word(a, aRemembered), word(a, aRememberedCap), p)
    let clock = word(a, aClock)
    var from = if n > 0 {
        n - 1 // the element written (a map's: 0, all of it)
    } else {
        0
    }
    if word(r, rPtr) == 0 {
        zeroBytes(r, 8 * rememberedWords)
        setWord(r, rPtr, p)
        setWord(r, rLen, n)
        setWord(r, rDesc, desc)
        setWord(r, rTime, clock)
        setWord(a, aRememberedCount, word(a, aRememberedCount) + 1)
    } else {
        if n > word(r, rLen) {
            // longer: what was pushed or appended since, all of it written
            if word(r, rLen) < from {
                from = word(r, rLen)
            }
            setWord(r, rLen, n)
        }
        setWord(r, rDesc, desc)
        setWord(r, rTime, clock)
    }
    if byte(desc, 0) != 'A' {
        return
    }
    let last = if n > 0 { shr(n - 1, cardShift) } else { 0 }
    if last >= word(r, rCardCap) {
        var cap = if word(r, rCardCap) != 0 { word(r, rCardCap) } else { 4 }
        while cap <= last {
            cap *= 2
        }
        let cards = realloc(word(r, rCards), cap * 8)
        if cards == 0 {
            panicNow(panicSize, 0, cap, 0)
        }
        zeroBytes(cards + 8 * word(r, rCardCap), 8 * (cap - word(r, rCardCap)))
        setWord(r, rCards, cards)
        setWord(r, rCardCap, cap)
    }
    let cards = word(r, rCards)
    for k in shr(from, cardShift)..last + 1 {
        setWord(cards, k, clock)
    }
}

pub extern effect fn rtRemember(p: Int64, n: Int64, desc: Int64) as "qk_remember" =
    remember(p, n, desc)
