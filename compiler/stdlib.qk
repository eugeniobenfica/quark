    if name == "json" {
        return r"""
// JSON: a value of any shape, read from text and written back.
pub enum Json {
    Null
    Bool(b: Bool)
    Num(n: Float)
    Str(s: Text)
    List(items: [Json])
    Object(fields: [Text: Json])
    Integer(n: Int)
    NumberText(digits: Text)
}

// the text, as JSON's value, or why it is not JSON
pub fn parseJson(text: Text) -> Json! {
    let (value, at) = readValue(text, skip(text, 0))?
    let end = skip(text, at)
    if end < len(text) {
        return Err("JSON: {shown(text, end)} after the value, at byte {end}")
    }
    value
}

// the value as JSON text, on one line
pub fn toJson(j: Json) -> Text = match j {
    Null => "null"
    Bool(b) => if b { "true" } else { "false" }
    Num(n) => if abs(n) < 1e15 and n == floor(n) { "{floor(n)}" } else { "{n}" }
    Str(s) => quote(s)
    List(items) => "[" + items.map(toJson).join(",") + "]"
    Object(fields) => "\{" + fields.map(e => quote(e.key) + ":" + toJson(e.value)).join(",") + "\}"
    Integer(n) => "{n}"
    NumberText(digits) => digits
}

// a field of an object, or None
pub fn Json.field(self, name: Text) -> Json? = match self {
    Object(fields) => fields[name]
    _ => None
}

// the number in it, or None
pub fn Json.number(self) -> Float? = match self {
    Num(n) => n
    Integer(n) => toFloat(n)
    NumberText(digits) => digits.parseFloat() ?? return None
    _ => None
}

pub fn Json.integer(self) -> Int? = match self {
    Integer(n) => n
    NumberText(digits) => digits.parseInt() ?? return None
    _ => None
}

// the text in it, or None
pub fn Json.text(self) -> Text? = match self {
    Str(s) => s
    _ => None
}

// ---- a program's values as JSON, and back, by their types ----
// jsonOf and fromJson are made for each type they are used with (compiler/check.qk's jsonBody): a record is an
// object of its fields; an enum's case without data its name, one with data an object of one entry, its name and an
// object of its fields; an array a list; a map from Text (or Int, as text) an object; an optional null when None; a
// tuple a list; Int, Float, Bool and Text themselves. A field missing from an object takes its default, and an
// optional one None.
//   let text = encode(Person("Ana", 34, ["x"]))       // {"name":"Ana","age":34,"tags":["x"]}
//   let p: Person = decode(text)?
// v as JSON
pub fn jsonOf<T>(value: T) -> Json = Json.Null

// the T this JSON is, or why it is not one
pub fn fromJson<T>(j: Json) -> T! = Err("JSON: no reading for this type")

// v as JSON text, on one line
pub fn encode<T>(value: T) -> Text = toJson(jsonOf(value))

// the T this JSON text is, or why it is not one
pub fn decode<T>(text: Text) -> T! {
    let got: T! = fromJson(parseJson(text)?)
    got
}

// what kind of JSON value this is, for a message
pub fn Json.kindName(self) -> Text = match self {
    Null => "null"
    Bool(_) => "a boolean"
    Num(_) | Integer(_) | NumberText(_) => "a number"
    Str(_) => "a text"
    List(_) => "a list"
    Object(_) => "an object"
}

// an object's fields, or None
pub fn Json.fields(self) -> [Text: Json]? = match self {
    Object(fields) => Some(fields)
    _ => None
}

// a list's items, or None
pub fn Json.items(self) -> [Json]? = match self {
    List(items) => Some(items)
    _ => None
}

pub fn intOfJson(j: Json) -> Int! {
    if j.integer() is Some(n) {
        return n
    }
    if j.number() is Some(x) and x == floor(x) and abs(x) < 9007199254740992.0 {
        return toInt(x)
    }
    Err("JSON: an Int, not {j.kindName()}")
}

pub fn floatOfJson(j: Json) -> Float! =
    j.number() ?? return Err("JSON: a number, not {j.kindName()}")

pub fn boolOfJson(j: Json) -> Bool! = match j {
    Bool(b) => b
    _ => Err("JSON: true or false, not {j.kindName()}")
}

pub fn textOfJson(j: Json) -> Text! = j.text() ?? return Err("JSON: a text, not {j.kindName()}")

// field name of an object as a T: its error said with its name
pub fn fieldFromJson<T>(fields: [Text: Json], name: Text) -> T! {
    let got: T! = fromJson(fields[name] ?? Json.Null)
    match got {
        Ok(v) => v
        Err(why) => Err("{name}: {why}")
    }
}

// an optional field: None when it is missing or null (none: None, which tells E)
pub fn optionFieldFromJson<E>(fields: [Text: Json], name: Text, none: E?) -> E?! {
    let j = fields[name] ?? Json.Null
    if j == Json.Null {
        return Ok(none)
    }
    let got: E! = fromJson(j)
    match got {
        Ok(v) => Ok(Some(v))
        Err(why) => Err("{name}: {why}")
    }
}

// a list as [E] (out: an empty one, of the type)
pub fn listFromJson<E>(j: Json, out: [E]) -> [E]! {
    let items = j.items() ?? return Err("JSON: a list, not {j.kindName()}")
    var r = out
    for (i, x) in items.enumerate() {
        let got: E! = fromJson(x)
        match got {
            Ok(v) => r.push(v)
            Err(why) => return Err("[{i}]: {why}")
        }
    }
    r
}

// an object as [Text: V]
pub fn mapFromJson<V>(j: Json, out: [Text: V]) -> [Text: V]! {
    let fields = j.fields() ?? return Err("JSON: an object, not {j.kindName()}")
    var r = out
    for (k, x) in fields {
        let got: V! = fromJson(x)
        match got {
            Ok(v) => {
                r[k] = v
            }
            Err(why) => return Err("{k}: {why}")
        }
    }
    r
}

// an object as [Int: V]: its keys whole numbers
pub fn intMapFromJson<V>(j: Json, out: [Int: V]) -> [Int: V]! {
    let fields = j.fields() ?? return Err("JSON: an object, not {j.kindName()}")
    var r = out
    for (k, x) in fields {
        let n = k.parseInt() ?? return Err("JSON: the key {k} is not an Int")
        let got: V! = fromJson(x)
        match got {
            Ok(v) => {
                r[n] = v
            }
            Err(why) => return Err("{k}: {why}")
        }
    }
    r
}

// null as None, anything else as Some
pub fn optionFromJson<E>(j: Json, none: E?) -> E?! {
    if j == Json.Null {
        return Ok(none)
    }
    let got: E! = fromJson(j)
    match got {
        Ok(v) => Ok(Some(v))
        Err(why) => Err(why)
    }
}

// a tuple's item i
pub fn itemFromJson<E>(items: [Json], i: Int) -> E! {
    let got: E! = fromJson(items.get(i) ?? return Err("JSON: the tuple has no item {i}"))
    match got {
        Ok(v) => v
        Err(why) => Err("[{i}]: {why}")
    }
}

// an enum's case in JSON: its name, and the object of its fields ({} for a case without data)
pub fn caseOfJson(j: Json, typeName: Text) -> (Text, [Text: Json])! {
    let none: [Text: Json] = [:]
    match j {
        Str(name) => (name, none)
        Object(fields) => {
            if len(fields) != 1 {
                return Err("JSON: a {typeName} is a case's name, or an object of one case")
            }
            for (name, inner) in fields {
                let f = inner.fields() ?? return Err(
                    "JSON: case {name} of {typeName}: an object of its fields, not {inner.kindName()}",
                )
                return (name, f)
            }
            Err("JSON: no case")
        }
        _ => Err("JSON: a {typeName} is a case's name, or an object of one case, not {j.kindName()}")
    }
}

// a text in quotes, with what JSON escapes escaped (every piece between them goes in whole)
fn quote(s: Text) -> Text {
    var out = "\""
    var from = 0
    for (i, c) in s.bytes().enumerate() {
        let escaped = match c {
            '"' => "\\\""
            '\\' => r"\\"
            '\n' => r"\n"
            '\t' => r"\t"
            '\r' => r"\r"
            0x08 => r"\b"
            0x0c => r"\f"
            0..=0x1f => r"\u00" + hexDigit(c / 16) + hexDigit(c % 16)
            _ => ""
        }
        if escaped != "" {
            out += s[from..i] + escaped
            from = i + 1
        }
    }
    out + s[from..] + "\""
}

fn hexDigit(n: Int) -> Text = "0123456789abcdef"[n..n + 1]

fn hex(n: Int) -> Text = (0..4).map(k => hexDigit(n >> (12 - 4 * k) & 15)).join("")

// the character at a byte, for a message
fn shown(t: Text, at: Int) -> Text {
    let c = t.bytes()[at]
    if c >= 0x20 and c < 0x7f { "\"{char(c)}\"" } else { "byte {c}" }
}

fn skip(t: Text, from: Int) -> Int {
    let b = t.bytes()
    var i = from
    while i < len(b) and b[i] is ' ' | '\n' | '\t' | '\r' {
        i += 1
    }
    i
}

fn readValue(t: Text, at: Int) -> (Json, Int)! {
    if at >= len(t) {
        return Err("JSON: the text ends where a value should be")
    }
    match t.bytes()[at] {
        '{' => readObject(t, at + 1)
        '[' => readList(t, at + 1)
        '"' => {
            let (s, next) = readText(t, at + 1)?
            (Json.Str(s), next)
        }
        't' if word(t, at, "true") => (Json.Bool(true), at + 4)
        'f' if word(t, at, "false") => (Json.Bool(false), at + 5)
        'n' if word(t, at, "null") => (Json.Null, at + 4)
        _ => readNumber(t, at)
    }
}

fn word(t: Text, at: Int, w: Text) -> Bool =
    at + len(w) <= len(t) and t.bytes()[at..at + len(w)] == w.bytes()

fn digit(b: Bytes, at: Int) -> Bool = at < len(b) and b[at] is '0'..='9'

fn readNumber(t: Text, at: Int) -> (Json, Int)! {
    let b = t.bytes()
    var i = at
    if b[i] == '-' {
        i += 1
    }
    if not digit(b, i) {
        return Err("JSON: {shown(t, at)} is not a value, at byte {at}")
    }
    if b[i] == '0' {
        i += 1
    } else {
        while digit(b, i) {
            i += 1
        }
    }
    if i < len(b) and b[i] == '.' {
        i += 1
        if not digit(b, i) {
            return Err("JSON: expected a fraction digit at byte {i}")
        }
        while digit(b, i) {
            i += 1
        }
    }
    if i < len(b) and b[i] is 'e' | 'E' {
        i += 1
        if i < len(b) and b[i] is '+' | '-' {
            i += 1
        }
        if not digit(b, i) {
            return Err("JSON: expected an exponent digit at byte {i}")
        }
        while digit(b, i) {
            i += 1
        }
    }
    let digits = t[at..i]
    if digits != "-0" and digits.parseInt() is Ok(n) {
        return (Json.Integer(n), i)
    }
    (Json.NumberText(digits), i)
}

// four hex digits at a byte (A), or None
fn hex4(b: Bytes, at: Int) -> Int? {
    if at + 4 > len(b) {
        return None
    }
    var n = 0
    for c in b[at..at + 4] {
        let d = match c {
            '0'..='9' => c - '0'
            'a'..='f' => c - 'a' + 10
            'A'..='F' => c - 'A' + 10
            _ => return None
        }
        n = n * 16 + d
    }
    n
}

// a text's characters, to its closing quote: the pieces between escapes go in whole (one with none is a slice)
fn readText(t: Text, from: Int) -> (Text, Int)! {
    let b = t.bytes()
    var out = ""
    var piece = from
    var i = from
    while i < len(b) and b[i] != '"' {
        let c = b[i]
        if c < 0x20 {
            return Err("JSON: a control character (byte {c}) in a text, at byte {i}: it is written escaped")
        }
        if c != '\\' {
            i += 1
            continue
        }
        out += t[piece..i]
        if i + 1 >= len(b) {
            break
        }
        let e = b[i + 1]
        i += 2
        out += match e {
            '"' => "\""
            '\\' => "\\"
            '/' => "/"
            'b' => "\x08"
            'f' => "\x0c"
            'n' => "\n"
            'r' => "\r"
            't' => "\t"
            'u' => {
                var cp = hex4(b, i) ?? return Err("JSON: \\u takes four hex digits, at byte {i - 2}")
                i += 4
                if cp >= 0xd800
                    and cp < 0xdc00
                    and i + 6 <= len(b)
                    and b[i] == '\\'
                    and b[i + 1] == 'u'
                    and hex4(b, i + 2) is Some(low)
                    and low >= 0xdc00
                    and low < 0xe000 {
                    cp = 0x10000 + (cp - 0xd800) * 0x400 + (low - 0xdc00) // a surrogate pair: one character
                    i += 6
                }
                if cp >= 0xd800 and cp < 0xe000 {
                    return Err("JSON: half of a surrogate pair (\\u{hex(cp)}), at byte {i - 6}")
                }
                char(cp)
            }
            _ => return Err("JSON: {shown(t, i - 1)} after a backslash is not an escape, at byte {i - 2}")
        }
        piece = i
    }
    if i >= len(b) {
        return Err("JSON: a text that never ends, from byte {from - 1}")
    }
    if piece == from {
        return (t[from..i], i + 1) // no escape: the same memory
    }
    (out + t[piece..i], i + 1)
}

fn readList(t: Text, from: Int) -> (Json, Int)! {
    let b = t.bytes()
    var items: [Json] = []
    var i = skip(t, from)
    if i < len(b) and b[i] == ']' {
        return (Json.List(items), i + 1)
    }
    while true {
        let (item, next) = readValue(t, skip(t, i))?
        items.push(item)
        i = skip(t, next)
        if i < len(b) and b[i] == ',' {
            i += 1
        } else {
            break
        }
    }
    if i >= len(b) or b[i] != ']' {
        return Err("JSON: a list without its ], at byte {i}")
    }
    (Json.List(items), i + 1)
}

fn readObject(t: Text, from: Int) -> (Json, Int)! {
    let b = t.bytes()
    var fields: [Text: Json] = [:]
    var i = skip(t, from)
    if i < len(b) and b[i] == '}' {
        return (Json.Object(fields), i + 1)
    }
    while true {
        if i >= len(b) or b[i] != '"' {
            return Err("JSON: a field's name in quotes, at byte {i}")
        }
        let (name, afterName) = readText(t, i + 1)?
        i = skip(t, afterName)
        if i >= len(b) or b[i] != ':' {
            return Err("JSON: a : after \"{name}\", at byte {i}")
        }
        let (value, next) = readValue(t, skip(t, i + 1))?
        fields[name] = value
        i = skip(t, next)
        if i < len(b) and b[i] == ',' {
            i = skip(t, i + 1)
        } else {
            break
        }
    }
    if i >= len(b) or b[i] != '}' {
        return Err("JSON: an object without its \}, at byte {i}")
    }
    (Json.Object(fields), i + 1)
}
