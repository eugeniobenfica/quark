        return r"""
// The arena: memory comes from blocks, by bumping a pointer. Blocks after the current one are empty, so the list is
// in the order things were made, and going back to a mark frees everything made after it at once (loops.qk). A large
// allocation (largeFrom bytes or more) gets a block of its own, outside the list: a loop keeps it in place while its
// vars reach it. Arrays and texts that grow keep their room in a table by address; containers from before a loop's
// mark that the loop changes in place are remembered, an array's by its cards (16 elements each).
use base

// an arena's words
pub const aBlocks = 0
pub const aCurrent = 1
pub const aExtras = 2 // survivors: what loops copied out, outside the blocks
pub const aClock = 3
pub const aAllocated = 4 // bytes handed out, ever
pub const aGrowing = 5 // the rooms: growingEntries (address, bytes) pairs
pub const aGrowingBits = 6 // the table's buckets: 2^bits
pub const aGrowingUsed = 7 // the rooms the table holds
pub const aLastText = 8 // the last text made: s + t appends in place while it is the top
pub const aReserved = 9
pub const aLimit = 10
pub const aMarkBlock = 11
pub const aMarkUsed = 12
pub const aMarked = 13
pub const aRemembered = 14 // remembered entries (rememberedWords each) by address, open addressing
pub const aRememberedCap = 15
pub const aRememberedCount = 16
pub const aLarge = 17 // the large blocks, the latest first
pub const aSpare = 18 // large blocks given back, kept for one of the same size (a few: memory touched already)
pub const aSpareCount = 19
pub const aGrowingEvicted = 20 // rooms a full bucket gave its place away to make, since the table was made
pub const aLastRemembered = 21 // the entry remember found last (a loop writes one container again and again), or 0
pub const aSide = 22 // the loop collections' side table (loops.qk sideSlot), kept from one to the next
pub const aSideBytes = 23
pub const aSideEpoch = 24 // the collection its entries are of (1 to 15): an entry of another is empty
pub const aGrowingLog = 25 // the rooms added, in order, with the clock then: (address, time) pairs
pub const aGrowingLogCount = 26 // how many (-1: more than the log holds: a collection looks through the table)
pub const aGrowingLogCap = 27
pub const arenaWords = 28

// a block's words, then its bytes (16-aligned)
pub const bNext = 0
pub const bSize = 1
pub const bUsed = 2
pub const bData = 3

// a survivor's
pub const xNext = 0
pub const xTime = 1
pub const xSize = 2
pub const xUsed = 3
pub const xData = 4

// a large block's words (its time: the clock when it was made; marked: reached by the collection under way), then its
// bytes (16-aligned)
pub const bigNext = 0
pub const bigTime = 1
pub const bigSize = 2
pub const bigMarked = 3
pub const bigData = 4
pub const largeFrom = 65536
const largeSpare = 4
const growingFirstBits = 10 // 1024 buckets to start with
const growingWays = 4
const growingMostBits = 14 // at most 16384 buckets: a loop's collection looks through all of them
const blockSize = 16777216
const blockFirst = 65536 // an arena's first block (a new block: as large as all before it, up to blockSize)

pub fn arena() -> Int = ctxGet(ctxArena)

pub fn arenaNew() -> Int {
    let a = calloc(1, 8 * arenaWords)
    if a != 0 {
        setWord(a, aGrowing, calloc(1 << growingFirstBits * growingWays, 16))
        setWord(a, aGrowingBits, growingFirstBits)
    }
    a
}

// an arena for code the running program's (a task's, a thread's)
pub fn arenaLike() -> Int = arenaNew()

// the memory an arena may use (--memory, a host's limit)
pub fn setLimit(a: Int, bytes: Int) {
    setWord(a, aLimit, if bytes > 0 { bytes } else { 0 })
}

pub extern effect fn qkArenaNew() -> Int64 as "qkArenaNew" = arenaNew()

pub extern effect fn qkArenaLimit(a: Int64, bytes: Int64) as "qkArenaLimit" {
    if a != 0 {
        setLimit(a, bytes)
    }
}

// survivors made in (after, before): their bytes
pub fn freeExtras(a: Int, after: Int, before: Int) -> Int {
    var at = a + 8 * aExtras // the word that points to the next one (newest first: the older ones stay)
    var bytes = 0
    while word(at, 0) != 0 and word(word(at, 0), xTime) > after {
        let x = word(at, 0)
        if word(x, xTime) < before {
            setWord(at, 0, word(x, xNext))
            bytes += word(x, xSize)
            free(x)
        } else {
            at = x + 8 * xNext
        }
    }
    bytes
}

// the large blocks made in [from, before) that no collection marked: their bytes (marks are cleared)
pub fn freeLarge(a: Int, from: Int, before: Int) -> Int {
    var at = a + 8 * aLarge // newest first: the older ones stay, and only younger ones are marked
    var bytes = 0
    while word(at, 0) != 0 and word(word(at, 0), bigTime) >= from {
        let x = word(at, 0)
        if word(x, bigTime) < before and word(x, bigMarked) == 0 {
            setWord(at, 0, word(x, bigNext))
            bytes += word(x, bigSize)
            setWord(a, aReserved, word(a, aReserved) - word(x, bigSize))
            if word(a, aSpareCount) < largeSpare and before != -1 - intMin {
                setWord(x, bigNext, word(a, aSpare))
                setWord(a, aSpare, x)
                setWord(a, aSpareCount, word(a, aSpareCount) + 1)
            } else {
                free(x)
            }
        } else {
            setWord(x, bigMarked, 0)
            at = x + 8 * bigNext
        }
    }
    bytes
}

// a large block of bytes, made at time
pub fn freeSpare(a: Int) {
    while word(a, aSpare) != 0 {
        let x = word(a, aSpare)
        setWord(a, aSpare, word(x, bigNext))
        free(x)
    }
    setWord(a, aSpareCount, 0)
}

pub fn largeNew(a: Int, bytes: Int, time: Int) -> Int {
    var x = 0
    var at = a + 8 * aSpare
    while x == 0 and word(at, 0) != 0 {
        let s = word(at, 0)
        if word(s, bigSize) == bytes {
            // a block given back of this size: zeroed again
            x = s
            setWord(at, 0, word(s, bigNext))
            setWord(a, aSpareCount, word(a, aSpareCount) - 1)
            zeroBytes(word(s, bigData), bytes)
            setWord(s, bigMarked, 0)
        } else {
            at = s + 8 * bigNext
        }
    }
    if x == 0 {
        x = calloc(1, bytes + 64)
    }
    if x == 0 {
        panicNow(panicSize, 0, bytes, 0)
    }
    setWord(x, bigSize, bytes)
    setWord(x, bigTime, time)
    setWord(x, bigData, align16(x + 40))
    setWord(x, bigNext, word(a, aLarge))
    setWord(a, aLarge, x)
    setWord(a, aReserved, word(a, aReserved) + bytes)
    x
}

// the remembered containers, and their cards, gone
pub fn rememberedFree(a: Int) {
    let r = word(a, aRemembered)
    for i in 0..word(a, aRememberedCap) {
        free(word(r + 8 * rememberedWords * i, rCards))
    }
    free(r)
    setWord(a, aRemembered, 0)
    setWord(a, aRememberedCap, 0)
    setWord(a, aRememberedCount, 0)
    setWord(a, aLastRemembered, 0)
}

pub fn arenaFree(a: Int) {
    if a == 0 {
        return
    }
    var b = word(a, aBlocks)
    while b != 0 {
        let next = word(b, bNext)
        free(b)
        b = next
    }
    let _ = freeExtras(a, intMin, -1 - intMin)
    let _ = freeLarge(a, intMin, -1 - intMin)
    freeSpare(a)
    rememberedFree(a)
    free(word(a, aGrowing))
    free(word(a, aGrowingLog))
    free(word(a, aSide))
    free(a)
}

pub extern effect fn qkArenaFree(a: Int64) as "qkArenaFree" = arenaFree(a)

// count elements of bytesEach bytes, zeroed, 16-aligned
// the usual allocation: small, and room in the current block (no division, no loop); allocSlow for the rest
pub fn alloc(count: Int, bytesEach: Int) -> Int {
    if count >= 0 and count < 16777216 and bytesEach >= 0 and bytesEach < 65536 {
        let bytes = align16(count * bytesEach)
        let a = arena()
        let cur = word(a, aCurrent)
        if bytes != 0 and bytes < largeFrom and cur != 0 and word(cur, bUsed) + bytes <= word(cur, bSize) {
            let used = word(cur, bUsed)
            setWord(cur, bUsed, used + bytes)
            setWord(a, aAllocated, word(a, aAllocated) + bytes)
            return word(cur, bData) + used
        }
    }
    allocSlow(count, bytesEach)
}

// count of bytesEach for what the caller writes all of (a text's bytes)
pub fn allocRaw(count: Int, bytesEach: Int) -> Int = alloc(count, bytesEach)

fn allocSlow(count: Int, bytesEach: Int) -> Int {
    let a = arena()
    if count < 0 or count != 0 and bytesEach > 1099511627776 / count {
        panicNow(panicSize, 0, count, 0)
    }
    var bytes = align16(count * bytesEach)
    if bytes == 0 {
        bytes = 16
    }
    if bytes >= largeFrom and (word(a, aLimit) == 0 or word(a, aReserved) + bytes <= word(a, aLimit)) {
        // a block of its own (else the room the limit leaves)
        setWord(a, aAllocated, word(a, aAllocated) + bytes)
        return word(largeNew(a, bytes, word(a, aClock)), bigData)
    }
    var cur = word(a, aCurrent)
    while cur != 0 and word(cur, bUsed) + bytes > word(cur, bSize) {
        let next = word(cur, bNext)
        if next == 0 or word(next, bSize) < bytes {
            break
        }
        cur = next // blocks after the current one are empty and zeroed
    }
    if cur == 0 or word(cur, bUsed) + bytes > word(cur, bSize) {
        // as large as all the arena reserved so far: from 64 KB (a task's arena, often small) up to 16 MB
        let step = min(max(word(a, aReserved), blockFirst), blockSize)
        var size = if bytes > step { bytes } else { step }
        let limit = word(a, aLimit)
        if limit != 0 and word(a, aReserved) + size > limit {
            if word(a, aReserved) + bytes > limit {
                panicNow(panicMemory, 0, limit, 0)
            }
            size = bytes // the last room the limit leaves
        }
        let blk = calloc(1, size + 64)
        if blk == 0 {
            panicNow(panicSize, 0, count, 0)
        }
        setWord(blk, bSize, size)
        setWord(a, aReserved, word(a, aReserved) + size)
        setWord(blk, bData, align16(blk + 32))
        if cur != 0 {
            // in after the current block
            setWord(blk, bNext, word(cur, bNext))
            setWord(cur, bNext, blk)
        } else {
            setWord(a, aBlocks, blk)
        }
        cur = blk
    }
    setWord(a, aCurrent, cur)
    let p = word(cur, bData) + word(cur, bUsed)
    setWord(cur, bUsed, word(cur, bUsed) + bytes)
    setWord(a, aAllocated, word(a, aAllocated) + bytes)
    p
}

// back to a mark (block, used): what was made after it goes, zeroed again
pub fn resetTo(a: Int, block: Int, used: Int) {
    var b = if block != 0 { word(block, bNext) } else { word(a, aBlocks) }
    while b != 0 and word(b, bUsed) != 0 {
        zeroBytes(word(b, bData), word(b, bUsed))
        setWord(b, bUsed, 0)
        b = word(b, bNext)
    }
    if block != 0 {
        zeroBytes(word(block, bData) + used, word(block, bUsed) - used)
        setWord(block, bUsed, used)
    }
    setWord(a, aCurrent, if block != 0 { block } else { word(a, aBlocks) })
}

// everything the last call allocated goes; the memory stays
pub fn arenaReset() {
    let a = arena()
    resetTo(a, 0, 0)
    let _ = freeExtras(a, intMin, -1 - intMin)
    let _ = freeLarge(a, intMin, -1 - intMin)
    freeSpare(a)
    if word(a, aGrowingUsed) != 0 {
        zeroBytes(word(a, aGrowing), growingSlots(a) * 16)
    }
    setWord(a, aGrowingUsed, 0)
    setWord(a, aGrowingLogCount, 0)
    rememberedFree(a)
    setWord(a, aMarked, 0)
    setWord(a, aMarkBlock, 0)
    setWord(a, aLastText, 0)
}

pub extern effect fn qkArenaReset() as "qkArenaReset" = arenaReset()

// ---- room to grow: arrays that push, long texts made by s + t, by address (four to a bucket) ----
// A full bucket gives the smallest room's place away (a room lost costs a copy of what it holds). When that has
// happened as many times as there are buckets, the program grows more things at once than the table holds (thousands
// of elements that push): it doubles, and keeps them all.
fn growingBucket(a: Int, p: Int) -> Int {
    var h = shr(p, 4)
    h ^= shr(h, 17)
    h *%= -7046029254386353131
    word(a, aGrowing) + shr(h, 64 - word(a, aGrowingBits)) * growingWays * 16 // the top bits: the bucket
}

// the room known at p (bytes), or 0
pub fn growingRoom(a: Int, p: Int) -> Int {
    let b = growingBucket(a, p)
    for i in 0..growingWays {
        if word(b, 2 * i) == p {
            return word(b, 2 * i + 1)
        }
    }
    0
}

pub fn growingForget(a: Int, p: Int) {
    let b = growingBucket(a, p)
    for i in 0..growingWays {
        if word(b, 2 * i) == p {
            setWord(b, 2 * i, 0)
            setWord(a, aGrowingUsed, word(a, aGrowingUsed) - 1)
        }
    }
}

// a room added: noted in the log with the clock, for the loops' collections (only what is younger than their mark
// can be gone: they look at the log's end instead of the whole table)
fn growingNote(a: Int, p: Int) {
    let count = word(a, aGrowingLogCount)
    if count < 0 {
        return
    }
    if count == word(a, aGrowingLogCap) {
        if count >= growingLogMost {
            setWord(a, aGrowingLogCount, -1)
            return
        }
        let cap = if count == 0 { 1024 } else { 2 * count }
        let log = malloc(cap * 16)
        if word(a, aGrowingLog) != 0 {
            copyBytes(log, word(a, aGrowingLog), count * 16)
            free(word(a, aGrowingLog))
        }
        setWord(a, aGrowingLog, log)
        setWord(a, aGrowingLogCap, cap)
    }
    let at = word(a, aGrowingLog) + 16 * count
    setWord(at, 0, p)
    setWord(at, 1, word(a, aClock))
    setWord(a, aGrowingLogCount, count + 1)
}

const growingLogMost = 1048576

pub fn growingAdd(a: Int, p: Int, capBytes: Int) {
    growingNote(a, p)
    growingPut(a, p, capBytes)
}

fn growingPut(a: Int, p: Int, capBytes: Int) {
    let b = growingBucket(a, p)
    var at = -1
    for i in 0..growingWays {
        if at < 0 and (word(b, 2 * i) == 0 or word(b, 2 * i) == p) {
            at = i
        }
    }
    if at < 0 {
        let evicted = word(a, aGrowingEvicted) + 1
        setWord(a, aGrowingEvicted, evicted)
        if evicted > 1 << word(a, aGrowingBits) and word(a, aGrowingBits) < growingMostBits {
            growingDouble(a)
            growingPut(a, p, capBytes)
            return
        }
        // a full bucket: the smallest room gives its place
        at = 0
        for i in 1..growingWays {
            if word(b, 2 * i + 1) < word(b, 2 * at + 1) {
                at = i
            }
        }
    }
    if word(b, 2 * at) == 0 {
        setWord(a, aGrowingUsed, word(a, aGrowingUsed) + 1)
    }
    setWord(b, 2 * at, p)
    setWord(b, 2 * at + 1, capBytes)
}

// twice the buckets, the rooms put in again
fn growingDouble(a: Int) = growingResize(a, word(a, aGrowingBits) + 1)

// after a loop's collection (rooms: those it left): a table grown for rooms that went back to the size they need (a
// quarter of its slots at most), so that the next collections look through no more than that
pub fn growingFit(a: Int, rooms: Int) {
    var bits = word(a, aGrowingBits)
    while bits > growingFirstBits and 8 * rooms < 1 << (bits - 1) * growingWays {
        bits -= 1
    }
    if bits != word(a, aGrowingBits) {
        growingResize(a, bits)
    }
}

fn growingResize(a: Int, bits: Int) {
    let old = word(a, aGrowing)
    let oldSlots = growingSlots(a)
    setWord(a, aGrowingBits, bits)
    setWord(a, aGrowing, calloc(growingSlots(a), 16))
    setWord(a, aGrowingEvicted, 0)
    setWord(a, aGrowingUsed, 0)
    for i in 0..oldSlots {
        let p = word(old, 2 * i)
        if p != 0 {
            growingPut(a, p, word(old, 2 * i + 1))
        }
    }
    free(old)
}

// the table's slots, for the loops' collections to look through (loops.qk)
pub fn growingSlots(a: Int) -> Int = 1 << word(a, aGrowingBits) * growingWays

// ---- the runtime's functions the code calls ----
pub extern effect fn rtAlloc(count: Int64, bytesEach: Int64) -> Int64 as "qk_alloc" =
    alloc(count, bytesEach)

pub extern effect fn rtGrow(p: Int64, oldCount: Int64, newCount: Int64, bytesEach: Int64) -> Int64 as "qk_grow" {
    let q = alloc(newCount, bytesEach)
    copyBytes(q, p, oldCount * bytesEach)
    q
}

pub extern effect fn rtCopy(p: Int64, count: Int64, bytesEach: Int64) -> Int64 as "qk_copy" {
    let q = alloc(count, bytesEach)
    copyBytes(q, p, count * bytesEach)
    q
}

// xs.push(v): the array's address with room for one more (in place, or moved to twice the room)
pub extern effect fn rtPush(p: Int64, n: Int64, bytesEach: Int64) -> Int64 as "qk_push" {
    let a = arena()
    if p != 0 {
        let room = growingRoom(a, p)
        if (n + 1) * bytesEach <= room {
            return p
        }
        if room != 0 {
            growingForget(a, p) // it moves: its room is known by its new address
        }
    }
    let cap = if n * 2 > 8 { n * 2 } else { 8 }
    let q = alloc(cap, bytesEach)
    copyBytes(q, p, n * bytesEach)
    growingAdd(a, q, cap * bytesEach)
    q
}

// xs + ys: a new array
pub extern effect fn rtArrayJoin(x: Int64, xn: Int64, y: Int64, yn: Int64, bytesEach: Int64) -> Int64 as "qk_arrayJoin" {
    let p = alloc(xn + yn, bytesEach)
    copyBytes(p, x, xn * bytesEach)
    copyBytes(p + xn * bytesEach, y, yn * bytesEach)
    p
}

// xs += ys on a var: in xs's room when it has it, else moved to twice the room
pub extern effect fn rtArrayAppend(x: Int64, xn: Int64, y: Int64, yn: Int64, bytesEach: Int64) -> Int64 as "qk_arrayAppend" {
    let a = arena()
    let n = xn + yn
    var p = x
    let room = if x != 0 { growingRoom(a, x) } else { 0 }
    if x == 0 or n * bytesEach > room {
        if room != 0 {
            growingForget(a, x)
        }
        let cap = if n * 2 > 8 { n * 2 } else { 8 }
        p = alloc(cap, bytesEach)
        copyBytes(p, x, xn * bytesEach)
        growingAdd(a, p, cap * bytesEach)
    }
    moveBytes(p + xn * bytesEach, y, yn * bytesEach)
    p
}

// ---- containers loops must look into again ----
pub fn setMark(a: Int, block: Int, used: Int) {
    setWord(a, aMarkBlock, block)
    setWord(a, aMarkUsed, used)
    setWord(a, aMarked, 1)
}

// made after the latest mark: above it in its block, or in the block allocation is in now
fn newSinceMark(a: Int, p: Int) -> Bool {
    let b = word(a, aMarkBlock)
    let data = word(b, bData)
    if p >= data + word(a, aMarkUsed) and p < data + word(b, bSize) {
        return true
    }
    let c = word(a, aCurrent)
    c != b and p >= word(c, bData) and p < word(c, bData) + word(c, bSize)
}

// a remembered entry: its address, its length (an array's elements written so far, at most), its description (A<elem>
// or M<key><value>), the clock when it last changed, then an array's cards: (malloc'd) the clock when one of elements
// k * 16 to k * 16 + 15 was last written (0: never), and how many there is room for: a loop looks again only at the
// cards written since its mark, not at the whole array
pub const rPtr = 0
pub const rLen = 1
pub const rDesc = 2
pub const rTime = 3
pub const rCards = 4
pub const rCardCap = 5
pub const rememberedWords = 6
pub const cardShift = 4

pub fn rememberedAt(r: Int, cap: Int, p: Int) -> Int {
    var k = mix(p) & (cap - 1)
    while word(r, rememberedWords * k) != 0 and word(r, rememberedWords * k) != p {
        k = (k + 1) & (cap - 1)
    }
    r + 8 * rememberedWords * k
}

pub fn rememberedGrow(a: Int, cap: Int) {
    let grown = calloc(cap, 8 * rememberedWords)
    if grown == 0 {
        panicNow(panicSize, 0, cap, 0)
    }
    let old = word(a, aRemembered)
    for i in 0..word(a, aRememberedCap) {
        let e = old + 8 * rememberedWords * i
        if word(e, rPtr) != 0 {
            copyBytes(rememberedAt(grown, cap, word(e, rPtr)), e, 8 * rememberedWords)
        }
    }
    free(old)
    setWord(a, aRemembered, grown)
    setWord(a, aRememberedCap, cap)
    setWord(a, aLastRemembered, 0) // (the entries moved)
}

pub fn remember(p: Int, n: Int, desc: Int) {
    let a = arena()
    if word(a, aMarked) == 0 or p == 0 {
        return
    }
    let seen = word(a, aLastRemembered)
    if seen != 0 and word(seen, rPtr) == p and n > 0 and n <= word(seen, rLen) and byte(desc, 0) == 'A' {
        // the array remembered last, written again inside what it held: its time and that element's card
        let k = shr(n - 1, cardShift)
        if k < word(seen, rCardCap) {
            let clock = word(a, aClock)
            setWord(seen, rDesc, desc)
            setWord(seen, rTime, clock)
            setWord(word(seen, rCards), k, clock)
            return
        }
    }
    if newSinceMark(a, p) {
        return
    }
    if (word(a, aRememberedCount) + 1) * 2 > word(a, aRememberedCap) {
        rememberedGrow(a, if word(a, aRememberedCap) != 0 {
            word(a, aRememberedCap) * 2
        } else {
            256
        })
    }
    let r = rememberedAt(word(a, aRemembered), word(a, aRememberedCap), p)
    setWord(a, aLastRemembered, r)
    let clock = word(a, aClock)
    var from = if n > 0 {
        n - 1 // the element written (a map's: 0, all of it)
    } else {
        0
    }
    if word(r, rPtr) == 0 {
        zeroBytes(r, 8 * rememberedWords)
        setWord(r, rPtr, p)
        setWord(r, rLen, n)
        setWord(r, rDesc, desc)
        setWord(r, rTime, clock)
        setWord(a, aRememberedCount, word(a, aRememberedCount) + 1)
    } else {
        if n > word(r, rLen) {
            // longer: what was pushed or appended since, all of it written
            if word(r, rLen) < from {
                from = word(r, rLen)
            }
            setWord(r, rLen, n)
        }
        setWord(r, rDesc, desc)
        setWord(r, rTime, clock)
    }
    if byte(desc, 0) != 'A' {
        return
    }
    let last = if n > 0 { shr(n - 1, cardShift) } else { 0 }
    if last >= word(r, rCardCap) {
        var cap = if word(r, rCardCap) != 0 { word(r, rCardCap) } else { 4 }
        while cap <= last {
            cap *= 2
        }
        let cards = realloc(word(r, rCards), cap * 8)
        if cards == 0 {
            panicNow(panicSize, 0, cap, 0)
        }
        zeroBytes(cards + 8 * word(r, rCardCap), 8 * (cap - word(r, rCardCap)))
        setWord(r, rCards, cards)
        setWord(r, rCardCap, cap)
    }
    let cards = word(r, rCards)
    for k in shr(from, cardShift)..last + 1 {
        setWord(cards, k, clock)
    }
}

pub extern effect fn rtRemember(p: Int64, n: Int64, desc: Int64) as "qk_remember" =
    remember(p, n, desc)
""" + "\n"
    }
    if name == "base" {
        return r"""
// The runtime's ground: memory as words and bytes, C's library, the context of the running thread, and a message
// built in place. The runtime IS the arena, so nothing here allocates: Pointers, Ints, Floats, records in
// registers, loops, and C's functions, as Go's runtime is Go without its heap.
use std.machine as machine

// ---- C's library (the same names on every system) ----
pub extern effect fn malloc(size: UInt64) -> Int64
pub extern effect fn calloc(count: UInt64, size: UInt64) -> Int64
pub extern effect fn realloc(p: Int64, size: UInt64) -> Int64
pub extern effect fn free(p: Int64)
pub extern effect fn memcpy(to: Int64, from: Int64, n: UInt64) -> Int64
pub extern effect fn memmove(to: Int64, from: Int64, n: UInt64) -> Int64
pub extern effect fn memset(to: Int64, c: Int32, n: UInt64) -> Int64
pub extern effect fn memcmp(a: Int64, b: Int64, n: UInt64) -> Int32
pub extern effect fn strlen(s: Int64) -> UInt64
pub extern effect fn strtoll(s: Int64, end: Int64, base: Int32) -> Int64
pub extern effect fn strerror(code: Int32) -> Int64
pub extern effect fn cExit(code: Int32) as "exit"
pub extern fn cFloor(x: Float64) -> Float64 as "floor"
pub extern fn log10(x: Float64) -> Float64
pub extern fn fabs(x: Float64) -> Float64

// ---- the system's own (windows.qk, linux.qk: the same symbols, C's calls) ----
pub extern effect fn osCtx() -> Int64 as "qkosCtx" // the running thread's context (its own storage)
pub extern effect fn osSetCtx(c: Int64) as "qkosSetCtx"
pub extern effect fn osWrite(fd: Int64, p: Int64, n: Int64) as "qkosWrite" // 1 stdout, 2 stderr: every byte
pub extern effect fn osErrno() -> Int64 as "qkosErrno"
pub extern effect fn osSetErrno(e: Int64) as "qkosSetErrno"

// a Float as C's printf writes it: kind 'g' or 'f', with precision; the length written
// ---- words and bytes ----
pub fn word(a: Int, i: Int) -> Int = Pointer<Int64>(a)[i]

pub fn setWord(a: Int, i: Int, v: Int) {
    Pointer<Int64>(a)[i] = v
}

pub fn byte(a: Int, i: Int) -> Int = Pointer<UInt8>(a)[i]

pub fn setByte(a: Int, i: Int, v: Int) {
    Pointer<UInt8>(a)[i] = v
}

pub fn int32At(a: Int, i: Int) -> Int = Pointer<Int32>(a)[i]

pub fn setInt32(a: Int, i: Int, v: Int) {
    Pointer<Int32>(a)[i] = v
}

pub fn floatAt(a: Int, i: Int) -> Float = Pointer<Float64>(a)[i]

pub fn setFloat(a: Int, i: Int, v: Float) {
    Pointer<Float64>(a)[i] = v
}

pub fn bitsOf(v: Float) -> Int {
    let cell = Pointer<Float64>(osScratch())
    cell[0] = v
    Pointer<Int64>(cell)[0]
}

pub fn floatOf(bits: Int) -> Float {
    let cell = Pointer<Int64>(osScratch())
    cell[0] = bits
    Pointer<Float64>(cell)[0]
}

// eight bytes of the thread's own, for a Float's bits
fn osScratch() -> Int = ctx() + 8 * ctxScratch

pub fn copyBytes(to: Int, from: Int, n: Int) {
    if n > 16 {
        let _ = memcpy(to, from, n)
    } else if n > 0 {
        smallMove(to, from, n)
    }
}

pub fn moveBytes(to: Int, from: Int, n: Int) {
    if n > 16 {
        let _ = memmove(to, from, n)
    } else if n > 0 {
        smallMove(to, from, n)
    }
}

// 1 to 16 bytes, without a call: all read before any is written (so the two may overlap), as two words, two halves
// or three bytes that cover them
fn smallMove(to: Int, from: Int, n: Int) {
    if n >= 8 {
        let a = Pointer<Int64>(from)[0]
        let b = Pointer<Int64>(from + n - 8)[0]
        Pointer<Int64>(to)[0] = a
        Pointer<Int64>(to + n - 8)[0] = b
    } else if n >= 4 {
        let a = Pointer<UInt32>(from)[0]
        let b = Pointer<UInt32>(from + n - 4)[0]
        Pointer<UInt32>(to)[0] = a
        Pointer<UInt32>(to + n - 4)[0] = b
    } else {
        let a = Pointer<UInt8>(from)[0]
        let b = Pointer<UInt8>(from)[n / 2]
        let c = Pointer<UInt8>(from)[n - 1]
        Pointer<UInt8>(to)[0] = a
        Pointer<UInt8>(to)[n / 2] = b
        Pointer<UInt8>(to)[n - 1] = c
    }
}

pub fn zeroBytes(to: Int, n: Int) {
    if n > 0 {
        let _ = memset(to, 0, n)
    }
}

// the same n bytes at a and b: eight at a time (the last eight overlapping), C's memcmp only for long runs
pub fn sameBytes(a: Int, b: Int, n: Int) -> Bool {
    if n >= 64 {
        return memcmp(a, b, n) == 0
    }
    if n >= 8 {
        var i = 0
        while i + 8 < n {
            if Pointer<Int64>(a + i)[0] != Pointer<Int64>(b + i)[0] {
                return false
            }
            i += 8
        }
        return Pointer<Int64>(a + n - 8)[0] == Pointer<Int64>(b + n - 8)[0]
    }
    var i = 0
    while i < n {
        if Pointer<UInt8>(a)[i] != Pointer<UInt8>(b)[i] {
            return false
        }
        i += 1
    }
    true
}

// memcmp's sign: the first byte that differs (unsigned); eight at a time up to it
pub fn compareBytes(a: Int, b: Int, n: Int) -> Int {
    if n >= 64 {
        return memcmp(a, b, n)
    }
    var i = 0
    while i + 8 <= n and Pointer<Int64>(a + i)[0] == Pointer<Int64>(b + i)[0] {
        i += 8
    }
    while i < n {
        let d = Pointer<UInt8>(a)[i] - Pointer<UInt8>(b)[i]
        if d != 0 {
            return d
        }
        i += 1
    }
    0
}

// ---- eight bytes at a time (SWAR): a word's bytes tested together ----
pub const lowBytes = 72340172838076673 // 0x0101010101010101
pub const highBits = -9187201950435737472 // 0x8080808080808080

// the bytes of x that are 0: their high bit set (exact for the first one, which is all a search needs)
pub fn zeroBytesOf(x: Int) -> Int = (x -% lowBytes) & ~x & highBits

// the first byte at or after i (before n) that is c, else n
pub fn findByte(t: Int, i0: Int, n: Int, c: Int) -> Int {
    var i = i0
    let spread = c * lowBytes
    while i + 8 <= n {
        if zeroBytesOf(Pointer<Int64>(t + i)[0] ^ spread) != 0 {
            break
        }
        i += 8
    }
    while i < n and Pointer<UInt8>(t)[i] != c {
        i += 1
    }
    i
}

// the first place at or after i where the pn bytes of part are, else -1: its first byte found eight at a time, its
// last byte checked, then the rest
pub fn findBytes(t: Int, i0: Int, n: Int, part: Int, pn: Int) -> Int {
    if pn == 0 {
        return if i0 <= n { i0 } else { -1 }
    }
    let first = Pointer<UInt8>(part)[0]
    let last = Pointer<UInt8>(part)[pn - 1]
    let stop = n - pn + 1 // where a match may start: before stop
    var i = i0
    while i < stop {
        i = findByte(t, i, stop, first)
        if i >= stop {
            return -1
        }
        if Pointer<UInt8>(t)[i + pn - 1] == last and sameBytes(t + i, part, pn) {
            return i
        }
        i += 1
    }
    -1
}

// ---- the addresses of what Quark holds: a text's bytes, a function's C entry (C gives back what it is given) ----
pub fn textAt(t: Text) -> Int = machine.address(t)

pub extern fn textAddressOf(p: Int64, n: Int64) -> Int64 as "qkTextAddress" = p

// ---- numbers as C's unsigned ones ----
pub const intMin = -9223372036854775807 - 1

pub fn shr(x: Int, n: Int) -> Int = if n == 0 { x } else { x >> n & ~(-1 << (64 - n)) }

pub fn below(a: Int, b: Int) -> Bool = a ^ intMin < b ^ intMin // unsigned a < b

// unsigned a / b and a % b
pub fn udiv(a: Int, b: Int) -> Int {
    if b < 0 {
        return if below(a, b) { 0 } else { 1 }
    }
    if a >= 0 {
        return a / b
    }
    var q = shr(a, 1) / b << 1
    let r = a -% q *% b // unsigned
    if not below(r, b) {
        q += 1
    }
    q
}

pub fn umod(a: Int, b: Int) -> Int = a -% udiv(a, b) *% b

pub fn mix(x: Int) -> Int {
    var h = (x ^ shr(x, 30)) *% -4658895280553007687
    h = (h ^ shr(h, 27)) *% -7723592293110705685
    h ^ shr(h, 31)
}

pub fn align16(n: Int) -> Int = (n + 15) & -16

// ---- the context: one per thread that runs Quark ----
// Words: what the code a loader patched reads and writes (the budget, the panic's frame, the escape, the stack's
// limit), then the runtime's own: the arena, the code running, a loop's description, the task, the capture.
pub const ctxFuel = 0
pub const ctxPanicFrame = 1
pub const ctxEscapeRsp = 2
pub const ctxEscapeStub = 3
pub const ctxStackLimit = 4
pub const ctxArena = 5
pub const ctxRunning = 6
pub const ctxRunningEntry = 7
pub const ctxDescBase = 8
pub const ctxTask = 9
pub const ctxTaskStackLow = 10
pub const ctxCapture = 11 // print writes into the capture (a value made text) instead of the output
pub const ctxCaptureBuf = 12
pub const ctxCaptureLen = 13
pub const ctxCaptureCap = 14
pub const ctxGlobals = 15
pub const ctxScratch = 16 // 128 bytes: an Int's digits, a Float's text, a Float's bits
pub const ctxPanicText = 32 // 512 bytes: 64 words
pub const ctxFloatWork = 96 // floatText's room for its big integers (made at the thread's first Float written)
pub const ctxWords = 97
pub const panicTextSize = 512

// The running thread's context: in the context register (machine.context), which every way in from C makes 0; then
// from the thread's own storage (osCtx), kept in the register for what follows. The Quark code a thread runs calls
// the runtime the Quark way, so the register goes along.
pub fn ctx() -> Int {
    let c = machine.context()
    if c != 0 { c } else { ctxFromStorage() }
}

fn ctxFromStorage() -> Int {
    let c = osCtx()
    machine.setContext(c)
    c
}

// this thread's context set: its storage and the register
pub fn setCtx(c: Int) {
    osSetCtx(c)
    machine.setContext(c)
}

pub fn ctxGet(i: Int) -> Int = word(ctx(), i)

pub fn ctxSet(i: Int, v: Int) {
    setWord(ctx(), i, v)
}

pub fn panicText() -> Int = ctx() + 8 * ctxPanicText

pub fn panicTextLen() -> Int = strlen(panicText())

// ---- what every thread shares ----
pub const gOutBuf = 0 // print's buffer (stdout), flushed when full, before stderr and at the end
pub const gOutLen = 1
pub const gOutCap = 2
pub const gOutFd = 3 // 1, or 2 while printErr prints
pub const gArgs = 4 // the program's arguments: (bytes, length) pairs
pub const gArgCount = 5
pub const gRuntime = 6 // each runtime function's address (its Quark function), by its number
pub const gRng = 7 // four words
pub const gRngSeeded = 11
pub const gTasks = 12
pub const gTaskCount = 13
pub const gTaskCap = 14
pub const gExitEnds = 15
pub const gMainCtx = 16
pub const gMainArena = 17
pub const gInBuf = 18 // the input, read ahead (readLine)
pub const gInLen = 19
pub const gInAt = 20
pub const gRunPath = 21 // the program's path, as its panics say it (zero-ended; 0: "program")
pub const gDebug = 22 // the debugger's state (debug.qk), when the command line runs the program under it
pub const gOutSink = 23 // print's output kept (buffer, length, capacity) rather than written, when not 0
pub const gBackground = 24 // go(f)'s tasks, by number, that runTasks (and receive, outside a task) step
pub const gBackgroundCount = 25
pub const gBackgroundCap = 26
pub const gChannels = 27 // channel()'s queues, by number
pub const gChannelCount = 28
pub const gChannelCap = 29
pub const gChannelArena = 30 // where the values in the channels' queues are, apart from any task's memory (or 0)
pub const gChannelQueued = 31 // values in all the queues: none, and the arena is emptied
pub const gChannelKept = 32 // what the arena held when it was last made again from the queued values
pub const gChannelCopier = 33 // the copier the channels' values go through (copierFresh), kept
pub const gChannelFree = 34 // the first place in the channels' table let go of, + 1 (0 none)
pub const gTaskSpares = 35 // the stacks and arenas of tasks that ended, kept for new ones: (stack, arena) pairs
pub const gTaskSpareCount = 36
pub const gScopes = 37 // scope()'s: (open, tasks alive) pairs, by number
pub const gScopeCount = 38
pub const gScopeCap = 39
pub const gTlsLibrary = 40 // the system's TLS library, loaded the first time it is used (its handle; 0 not yet)
pub const gCover = 41 // quark test --coverage: a byte for each line of the program's file, 1 once run (0: none yet)
pub const gWords = 42

pub fn globals() -> Int = word(ctx(), ctxGlobals)

pub fn gGet(i: Int) -> Int = word(globals(), i)

pub fn gSet(i: Int, v: Int) {
    setWord(globals(), i, v)
}

// ---- bytes kept in malloc'd memory that grows: (place, length, capacity) in the words at, at + 1, at + 2 of a block ----
pub fn heldAppend(block: Int, at: Int, p: Int, n: Int) {
    if n <= 0 {
        return
    }
    let have = word(block, at + 1)
    var cap = word(block, at + 2)
    if have + n > cap {
        cap = if cap == 0 { 16384 } else { cap }
        while have + n > cap {
            cap *= 2
        }
        setWord(block, at, realloc(word(block, at), cap))
        setWord(block, at + 2, cap)
    }
    copyBytes(word(block, at) + have, p, n)
    setWord(block, at + 1, have + n)
}

// the first k of them let go of
pub fn heldDrop(block: Int, at: Int, k: Int) {
    let rest = word(block, at + 1) - k
    if rest > 0 {
        moveBytes(word(block, at), word(block, at) + k, rest)
    }
    setWord(block, at + 1, if rest > 0 { rest } else { 0 })
}

pub fn heldFree(block: Int, at: Int) {
    free(word(block, at))
    setWord(block, at, 0)
    setWord(block, at + 1, 0)
    setWord(block, at + 2, 0)
}

// ---- a message, built in place: bytes at p, room for cap (one kept for the zero) ----
pub type Buf { p: Int, cap: Int, n: Int }

pub fn bufAt(p: Int, cap: Int) -> Buf {
    setByte(p, 0, 0)
    Buf(p, cap, 0)
}

pub fn Buf.bytes(self, from: Int, count: Int) -> Buf {
    var k = count
    if self.n + k > self.cap - 1 {
        k = self.cap - 1 - self.n
    }
    if k <= 0 {
        return self
    }
    copyBytes(self.p + self.n, from, k)
    setByte(self.p, self.n + k, 0)
    Buf(self.p, self.cap, self.n + k)
}

pub fn Buf.text(self, t: Text) -> Buf = self.bytes(textAt(t), len(t))

pub fn Buf.zeroText(self, s: Int) -> Buf = if s == 0 { self } else { self.bytes(s, strlen(s)) }

pub fn Buf.char(self, c: Int) -> Buf {
    if self.n + 1 > self.cap - 1 {
        return self
    }
    setByte(self.p, self.n, c)
    setByte(self.p, self.n + 1, 0)
    Buf(self.p, self.cap, self.n + 1)
}

pub fn Buf.int(self, v: Int) -> Buf {
    let s = osScratch() // 24 bytes: an Int's digits, from the end
    var u = v
    var at = 23
    let negative = v < 0
    if u == 0 {
        setByte(s, at, '0')
        at -= 1
    }
    while u != 0 {
        var d = u % 10
        var next = u / 10
        if u < 0 and d != 0 {
            // floored division: back to C's truncation
            d = 10 - d
            next += 1
        }
        setByte(s, at, '0' + d)
        at -= 1
        u = next
    }
    if negative {
        setByte(s, at, '-')
        at -= 1
    }
    self.bytes(s + at + 1, 23 - at)
}

pub fn Buf.hex(self, v: Int) -> Buf {
    let s = osScratch()
    var at = 23
    var u = v
    while true {
        let d = u & 15
        setByte(s, at, if d < 10 { '0' + d } else { 'a' + d - 10 })
        at -= 1
        u = shr(u, 4)
        if u == 0 {
            break
        }
    }
    self.bytes(s + at + 1, 23 - at)
}

// a Float as print writes it: the shortest text that reads back as the same number, with its point
pub fn Buf.float(self, v: Float) -> Buf {
    let s = osScratch() + 48 // past an Int's digits: 80 bytes
    let n = floatText(s, v)
    self.bytes(s, n)
}

// v as print writes it, into s (48 bytes); its length. The shortest digits that read back as the same number (rounded
// as printf rounds, half to even, and read back as strtod reads, the nearest, half to even), worked out exactly with
// big integers: no C library. As %g writes them, then a number from 0.0001 to 1e16 in plain digits, and ".0" when
// there is no point.
pub fn floatText(s: Int, v: Float) -> Int {
    if v != v {
        return writeText(s, "nan")
    }
    if v == 1.0 / 0.0 {
        return writeText(s, "inf")
    }
    if v == -1.0 / 0.0 {
        return writeText(s, "-inf")
    }
    let bits = bitsOf(v)
    var at = 0
    if bits < 0 {
        setByte(s, 0, '-')
        at = 1
    }
    let field = shr(bits, 52) & 2047
    let frac = bits & 4503599627370495
    if field == 0 and frac == 0 {
        return at + writeText(s + at, "0.0")
    }
    // v = m * 2^e2
    let m = if field == 0 { frac } else { frac | 4503599627370496 }
    let e2 = if field == 0 { -1074 } else { field - 1075 }
    let w = floatWork()
    // its exact digits: B * 10^-k, B = m * 2^e2 or m * 5^-e2 (k = -e2)
    let big = w
    bigSet(big, m)
    var k = 0
    if e2 >= 0 {
        bigShl(big, e2)
    } else {
        bigMulPow5(big, -e2)
        k = -e2
    }
    let digits = w + 8 * floatDigitsAt
    let count = bigDecimal(big, digits)
    let ev = count - 1 - k // v's exponent: its first digit's place
    // the rounding interval, scaled to integers: 2^a and 10^b clear every fraction below
    let a = if e2 < 2 { 2 - e2 } else { 0 }
    let b = if ev < 17 { 17 - ev } else { 0 }
    let y = w + 8 * floatLimbs
    bigSet(y, m)
    bigShl(y, e2 + a)
    bigMulPow10(y, b)
    let up = w + 8 * 2 * floatLimbs
    bigSet(up, 1)
    bigShl(up, e2 - 1 + a)
    bigMulPow10(up, b)
    let boundary = frac == 0 and field > 1 // the number below is half as far
    let down = w + 8 * 3 * floatLimbs
    bigSet(down, 1)
    bigShl(down, e2 - (if boundary { 2 } else { 1 }) + a)
    bigMulPow10(down, b)
    let x = w + 8 * 4 * floatLimbs
    let diff = w + 8 * 5 * floatLimbs
    let r = w + 8 * floatRoundedAt // the digits rounded: d of them
    var d = 1
    var ex = ev
    while d <= 17 {
        ex = roundDigits(digits, count, ev, d, r)
        // the candidate: D * 10^q, read back as v when within the interval (on its edge: when m is even)
        var dv = 0
        for i in 0..d {
            dv = dv * 10 + byte(r, i) - '0'
        }
        let q = ex - d + 1
        bigSet(x, dv)
        bigMulPow10(x, q + b)
        bigShl(x, a)
        let c = bigCompare(x, y)
        if c == 0 {
            break
        }
        if c > 0 {
            bigDifference(diff, x, y)
        } else {
            bigDifference(diff, y, x)
        }
        let h = bigCompare(diff, if c > 0 { up } else { down })
        if h < 0 or h == 0 and m & 1 == 0 {
            break
        }
        d += 1
    }
    // the digits without the zeros that end them, as %g writes them
    var sig = d
    while sig > 1 and byte(r, sig - 1) == '0' {
        sig -= 1
    }
    let size = if v < 0.0 { -v } else { v }
    let exponential = ex < -4 or ex >= d
    if exponential and size >= 0.0001 and size < 10000000000000000.0 {
        // in plain digits: v rounded to a whole number (130, not 1.3e+02)
        return at + wholeDigits(s + at, digits, count, ev)
    }
    if exponential {
        setByte(s, at, byte(r, 0))
        at += 1
        if sig > 1 {
            setByte(s, at, '.')
            at += 1
            for i in 1..sig {
                setByte(s, at, byte(r, i))
                at += 1
            }
        }
        setByte(s, at, 'e')
        setByte(s, at + 1, if ex < 0 { '-' } else { '+' })
        at += 2
        let e = if ex < 0 { -ex } else { ex }
        if e >= 100 {
            setByte(s, at, '0' + e / 100)
            at += 1
        }
        setByte(s, at, '0' + e / 10 % 10)
        setByte(s, at + 1, '0' + e % 10)
        return at + 2
    }
    // plain: the point after the digit of 10^0
    if ex < 0 {
        setByte(s, at, '0')
        setByte(s, at + 1, '.')
        at += 2
        for _ in 0..-ex - 1 {
            setByte(s, at, '0')
            at += 1
        }
        for i in 0..sig {
            setByte(s, at, byte(r, i))
            at += 1
        }
        return at
    }
    for i in 0..ex + 1 {
        setByte(s, at, if i < sig { byte(r, i) } else { '0' })
        at += 1
    }
    setByte(s, at, '.')
    at += 1
    if sig > ex + 1 {
        for i in ex + 1..sig {
            setByte(s, at, byte(r, i))
            at += 1
        }
    } else {
        setByte(s, at, '0')
        at += 1
    }
    at
}

// v with `decimals` digits after the point (0 to 40: none, and no point, for 0), as C's %.*f writes it, without C:
// its exact digits rounded half to even (the same on every system), "nan", "inf" and "-inf" as they are; its length
pub fn fixedText(s: Int, v: Float, decimals: Int) -> Int {
    if v != v {
        return writeText(s, "nan")
    }
    if v == 1.0 / 0.0 {
        return writeText(s, "inf")
    }
    if v == -1.0 / 0.0 {
        return writeText(s, "-inf")
    }
    let bits = bitsOf(v)
    var at = 0
    if bits < 0 {
        setByte(s, 0, '-')
        at = 1
    }
    let field = shr(bits, 52) & 2047
    let frac = bits & 4503599627370495
    var count = 0
    var ev = 0
    let w = floatWork()
    let digits = w + 8 * floatDigitsAt
    if field != 0 or frac != 0 {
        let m = if field == 0 { frac } else { frac | 4503599627370496 }
        let e2 = if field == 0 { -1074 } else { field - 1075 }
        bigSet(w, m)
        var k = 0
        if e2 >= 0 {
            bigShl(w, e2)
        } else {
            bigMulPow5(w, -e2)
            k = -e2
        }
        count = bigDecimal(w, digits)
        ev = count - 1 - k
    }
    // the places from the highest (at least 10^0) down to 10^-decimals: the digit there, else 0
    let top = if ev > 0 { ev } else { 0 }
    let from = s + at
    var n = 0
    var p = top
    while p >= -decimals {
        if p == -1 {
            setByte(from, n, '.')
            n += 1
        }
        let i = ev - p
        setByte(from, n, if count > 0 and i >= 0 and i < count { byte(digits, i) } else { '0' })
        n += 1
        p -= 1
    }
    // the rest: up (half to even) when it is more than half of the last place
    let i = ev + decimals + 1
    var up = false
    if count > 0 and i < count {
        let next = if i >= 0 { byte(digits, i) } else { '0' }
        var more = false
        for j in (if i + 1 > 0 { i + 1 } else { 0 })..count {
            if byte(digits, j) != '0' {
                more = true
                break
            }
        }
        if i < 0 {
            up = false // below the last place's half: all of it under 10^-decimals / 10
        } else if next > '5' or next == '5' and more {
            up = true
        } else if next == '5' {
            up = (byte(from, n - 1) - '0') & 1 == 1
        }
    }
    if up {
        var j = n - 1
        while j >= 0 and (byte(from, j) == '9' or byte(from, j) == '.') {
            if byte(from, j) == '9' {
                setByte(from, j, '0')
            }
            j -= 1
        }
        if j >= 0 {
            setByte(from, j, byte(from, j) + 1)
        } else {
            moveBytes(from + 1, from, n)
            setByte(from, 0, '1')
            n += 1
        }
    }
    at + n
}

// the work room of a thread's Floats: six big integers, the digits, the rounded digits
const floatLimbs = 130 // a big integer: its count of 32-bit limbs, then the limbs (up to 4100 bits)
const floatDigitsAt = 6 * floatLimbs // 808 bytes: up to 800 digits
const floatRoundedAt = floatDigitsAt + 101
const floatWorkWords = floatRoundedAt + 4

fn floatWork() -> Int {
    let c = ctx()
    if word(c, ctxFloatWork) == 0 {
        setWord(c, ctxFloatWork, calloc(floatWorkWords, 8))
    }
    word(c, ctxFloatWork)
}

// the d digits of the number written digits * 10^(ev - count + 1) rounded half to even, into r; their exponent (one
// more when 9...9 rounds up)
fn roundDigits(digits: Int, count: Int, ev: Int, d: Int, r: Int) -> Int {
    for i in 0..d {
        setByte(r, i, if i < count { byte(digits, i) } else { '0' })
    }
    if d >= count {
        return ev
    }
    let next = byte(digits, d)
    var up = next > '5'
    if next == '5' {
        var more = false
        for i in d + 1..count {
            if byte(digits, i) != '0' {
                more = true
                break
            }
        }
        up = more or (byte(r, d - 1) - '0') & 1 == 1
    }
    if not up {
        return ev
    }
    var i = d - 1
    while i >= 0 and byte(r, i) == '9' {
        setByte(r, i, '0')
        i -= 1
    }
    if i >= 0 {
        setByte(r, i, byte(r, i) + 1)
        return ev
    }
    setByte(r, 0, '1') // 9...9 up: 10...0, one place more
    ev + 1
}

// v rounded to a whole number (half to even) from its exact digits, with ".0"; its length
fn wholeDigits(s: Int, digits: Int, count: Int, ev: Int) -> Int {
    let n = ev + 1 // the whole digits
    for i in 0..n {
        setByte(s, i, if i < count { byte(digits, i) } else { '0' })
    }
    var len = n
    if n < count {
        let next = byte(digits, n)
        var up = next > '5'
        if next == '5' {
            var more = false
            for i in n + 1..count {
                if byte(digits, i) != '0' {
                    more = true
                    break
                }
            }
            up = more or (byte(s, n - 1) - '0') & 1 == 1
        }
        if up {
            var i = n - 1
            while i >= 0 and byte(s, i) == '9' {
                setByte(s, i, '0')
                i -= 1
            }
            if i >= 0 {
                setByte(s, i, byte(s, i) + 1)
            } else {
                moveBytes(s + 1, s, n)
                setByte(s, 0, '1')
                len += 1
            }
        }
    }
    setByte(s, len, '.')
    setByte(s, len + 1, '0')
    len + 2
}

// ---- a Float read from text, without C: what strtod reads, rounded as it rounds (the nearest, half to even) ----
// The whole text is the number: a sign, then digits with a point and an exponent (1, 1.5, .5, 5., 1e-7), inf or
// infinity, nan or nan(...), or hexadecimal (0x1.8p3). Up to 800 digits are kept, and whether any after them is not 0:
// no number halfway between two Floats has more. False when it is not a number; else its bits in out's word.
pub fn textFloat(t: Int, n: Int, out: Int) -> Bool {
    var i = 0
    var negative = false
    if i < n and (byte(t, i) == '+' or byte(t, i) == '-') {
        negative = byte(t, i) == '-'
        i += 1
    }
    let sign = if negative { intMin } else { 0 }
    if wordAt(t, i, n, "infinity") or wordAt(t, i, n, "inf") and i + 3 == n {
        setWord(out, 0, sign | 9218868437227405312)
        return true
    }
    if wordAt(t, i, n, "nan") {
        if i + 3 != n {
            // nan(letters, digits, _)
            if byte(t, i + 3) != '(' or byte(t, n - 1) != ')' {
                return false
            }
            for k in i + 4..n - 1 {
                let c = byte(t, k)
                if not (c >= '0' and c <= '9' or c >= 'a' and c <= 'z' or c >= 'A' and c <= 'Z' or c == '_') {
                    return false
                }
            }
        }
        setWord(out, 0, sign | 9221120237041090560)
        return true
    }
    if i + 1 < n and byte(t, i) == '0' and (byte(t, i + 1) == 'x' or byte(t, i + 1) == 'X') {
        return hexFloat(t, i + 2, n, sign, out)
    }
    let w = floatWork()
    let digits = w + 8 * floatDigitsAt
    var kept = 0
    var started = false
    var more = false // a digit not 0 after the kept ones
    var dexp = 0 // the number is digits * 10^dexp
    var seen = false // a digit at all
    var point = false
    while i < n {
        let c = byte(t, i)
        if c == '.' {
            if point {
                return false
            }
            point = true
            i += 1
            continue
        }
        if c < '0' or c > '9' {
            break
        }
        seen = true
        if c != '0' or started {
            started = true
            if kept < floatDigitsKept {
                setByte(digits, kept, c)
                kept += 1
                if point {
                    dexp -= 1
                }
            } else {
                more = more or c != '0'
                if not point {
                    dexp += 1
                }
            }
        } else if point {
            dexp -= 1 // a 0 before the first digit, after the point
        }
        i += 1
    }
    if not seen {
        return false
    }
    if i < n and (byte(t, i) == 'e' or byte(t, i) == 'E') {
        i += 1
        var exponentNegative = false
        if i < n and (byte(t, i) == '+' or byte(t, i) == '-') {
            exponentNegative = byte(t, i) == '-'
            i += 1
        }
        if i >= n {
            return false
        }
        var e = 0
        while i < n and byte(t, i) >= '0' and byte(t, i) <= '9' {
            if e < 100000000 {
                e = e * 10 + byte(t, i) - '0'
            }
            i += 1
        }
        dexp += if exponentNegative { -e } else { e }
    }
    if i != n {
        return false
    }
    // the 0s that end the digits go into the exponent
    while kept > 0 and byte(digits, kept - 1) == '0' {
        kept -= 1
        dexp += 1
    }
    if kept == 0 {
        setWord(out, 0, sign)
        return true
    }
    let size = kept + dexp // the number is below 10^size, at least 10^(size - 1)
    if size > 310 {
        setWord(out, 0, sign | 9218868437227405312)
        return true
    }
    if size < -324 {
        setWord(out, 0, sign)
        return true
    }
    // exact with Floats: at most 15 digits, times or over a power of ten that is a Float exactly
    if kept <= 15 and dexp >= -22 and dexp <= 22 and not more {
        var whole = 0
        for k in 0..kept {
            whole = whole * 10 + byte(digits, k) - '0'
        }
        var p = 1.0
        for _ in 0..(if dexp < 0 { -dexp } else { dexp }) {
            p *= 10.0
        }
        let v = if dexp >= 0 { toFloat(whole) * p } else { toFloat(whole) / p }
        setWord(out, 0, sign | bitsOf(v))
        return true
    }
    // else a guess from the first digits, made right by comparing exactly with the halfway numbers around it
    var lead = 0
    let used = if kept < 17 { kept } else { 17 }
    for k in 0..used {
        lead = lead * 10 + byte(digits, k) - '0'
    }
    var guess = toFloat(lead)
    var x = dexp + kept - used
    while x >= 22 {
        guess *= 10000000000000000000000.0
        x -= 22
    }
    while x <= -22 {
        guess /= 10000000000000000000000.0
        x += 22
    }
    while x > 0 {
        guess *= 10.0
        x -= 1
    }
    while x < 0 {
        guess /= 10.0
        x += 1
    }
    var g = bitsOf(guess)
    if g <= 0 {
        g = 1 // the least subnormal
    }
    if g >= 9218868437227405312 {
        g = 9218868437227405311 // the greatest finite
    }
    let s = w // the digits as a big integer
    bigFromDigits(s, digits, kept)
    while true {
        let field = shr(g, 52) & 2047
        let frac = g & 4503599627370495
        let m = if field == 0 { frac } else { frac | 4503599627370496 }
        let e2 = if field == 0 { -1074 } else { field - 1075 }
        // above the halfway number to the next one up: (2m + 1) * 2^(e2 - 1)
        let above = halfwayCompare(s, dexp, more, 2 * m + 1, e2 - 1)
        if above > 0 or above == 0 and m & 1 == 1 {
            if g == 9218868437227405311 {
                g = 9218868437227405312 // past the greatest: infinite
                break
            }
            g += 1
            continue
        }
        // below the halfway number to the next one down
        let boundary = frac == 0 and field > 1
        let below = if boundary {
            halfwayCompare(s, dexp, more, 4 * m - 1, e2 - 2)
        } else {
            halfwayCompare(s, dexp, more, 2 * m - 1, e2 - 1)
        }
        if below < 0 or below == 0 and m & 1 == 1 {
            g -= 1
            if g == 0 {
                break
            }
            continue
        }
        break
    }
    setWord(out, 0, sign | g)
    true
}

const floatDigitsKept = 800

// does the word w (lower case) begin t at i, in any case
fn wordAt(t: Int, i: Int, n: Int, w: Text) -> Bool {
    let k = len(w)
    if i + k > n {
        return false
    }
    let wb = textAt(w)
    for j in 0..k {
        var c = byte(t, i + j)
        if c >= 'A' and c <= 'Z' {
            c += 32
        }
        if c != byte(wb, j) {
            return false
        }
    }
    i + k == n or k == 3 // inf and nan may have more after them (infinity, nan(...)): their callers look
}

// digits * 10^dexp (plus a little more when more) against k * 2^p: -1, 0, 1
fn halfwayCompare(s: Int, dexp: Int, more: Bool, k: Int, p: Int) -> Int {
    let w = floatWork()
    let a = w + 8 * 4 * floatLimbs
    let b = w + 8 * 5 * floatLimbs
    bigCopy(a, s)
    if dexp > 0 {
        bigMulPow10(a, dexp)
    }
    if p < 0 {
        bigShl(a, -p)
    }
    bigSet(b, k)
    if p > 0 {
        bigShl(b, p)
    }
    if dexp < 0 {
        bigMulPow10(b, -dexp)
    }
    let c = bigCompare(a, b)
    if c == 0 and more { 1 } else { c }
}

fn bigCopy(to: Int, from: Int) {
    for i in 0..word(from, 0) + 1 {
        setWord(to, i, word(from, i))
    }
}

// x = the decimal digits s[0..count]
fn bigFromDigits(x: Int, s: Int, count: Int) {
    setWord(x, 0, 0)
    var i = 0
    while i < count {
        var chunk = 0
        var f = 1
        var k = 0
        while k < 9 and i < count {
            chunk = chunk * 10 + byte(s, i) - '0'
            f *= 10
            k += 1
            i += 1
        }
        if word(x, 0) == 0 {
            bigSet(x, chunk)
        } else {
            bigMulSmall(x, f)
            bigAddSmall(x, chunk)
        }
    }
}

// x += v (v below 2^32)
fn bigAddSmall(x: Int, v: Int) {
    var carry = v
    var i = 1
    while carry != 0 {
        if i > word(x, 0) {
            setWord(x, i, carry)
            setWord(x, 0, i)
            return
        }
        let t = word(x, i) + carry
        setWord(x, i, t & low32)
        carry = shr(t, 32)
        i += 1
    }
}

// 0x digits [. digits] [p exponent], from i: its value rounded to 53 bits (half to even), into out
fn hexFloat(t: Int, i0: Int, n: Int, sign: Int, out: Int) -> Bool {
    var i = i0
    var mant = 0 // the first 60 bits of the digits
    var bits = 0 // how many bits mant holds
    var exp = 0 // the number is mant * 2^exp (plus more)
    var more = false
    var seen = false
    var point = false
    while i < n {
        let c = byte(t, i)
        if c == '.' {
            if point {
                return false
            }
            point = true
            i += 1
            continue
        }
        let d = if c >= '0' and c <= '9' {
            c - '0'
        } else if c >= 'a' and c <= 'f' {
            c - 'a' + 10
        } else if c >= 'A' and c <= 'F' {
            c - 'A' + 10
        } else {
            -1
        }
        if d < 0 {
            break
        }
        seen = true
        if mant == 0 and d == 0 {
            if point {
                exp -= 4
            }
        } else if bits <= 56 {
            mant = mant << 4 | d
            bits = if mant == d { hexBits(d) } else { bits + 4 }
            if point {
                exp -= 4
            }
        } else {
            more = more or d != 0
            if not point {
                exp += 4
            }
        }
        i += 1
    }
    if not seen {
        return false
    }
    if i < n and (byte(t, i) == 'p' or byte(t, i) == 'P') {
        i += 1
        var negative = false
        if i < n and (byte(t, i) == '+' or byte(t, i) == '-') {
            negative = byte(t, i) == '-'
            i += 1
        }
        if i >= n {
            return false
        }
        var e = 0
        while i < n and byte(t, i) >= '0' and byte(t, i) <= '9' {
            if e < 100000000 {
                e = e * 10 + byte(t, i) - '0'
            }
            i += 1
        }
        exp += if negative { -e } else { e }
    }
    if i != n {
        return false
    }
    if mant == 0 {
        setWord(out, 0, sign)
        return true
    }
    // mant * 2^exp: its top bit at 2^top
    var top = 0
    var probe = mant
    while probe > 1 {
        probe = shr(probe, 1)
        top += 1
    }
    let topExp = top + exp
    if topExp > 1023 {
        setWord(out, 0, sign | 9218868437227405312)
        return true
    }
    // the bits that stay: 53 for a normal number, fewer below 2^-1022
    let keep = if topExp >= -1022 { 53 } else { 53 - (-1022 - topExp) }
    if keep < 0 {
        // below half the least subnormal
        setWord(out, 0, sign)
        return true
    }
    let drop = top + 1 - keep // the low bits that go
    var m = mant
    if drop > 0 {
        let lowMask = 1 << drop - 1
        let low = m & lowMask
        let half = 1 << (drop - 1)
        m = shr(m, drop)
        if low > half or low == half and (more or m & 1 == 1) {
            m += 1
        }
    } else if drop < 0 {
        m = m << -drop
    }
    // m has keep bits (or keep + 1 after rounding up): the Float's fields
    var e2 = topExp
    if keep < 53 {
        // subnormal (or the least normal, rounded up)
        let field = if m >= 4503599627370496 { 1 } else { 0 }
        setWord(out, 0, sign | field << 52 | m & 4503599627370495)
        return true
    }
    if m >= 9007199254740992 {
        m = shr(m, 1)
        e2 += 1
        if e2 > 1023 {
            setWord(out, 0, sign | 9218868437227405312)
            return true
        }
    }
    setWord(out, 0, sign | (e2 + 1023) << 52 | m & 4503599627370495)
    true
}

fn hexBits(d: Int) -> Int = if d >= 8 {
    4
} else if d >= 4 {
    3
} else if d >= 2 {
    2
} else {
    1
}

// ---- big integers for floatText: word 0 their limbs' count, then 32-bit limbs, the lowest first ----
const low32 = 4294967295

fn bigSet(x: Int, v: Int) {
    if v == 0 {
        setWord(x, 0, 0)
        return
    }
    setWord(x, 1, v & low32)
    let high = shr(v, 32)
    if high == 0 {
        setWord(x, 0, 1)
    } else {
        setWord(x, 2, high)
        setWord(x, 0, 2)
    }
}

// x *= f (f below 2^32)
fn bigMulSmall(x: Int, f: Int) {
    let n = word(x, 0)
    var carry = 0
    for i in 1..n + 1 {
        let t = word(x, i) *% f +% carry
        setWord(x, i, t & low32)
        carry = shr(t, 32)
    }
    if carry != 0 {
        setWord(x, n + 1, carry)
        setWord(x, 0, n + 1)
    }
}

fn bigMulPow10(x: Int, n0: Int) {
    var n = n0
    while n >= 9 {
        bigMulSmall(x, 1000000000)
        n -= 9
    }
    var f = 1
    for _ in 0..n {
        f *= 10
    }
    if f > 1 {
        bigMulSmall(x, f)
    }
}

fn bigMulPow5(x: Int, n0: Int) {
    var n = n0
    while n >= 13 {
        bigMulSmall(x, 1220703125) // 5^13
        n -= 13
    }
    var f = 1
    for _ in 0..n {
        f *= 5
    }
    if f > 1 {
        bigMulSmall(x, f)
    }
}

// x *= 2^bits
fn bigShl(x: Int, bits: Int) {
    let n = word(x, 0)
    if n == 0 or bits <= 0 {
        return
    }
    let whole = bits / 32
    let part = bits % 32
    var top = n + whole
    if part != 0 {
        setWord(x, top + 1, 0)
        var i = n
        while i >= 1 {
            let v = word(x, i)
            setWord(x, i + whole + 1, word(x, i + whole + 1) | shr(v, 32 - part))
            setWord(x, i + whole, v << part & low32)
            i -= 1
        }
        if word(x, top + 1) != 0 {
            top += 1
        }
    } else {
        var i = n
        while i >= 1 {
            setWord(x, i + whole, word(x, i))
            i -= 1
        }
    }
    for i in 1..whole + 1 {
        setWord(x, i, 0)
    }
    setWord(x, 0, top)
}

// -1, 0, 1: x below, equal to, above y
fn bigCompare(x: Int, y: Int) -> Int {
    let n = word(x, 0)
    if n != word(y, 0) {
        return if n < word(y, 0) { -1 } else { 1 }
    }
    var i = n
    while i >= 1 {
        if word(x, i) != word(y, i) {
            return if word(x, i) < word(y, i) { -1 } else { 1 }
        }
        i -= 1
    }
    0
}

// out = x - y (x at least y)
fn bigDifference(out: Int, x: Int, y: Int) {
    let n = word(x, 0)
    var borrow = 0
    var top = 0
    for i in 1..n + 1 {
        var t = word(x, i) - borrow - (if i <= word(y, 0) { word(y, i) } else { 0 })
        borrow = 0
        if t < 0 {
            t += 4294967296
            borrow = 1
        }
        setWord(out, i, t)
        if t != 0 {
            top = i
        }
    }
    setWord(out, 0, top)
}

// x's decimal digits into s (x is used up); their count
fn bigDecimal(x: Int, s: Int) -> Int {
    var chunks = 0 // nine digits each, the lowest first, written from the end of s's room backwards
    let room = 792
    var at = room
    while word(x, 0) > 0 {
        var rem = 0
        var i = word(x, 0)
        while i >= 1 {
            let cur = rem << 32 | word(x, i)
            setWord(x, i, cur / 1000000000)
            rem = cur % 1000000000
            i -= 1
        }
        while word(x, 0) > 0 and word(x, word(x, 0)) == 0 {
            setWord(x, 0, word(x, 0) - 1)
        }
        for _ in 0..9 {
            at -= 1
            setByte(s, at, '0' + rem % 10)
            rem /= 10
        }
        chunks += 1
    }
    // the zeros before the first digit go
    while at < room - 1 and byte(s, at) == '0' {
        at += 1
    }
    let count = room - at
    moveBytes(s, s + at, count)
    count
}

pub fn writeText(s: Int, t: Text) -> Int {
    copyBytes(s, textAt(t), len(t))
    len(t)
}

pub fn hasByte(s: Int, n: Int, c: Int) -> Bool {
    for i in 0..n {
        if byte(s, i) == c {
            return true
        }
    }
    false
}

// ---- the runtime's own functions, called the C way: what a module below cannot reach by use ----
pub extern effect fn panicNow(code: Int64, line: Int64, a: Int64, b: Int64) as "qk_panic"
pub extern effect fn stopNow() as "qkrtStop" // the panic text said; back to the call, or the end
pub extern effect fn flushOut() as "qkrtFlush" // what print buffered, written

pub const panicIndex = 1
pub const panicDivide = 2
pub const panicFuel = 3
pub const panicEmpty = 5
pub const panicSize = 6
pub const panicSliceEnd = 7
pub const panicSliceStart = 8
pub const panicStack = 9
pub const panicTextCut = 10
pub const panicMemory = 11
pub const panicOverflow = 12
pub const panicTooBig = 13
pub const panicEmptyRange = 14
pub const panicTask = 15
pub const panicNanKey = 16
pub const panicChar = 17
pub const panicByte = 18
pub const panicMapFull = 19
pub const panicFreed = 20 // QUARK_VALIDATE=1: a block counted or let go of after it went back to the heap
pub const panicDeadlock = 21 // every task waits on a channel, and nothing is left to send on one
pub const panicClosedChannel = 22
pub const panicNoChannel = 23
pub const panicScopeClosed = 24 // scope.start after its scope(...) ended

// ---- the runtime's one word of its own: the shared state's address ----
// Quark has no global variables; the runtime keeps two words in its object's data (quark object --linked makes
// .data writable, as C's statics are): the bytes of this literal, written once when the program starts (a text is in
// the data once, however many places use it). qkCell gives it to C.
pub extern fn cellOfRuntime() -> Int64 as "qkCell" = cell()

pub fn cell() -> Int = textAt("quark-runtime-globals-cell-word!")
