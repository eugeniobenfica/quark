extern effect fn findWsSetOption(m: Int64, name: Int64) -> (extern (Int64, Int32, Int32, Int64, Int32) -> Int32)? as "GetProcAddress"

fn wsSetOption(s: Int, level: Int, name: Int, value: Int, n: Int) -> Int = match findWsSetOption(
    winsock(),
    textAt("setsockopt\0"),
) {
    Some(f) => f(s, level, name, value, n)
    None => -1
