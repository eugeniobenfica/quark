extern effect fn findWsRecv(m: Int64, name: Int64) -> (extern (Int64, Int64, Int32, Int32) -> Int32)? as "GetProcAddress"

fn wsRecv(s: Int, p: Int, n: Int, flags: Int) -> Int = match findWsRecv(winsock(), textAt("recv\0")) {
    Some(f) => f(s, p, n, flags)
    None => -1
}

extern effect fn findWsSend(m: Int64, name: Int64) -> (extern (Int64, Int64, Int32, Int32) -> Int32)? as "GetProcAddress"

fn wsSend(s: Int, p: Int, n: Int, flags: Int) -> Int = match findWsSend(winsock(), textAt("send\0")) {
    Some(f) => f(s, p, n, flags)
    None => -1
}

extern effect fn findWsClose(m: Int64, name: Int64) -> (extern (Int64) -> Int32)? as "GetProcAddress"

fn wsClose(s: Int) -> Int = match findWsClose(winsock(), textAt("closesocket\0")) {
    Some(f) => f(s)
    None => -1
}

extern effect fn findWsIoctl(m: Int64, name: Int64) -> (extern (Int64, Int32, Int64) -> Int32)? as "GetProcAddress"

fn wsIoctl(s: Int, command: Int, arg: Int) -> Int = match findWsIoctl(winsock(), textAt("ioctlsocket\0")) {
    Some(f) => f(s, command, arg)
    None => -1
