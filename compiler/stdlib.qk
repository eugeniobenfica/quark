// The runtime's system calls on Linux: the C library (glibc: POSIX, pthreads, dlopen), each behind a symbol of the
// runtime's own (qkos*, C's calls; windows.qk gives the same ones), and the executable's entry, main.
use base
use start
use host

extern effect fn pthreadKeyCreate(key: Int64, destructor: Int64) -> Int32 as "pthread_key_create"
extern effect fn pthreadGetSpecific(key: UInt32) -> Int64 as "pthread_getspecific"
extern effect fn pthreadSetSpecific(key: UInt32, v: Int64) -> Int32 as "pthread_setspecific"
extern effect fn pthreadSelf() -> Int64 as "pthread_self"
extern effect fn pthreadGetAttrNp(t: Int64, attr: Int64) -> Int32 as "pthread_getattr_np"
extern effect fn pthreadAttrGetStack(attr: Int64, low: Int64, size: Int64) -> Int32 as "pthread_attr_getstack"
extern effect fn pthreadAttrInit(attr: Int64) -> Int32 as "pthread_attr_init"
extern effect fn pthreadAttrSetStackSize(attr: Int64, size: UInt64) -> Int32 as "pthread_attr_setstacksize"
extern effect fn pthreadAttrDestroy(attr: Int64) -> Int32 as "pthread_attr_destroy"
extern effect fn pthreadCreate(t: Int64, attr: Int64, f: Int64, arg: Int64) -> Int32 as "pthread_create"
extern effect fn pthreadJoin(t: Int64, result: Int64) -> Int32 as "pthread_join"
extern effect fn cWrite(fd: Int32, p: Int64, n: UInt64) -> Int64 as "write"
extern effect fn cRead(fd: Int32, p: Int64, n: UInt64) -> Int64 as "read"
extern effect fn cClose(fd: Int32) -> Int32 as "close"
extern effect fn cOpen(path: Int64, flags: Int32) -> Int32 as "open"
extern effect fn errnoLocation() -> Int64 as "__errno_location"
extern effect fn vsnprintf(buf: Int64, size: UInt64, format: Int64, args: Int64) -> Int32
extern effect fn clockGettime(clock: Int32, at: Int64) -> Int32 as "clock_gettime"
extern effect fn usleep(us: UInt32) -> Int32
extern effect fn fopen(path: Int64, mode: Int64) -> Int64
extern effect fn getenv(name: Int64) -> Int64
extern effect fn access(path: Int64, mode: Int32) -> Int32
extern effect fn opendir(path: Int64) -> Int64
extern effect fn readdir(d: Int64) -> Int64
extern effect fn closedir(d: Int64) -> Int32
extern effect fn mkdir(path: Int64, mode: UInt32) -> Int32
extern effect fn rmdir(path: Int64) -> Int32
extern effect fn unlink(path: Int64) -> Int32
extern effect fn pipe(fds: Int64) -> Int32
extern effect fn pipe2(fds: Int64, flags: Int32) -> Int32
extern effect fn fork() -> Int32
extern effect fn dup2(a: Int32, b: Int32) -> Int32
extern effect fn execvp(name: Int64, argv: Int64) -> Int32
extern effect fn cExitNow(code: Int32) as "_exit"
extern effect fn poll(fds: Int64, n: UInt64, timeout: Int32) -> Int32
extern effect fn waitpid(pid: Int32, status: Int64, options: Int32) -> Int32
extern effect fn mmap(p: Int64, n: UInt64, prot: Int32, flags: Int32, fd: Int32, offset: Int64) -> Int64
extern effect fn mprotect(p: Int64, n: UInt64, prot: Int32) -> Int32
extern effect fn munmap(p: Int64, n: UInt64) -> Int32
extern effect fn clearCache(from: Int64, to: Int64) as "__clear_cache"
extern effect fn dlopen(name: Int64, flags: Int32) -> Int64
extern effect fn dlsym(h: Int64, name: Int64) -> Int64
extern effect fn sysconf(name: Int32) -> Int64
extern effect fn readlink(path: Int64, buf: Int64, n: UInt64) -> Int64
extern fn fnAddress(f: extern (Int64) -> Int64) -> Int64 as "qkTextAddress"

const eintr = 4

// ---- the context, the output, numbers ----
pub extern effect fn osCtxImpl() -> Int64 as "qkosCtx" = pthreadGetSpecific(word(cell(), 1))

pub extern effect fn osSetCtxImpl(c: Int64) as "qkosSetCtx" {
    let _ = pthreadSetSpecific(word(cell(), 1), c)
}

pub extern effect fn osWriteImpl(fd: Int64, p: Int64, n: Int64) as "qkosWrite" {
    var at = 0
    while at < n {
        let k = cWrite(fd, p + at, n - at)
        if k < 0 and int32At(errnoLocation(), 0) == eintr {
            continue
        }
        if k <= 0 {
            break
        }
        at += k
    }
}

pub extern effect fn osErrnoImpl() -> Int64 as "qkosErrno" = int32At(errnoLocation(), 0)

pub extern effect fn osSetErrnoImpl(e: Int64) as "qkosSetErrno" = setInt32(errnoLocation(), 0, e)

// printf's way with a Float, called through vsnprintf with a va_list made here (a variadic call would need al on
// x86-64): the precision and the Float's bits as the stack would hold them, and the list says every register is used
pub extern effect fn osFloatTextImpl(buf: Int64, size: Int64, kind: Int64, precision: Int64, v: Float64) -> Int64 as "qkosFloatText" {
    let args = calloc(4, 8)
    setWord(args, 0, precision)
    setFloat(args, 1, v)
    let va = calloc(4, 8)
    if byte(fnAddress(x => run(x)), 0) == 85 {
        // x86-64 (push rbp): gp_offset 48, fp_offset 176, the overflow area
        setInt32(va, 0, 48)
        setInt32(va, 1, 176)
        setWord(va, 1, args)
    } else {
        // ARM64: __stack, __gr_top, __vr_top, __gr_offs 0, __vr_offs 0 (the struct, by its address)
        setWord(va, 0, args)
    }
    let format = if kind == 'f' { textAt("%.*f\0") } else { textAt("%.*g\0") }
    let n = vsnprintf(buf, size, format, va)
    free(va)
    free(args)
    n
}

fn clock(which: Int) -> Float {
    let t = calloc(2, 8)
    let _ = clockGettime(which, t)
    let s = toFloat(word(t, 0)) + toFloat(word(t, 1)) * 0.000000001
    free(t)
    s
}

pub extern effect fn osNowImpl() -> Float64 as "qkosNow" = clock(1) // CLOCK_MONOTONIC

pub extern effect fn osTimeImpl() -> Float64 as "qkosTime" = clock(0) // CLOCK_REALTIME

pub extern effect fn osSleepImpl(ms: Int64) as "qkosSleep" {
    let _ = usleep(1000 * ms)
}

// ---- files and folders ----
pub extern effect fn osOpenImpl(path: Int64, mode: Int64) -> Int64 as "qkosOpen" = fopen(path, mode)

pub extern effect fn osEnvImpl(name: Int64) -> Int64 as "qkosEnv" {
    let v = getenv(name)
    if v == 0 {
        return 0
    }
    let n = strlen(v)
    let s = malloc(n + 1)
    copyBytes(s, v, n + 1)
    s
}

pub extern effect fn osPathKindImpl(path: Int64) -> Int64 as "qkosPathKind" {
    if access(path, 0) != 0 {
        return -1
    }
    let d = opendir(path)
    if d == 0 {
        return 0
    }
    let _ = closedir(d)
    1
}

pub extern effect fn osMakeDirImpl(path: Int64) -> Int64 as "qkosMakeDir" = mkdir(path, 511)

pub extern effect fn osRemoveImpl(path: Int64, folder: Int64) -> Int64 as "qkosRemove" =
    if folder == 1 { rmdir(path) } else { unlink(path) }

pub extern effect fn osSeparatorImpl(c: Int64) -> Int64 as "qkosSeparator" =
    if c == '/' { 1 } else { 0 }

pub extern effect fn osListDirImpl(path: Int64) -> Int64 as "qkosListDir" {
    let d = opendir(path)
    if d == 0 {
        return 0
    }
    var cap = 1024
    var out = malloc(cap)
    var used = 0
    while true {
        let e = readdir(d)
        if e == 0 {
            break
        }
        let name = e + 19 // d_name, after d_ino, d_off, d_reclen and d_type
        let k = strlen(name)
        let dots = k == 1 and byte(name, 0) == '.' or k == 2 and byte(name, 0) == '.' and byte(name, 1) == '.'
        if not dots {
            while used + k + 2 > cap {
                cap *= 2
                out = realloc(out, cap)
            }
            copyBytes(out + used, name, k + 1)
            used += k + 1
        }
    }
    let _ = closedir(d)
    setByte(out, used, 0)
    out
}

// ---- the input ----
pub extern effect fn osReadInImpl(p: Int64, n: Int64) -> Int64 as "qkosReadIn" {
    while true {
        let k = cRead(0, p, n)
        if k < 0 and int32At(errnoLocation(), 0) == eintr {
            continue
        }
        return if k > 0 { k } else { 0 }
    }
    0
}

pub extern effect fn osReadLineImpl(out: Int64) -> Int64 as "qkosReadLine" = -1 + out - out

// ---- other programs ----
fn cannotRun(out: Int, name: Int, e: Int) -> Int {
    let m = malloc(700)
    let _ = bufAt(m, 700).text("cannot run ").zeroText(name).text(": ").zeroText(strerror(e))
    setWord(out, 1, m)
    1
}

fn errno() -> Int = int32At(errnoLocation(), 0)

pub extern effect fn osRunProcessImpl(name: Int64, args: Int64, count: Int64, out: Int64) -> Int64 as "qkosRunProcess" {
    let argv = calloc(count + 2, 8)
    setWord(argv, 0, name)
    for i in 0..count {
        let n = word(args, 2 * i + 1)
        let s = calloc(n + 1, 1)
        copyBytes(s, word(args, 2 * i), n)
        setWord(argv, i + 1, s)
    }
    let fds = calloc(6, 4) // the output, the errors, and exec's failure (closed when exec works)
    if pipe(fds) != 0 {
        return cannotRun(out, name, errno())
    }
    if pipe(fds + 8) != 0 {
        let e = errno()
        let _ = cClose(int32At(fds, 0)) + cClose(int32At(fds, 1))
        return cannotRun(out, name, e)
    }
    if pipe2(fds + 16, 524288) != 0 {
        // O_CLOEXEC
        let e = errno()
        let _ = cClose(int32At(fds, 0)) + cClose(int32At(fds, 1)) + cClose(int32At(fds, 2)) + cClose(int32At(fds, 3))
        return cannotRun(out, name, e)
    }
    let pid = fork()
    if pid < 0 {
        let e = errno()
        for i in 0..6 {
            let _ = cClose(int32At(fds, i))
        }
        return cannotRun(out, name, e)
    }
    if pid == 0 {
        // the child
        let devNull = cOpen(textAt("/dev/null\0"), 0)
        if devNull >= 0 {
            let _ = dup2(devNull, 0)
        }
        let _ = dup2(int32At(fds, 1), 1) + dup2(int32At(fds, 3), 2)
        let _ = cClose(int32At(fds, 0)) + cClose(int32At(fds, 2)) + cClose(int32At(fds, 4))
        let _ = execvp(name, argv)
        let e = calloc(1, 8)
        setInt32(e, 0, errno())
        let _ = cWrite(int32At(fds, 5), e, 4)
        cExitNow(127)
    }
    let _ = cClose(int32At(fds, 1)) + cClose(int32At(fds, 3)) + cClose(int32At(fds, 5))
    let execError = calloc(1, 8)
    var got = cRead(int32At(fds, 4), execError, 4)
    while got < 0 and errno() == eintr {
        got = cRead(int32At(fds, 4), execError, 4)
    }
    let _ = cClose(int32At(fds, 4))
    let pfd = calloc(2, 8) // two pollfds: fd, events (POLLIN), revents
    setInt32(pfd, 0, int32At(fds, 0))
    setInt32(pfd, 1, 1)
    setInt32(pfd, 2, int32At(fds, 2))
    setInt32(pfd, 3, 1)
    let bufs = calloc(6, 8) // (bytes, length, room) for the output, then the errors
    for i in 0..2 {
        setWord(bufs, 3 * i, malloc(4096))
        setWord(bufs, 3 * i + 2, 4096)
    }
    let chunk = malloc(16384)
    var live = 2
    while live > 0 {
        if poll(pfd, 2, -1) < 0 {
            if errno() == eintr {
                continue
            }
            break
        }
        for i in 0..2 {
            let fd = int32At(pfd, 2 * i)
            if fd >= 0 and Pointer<Int16>(pfd)[4 * i + 3] != 0 {
                let n = cRead(fd, chunk, 16384)
                if n > 0 {
                    let b = bufs + 24 * i
                    while word(b, 1) + n > word(b, 2) {
                        setWord(b, 2, word(b, 2) * 2)
                        setWord(b, 0, realloc(word(b, 0), word(b, 2)))
                    }
                    copyBytes(word(b, 0) + word(b, 1), chunk, n)
                    setWord(b, 1, word(b, 1) + n)
                } else if n == 0 or errno() != eintr {
                    let _ = cClose(fd)
                    setInt32(pfd, 2 * i, -1)
                    live -= 1
                }
            }
        }
    }
    free(chunk)
    for i in 0..2 {
        if int32At(pfd, 2 * i) >= 0 {
            let _ = cClose(int32At(pfd, 2 * i))
        }
    }
    let ws = calloc(1, 8)
    while waitpid(pid, ws, 0) < 0 and errno() == eintr {}
    if got == 4 {
        free(word(bufs, 0))
        free(word(bufs, 3))
        return cannotRun(out, name, int32At(execError, 0))
    }
    let s = int32At(ws, 0)
    let status = if s & 127 == 0 {
        s >> 8 & 255
    } else if s & 127 != 127 {
        128 + s & 127
    } else {
        -1
    }
    setWord(out, 0, status)
    setWord(out, 1, word(bufs, 0))
    setWord(out, 2, word(bufs, 1))
    setWord(out, 3, word(bufs, 3))
    setWord(out, 4, word(bufs, 4))
    0
}

// ---- code in memory, the stack, C's libraries, threads ----
pub extern effect fn osMapCodeImpl(n: Int64) -> Int64 as "qkosMapCode" {
    let p = mmap(0, n, 3, 34, -1, 0) // read, write; private, anonymous
    if p == -1 { 0 } else { p }
}

pub extern effect fn osProtectCodeImpl(p: Int64, n: Int64) as "qkosProtectCode" {
    let _ = mprotect(p, n, 5) // read, run
    clearCache(p, p + n) // ARM: the instruction cache sees the new code
}

pub extern effect fn osUnmapCodeImpl(p: Int64, n: Int64) as "qkosUnmapCode" {
    let _ = munmap(p, n)
}

// the heap's range (heap.qk): reserved with no access (MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE), made readable and writable as
// it is used
pub extern effect fn osReserveImpl(n: Int64) -> Int64 as "qkosReserve" {
    let p = mmap(0, n, 0, 16418, -1, 0)
    if p == -1 { 0 } else { p }
}

pub extern effect fn osCommitImpl(p: Int64, n: Int64) -> Int64 as "qkosCommit" =
    if mprotect(p, n, 3) == 0 { 1 } else { 0 }

pub extern effect fn osReleaseImpl(p: Int64, n: Int64) as "qkosRelease" {
    let _ = munmap(p, n)
}

pub extern effect fn osStackLowImpl() -> Int64 as "qkosStackLow" {
    let attr = calloc(1, 256)
    var low = 0
    if pthreadGetAttrNp(pthreadSelf(), attr) == 0 {
        let at = calloc(2, 8)
        let _ = pthreadAttrGetStack(attr, at, at + 8)
        let _ = pthreadAttrDestroy(attr)
        low = word(at, 0)
        free(at)
    }
    free(attr)
    low
}

fn isText(s: Int, t: Text) -> Bool = strlen(s) == len(t) and sameBytes(s, textAt(t), len(t))

fn hasPart(s: Int, t: Text) -> Bool {
    let n = strlen(s)
    var i = 0
    while i + len(t) <= n {
        if sameBytes(s + i, textAt(t), len(t)) {
            return true
        }
        i += 1
    }
    false
}

pub extern effect fn osCFunctionImpl(symbol: Int64, lib: Int64, why: Int64) -> Int64 as "qkosCFunction" {
    let cLibrary = lib == 0 or isText(lib, "c")
    var h = 0
    if cLibrary {
        h = dlopen(0, 2) // the process: the C library it links, and what it has loaded
    } else if hasPart(lib, "/") or hasPart(lib, ".so") or hasPart(lib, ".dylib") {
        h = dlopen(lib, 258)
    } else {
        let name = calloc(1, 1024)
        for form in 0..4 {
            if h == 0 {
                let b = bufAt(name, 1024).text("lib").zeroText(lib).text(".so")
                let _ = if form == 1 {
                    b.text(".6")
                } else if form == 2 {
                    b.text(".1")
                } else if form == 3 {
                    b.text(".0")
                } else {
                    b
                }
                h = dlopen(name, 258)
            }
        }
        free(name)
        if h == 0 and isText(lib, "m") {
            h = dlopen(0, 2) // libm in the C library, or linked in
        }
    }
    if h == 0 {
        let _ = bufAt(why, 512).text("cannot load the library ").zeroText(lib).text(" (lib").zeroText(lib).text(".so)")
        return 0
    }
    let f = dlsym(h, symbol)
    if f == 0 and cLibrary {
        let _ = bufAt(why, 512).text("cannot find ").zeroText(symbol).text(" in the C library")
    } else if f == 0 {
        let _ = bufAt(why, 512).text("cannot find ").zeroText(symbol).text(" in the library ").zeroText(lib)
    }
    f
}

pub extern effect fn osProcessorsImpl() -> Int64 as "qkosProcessors" {
    let n = sysconf(84) // _SC_NPROCESSORS_ONLN
    if n > 0 { n } else { 1 }
}

fn threadOf(f: Int, arg: Int, stack: Int) -> Int {
    let attr = calloc(1, 256)
    let t = calloc(1, 8)
    let _ = pthreadAttrInit(attr)
    let _ = pthreadAttrSetStackSize(attr, stack)
    let started = pthreadCreate(t, attr, f, arg) == 0
    let _ = pthreadAttrDestroy(attr)
    free(attr)
    let id = word(t, 0)
    free(t)
    if started { id } else { 0 }
}

pub extern effect fn osThreadStartImpl(f: Int64, arg: Int64) -> Int64 as "qkosThreadStart" =
    threadOf(f, arg, 67108864)

pub extern effect fn osThreadJoinImpl(h: Int64) as "qkosThreadJoin" {
    let _ = pthreadJoin(h, 0)
}

// ---- the executable's entry: on a thread of 256 MB of stack, as on Windows ----
// (argc, argv, self, status)
fn run(a: Int) -> Int {
    setWord(a, 3, qkStart(word(a, 0), word(a, 1), word(a, 2)))
    0
}

pub extern effect fn cMain(argc: Int32, argv: Int64) -> Int32 as "main" {
    let _ = pthreadKeyCreate(cell() + 8, 0)
    setWord(cell(), 1, int32At(cell() + 8, 0)) // the key, its own word
    let self = calloc(1, 4097)
    let n = readlink(textAt("/proc/self/exe\0"), self, 4096)
    let a = calloc(4, 8)
    setWord(a, 0, argc)
    setWord(a, 1, argv)
    setWord(a, 2, if n > 0 { self } else { 0 })
    setWord(a, 3, 1)
    let t = threadOf(fnAddress(x => run(x)), a, 268435456)
    if t == 0 {
        return qkStart(argc, argv, word(a, 2))
    }
    let _ = pthreadJoin(t, 0)
    word(a, 3)
}

// ---- a program run from memory (quarkimg run): the runtime mapped by the caller, on the caller's thread ----
pub extern effect fn memoryMain(argc: Int64, argv: Int64, payload: Int64, trailer: Int64) -> Int64 as "qkMemoryMain" {
    let _ = pthreadKeyCreate(cell() + 8, 0)
    setWord(cell(), 1, int32At(cell() + 8, 0))
    qkStartMemory(argc, argv, payload, trailer)
}

// ---- the command line's own runs (host.qk, compiler/memory.qk): this thread made ready for the runtime ----
pub extern effect fn hostInit() as "qkosHostInit" {
    let _ = pthreadKeyCreate(cell() + 8, 0)
    setWord(cell(), 1, int32At(cell() + 8, 0))
}

// ---- --profile: a timer signal every millisecond of the process's time, and where the thread it stops is ----
extern effect fn sigaction(sig: Int32, act: Int64, old: Int64) -> Int32
extern effect fn setitimer(which: Int32, value: Int64, old: Int64) -> Int32
extern fn handlerAddress(f: extern (Int64, Int64, Int64) -> Unit) -> Int64 as "qkTextAddress"

// SIGPROF: the stopped code's address, from the signal's ucontext (x86-64: gregs[REG_RIP]; ARM64: pc)
fn sample(context: Int) {
    let p = word(cell(), 3)
    if p == 0 or word(p, 4) >= word(p, 5) {
        return
    }
    let x64 = byte(fnAddress(x => x), 0) == 85
    setWord(word(p, 3) + 8 * sampleWords * word(p, 4), 0, word(context, if x64 { 21 } else { 55 }))
    setWord(p, 4, word(p, 4) + 1)
}

fn profileTimer(us: Int) {
    let t = calloc(4, 8)
    setWord(t, 1, us) // the interval, then the first one: seconds 0, microseconds us
    setWord(t, 3, us)
    let _ = setitimer(2, t, 0) // ITIMER_PROF
    free(t)
}

pub extern effect fn osProfileStartImpl(p: Int64) as "qkosProfileStart" {
    setWord(cell(), 3, p)
    let sa = calloc(1, 160) // a struct sigaction: the handler, the mask (128 bytes), the flags
    setWord(sa, 0, handlerAddress((sig, info, context) => sample(context)))
    setInt32(sa, 34, 268435460) // SA_SIGINFO | SA_RESTART
    let _ = sigaction(27, sa, 0) // SIGPROF
    free(sa)
    profileTimer(1000)
}

pub extern effect fn osProfileStopImpl(p: Int64) as "qkosProfileStop" {
    profileTimer(0)
    setWord(cell(), 3, 0)
}

// ---- sockets (BSD sockets), seeking, the local time ----
extern effect fn fcntl(fd: Int32, command: Int32, ...) -> Int32
extern effect fn pxSocket(family: Int32, kind: Int32, protocol: Int32) -> Int32 as "socket"
extern effect fn pxBind(s: Int32, addr: Int64, n: UInt32) -> Int32 as "bind"
extern effect fn pxListen(s: Int32, backlog: Int32) -> Int32 as "listen"
extern effect fn pxAccept(s: Int32, addr: Int64, n: Int64) -> Int32 as "accept"
extern effect fn pxConnect(s: Int32, addr: Int64, n: UInt32) -> Int32 as "connect"
extern effect fn pxRecv(s: Int32, p: Int64, n: UInt64, flags: Int32) -> Int64 as "recv"
extern effect fn pxSend(s: Int32, p: Int64, n: UInt64, flags: Int32) -> Int64 as "send"
extern effect fn pxSetOption(s: Int32, level: Int32, name: Int32, value: Int64, n: UInt32) -> Int32 as "setsockopt"
extern effect fn pxGetAddrInfo(host: Int64, service: Int64, hints: Int64, out: Int64) -> Int32 as "getaddrinfo"
extern effect fn pxFreeAddrInfo(info: Int64) as "freeaddrinfo"
extern effect fn pxGaiError(code: Int32) -> Int64 as "gai_strerror"
extern effect fn fseeko(f: Int64, at: Int64, from: Int32) -> Int32
extern effect fn ftello(f: Int64) -> Int64
extern effect fn localtimeR(t: Int64, tm: Int64) -> Int64 as "localtime_r"

const sockLevel = 1 // SOL_SOCKET
const reuseAddress = 2 // SO_REUSEADDR
const nonBlockFlag = 2048 // O_NONBLOCK
const tryAgain = 11 // EAGAIN (EWOULDBLOCK)
const sendFlags = 16384 // MSG_NOSIGNAL where there is one: a closed other end is an error, not a signal
const addrAt = 3 // ai_addr's place in an addrinfo, in words

fn netWhy(why: Int, text: Int) {
    let _ = bufAt(why, 256).zeroText(text)
}

// host:port's first IPv4 address (a sockaddr_in, 16 bytes) into addr; host 0 or "": any (to listen)
fn resolve(host: Int, port: Int, addr: Int, why: Int) -> Bool {
    let hints = calloc(48 + 24 + 8, 1) // the hints, the port's digits, the result's address
    let any = host == 0 or byte(host, 0) == 0
    setInt32(hints, 0, if any {
        1 // AI_PASSIVE
    } else {
        0
    })
    setInt32(hints, 1, 2) // AF_INET
    setInt32(hints, 2, 1) // SOCK_STREAM
    let service = bufAt(hints + 48, 24).int(port)
    let out = hints + 72
    let r = pxGetAddrInfo(if any { 0 } else { host }, service.p, hints, out)
    let found = r == 0 and word(out, 0) != 0
    if found {
        copyBytes(addr, word(word(out, 0), addrAt), 16)
        pxFreeAddrInfo(word(out, 0))
    } else {
        netWhy(why, if r != 0 { pxGaiError(r) } else { textAt("the host is not known\0") })
    }
    free(hints)
    found
}

fn nonBlocking(s: Int) {
    let flags = fcntl(s, 3) // F_GETFL
    let _ = fcntl(s, 4, flags | nonBlockFlag) // F_SETFL
}

fn socketOptions(s: Int) {
    let one = calloc(1, 8)
    setInt32(one, 0, 1)
    let _ = pxSetOption(s, sockLevel, reuseAddress, one, 4)
    free(one)
}

pub extern effect fn osListenImpl(host: Int64, port: Int64, why: Int64) -> Int64 as "qkosListen" {
    let addr = calloc(2, 8)
    if not resolve(host, port, addr, why) {
        free(addr)
        return -1
    }
    let s = pxSocket(2, 1, 0)
    if s < 0 {
        netWhy(why, strerror(osErrno()))
        free(addr)
        return -1
    }
    socketOptions(s)
    let ok = pxBind(s, addr, 16) == 0 and pxListen(s, 128) == 0
    free(addr)
    if not ok {
        netWhy(why, strerror(osErrno()))
        let _ = cClose(s)
        return -1
    }
    nonBlocking(s)
    s
}

pub extern effect fn osConnectImpl(host: Int64, port: Int64, why: Int64) -> Int64 as "qkosConnect" {
    let addr = calloc(2, 8)
    if not resolve(host, port, addr, why) {
        free(addr)
        return -1
    }
    let s = pxSocket(2, 1, 0)
    if s < 0 {
        netWhy(why, strerror(osErrno()))
        free(addr)
        return -1
    }
    socketOptions(s)
    var r = pxConnect(s, addr, 16)
    while r != 0 and osErrno() == 4 {
        r = pxConnect(s, addr, 16) // EINTR
    }
    free(addr)
    if r != 0 {
        netWhy(why, strerror(osErrno()))
        let _ = cClose(s)
        return -1
    }
    nonBlocking(s)
    s
}

pub extern effect fn osAcceptImpl(s: Int64, why: Int64) -> Int64 as "qkosAccept" {
    while true {
        let c = pxAccept(s, 0, 0)
        if c >= 0 {
            socketOptions(c)
            nonBlocking(c)
            return c
        }
        let e = osErrno()
        if e == tryAgain {
            return -1
        }
        if e != 4 {
            netWhy(why, strerror(e))
            return -2
        }
    }
    -2
}

pub extern effect fn osRecvImpl(s: Int64, p: Int64, n: Int64, why: Int64) -> Int64 as "qkosRecv" {
    while true {
        let k = pxRecv(s, p, n, 0)
        if k >= 0 {
            return k
        }
        let e = osErrno()
        if e == tryAgain {
            return -1
        }
        if e != 4 {
            netWhy(why, strerror(e))
            return -2
        }
    }
    -2
}

pub extern effect fn osSendImpl(s: Int64, p: Int64, n: Int64, why: Int64) -> Int64 as "qkosSend" {
    while true {
        let k = pxSend(s, p, n, sendFlags)
        if k >= 0 {
            return k
        }
        let e = osErrno()
        if e == tryAgain {
            return -1
        }
        if e != 4 {
            netWhy(why, strerror(e))
            return -2
        }
    }
    -2
}

pub extern effect fn osCloseSocketImpl(s: Int64) as "qkosCloseSocket" {
    let _ = cClose(s)
}

// items: (socket, write, ready) each; ready 1 for those that are (an error or a hang-up too: the next call says it)
pub extern effect fn osPollImpl(items: Int64, count: Int64, ms: Int64) -> Int64 as "qkosPoll" {
    let fds = calloc(if count > 0 {
        count // pollfd: the fd, then events and revents (shorts)
    } else {
        1
    }, 8)
    for i in 0..count {
        setInt32(fds, 2 * i, word(items, 3 * i))
        setInt32(fds, 2 * i + 1, if word(items, 3 * i + 1) != 0 {
            4 // POLLOUT, POLLIN
        } else {
            1
        })
    }
    var r = poll(fds, count, if ms < 0 { -1 } else { ms })
    while r < 0 and osErrno() == 4 {
        r = poll(fds, count, if ms < 0 { -1 } else { ms })
    }
    for i in 0..count {
        let revents = shr(int32At(fds, 2 * i + 1), 16) & 65535
        setWord(items, 3 * i + 2, if revents != 0 { 1 } else { 0 })
    }
    free(fds)
    r
}

pub extern effect fn osSeekImpl(f: Int64, at: Int64, from: Int64) -> Int64 as "qkosSeek" {
    if fseeko(f, at, from) != 0 {
        return -1
    }
    ftello(f)
}

pub extern effect fn osLocalOffsetImpl(seconds: Float64) -> Int64 as "qkosLocalOffset" {
    let t = calloc(10, 8) // the moment, then a struct tm (tm_gmtoff: its sixth word)
    setWord(t, 0, toInt(cFloor(seconds)))
    var offset = 0
    if localtimeR(t, t + 8) != 0 {
        offset = word(t + 8, 5)
    }
    free(t)
    offset
}
""" + "\n"
    }
    if name == "loader" {
        return r"""
// Loading machine code: the code and data in memory of their own, every address it needs written in (the runtime's
// functions, the data, the C functions, and this thread's cells: the budget, the escape, the panic's frame, the
// stack's limit), and calls into it through its trampoline. Then the start of a built executable (
// job): the program after this one in its own file, loaded and run.
use std.machine as machine
use base
use arena
use print

extern effect fn osMapCode(n: Int64) -> Int64 as "qkosMapCode" // writable memory for code
extern effect fn osProtectCode(p: Int64, n: Int64) as "qkosProtectCode" // ... made code: run, not written
extern effect fn osUnmapCode(p: Int64, n: Int64) as "qkosUnmapCode"
extern effect fn osStackLow() -> Int64 as "qkosStackLow" // the lowest address the thread's stack may reach, or 0

// a C function: its address, or 0 and why (in why, 512 bytes)
extern effect fn osCFunction(symbol: Int64, lib: Int64, why: Int64) -> Int64 as "qkosCFunction"

// a Loaded's words
pub const lCode = 0
pub const lCodeLen = 1
pub const lData = 2
pub const lEnter = 3
pub const lEscape = 4
pub const lSource = 6 // what another thread's copy is loaded from: code, then data
pub const lDataLen = 7
pub const lRelocs = 8
pub const lRelocCount = 9
pub const lEnterAt = 10
pub const lEscapeAt = 11
pub const lHosts = 12
pub const lHostCount = 13
pub const loadedWords = 16
const relocRuntime = 0
const relocData = 1
const relocFuel = 2
const relocHost = 3
const relocEscape = 4
const relocPanicFrame = 5
const relocStackLimit = 6

// the address a reloc stands for, on this thread
pub fn relocTarget(kind: Int, target: Int, data: Int, hosts: Int) -> Int {
    let c = ctx()
    if kind == relocRuntime {
        return word(gGet(gRuntime), target)
    }
    if kind == relocData {
        return data + target
    }
    if kind == relocFuel {
        return c + 8 * ctxFuel
    }
    if kind == relocHost {
        return if hosts != 0 { word(hosts, target) } else { 0 }
    }
    if kind == relocEscape {
        return c + 8 * ctxEscapeRsp
    }
    if kind == relocPanicFrame {
        return c + 8 * ctxPanicFrame
    }
    if kind == relocStackLimit {
        return c + 8 * ctxStackLimit
    }
    0
}

// relocs: (at: Int32, kind: Int32, target: Int64), 16 bytes each; a Loaded, or 0
pub fn load(
    code: Int,
    codeLen: Int,
    data: Int,
    dataLen: Int,
    relocs: Int,
    relocCount: Int,
    enter: Int,
    escape: Int,
    hosts: Int,
) -> Int {
    let dataCopy = malloc(dataLen + 16)
    if dataCopy == 0 {
        return 0
    }
    copyBytes(dataCopy, data, dataLen)
    let mem = osMapCode(codeLen)
    if mem == 0 {
        free(dataCopy)
        return 0
    }
    copyBytes(mem, code, codeLen)
    for i in 0..relocCount {
        let r = relocs + 16 * i
        setWord(mem + int32At(r, 0), 0, relocTarget(int32At(r, 1), word(r, 1), dataCopy, hosts))
    }
    osProtectCode(mem, codeLen)
    let l = calloc(loadedWords, 8)
    setWord(l, lCode, mem)
    setWord(l, lCodeLen, codeLen)
    setWord(l, lData, dataCopy)
    let source = malloc(codeLen + dataLen + 16)
    copyBytes(source, code, codeLen)
    copyBytes(source + codeLen, data, dataLen)
    setWord(l, lSource, source)
    let rs = malloc(16 * relocCount + 16)
    copyBytes(rs, relocs, 16 * relocCount)
    setWord(l, lRelocs, rs)
    setWord(l, lRelocCount, relocCount)
    setWord(l, lDataLen, dataLen)
    setWord(l, lEnterAt, enter)
    setWord(l, lEscapeAt, escape)
    var hostCount = 0
    for i in 0..relocCount {
        let r = relocs + 16 * i
        if int32At(r, 1) == relocHost and word(r, 1) + 1 > hostCount {
            hostCount = word(r, 1) + 1
        }
    }
    setWord(l, lHostCount, hostCount)
    let hs = calloc(if hostCount != 0 { hostCount } else { 1 }, 8)
    if hosts != 0 {
        copyBytes(hs, hosts, 8 * hostCount)
    }
    setWord(l, lHosts, hs)
    setWord(l, lEnter, mem + enter)
    setWord(l, lEscape, mem + escape)
    l
}

// another thread's copy: the same code, its addresses this thread's
pub fn loadAgain(l: Int) -> Int {
    let s = word(l, lSource)
    load(
        s,
        word(l, lCodeLen),
        s + word(l, lCodeLen),
        word(l, lDataLen),
        word(l, lRelocs),
        word(l, lRelocCount),
        word(l, lEnterAt),
        word(l, lEscapeAt),
        word(l, lHosts),
    )
}

pub fn unload(l: Int) {
    osUnmapCode(word(l, lCode), word(l, lCodeLen))
    free(word(l, lData))
    free(word(l, lSource))
    free(word(l, lRelocs))
    free(word(l, lHosts))
    free(l)
}

// the lowest address this thread's stack may reach, keeping room for the runtime (a panic prints, C calls)
fn stackLimit() -> Int {
    let room = 262144
    let here = machine.frame().address
    let taskLow = ctxGet(ctxTaskStackLow)
    if taskLow != 0 {
        return taskLow + 65536 // a task: its own stack
    }
    let low = osStackLow()
    if low != 0 and here > low + room {
        return low + room
    }
    if here > 1048576 {
        here - 1048576 + room // unknown: a megabyte from here
    } else {
        0
    }
}

// calls fn (in l's code) through the trampoline; false when it panicked (the panic text says why)
pub fn runEntry(l: Int, f: Int, args: Int, argCount: Int, results: Int, resultCount: Int) -> Bool {
    let c = ctx()
    if word(c, ctxEscapeRsp) == 0 {
        arenaReset()
    }
    setWord(c, ctxStackLimit, stackLimit())
    let savedStub = word(c, ctxEscapeStub)
    setWord(c, ctxEscapeStub, word(l, lEscape))
    setByte(panicText(), 0, 0)
    let e = malloc(40) // fn, args, argCount, results, resultCount
    setWord(e, 0, f)
    setWord(e, 1, args)
    setWord(e, 2, argCount)
    setWord(e, 3, results)
    setWord(e, 4, resultCount)
    let wasRunning = word(c, ctxRunning)
    let wasEntry = word(c, ctxRunningEntry)
    setWord(c, ctxRunning, l)
    setWord(c, ctxRunningEntry, f - word(l, lCode))
    setWord(c, ctxPanicFrame, 0)
    let stopped = machine.call(Pointer<UInt8>(word(l, lEnter)), e, 0, 0, 0)
    let c2 = ctx() // (the same thread: a task's switch leaves it as it was)
    setWord(c2, ctxEscapeStub, savedStub)
    setWord(c2, ctxRunning, wasRunning)
    setWord(c2, ctxRunningEntry, wasEntry)
    free(e)
    stopped == 0
}

pub extern effect fn qkRunEntry(
    l: Int64,
    f: Int64,
    args: Int64,
    argCount: Int64,
    results: Int64,
    resultCount: Int64,
) -> Int64 as "qkRunEntry" = if runEntry(l, f, args, argCount, results, resultCount) {
    1
} else {
    0
}
""" + "\n"
    }
    if name == "loops" {
        return r"""
// Loops: a mark at the start, and what the turns made that the vars still hold, copied out. A loop's frame: [0] the
// mark's block, [1] its used bytes, [2] what had been allocated at the mark, [3] how much may be made before the next
// collection, [4] the mark's time, [5] its generations (below), [6...] the vars' slots. Spawn copies what a task
// captured the same way.
//
// Generations: what a collection kept is old to the next one, which copies only what the turns made since (a minor
// collection), and what old values were changed to hold. When what minor collections kept since the last full one
// is as much as that one kept (16 MB at least), the next is full: everything since the mark, so garbage among the old
// values goes too, and a loop that runs for ever stays at a few times what its vars hold.
use base
use arena
use text
use map

const frameBlock = 0
const frameUsed = 1
const frameAllocated = 2
const frameLimit = 3
const frameTime = 4
const frameGen = 5
const frameRoots = 6

// a loop's first collection after 4 MB made, then after up to 16 MB (a loop that runs briefly never collects: an
// outer one takes back what it left); with a memory limit (--memory), at most a sixteenth of it, from 64 KB
const loopFirstLimit = 4194304
const nurseryMost = 16777216
const nurseryLeast = 65536

fn limited(a: Int, n: Int) -> Int {
    let budget = word(a, aLimit) / 16
    if budget == 0 or n <= budget { n } else { max(budget, nurseryLeast) }
}

// a frame's generations: the last collection's time, what minor ones kept since the last full one, what that one
// kept, the survivor block being filled (old values are copied into it, one minor collection after another)
const gLast = 0
const gPromoted = 1
const gLive = 2
const gBlock = 3
const gArena = 4 // the arena the loop allocates in: its turns' check reads what it made (compiler/lower.qk)
const genWords = 5

pub extern effect fn rtLoopStart(rootSlots: Int64) -> Int64 as "qk_loopStart" {
    let a = arena()
    if word(a, aCurrent) == 0 {
        let _ = alloc(1, 16) // a block to mark (the first allocations may all have been large)
    }
    let f = alloc(frameRoots + rootSlots, 8)
    let gen = alloc(genWords, 8)
    setWord(f, frameGen, gen)
    let cur = word(a, aCurrent)
    setWord(f, frameBlock, cur)
    setWord(f, frameUsed, word(cur, bUsed))
    setWord(f, frameAllocated, word(a, aAllocated))
    setWord(f, frameLimit, limited(a, loopFirstLimit))
    setWord(a, aClock, word(a, aClock) + 1)
    setWord(f, frameTime, word(a, aClock))
    setWord(gen, gLast, word(a, aClock))
    setWord(gen, gArena, a)
    setMark(a, cur, word(cur, bUsed))
    f
}

pub extern effect fn rtLoopCheck(f: Int64) -> Int64 as "qk_loopCheck" = if word(arena(), aAllocated) - word(
    f,
    frameAllocated,
) > word(f, frameLimit) {
    1
} else {
    0
}

// ---- the copier's words ----
const cA = 0
const cTime = 1
const cNow = 2 // the survivor being filled
const cTotal = 3 // bytes copied, and of large blocks kept and looked into
const cMoved = 4 // (from, length, kind, to): what was copied already, by address
const cMovedCap = 5
const cMovedCount = 6
pub const cPending = 7 // (slots, shape): boxes copied, their insides not yet
pub const cPendingCount = 8
pub const cPendingCap = 9
const cYoung = 10 // (lo, hi, large block or 0): what the turns made, by address, sorted
const cYoungCount = 11
const cYoungCap = 12
const cAll = 13
const cRooms = 14 // (address, bytes): copies that keep their room to grow
const cRoomCount = 15
const cRoomCap = 16
const cMade = 17 // bytes of the survivor blocks made (a block twice the last, from 64 KB up to 1 MB)
const cShapes = 18 // (description, base, kind, shape): the shapes worked out, open addressing
const cShapeCap = 19
const cShapeCount = 20
const cShapesMade = 21 // every shape made, to free
const cFromData = 22 // copying out of another thread's copy of the program: its data, where a map's description is
const cDataLen = 23
const cToData = 24 // ... and this program's, where the copy's description goes
const cSides = 25 // for each young range (as cYoung is sorted), its side table or 0 (movedSlot)
const cLastRange = 26 // the young range youngAt found last (the next address is most often in it too), or 0
const copierWords = 27

pub fn copierNew(a: Int, time: Int) -> Int {
    let c = calloc(copierWords, 8)
    setWord(c, cA, a)
    setWord(c, cTime, time)
    c
}

pub fn freeCopier(c: Int) {
    forgetSides(c)
    free(word(c, cPending))
    free(word(c, cMoved))
    free(word(c, cYoung))
    free(word(c, cRooms))
    var s = word(c, cShapesMade)
    while s != 0 {
        let next = word(s, sNextMade)
        free(word(s, sPtrs))
        free(word(s, sCaseFrom))
        free(s)
        s = next
    }
    free(word(c, cShapes))
    free(c)
}

// a list of n-word items in the copier: listAt, countAt, capAt are its words
pub fn grow(c: Int, listAt: Int, countAt: Int, capAt: Int, words: Int) -> Int {
    if word(c, countAt) == word(c, capAt) {
        let cap = if word(c, capAt) != 0 { word(c, capAt) * 2 } else { 16 }
        setWord(c, listAt, realloc(word(c, listAt), cap * 8 * words))
        setWord(c, capAt, cap)
    }
    let at = word(c, listAt) + 8 * words * word(c, countAt)
    setWord(c, countAt, word(c, countAt) + 1)
    at
}

// ---- shapes: where a type's values point, worked out once from its description ----
// A shape's words: its slots, its pointers (count, room, the list: ptrWords each), an enum's cases and where each
// one's pointers start (cases + 1 of them: the tag at slot 0), where its description ends, the next shape made.
pub const sSlots = 0
pub const sCount = 1
const sCap = 2
pub const sPtrs = 3
pub const sCases = 4
pub const sCaseFrom = 5
pub const sEnd = 6
const sNextMade = 7
const shapeWords = 8

// a pointer's words: its slot, its kind (T A M B C E P), the description of what it holds (A: the element's; B, P: the
// type's), the whole description that one's references count from, and the shape (E: the enum's; A, B, P: the
// element's, once worked out)
pub const pAt = 0
pub const pKind = 1
pub const pDesc = 2
pub const pBase = 3
pub const pSub = 4
pub const ptrWords = 5

fn descRefIn(d: Int, base: Int) -> Int {
    var at = 0
    for i in 0..3 {
        at = at * 64 + byte(d, i) - '0'
    }
    base + at
}

fn shapeAdd(s: Int, at: Int, kind: Int, desc: Int, base: Int, sub: Int) {
    if word(s, sCount) == word(s, sCap) {
        let cap = if word(s, sCap) != 0 { word(s, sCap) * 2 } else { 4 }
        setWord(s, sPtrs, realloc(word(s, sPtrs), cap * 8 * ptrWords))
        setWord(s, sCap, cap)
    }
    let q = word(s, sPtrs) + 8 * ptrWords * word(s, sCount)
    setWord(q, pAt, at)
    setWord(q, pKind, kind)
    setWord(q, pDesc, desc)
    setWord(q, pBase, base)
    setWord(q, pSub, sub)
    setWord(s, sCount, word(s, sCount) + 1)
}

fn shapeMake(c: Int) -> Int {
    let s = calloc(shapeWords, 8)
    setWord(s, sNextMade, word(c, cShapesMade))
    setWord(c, cShapesMade, s)
    s
}

// one type at d laid into s from slot at: its slot count, and where its description ends (descBase is base)
fn shapeLay(c: Int, s: Int, at: Int, d0: Int, base: Int) -> Desc {
    let k = byte(d0, 0)
    let d = d0 + 1
    if k == 'T' {
        shapeAdd(s, at, 'T', 0, base, 0)
        return Desc(2, d)
    }
    if k == 'A' {
        shapeAdd(s, at, 'A', d, base, 0)
        return Desc(2, skipDesc(d))
    }
    if k == 'M' {
        shapeAdd(s, at, 'M', d0, base, 0)
        return Desc(1, skipDesc(skipDesc(d)))
    }
    if k == 'B' or k == 'P' {
        shapeAdd(s, at, k, d, base, 0)
        return Desc(1, skipDesc(d))
    }
    if k == 'C' {
        shapeAdd(s, at, 'C', 0, base, 0)
        return Desc(1, d)
    }
    if k == 'R' {
        return Desc(shapeLay(c, s, at, descRefIn(d, base), base).n, d + 3)
    }
    if k == '(' {
        var n = 0
        var q = d
        while byte(q, 0) != ')' {
            let f = shapeLay(c, s, at + n, q, base)
            n += f.n
            q = f.d
        }
        return Desc(n, q + 1)
    }
    if k == 'E' {
        let e = shapeMake(c)
        let cases = byte(d, 0) - 32
        setWord(e, sCases, cases)
        let from = malloc(8 * (cases + 1))
        setWord(e, sCaseFrom, from)
        let n = descNumber(d + 1) // then each case: where its data starts, its fields, '.'
        var q = d + 4
        for i in 0..cases {
            setWord(from, i, word(e, sCount))
            var slot = descNumber(q)
            q += 3
            while byte(q, 0) != '.' {
                let f = shapeLay(c, e, slot, q, base)
                slot += f.n
                q = f.d
            }
            q += 1 // the case's end
        }
        setWord(from, cases, word(e, sCount))
        setWord(e, sSlots, n)
        if word(e, sCount) > 0 {
            shapeAdd(s, at, 'E', 0, base, e)
        }
        return Desc(n, q)
    }
    Desc(1, d) // I, F
}

fn shapeHash(d: Int, base: Int, kind: Int) -> Int = mix(d ^ base * 31 ^ kind)

// the shape of the type at d (kind 0), or of the types from d to its end (kind 'S': a frame's vars, from slot 0;
// kind 'C': a closure's captured values, from slot 1)
pub fn shapeOf(c: Int, d: Int, base: Int, kind: Int) -> Int {
    if word(c, cShapeCount) * 2 >= word(c, cShapeCap) {
        let cap = if word(c, cShapeCap) != 0 { word(c, cShapeCap) * 2 } else { 64 }
        let grown = calloc(cap, 32)
        let old = word(c, cShapes)
        for i in 0..word(c, cShapeCap) {
            let e = old + 32 * i
            if word(e, 0) != 0 {
                var k = shapeHash(word(e, 0), word(e, 1), word(e, 2)) & (cap - 1)
                while word(grown, 4 * k) != 0 {
                    k = (k + 1) & (cap - 1)
                }
                copyBytes(grown + 32 * k, e, 32)
            }
        }
        free(old)
        setWord(c, cShapes, grown)
        setWord(c, cShapeCap, cap)
    }
    let table = word(c, cShapes)
    let mask = word(c, cShapeCap) - 1
    var k = shapeHash(d, base, kind) & mask
    while word(table, 4 * k) != 0 {
        let e = table + 32 * k
        if word(e, 0) == d and word(e, 1) == base and word(e, 2) == kind {
            return word(e, 3)
        }
        k = (k + 1) & mask
    }
    let saved = descBase()
    setDescBase(base)
    let s = shapeMake(c)
    if kind != 0 {
        var n = if kind == 'C' { 1 } else { 0 }
        var q = d
        while byte(q, 0) != 0 {
            let f = shapeLay(c, s, n, q, base)
            n += f.n
            q = f.d
        }
        setWord(s, sSlots, n)
        setWord(s, sEnd, q)
    } else {
        let f = shapeLay(c, s, 0, d, base)
        setWord(s, sSlots, f.n)
        setWord(s, sEnd, f.d)
    }
    setDescBase(saved)
    let e = table + 32 * k
    setWord(e, 0, d)
    setWord(e, 1, base)
    setWord(e, 2, kind)
    setWord(e, 3, s)
    setWord(c, cShapeCount, word(c, cShapeCount) + 1)
    s
}

// ---- what the turns made: ranges by address ----
// the range p is in (its address: lo, hi, large block or 0), or 0
fn youngAt(c: Int, p: Int) -> Int {
    let last = word(c, cLastRange)
    if last != 0 and not below(p, word(last, 0)) and below(p, word(last, 1)) {
        return last
    }
    let r = youngSearch(c, p)
    if r != 0 {
        setWord(c, cLastRange, r)
    }
    r
}

fn youngSearch(c: Int, p: Int) -> Int {
    let young = word(c, cYoung)
    var lo = 0
    var hi = word(c, cYoungCount)
    while lo < hi {
        let mid = (lo + hi) / 2
        let r = young + 24 * mid
        if below(p, word(r, 0)) {
            hi = mid
        } else if not below(p, word(r, 1)) {
            lo = mid + 1
        } else {
            return r
        }
    }
    0
}

fn isYoung(c: Int, p: Int) -> Bool = word(c, cAll) != 0 or youngAt(c, p) != 0

// made by the turns and not kept: a large block the collection reached stays
fn goneAt(c: Int, p: Int) -> Bool {
    let r = youngAt(c, p)
    r != 0 and (word(r, 2) == 0 or word(word(r, 2), bigMarked) == 0)
}

// the large block of the turns' that p is in (not when copying everything), or 0
fn largeAt(c: Int, p: Int) -> Int {
    if word(c, cAll) != 0 {
        return 0
    }
    let r = youngAt(c, p)
    if r != 0 { word(r, 2) } else { 0 }
}

fn addYoung(c: Int, lo: Int, hi: Int, large: Int) {
    if lo >= hi {
        return
    }
    setWord(c, cLastRange, 0) // the list may move
    let at = grow(c, cYoung, cYoungCount, cYoungCap, 3)
    setWord(at, 0, lo)
    setWord(at, 1, hi)
    setWord(at, 2, large)
}

fn sortYoung(c: Int) {
    setWord(c, cLastRange, 0)
    // by low address: an insertion sort
    let y = word(c, cYoung)
    for i in 1..word(c, cYoungCount) {
        let lo = word(y, 3 * i)
        let hi = word(y, 3 * i + 1)
        let large = word(y, 3 * i + 2)
        var j = i
        while j > 0 and below(lo, word(y, 3 * (j - 1))) {
            copyBytes(y + 24 * j, y + 24 * (j - 1), 24)
            j -= 1
        }
        setWord(y, 3 * j, lo)
        setWord(y, 3 * j + 1, hi)
        setWord(y, 3 * j + 2, large)
    }
}

fn survive(c: Int, bytes0: Int) -> Int {
    var bytes = align16(bytes0)
    if bytes == 0 {
        bytes = 16
    }
    if bytes >= largeFrom {
        // a large block of its own, made now: the next collection keeps it in place
        setWord(c, cMade, word(c, cMade) + bytes)
        setWord(c, cTotal, word(c, cTotal) + bytes)
        return word(largeNew(word(c, cA), bytes, word(c, cTime)), bigData)
    }
    var now = word(c, cNow)
    if now == 0 or word(now, xUsed) + bytes > word(now, xSize) {
        // small blocks first: an inner loop that keeps a little, collected at each call, makes a little
        var step = if now != 0 { word(now, xSize) * 2 } else { 65536 }
        if step > 1048576 {
            step = 1048576
        }
        let size = if bytes > step { bytes } else { step }
        let x = calloc(1, size + 64)
        if x == 0 {
            panicNow(panicSize, 0, bytes, 0)
        }
        setWord(x, xSize, size)
        setWord(x, xTime, word(c, cTime))
        setWord(x, xData, align16(x + 40))
        let a = word(c, cA)
        setWord(x, xNext, word(a, aExtras))
        setWord(a, aExtras, x)
        setWord(c, cNow, x)
        setWord(c, cMade, word(c, cMade) + size)
        now = x
    }
    let p = word(now, xData) + word(now, xUsed)
    setWord(now, xUsed, word(now, xUsed) + bytes)
    setWord(c, cTotal, word(c, cTotal) + bytes)
    p
}

fn keepRoom(c: Int, p: Int, bytes: Int) {
    let at = grow(c, cRooms, cRoomCount, cRoomCap, 2)
    setWord(at, 0, p)
    setWord(at, 1, bytes)
}

// the place of (from, length, kind) in the moved table: its `to` word's address, and whether it was there
type Slot { to: Int, found: Bool }

fn movedHash(from: Int, n: Int, kind: Int) -> Int = mix(from ^ n * 31 ^ kind)

// The young ranges' side table: 16 bytes for each 16 of a range, (to, (n * 256 + kind) * 16 + epoch) of what was
// copied from the address there. Blocks are copied mostly in the order they were made, so it is walked in order (a
// hash table's places are scattered over all of it: a cache miss each). One for the arena, kept from a collection to
// the next: an entry of an earlier collection (another epoch) is empty, so it is cleared once in 15. cSides: each
// range's offset in it (-1: none, past 64 MB).
const sideMost = 67108864

fn sideSlot(c: Int, from: Int, n: Int, kind: Int) -> Slot? {
    if from & 15 != 0 or word(c, cAll) != 0 {
        return None
    }
    let r = youngAt(c, from)
    if r == 0 {
        return None
    }
    if word(c, cSides) == 0 {
        sidesStart(c)
    }
    let i = (r - word(c, cYoung)) / 24
    let off = word(word(c, cSides), i)
    if off < 0 {
        return None
    }
    let a = word(c, cA)
    let e = word(a, aSide) + off + shr(from - word(r, 0), 4) * 16
    let epoch = word(a, aSideEpoch)
    let key = (n * 256 + kind) * 16 + epoch
    let had = word(e, 1)
    if had & 15 != epoch {
        setWord(e, 1, key) // empty (another collection's)
        return Some(Slot(e, false))
    }
    if had == key {
        return Some(Slot(e, true))
    }
    None // another length from the same address (a slice): the hash table
}

// each young range's place in the arena's side table (grown if it is too small), and this collection's epoch
fn sidesStart(c: Int) {
    let a = word(c, cA)
    let count = word(c, cYoungCount)
    let offsets = calloc(count + 1, 8)
    setWord(c, cSides, offsets)
    var total = 0
    for i in 0..count {
        let r = word(c, cYoung) + 24 * i
        let size = word(r, 1) - word(r, 0)
        if size > sideMost {
            setWord(offsets, i, -1)
        } else {
            setWord(offsets, i, total)
            total += (size / 16 + 1) * 16
        }
    }
    var epoch = word(a, aSideEpoch) + 1
    if total > word(a, aSideBytes) {
        free(word(a, aSide))
        let bytes = max(total, 2 * word(a, aSideBytes))
        setWord(a, aSide, calloc(bytes, 1))
        setWord(a, aSideBytes, bytes)
        epoch = 1
    } else if epoch == 16 {
        zeroBytes(word(a, aSide), word(a, aSideBytes)) // every epoch used: cleared, and the first again
        epoch = 1
    }
    setWord(a, aSideEpoch, epoch)
}

// what was copied forgotten: the next copy is of another epoch
fn forgetSides(c: Int) {
    if word(c, cSides) != 0 {
        free(word(c, cSides))
        setWord(c, cSides, 0)
    }
}

fn movedSlot(c: Int, from: Int, n: Int, kind: Int) -> Slot {
    if sideSlot(c, from, n, kind) is Some(s) {
        return s
    }
    if word(c, cMovedCount) * 2 >= word(c, cMovedCap) {
        let cap = if word(c, cMovedCap) != 0 { word(c, cMovedCap) * 2 } else { 1024 }
        let grown = calloc(cap, 32)
        let old = word(c, cMoved)
        for i in 0..word(c, cMovedCap) {
            let m = old + 32 * i
            if word(m, 0) != 0 {
                var k = movedHash(word(m, 0), word(m, 1), word(m, 2)) & (cap - 1)
                while word(grown, 4 * k) != 0 {
                    k = (k + 1) & (cap - 1)
                }
                copyBytes(grown + 32 * k, m, 32)
            }
        }
        free(old)
        setWord(c, cMoved, grown)
        setWord(c, cMovedCap, cap)
    }
    let table = word(c, cMoved)
    let mask = word(c, cMovedCap) - 1
    var k = movedHash(from, n, kind) & mask
    while word(table, 4 * k) != 0 {
        let m = table + 32 * k
        if word(m, 0) == from and word(m, 1) == n and word(m, 2) == kind {
            return Slot(m + 24, true)
        }
        k = (k + 1) & mask
    }
    let m = table + 32 * k
    setWord(m, 0, from)
    setWord(m, 1, n)
    setWord(m, 2, kind)
    setWord(m, 3, 0)
    setWord(c, cMovedCount, word(c, cMovedCount) + 1)
    Slot(m + 24, false)
}

// the insides of a map: its entries' keys and values
fn copyEntries(c: Int, n: Int) {
    let desc = word(n, mDesc)
    let key = shapeOf(c, desc + 1, desc, 0)
    let value = shapeOf(c, word(key, sEnd), desc, 0)
    if word(key, sCount) == 0 and word(value, sCount) == 0 {
        return
    }
    for i in 0..word(n, mUsed) {
        let e = entryAt(n, i)
        if word(e, 0) != 0 {
            copyShape(c, e + 8, key)
            copyShape(c, e + 8 + 8 * word(n, mKeySlots), value)
        }
    }
}

fn copyMapInto(c: Int, slot: Int) {
    let m = word(slot, 0)
    if m == 0 or not isYoung(c, m) {
        return
    }
    let to = movedSlot(c, m, 0, 'M')
    if to.found {
        setWord(slot, 0, word(to.to, 0))
        return
    }
    let n = survive(c, 8 * mapWords)
    setWord(to.to, 0, n)
    setWord(slot, 0, n)
    copyBytes(n, m, 8 * mapWords)
    let d = word(n, mDesc)
    if word(c, cDataLen) != 0 and d >= word(c, cFromData) and d < word(c, cFromData) + word(c, cDataLen) {
        setWord(n, mDesc, d - word(c, cFromData) + word(c, cToData))
    }
    setWord(n, mCap, if word(m, mCount) != 0 { word(m, mCount) } else { 1 })
    setWord(n, mUsed, 0)
    setWord(n, mEntries, survive(c, word(n, mCap) * entryBytes(m)))
    for i in 0..word(m, mUsed) {
        let e = entryAt(m, i)
        if word(e, 0) != 0 {
            copyBytes(entryAt(n, word(n, mUsed)), e, entryBytes(m))
            setWord(n, mUsed, word(n, mUsed) + 1)
        }
    }
    setWord(n, mCount, word(n, mUsed))
    copyEntries(c, n)
    var tableCap = 16
    while tableCap < word(n, mUsed) * 2 {
        tableCap *= 2
    }
    setWord(n, mTableCap, tableCap)
    setWord(n, mTable, survive(c, tableCap * 8))
    zeroBytes(word(n, mTable), tableCap * 8)
    for i in 0..word(n, mUsed) {
        mapPlace(n, i)
    }
}

fn copyText(c: Int, slots: Int) {
    let n = word(slots, 1)
    let p = word(slots, 0)
    if n <= 0 or p == 0 or not isYoung(c, p) and not isYoung(c, p + n - 1) {
        // from before the mark: it stays
        return
    }
    let large = largeAt(c, p)
    if large != 0 {
        // a long text: it stays where it is
        setWord(large, bigMarked, 1)
        return
    }
    let to = movedSlot(c, p, n, 'T')
    if not to.found {
        let room = textRoom(word(c, cA), p, n)
        let q = survive(c, if room > n + 8 { room } else { n + 8 })
        setWord(q, 0, n)
        copyBytes(q + 8, p, n)
        if room > n + 8 {
            keepRoom(c, q, room)
        }
        setWord(to.to, 0, q + 8)
    }
    setWord(slots, 0, word(to.to, 0))
}

fn copyArray(c: Int, slots: Int, elem: Int) {
    let each = word(elem, sSlots) * 8
    let n = word(slots, 1)
    if n <= 0 or word(slots, 0) == 0 {
        // nothing to keep: not an address the arena may give out again
        setWord(slots, 0, ctx() + 8 * ctxScratch + 120) // a word nothing writes
        return
    }
    let from = word(slots, 0)
    if not isYoung(c, from) {
        return
    }
    let to = movedSlot(c, from, n, 'A')
    if to.found {
        setWord(slots, 0, word(to.to, 0))
        return
    }
    var p = from
    let large = largeAt(c, from)
    if large != 0 {
        // a long array: it stays where it is (with its room), and only what it holds is copied
        if word(large, bigMarked) == 0 and word(elem, sCount) > 0 {
            setWord(c, cTotal, word(c, cTotal) + word(large, bigSize))
        }
        setWord(large, bigMarked, 1)
    } else {
        var room = growingRoom(word(c, cA), from)
        if room < n * each {
            room = 0
        }
        p = survive(c, if room != 0 { room } else { n * each })
        copyBytes(p, from, n * each)
        if room != 0 {
            keepRoom(c, p, room)
        }
        setWord(slots, 0, p)
    }
    setWord(to.to, 0, p) // before the elements: the table may grow while they are copied
    if word(elem, sCount) > 0 {
        for i in 0..n {
            copyShape(c, p + i * each, elem)
        }
    }
}

fn copyBox(c: Int, slots: Int, inner: Int) {
    let from = word(slots, 0)
    if from == 0 or not isYoung(c, from) {
        return
    }
    let n = word(inner, sSlots)
    let to = movedSlot(c, from, n, 'B')
    if to.found {
        setWord(slots, 0, word(to.to, 0))
        return
    }
    let p = survive(c, n * 8)
    copyBytes(p, from, n * 8)
    setWord(slots, 0, p)
    setWord(to.to, 0, p)
    if word(inner, sCount) == 0 {
        return
    }
    let at = grow(c, cPending, cPendingCount, cPendingCap, 2)
    setWord(at, 0, p)
    setWord(at, 1, inner)
}

// a lambda's captured values: [their description][their slots], copied, then copied into
fn copyClosure(c: Int, slots: Int) {
    let from = word(slots, 0)
    if from == 0 or not isYoung(c, from) {
        return
    }
    let desc = word(from, 0)
    let s = shapeOf(c, desc, desc, 'C')
    let n = word(s, sSlots)
    let to = movedSlot(c, from, n, 'C')
    if to.found {
        setWord(slots, 0, word(to.to, 0))
        return
    }
    let p = survive(c, n * 8)
    copyBytes(p, from, n * 8)
    setWord(slots, 0, p)
    setWord(to.to, 0, p)
    copyShape(c, p, s)
}

// copies what slot q (a pointer's words) of a value at slots points to when the turns made it, and points it at the copy
fn copyPtr(c: Int, slots: Int, q: Int) {
    let at = slots + 8 * word(q, pAt)
    let k = word(q, pKind)
    if k == 'T' {
        copyText(c, at)
    } else if k == 'A' {
        if word(q, pSub) == 0 {
            setWord(q, pSub, shapeOf(c, word(q, pDesc), word(q, pBase), 0))
        }
        copyArray(c, at, word(q, pSub))
    } else if k == 'M' {
        copyMapInto(c, at)
    } else if k == 'B' {
        if word(q, pSub) == 0 {
            setWord(q, pSub, shapeOf(c, word(q, pDesc), word(q, pBase), 0))
        }
        copyBox(c, at, word(q, pSub))
    } else if k == 'C' {
        copyClosure(c, at)
    } else if k == 'P' {
        // a var in memory: what it holds, there
        if word(q, pSub) == 0 {
            setWord(q, pSub, shapeOf(c, word(q, pDesc), word(q, pBase), 0))
        }
        if word(at, 0) != 0 {
            copyShape(c, word(at, 0), word(q, pSub))
        }
    } else if k == 'E' {
        // the pointers of the case the tag says
        let e = word(q, pSub)
        let tag = word(at, 0)
        if tag >= 0 and tag < word(e, sCases) {
            let from = word(e, sCaseFrom)
            for j in word(from, tag)..word(from, tag + 1) {
                copyPtr(c, at, word(e, sPtrs) + 8 * ptrWords * j)
            }
        }
    }
}

// copies what the slots point to (as the shape says) when the turns made it, and points them at the copies
fn copyShape(c: Int, slots: Int, s: Int) {
    let ptrs = word(s, sPtrs)
    for i in 0..word(s, sCount) {
        copyPtr(c, slots, ptrs + 8 * ptrWords * i)
    }
}

fn copyPending(c: Int) {
    while word(c, cPendingCount) > 0 {
        // the boxes' insides, one after another
        setWord(c, cPendingCount, word(c, cPendingCount) - 1)
        let w = word(c, cPending) + 16 * word(c, cPendingCount)
        copyShape(c, word(w, 0), word(w, 1))
    }
}

// the vars' values in the frame, as desc describes them
fn copyRoots(c: Int, slots: Int, desc: Int) {
    copyShape(c, slots, shapeOf(c, desc, desc, 'S'))
    copyPending(c)
}

// a container from before the mark that the loop changed in place: what it holds that the turns made, copied
fn lookAgain(c: Int, r: Int, since: Int) {
    let desc = word(r, rDesc)
    if byte(desc, 0) == 'A' {
        let elem = shapeOf(c, desc + 1, desc, 0)
        var cards = shr(word(r, rLen) + 15, cardShift)
        if cards > word(r, rCardCap) {
            cards = word(r, rCardCap)
        }
        if word(elem, sCount) > 0 {
            let each = 8 * word(elem, sSlots)
            for k in 0..cards {
                // the cards written since
                if word(word(r, rCards), k) < since {
                    continue
                }
                var i = k * 16
                while i < k * 16 + 16 and i < word(r, rLen) {
                    copyShape(c, word(r, rPtr) + i * each, elem)
                    i += 1
                }
                setWord(c, cTotal, word(c, cTotal) + 16 * each) // looked into: the next collection waits as long
            }
        }
    } else {
        let m = word(r, rPtr)
        if word(m, mEntries) != 0 and isYoung(c, word(m, mEntries)) {
            let e = survive(c, word(m, mCap) * entryBytes(m))
            copyBytes(e, word(m, mEntries), word(m, mUsed) * entryBytes(m))
            setWord(m, mEntries, e)
        }
        if word(m, mTable) != 0 and isYoung(c, word(m, mTable)) {
            let t = survive(c, word(m, mTableCap) * 8)
            copyBytes(t, word(m, mTable), word(m, mTableCap) * 8)
            setWord(m, mTable, t)
        }
        copyEntries(c, m)
        setWord(c, cTotal, word(c, cTotal) + word(m, mUsed) * entryBytes(m))
    }
    copyPending(c)
}

// the loop's turns made enough: what its vars hold of that, to a survivor, and the arena back to the mark
pub extern effect fn rtLoopCollect(f: Int64, desc: Int64) as "qk_loopCollect" {
    let a = arena()
    let gen = word(f, frameGen)
    let full = word(gen, gPromoted) >= max(word(gen, gLive), limited(a, nurseryMost))
    // young: made at this time or later (a full collection: since the mark)
    let since = if full { word(f, frameTime) } else { word(gen, gLast) }
    setWord(a, aClock, word(a, aClock) + 1)
    let c = copierNew(a, word(a, aClock))
    if not full {
        setWord(c, cNow, word(gen, gBlock)) // old values go on where the last ones went
    }
    let mark = word(f, frameBlock)
    let used = word(f, frameUsed)
    var b = mark
    while b != 0 {
        addYoung(c, if b == mark { word(b, bData) + used } else { word(b, bData) }, word(b, bData) + word(b, bSize), 0)
        b = word(b, bNext)
    }
    var x = word(a, aExtras)
    while x != 0 and word(x, xTime) >= since {
        // survivors of inner loops' collections (and, when full, of this loop's): the list is newest first
        addYoung(c, word(x, xData), word(x, xData) + word(x, xSize), 0)
        x = word(x, xNext)
    }
    var lb = word(a, aLarge)
    while lb != 0 and word(lb, bigTime) >= since {
        // large blocks made since: the list is newest first
        addYoung(c, word(lb, bigData), word(lb, bigData) + word(lb, bigSize), lb)
        lb = word(lb, bigNext)
    }
    sortYoung(c)
    copyRoots(c, f + 8 * frameRoots, desc)
    let cap = word(a, aRememberedCap)
    for i in 0..cap {
        let r = word(a, aRemembered) + 8 * rememberedWords * i
        if word(r, rPtr) != 0 and word(r, rTime) >= since and not isYoung(c, word(r, rPtr)) {
            lookAgain(c, r, since)
        }
    }
    // what goes: its rooms and remembered containers are forgotten (a large block kept keeps its room)
    var kept = 0
    for i in 0..word(a, aRememberedCap) {
        let r = word(a, aRemembered) + 8 * rememberedWords * i
        if word(r, rPtr) != 0 and isYoung(c, word(r, rPtr)) {
            setWord(r, rPtr, 0)
            free(word(r, rCards))
            setWord(r, rCards, 0)
            setWord(r, rCardCap, 0)
        } else if word(r, rPtr) != 0 {
            kept += 1
        }
    }
    if kept != word(a, aRememberedCount) {
        setWord(a, aRememberedCount, kept)
        rememberedGrow(a, word(a, aRememberedCap)) // the same size, without the holes
    }
    let growing = word(a, aGrowing)
    for i in 0..growingSlots(a) {
        let p = word(growing, 2 * i)
        if p != 0 and goneAt(c, p) {
            setWord(growing, 2 * i, 0)
        }
    }
    var gone = freeExtras(a, since - 1, word(c, cTime)) // inner loops' survivors (and, when full, this loop's)
    gone += freeLarge(a, since, word(c, cTime)) // (those made now hold what was copied)
    gone += word(mark, bUsed) - used
    var after = word(mark, bNext)
    while after != 0 and word(after, bUsed) != 0 {
        gone += word(after, bUsed)
        after = word(after, bNext)
    }
    setWord(a, aAllocated, word(a, aAllocated) + word(c, cMade) - gone) // what the arena holds now: an outer loop counts only what this one kept
    resetTo(a, mark, used)
    setMark(a, mark, used)
    setWord(a, aLastText, 0)
    for i in 0..word(c, cRoomCount) {
        let r = word(c, cRooms) + 16 * i
        growingAdd(a, word(r, 0), word(r, 1))
    }
    if full {
        setWord(gen, gLive, word(c, cTotal))
        setWord(gen, gPromoted, 0)
    } else {
        setWord(gen, gPromoted, word(gen, gPromoted) + word(c, cTotal))
    }
    setWord(gen, gBlock, word(c, cNow))
    setWord(a, aClock, word(a, aClock) + 1) // what is made from now on is younger than what was kept
    setWord(gen, gLast, word(a, aClock))
    setWord(f, frameAllocated, word(a, aAllocated))
    // the next one after twice what this one copied, the turns' own making growing to 16 MB (each collection looks
    // through tables of a fixed size: they run no more often than that)
    setWord(f, frameLimit, max(2 * word(c, cTotal), min(2 * word(f, frameLimit), limited(a, nurseryMost))))
    freeCopier(c)
}

// A copier of values, with all they point to, into arena to (copyValue for each, then copierDone). A map's description
// in [fromData, fromData + dataLen) (another thread's copy of the program, unloaded after) is moved to the same place
// in toData.
pub fn copierInto(to: Int, fromData: Int, dataLen: Int, toData: Int) -> Int {
    setWord(to, aClock, word(to, aClock) + 1)
    let c = copierNew(to, word(to, aClock))
    setWord(c, cAll, 1)
    setWord(c, cFromData, fromData)
    setWord(c, cDataLen, dataLen)
    setWord(c, cToData, toData)
    c
}

// the value at slots (desc: an array of its type's description), copied, and the slots pointed at the copy
pub fn copyValue(c: Int, slots: Int, desc: Int) {
    copyShape(c, slots, shapeOf(c, desc + 1, desc, 0))
    copyPending(c)
}

// what was copied is forgotten: its addresses may hold other values from now on (a thread's memory cleared)
pub fn copierForget(c: Int) {
    forgetSides(c)
    if word(c, cMovedCount) != 0 {
        zeroBytes(word(c, cMoved), 32 * word(c, cMovedCap))
        setWord(c, cMovedCount, 0)
    }
}

pub fn copierDone(c: Int) {
    let to = word(c, cA)
    setWord(to, aAllocated, word(to, aAllocated) + word(c, cMade))
    freeCopier(c)
}

// a task's own copy of what its function captured (env: [description][slots]), in the task's arena
pub fn copyIntoArena(to: Int, env: Int) -> Int {
    if env == 0 {
        return 0
    }
    setWord(to, aClock, word(to, aClock) + 1)
    let c = copierNew(to, word(to, aClock))
    setWord(c, cAll, 1)
    let cell = ctx() + 8 * ctxScratch + 112
    setWord(cell, 0, env)
    copyClosure(c, cell)
    copyPending(c)
    freeCopier(c)
    word(cell, 0)
}
""" + "\n"
    }
    if name == "macos" {
        return r"""
// The runtime's system calls on macOS (x86-64 and Apple Silicon): libSystem (POSIX, pthreads, dlopen), each behind
// a symbol of the runtime's own (qkos*, C's calls; linux.qk and windows.qk give the same ones), and the executable's
// entry: an executable carries its program in its own data (compiler/image.qk's machoImage), so nothing is read back
// from its file. Code made while running goes into MAP_JIT memory, writable on this thread until it is protected.
use std.machine as machine
use base
use start
use host

extern effect fn pthreadKeyCreate(key: Int64, destructor: Int64) -> Int32 as "pthread_key_create"
extern effect fn pthreadGetSpecific(key: UInt64) -> Int64 as "pthread_getspecific"
extern effect fn pthreadSetSpecific(key: UInt64, v: Int64) -> Int32 as "pthread_setspecific"
extern effect fn pthreadSelf() -> Int64 as "pthread_self"
extern effect fn pthreadStackTop(t: Int64) -> Int64 as "pthread_get_stackaddr_np"
extern effect fn pthreadStackSize(t: Int64) -> UInt64 as "pthread_get_stacksize_np"
extern effect fn pthreadAttrInit(attr: Int64) -> Int32 as "pthread_attr_init"
extern effect fn pthreadAttrSetStackSize(attr: Int64, size: UInt64) -> Int32 as "pthread_attr_setstacksize"
extern effect fn pthreadAttrDestroy(attr: Int64) -> Int32 as "pthread_attr_destroy"
extern effect fn pthreadCreate(t: Int64, attr: Int64, f: Int64, arg: Int64) -> Int32 as "pthread_create"
extern effect fn pthreadJoin(t: Int64, result: Int64) -> Int32 as "pthread_join"
extern effect fn cWrite(fd: Int32, p: Int64, n: UInt64) -> Int64 as "write"
extern effect fn cRead(fd: Int32, p: Int64, n: UInt64) -> Int64 as "read"
extern effect fn cClose(fd: Int32) -> Int32 as "close"
extern effect fn cOpen(path: Int64, flags: Int32, ...) -> Int32 as "open"
extern effect fn fcntl(fd: Int32, command: Int32, ...) -> Int32
extern effect fn errnoLocation() -> Int64 as "__error"
extern effect fn snprintf(buf: Int64, size: UInt64, format: Int64, ...) -> Int32
extern effect fn clockGettime(clock: Int32, at: Int64) -> Int32 as "clock_gettime"
extern effect fn usleep(us: UInt32) -> Int32
extern effect fn fopen(path: Int64, mode: Int64) -> Int64
extern effect fn getenv(name: Int64) -> Int64
extern effect fn access(path: Int64, mode: Int32) -> Int32
extern effect fn opendir(path: Int64) -> Int64
extern effect fn readdir(d: Int64) -> Int64
extern effect fn closedir(d: Int64) -> Int32
extern effect fn mkdir(path: Int64, mode: UInt16) -> Int32
extern effect fn rmdir(path: Int64) -> Int32
extern effect fn unlink(path: Int64) -> Int32
extern effect fn pipe(fds: Int64) -> Int32
extern effect fn fork() -> Int32
extern effect fn dup2(a: Int32, b: Int32) -> Int32
extern effect fn execvp(name: Int64, argv: Int64) -> Int32
extern effect fn cExitNow(code: Int32) as "_exit"
extern effect fn poll(fds: Int64, n: UInt32, timeout: Int32) -> Int32
extern effect fn waitpid(pid: Int32, status: Int64, options: Int32) -> Int32
extern effect fn mmap(p: Int64, n: UInt64, prot: Int32, flags: Int32, fd: Int32, offset: Int64) -> Int64
extern effect fn mprotect(p: Int64, n: UInt64, prot: Int32) -> Int32
extern effect fn munmap(p: Int64, n: UInt64) -> Int32
extern effect fn dlopen(name: Int64, flags: Int32) -> Int64
extern effect fn dlsym(h: Int64, name: Int64) -> Int64
extern effect fn sysconf(name: Int32) -> Int64
extern fn fnAddress(f: extern (Int64) -> Int64) -> Int64 as "qkTextAddress"

const eintr = 4
const rtldDefault = -2 // every image the process has loaded

// x86-64's functions start with push rbp (0x55); Apple Silicon's with stp x29, x30
fn x64() -> Bool = byte(fnAddress(x => x), 0) == 85

// a libSystem function only one processor has, found when it runs (0: none)
fn optional(name: Text) -> Int = dlsym(rtldDefault, textAt(name))

// ---- the context, the output, numbers ----
pub extern effect fn osCtxImpl() -> Int64 as "qkosCtx" = pthreadGetSpecific(word(cell(), 1))

pub extern effect fn osSetCtxImpl(c: Int64) as "qkosSetCtx" {
    let _ = pthreadSetSpecific(word(cell(), 1), c)
}

pub extern effect fn osWriteImpl(fd: Int64, p: Int64, n: Int64) as "qkosWrite" {
    var at = 0
    while at < n {
        let k = cWrite(fd, p + at, n - at)
        if k < 0 and int32At(errnoLocation(), 0) == eintr {
            continue
        }
        if k <= 0 {
            break
        }
        at += k
    }
}

pub extern effect fn osErrnoImpl() -> Int64 as "qkosErrno" = int32At(errnoLocation(), 0)

pub extern effect fn osSetErrnoImpl(e: Int64) as "qkosSetErrno" = setInt32(errnoLocation(), 0, e)

// printf's way with a Float: snprintf, a variadic call (the compiler passes its values as each processor's C does)
pub extern effect fn osFloatTextImpl(buf: Int64, size: Int64, kind: Int64, precision: Int64, v: Float64) -> Int64 as "qkosFloatText" {
    let format = if kind == 'f' { textAt("%.*f\0") } else { textAt("%.*g\0") }
    snprintf(buf, size, format, precision, v)
}

fn clock(which: Int) -> Float {
    let t = calloc(2, 8)
    let _ = clockGettime(which, t)
    let s = toFloat(word(t, 0)) + toFloat(word(t, 1)) * 0.000000001
    free(t)
    s
}

pub extern effect fn osNowImpl() -> Float64 as "qkosNow" = clock(6) // CLOCK_MONOTONIC

pub extern effect fn osTimeImpl() -> Float64 as "qkosTime" = clock(0) // CLOCK_REALTIME

pub extern effect fn osSleepImpl(ms: Int64) as "qkosSleep" {
    let _ = usleep(1000 * ms)
}

// ---- files and folders ----
pub extern effect fn osOpenImpl(path: Int64, mode: Int64) -> Int64 as "qkosOpen" = fopen(path, mode)

pub extern effect fn osEnvImpl(name: Int64) -> Int64 as "qkosEnv" {
    let v = getenv(name)
    if v == 0 {
        return 0
    }
    let n = strlen(v)
    let s = malloc(n + 1)
    copyBytes(s, v, n + 1)
    s
}

pub extern effect fn osPathKindImpl(path: Int64) -> Int64 as "qkosPathKind" {
    if access(path, 0) != 0 {
        return -1
    }
    let d = opendir(path)
    if d == 0 {
        return 0
    }
    let _ = closedir(d)
    1
}

pub extern effect fn osMakeDirImpl(path: Int64) -> Int64 as "qkosMakeDir" = mkdir(path, 511)

pub extern effect fn osRemoveImpl(path: Int64, folder: Int64) -> Int64 as "qkosRemove" =
    if folder == 1 { rmdir(path) } else { unlink(path) }

pub extern effect fn osSeparatorImpl(c: Int64) -> Int64 as "qkosSeparator" =
    if c == '/' { 1 } else { 0 }

pub extern effect fn osListDirImpl(path: Int64) -> Int64 as "qkosListDir" {
    let d = opendir(path)
    if d == 0 {
        return 0
    }
    // d_name: x86-64's readdir has the 32-bit inode's dirent (d_ino, d_reclen, d_type, d_namlen); Apple Silicon's
    // the 64-bit one (d_ino, d_seekoff, d_reclen, d_namlen, d_type)
    let nameAt = if x64() { 8 } else { 21 }
    var cap = 1024
    var out = malloc(cap)
    var used = 0
    while true {
        let e = readdir(d)
        if e == 0 {
            break
        }
        let name = e + nameAt
        let k = strlen(name)
        let dots = k == 1 and byte(name, 0) == '.' or k == 2 and byte(name, 0) == '.' and byte(name, 1) == '.'
        if not dots {
            while used + k + 2 > cap {
                cap *= 2
                out = realloc(out, cap)
            }
            copyBytes(out + used, name, k + 1)
            used += k + 1
        }
    }
    let _ = closedir(d)
    setByte(out, used, 0)
    out
}

// ---- the input ----
pub extern effect fn osReadInImpl(p: Int64, n: Int64) -> Int64 as "qkosReadIn" {
    while true {
        let k = cRead(0, p, n)
        if k < 0 and int32At(errnoLocation(), 0) == eintr {
            continue
        }
        return if k > 0 { k } else { 0 }
    }
    0
}

pub extern effect fn osReadLineImpl(out: Int64) -> Int64 as "qkosReadLine" = -1 + out - out

// ---- other programs ----
fn cannotRun(out: Int, name: Int, e: Int) -> Int {
    let m = malloc(700)
    let _ = bufAt(m, 700).text("cannot run ").zeroText(name).text(": ").zeroText(strerror(e))
    setWord(out, 1, m)
    1
}

fn errno() -> Int = int32At(errnoLocation(), 0)

pub extern effect fn osRunProcessImpl(name: Int64, args: Int64, count: Int64, out: Int64) -> Int64 as "qkosRunProcess" {
    let argv = calloc(count + 2, 8)
    setWord(argv, 0, name)
    for i in 0..count {
        let n = word(args, 2 * i + 1)
        let s = calloc(n + 1, 1)
        copyBytes(s, word(args, 2 * i), n)
        setWord(argv, i + 1, s)
    }
    let fds = calloc(6, 4) // the output, the errors, and exec's failure (closed when exec works)
    if pipe(fds) != 0 {
        return cannotRun(out, name, errno())
    }
    if pipe(fds + 8) != 0 {
        let e = errno()
        let _ = cClose(int32At(fds, 0)) + cClose(int32At(fds, 1))
        return cannotRun(out, name, e)
    }
    if pipe(fds + 16) != 0 {
        let e = errno()
        let _ = cClose(int32At(fds, 0)) + cClose(int32At(fds, 1)) + cClose(int32At(fds, 2)) + cClose(int32At(fds, 3))
        return cannotRun(out, name, e)
    }
    let _ = fcntl(int32At(fds, 5), 2, 1) // F_SETFD, FD_CLOEXEC: exec closes it
    let pid = fork()
    if pid < 0 {
        let e = errno()
        for i in 0..6 {
            let _ = cClose(int32At(fds, i))
        }
        return cannotRun(out, name, e)
    }
    if pid == 0 {
        // the child
        let devNull = cOpen(textAt("/dev/null\0"), 0)
        if devNull >= 0 {
            let _ = dup2(devNull, 0)
        }
        let _ = dup2(int32At(fds, 1), 1) + dup2(int32At(fds, 3), 2)
        let _ = cClose(int32At(fds, 0)) + cClose(int32At(fds, 2)) + cClose(int32At(fds, 4))
        let _ = execvp(name, argv)
        let e = calloc(1, 8)
        setInt32(e, 0, errno())
        let _ = cWrite(int32At(fds, 5), e, 4)
        cExitNow(127)
    }
    let _ = cClose(int32At(fds, 1)) + cClose(int32At(fds, 3)) + cClose(int32At(fds, 5))
    let execError = calloc(1, 8)
    var got = cRead(int32At(fds, 4), execError, 4)
    while got < 0 and errno() == eintr {
        got = cRead(int32At(fds, 4), execError, 4)
    }
    let _ = cClose(int32At(fds, 4))
    let pfd = calloc(2, 8) // two pollfds: fd, events (POLLIN), revents
    setInt32(pfd, 0, int32At(fds, 0))
    setInt32(pfd, 1, 1)
    setInt32(pfd, 2, int32At(fds, 2))
    setInt32(pfd, 3, 1)
    let bufs = calloc(6, 8) // (bytes, length, room) for the output, then the errors
    for i in 0..2 {
        setWord(bufs, 3 * i, malloc(4096))
        setWord(bufs, 3 * i + 2, 4096)
    }
    let chunk = malloc(16384)
    var live = 2
    while live > 0 {
        if poll(pfd, 2, -1) < 0 {
            if errno() == eintr {
                continue
            }
            break
        }
        for i in 0..2 {
            let fd = int32At(pfd, 2 * i)
            if fd >= 0 and Pointer<Int16>(pfd)[4 * i + 3] != 0 {
                let n = cRead(fd, chunk, 16384)
                if n > 0 {
                    let b = bufs + 24 * i
                    while word(b, 1) + n > word(b, 2) {
                        setWord(b, 2, word(b, 2) * 2)
                        setWord(b, 0, realloc(word(b, 0), word(b, 2)))
                    }
                    copyBytes(word(b, 0) + word(b, 1), chunk, n)
                    setWord(b, 1, word(b, 1) + n)
                } else if n == 0 or errno() != eintr {
                    let _ = cClose(fd)
                    setInt32(pfd, 2 * i, -1)
                    live -= 1
                }
            }
        }
    }
    free(chunk)
    for i in 0..2 {
        if int32At(pfd, 2 * i) >= 0 {
            let _ = cClose(int32At(pfd, 2 * i))
        }
    }
    let ws = calloc(1, 8)
    while waitpid(pid, ws, 0) < 0 and errno() == eintr {}
    if got == 4 {
        free(word(bufs, 0))
        free(word(bufs, 3))
        return cannotRun(out, name, int32At(execError, 0))
    }
    let s = int32At(ws, 0)
    let status = if s & 127 == 0 {
        s >> 8 & 255
    } else if s & 127 != 127 {
        128 + s & 127
    } else {
        -1
    }
    setWord(out, 0, status)
    setWord(out, 1, word(bufs, 0))
    setWord(out, 2, word(bufs, 1))
    setWord(out, 3, word(bufs, 3))
    setWord(out, 4, word(bufs, 4))
    0
}

// ---- code in memory, the stack, C's libraries, threads ----
// MAP_JIT memory (read, write, run), made writable for this thread (pthread_jit_write_protect_np on Apple Silicon);
// protected, it runs, and the instruction cache is told (sys_icache_invalidate)
pub extern effect fn osMapCodeImpl(n: Int64) -> Int64 as "qkosMapCode" {
    let p = mmap(0, n, 7, 6146, -1, 0) // MAP_PRIVATE | MAP_ANON | MAP_JIT
    if p == -1 {
        return 0
    }
    let writable = optional("pthread_jit_write_protect_np\0")
    if writable != 0 {
        let _ = machine.call(Pointer<UInt8>(writable), 0, 0, 0, 0)
    }
    p
}

pub extern effect fn osProtectCodeImpl(p: Int64, n: Int64) as "qkosProtectCode" {
    let protect = optional("pthread_jit_write_protect_np\0")
    if protect != 0 {
        let _ = machine.call(Pointer<UInt8>(protect), 1, 0, 0, 0)
    }
    let invalidate = optional("sys_icache_invalidate\0")
    if invalidate != 0 {
        let _ = machine.call(Pointer<UInt8>(invalidate), p, n, 0, 0)
    }
}

pub extern effect fn osUnmapCodeImpl(p: Int64, n: Int64) as "qkosUnmapCode" {
    let _ = munmap(p, n)
}

// the heap's range (heap.qk): reserved with no access (MAP_PRIVATE | MAP_ANONYMOUS), made readable and writable as
// it is used
pub extern effect fn osReserveImpl(n: Int64) -> Int64 as "qkosReserve" {
    let p = mmap(0, n, 0, 4098, -1, 0)
    if p == -1 { 0 } else { p }
}

pub extern effect fn osCommitImpl(p: Int64, n: Int64) -> Int64 as "qkosCommit" =
    if mprotect(p, n, 3) == 0 { 1 } else { 0 }

pub extern effect fn osReleaseImpl(p: Int64, n: Int64) as "qkosRelease" {
    let _ = munmap(p, n)
}

pub extern effect fn osStackLowImpl() -> Int64 as "qkosStackLow" {
    let t = pthreadSelf()
    pthreadStackTop(t) - pthreadStackSize(t)
}

fn isText(s: Int, t: Text) -> Bool = strlen(s) == len(t) and sameBytes(s, textAt(t), len(t))

fn hasPart(s: Int, t: Text) -> Bool {
    let n = strlen(s)
    var i = 0
    while i + len(t) <= n {
        if sameBytes(s + i, textAt(t), len(t)) {
            return true
        }
        i += 1
    }
    false
}

// "c" and "m" are libSystem, which every process has loaded; another is libNAME.dylib, or a path
pub extern effect fn osCFunctionImpl(symbol: Int64, lib: Int64, why: Int64) -> Int64 as "qkosCFunction" {
    let system = lib == 0 or isText(lib, "c") or isText(lib, "m")
    var h = rtldDefault
    if not system {
        if hasPart(lib, "/") or hasPart(lib, ".dylib") {
            h = dlopen(lib, 2)
        } else {
            let name = calloc(1, 1024)
            let _ = bufAt(name, 1024).text("lib").zeroText(lib).text(".dylib")
            h = dlopen(name, 2)
            free(name)
        }
    }
    if h == 0 {
        let _ = bufAt(why, 512).text("cannot load the library ").zeroText(lib).text(" (lib").zeroText(lib).text(
            ".dylib)",
        )
        return 0
    }
    let f = dlsym(h, symbol)
    if f == 0 and system {
        let _ = bufAt(why, 512).text("cannot find ").zeroText(symbol).text(" in the C library")
    } else if f == 0 {
        let _ = bufAt(why, 512).text("cannot find ").zeroText(symbol).text(" in the library ").zeroText(lib)
    }
    f
}

pub extern effect fn osProcessorsImpl() -> Int64 as "qkosProcessors" {
    let n = sysconf(58) // _SC_NPROCESSORS_ONLN
    if n > 0 { n } else { 1 }
}

fn threadOf(f: Int, arg: Int, stack: Int) -> Int {
    let attr = calloc(1, 256)
    let t = calloc(1, 8)
    let _ = pthreadAttrInit(attr)
    let _ = pthreadAttrSetStackSize(attr, stack)
    let started = pthreadCreate(t, attr, f, arg) == 0
    let _ = pthreadAttrDestroy(attr)
    free(attr)
    let id = word(t, 0)
    free(t)
    if started { id } else { 0 }
}

pub extern effect fn osThreadStartImpl(f: Int64, arg: Int64) -> Int64 as "qkosThreadStart" =
    threadOf(f, arg, 67108864)

pub extern effect fn osThreadJoinImpl(h: Int64) as "qkosThreadJoin" {
    let _ = pthreadJoin(h, 0)
}

// ---- the executable's entry: the program from its own data, on a thread of 256 MB of stack, as elsewhere ----
// (argc, argv, payload, trailer, status)
fn run(a: Int) -> Int {
    setWord(a, 4, qkStartMemory(word(a, 0), word(a, 1), word(a, 2), word(a, 3)))
    0
}

fn makeKey() {
    let _ = pthreadKeyCreate(cell() + 8, 0)
    setWord(cell(), 1, word(cell() + 8, 0)) // the key (a pthread_key_t is an unsigned long), its own word
}

// main's stub (compiler/image.qk) gives the program the executable carries: its payload and its trailer
pub extern effect fn macMain(argc: Int64, argv: Int64, payload: Int64, trailer: Int64) -> Int64 as "qkMacMain" {
    makeKey()
    let a = calloc(5, 8)
    setWord(a, 0, argc)
    setWord(a, 1, argv)
    setWord(a, 2, payload)
    setWord(a, 3, trailer)
    setWord(a, 4, 1)
    let t = threadOf(fnAddress(x => run(x)), a, 268435456)
    if t == 0 {
        return qkStartMemory(argc, argv, payload, trailer)
    }
    let _ = pthreadJoin(t, 0)
    word(a, 4)
}

// ---- a program run from memory (quarkimg run): the runtime mapped by the caller, on the caller's thread ----
pub extern effect fn memoryMain(argc: Int64, argv: Int64, payload: Int64, trailer: Int64) -> Int64 as "qkMemoryMain" {
    makeKey()
    qkStartMemory(argc, argv, payload, trailer)
}

// ---- the command line's own runs (host.qk, compiler/memory.qk): this thread made ready for the runtime ----
pub extern effect fn hostInit() as "qkosHostInit" = makeKey()

// ---- --profile: a timer signal every millisecond of the process's time, and where the thread it stops is ----
extern effect fn sigaction(sig: Int32, act: Int64, old: Int64) -> Int32
extern effect fn setitimer(which: Int32, value: Int64, old: Int64) -> Int32
extern fn handlerAddress(f: extern (Int64, Int64, Int64) -> Unit) -> Int64 as "qkTextAddress"

// SIGPROF: the stopped code's address, from the signal's ucontext: its uc_mcontext (a pointer, at byte 48), then the
// thread state after the exception state (16 bytes): x86-64's rip (byte 144), Apple Silicon's pc (byte 272)
fn sample(context: Int) {
    let p = word(cell(), 3)
    if p == 0 or word(p, 4) >= word(p, 5) {
        return
    }
    let mc = word(context, 6)
    setWord(word(p, 3) + 8 * sampleWords * word(p, 4), 0, word(mc, if x64() { 18 } else { 34 }))
    setWord(p, 4, word(p, 4) + 1)
}

fn profileTimer(us: Int) {
    let t = calloc(4, 8)
    setWord(t, 1, us) // the interval, then the first one: seconds 0, microseconds us
    setWord(t, 3, us)
    let _ = setitimer(2, t, 0) // ITIMER_PROF
    free(t)
}

pub extern effect fn osProfileStartImpl(p: Int64) as "qkosProfileStart" {
    setWord(cell(), 3, p)
    let sa = calloc(1, 16) // a struct sigaction: the handler, the mask (4 bytes), the flags
    setWord(sa, 0, handlerAddress((sig, info, context) => sample(context)))
    setInt32(sa, 3, 66) // SA_SIGINFO | SA_RESTART
    let _ = sigaction(27, sa, 0) // SIGPROF
    free(sa)
    profileTimer(1000)
}

pub extern effect fn osProfileStopImpl(p: Int64) as "qkosProfileStop" {
    profileTimer(0)
    setWord(cell(), 3, 0)
}

// ---- sockets (BSD sockets), seeking, the local time ----
extern effect fn pxSocket(family: Int32, kind: Int32, protocol: Int32) -> Int32 as "socket"
extern effect fn pxBind(s: Int32, addr: Int64, n: UInt32) -> Int32 as "bind"
extern effect fn pxListen(s: Int32, backlog: Int32) -> Int32 as "listen"
extern effect fn pxAccept(s: Int32, addr: Int64, n: Int64) -> Int32 as "accept"
extern effect fn pxConnect(s: Int32, addr: Int64, n: UInt32) -> Int32 as "connect"
extern effect fn pxRecv(s: Int32, p: Int64, n: UInt64, flags: Int32) -> Int64 as "recv"
extern effect fn pxSend(s: Int32, p: Int64, n: UInt64, flags: Int32) -> Int64 as "send"
extern effect fn pxSetOption(s: Int32, level: Int32, name: Int32, value: Int64, n: UInt32) -> Int32 as "setsockopt"
extern effect fn pxGetAddrInfo(host: Int64, service: Int64, hints: Int64, out: Int64) -> Int32 as "getaddrinfo"
extern effect fn pxFreeAddrInfo(info: Int64) as "freeaddrinfo"
extern effect fn pxGaiError(code: Int32) -> Int64 as "gai_strerror"
extern effect fn fseeko(f: Int64, at: Int64, from: Int32) -> Int32
extern effect fn ftello(f: Int64) -> Int64
extern effect fn localtimeR(t: Int64, tm: Int64) -> Int64 as "localtime_r"

const sockLevel = 65535 // SOL_SOCKET
const reuseAddress = 4 // SO_REUSEADDR
const nonBlockFlag = 4 // O_NONBLOCK
const tryAgain = 35 // EAGAIN (EWOULDBLOCK)
const sendFlags = 0 // MSG_NOSIGNAL where there is one: a closed other end is an error, not a signal
const addrAt = 4 // ai_addr's place in an addrinfo, in words

fn netWhy(why: Int, text: Int) {
    let _ = bufAt(why, 256).zeroText(text)
}

// host:port's first IPv4 address (a sockaddr_in, 16 bytes) into addr; host 0 or "": any (to listen)
fn resolve(host: Int, port: Int, addr: Int, why: Int) -> Bool {
    let hints = calloc(48 + 24 + 8, 1) // the hints, the port's digits, the result's address
    let any = host == 0 or byte(host, 0) == 0
    setInt32(hints, 0, if any {
        1 // AI_PASSIVE
    } else {
        0
    })
    setInt32(hints, 1, 2) // AF_INET
    setInt32(hints, 2, 1) // SOCK_STREAM
    let service = bufAt(hints + 48, 24).int(port)
    let out = hints + 72
    let r = pxGetAddrInfo(if any { 0 } else { host }, service.p, hints, out)
    let found = r == 0 and word(out, 0) != 0
    if found {
        copyBytes(addr, word(word(out, 0), addrAt), 16)
        pxFreeAddrInfo(word(out, 0))
    } else {
        netWhy(why, if r != 0 { pxGaiError(r) } else { textAt("the host is not known\0") })
    }
    free(hints)
    found
}

fn nonBlocking(s: Int) {
    let flags = fcntl(s, 3) // F_GETFL
    let _ = fcntl(s, 4, flags | nonBlockFlag) // F_SETFL
}

fn socketOptions(s: Int) {
    let one = calloc(1, 8)
    setInt32(one, 0, 1)
    let _ = pxSetOption(s, sockLevel, reuseAddress, one, 4)
    let _ = pxSetOption(s, sockLevel, 4130, one, 4) // SO_NOSIGPIPE: a closed other end is an error
    free(one)
}

pub extern effect fn osListenImpl(host: Int64, port: Int64, why: Int64) -> Int64 as "qkosListen" {
    let addr = calloc(2, 8)
    if not resolve(host, port, addr, why) {
        free(addr)
        return -1
    }
    let s = pxSocket(2, 1, 0)
    if s < 0 {
        netWhy(why, strerror(osErrno()))
        free(addr)
        return -1
    }
    socketOptions(s)
    let ok = pxBind(s, addr, 16) == 0 and pxListen(s, 128) == 0
    free(addr)
    if not ok {
        netWhy(why, strerror(osErrno()))
        let _ = cClose(s)
        return -1
    }
    nonBlocking(s)
    s
}

pub extern effect fn osConnectImpl(host: Int64, port: Int64, why: Int64) -> Int64 as "qkosConnect" {
    let addr = calloc(2, 8)
    if not resolve(host, port, addr, why) {
        free(addr)
        return -1
    }
    let s = pxSocket(2, 1, 0)
    if s < 0 {
        netWhy(why, strerror(osErrno()))
        free(addr)
        return -1
    }
    socketOptions(s)
    var r = pxConnect(s, addr, 16)
    while r != 0 and osErrno() == 4 {
        r = pxConnect(s, addr, 16) // EINTR
    }
    free(addr)
    if r != 0 {
        netWhy(why, strerror(osErrno()))
        let _ = cClose(s)
        return -1
    }
    nonBlocking(s)
    s
}

pub extern effect fn osAcceptImpl(s: Int64, why: Int64) -> Int64 as "qkosAccept" {
    while true {
        let c = pxAccept(s, 0, 0)
        if c >= 0 {
            socketOptions(c)
            nonBlocking(c)
            return c
        }
        let e = osErrno()
        if e == tryAgain {
            return -1
        }
        if e != 4 {
            netWhy(why, strerror(e))
            return -2
        }
    }
    -2
}

pub extern effect fn osRecvImpl(s: Int64, p: Int64, n: Int64, why: Int64) -> Int64 as "qkosRecv" {
    while true {
        let k = pxRecv(s, p, n, 0)
        if k >= 0 {
            return k
        }
        let e = osErrno()
        if e == tryAgain {
            return -1
        }
        if e != 4 {
            netWhy(why, strerror(e))
            return -2
        }
    }
    -2
}

pub extern effect fn osSendImpl(s: Int64, p: Int64, n: Int64, why: Int64) -> Int64 as "qkosSend" {
    while true {
        let k = pxSend(s, p, n, sendFlags)
        if k >= 0 {
            return k
        }
        let e = osErrno()
        if e == tryAgain {
            return -1
        }
        if e != 4 {
            netWhy(why, strerror(e))
            return -2
        }
    }
    -2
}

pub extern effect fn osCloseSocketImpl(s: Int64) as "qkosCloseSocket" {
    let _ = cClose(s)
}

// items: (socket, write, ready) each; ready 1 for those that are (an error or a hang-up too: the next call says it)
pub extern effect fn osPollImpl(items: Int64, count: Int64, ms: Int64) -> Int64 as "qkosPoll" {
    if count == 0 and ms >= 0 {
        // only a wait: macOS's poll of no descriptors does not wait reliably
        let _ = usleep(1000 * ms)
        return 0
    }
    let fds = calloc(if count > 0 {
        count // pollfd: the fd, then events and revents (shorts)
    } else {
        1
    }, 8)
    for i in 0..count {
        setInt32(fds, 2 * i, word(items, 3 * i))
        setInt32(fds, 2 * i + 1, if word(items, 3 * i + 1) != 0 {
            4 // POLLOUT, POLLIN
        } else {
            1
        })
    }
    var r = poll(fds, count, if ms < 0 { -1 } else { ms })
    while r < 0 and osErrno() == 4 {
        r = poll(fds, count, if ms < 0 { -1 } else { ms })
    }
    for i in 0..count {
        let revents = shr(int32At(fds, 2 * i + 1), 16) & 65535
        setWord(items, 3 * i + 2, if revents != 0 { 1 } else { 0 })
    }
    free(fds)
    r
}

pub extern effect fn osSeekImpl(f: Int64, at: Int64, from: Int64) -> Int64 as "qkosSeek" {
    if fseeko(f, at, from) != 0 {
        return -1
    }
    ftello(f)
}

pub extern effect fn osLocalOffsetImpl(seconds: Float64) -> Int64 as "qkosLocalOffset" {
    let t = calloc(10, 8) // the moment, then a struct tm (tm_gmtoff: its sixth word)
    setWord(t, 0, toInt(cFloor(seconds)))
    var offset = 0
    if localtimeR(t, t + 8) != 0 {
        offset = word(t + 8, 5)
    }
    free(t)
    offset
}
""" + "\n"
    }
    if name == "map" {
        return r"""
// Maps, and == of any value, by the description of its type the compiler wrote: I a plain slot, F a Float, T a
// text, A<elem> an array, M<key><value> a map, (<fields>) a record, E<n><case's fields>.<...> an enum with data (n +
// 32 its cases), B<type> a box, C a function's captured values, R<at> the type whose description starts `at` (three
// base-64 digits) into the whole description, P<type> a var a loop keeps in memory (its address: looked into there).
use base
use arena

// ---- descriptions (zero-ended bytes) ----
pub type Desc {
    n: Int // a type's slots, and where its description ends
    d: Int
}

pub fn descBase() -> Int = ctxGet(ctxDescBase)

pub fn setDescBase(b: Int) = ctxSet(ctxDescBase, b)

pub fn descRef(d: Int) -> Int = descBase() + descNumber(d)

// a number in three characters, six bits each from '0' (a reference, an enum's slots and where a case's data starts)
pub fn descNumber(d: Int) -> Int {
    var n = 0
    for i in 0..3 {
        n = n * 64 + byte(d, i) - '0'
    }
    n
}

// past one type, by its letters alone (a reference is never followed: it may be the type around it, and a type that
// holds itself through a box would be followed for ever)
pub fn skipDesc(d: Int) -> Int {
    let k = byte(d, 0)
    if k == 'R' {
        return d + 4
    }
    if k == 'A' or k == 'B' or k == 'P' {
        return skipDesc(d + 1)
    }
    if k == 'M' {
        return skipDesc(skipDesc(d + 1))
    }
    if k == '(' {
        var q = d + 1
        while byte(q, 0) != ')' {
            q = skipDesc(q)
        }
        return q + 1
    }
    if k == 'E' {
        let cases = byte(d, 1) - 32
        var q = d + 5 // E, the cases, the slots (three characters)
        for _ in 0..cases {
            q += 3 // where the case's data starts
            while byte(q, 0) != '.' {
                q = skipDesc(q)
            }
            q += 1
        }
        return q
    }
    d + 1 // I, F, T, C
}

pub fn descSlots(d0: Int) -> Desc {
    let k = byte(d0, 0)
    var d = d0 + 1
    if k == 'I' or k == 'F' or k == 'C' {
        return Desc(1, d)
    }
    if k == 'B' or k == 'P' {
        return Desc(1, skipDesc(d))
    }
    if k == 'R' {
        return Desc(descSlots(descRef(d)).n, d + 3)
    }
    if k == 'T' {
        return Desc(2, d)
    }
    if k == 'A' {
        return Desc(2, skipDesc(d))
    }
    if k == 'M' {
        return Desc(1, skipDesc(skipDesc(d)))
    }
    if k == '(' {
        var n = 0
        while byte(d, 0) != ')' {
            let f = descSlots(d)
            n += f.n
            d = f.d
        }
        return Desc(n, d + 1)
    }
    if k == 'E' {
        // E, the cases' count, the slots, then each case: where its data starts, its fields, '.'
        let cases = byte(d, 0) - 32
        let n = descNumber(d + 1)
        d += 4
        for i in 0..cases {
            d += 3
            while byte(d, 0) != '.' {
                d = descSlots(d).d
            }
            d += 1 // the case's end
        }
        return Desc(n, d)
    }
    Desc(0, d)
}

// ---- maps: entries in the order their keys came, and a table of where each key is ----
// A map's words: an entry is [alive][key: at least 2 slots][value]. A table slot is a word: the entry's index + 1 in
// its low 32 bits, the key's hash's high 32 bits above them (a probe that meets another key's slot goes on without
// reading its entry), 0 empty.
pub const mCount = 0
pub const mUsed = 1
pub const mCap = 2
pub const mValueBytes = 3
pub const mKeyKind = 4
pub const mTableCap = 5
pub const mEntries = 6
pub const mTable = 7
pub const mDesc = 8
pub const mKeySlots = 9
pub const mKeyBytes = 10
pub const mapWords = 11
const keyPlain = 0
const keyText = 1
const keyPair = 2
const keyAny = 3

pub fn entryBytes(m: Int) -> Int = 8 + word(m, mKeySlots) * 8 + word(m, mValueBytes)

pub fn entryAt(m: Int, i: Int) -> Int = word(m, mEntries) + i * entryBytes(m)

// eight bytes at a time, multiplied in, the last few as one word; mixed at the end
fn textHash(p: Int, n: Int) -> Int {
    var h = n *% -7046029254386353131 ^ 1469598103934665603
    var i = 0
    while i + 8 <= n {
        h = (h ^ Pointer<Int64>(p + i)[0]) *% -7046029254386353131
        h = h ^ shr(h, 29)
        i += 8
    }
    var last = 0
    var shift = 0
    while i < n {
        last = last | byte(p, i) << shift
        shift += 8
        i += 1
    }
    mix(h ^ last)
}

const tagBits = -4294967296 // a table slot's high 32 bits: the hash's
const indexBits = 4294967295

// the kind of key a description (of the key alone, n bytes) makes
fn mapKeyKind(d: Int, n: Int) -> Int {
    var plain = 0
    var texts = 0
    for i in 0..n {
        let c = byte(d, i)
        if c == 'I' {
            plain += 1
        } else if c == 'T' {
            texts += 1
        } else if c != '(' and c != ')' {
            return keyAny
        }
    }
    if texts == 1 and plain == 0 {
        return keyText
    }
    if texts == 0 and plain == 1 {
        return keyPlain
    }
    if texts == 0 and plain == 2 {
        return keyPair
    }
    keyAny
}

// a map's value, after its key, in its description
pub fn mapValueDesc(m: Int) -> Int {
    let saved = descBase()
    setDescBase(word(m, mDesc))
    let d = skipDesc(word(m, mDesc) + 1)
    setDescBase(saved)
    d
}

// ---- == and hashing of any value: a list of what is left to do, not calls inside calls ----
// Work: (a, b, description, base), four words each, in memory of its own.
type Walk { items: Int, count: Int, cap: Int }

fn walkNew() -> Walk = Walk(malloc(16 * 32), 0, 16)

fn Walk.push(self, a: Int, b: Int, d: Int, base: Int) -> Walk {
    var w = self
    if w.count == w.cap {
        w = Walk(realloc(w.items, w.cap * 2 * 32), w.count, w.cap * 2)
    }
    let at = w.items + 32 * w.count
    setWord(at, 0, a)
    setWord(at, 1, b)
    setWord(at, 2, d)
    setWord(at, 3, base)
    Walk(w.items, w.count + 1, w.cap)
}

// the fields of a record, or of the case an enum's value is, each one a piece of work
fn Walk.fields(self, a0: Int, b0: Int, d0: Int, base: Int) -> Walk {
    var w = self
    var a = a0
    var b = b0
    var d = d0
    if byte(d, 0) == '(' {
        d += 1
        while byte(d, 0) != ')' {
            let f = descSlots(d)
            w = w.push(a, b, d, base)
            a += 8 * f.n
            if b != 0 {
                b += 8 * f.n
            }
            d = f.d
        }
        return w
    }
    let cases = byte(d, 1) - 32 // E<n><slots>, then each case: <start> fields '.'
    d += 5
    let tag = word(a, 0)
    for i in 0..cases {
        let start = descNumber(d)
        d += 3
        if i != tag {
            while byte(d, 0) != '.' {
                d = descSlots(d).d
            }
            d += 1
            continue
        }
        a += 8 * start
        if b != 0 {
            b += 8 * start
        }
        while byte(d, 0) != '.' {
            let f = descSlots(d)
            w = w.push(a, b, d, base)
            a += 8 * f.n
            if b != 0 {
                b += 8 * f.n
            }
            d = f.d
        }
        return w
    }
    w
}

pub fn valuesEqual(a0: Int, b0: Int, d0: Int, base0: Int) -> Bool {
    var w = walkNew().push(a0, b0, d0, base0)
    let saved = descBase()
    var same = true
    while same and w.count > 0 {
        w = Walk(w.items, w.count - 1, w.cap)
        let it = w.items + 32 * w.count
        let a = word(it, 0)
        let b = word(it, 1)
        let d = word(it, 2)
        let base = word(it, 3)
        setDescBase(base)
        let k = byte(d, 0)
        if k == 'F' {
            same = floatAt(a, 0) == floatAt(b, 0) // -0.0 == 0.0; NaN is equal to nothing
        } else if k == 'T' {
            same = word(a, 1) == word(b, 1)
                and (word(a, 0) == word(b, 0) or sameBytes(word(a, 0), word(b, 0), word(a, 1)))
        } else if k == 'A' {
            if word(a, 1) != word(b, 1) {
                same = false
            } else if word(a, 0) != word(b, 0) {
                let elem = d + 1
                let n = descSlots(elem).n
                for i in 0..word(a, 1) {
                    w = w.push(word(a, 0) + 8 * i * n, word(b, 0) + 8 * i * n, elem, base)
                }
            }
        } else if k == 'M' {
            let x = word(a, 0)
            let y = word(b, 0)
            if x != y {
                if x == 0 or y == 0 {
                    same = (if x != 0 { word(x, mCount) } else { 0 }) == (if y != 0 { word(y, mCount) } else { 0 })
                } else if word(x, mCount) != word(y, mCount) {
                    same = false
                } else {
                    let vd = mapValueDesc(x)
                    var i = 0
                    while same and i < word(x, mUsed) {
                        // each key of one in the other, with an equal value
                        let e = entryAt(x, i)
                        if word(e, 0) != 0 {
                            let at = if word(x, mKeyKind) == keyAny {
                                mapFind(y, e + 8, 0)
                            } else {
                                mapFind(y, word(e, 1), word(e, 2))
                            }
                            if at < 0 {
                                same = false
                            } else {
                                w = w.push(
                                    e + 8 + 8 * word(x, mKeySlots),
                                    entryAt(y, at) + 8 + 8 * word(y, mKeySlots),
                                    vd,
                                    word(x, mDesc),
                                )
                            }
                        }
                        i += 1
                    }
                }
            }
        } else if k == 'B' {
            let pa = word(a, 0)
            let pb = word(b, 0)
            if pa != pb {
                if pa == 0 or pb == 0 {
                    same = false
                } else {
                    w = w.push(pa, pb, if byte(d, 1) == 'R' { descRef(d + 2) } else { d + 1 }, base)
                }
            }
        } else if k == 'R' {
            w = w.push(a, b, descRef(d + 1), base)
        } else if k == '(' {
            w = w.fields(a, b, d, base)
        } else if k == 'E' {
            if word(a, 0) != word(b, 0) {
                same = false
            } else {
                w = w.fields(a, b, d, base)
            }
        } else {
            same = word(a, 0) == word(b, 0) // I, and a function's address
        }
    }
    free(w.items)
    setDescBase(saved)
    same
}

type Hashed { h: Int, nan: Bool }

pub fn valueHash(a0: Int, d0: Int, base0: Int) -> Hashed {
    var w = walkNew().push(a0, 0, d0, base0)
    let saved = descBase()
    var h = -8925532866252464924
    var nan = false
    while w.count > 0 {
        w = Walk(w.items, w.count - 1, w.cap)
        let it = w.items + 32 * w.count
        let a = word(it, 0)
        let d = word(it, 2)
        let base = word(it, 3)
        setDescBase(base)
        let k = byte(d, 0)
        if k == 'F' {
            var x = floatAt(a, 0)
            if x != x {
                nan = true
            }
            if x == 0.0 {
                x = 0.0 // -0.0 hashes as 0.0
            }
            h = mix(h ^ bitsOf(x))
        } else if k == 'T' {
            h = mix(h ^ textHash(word(a, 0), word(a, 1)))
        } else if k == 'A' {
            h = mix(h ^ word(a, 1))
            let elem = d + 1
            let n = descSlots(elem).n
            for i in 0..word(a, 1) {
                w = w.push(word(a, 0) + 8 * i * n, 0, elem, base)
            }
        } else if k == 'M' {
            // the same keys in any order: the entries' hashes summed
            let m = word(a, 0)
            if m != 0 {
                let kd = word(m, mDesc) + 1
                let vd = mapValueDesc(m)
                var sum = 0
                for i in 0..word(m, mUsed) {
                    let e = entryAt(m, i)
                    if word(e, 0) != 0 {
                        let hk = valueHash(e + 8, kd, word(m, mDesc))
                        let hv = valueHash(e + 8 + 8 * word(m, mKeySlots), vd, word(m, mDesc))
                        if hk.nan or hv.nan {
                            nan = true
                        }
                        sum +%= mix(hk.h *% 31 +% hv.h)
                    }
                }
                h = mix(h ^ sum ^ word(m, mCount))
            }
        } else if k == 'B' {
            if word(a, 0) != 0 {
                w = w.push(word(a, 0), 0, if byte(d, 1) == 'R' { descRef(d + 2) } else { d + 1 }, base)
            }
        } else if k == 'R' {
            w = w.push(a, 0, descRef(d + 1), base)
        } else if k == '(' {
            w = w.fields(a, 0, d, base)
        } else if k == 'E' {
            h = mix(h ^ word(a, 0))
            w = w.fields(a, 0, d, base)
        } else {
            h = mix(h ^ word(a, 0))
        }
    }
    free(w.items)
    setDescBase(saved)
    Hashed(h, nan)
}

// a == b for values whose == looks inside arrays, maps and boxes
pub extern effect fn rtValueEqual(a: Int64, b: Int64, desc: Int64) -> Int64 as "qk_valueEqual" =
    if valuesEqual(a, b, desc, desc) { 1 } else { 0 }

fn keyHash(m: Int, k0: Int, k1: Int) -> Hashed {
    let kind = word(m, mKeyKind)
    if kind == keyPair {
        return Hashed(mix(k0 *% -7046029254386353131 ^ (k1 +% 7146057691288625177)), false)
    }
    if kind == keyText {
        return Hashed(textHash(k0, k1), false)
    }
    if kind == keyAny {
        return valueHash(k0, word(m, mDesc) + 1, word(m, mDesc))
    }
    Hashed(mix(k0 +% -7046029254386353131), false)
}

fn keyEqual(m: Int, e: Int, k0: Int, k1: Int) -> Bool {
    let kind = word(m, mKeyKind)
    if kind == keyPair {
        return word(e, 1) == k0 and word(e, 2) == k1
    }
    if kind == keyText {
        return word(e, 2) == k1 and sameBytes(word(e, 1), k0, k1)
    }
    if kind == keyAny {
        return valuesEqual(e + 8, k0, word(m, mDesc) + 1, word(m, mDesc))
    }
    word(e, 1) == k0
}

fn mapFindHashed(m: Int, k0: Int, k1: Int, h: Int) -> Int {
    if word(m, mTableCap) == 0 {
        return -1
    }
    let mask = word(m, mTableCap) - 1
    let table = word(m, mTable)
    let tag = h & tagBits
    var i = h & mask
    while true {
        let slot = word(table, i)
        if slot == 0 {
            return -1
        }
        if slot & tagBits == tag {
            let at = slot & indexBits - 1
            let e = entryAt(m, at)
            if word(e, 0) != 0 and keyEqual(m, e, k0, k1) {
                return at
            }
        }
        i = (i + 1) & mask
    }
    -1
}

pub fn mapFind(m: Int, k0: Int, k1: Int) -> Int {
    if m == 0 or word(m, mTableCap) == 0 {
        return -1
    }
    let h = keyHash(m, k0, k1)
    if h.nan {
        -1 // NaN is no key's equal
    } else {
        mapFindHashed(m, k0, k1, h.h)
    }
}

pub fn mapPlace(m: Int, index: Int) {
    let e = entryAt(m, index)
    let mask = word(m, mTableCap) - 1
    let k0 = if word(m, mKeyKind) == keyAny { e + 8 } else { word(e, 1) }
    let h = keyHash(m, k0, word(e, 2)).h
    var i = h & mask
    while word(word(m, mTable), i) != 0 {
        i = (i + 1) & mask
    }
    setWord(word(m, mTable), i, h & tagBits | (index + 1))
}

fn mapRehash(m: Int, tableCap: Int) {
    setWord(m, mTableCap, tableCap)
    setWord(m, mTable, alloc(tableCap, 8))
    for i in 0..word(m, mUsed) {
        if word(entryAt(m, i), 0) != 0 {
            mapPlace(m, i)
        }
    }
}

// a new map of the type desc describes (M<key><value>)
pub extern effect fn rtMapNew(desc: Int64) -> Int64 as "qk_mapNew" {
    let m = alloc(mapWords, 8)
    let saved = descBase()
    setDescBase(desc)
    let key = descSlots(desc + 1)
    setWord(m, mKeyKind, mapKeyKind(desc + 1, key.d - desc - 1))
    setWord(m, mValueBytes, descSlots(key.d).n * 8)
    setDescBase(saved)
    setWord(m, mDesc, desc)
    setWord(m, mKeyBytes, key.n * 8)
    setWord(m, mKeySlots, if key.n < 2 { 2 } else { key.n })
    m
}

const mapMost = 2147483646

// removed entries go once they are half of those used: the others move down, and the table is made again
fn mapCompact(m: Int) {
    remember(m, 0, word(m, mDesc)) // its new table: kept by a loop that began before it
    let size = entryBytes(m)
    var to = 0
    for i in 0..word(m, mUsed) {
        let e = entryAt(m, i)
        if word(e, 0) != 0 {
            if to != i {
                moveBytes(entryAt(m, to), e, size)
            }
            to += 1
        }
    }
    setWord(m, mUsed, to)
    var tableCap = 16
    while tableCap < (to + 1) * 2 {
        tableCap *= 2
    }
    mapRehash(m, tableCap)
}

// m[k] = ...: where the value goes (the key added when new); a NaN in the key stops the program
pub extern effect fn rtMapSet(m: Int64, k0: Int64, k1: Int64, line: Int64) -> Int64 as "qk_mapSet" {
    remember(m, 0, word(m, mDesc)) // a loop that began before the map was made keeps what goes in it
    let h = keyHash(m, k0, k1)
    if h.nan {
        panicNow(panicNanKey, line, 0, 0)
    }
    let at = mapFindHashed(m, k0, k1, h.h)
    if at >= 0 {
        return entryAt(m, at) + 8 + 8 * word(m, mKeySlots)
    }
    if word(m, mUsed) >= mapMost {
        if word(m, mUsed) > word(m, mCount) {
            mapCompact(m)
        }
        if word(m, mUsed) >= mapMost {
            panicNow(panicMapFull, line, mapMost, 0)
        }
    }
    if word(m, mUsed) == word(m, mCap) {
        let cap = if word(m, mCap) != 0 { word(m, mCap) * 2 } else { 8 }
        let entries = alloc(cap, entryBytes(m))
        copyBytes(entries, word(m, mEntries), word(m, mUsed) * entryBytes(m))
        setWord(m, mEntries, entries)
        setWord(m, mCap, cap)
    }
    if (word(m, mUsed) + 1) * 2 > word(m, mTableCap) {
        mapRehash(m, if word(m, mTableCap) != 0 { word(m, mTableCap) * 2 } else { 16 })
    }
    let e = entryAt(m, word(m, mUsed))
    zeroBytes(e, entryBytes(m))
    setWord(e, 0, 1)
    if word(m, mKeyKind) == keyAny {
        copyBytes(e + 8, k0, word(m, mKeyBytes))
    } else {
        setWord(e, 1, k0)
        setWord(e, 2, if word(m, mKeyKind) == keyPlain { 0 } else { k1 })
    }
    mapPlace(m, word(m, mUsed))
    setWord(m, mUsed, word(m, mUsed) + 1)
    setWord(m, mCount, word(m, mCount) + 1)
    e + 8 + 8 * word(m, mKeySlots)
}

pub extern effect fn rtMapGet(m: Int64, k0: Int64, k1: Int64) -> Int64 as "qk_mapGet" {
    let at = mapFind(m, k0, k1)
    if at < 0 { 0 } else { entryAt(m, at) + 8 + 8 * word(m, mKeySlots) }
}

pub extern effect fn rtMapRemove(m: Int64, k0: Int64, k1: Int64) as "qk_mapRemove" {
    let at = mapFind(m, k0, k1)
    if at < 0 {
        return
    }
    setWord(entryAt(m, at), 0, 0) // its table slot stays: lookups go past it
    setWord(m, mCount, word(m, mCount) - 1)
    let removed = word(m, mUsed) - word(m, mCount)
    if removed >= 16 and removed * 2 >= word(m, mUsed) {
        mapCompact(m)
    }
}

// a map of its own (a var's): the same keys and values, removed entries left out
pub extern effect fn rtMapCopy(m: Int64) -> Int64 as "qk_mapCopy" {
    let c = alloc(mapWords, 8)
    copyBytes(c, m, 8 * mapWords)
    setWord(c, mCount, 0)
    setWord(c, mUsed, 0)
    setWord(c, mCap, 0)
    setWord(c, mTableCap, 0)
    setWord(c, mEntries, 0)
    setWord(c, mTable, 0)
    if word(m, mCount) == 0 {
        return c
    }
    setWord(c, mCap, word(m, mCount))
    setWord(c, mEntries, alloc(word(m, mCount), entryBytes(m)))
    for i in 0..word(m, mUsed) {
        let e = entryAt(m, i)
        if word(e, 0) != 0 {
            copyBytes(entryAt(c, word(c, mUsed)), e, entryBytes(m))
            setWord(c, mUsed, word(c, mUsed) + 1)
        }
    }
    setWord(c, mCount, word(c, mUsed))
    var tableCap = 16
    while tableCap < word(c, mUsed) * 2 {
        tableCap *= 2
    }
    mapRehash(c, tableCap)
    c
}

pub extern effect fn rtMapLen(m: Int64) -> Int64 as "qk_mapLen" = word(m, mCount)

pub extern effect fn rtMapUsed(m: Int64) -> Int64 as "qk_mapUsed" = word(m, mUsed)

// entry i's key (its value keySlots on), or 0 when it was removed
pub extern effect fn rtMapEntry(m: Int64, i: Int64) -> Int64 as "qk_mapEntry" {
    let e = entryAt(m, i)
    if word(e, 0) != 0 { e + 8 } else { 0 }
}

// keys(m), values(m): [count][each one's slots]
fn mapList(m: Int, keys: Bool) -> Int {
    let each = if keys { word(m, mKeyBytes) } else { word(m, mValueBytes) }
    let p = alloc(1 + (word(m, mCount) * each + 7) / 8, 8)
    setWord(p, 0, word(m, mCount))
    var w = p + 8
    for i in 0..word(m, mUsed) {
        let e = entryAt(m, i)
        if word(e, 0) != 0 {
            copyBytes(w, if keys { e + 8 } else { e + 8 + 8 * word(m, mKeySlots) }, each)
            w += each
        }
    }
    p
}

pub extern effect fn rtMapKeys(m: Int64) -> Int64 as "qk_mapKeys" = mapList(m, true)

pub extern effect fn rtMapValues(m: Int64) -> Int64 as "qk_mapValues" = mapList(m, false)
""" + "\n"
    }
    if name == "numbers" {
        return r"""
// Sorting plain values in place, random numbers, the math library, the clocks.
use base
use text

// ---- sort: Ints (and Bools, cases), Floats or texts, an introsort with no memory of its own ----
// kind 0: Ints (one word each), 1: Floats, 2: texts (two words each). NaNs go last; -0.0 and 0.0 are equal.
fn less(kind: Int, v: Int, i: Int, j: Int) -> Bool {
    if kind == 0 {
        return word(v, i) < word(v, j)
    }
    if kind == 1 {
        let x = floatAt(v, i)
        let y = floatAt(v, j)
        return x < y or y != y and x == x
    }
    textCompare(word(v, 2 * i), word(v, 2 * i + 1), word(v, 2 * j), word(v, 2 * j + 1)) < 0
}

fn swap(kind: Int, v: Int, i: Int, j: Int) {
    if kind == 2 {
        let p = word(v, 2 * i)
        let n = word(v, 2 * i + 1)
        setWord(v, 2 * i, word(v, 2 * j))
        setWord(v, 2 * i + 1, word(v, 2 * j + 1))
        setWord(v, 2 * j, p)
        setWord(v, 2 * j + 1, n)
    } else {
        let t = word(v, i)
        setWord(v, i, word(v, j))
        setWord(v, j, t)
    }
}

fn each(kind: Int) -> Int = if kind == 2 { 16 } else { 8 }

fn siftDown(kind: Int, v: Int, k0: Int, n: Int) {
    var k = k0
    while true {
        var c = 2 * k + 1
        if c >= n {
            return
        }
        if c + 1 < n and less(kind, v, c, c + 1) {
            c += 1
        }
        if not less(kind, v, k, c) {
            return
        }
        swap(kind, v, k, c)
        k = c
    }
}

fn introsort(kind: Int, v0: Int, n0: Int, depth0: Int) {
    var v = v0
    var n = n0
    var depth = depth0
    while n > 24 {
        if depth == 0 {
            // heapsort: n log n, whatever the values
            var i = n / 2 - 1
            while i >= 0 {
                siftDown(kind, v, i, n)
                i -= 1
            }
            var e = n - 1
            while e > 0 {
                swap(kind, v, 0, e)
                siftDown(kind, v, 0, e)
                e -= 1
            }
            return
        }
        depth -= 1
        let m = n / 2 // the median of the first, the middle and the last: the pivot
        if less(kind, v, m, 0) {
            swap(kind, v, m, 0)
        }
        if less(kind, v, n - 1, m) {
            swap(kind, v, n - 1, m)
            if less(kind, v, m, 0) {
                swap(kind, v, m, 0)
            }
        }
        swap(kind, v, 0, m)
        var i = 0
        var j = n // the pivot stays at 0 while the others are split around it
        while true {
            i += 1
            while i < n and less(kind, v, i, 0) {
                i += 1
            }
            j -= 1
            while less(kind, v, 0, j) {
                j -= 1
            }
            if i >= j {
                break
            }
            swap(kind, v, i, j)
        }
        swap(kind, v, 0, j)
        if j < n - 1 - j {
            // the shorter side by recursion, the longer by the loop
            introsort(kind, v, j, depth)
            v += (j + 1) * each(kind)
            n -= j + 1
        } else {
            introsort(kind, v + (j + 1) * each(kind), n - j - 1, depth)
            n = j
        }
    }
    for i in 1..n {
        // insertion sort for what is left
        var j = i
        while j > 0 and less(kind, v, j, j - 1) {
            swap(kind, v, j, j - 1)
            j -= 1
        }
    }
}

pub extern effect fn rtSort(p: Int64, n: Int64, kind: Int64, descending: Int64) as "qk_sort" {
    var depth = 2
    var k = n
    while k > 1 {
        depth += 2
        k = k >> 1
    }
    introsort(kind, p, n, depth)
    if descending == 0 {
        return
    }
    var a = 0 // equal values cannot be told apart: the reverse of ascending is descending
    var b = n - 1
    while a < b {
        swap(if kind == 2 { 2 } else { 0 }, p, a, b)
        a += 1
        b -= 1
    }
}

// ---- random numbers: xoshiro256**, seeded from the clock the first time, or by seedRandom ----
extern effect fn cTime(t: Int64) -> Int64 as "time"

fn splitmix(state: Int) -> Int {
    // state: the address of x
    let z0 = word(state, 0) +% -7046029254386353131
    setWord(state, 0, z0)
    var z = (z0 ^ shr(z0, 30)) *% -4658895280553007687
    z = (z ^ shr(z, 27)) *% -7723592293110705685
    z ^ shr(z, 31)
}

pub extern effect fn rtSeedRandom(seed: Int64) as "qk_seedRandom" {
    let g = globals()
    let x = ctx() + 8 * ctxScratch
    setWord(x, 0, seed)
    for i in 0..4 {
        setWord(g, gRng + i, splitmix(x))
    }
    setWord(g, gRngSeeded, 1)
}

fn rotl(x: Int, k: Int) -> Int = x << k | shr(x, 64 - k)

fn nextRandom() -> Int {
    let g = globals()
    if word(g, gRngSeeded) == 0 {
        rtSeedRandom(cTime(0) ^ (g + 8 * gRngSeeded))
    }
    let s = g + 8 * gRng
    let r = rotl(word(s, 1) *% 5, 7) *% 9
    let t = word(s, 1) << 17
    setWord(s, 2, word(s, 2) ^ word(s, 0))
    setWord(s, 3, word(s, 3) ^ word(s, 1))
    setWord(s, 1, word(s, 1) ^ word(s, 2))
    setWord(s, 0, word(s, 0) ^ word(s, 3))
    setWord(s, 2, word(s, 2) ^ t)
    setWord(s, 3, rotl(word(s, 3), 45))
    r
}

pub extern effect fn rtRandom() -> Float64 as "qk_random" =
    toFloat(shr(nextRandom(), 11)) * (1.0 / 9007199254740992.0)

pub extern effect fn rtRandomInt(lo: Int64, hi: Int64, line: Int64) -> Int64 as "qk_randomInt" {
    if hi <= lo {
        panicNow(panicEmptyRange, line, lo, hi)
    }
    let span = hi -% lo // as an unsigned number
    let limit = -1 - umod(-1, span)
    var r = nextRandom()
    while not below(r, limit) {
        // no bias toward the low numbers
        r = nextRandom()
    }
    lo +% umod(r, span)
}

// ---- the math library, and the clocks ----
extern fn cSin(x: Float64) -> Float64 as "sin"
extern fn cCos(x: Float64) -> Float64 as "cos"
extern fn cTan(x: Float64) -> Float64 as "tan"
extern fn cAsin(x: Float64) -> Float64 as "asin"
extern fn cAcos(x: Float64) -> Float64 as "acos"
extern fn cAtan(x: Float64) -> Float64 as "atan"
extern fn cAtan2(y: Float64, x: Float64) -> Float64 as "atan2"
extern fn cExp(x: Float64) -> Float64 as "exp"
extern fn cLog(x: Float64) -> Float64 as "log"
extern fn cPow(x: Float64, y: Float64) -> Float64 as "pow"

pub extern fn rtSin(x: Float64) -> Float64 as "qk_sin" = cSin(x)

pub extern fn rtCos(x: Float64) -> Float64 as "qk_cos" = cCos(x)

pub extern fn rtTan(x: Float64) -> Float64 as "qk_tan" = cTan(x)

pub extern fn rtAsin(x: Float64) -> Float64 as "qk_asin" = cAsin(x)

pub extern fn rtAcos(x: Float64) -> Float64 as "qk_acos" = cAcos(x)

pub extern fn rtAtan(x: Float64) -> Float64 as "qk_atan" = cAtan(x)

pub extern fn rtAtan2(y: Float64, x: Float64) -> Float64 as "qk_atan2" = cAtan2(y, x)

pub extern fn rtExp(x: Float64) -> Float64 as "qk_exp" = cExp(x)

pub extern fn rtLog(x: Float64) -> Float64 as "qk_log" = cLog(x)

pub extern fn rtPow(x: Float64, y: Float64) -> Float64 as "qk_pow" = cPow(x, y)

pub extern effect fn osNow() -> Float64 as "qkosNow" // seconds, monotonic
pub extern effect fn osTime() -> Float64 as "qkosTime" // seconds since 1970
pub extern effect fn osSleep(ms: Int64) as "qkosSleep"

pub extern effect fn rtNow() -> Float64 as "qk_now" = osNow()

pub extern effect fn rtTime() -> Float64 as "qk_time" = osTime()
