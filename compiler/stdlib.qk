extern effect fn findWsAccept(m: Int64, name: Int64) -> (extern (Int64, Int64, Int64) -> Int64)? as "GetProcAddress"

fn wsAccept(s: Int, addr: Int, n: Int) -> Int = match findWsAccept(winsock(), textAt("accept\0")) {
    Some(f) => f(s, addr, n)
    None => -1
}

extern effect fn findWsConnect(m: Int64, name: Int64) -> (extern (Int64, Int64, Int32) -> Int32)? as "GetProcAddress"

fn wsConnect(s: Int, addr: Int, n: Int) -> Int = match findWsConnect(winsock(), textAt("connect\0")) {
    Some(f) => f(s, addr, n)
    None => -1
