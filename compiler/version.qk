// What this compiler is, as docs/STABILITY.md says what each number promises: the compiler's version (major.minor.patch),
// and the versions of the contracts it keeps, each changed only by a new major version of the language.
pub const quarkVersion = "0.9.0"
pub const languageEdition = 1 // the language: syntax, types, built-ins, what programs do
pub const qgnVersion = 1 // Quark Graph Notation (quark graph, quark text, diff, merge)
pub const cApiVersion = 1 // include/quark.h: libquark's functions and qkVm, the C ABI of extern fn

// quark version: one line for people, then the contracts' numbers
pub fn versionCommand(os: Text, arch: Text) -> Int {
    print("quark {quarkVersion} ({os}, {arch})")
    print("language edition {languageEdition}, QGN {qgnVersion}, C API {cApiVersion}")
    0
}
