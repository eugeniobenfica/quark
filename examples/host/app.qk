// What a host application gives its scripts (its prelude): its API as Quark sees it.
// Every program the host compiles sees these; the host registers a C function for each extern fn.
// Mark calls that read live state or change it as effects, on the execution wire.
extern type Item

type Point { x: Float, y: Float }

extern effect fn position(i: Item) -> Point
extern effect fn moveBy(i: Item, dx: Float, dy: Float)
extern effect fn moveTo(i: Item, p: Point)
extern effect fn setColor(i: Item, r: Float, g: Float, b: Float, a: Float)
extern effect fn note(i: Item, message: Text)
extern effect fn delete(i: Item)
extern effect fn flag(name: Text) -> Bool
