// An object's behavior, the way Artifice's nodes say it: each event is a function the engine calls.
// The object's own variables are a record: start gives the first one, update the next.
type Ship { speed: Float, laps: Int }

effect fn start(self: Object) -> Ship {
    setColor(self, 0.9, 0.7, 0.2, 1.0)
    say(self, "ready")
    Ship(speed: 120, laps: 0)
}

effect fn update(self: Object, ship: Ship, dt: Float) -> Ship {
    let at = position(self)
    if at.x > 300 {
        moveTo(self, Vec2(0, at.y))
        return Ship(speed: ship.speed * 1.5, laps: ship.laps + 1)
    }
    let boost = if keyDown("space") { 2 } else { 1 }
    moveBy(self, ship.speed * boost * dt, 0)
    ship
}

effect fn hit(self: Object, other: Object) {
    if other != self {
        say(self, "hit")
        destroy(other)
    }
}
