// Exam scores: how they spread, counted into grades and into bands of ten points.
type Student { name: Text, score: Int }
enum Grade { A, B, C, D, F }

fn grade(score: Int) -> Grade = match score {
    90.. => Grade.A
    80..90 => Grade.B
    70..80 => Grade.C
    60..70 => Grade.D
    _ => Grade.F
}

// a made-up class: scores from a fixed sequence, between 35 and 100
fn testClass(size: Int) -> [Student] =
    (0..size).map(i => Student("student{i}", 35 + (i * 2654435761 + 12345) / 7 % 66))

// how many students fall in each band of ten points, and in each grade
fn bands(students: [Student]) -> [Int] {
    var counts = fill(11, 0)
    for s in students {
        counts[s.score / 10] += 1
    }
    counts
}

fn grades(students: [Student]) -> [Int] {
    var counts = fill(5, 0)
    for s in students {
        counts[grade(s.score).index()] += 1
    }
    counts
}

fn main() {
    let students = testClass(1000)
    let scores = students.map(s => s.score)
    let average = scores.mean()
    let byBand = bands(students)
    let busiest = (0..11).maxBy(b => byBand[b])
    print("students", len(students), "average", average, "best", scores.max(), "worst", scores.min())
    print("grades A to F", grades(students))
    print("most scores between", busiest * 10, "and", busiest * 10 + 9, "with", byBand[busiest])
    print("everyone passed:", students.all(s => s.score >= 60))
}
