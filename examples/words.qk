// The most used words of a text: a file named on the command line (quark run examples/words.qk -- notes.txt),
// or a short one of its own.
const sample = "The fox saw the dog. The dog saw the fox, and the fox ran."

fn clean(word: Text) -> Text = word.replace(",", "").replace(".", "")

fn source() -> Text! {
    let path = args().first() ?? return sample
    readFile(path)
}

fn main() {
    let text = match source() {
        Ok(t) => t
        Err(why) => {
            printErr(why)
            exit(1)
        }
    }
    let counts = text
        .lower()
        .words()
        .map(clean)
        .filter(w => len(w) > 0)
        .countBy(w => w)
    print("{len(counts)} different words, {len(text.words())} in all")
    for (i, e) in counts.sortedBy(e => e.value, descending: true).take(4).enumerate() {
        print("{i + 1:2}. {e.key:5} {e.value:2} {"#" * e.value}")
    }
}
