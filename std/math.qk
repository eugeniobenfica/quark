// Math beyond the built-ins: pi and tau, and Vec2 and Vec3 with their operators, length, dot, cross, lerp.
pub type Vec2 { x: Float, y: Float }
pub type Vec3 { x: Float, y: Float, z: Float }

pub fn Vec2.plus(self, b: Vec2) -> Vec2 = Vec2(self.x + b.x, self.y + b.y)

pub fn Vec2.minus(self, b: Vec2) -> Vec2 = Vec2(self.x - b.x, self.y - b.y)

pub fn Vec2.times(self, k: Float) -> Vec2 = Vec2(self.x * k, self.y * k)

pub fn Vec2.div(self, k: Float) -> Vec2 = Vec2(self.x / k, self.y / k)

pub fn Vec2.negate(self) -> Vec2 = Vec2(-self.x, -self.y)

pub fn Vec2.dot(self, b: Vec2) -> Float = self.x * b.x + self.y * b.y

pub fn Vec2.length(self) -> Float = sqrt(self.x * self.x + self.y * self.y)

pub fn Vec2.distance(self, b: Vec2) -> Float = (self - b).length()

pub fn Vec2.normalized(self) -> Vec2 {
    let n = self.length()
    if n == 0 { self } else { self / n }
}

pub fn Vec2.lerp(self, b: Vec2, t: Float) -> Vec2 = self + (b - self) * t

pub fn Vec2.angle(self) -> Float = atan2(self.y, self.x)

pub fn Vec2.rotated(self, radians: Float) -> Vec2 {
    let c = cos(radians)
    let s = sin(radians)
    Vec2(self.x * c - self.y * s, self.x * s + self.y * c)
}

pub fn Vec3.plus(self, b: Vec3) -> Vec3 = Vec3(self.x + b.x, self.y + b.y, self.z + b.z)

pub fn Vec3.minus(self, b: Vec3) -> Vec3 = Vec3(self.x - b.x, self.y - b.y, self.z - b.z)

pub fn Vec3.times(self, k: Float) -> Vec3 = Vec3(self.x * k, self.y * k, self.z * k)

pub fn Vec3.div(self, k: Float) -> Vec3 = Vec3(self.x / k, self.y / k, self.z / k)

pub fn Vec3.negate(self) -> Vec3 = Vec3(-self.x, -self.y, -self.z)

pub fn Vec3.dot(self, b: Vec3) -> Float = self.x * b.x + self.y * b.y + self.z * b.z

pub fn Vec3.cross(self, b: Vec3) -> Vec3 =
    Vec3(self.y * b.z - self.z * b.y, self.z * b.x - self.x * b.z, self.x * b.y - self.y * b.x)

pub fn Vec3.length(self) -> Float = sqrt(self.dot(self))

pub fn Vec3.normalized(self) -> Vec3 {
    let n = self.length()
    if n == 0 { self } else { self / n }
}

pub fn Vec3.lerp(self, b: Vec3, t: Float) -> Vec3 = self + (b - self) * t

pub const pi = 3.141592653589793
pub const tau = 6.283185307179586
