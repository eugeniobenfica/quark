// Paths as text: joined, taken apart and normalized. Both / and \ separate parts, and a drive (C:) or a
// leading separator makes a path absolute; the paths given back use /, and windowsPath turns them to \.
//
// joinPath(a, b): b after a, with one separator between; an absolute b stands alone
pub fn joinPath(a: Text, b: Text) -> Text {
    if a == "" or isAbsolutePath(b) {
        return b
    }
    if b == "" {
        return a
    }
    if a.endsWith("/") or a.endsWith("\\") { a + b } else { a + "/" + b }
}

// the path without "." parts, separators doubled or at the end, or a part followed by ".." (at the root,
// ".." stays there); "a/./b/../c/" is "a/c", and an empty path is "."
pub fn normalizePath(path: Text) -> Text {
    let r = root(path)
    var parts: [Text] = []
    for p in partsOf(path[len(r)..]) {
        if p == ".." and len(parts) > 0 and parts[len(parts) - 1] != ".." {
            parts = parts[..len(parts) - 1]
        } else if p == ".." and r.endsWith("/") {
            continue
        } else {
            parts.push(p)
        }
    }
    let rest = parts.join("/")
    if r == "" and rest == "" { "." } else { r + rest }
}

// the parts after the root: "/usr/lib/" is ["usr", "lib"]
pub fn pathParts(path: Text) -> [Text] {
    let n = normalizePath(path)
    if n == "." { [] } else { partsOf(n[len(root(n))..]) }
}

// the folder the path is in: "a/b/c.txt" is "a/b", "c.txt" is ".", and a root is itself
pub fn parentPath(path: Text) -> Text {
    let n = normalizePath(path)
    let r = root(n)
    let parts = partsOf(n[len(r)..])
    if len(parts) == 0 {
        return if r == "" { ".." } else { r }
    }
    if parts[len(parts) - 1] == ".." {
        return n + "/.."
    }
    let up = r + parts[..len(parts) - 1].join("/")
    if up == "" { "." } else { up }
}

// the last part: "a/b/c.txt" is "c.txt", and a root has none ("")
pub fn fileName(path: Text) -> Text {
    let parts = pathParts(path)
    if len(parts) == 0 { "" } else { parts[len(parts) - 1] }
}

// the file name's text after its last dot, without it: "a/b.tar.gz" is "gz"; ".profile" and "make" have none
pub fn fileExtension(path: Text) -> Text = splitName(fileName(path)).1

// the file name without its extension: "a/b.tar.gz" is "b.tar"
pub fn fileStem(path: Text) -> Text = splitName(fileName(path)).0

// the path with its file name's extension changed (or added, or taken away with "")
pub fn withExtension(path: Text, ext: Text) -> Text {
    let old = fileName(path)
    if old == "" or old == ".." {
        return normalizePath(path)
    }
    let name = fileStem(path) + (if ext == "" { "" } else { "." + ext })
    let up = parentPath(path)
    if up == "." { name } else { joinPath(up, name) }
}

// whether it starts at a root: "/x", "\x", "C:/x", "C:\x"
pub fn isAbsolutePath(path: Text) -> Bool = root(path).endsWith("/")

// the path with \ between its parts, as Windows writes it
pub fn windowsPath(path: Text) -> Text = path.replace("/", "\\")

// a file name before and after its last dot: "b.tar.gz" is ("b.tar", "gz"), ".profile" is (".profile", "")
fn splitName(name: Text) -> (Text, Text) {
    let dots = name.split(".")
    let dot = len(name) - len(dots[len(dots) - 1]) - 1
    if dot <= 0 or name == ".." {
        (name, "")
    } else {
        (name[..dot], name[dot + 1..])
    }
}

fn isSeparator(c: Int) -> Bool = c is '/' | '\\'

// where the path starts, written with /: "/", "C:/", "C:" (a drive's current folder), or "" (relative)
fn root(path: Text) -> Text {
    let b = path.bytes()
    if len(b) >= 2 and b[1] == ':' and b[0] is 'a'..='z' | 'A'..='Z' {
        return if len(b) >= 3 and isSeparator(b[2]) {
            path[..2] + "/"
        } else {
            path[..2]
        }
    }
    if len(b) >= 1 and isSeparator(b[0]) { "/" } else { "" }
}

// the parts between separators, without empty ones and "."
fn partsOf(path: Text) -> [Text] =
    path.replace("\\", "/").split("/").filter(p => p != "" and p != ".")
