// Syntax errors: each is said, and what could be read is still a program (a hole where a statement could not be read,
// a declaration left out when its own lines could not be).
fn half(n: Int) -> Int {
    let a = n +
    let b = (n * 2
    a / 2
}

fn ok(n: Int) -> Int = n + 1

fn broken(x: Int -> Int {
    x
}

fn main() {
    print(ok(1))
    let s = [1, 2
    print(s)
