// Tasks in the background (go, runTasks) and channels: workers that send what they make, a receive that runs the
// tasks until a text comes, sleeps that let the others go on, a channel closed when its last text is sent.
fn worker(id: Int, results: Channel) {
    for k in 0..3 {
        send(results, "{id}:{k}")
        yield()
    }
}

fn main() {
    let results = channel()
    for id in 0..4 {
        go(() => worker(id, results))
    }
    var got: [Text] = []
    for _ in 0..12 {
        got.push(receive(results) ?? "?")
    }
    print(got.sorted())
    // a pipeline: numbers through a channel, squared in another task, summed here
    let numbers = channel()
    let squares = channel()
    go(() => {
        for i in 1..11 {
            send(numbers, "{i}")
        }
        closeChannel(numbers)
    })
    go(() => {
        while receive(numbers) is Some(t) {
            let n = t.parseInt() ?? 0
            send(squares, "{n * n}")
        }
        closeChannel(squares)
    })
    var total = 0
    while receive(squares) is Some(t) {
        total += t.parseInt() ?? 0
    }
    print(total)
    // sleeps: the one that sleeps less says first
    let order = channel()
    go(() => {
        sleep(0.06)
        send(order, "slow")
    })
    go(() => {
        sleep(0.01)
        send(order, "quick")
    })
    runTasks()
    closeChannel(order)
    print(receive(order), receive(order), receive(order))
}
