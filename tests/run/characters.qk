// Characters are Ints ('a', '\n', '\u{20AC}'); texts take \0 \x41 \u{...} (the formatter writes back only what
// cannot be seen), raw texts take nothing, and patterns take inclusive ranges ('a'..='z').
fn kind(c: Int) -> Text = match c {
    'a'..='z' | 'A'..='Z' => "letter"
    '0'..='9' => "digit"
    ' ' | '\t' | '\n' => "space"
    0x80.. => "beyond ASCII"
    _ => "other"
}

fn main() {
    print('a', 'Z' - 'A', '\n', '\t', '\\', '\'', '"', '\0', '\x41', '\u{20AC}', '€', '😀')
    print("tab\there", "nul[\0]", "zero\u{200B}width", len("\u{200B}"), "été" == "été", len("€"))
    print(r"C:\path\to\file", r"no {values} here", r"\d+\.\d+", len(r"\n"))
    let poem = r"""
        a raw text: \n stays two characters,
        "quotes" and {braces} too
        """
    print(poem)
    print(char('a'), char(0x20AC) + char(0x1F600), char(10) == "\n")
    print("aé€😀".codePoints().toArray(), "ação".codePoints().count(c => c > 127), len("ação".codePoints()))
    var shifted = ""
    for c in "Hal".codePoints() {
        shifted += char(c + 1)
    }
    print(shifted, "".codePoints().toArray(), "日本".codePoints().map(c => char(c)).toArray())
    print("x1 ?".bytes().map(kind).toArray(), kind('é'), kind(0xe9))
    let grade = match 85 {
        90..=100 => "A"
        80..=89 => "B"
        _ => "C"
    }
    print(grade, 'q' is 'a'..='z', 5 is 0..=4)
}
