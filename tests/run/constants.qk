// Constants: worked out when the program is compiled, once; an array of numbers kept in the program's data.
const base = 10
const scale = base * 2.5
const table = [1, 2, 3, base]
const floats: [Float] = [1, 2.5]
const name = "q" + "uark"
const title = "{name} v{base / 3}"
const big = if base > 5 { "big" } else { "small" }

fn main() {
    var t = table
    t[0] = 99
    print(scale, table, t, floats, title, big, len(name), table.sum())
}
