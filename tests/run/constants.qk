// Constants: worked out when the program is compiled, once; an array of numbers kept in the program's data.
const base = 10
const scale = base * 2.5
const table = [1, 2, 3, base]
const floats: [Float] = [1, 2.5]
const name = "q" + "uark"
const title = "{name} v{base / 3}"
const big = if base > 5 { "big" } else { "small" }

// match, is, ??, min, max, abs and arrays joined work out too
const joined = table + [20]
const graded = grade(85)
const isLetter = 'q' is 'a'..='z'
const fallback = Some(3) ?? 0
const bounds = (min(1, 2.5), max(-4, abs(-7)))

enum Grade { A, B, C }

fn grade(n: Int) -> Grade = match n {
    90.. => .A
    80..90 => .B
    _ => .C
}

fn main() {
    var t = table
    t[0] = 99
    print(scale, table, t, floats, title, big, len(name), table.sum())
    print(joined, graded, isLetter, fallback, bounds)
}
