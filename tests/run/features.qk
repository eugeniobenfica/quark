type Point { x: Float, y: Float }
type Vec2 { x: Float, y: Float }
type Particle { position: Vec2, velocity: Vec2, alive: Bool }
enum Weekday { Monday, Tuesday, Wednesday, Thursday }

fn fib(n: Int) -> Int {
    if n < 2 {
        return n
    }
    fib(n - 1) + fib(n - 2)
}

fn Vec2.plus(self, b: Vec2) -> Vec2 = Vec2(self.x + b.x, self.y + b.y)

fn Vec2.times(self, k: Float) -> Vec2 = Vec2(self.x * k, self.y * k)

fn Vec2.dot(self, b: Vec2) -> Float = self.x * b.x + self.y * b.y

fn Vec2.length(self) -> Float = sqrt(self.dot(self))

fn mid(a: Point, b: Point) -> Point = Point((a.x + b.x) / 2, (a.y + b.y) / 2)

fn step(p: Particle, dt: Float) -> Particle =
    Particle(position: p.position + p.velocity * dt, velocity: p.velocity * 0.5, alive: p.alive)

fn dayNumber(d: Weekday) -> Int = match d {
    Monday => 1
    Tuesday => 2
    _ => 0
}

fn collatz(start: Int) -> Int {
    var n = start
    var steps = 0
    while n != 1 {
        n = if n % 2 == 0 { n / 2 } else { 3 * n + 1 }
        steps += 1
    }
    steps
}

fn main() {
    print(fib(20), collatz(27))
    let m = mid(Point(0, 0), Point(x: 4, y: 2.5))
    print(m, m.x)
    var p = Particle(Vec2(0, 0), Vec2(10, 4), true)
    for i in 0..3 {
        p = step(p, 1.0)
    }
    print(p)
    print(Weekday.Tuesday, dayNumber(Weekday.Tuesday), dayNumber(Weekday.Thursday))
    var counts = [0] * 5
    for v in [1, 3, 3, 4, 1, 1] {
        counts[v] += 1
    }
    print(counts, len(counts))
    var h = [0] * 10
    for i in 0..1000 {
        h[i % 10] += 1
    }
    print(h)
    let total = (1..11).fold(1, (acc, x) => acc * x)
    print(total, [2.5, -1.0, 9.0].max(), [4, 2, 8].min(), max(3, 7.5))
    print((0..10).any(x => x > 8), (0..10).all(x => x < 5))
    var v = Vec2(1, 2)
    v = Vec2(v.y, v.x)
    v *= 3
    print(v, length(Vec2(3, 4)), dot(v, v))
    let words = [Weekday.Monday, Weekday.Wednesday]
    print(words, round(2.5), floor(-2.5), ceil(2.1), abs(-3), clamp(15, 0, 10))
    let squares = (0..5).enumerate().map((i, x) => x * i)
    print(squares, squares[4])
    let copied = counts
    counts[0] = 99
    print(copied[0], counts[0])
    for (i, x) in [10, 20, 30].enumerate() {
        if i == 1 {
            continue
        }
        print(i, x)
    }
}
