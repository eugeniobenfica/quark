// Generic types: records and enums with type parameters, made for each list of types they are given.
type Pair<A, B> { first: A, second: B }
enum Tree<T> { Leaf, Node(left: Tree<T>, value: T, right: Tree<T>) }
type Stack<T> { items: [T] }

fn Pair.swap(self) -> Pair<B, A> = Pair(self.second, self.first)

fn insert<T>(t: Tree<T>, v: T) -> Tree<T> = match t {
    Leaf => Tree.Node(Tree.Leaf, v, Tree.Leaf)
    Node(l, x, r) => if v < x {
        Tree.Node(insert(l, v), x, r)
    } else {
        Tree.Node(l, x, insert(r, v))
    }
}

fn inOrder<T>(t: Tree<T>) -> [T] = match t {
    Leaf => []
    Node(l, x, r) => inOrder(l) + [x] + inOrder(r)
}

fn depth<T>(t: Tree<T>) -> Int = match t {
    Leaf => 0
    Node(l, _, r) => 1 + max(depth(l), depth(r))
}

fn Stack.push(self, x: T) -> Stack<T> = Stack(self.items + [x])

fn main() {
    let p = Pair(1, "one")
    print(p, p.swap(), p.first + 1, p.second)
    var t: Tree<Int> = Tree.Leaf
    for v in [5, 2, 8, 1, 9, 3] {
        t = insert(t, v)
    }
    print(inOrder(t), depth(t))
    var words: Tree<Text> = Tree.Leaf
    for w in split("pear apple fig", " ") {
        words = insert(words, w)
    }
    print(inOrder(words))
    let s = Stack([1.5]).push(2.5).push(4)
    print(s.items, len(s.items))
    let pairs = [Pair("a", 1), Pair("b", 2)]
    print(pairs.map(q => q.second).sum(), pairs[1] == Pair("b", 2))
}
