// Typed JSON: a program's records, enums, arrays, maps, optionals and tuples written as JSON and read back by their
// types (std.json's encode and decode, made for each type).
use std.json

type Box<T> { value: T, label: Text }
enum Shape { Dot, Circle(radius: Float), Rect(w: Int, h: Int) }
type Pet { name: Text, age: Int }

type Person {
    name: Text
    age: Int
    tags: [Text]
    pet: Pet?
    shapes: [Shape]
    scores: [Text: Int]
    port: Int = 8080
    pair: (Int, Text)
    ok: Bool
}

fn main() {
    let p = Person(
        "Ana",
        34,
        ["x", "y"],
        Some(Pet("Rex", 3)),
        [.Dot, .Circle(1.5), .Rect(2, 3)],
        ["a": 1],
        9,
        (7, "z"),
        true,
    )
    let text = encodeJson(p)
    print(text)
    let back: Person = decodeJson(text)?
    print(back == p, back)
    let short: Person = decodeJson(
        "\{\"name\":\"Bo\",\"age\":5,\"tags\":[],\"shapes\":[\"Dot\"],\"scores\":\{\},\"pair\":[1,\"a\"],\"ok\":false\}",
    )?
    print(short.port, short.pet)
    let bad: Person! = decodeJson("\{\"name\":\"Bo\",\"age\":\"five\"\}")
    print(bad)
    let xs: [Int] = decodeJson("[1, 2, 3]")?
    print(xs, encodeJson([1.5, 2.0]), encodeJson(["k": [true]]))
    let b: Box<Int> = decodeJson(encodeJson(Box(3, "n")))?
    let m: [Int: [Box<Text>]] = decodeJson("\{\"1\": [\{\"value\": \"a\", \"label\": \"l\"\}]\}")?
    print(b, m)
    let wrong: [Shape]! = decodeJson("[\"Dot\", \"Hexagon\"]")
    print(wrong)
}
