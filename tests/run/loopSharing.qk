// What a loop's collections copy keeps its sharing: one array held twice, slices of one array (the same start,
// other lengths; other starts), texts cut from one text, a record holding them; turn after turn, collection after
// collection (each copied block is found again by where it was).
type Pair { whole: [Int], part: [Int], word: Text }

fn main() {
    var held: [[Int]] = []
    var pairs: [Pair] = []
    var words: [Text] = []
    var total = 0
    for i in 0..300_000 {
        let a = [i, i + 1, i + 2, i + 3, i + 4]
        held.push(a)
        held.push(a[0..3]) // the same start, shorter
        held.push(a) // the same, again
        held.push(a[2..5]) // another start
        let t = "w{i}-{i * 3}"
        words.push(t[0..2])
        words.push(t)
        pairs.push(Pair(a, a[1..2], t[1..]))
        if len(held) > 4000 {
            for h in held {
                total += h[0] + len(h)
            }
            for w in words {
                total += len(w)
            }
            for p in pairs {
                total += p.whole[4] + p.part[0] + len(p.word)
            }
            held = held[2000..]
            words = words[1000..]
            pairs = pairs[500..]
        }
    }
    print(total, len(held), len(words), len(pairs), held[len(held) - 1], words[len(words) - 1])
    print(pairs[0].whole, pairs[0].part, pairs[0].word)
}
