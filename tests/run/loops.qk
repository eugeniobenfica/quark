// Fused loops: a let used once is folded into its use; used twice, it is kept as an array.
fn main() {
    let squares = (1..6).map(x => x * x)
    print(squares.sum())
    let kept = (0..5).map(x => x * 2)
    print(kept, kept.sum(), len(kept))
    let odd = (0..20).filter(x => x % 2 == 1).map((x, i) => x * 100 + i)
    print(odd)
    var found = -1
    for x, i in (10..100).filter(x => x % 7 == 0) {
        if x > 40 {
            found = i
            break
        }
    }
    print(found)
    var n = 0
    while true {
        n += 1
        if n % 2 == 0 {
            continue
        }
        if n > 9 {
            break
        }
    }
    print(n)
    print((0..0).sum(), (5..2).map(x => x).len(), [1.5, 2.5].fold(0.0, (a, x) => a + x))
}
