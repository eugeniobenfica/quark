// xs = xs.map(f) on a var, written in place: a let that kept the old value keeps it, a lambda that reads xs or
// captured it sees the old one, records of numbers too; many maps over a large array.
type P { x: Float, y: Float }

fn main() {
    var xs = (0..10).toArray()
    let kept = xs
    xs = xs.map(x => x * x)
    print(xs, kept)
    var ps = [P(1.0, 2.0), P(3.0, 4.0)]
    ps = ps.map(p => P(p.y, p.x + 1.0))
    print(ps)
    // reads xs inside: not in place, every value from the old xs
    var ys = [1, 2, 3]
    ys = ys.map(y => y + ys[0])
    print(ys)
    var zs = [5, 6]
    let f = () => zs[0]
    zs = zs.map(z => z + 1)
    print(zs, f())
    var big = (0..1000000).toArray()
    for _ in 0..50 {
        big = big.map(v => v + 1)
    }
    print(big[0], big[999999])
}
