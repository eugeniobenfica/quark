// Built-ins take named values, in their order; get gives None outside the array; len counts.
fn main() {
    let xs = [3, 1, 2]
    print("a,b".split(separator: ","), xs.sorted(descending: true), clamp(5, low: 0, high: 3))
    print(xs.get(1), xs.get(3), xs.get(-1), ["a", "b"].get(0), len(xs), xs.map(x => x * 2).len())
}
