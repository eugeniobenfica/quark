// std.path: paths joined, taken apart and normalized, with / and \ separators.
use std.path

fn main() {
    print(
        joinPath("a/b", "c.txt"),
        joinPath("a/b/", "c"),
        joinPath("a", "/etc"),
        joinPath("C:\\x", "y"),
        joinPath("", "z"),
    )
    for p in ["a/./b/../c/", "/../x//y/.", "../../a", "a/..", "", "C:\\Users\\..\\Temp\\", "C:x\\..\\..", "./"] {
        print("\"{p}\" -> \"{normalizePath(p)}\"", pathParts(p))
    }
    for p in ["a/b/c.txt", "c.txt", "/", "/usr", "..", "C:\\docs\\é.tar.gz", ".profile", "make", "notes."] {
        print(
            p,
            "|",
            parentPath(p),
            "|",
            fileName(p),
            "|",
            fileExtension(p),
            "|",
            fileStem(p),
            "|",
            withExtension(p, "md"),
        )
    }
    print(
        isAbsolutePath("/x"),
        isAbsolutePath("\\x"),
        isAbsolutePath("C:/x"),
        isAbsolutePath("C:x"),
        isAbsolutePath("x/y"),
    )
    print(windowsPath(normalizePath("C:/a//b/./c")), withExtension("a/b.txt", ""))
}
