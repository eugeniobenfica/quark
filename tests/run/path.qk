// std.path: paths joined, taken apart and normalized, with / and \ separators.
use std.path

fn main() {
    print(joinPath("a/b", "c.txt"), joinPath("a/b/", "c"), joinPath("a", "/etc"), joinPath("C:\\x", "y"), joinPath("", "z"))
    for p in ["a/./b/../c/", "/../x//y/.", "../../a", "a/..", "", "C:\\Users\\..\\Temp\\", "C:x\\..\\..", "./"] {
        print("\"{p}\" -> \"{normalize(p)}\"", pathParts(p))
    }
    for p in ["a/b/c.txt", "c.txt", "/", "/usr", "..", "C:\\docs\\é.tar.gz", ".profile", "make", "notes."] {
        print(p, "|", parent(p), "|", fileName(p), "|", extension(p), "|", stem(p), "|", withExtension(p, "md"))
    }
    print(isAbsolute("/x"), isAbsolute("\\x"), isAbsolute("C:/x"), isAbsolute("C:x"), isAbsolute("x/y"))
    print(windowsPath(normalize("C:/a//b/./c")), withExtension("a/b.txt", ""))
}
