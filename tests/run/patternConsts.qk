// A constant's name in a pattern compares the value with the constant (any other name is the value, named), and a
// T?! is a result whose value may be missing: Ok(Some(x)), Ok(None), Err(why), taken apart by ?, ?? and match.
const zero = 0
const limit = 10
const greeting = "hello"

enum Color { Red, Green, Blue }

const favorite = Color.Green

fn size(n: Int) -> Text = match n {
    zero => "none"
    limit => "the limit"
    k if k > limit => "past it: {k}"
    k => "some: {k}"
}

fn kind(t: Text) -> Text = match t {
    greeting => "a greeting"
    other => "else: {other}"
}

fn liked(c: Color) -> Bool = match c {
    favorite => true
    _ => false
}

fn firstEven(xs: [Int]) -> Int?! {
    for x in xs {
        if x < 0 {
            return Err("negative: {x}")
        }
        if x % 2 == 0 {
            return Ok(Some(x))
        }
    }
    Ok(None)
}

fn twice(xs: [Int]) -> Int?! {
    let v = firstEven(xs)?
    Ok(if v is Some(n) { Some(2 * n) } else { None })
}

fn main() {
    print(size(0), size(10), size(12), size(3))
    print(kind("hello"), kind("bye"), liked(.Green), liked(.Red))
    print(firstEven([1, 3, 4]), firstEven([1, 3]), firstEven([1, -2]))
    print(twice([5, 6]), twice([1]), twice([-1]))
    for xs in [[7, 8], [7], [-7]] {
        print(match firstEven(xs) {
            Ok(Some(n)) => "found {n}"
            Ok(None) => "none"
            Err(why) => "error: {why}"
        })
    }
    let r: Text?! = Ok(None)
    print(r, r ?? Some("x") ?? "y")
}
