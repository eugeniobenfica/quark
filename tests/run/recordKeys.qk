// Records of one or two Ints (and tuples) as a map's keys: a grid's cells, pairs.
type Cell { x: Int, y: Int }
enum Tile { Wall, Floor, Door }

fn neighbours(c: Cell) -> [Cell] =
    [Cell(c.x + 1, c.y), Cell(c.x - 1, c.y), Cell(c.x, c.y + 1), Cell(c.x, c.y - 1)]

fn main() {
    var grid: [Cell: Tile] = [:]
    for y in 0..3 {
        for x in 0..3 {
            grid[Cell(x, y)] = if x == 1 and y == 1 { .Door } else { .Floor }
        }
    }
    grid[Cell(2, 2)] = .Wall
    print(len(grid), grid[Cell(1, 1)], grid[Cell(5, 5)], grid.contains(Cell(2, 2)))
    let around = neighbours(Cell(1, 1)).count(n => grid.contains(n))
    var seen: [(Int, Int): Int] = [:]
    for i in 0..10 {
        seen[(i % 3, i % 2)] = (seen[(i % 3, i % 2)] ?? 0) + 1
    }
    print(around, len(seen), seen[(0, 0)], seen.keys()[0])
    grid.remove(Cell(0, 0))
    print(len(grid), grid.keys()[0])
}
