// Sets: each value once, in the order they came; add, remove, contains, | & -, loops over them.
fn main() {
    var seen: Set<Text> = ["a", "b"]
    seen.add("c")
    seen.add("a")
    let other: Set<Text> = ["b", "c", "d"]
    print(seen, len(seen), contains(seen, "b"), contains(seen, "z"))
    print(seen | other, seen & other, seen - other, other.filter(x => x != "d").toArray())
    seen.remove("a")
    for x in seen {
        print(x)
    }
    let empty: Set<Int> = []
    print(empty, [3, 1, 3, 2, 1].toSet(), words("to be or not to be").toSet().len())
}
