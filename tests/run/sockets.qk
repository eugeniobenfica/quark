// TCP and HTTP in one program: a server whose connections each run in a task of their own, clients in tasks too,
// every read and write waiting only on its own socket; std.http's server and client; the errors connect gives.
use std.net
use std.http

fn shout(s: Socket) {
    var c = conn(s)
    while c.readLine() is Some(line) {
        let _ = c.write(line.upper() + "\n")
    }
    c.close()
}

fn route(r: Request) -> Response = match r.path {
    "/hello" => textResponse("hello, {r.query["name"] ?? "world"}")
    "/echo" => textResponse("{r.method} {len(r.body)} bytes: {r.text()}")
    _ => textResponse("no page {r.path}", status: 404)
}

fn main() {
    let server = listen("127.0.0.1", 47911)?
    go(() => {
        for _ in 0..3 {
            let s = accept(server) ?? panic("accept")
            go(() => shout(s))
        }
    })
    let answers: Channel<Text> = channel()
    for name in ["ana", "bia", "caio"] {
        go(() => {
            var c = conn(connect("127.0.0.1", 47911) ?? panic("connect"))
            let _ = c.write("hello from {name}\nbye {name}\n")
            let first = c.readLine() ?? "?"
            let second = c.readLine() ?? "?"
            c.close()
            send(answers, "{first} / {second}")
        })
    }
    runTasks()
    closeSocket(server)
    closeChannel(answers)
    var said: [Text] = []
    while receive(answers) is Some(a) {
        said.push(a)
    }
    print(said.sorted())
    let web = listen("127.0.0.1", 47912)?
    go(() => {
        for _ in 0..4 {
            let s = accept(web) ?? panic("accept")
            go(() => handleConnection(s, route))
        }
    })
    let out: Channel<Text> = channel()
    for path in ["/hello?name=Ana%20Lu", "/hello", "/x"] {
        go(() => {
            send(out, match get("http://127.0.0.1:47912{path}") {
                Ok(r) => "{r.status} {r.headers["content-type"] ?? "?"} {r.text()}"
                Err(why) => "error: {why}"
            })
        })
    }
    go(() => {
        send(out, match post("http://127.0.0.1:47912/echo", "a body".bytes(), contentType: "text/plain") {
            Ok(r) => "{r.status} {r.text()}"
            Err(why) => "error: {why}"
        })
    })
    runTasks()
    closeSocket(web)
    closeChannel(out)
    var pages: [Text] = []
    while receive(out) is Some(p) {
        pages.push(p)
    }
    for p in pages.sorted() {
        print(p)
    }
    // bodies in chunks (Transfer-Encoding: chunked): a response read by get, a request read by handleConnection
    let raw = listen("127.0.0.1", 47914)?
    go(() => {
        var c = conn(accept(raw) ?? panic("accept"))
        let _ = c.readUntil("\r\n\r\n".bytes())
        let _ = c.write(
            "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n5;x=1\r\nhello\r\nB\r\n, in chunks\r\n0\r\nx-end: 1\r\n\r\n",
        )
        c.close()
        handleConnection(accept(raw) ?? panic("accept"), route)
    })
    let chunked: Channel<Text> = channel()
    go(() => {
        send(chunked, match get("http://127.0.0.1:47914/") {
            Ok(r) => "{r.status} {r.text()}"
            Err(why) => "error: {why}"
        })
        var c = conn(connect("127.0.0.1", 47914) ?? panic("connect"))
        let _ = c.write(
            "POST /echo HTTP/1.1\r\nhost: x\r\ntransfer-encoding: chunked\r\n\r\n3\r\nabc\r\n4\r\ndefg\r\n0\r\n\r\n",
        )
        let text = Text(c.readAll() ?? []) ?? ""
        send(chunked, text.split("\r\n\r\n")[1])
        c.close()
    })
    runTasks()
    closeSocket(raw)
    closeChannel(chunked)
    while receive(chunked) is Some(line) {
        print(line)
    }
    print(
        parseUrl("https://example.com"),
        get("ftp://example.com") is Err(_),
        parseUrl("http://h:8080/a?b=1"),
        connect("127.0.0.1", 47913) is Err(_),
    )
}
