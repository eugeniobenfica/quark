// Tasks: functions that run a step at a time, giving the turn back with yield; the caller decides when they go on.
fn countdown(name: Text, from: Int) {
    for i in 0..from {
        print(name, from - i)
        yield()
    }
    print(name, "done")
}

fn fib(n: Int) -> Int = if n < 2 { n } else { fib(n - 1) + fib(n - 2) }

fn main() {
    let a = spawn(() => countdown("a", 3))
    let b = spawn(() => countdown("b", 2))
    var aGoes = true
    var bGoes = true
    while aGoes or bGoes {
        if aGoes {
            aGoes = step(a)
        }
        if bGoes {
            bGoes = step(b)
        }
    }
    var produced: [Int] = []
    let gen = spawn(() => {
        for n in 0..5 {
            print("making", fib(n + 20))
            yield()
        }
    })
    var steps = 0
    while step(gen) {
        steps += 1
    }
    print("steps", steps)
    let t0 = monotonicTime()
    let sleeper = spawn(() => sleep(0.05))
    var turns = 0
    while step(sleeper) {
        turns += 1
    }
    print(monotonicTime() - t0 >= 0.05, turns > 0)
    let joined: Task = spawn(() => countdown("joined", 1))
    joinTask(joined)
    // joinTask waits only while the task sleeps: a task that only yields runs its turns back to back
    let t1 = monotonicTime()
    joinTask(spawn(() => {
        for _ in 0..2000 {
            yield()
        }
    }))
    let napper = spawn(() => sleep(0.05))
    joinTask(napper)
    let took = monotonicTime() - t1
    print(took >= 0.05, took < 1.0)
}
