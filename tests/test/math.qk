// Tests: each runs on its own; a failed assert or a panic fails only that one.
fn gcd(a: Int, b: Int) -> Int = if b == 0 { a } else { gcd(b, a % b) }

fn mean(xs: [Float]) -> Float? = if len(xs) == 0 { None } else { xs.sum() / len(xs) }

test "gcd of two numbers" {
    assert(gcd(12, 18) == 6)
    assert(gcd(7, 3) == 1, "seven and three share nothing")
}

test "the mean of nothing is None" {
    assert((mean([]) ?? -1.0) == -1.0)
    let m = mean([1.0, 2.0, 3.0])?
    assert(m == 2.0)
}

test "a wrong expectation fails" {
    assert(gcd(10, 4) == 3, "gcd(10, 4) is {gcd(10, 4)}, not 3")
}

test "an index out of range fails too" {
    let xs = [1, 2]
    print(xs[5])
}
