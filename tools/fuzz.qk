// Fuzzing the front end: the programs of the tests, changed at random (lines dropped, doubled or swapped, a piece cut,
// bytes put in), given to quark check, quark fmt and the graph's round trip. Whatever the input, the compiler must
// answer (exit 0, 1 or 2: never a crash), quark fmt must be stable (its text formatted again is the same), and a
// program that checks must come back from its graph as quark fmt writes it. Every fourth case is a C header changed
// the same way (with C's pieces), given to quark bind: it must answer too, and what it writes is Quark in its
// canonical form. A case that fails is kept, with its seed.
//   quark run tools/fuzz.qk -- QUARK [COUNT] [FIRST_SEED]
type Rng { s: Int }

fn Rng.next(var self) -> Int {
    var x = self.s
    x = x ^ x >> 12
    x = x ^ x << 25
    x = x ^ x >> 27
    self.s = x
    x *% 2685821657736338717 & 0x7FFFFFFFFFFFFFFF
}

fn Rng.below(var self, n: Int) -> Int = if n <= 0 { 0 } else { self.next() % n }

const pieces = [
    "{", "}",
    "(",
    ")",
    "[",
    "]",
    ",",
    ".",
    "?",
    "!",
    "=>",
    "->",
    "..",
    "|",
    "\"",
    "'",
    "fn",
    "let",
    "match",
    "_",
    "\n",
    " ",
]

// C's pieces, for quark bind's headers
const cPieces = [
    "{", "}",
    "(",
    ")",
    "[",
    "]",
    ";",
    ",",
    "*",
    "&",
    "=",
    "#define X ",
    "#define F(a, b) ((a) + (b))",
    "typedef ",
    "struct ",
    "union ",
    "enum ",
    "const ",
    "unsigned ",
    "long ",
    "void ",
    "int ",
    "char *",
    "...",
    "\\\n",
    "/*",
    "*/",
    "//",
    "\n",
    " ",
    "0x7f",
    "1.5f",
    "\"text\"",
    "'c'",
    "__attribute__((packed)) ",
    "static inline ",
]

// one change of the text
fn Rng.mutate(var self, text: Text) -> Text = self.mutateWith(text, pieces)

fn Rng.mutateWith(var self, text: Text, given: [Text]) -> Text {
    var lines = text.split("\n")
    if len(lines) == 0 {
        return text
    }
    let at = self.below(len(lines))
    match self.below(6) {
        0 => {
            lines = lines[..at] + lines[at + 1..]
        }
        1 => {
            lines = lines[..at] + [lines[at]] + lines[at..]
        }
        2 => {
            let other = self.below(len(lines))
            let a = lines[at]
            lines[at] = lines[other]
            lines[other] = a
        }
        3 => {
            let l = lines[at]
            let b = l.bytes()
            if len(b) > 1 {
                let i = self.below(len(b))
                let j = i + self.below(len(b) - i)
                lines[at] = Text(b[..i] + b[j..]) ?? l
            }
        }
        _ => {
            let l = lines[at]
            let b = l.bytes()
            let i = self.below(len(b) + 1)
            lines[at] = (Text(b[..i]) ?? "") + given[self.below(len(given))] + (Text(b[i..]) ?? "")
        }
    }
    lines.join("\n")
}

// the command run: its status and output; a status past 2 is a crash
fn call(quark: Text, args: [Text]) -> Process {
    runProcess(quark, args) ?? Process(99, "", "could not start {quark}")
}

// a C header changed at random, given to quark bind: why it failed, or ""
fn bindCase(quark: Text, seed: Int, dir: Text, headers: [Text]) -> Text! {
    var g = Rng(seed *% 6364136223846793005 +% 1442695040888963407)
    let name = headers[g.below(len(headers))]
    var text = readFile(name)?
    for _ in 0..g.below(3) + 1 {
        text = g.mutateWith(text, cPieces)
    }
    let path = "{dir}/b{seed}.h"
    writeFile(path, text)?
    let out = "{dir}/b{seed}.qk"
    let bound = call(quark, ["bind", path, "-o", out])
    if bound.status > 2 {
        return Ok("quark bind crashed ({bound.status}): {bound.err} ({path}, from {name})")
    }
    if bound.status == 0 and pathExists(out) {
        let written = readFile(out)?
        let formatted = call(quark, ["fmt", out])
        if formatted.status != 0 {
            return Ok("quark bind wrote what is not Quark: {formatted.err} ({path}, from {name})")
        }
        if formatted.out != written {
            return Ok("quark bind wrote Quark not in its canonical form ({path}, from {name})")
        }
        let checked = call(quark, ["check", out])
        if checked.status > 2 {
            return Ok("quark check crashed on quark bind's output ({checked.status}) ({path})")
        }
        let _ = removePath(out)
    }
    let _ = removePath(path)
    Ok("")
}

fn main() {
    let given = args()
    if len(given) < 1 {
        printErr("usage: quark run tools/fuzz.qk -- QUARK [COUNT] [FIRST_SEED]")
        exit(2)
    }
    let quark = given[0]
    let count = if len(given) > 1 { given[1].parseInt() ?? 200 } else { 200 }
    let first = if len(given) > 2 { given[2].parseInt() ?? 1 } else { 1 }
    let sources = (listDir("tests/run")?).filter(n => n.endsWith(".qk")).sorted().toArray()
    let dir = (env("TEMP") ?? env("TMPDIR") ?? "/tmp") + "/quark-fuzz"
    let _ = makeDir(dir)
    var failed = 0
    let headers = (listDir("tests/bind")?)
        .filter(n => n.endsWith(".h"))
        .sorted()
        .map(n => "tests/bind/" + n)
        .toArray() + ["include/quark.h"]
    for seed in first..first + count {
        if seed % 4 == 0 {
            let why = bindCase(quark, seed, dir, headers)?
            if why != "" {
                failed += 1
                print("seed {seed}: {why}")
            }
            continue
        }
        var g = Rng(seed *% 6364136223846793005 +% 1442695040888963407)
        let name = sources[g.below(len(sources))]
        var text = readFile("tests/run/" + name)?
        for _ in 0..g.below(3) + 1 {
            text = g.mutate(text)
        }
        let path = "{dir}/f{seed}.qk"
        writeFile(path, text)?
        var why = ""
        let checked = call(quark, ["check", path])
        if checked.status > 2 {
            why = "quark check crashed ({checked.status}): {checked.err}"
        }
        let formatted = call(quark, ["fmt", path])
        if why == "" and formatted.status > 2 {
            why = "quark fmt crashed ({formatted.status}): {formatted.err}"
        }
        if why == "" and formatted.status == 0 {
            // stable: the canonical text, formatted again, is itself
            let again = "{dir}/f{seed}.fmt.qk"
            writeFile(again, formatted.out)?
            let twice = call(quark, ["fmt", again])
            if twice.status > 2 {
                why = "quark fmt crashed on its own output ({twice.status})"
            } else if twice.status == 0 and twice.out != formatted.out {
                why = "quark fmt is not stable: its output formatted again differs"
            }
            let _ = removePath(again)
        }
        if why == "" and checked.status == 0 {
            // the graph's round trip gives the canonical text back
            let graph = call(quark, ["graph", path])
            if graph.status > 2 {
                why = "quark graph crashed ({graph.status})"
            } else if graph.status == 0 {
                let qgn = "{dir}/f{seed}.qgn"
                writeFile(qgn, graph.out)?
                let back = call(quark, ["text", qgn])
                if back.status > 2 {
                    why = "quark text crashed ({back.status})"
                } else if back.status == 0 and formatted.status == 0 and back.out != formatted.out {
                    why = "the graph's round trip gives another text than quark fmt"
                }
                let _ = removePath(qgn)
            }
        }
        if why != "" {
            failed += 1
            print("seed {seed} ({name}): {why} ({path})")
        } else {
            let _ = removePath(path)
        }
    }
    print("fuzz: {count} cases, {failed} failed")
    if failed > 0 {
        exit(1)
    }
}
